// A stage.match whose selector is a double-quoted LogQL string, the only shape Alloy's
// match-stage parser accepts (the k3s pipeline in loki-homelab's config.alloy.j2).
loki.write "fixture" {
  endpoint {
    url = "http://loki.invalid/loki/api/v1/push"
  }
}

loki.process "fixture" {
  forward_to = [loki.write.fixture.receiver]

  stage.match {
    selector            = "{job=\"fixture\"} !~ \"^[WEF][0-9]{4} |^panic: \""
    action              = "drop"
    drop_counter_reason = "below_warn"
  }
}
