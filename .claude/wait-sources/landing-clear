#!/bin/sh
# cc-wait's `landing-clear` source: `cc-wait landing-clear` waits until nothing in CLAUDE.md's
# *When to wait* list blocks a landing. The logic and its contract are
# scripts/diagnostics/landing_clear.py; this only finds it. It runs under uv's 3.15 with no
# project environment, as the `land` source does.
root=$(cd "$(dirname "$0")/../.." && pwd)
exec env PYTHONPATH="$root/scripts" uv run --no-project --quiet --python 3.15 python "$root/scripts/diagnostics/landing_clear.py" "$@"
