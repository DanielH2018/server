#!/bin/sh
# cc-wait's `fanout-headroom` source: `cc-wait fanout-headroom [--batches N] [--host HOST]`
# waits until `fanout.py place launch` would place. The logic and its contract are
# scripts/dev/fanout_lib/headroom_probe.py, run as `scripts/dev/fanout.py headroom`; this only
# finds it. It runs under uv's 3.14 with no project environment, as the `fanout` source does.
root=$(cd "$(dirname "$0")/../.." && pwd)
exec uv run --no-project --quiet --python 3.14 python "$root/scripts/dev/fanout.py" headroom "$@"
