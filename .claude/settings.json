{
  "disableClaudeAiConnectors": true,
  "permissions": {
    "allow": [
      "Bash(ansible-lint *)",
      "Bash(git check-ignore *)",
      "Bash(uv run python scripts/diagnostics/probe.py:*)",
      "Bash(./scripts/deploy_tools/gitops_tick.sh:*)",
      "Bash(kubectl get *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl top *)",
      "Bash(kubectl explain *)",
      "Bash(kubectl events *)",
      "Bash(kubectl api-resources *)",
      "Bash(kubectl api-versions *)",
      "Bash(kubectl version *)",
      "Bash(kubectl diff *)",
      "Bash(kubectl wait *)",
      "Bash(kubectl auth *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/server/.claude/hooks/auto-approve-readonly.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/server/.claude/hooks/uv-python.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/server/.claude/hooks/block-protected-bash.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/server/.claude/hooks/block-protected-edits.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/server/.claude/hooks/ansible-lint.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/server/.claude/hooks/validate-compose.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/server/.claude/hooks/auto-mode-bridge.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/server/.claude/hooks/auto-approve-remote-ssh.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/server/.claude/hooks/auto-mode-bridge.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/server/.claude/hooks/log-instructions.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/server/.claude/hooks/session-health.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "claude-permission-audit@daniel-tools": false
  }
}
