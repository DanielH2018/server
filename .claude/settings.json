{
  "disableClaudeAiConnectors": true,
  "permissions": {
    "allow": [
      "Bash(ansible-lint *)",
      "Bash(git check-ignore *)",
      "Bash(uv run python scripts/probe.py:*)",
      "Bash(kubectl get *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl top *)",
      "Bash(kubectl explain *)",
      "Bash(kubectl events *)",
      "Bash(kubectl api-resources *)",
      "Bash(kubectl api-versions *)",
      "Bash(kubectl version *)",
      "Bash(kubectl cluster-info)",
      "Bash(kubectl auth can-i *)",
      "Bash(kubectl auth whoami)",
      "Bash(kubectl diff *)",
      "Bash(kubectl wait *)",
      "Bash(kubectl rollout status *)",
      "Bash(kubectl rollout history *)",
      "Bash(kubectl config view *)",
      "Bash(kubectl config get-contexts *)",
      "Bash(kubectl config current-context)",
      "Bash(kubectl apply *)",
      "Bash(kubectl scale *)",
      "Bash(kubectl rollout restart *)",
      "Bash(kubectl rollout undo *)",
      "Bash(kubectl rollout pause *)",
      "Bash(kubectl rollout resume *)",
      "Bash(kubectl label *)",
      "Bash(kubectl annotate *)",
      "Bash(kubectl cordon *)",
      "Bash(kubectl uncordon *)",
      "Bash(kubectl create job *)"
    ],
    "ask": [
      "Bash(kubectl apply --prune*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/server/.claude/hooks/auto-approve-readonly.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/server/.claude/hooks/block-protected-edits.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/server/.claude/hooks/ansible-lint.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/server/.claude/hooks/validate-compose.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/server/.claude/hooks/log-instructions.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/server/.claude/hooks/session-health.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "claude-permission-audit@daniel-tools": false
  }
}
