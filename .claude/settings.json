{
  "disableClaudeAiConnectors": true,
  "permissions": {
    "allow": [
      "Bash(ansible-lint *)",
      "Bash(git check-ignore *)",
      "Bash(uv run python scripts/diagnostics/probe.py:*)",
      "Bash(./scripts/deploy_tools/gitops_tick.sh:*)",
      "Bash(kubectl get *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl top *)",
      "Bash(kubectl explain *)",
      "Bash(kubectl events *)",
      "Bash(kubectl api-resources *)",
      "Bash(kubectl api-versions *)",
      "Bash(kubectl version *)",
      "Bash(kubectl diff *)",
      "Bash(kubectl wait *)",
      "Bash(kubectl auth *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-hook.sh bash-pretool --ask-on-cd=block-protected-bash,block-footguns || { rc=$?; [ -x \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-hook.sh ] && exit $rc; echo \"run-hook.sh bash-pretool: $CLAUDE_PROJECT_DIR/.claude/hooks/run-hook.sh is missing or not executable (exit $rc), so this call was checked by none of: block-protected-bash,block-footguns. The checkout this session started in is gone; restart the session from a live checkout.\" >&2; exit 2; }",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-hook.sh block-protected-edits --ask-on-cd || { rc=$?; [ -x \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-hook.sh ] && exit $rc; echo \"run-hook.sh block-protected-edits: $CLAUDE_PROJECT_DIR/.claude/hooks/run-hook.sh is missing or not executable (exit $rc), so this call was checked by none of: block-protected-edits. The checkout this session started in is gone; restart the session from a live checkout.\" >&2; exit 2; }",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-hook.sh auto-mode-bridge --project",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-hook.sh auto-mode-bridge --project",
            "timeout": 10
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-hook.sh log-instructions",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-hook.sh session-health",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-hook.sh fanout-stop",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false
  }
}
