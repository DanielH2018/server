{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
{% from 'crowdsec-agent.yml.j2' import crowdsec_agent_init_containers, crowdsec_agent_sidecar, crowdsec_agent_volumes with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: traefik
  namespace: {{ k8s_namespace }}
spec:
  # acme.json is a ReadWriteOnce volume and two Traefiks racing to write it corrupt the
  # account registration, so the rollout must stop the old pod before starting the new one.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: traefik
  template:
    metadata:
      labels:
        app: traefik
        netpol-baseline: enforced
    spec:
      # Pinned to the VIP-announcing node while the MetalLB L2Advertisement is pinned
      # to daniel-box: with externalTrafficPolicy Local, a VIP-backed pod on the other
      # node makes the announcer DROP all forwarded LAN traffic (2026-08-14 post-boot
      # DNS blackout). DECIDED: permanent posture (operator 2026-08-14) — with ETP Local
      # load-bearing for client IPs, announcement and placement stay on one node as a
      # unit; this pin only ever moves together with the L2Advertisement nodeSelector.
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_primary_node }}
{# DECIDED: no automountServiceAccountToken: false here; the kubernetesCRD provider needs the
   token to reach the API server. #}
      # Edge/auth/DNS eviction ordering — see k8s/roles/cluster-base/templates/priorityclass.yaml.j2.
{{ pod_shell(services | tier_priority_class('traefik'), service_account='traefik-ingress-controller', run_as_user=traefik_k8s_uid, run_as_group=traefik_k8s_uid, fs_group=traefik_k8s_uid) }}
{# Both init containers below are conditional, and a cluster with neither ACME nor CrowdSec
   leaves the key with no list under it. Gate the key so it is absent rather than empty. #}
{% if traefik_k8s_manage_acme or traefik_k8s_manage_crowdsec %}
      initContainers:
{% endif %}
{% if traefik_k8s_manage_acme %}
        # Traefik creates acme.json 0600, but kubelet's fsGroup handling ORs group bits into every
        # file on the volume at mount time, so it comes back 0660 on every start. Traefik then
        # refuses the ACME account and drops the entire resolver:
        #   unable to get ACME account: permissions 660 for /data/acme.json are too open,
        #   please use 600
        # Every router asking for that resolver then fails with "Router uses a nonexistent
        # certificate resolver" and nothing serves TLS, while the deploy stays green.
        #
        # This runs on every start because the mount is what widens the file. It reuses the
        # Traefik image (it carries /bin/sh), so there is no second image to pin.
        - name: fix-acme-permissions
          image: {{ traefik_k8s_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
            - touch /data/acme.json && chmod 600 /data/acme.json
{{ hardened_security_context(read_only=true, non_root=true) }}
          volumeMounts:
            - name: traefik-acme
              mountPath: /data
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
{% endif %}
{% if traefik_k8s_manage_crowdsec %}
{{ crowdsec_agent_init_containers('traefik', log_volume='traefik-logs', log_dir='/var/log/traefik', log_file='access.log', uid=traefik_k8s_uid, gid=traefik_k8s_uid) }}
{% endif %}
      containers:
        - name: traefik
          image: {{ traefik_k8s_image }}
          imagePullPolicy: IfNotPresent
          args:
            - --configFile=/config/traefik.yml
          ports:
            - name: http
              containerPort: {{ traefik_k8s_http_port }}
            - name: https
              containerPort: {{ traefik_k8s_https_port }}
            - name: ping
              containerPort: {{ traefik_k8s_ping_port }}
{% if traefik_k8s_manage_acme %}
{# The whole env: key is gated, not just its entries — an env: with no list under it parses as
   null, which the API server rejects on a container spec. This comment sits at column 0 on
   purpose: lstrip_blocks is off, so an indented tag leaves its leading spaces in the output. #}
          env:
            # Not sensitive — the token itself is file-mounted below.
            - name: CF_API_EMAIL
              value: "{{ email }}"
            - name: CF_DNS_API_TOKEN_FILE
              value: /secrets/cf_dns_token
{% endif %}
{{ hardened_security_context(read_only=true, non_root=true) }}
          volumeMounts:
            - name: traefik-config
              mountPath: /config
              readOnly: true
{% if traefik_k8s_manage_livesync_gate %}
            - name: traefik-livesync-gate
              mountPath: /etc/traefik-file
              readOnly: true
{% endif %}
            # NOT /run/secrets: /var/run/secrets symlinks to it, and Kubernetes projects the
            # ServiceAccount token there. Mounting a read-only Secret over it leaves runc unable
            # to create /run/secrets/kubernetes.io and the container never starts:
            #   mkdirat .../rootfs/run/secrets/kubernetes.io: read-only file system
{% if traefik_k8s_manage_acme %}
            - name: traefik-cloudflare
              mountPath: /secrets
              readOnly: true
{% endif %}
{% if traefik_k8s_manage_crowdsec %}
            # The bouncer plugin reads its LAPI key from here (crowdsecLapiKeyFile in the
            # crowdsec Middleware) — a file, so the key never appears in the CRD.
            - name: crowdsec-key
              mountPath: /secrets/crowdsec
              readOnly: true
            # The cloudflare-realip local plugin's source. Traefik resolves
            # ./plugins-local/src/<moduleName>/ against its working directory, which is /.
            - name: cloudflare-realip-plugin
              mountPath: /plugins-local
              readOnly: true
{% endif %}
{% if traefik_k8s_manage_acme %}
            - name: traefik-acme
              mountPath: /data
{% endif %}
            # Shared with the crowdsec-agent sidecar, which tails access.log.
            - name: traefik-logs
              mountPath: /var/log/traefik
            # Traefik downloads experimental plugins (the crowdsec bouncer) here at start. With the
            # read-only rootfs it cannot mkdir this itself, and when that fails it does not fail
            # the pod: it DISABLES plugins, the crowdsec Middleware never materializes, and every
            # router referencing it 404s.
            - name: traefik-plugins-storage
              mountPath: /plugins-storage
            - name: traefik-tmp
              mountPath: /tmp
{% if traefik_k8s_manage_crowdsec %}
          # /ping answers 200 from the moment the process is up, and says nothing about whether
          # Traefik built a routing table. If the boot-time download of the bouncer plugin times
          # out, the `crowdsec` Middleware the https entrypoint names resolves to "invalid
          # middleware type", every router on that entrypoint is rejected, and the pod sits Ready
          # serving 404. Traefik does not retry that download.
          #
          # This probe makes the pod's start conditional on the routing table existing. Its
          # target is edge-selfcheck-ingressroute.yaml.j2: a router on the https entrypoint
          # backed by ping@internal, so it carries the crowdsec middleware chain but depends on
          # no other workload. Plugin missing: the router is rejected with all the others, the
          # probe reads 404, kubelet restarts the container, and the restart re-downloads. A
          # download that keeps failing shows as CrashLoopBackOff rather than a green pod.
          #
          # A startupProbe rather than a liveness one: it is scoped to boot, when the download
          # happens, so a steady-state wobble in CrowdSec can never restart-loop the edge. It
          # also suppresses the readiness probe below until it passes, which keeps a routerless
          # Traefik out of the Service.
          #
          # DECIDED: the shared emptyDir does not need clearing between container starts (#1345).
          # A failing startupProbe restarts the CONTAINER, so /plugins-storage is the same
          # emptyDir on every retry. Traefik clears the sources tree at every process start and
          # re-requests the archive on every install, so a stale or partial archive cannot
          # short-circuit recovery. This role's CLAUDE.md has the evidence.
          #
          # 3 minutes of tolerance (36 x 5s). The download takes ~1s when plugins.traefik.io
          # answers, and the bouncer's own updateMaxFailure: 5 gives roughly 6 minutes before
          # a dead LAPI turns into a blanket 403, so this window closes well inside the one
          # case where a healthy edge could still fail the probe.
          startupProbe:
            httpGet:
              path: /.well-known/traefik-edge-selfcheck
              port: https
              scheme: HTTPS
            periodSeconds: 5
            failureThreshold: 36
            # 3s, not kubelet's 1s default. Each attempt is a full TLS handshake plus the crowdsec,
            # default-headers and compress chain, and at cold boot on a loaded node 1s can expire
            # on a healthy Traefik, burning all 36 attempts and restarting it.
            timeoutSeconds: 3
{% endif %}
          readinessProbe:
            httpGet:
              path: /ping
              port: ping
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /ping
              port: ping
            initialDelaySeconds: 15
            periodSeconds: 30
{{ container_resources(cpu_limit=traefik_k8s_cpu_limit, mem_limit=traefik_k8s_mem_limit, cpu_request=traefik_k8s_cpu_request, mem_request=traefik_k8s_mem_request) }}
{% if traefik_k8s_manage_crowdsec %}
        # Tails this pod's access log into the in-cluster LAPI. The bouncer middleware fails
        # open per its own config, so a dead agent costs detection, not serving.
{{ crowdsec_agent_sidecar('traefik', collections=traefik_k8s_agent_collections, log_volume='traefik-logs', log_dir='/var/log/traefik', cpu_limit=traefik_k8s_agent_cpu_limit, mem_limit=traefik_k8s_agent_mem_limit, cpu_request=traefik_k8s_agent_cpu_request, mem_request=traefik_k8s_agent_mem_request, parsers=traefik_k8s_agent_parsers) }}
{% endif %}
        # Ships the access log to Loki (tails it to stdout, which promtail's k8s-pods job
        # auto-discovers by container name — no scrape-config change needed) and keeps the
        # traefik-logs emptyDir off the eviction path (copytruncate before traefik_k8s_access_log_size
        # is ever reached).
        #
        # copytruncate, NOT a SIGUSR1 reopen signal: signalling traefik's PID 1 from a sibling
        # container needs shareProcessNamespace: true on the pod, which stays unset so no
        # sidecar can see or signal another container's process on this security-critical pod.
        # copytruncate copies the log aside, then truncates the SAME inode, so traefik's
        # already-open fd keeps writing. That works because traefik opens the access log
        # O_APPEND, so the first write after a truncate lands at the new offset 0. The rotate()
        # function below checks this held. CrowdSec's acquis.yaml (crowdsec-secret.yaml.j2)
        # names the exact file /var/log/traefik/access.log, not a glob, so the rotated .1/.2
        # generations are never re-ingested and old requests never get re-banned.
        #
        # Deliberately NO readinessProbe, as with crowdsec-agent above: a sidecar's readiness
        # gates the whole pod's Service endpoints, so a tail or rotation hiccup here must never
        # pull the EDGE out of rotation. No livenessProbe either: the loop below watchdogs the
        # child `tail`, and a container restart would gain nothing.
        - name: access-log-rotate
          image: {{ traefik_k8s_logrotate_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
            - |
              set -eu
              LOG=/var/log/traefik/access.log
              MAX_BYTES=$(( {{ traefik_k8s_access_log_rotate_mb }} * 1024 * 1024 ))
              KEEP={{ traefik_k8s_access_log_keep }}
              ROTATE_DISABLED=0

              log() { echo "access-log-rotate: $*"; }

              # BusyBox's tail is not known to reseek to 0 on a detected truncation the way GNU
              # coreutils does, so the child is killed and restarted across every rotation.
              # `-n +1` follows from byte 0: right after a truncate/restart the file is ~empty,
              # so nothing is lost by not seeking to the (now stale) end.
              start_tail() {
                tail -f -n +1 "$LOG" &
                TAIL_PID=$!
              }

              # stat is O(1); wc -c re-reads the whole file, which matters at 100MB+ on a
              # once-a-minute poll. Falls back if this image's stat lacks -c.
              file_size() {
                stat -c%s "$LOG" 2>/dev/null || wc -c < "$LOG"
              }

              rotate() {
                i=$KEEP
                while [ "$i" -gt 1 ]; do
                  prev=$((i - 1))
                  if [ -e "$LOG.$prev" ]; then
                    mv "$LOG.$prev" "$LOG.$i"
                  fi
                  i=$prev
                done
                cp "$LOG" "$LOG.1"
                : > "$LOG"
                kill "$TAIL_PID" 2>/dev/null || true
                wait "$TAIL_PID" 2>/dev/null || true
                start_tail

                # Did the truncate take? If traefik does not open the log O_APPEND, its write offset
                # stays at the pre-rotate size and the file re-grows to it on the next write, so
                # copying it in full every cycle would thrash the disk. Fail loud and stop rotating.
                size_after=$(file_size)
                if [ "$size_after" -ge "$MAX_BYTES" ]; then
                  log "truncate did not shrink $LOG (still ${size_after}B) — disabling further rotation"
                  ROTATE_DISABLED=1
                fi
              }

              start_tail

              while true; do
                sleep 60
                if ! kill -0 "$TAIL_PID" 2>/dev/null; then
                  log "tail exited, restarting"
                  start_tail
                fi
                if [ "$ROTATE_DISABLED" -eq 1 ]; then
                  continue
                fi
                if [ -f "$LOG" ]; then
                  size=$(file_size)
                  if [ "$size" -ge "$MAX_BYTES" ]; then
                    rotate
                  fi
                fi
              done
{{ hardened_security_context(non_root=true) }}
          volumeMounts:
            - name: traefik-logs
              mountPath: /var/log/traefik
{{ container_resources(cpu_limit=traefik_k8s_logrotate_cpu_limit, mem_limit=traefik_k8s_logrotate_mem_limit, cpu_request=traefik_k8s_logrotate_cpu_request, mem_request=traefik_k8s_logrotate_mem_request) }}
      volumes:
        - name: traefik-config
          configMap:
            name: traefik-static
{% if traefik_k8s_manage_livesync_gate %}
        # LiveSync token gate — file-provider dynamic config (see livesync-gate-secret.yaml.j2)
        - name: traefik-livesync-gate
          secret:
            secretName: traefik-livesync-gate
{% endif %}
{% if traefik_k8s_manage_acme %}
        - name: traefik-cloudflare
          secret:
            secretName: traefik-cloudflare
            # 0440, not 0400: the kubelet owns secret files as root:fsGroup, so the container user
            # reaches them through the GROUP bit, which 0400 does not grant.
            defaultMode: 0440
        - name: traefik-acme
          persistentVolumeClaim:
            claimName: traefik-acme
{% endif %}
        - name: traefik-tmp
          emptyDir: {}
{% if traefik_k8s_manage_crowdsec %}
{{ crowdsec_agent_volumes('traefik') }}
        # The traefik container gets ONLY the key file from traefik-crowdsec; the whole Secret
        # (agent password, acquis, whitelists) is projected for the sidecar's seed above.
        - name: crowdsec-key
          secret:
            secretName: traefik-crowdsec
            defaultMode: 0440
            items:
              - key: lapi_key
                path: lapi_key
        # Projects the plugin into the GOPATH layout Traefik reads. The manifest's ConfigMap key
        # is `traefik-plugin.yml` and only the projected name carries the leading dot.
        - name: cloudflare-realip-plugin
          configMap:
            name: traefik-cloudflare-realip
            items:
              - key: cloudflarerealip.go
                path: src/{{ traefik_k8s_realip_plugin_module }}/cloudflarerealip.go
              - key: traefik-plugin.yml
                path: src/{{ traefik_k8s_realip_plugin_module }}/.traefik.yml
{% endif %}
        - name: traefik-plugins-storage
          emptyDir: {}
        # sizeLimit is a BACKSTOP against pod eviction, not the rotation mechanism: the
        # access-log-rotate sidecar copytruncates the log well before it is reached (see
        # traefik_k8s_access_log_rotate_mb / _keep in defaults/main.yml).
        - name: traefik-logs
          emptyDir:
            sizeLimit: {{ traefik_k8s_access_log_size }}
