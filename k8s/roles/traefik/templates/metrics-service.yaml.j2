---
# Separate on purpose: 8080 on the LoadBalancer would expose metrics and api@internal on the VIP.
# targetPort is the default of Traefik's auto-created `traefik` entrypoint (:8080).
apiVersion: v1
kind: Service
metadata:
  name: traefik-metrics
  namespace: {{ k8s_namespace }}
spec:
  selector:
    app: traefik
  ports:
    - name: metrics
      port: {{ services | metrics_port('traefik-k8s') }}
      targetPort: 8080
