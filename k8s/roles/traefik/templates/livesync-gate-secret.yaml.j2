---
# The k8s edge's token gates: LiveSync's X-Sync-Token and homelab-mcp's bearer. One Secret, one
# file: the static config's file provider takes a single `filename:` (directory-watch
# double-parses Secret ..data symlinks), so every token-gated router lives here. A
# Secret-mounted file-provider config, NOT an IngressRoute: the readonly kubeconfig can read
# CRDs but is RBAC-denied Secrets, so a token in a CRD would be readable.
#
# Router semantics:
#   - a request without the matching token matches NO router for the host and 404s
#     before CouchDB; CouchDB's require_valid_user is the second layer
#   - /_utils carve-out at priority 200 behind Authelia (k8s portal — same cookie domain)
#   - the probe router is LAN-only by construction (.local host, no public sibling) and
#     exists so ONE probe exercises edge → CouchDB end-to-end (blackbox-extra's `http_401`
#     module expects its 401)
#
# Middleware/TLS-option refs are provider-qualified (@kubernetescrd) — a file-provider
# router referencing CRD objects needs the namespace-prefixed form, same as the
# entrypoint middlewares in static-config.yaml.j2.
apiVersion: v1
kind: Secret
metadata:
  name: traefik-livesync-gate
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  livesync-gate.yml: |
    http:
      routers:
{#
  `suffix` picks the limiter's keying per host: the public name is Cloudflare-proxied, so its
  connections come from a Cloudflare edge and the limiter keys on the forwarded client; the
  `.local.` name is reached direct, where the remote address is the client. For the public
  name the connection is Cloudflare's, so a remote-address limiter would make every phone
  syncing through the same edge share one 6000/min bucket. The rationale is with the
  middlewares in dynamic.yaml.j2.
  `tls_option` follows the same line: the public name requires Cloudflare's origin-pull client
  certificate (`cloudflare-origin-pull`, k8s/templates/origin-pull.yml.j2) and the
  `.local.` name stays on `modern`. The probe and mcp routers below are `.local.`-only and
  stay on `modern` too.
#}
{% for key, host, suffix, tls_option in [('public', 'livesync.' ~ domain, '-proxied', 'cloudflare-origin-pull'), ('local', 'livesync.local.' ~ domain, '', 'modern')] %}
        livesync-sync-{{ key }}:
          entryPoints:
            - https
          rule: "Host(`{{ host }}`) && Header(`X-Sync-Token`, `{{ livesync_sync_token }}`)"
          service: livesync-couchdb
          middlewares:
            # The high ceiling is livesync's replication exemption: a phone 429s mid-sync on the
            # default limiter.
            - {{ k8s_namespace }}-rate-limit-public-livesync{{ suffix }}@kubernetescrd
          tls:
{% if k8s_tls_cert_resolver %}
            certResolver: {{ k8s_tls_cert_resolver }}
{% endif %}
            options: {{ k8s_namespace }}-{{ tls_option }}@kubernetescrd
{% if k8s_tls_cert_resolver %}
            domains:
              - main: "{{ domain }}"
                sans:
                  - "*.{{ domain }}"
                  - "*.local.{{ domain }}"
{% endif %}
        livesync-utils-{{ key }}:
          entryPoints:
            - https
          rule: "Host(`{{ host }}`) && (PathPrefix(`/_utils/`) || Path(`/_utils`))"
          service: livesync-couchdb
          priority: 200
          middlewares:
            - {{ k8s_namespace }}-rate-limit{{ suffix }}@kubernetescrd
            - {{ k8s_namespace }}-authelia@kubernetescrd
          tls:
{% if k8s_tls_cert_resolver %}
            certResolver: {{ k8s_tls_cert_resolver }}
{% endif %}
            options: {{ k8s_namespace }}-{{ tls_option }}@kubernetescrd
{% if k8s_tls_cert_resolver %}
            domains:
              - main: "{{ domain }}"
                sans:
                  - "*.{{ domain }}"
                  - "*.local.{{ domain }}"
{% endif %}
{% endfor %}
{#
  Path, not PathPrefix, and no public sibling: the same LAN-only shape the Docker probe router
  had. CouchDB answers 401, the status the blackbox-extra job's `http_401` module accepts. A
  Jinja comment, because a YAML one here is Secret data that moves traefik's `checksum/restart`.
#}
        livesync-probe:
          entryPoints:
            - https
          rule: "Host(`livesync.local.{{ domain }}`) && Path(`/`)"
          service: livesync-couchdb
          priority: 200
          middlewares:
            - {{ k8s_namespace }}-rate-limit@kubernetescrd
          tls:
{% if k8s_tls_cert_resolver %}
            certResolver: {{ k8s_tls_cert_resolver }}
{% endif %}
            options: {{ k8s_namespace }}-modern@kubernetescrd
{% if k8s_tls_cert_resolver %}
            domains:
              - main: "{{ domain }}"
                sans:
                  - "*.{{ domain }}"
                  - "*.local.{{ domain }}"
{% endif %}
        homelab-mcp-local:
          entryPoints:
            - https
          # LAN-ONLY (only the .local host, no public sibling) AND the exact bearer token, or the
          # request matches NO router for the host and 404s before the app. The app re-checks the
          # token (defence in depth).
          rule: "Host(`mcp.local.{{ domain }}`) && Header(`Authorization`, `Bearer {{ homelab_mcp_token }}`)"
          service: homelab-mcp
          middlewares:
            - {{ k8s_namespace }}-rate-limit@kubernetescrd
          tls:
{% if k8s_tls_cert_resolver %}
            certResolver: {{ k8s_tls_cert_resolver }}
{% endif %}
            options: {{ k8s_namespace }}-modern@kubernetescrd
{% if k8s_tls_cert_resolver %}
            domains:
              - main: "{{ domain }}"
                sans:
                  - "*.{{ domain }}"
                  - "*.local.{{ domain }}"
{% endif %}
        homelab-mcp-probe:
          entryPoints:
            - https
          # Same shape and purpose as livesync-probe above: LAN-only, one exact Path, no public
          # sibling, so ONE monitor exercises edge -> app end-to-end. A probe of /mcp with no
          # bearer that accepts the 404 would not do: that 404 is Traefik's own, byte-identical
          # to the one a router-less edge returns for everything, so the monitor would read green
          # through a total-404 outage. A 200 from the app's own /health cannot be forged by the
          # edge failing.
          #
          # No token on this router, and none needed: app.py's _BearerAuth exempts /health,
          # which returns the bare string "ok" and reads nothing. Every other path still
          # requires the exact bearer, on this edge and again in the app.
          rule: "Host(`mcp.local.{{ domain }}`) && Path(`/health`)"
          service: homelab-mcp
          priority: 200
          middlewares:
            - {{ k8s_namespace }}-rate-limit@kubernetescrd
          tls:
{% if k8s_tls_cert_resolver %}
            certResolver: {{ k8s_tls_cert_resolver }}
{% endif %}
            options: {{ k8s_namespace }}-modern@kubernetescrd
{% if k8s_tls_cert_resolver %}
            domains:
              - main: "{{ domain }}"
                sans:
                  - "*.{{ domain }}"
                  - "*.local.{{ domain }}"
{% endif %}
      services:
        livesync-couchdb:
          loadBalancer:
            servers:
              - url: "http://livesync.{{ k8s_namespace }}.svc.cluster.local:5984"
        homelab-mcp:
          loadBalancer:
            servers:
              - url: "http://homelab-mcp.{{ k8s_namespace }}.svc.cluster.local:8000"
