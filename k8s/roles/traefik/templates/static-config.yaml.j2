---
apiVersion: v1
kind: ConfigMap
metadata:
  name: traefik-static
  namespace: {{ k8s_namespace }}
data:
  traefik.yml: |
    api:
      dashboard: true
      insecure: false
      debug: false
    # Explicit: the default is the internal `traefik` entrypoint, so the probes would poll nothing.
    ping:
      entryPoint: ping

    entryPoints:
      http:
        address: ":{{ traefik_k8s_http_port }}"
        forwardedHeaders:
          trustedIPs:
{% for ip in cloudflare_ips %}
            - "{{ ip }}"
{% endfor %}
            # This list governs X-Forwarded-For TRUST, not admission: from a source listed
            # here Traefik keeps the client-sent XFF, and from any other source it discards it
            # and uses the connection address. Only a proxy in front of Traefik belongs here.
            #
            # DECIDED: Cloudflare only, and not `lan_subnet` ({{ lan_subnet }}). The LAN /24
            # does not hold a proxy for Traefik on k3s: neither node runs Docker, and the Pi runs
            # only docker-proxy, wg-easy, alloy and autoheal. Trusting the /24 let any LAN
            # device forge XFF, and that included every WireGuard peer. wg-easy masquerades
            # its `wg_client_subnet` ({{ wg_client_subnet }}) peers to the Pi's LAN address,
            # which is inside the /24. With the /24 untrusted, Traefik strips a LAN client's
            # XFF and forwards the connection address, so Authelia `networks:` rules and
            # ClientIP() matchers still see the LAN address. Not the pod CIDR either: the
            # Service runs externalTrafficPolicy: Local so requests arrive with the real client
            # address rather than cni0's, and trusting the pod network would let any pod forge
            # XFF. If a LAN reverse proxy is ever added in front of Traefik, list its single
            # address here rather than the /24.
            - "127.0.0.1/32"
        http:
          redirections:
            entryPoint:
              # Not `to: https`: it emits the container-side 8443 in Location, which the Service
              # never exposes.
              to: ":443"
              scheme: https
{% if traefik_k8s_manage_crowdsec %}
          middlewares:
            # Entrypoint-wide: everything entering this entrypoint passes the CrowdSec ban-list +
            # AppSec check before it is redirected. The only router here is
            # `http-to-443@internal`, the redirection above, so what the chain buys is rejecting a
            # banned IP on its FIRST request rather than on the https one it is redirected to.
            #
            # DECIDED: keep it, and expect one or two error lines per container start. Traefik
            # logs
            #
            #   {"level":"error","entryPointName":"http","routerName":"http-to-443@internal",
            #    "error":"middleware \"<ns>-crowdsec@kubernetescrd\" does not exist"}
            #
            # once or twice, within a second of startup, because the internal and file
            # providers publish their configuration before the kubernetesCRD watch delivers its
            # first one. The count is however many generations those two providers publish in
            # that window. The livesync `@file` routers log "unknown TLS options:
            # <ns>-modern@kubernetescrd" in the same window and then resolve fine. Traefik skips
            # the offending router and rebuilds the whole entrypoint on the next configuration
            # event, so http 404s instead of 301ing for that second and is correct afterwards.
            # The line does not show that an internal router cannot resolve a `@kubernetescrd`
            # middleware: it repeats on every configuration event while the reference is broken
            # and stops once it resolves. The line is also proof Traefik attaches this chain to the
            # internal router: `applyModel` prepends an entrypoint's middlewares to every root
            # router and only then does the lookup fail, so an excluded router would log
            # nothing at all. Dropping crowdsec here would remove real enforcement to silence
            # a startup line or two. ENFORCED by
            # tests/services/traefik/test_traefik_http_entrypoint_crowdsec.py.
            - {{ k8s_namespace }}-crowdsec@kubernetescrd
{% endif %}
      https:
        address: ":{{ traefik_k8s_https_port }}"
        forwardedHeaders:
          trustedIPs:
{% for ip in cloudflare_ips %}
            - "{{ ip }}"
{% endfor %}
            - "127.0.0.1/32"
        http:
          middlewares:
            # rate-limit stays per-router so a service can opt into a higher ceiling.
{% if traefik_k8s_manage_crowdsec %}
            # cloudflare-realip FIRST, ahead of crowdsec and of every router's forwardAuth.
            # Cloudflare appends the client address to any XFF the client sent, so the
            # trustedIPs above keep a client-chosen LEFTMOST entry, and Authelia logs the
            # leftmost entry as remote_ip. This middleware replaces XFF with CF-Connecting-IP
            # for a Cloudflare source, so everything after it sees `client` and every backend
            # sees `client, edge`. Gated with the bouncer because the startupProbe that catches
            # a failed plugin load is too.
            # ENFORCED by tests/k8s/edge/test_traefik_cloudflare_realip.py.
            - {{ k8s_namespace }}-cloudflare-realip@kubernetescrd
            # crowdsec next: a banned IP is rejected before any headers work is done.
            - {{ k8s_namespace }}-crowdsec@kubernetescrd
{% endif %}
            - {{ k8s_namespace }}-default-headers@kubernetescrd
            # Last on purpose: the last entry is innermost, so it compresses before the others add
            # headers.
            # Listed first it would compress responses for requests crowdsec rejects with a 403.
            - {{ k8s_namespace }}-compress@kubernetescrd
      ping:
        address: ":{{ traefik_k8s_ping_port }}"

    metrics:
      prometheus:
        addEntryPointsLabels: true
        addRoutersLabels: true
        addServicesLabels: true

    # A file, not stdout: the crowdsec sidecar tails it; json without StartUTC is the parser's
    # format.
    accessLog:
      filePath: /var/log/traefik/access.log
      format: json
      fields:
        defaultMode: keep
        names:
          StartUTC: drop

{% if traefik_k8s_manage_crowdsec %}
    experimental:
      plugins:
        bouncer:
          moduleName: github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin
          version: {{ traefik_k8s_bouncer_plugin_version }}
      # A local plugin: nothing is downloaded. The key must match the Middleware's `plugin:` key and
      # moduleName the manifest's `import` prefix; a mismatch disables every plugin.
      localPlugins:
        {{ traefik_k8s_realip_plugin_name }}:
          moduleName: {{ traefik_k8s_realip_plugin_module }}
{% endif %}

    serversTransport:
      insecureSkipVerify: false

    providers:
{% if traefik_k8s_manage_livesync_gate %}
      # Secret-mounted dynamic config, so the token stays out of CRDs the readonly kubeconfig reads;
      # watch:true makes rotation a Secret update with no restart.
      file:
        # filename, not directory: `..data` symlinks make a directory watch parse the file twice.
        filename: /etc/traefik-file/livesync-gate.yml
        watch: true
{% endif %}
      kubernetesCRD:
        # One list shared with rbac.yaml.j2. A namespace missing here fails silently: its routes
        # 404.
        # `allowCrossNamespace` stays OFF.
        namespaces:
{% for ns in traefik_k8s_watched_namespaces %}
          - {{ ns }}
{% endfor %}
        # DECIDED: keep a router whose Service has no ready endpoints (#2747, #2758). With
        # this off, v3.7.13's CRD provider logs `no servers found for <ns>/<svc>` and drops
        # the whole router, so its host briefly maps to no TLS options. A handshake in that
        # window records the options name `default` (pkg/server/router/tcp/router.go,
        # SetHTTPSForwarder), and once the router returns naming `modern` or
        # `cloudflare-origin-pull`, SNICheck answers every request on that connection 421
        # for the connection's life. With it on, the router
        # stays, the handshake records the router's own option, and the client gets a 503
        # it retries through. The cost is a 503 instead of a 404 while a backend is down or
        # scaled to 0, which the per-service traefik5xx check sees. Full reasoning in this
        # role's CLAUDE.md, the SNICheck bullet.
        allowEmptyServices: true

{% if traefik_k8s_manage_acme %}
    certificatesResolvers:
      cloudflare:
        acme:
          email: "{{ email }}"
          storage: /data/acme.json
{% if traefik_k8s_acme_ca_server %}
          caServer: "{{ traefik_k8s_acme_ca_server }}"
{% endif %}
          dnsChallenge:
            provider: cloudflare
            resolvers:
              - "9.9.9.9:53"
              - "149.112.112.112:53"
{% endif %}

    # Process log stays on stdout for kubectl logs.
    log:
      format: json
      level: INFO
