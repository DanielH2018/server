{% from 'origin-pull.yml.j2' import origin_pull_tlsoption with context %}
{# Not here: csp-karakeep (karakeep role). No TLSStore: every IngressRoute states its own
   tls.domains, so a store's defaultGeneratedCert would be a second source for the SAN set. #}
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: default-headers
  namespace: {{ k8s_namespace }}
spec:
  headers:
    customResponseHeaders:
      Permissions-Policy: "geolocation=(self), microphone=(), camera=(), fullscreen=(self), usb=()"
      # No global CSP: customResponseHeaders replaces the backend's header and clobbers per-app
      # CSPs.
    referrerPolicy: "strict-origin-when-cross-origin"
    browserXssFilter: true
    contentTypeNosniff: true
    forceSTSHeader: true
    stsIncludeSubdomains: true
    # No stsPreload: it needs max-age >= 1 year and is hard to reverse across every subdomain.
    stsSeconds: 15552000
    customFrameOptionsValue: SAMEORIGIN
    customRequestHeaders:
      X-Forwarded-Proto: https
{# Two keyings per profile: plain keys on the remote address (`.local.` hosts, direct), `-proxied`
   on XFF depth 1 (public, via Cloudflare); test_rate_limit_keys_on_the_client.py forbids mixing. #}
{% for profile in [
     {'name': 'rate-limit', 'average': 300, 'burst': 150,
      'why': 'The default per-client budget every route carries (ingressroute.yml.j2 attaches it unconditionally).'},
     {'name': 'rate-limit-public-livesync', 'average': 6000, 'burst': 600,
      'why': "livesync's replication ceiling (CouchDB sync is extremely chatty — _changes, _revs_diff, _bulk_docs, per-chunk reads; the shared 300/min 429'd a phone mid-pull, 2026-08-06). Referenced by the file-provider token gate (livesync-gate-secret.yaml.j2)."},
   ] %}
{% for suffix in ['', '-proxied'] %}
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  # {{ profile.why }}
  name: {{ profile.name }}{{ suffix }}
  namespace: {{ k8s_namespace }}
spec:
  rateLimit:
    average: {{ profile.average }}
    burst: {{ profile.burst }}
    period: 1m
{% if suffix %}
    sourceCriterion:
      ipStrategy:
        depth: 1
{% endif %}
{% endfor %}
{% endfor %}
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  # Attached entrypoint-wide in static-config.yaml.j2: no service wants uncompressed HTML/JSON.
  name: compress
  namespace: {{ k8s_namespace }}
spec:
  compress:
    # An allow-list: excludedContentTypes matches by equality, so a `video/` prefix excludes nothing
    # and Jellyfin's streams would be gzipped.
    includedContentTypes:
      - text/html
      - text/plain
      - text/css
      - text/javascript
      - text/xml
      - application/javascript
      - application/json
      - application/manifest+json
      - application/xml
      - application/rss+xml
      - image/svg+xml
    minResponseBodyBytes: 1024
---
apiVersion: traefik.io/v1alpha1
kind: TLSOption
metadata:
  # Not `default`: Traefik registers that TLSOption globally, not as
  # <namespace>-default@kubernetescrd, so naming it fails with `unknown TLS options`.
  name: modern
  namespace: {{ k8s_namespace }}
spec:
  # Referenced by name from the ingressroute() macro; test_k8s_manifests.py catches a mismatch.
  minVersion: VersionTLS12
  cipherSuites:
    - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
    - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
    - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
    - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
    - TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305
    - TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305
---
{{ origin_pull_tlsoption(k8s_namespace) }}
{% if traefik_k8s_manage_crowdsec %}
---
# The key is a file path, not inline: a Middleware CRD is readable by the read-only kubeconfig, so
# an inline crowdsecLapiKey would expose the ban-management API.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: crowdsec
  namespace: {{ k8s_namespace }}
spec:
  plugin:
    bouncer:
      enabled: true
      crowdsecLapiKeyFile: /secrets/crowdsec/lapi_key
      crowdsecLapiHost: "crowdsec:{{ crowdsec_k8s_lapi_port }}"
      crowdsecMode: stream
      updateIntervalSeconds: 60
      # Default 0 turns one missed stream poll into a blanket 403 for every IP; every roll gaps the
      # LAPI.
      # 5 (~6 min) is safe: cached bans and AppSec still apply. Not -1: a dead LAPI must fail
      # closed.
      updateMaxFailure: 5
      # DECIDED: no usage-metrics ticker. Nothing here reads the bouncer's usage metrics, which
      # only fill the dropped-request counts in `cscli metrics`. 0 passes the plugin's
      # validation and New() starts no metrics ticker. Restoring the default 600 restarts
      # Traefik, because the ticker is a package global, and needs a two-hour watch of the
      # LAPI's decisions/stream log for 600s or 1200s gaps.
      metricsUpdateIntervalSeconds: 0
      # AppSec: inline WAF that blocks a first-hit payload, unlike the reactive stream ban-list.
      # UnreachableBlock false fails open so an appsec outage cannot take down the edge.
      crowdsecAppsecEnabled: true
      crowdsecAppsecHost: "crowdsec:{{ crowdsec_k8s_appsec_port }}"
      crowdsecAppsecUnreachableBlock: false
---
# Attributes a request from a Cloudflare edge to the client Cloudflare reports in
# CF-Connecting-IP: X-Forwarded-For and X-Real-Ip become that single address, and other
# sources pass untouched. The https entrypoint chains it first (static-config.yaml.j2 says
# why); the plugin source is files/cloudflare-realip/cloudflarerealip.go.
#
# After it, the rightmost-entry consumers are unchanged: the bouncer and the `-proxied`
# limiters' `depth: 1` read the client either way, since Cloudflare's appended entry was
# already the rightmost one. A backend sees `client, edge`, so N8N_PROXY_HOPS: 2 still
# resolves the client.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: cloudflare-realip
  namespace: {{ k8s_namespace }}
spec:
  plugin:
    {{ traefik_k8s_realip_plugin_name }}:
      trustedIPs:
{% for ip in cloudflare_ips %}
        - "{{ ip }}"
{% endfor %}
{% endif %}
