{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
# PIHOLE_PASSWORD comes from pihole's `pihole-env` Secret, hence depends_on: [pihole].
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pihole-exporter
  namespace: {{ k8s_namespace }}
spec:
{{ spec_shell('RollingUpdate') }}
  replicas: 1
  selector:
    matchLabels:
      app: pihole-exporter
  template:
    metadata:
      labels:
        app: pihole-exporter
        netpol-baseline: enforced
    spec:
      # Dashboards, not resolution. DNS keeps working when this pod does not.
{{ pod_shell('homelab-best-effort', run_as_user=puid, run_as_group=pgid, non_root=true) }}
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: pihole-exporter
          image: {{ pihole_exporter_k8s_image }}
          imagePullPolicy: IfNotPresent
{{ hardened_security_context(read_only=true, non_root=true) }}
          env:
            - name: TZ
              value: "{{ tz }}"
            - name: PIHOLE_HOSTNAME
              value: "{{ pihole_exporter_k8s_targets | join(',') }}"
            - name: PIHOLE_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: pihole-env
                  key: FTLCONF_webserver_api_password
            - name: PIHOLE_PORT
              value: "{{ container_item.port | default(80) }}"
            - name: PIHOLE_PROTOCOL
              value: http
            - name: PORT
              value: "{{ services | metrics_port('pihole') }}"
          ports:
            - name: metrics
              containerPort: {{ services | metrics_port('pihole') }}
          # tcpSocket, not httpGet /metrics: a metrics probe under a 300s period is refused by a
          # test.
          livenessProbe:
            tcpSocket:
              port: {{ services | metrics_port('pihole') }}
            initialDelaySeconds: 10
            periodSeconds: 30
            failureThreshold: 3
          readinessProbe:
            tcpSocket:
              port: {{ services | metrics_port('pihole') }}
            initialDelaySeconds: 3
            periodSeconds: 10
{{ container_resources(cpu_limit=pihole_exporter_k8s_cpu_limit, mem_limit=pihole_exporter_k8s_mem_limit, cpu_request=pihole_exporter_k8s_cpu_request, mem_request=pihole_exporter_k8s_mem_request) }}
