{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: headlamp
  namespace: {{ k8s_namespace }}
spec:
{{ spec_shell('RollingUpdate') }}
  replicas: 1
  selector:
    matchLabels:
      app: headlamp
  template:
    metadata:
      labels:
        app: headlamp
        # Opted OUT of the namespace baseline: networkpolicy.yaml.j2 is tighter, and the baseline is
        # additive.
        netpol-baseline-exempt: "true"
    spec:
      # The credential the -unsafe-use-service-account-token flag below reads. Nothing may
      # mount under /run/secrets or /var/run/secrets here — that shadows the projected token
      # and the container never starts (the no-mount-shadows-the-serviceaccount-token row of
      # tests/k8s/rendered_properties/_workload_property_rows.py).
      #
      # STAYS TRUE under OIDC, where the token no longer authenticates anyone. `-in-cluster`
      # calls rest.InClusterConfig(), which reads the API server address and the cluster CA
      # from this same projected mount and ERRORS without it — the pod would not start at all.
{{ pod_shell('homelab-best-effort', service_account='headlamp', automount=true, run_as_user=headlamp_k8s_uid, run_as_group=headlamp_k8s_gid, non_root=true) }}
{{ node_affinity_preference('daniel-server') }}
{% if headlamp_k8s_plugins %}
      initContainers:
        # `set -eu` plus `sha256sum -c` make a bad download a failed pod start, never a silently
        # plugin-less dashboard. Rendered only when headlamp_k8s_plugins is non-empty.
        - name: fetch-plugins
          image: {{ headlamp_k8s_netpol_probe_image }}
          imagePullPolicy: IfNotPresent
          command:
            - sh
            - -c
            - |
              set -eu
              cd /tmp
{% for plugin in headlamp_k8s_plugins %}
              wget -q -O {{ plugin.name }}.tgz "https://github.com/headlamp-k8s/plugins/releases/download/{{ plugin.name }}-{{ plugin.version }}/{{ plugin.asset_prefix | default('') }}{{ plugin.name }}-{{ plugin.version }}.tar.gz"
              echo "{{ plugin.sha256 }}  {{ plugin.name }}.tgz" | sha256sum -c -
              tar xzf {{ plugin.name }}.tgz -C /headlamp/plugins
              echo "installed plugin {{ plugin.name }} {{ plugin.version }}"
{% endfor %}
{{ hardened_security_context(read_only=true) }}
          volumeMounts:
            - name: headlamp-plugins
              mountPath: /headlamp/plugins
            - name: headlamp-tmp
              mountPath: /tmp
{{ container_resources(cpu_limit='250m', mem_limit='64Mi', cpu_request='10m', mem_request='16Mi') }}
{% endif %}
      containers:
        - name: headlamp
          image: {{ headlamp_k8s_image }}
          imagePullPolicy: IfNotPresent
          args:
            - "-in-cluster"
            - "-in-cluster-context-name=main"
            - "-plugins-dir=/headlamp/plugins"
            - "-session-ttl={{ headlamp_k8s_session_ttl }}"
{% if headlamp_k8s_oidc_enabled %}
            # The SA-token flag is absent in this branch on purpose: the two are alternatives, and
            # both set would keep the SA's identity for API calls beside a sign-in button.
            # Every value must agree with something outside this role: the client id with Authelia's
            # client and the API server's `audiences`, the issuer with one of its `jwt` issuers.
            # The callback is derived per request.
            - "-oidc-client-id={{ headlamp_k8s_oidc_client_id }}"
            - "-oidc-idp-issuer-url={{ headlamp_k8s_oidc_issuer_url }}"
            - "-oidc-scopes={{ headlamp_k8s_oidc_scopes }}"
{% if headlamp_k8s_oidc_callback_url %}
            # Omitting the flag is NOT the same as passing it empty: blank lets Headlamp build the
            # callback per request, which serves both hostnames; `-oidc-callback-url=` sets the
            # empty string.
            - "-oidc-callback-url={{ headlamp_k8s_oidc_callback_url }}"
{% endif %}
            - "-oidc-use-pkce"
{% else %}
            # The flag makes Headlamp use its own mounted token instead of asking for one per
            # session.
            # Upstream names it "unsafe" because it removes Headlamp's authentication;
            # it is correct here only because Authelia forward-auth is the perimeter and the SA is
            # read-only with no secrets or exec (rbac.yaml.j2).
            - "-unsafe-use-service-account-token"
{% endif %}
{% if headlamp_k8s_oidc_enabled %}
          # The client secret is an ENV var, not an arg: args are part of the pod spec, which the
          # read-only ServiceAccount can read via `kubectl get deploy`.
          env:
            - name: HEADLAMP_CONFIG_OIDC_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: headlamp-oidc
                  key: client_secret
{% endif %}
          ports:
            - containerPort: {{ container_item.port }}
{{ hardened_security_context(read_only=true) }}
          volumeMounts:
            # Headlamp writes its generated kubeconfig under its XDG config dir, which
            # readOnlyRootFilesystem makes EROFS.
            - name: headlamp-config
              mountPath: /home/headlamp/.config
            - name: headlamp-tmp
              mountPath: /tmp
            - name: headlamp-plugins
              mountPath: /headlamp/plugins
              readOnly: true
          readinessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
            initialDelaySeconds: 15
            periodSeconds: 30
{{ container_resources(cpu_limit=headlamp_k8s_cpu_limit, mem_limit=headlamp_k8s_mem_limit, cpu_request=headlamp_k8s_cpu_request, mem_request=headlamp_k8s_mem_request) }}
      volumes:
        - name: headlamp-config
          emptyDir: {}
        - name: headlamp-tmp
          emptyDir: {}
        - name: headlamp-plugins
          emptyDir: {}
