{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: valheim
  namespace: {{ k8s_namespace }}
spec:
  # Recreate: RWO claims deadlock a rolling update, and two servers must never write one world.
{{ spec_shell('Recreate') }}
  # No `replicas:`: deploy.local's Games panel owns the count (ADR-0033); Flux would reset it.
  # progressDeadlineSeconds equals Flux's timeout (manifests_rollout_timeout).
  progressDeadlineSeconds: {{ valheim_k8s_rollout_timeout[:-1] | int }}
  selector:
    matchLabels:
      app: valheim
  template:
    metadata:
      labels:
        app: valheim
        netpol-baseline: enforced
    spec:
      # Pinned to the VIP-announcing node: with externalTrafficPolicy Local, a pod on the other node
      # makes the announcer drop LAN traffic while the pod reports healthy. Moves only with the
      # L2Advertisement nodeSelector.
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_primary_node }}
{{ pod_shell('homelab-standard') }}
      # Both locations: /config/bepinex/plugins survives updates; /opt/valheim/bepinex is what
      # loads.
      # Wipe-then-copy into `homelab/`, so dropping a mod from valheim_k8s_mods removes its DLL.
{% if valheim_k8s_mods %}
      initContainers:
        - name: mods
          image: {{ valheim_k8s_mods_image }}
          # Always: the image is pushed to a mutable :latest, so a cached one hides a mod bump.
          imagePullPolicy: Always
          command:
            - sh
            - -eu
            - -c
            - |
              cfg=/config/bepinex/plugins/homelab
              rm -rf "$cfg"
              mkdir -p "$cfg"
              cp /mods/*.dll "$cfg/"
              live=/opt/valheim/bepinex/BepInEx/plugins
              if [ -d "$live" ]; then
                rm -rf "$live/homelab"
                mkdir -p "$live/homelab"
                cp /mods/*.dll "$live/homelab/"
              fi
              echo "installed plugins:"
              ls -l "$cfg"
{{ hardened_security_context() }}
{{ container_resources(cpu_limit='200m', mem_limit='64Mi', cpu_request='10m', mem_request='16Mi') }}
          volumeMounts:
            - name: valheim-config
              mountPath: /config
            - name: valheim-server
              mountPath: /opt/valheim
{% endif %}
      containers:
        - name: valheim
          image: {{ valheim_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: game
              containerPort: 2456
              protocol: UDP
            - name: query
              containerPort: 2457
              protocol: UDP
          env:
            - name: SERVER_NAME
              value: "{{ valheim_k8s_server_name }}"
            - name: WORLD_NAME
              value: "{{ valheim_k8s_world_name }}"
            - name: SERVER_PUBLIC
              value: "{{ valheim_k8s_server_public }}"
            - name: ADMINLIST_IDS
              value: "{{ valheim_k8s_admin_ids }}"
            - name: SERVER_ARGS
              value: "{{ valheim_k8s_server_args }}"
            - name: TZ
              value: "{{ tz }}"
            # The image creates plugins and patchers itself. Do not add a PRE_BEPINEX_CONFIG_HOOK
            # `mkdir -p "$plugins_path"`: the variable no longer exists, so it runs `mkdir -p ""`
            # and aborts.
            - name: BEPINEX
              value: "{{ valheim_k8s_bepinex }}"
            # Off the backed-up claim: zips share no bytes, so each weekly backup re-uploads them.
            # A sibling of the SteamCMD install: steamcmd only touches server/.
            - name: BACKUPS_DIRECTORY
              value: /opt/valheim/backups
            - name: SERVER_PASS
              valueFrom:
                secretKeyRef:
                  name: valheim-env
                  key: SERVER_PASS
          # SYS_NICE: Steam raises its thread priority at startup. SETGID: the container's cron
          # calls initgroups(), which needs it even as root; without it every cron job fails
          # silently (`initgroups(0) failed`).
{{ hardened_security_context(add=['SYS_NICE', 'SETGID']) }}
          volumeMounts:
            - name: valheim-config
              mountPath: /config
            - name: valheim-server
              mountPath: /opt/valheim
          # UDP has no LISTEN state: grep a bound :2456 (hex 0998) socket, not touching the game
          # protocol.
          # Both tables: the server binds v6, so the socket appears only in /proc/net/udp6.
          startupProbe:
            exec:
              command: ["sh", "-c", "grep -q ':0998 ' /proc/net/udp /proc/net/udp6"]
            periodSeconds: 15
            # 15 min: the first boot downloads ~1.8 G through SteamCMD before anything binds.
            failureThreshold: 60
          livenessProbe:
            exec:
              command: ["sh", "-c", "grep -q ':0998 ' /proc/net/udp /proc/net/udp6"]
            periodSeconds: 30
            failureThreshold: 4
          # Room for the shutdown save instead of SIGKILL at the default 30s.
{{ container_resources(cpu_limit=valheim_k8s_cpu_limit, mem_limit=valheim_k8s_mem_limit, cpu_request=valheim_k8s_cpu_request, mem_request=valheim_k8s_mem_request) }}
      terminationGracePeriodSeconds: 120
      volumes:
        - name: valheim-config
          persistentVolumeClaim:
            claimName: {{ valheim_k8s_claim }}
        - name: valheim-server
          persistentVolumeClaim:
            claimName: {{ valheim_k8s_server_claim }}
