---
# On the node's own address: the router's port-forward targets only DHCP/ARP-known devices.
# Raw UDP, no Traefik: the password is the only access control. Never publish 9001 (supervisord).
apiVersion: v1
kind: Service
metadata:
  name: valheim
  namespace: {{ k8s_namespace }}
spec:
  # LoadBalancer: externalTrafficPolicy needs an external type; traffic arrives on the externalIP.
  type: LoadBalancer
  externalTrafficPolicy: Local
  externalIPs:
    - {{ hosts[k8s_primary_node].server_ip }}
  selector:
    app: valheim
  ports:
    - name: game
      port: 2456
      targetPort: 2456
      protocol: UDP
    - name: query
      port: 2457
      targetPort: 2457
      protocol: UDP
