{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: peanut
  namespace: {{ k8s_namespace }}
spec:
{{ spec_shell('RollingUpdate') }}
  replicas: 1
  selector:
    matchLabels:
      app: peanut
  template:
    metadata:
      labels:
        app: peanut
        netpol-baseline: enforced
    spec:
      # No runAsUser: the image's own non-root user serves the page. fsGroup, a supplementary group,
      # makes the /app/config emptyDir group-writable without knowing that UID.
{{ pod_shell('homelab-best-effort', fs_group=1000) }}
      # PeaNUT writes /config, so a read-only subPath mount fails with EROFS; seed a writable
      # emptyDir.
      initContainers:
        - name: seed-config
          # alpine, not the app image: peanut's image has no cp (StartError at start).
          image: {{ peanut_k8s_init_image }}
          imagePullPolicy: IfNotPresent
          command: ["cp", "/config-seed/settings.yml", "/config/settings.yml"]
{{ hardened_security_context(read_only=true) }}
          volumeMounts:
            - name: peanut-settings
              mountPath: /config-seed
              readOnly: true
            - name: peanut-config
              mountPath: /config
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: peanut
          image: {{ peanut_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{ container_item.port }}
{{ hardened_security_context(read_only=true) }}
          env:
            - name: TZ
              value: "{{ tz }}"
            - name: WEB_USERNAME
              valueFrom:
                secretKeyRef:
                  name: peanut-secrets
                  key: WEB_USERNAME
            - name: WEB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: peanut-secrets
                  key: WEB_PASSWORD
          volumeMounts:
            # Writable /config seeded with settings.yml by the init container above.
            - name: peanut-config
              mountPath: /config
            # auth.yaml is regenerated at every boot, so /app/config must be writable scratch.
            - name: peanut-app-config
              mountPath: /app/config
          readinessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
            initialDelaySeconds: 15
            periodSeconds: 30
{{ container_resources(cpu_limit=peanut_k8s_cpu_limit, mem_limit=peanut_k8s_mem_limit, cpu_request=peanut_k8s_cpu_request, mem_request=peanut_k8s_mem_request) }}
      volumes:
        - name: peanut-settings
          secret:
            secretName: peanut-secrets
            items:
              - key: settings.yml
                path: settings.yml
        - name: peanut-app-config
          emptyDir: {}
        - name: peanut-config
          emptyDir: {}
