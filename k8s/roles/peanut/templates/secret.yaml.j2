---
apiVersion: v1
kind: Secret
metadata:
  name: peanut-secrets
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  WEB_USERNAME: "{{ peanut_username }}"
  WEB_PASSWORD: "{{ peanut_password }}"
  # HOST is the nut ClusterIP Service (same namespace) — the daemon moved in-cluster
  # 2026-08-14 (D6 reversed), retiring the LAN publish this used to point at.
  #
  # The login is upsd's read-only one, shared with Home Assistant's NUT integration: it reads
  # every variable and holds no upsmon role, so it cannot raise FSD. Until 2026-09-28 this was
  # the `upsmon` primary login, so anything that could read this Secret could power off both
  # nodes. A dashboard needs no more than reads.
  settings.yml: |
    NUT_SERVERS:
      - HOST: nut
        PORT: {{ peanut_k8s_nut_port }}
        USERNAME: homeassistant
        PASSWORD: {{ nut_ha_password }}
