---
apiVersion: v1
kind: Secret
metadata:
  name: peanut-secrets
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  WEB_USERNAME: "{{ peanut_username }}"
  WEB_PASSWORD: "{{ peanut_password }}"
  # Read-only upsd login, no upsmon role: the `upsmon` primary login in this Secret would let a
  # reader power off both nodes.
  settings.yml: |
    NUT_SERVERS:
      - HOST: nut
        PORT: {{ peanut_k8s_nut_port }}
        USERNAME: homeassistant
        PASSWORD: {{ nut_ha_password }}
