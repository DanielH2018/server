---
apiVersion: v1
kind: Secret
metadata:
  name: peanut-secrets
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  WEB_USERNAME: "{{ peanut_username }}"
  WEB_PASSWORD: "{{ peanut_password }}"
  # HOST is the nut ClusterIP Service (same namespace).
  #
  # The login is upsd's read-only one, shared with Home Assistant's NUT integration: it reads
  # every variable and holds no upsmon role, so it cannot raise FSD. A dashboard needs no more
  # than reads; the `upsmon` primary login would let anything that reads this Secret power off
  # both nodes.
  settings.yml: |
    NUT_SERVERS:
      - HOST: nut
        PORT: {{ peanut_k8s_nut_port }}
        USERNAME: homeassistant
        PASSWORD: {{ nut_ha_password }}
