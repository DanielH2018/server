{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'workload-shell.yml.j2' import pod_shell with context %}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: alloy
  namespace: {{ k8s_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: alloy
rules:
  - apiGroups: [""]
    resources: [pods]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: alloy
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: alloy
subjects:
  - kind: ServiceAccount
    name: alloy
    namespace: {{ k8s_namespace }}
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: alloy
  namespace: {{ k8s_namespace }}
spec:
  selector:
    matchLabels:
      app: alloy
  template:
    metadata:
      labels:
        # `app: alloy` is what netpol-baseline's loki-homelab policy and the observability
        # Prometheus job match.
        app: alloy
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-best-effort', service_account='alloy') }}
      containers:
        - name: alloy
          image: {{ loki_homelab_k8s_alloy_image }}
          imagePullPolicy: IfNotPresent
          args:
            - run
            - /etc/alloy/config.alloy
            # Alloy binds 127.0.0.1 by default; the probes and scrape need the pod IP.
            - --server.http.listen-addr=0.0.0.0:12345
            # The tailing cursor lives here — see the positions volume below.
            - --storage.path=/var/lib/alloy/data
            # Same reason Loki's config sets analytics.reporting_enabled false: Pi-hole blocks
            # stats.grafana.org and each report would spend its retry budget on a name that
            # never resolves.
            - --disable-reporting
          env:
            # A pod's own HOSTNAME is the pod name, which changes on restart and matches no node in
            # the selector.
            - name: HOSTNAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          ports:
            - name: http-metrics
              containerPort: 12345
          readinessProbe:
            httpGet:
              path: /-/ready
              port: http-metrics
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /-/ready
              port: http-metrics
            initialDelaySeconds: 60
            periodSeconds: 30
            failureThreshold: 10
          securityContext:
            runAsUser: 0
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
              add:
                # syslog and auth.log are 640 syslog-owned, so root needs DAC_READ_SEARCH to read
                # them.
                - DAC_READ_SEARCH
          volumeMounts:
            - name: alloy-config
              mountPath: /etc/alloy
            - name: alloy-varlog
              mountPath: /var/log
              readOnly: true
            - name: alloy-positions
              mountPath: /var/lib/alloy/data
{% if k3s_audit_log_enabled | default(false) %}
            - name: k8s-audit
              mountPath: {{ k3s_audit_log_dir }}
              readOnly: true
{% endif %}
{{ container_resources(cpu_limit='1', mem_limit='384Mi', cpu_request='50m', mem_request='128Mi') }}
      volumes:
        - name: alloy-config
          configMap:
            name: loki-homelab-config
            items:
              - key: config.alloy
                path: config.alloy
        - name: alloy-varlog
          hostPath:
            path: /var/log
        - name: alloy-positions
          hostPath:
            # A directory of its own: Alloy cannot read Promtail's positions.yaml.
            path: /var/lib/alloy-positions
            type: DirectoryOrCreate
{% if k3s_audit_log_enabled | default(false) %}
        - name: k8s-audit
          hostPath:
            path: {{ k3s_audit_log_dir }}
            # DirectoryOrCreate, not Directory: daniel-server has no apiserver directory, and
            # Directory would stick its pod in ContainerCreating.
            type: DirectoryOrCreate
{% endif %}
