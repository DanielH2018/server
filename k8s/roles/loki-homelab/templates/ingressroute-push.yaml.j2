{% from 'ingressroute.yml.j2' import monitoring_route with context %}
---
{# Separate router from ingressroute.yaml.j2: the Pi gets `/loki/api/v1/push` only, with no delete or
   query.
   Push is a write on an unauthenticated store, trusted by source address; replace with a credential
   if Loki gains auth. #}
{{ monitoring_route(
    container_item.name ~ '-push',
    container_item.hostname | default(container_item.name),
    container_item.port,
    '/loki/api/v1/push',
    extra_client_cidrs=[k8s_pi_client_ip ~ '/32'],
    service_name=container_item.name
  )
}}
