// Grafana Alloy config for the cluster log shipper (KL3). Rendered by Ansible into the
// loki-homelab ConfigMap as `config.alloy` and read by alloy-daemonset.yaml.j2 on both nodes.
//
// The labels this file emits are a contract: monitor-bridge's LogQL selectors, terraria-stats'
// and valheim-stats' `{container="…"}` queries and the `{job="syslog"}` deploy annotation on
// every Grafana dashboard were written against `job`, `container`, `pod`, `namespace`,
// `machine` and `stream` — and against the ABSENCE of `app`, which is how the HA ban check
// went blind on 2026-08-23. The `alloy-emits-the-loki-labels-consumers-select-on` row of
// tests/k8s/rendered_properties/_config_property_rows.py guards the set. The host streams also carry
// `program`, the rsyslog tag the `loki.process "host"` stage extracts.
//
// Replaced Promtail on 2026-09-02, six months after Promtail's 2026-03-02 end of life. Three
// things Promtail did implicitly are explicit here: node scoping is a field selector (Alloy
// has no `__host__` filter); the positions cursor lives under --storage.path in Alloy's own
// format (a first start re-tails each current file from offset 0, which Loki dedupes where
// timestamp and line match); and the env lookup is sys.env() rather than -config.expand-env.

logging {
  level = "warn"
}

loki.write "homelab" {
  endpoint {
    url = "http://loki-homelab:3100/loki/api/v1/push"
  }
}

// ---- Cluster pod logs: this node's pods only. ------------------------------------------
// HOSTNAME is the downward-API nodeName (see the DaemonSet). Without the field selector every
// node discovers every pod, tails the other node's /var/log/pods paths, finds nothing there,
// and warns about each missing file on every refresh.
discovery.kubernetes "pods" {
  role = "pod"
  selectors {
    role  = "pod"
    field = "spec.nodeName=" + sys.env("HOSTNAME")
  }
}

discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
  rule {
    target_label = "job"
    replacement  = "{{ loki_streams.cluster_pods.job }}"
  }
  // The node name, mirroring the prometheus origin convention — one config, both nodes.
  rule {
    target_label = "machine"
    replacement  = sys.env("HOSTNAME")
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
    separator     = "/"
    target_label  = "__path__"
    replacement   = "/var/log/pods/*$1/*.log"
  }
}

local.file_match "pods" {
  path_targets = discovery.relabel.pods.output
}

loki.source.file "pods" {
  targets    = local.file_match.pods.targets
  forward_to = [loki.process.pods.receiver]
}

loki.process "pods" {
  forward_to = [loki.write.homelab.receiver]

  // Strip containerd's per-line envelope ("<rfc3339> stdout F <message>") so what lands in
  // Loki is the application's own line. Without it a START-ANCHORED parser keeps matching and
  // captures the envelope as payload: measured 2026-08-13, terraria-stats' join regex turned
  // "Ben" into "2026-08-13T21:14:28.159801911Z stdout F Ben", one new player per join.
  stage.cri {}

  // Drop routine Traefik access lines — ~172 MB/day measured 2026-08-29, of which nothing
  // reads 2xx/3xx out of Loki (every Traefik panel and bridge check is Prometheus-backed).
  //
  // THIS DOES NOT TOUCH CROWDSEC. The crowdsec agent sidecar tails /var/log/traefik/access.log
  // directly; this stage reads the access-log-rotate sidecar's STDOUT copy of the same file,
  // so a drop here is invisible to the WAF. Scoped to that container name and nothing else.
  //
  // A person's 302 is KEPT, because Authelia redirects are the cheapest evidence of an auth
  // loop. A 302 from a pod address is dropped: blackbox-exporter's http_sso_302 module probes
  // every SSO-gated name each minute and was ~35,000 of ~37,000 302s a day. A person arrives
  // from the LAN or through Cloudflare, never from the pod CIDR, and a Cloudflare request's
  // ClientHost is a comma-separated chain, which the pod-address pattern cannot match.
  //
  // The routine expression pairs a status with a sub-second Duration (nanoseconds, at most 9
  // digits). Traefik emits fields alphabetically, which puts ClientHost before
  // DownstreamStatus and DownstreamStatus before Duration.
  //
  // The counter this bumps is loki_process_dropped_lines_total, NOT the
  // loki_write_dropped_entries_total that monitor-bridge's dropped-entries check watches at
  // 1000/hour — a deliberate drop here cannot self-page as shipping loss.
  stage.match {
    selector = "{container=\"access-log-rotate\"}"
    stage.drop {
      expression          = "\"DownstreamStatus\":(200|204|304),.*\"Duration\":[0-9]{1,9},"
      drop_counter_reason = "traefik_routine_access_log"
    }
{# The pod CIDR is a /16, so its first two octets are the whole network prefix. #}
    stage.drop {
      expression          = "\"ClientHost\":\"{{ k3s_pod_cidr.split('.')[:2] | join('[.]') }}[.][0-9.]+\",.*\"DownstreamStatus\":302,"
      drop_counter_reason = "traefik_pod_probe_302"
    }
  }

  // Drop the Flux controllers' routine success lines, 94% of their volume measured 2026-11-19.
  // Only info lines go: a warning, an error, an apply that changed an object and a dispatched
  // failure event still ship. A stuck dependency stays visible through `probe.py flux`.
  // `--log-level=error` would hide the warnings too, so the cut is here.
  stage.match {
    selector = "{namespace=\"flux-system\", container=\"manager\"}"
    stage.drop {
      expression          = "^\\{\"level\":\"info\",[^}]*\"msg\":\"(?:Reconciliation finished in [^\"]*|artifact up-to-date with remote revision: [^\"]*|All dependencies are ready, proceeding with reconciliation|Dependencies do not meet ready condition, retrying in [^\"]*|event dropped for commit status providers due to missing commit metadata key)\""
      drop_counter_reason = "flux_routine_reconcile"
    }
    stage.drop {
      expression          = "^\\{\"level\":\"info\",.*\"msg\":\"dispatching event\",.*\"message\":\"(?:Reconciliation finished in [^\"]*|Dependencies do not meet ready condition, retrying in [^\"]*)\"\\}$"
      drop_counter_reason = "flux_routine_event"
    }
    stage.drop {
      expression          = "^\\{\"level\":\"info\",.*\"msg\":\"server-side apply completed\",.*\"output\":\\{(?:\"[^\"]+\":\"unchanged\",?)+\\}"
      drop_counter_reason = "flux_unchanged_apply"
    }
  }

  // Drop the CrowdSec LAPI's routine info lines, 91% of its volume measured 2026-11-19: the
  // AppSec allowlist skips and the 2xx access lines of agent and bouncer calls. A global
  // warn level would also hide the ban and `WAF block:` lines, which log at info.
  stage.match {
    selector = "{namespace=\"{{ k8s_namespace }}\", container=\"crowdsec\"}"
    stage.drop {
      expression          = "^time=\"[^\"]*\" level=info msg=\"[^\"]* is allowlisted by [^\"]*, skipping WAF processing\" module=acquisition[.]appsec "
      drop_counter_reason = "crowdsec_allowlisted_waf_skip"
    }
    stage.drop {
      expression          = "^time=\"[^\"]*\" level=info msg=\"[^ ]+ - \\[[^\\]]*\\] \\\\\"[A-Z]+ /v1/[^ ]* HTTP/1[.]1 2[0-9][0-9] .*\" module=lapi$"
      drop_counter_reason = "crowdsec_lapi_routine_access"
    }
  }

  // Redact the Google Cast user's refresh_token out of Home Assistant's lines (issue #3015).
  // HA formats the `cast_show_view` signal args into the message whenever a cast fails in
  // `_handle_signal_show_view`, and those args carry the cast system user's refresh_token in
  // plaintext. `homeassistant.util.logging` is not silenced, so the record reaches Loki, where
  // anyone with the LAN route can read a live HA API credential out of a 744h store.
  //
  // This REPLACES, it does not drop: `stage.replace` substitutes only the CAPTURE GROUP, so the
  // rest of the record survives intact. That is load-bearing — `docs/platform.md` tells the
  // operator to query `|= "_handle_signal_show_view"` to catch a cast that timed out on a worker
  // thread, and a stage that ate the marker would break the one detection query that still
  // works. No line is dropped, so no dropped-lines counter moves.
  //
  // The key appears as a Python dict repr (`'refresh_token': '<64 hex>'`); the class also
  // accepts the JSON spelling. The `{32,}` floor keeps `'refresh_token': None` unmatched.
  //
  // Prospective only. Records already in Loki keep the token until the 744h retention window
  // expires, and HA's own `system_log` / `/api/error_log` are upstream of this stage —
  // `probe.py` redacts those on the way out (probe_lib/core.py:redact_log_secrets).
  stage.match {
    selector = "{container=\"home-assistant\"}"
    stage.replace {
      expression = "refresh_token[\"']?: ?[\"']?([0-9a-f]{32,})"
      replace    = "<redacted>"
    }
  }

  // Redact Prowlarr's API key out of the *arr lines (issue #6276). Sonarr and Radarr log every
  // failed Torznab call with its full request URL, and that URL carries Prowlarr's key as
  // `apikey=<32 hex>`. As above, only the capture group goes, so the indexer name and the search
  // type a Torznab failure is diagnosed by survive. The class takes upper-case hex as well.
  // Prospective only: probe.py redacts the records already in Loki on the way out.
  stage.match {
    selector = "{container=~\"sonarr|radarr|prowlarr|bazarr\"}"
    stage.replace {
      expression = "apikey=([0-9a-fA-F]{32})"
      replace    = "<redacted>"
    }
  }

  // Redact the token half of any Discord webhook URL. Flux's notification-controller logs the
  // full URL when a post fails, and the token alone lets its holder post to the alert channel.
  // Unscoped: Alertmanager, CrowdSec, monitor-bridge and the *arr notification checks hold
  // Discord webhook URLs too. The numeric id half stays, so the channel is still identifiable.
  stage.replace {
    expression = "discord(?:app)?\\.com/api/webhooks/[0-9]+/([A-Za-z0-9_-]{20,})"
    replace    = "<redacted>"
  }

  // Redact the Home Assistant webhook id from Traefik's access lines. A mobile_app registration's
  // id authenticates the companion app, and an unencrypted one can call any HA service. Only the
  // id goes, so the route, status and client of a failed webhook POST stay readable. CrowdSec
  // reads the raw access-log file, not this stdout copy, so the WAF still sees the full path.
  stage.match {
    selector = "{container=\"access-log-rotate\"}"
    stage.replace {
      expression = "/api/webhook/([0-9A-Za-z_-]{16,})"
      replace    = "<redacted>"
    }
  }

  // Redact PeaNUT's session-signing secret, which it prints at every start: `Generated new
  // AUTH_SECRET: <secret>` when the env var is unset, `AUTH_SECRET already exists: <secret>`
  // when it is set (upstream src/server/auth-config.ts). Setting AUTH_SECRET therefore does not
  // stop the line; this stage is the only fix.
  stage.match {
    selector = "{container=\"peanut\"}"
    stage.replace {
      expression = "AUTH_SECRET(?: already exists)?: ([A-Za-z0-9+/=]+)"
      replace    = "<redacted>"
    }
  }

  // Redact credential-bearing query parameters out of Traefik's access log. The sidecar's
  // stdout copy carries the full request line in `RequestPath`, query string included. As
  // above, only the capture group goes, so the parameter name stays countable and the rest of
  // the record survives. A value ends at `&`, a quote, whitespace, a backslash or the end of
  // the line; the backslash covers the `\u0026` that Go's JSON encoder writes for `&`. The
  // prefix is a non-capturing group because RE2 has no lookbehind and a second capture group
  // would be replaced too. Prospective only: probe.py redacts the records already in Loki
  // (probe_lib/core.py:redact_log_secrets), and
  // tests/k8s/alloy/test_alloy_redacts_access_log_query_credentials.py holds the two lists
  // equal.
  //
  // The Subsonic credentials `u`, `t`, `s` and `p` are redacted under /rest/ only, because a
  // bare `p=` is pagination on other paths. RE2 cannot scope a match without consuming it, and
  // a match that starts at the path ends at its value, so each name gets its own stage: one
  // alternation would redact the first parameter on a URL and skip the rest.
  stage.match {
    selector = "{container=\"access-log-rotate\"}"
    stage.replace {
      expression = "(?i)(?:[?&]|u0026)(?:api_key|apikey|access_token|token|code)=([^&\"\\s\\\\]+)"
      replace    = "<redacted>"
    }
    stage.replace {
      expression = "\"RequestPath\":\"/rest/[^\"\\s]*(?:[?&]|u0026)u=([^&\"\\s\\\\]+)"
      replace    = "<redacted>"
    }
    stage.replace {
      expression = "\"RequestPath\":\"/rest/[^\"\\s]*(?:[?&]|u0026)t=([^&\"\\s\\\\]+)"
      replace    = "<redacted>"
    }
    stage.replace {
      expression = "\"RequestPath\":\"/rest/[^\"\\s]*(?:[?&]|u0026)s=([^&\"\\s\\\\]+)"
      replace    = "<redacted>"
    }
    stage.replace {
      expression = "\"RequestPath\":\"/rest/[^\"\\s]*(?:[?&]|u0026)p=([^&\"\\s\\\\]+)"
      replace    = "<redacted>"
    }
  }

  // Normalise the line's own level into a `level` structured-metadata field, never a label, so
  // `{namespace="homelab"} | level="error"` works across formats without adding streams. Each
  // shape keys on the format's level token, never on a bare word, which is how Loki's own
  // detected_level tags a `[WRN] ... error receiving data` line as an error. The shapes:
  // logfmt and logrus (`level=INFO`, `level="warn"`), JSON (`"level":"info"`), loguru
  // (`| DEBUG    |`), an ANSI-coloured token (`<ESC>[32minfo<ESC>[39m`), a bracketed token
  // (`[WRN]`, `[error]`), a token right after a leading timestamp (zap console, Python logging,
  // Home Assistant) and klog's `E1119 ` prefix. A line that matches none carries no field.
  //
  // The stages run from least to most severe and each overwrites the last, so a line holding
  // two tokens is filed under the worse one. Selectors avoid backslashes and quotes, as the k3s
  // stage below explains: `.` stands in for each JSON quote and for the ANSI escape byte.
{% set pod_levels = [
  ('debug', 'debug|debu|dbg|trace|trac|trc', ''),
  ('info', 'info|inf|information|notice', 'I'),
  ('warn', 'warn|warning|wrn', 'W'),
  ('error', 'error|erro|err|eror', 'E'),
  ('fatal', 'fatal|fata|ftl|critical|crit|panic|pani|dpanic|emerg', 'F'),
] %}
{% for name, words, klog in pod_levels %}
  stage.match {
    selector = "{namespace=~\".+\"} |~ \"(?i)(^|[^a-z_])level *(=|.:) *.?({{ words }})([^a-z]|$)|[|] *({{ words }}) *[|]|.[[][0-9;]*m *({{ words }}).[[]|[[]({{ words }})[]]|^(.[[][0-9;]*m)?[0-9]{4}-[0-9]{2}-[0-9]{2}[ T][0-9:.,+-]+Z?[^a-z0-9]+({{ words }})([^a-z]|$){% if klog %}|^{{ klog }}[0-9]{4} [0-9]{% endif %}\""
    stage.template {
      source   = "level"
      template = "{{ name }}"
    }
  }
{% endfor %}

  stage.structured_metadata {
    values = {
      level = "",
    }
  }
}

// ---- Host files. Root + DAC_READ_SEARCH in the DaemonSet exist for these. ---------------
// Same job labels on both nodes so monitor-bridge's freshness arm sees them together.
local.file_match "syslog" {
  path_targets = [{"__path__" = "/var/log/syslog", "job" = "{{ loki_streams.host_syslog.job }}", "machine" = sys.env("HOSTNAME")}]
}

loki.source.file "syslog" {
  targets    = local.file_match.syslog.targets
  forward_to = [loki.process.host.receiver]
}

local.file_match "authlog" {
  path_targets = [{"__path__" = "/var/log/auth.log", "job" = "{{ loki_streams.host_authlog.job }}", "machine" = sys.env("HOSTNAME")}]
}

loki.source.file "authlog" {
  targets    = local.file_match.authlog.targets
  forward_to = [loki.process.host.receiver]
}

// Label each host line with its rsyslog program tag (issue #6163), so the HostLogErrors rule
// in files/rules/homelab-logs.yaml can count error lines per program. rsyslog writes
// "<rfc3339> <host> <tag>[<pid>]: <msg>", and the capture stops at `[`, `:` or a space, so
// `uv[1333]:` labels as `uv` and `postfix/qmgr[812]:` as `postfix/qmgr`. Measured 2026-10-24,
// 26 distinct tags on daniel-server and 64 on daniel-box, so the label stays low-cardinality.
//
// THE LINE IS NOT REWRITTEN. stage.regex only fills the extracted map and stage.labels only
// promotes a key to a label; there is no stage.output or stage.replace here. The line filters in
// files/rules/homelab-logs.yaml and the `event=deploy` and `event=landing` logfmt queries read the
// raw rsyslog line, so a stage that changed it could blind them.
// A line the expression does not match passes unlabelled.
loki.process "host" {
  forward_to = [loki.write.homelab.receiver]

  stage.regex {
    expression = "^\\S+ \\S+ (?P<program>[^\\[:\\s]+)"
  }

  stage.labels {
    values = { program = "" }
  }
}

// k3s's own output, warnings and worse only (issue #6177). The k3s units write it to a file
// because journald stores nothing below notice and every k3s line is priority info (the
// header of hosts/components/k3s-server/templates/50-homelab.conf.j2 says why). That file keeps
// 4 rotations, so without this a crash loop's reason was gone within days. Both nodes write
// the same path, the `k3s_log_file` default of the `k3s-server` and `k3s-agent` components
// (hosts/components/). The k8s render cannot read a component's defaults, so this is a literal,
// which test_alloy_ships_k3s_log.py holds equal to both.
//
// The exact file, never `k3s.log*`: a glob would tail the rotated `.1` and the `.gz` files.
// logrotate rotates with `copytruncate`, and the tailer resets to offset 0 on a size shrink.
local.file_match "k3s" {
  path_targets = [{"__path__" = "/var/log/k3s.log", "job" = "{{ loki_streams.host_k3s.job }}", "machine" = sys.env("HOSTNAME")}]
}

loki.source.file "k3s" {
  targets    = local.file_match.k3s.targets
  forward_to = [loki.process.k3s.receiver]
}

// Measured 2026-10-29 over one day's k3s.log.1: 39444 lines (7.3 MB) on daniel-box and 49707
// (10.0 MB) on daniel-server. The two stages below keep 1481 and 1389 lines (0.5 and 0.6 MB).
loki.process "k3s" {
  forward_to = [loki.write.homelab.receiver]

  // Keep a line only when it carries a warn-or-worse level, in one of the four shapes k3s
  // writes: klog (`W1029 12:00:00.1 1234 file.go:1] …`, also E and F), logrus
  // (`time="…" level=error msg=…`), embedded etcd's zap JSON (`{"level":"warn",…}`), and the Go
  // runtime's own `panic: ` and `fatal error: ` lines, which carry no level. stage.drop cannot
  // say "drop what does NOT match", because RE2 has no negative lookahead, so a match stage with
  // a negated line filter does it.
  //
  // THE FILTER VALUE IS A DOUBLE-QUOTED LogQL STRING, NEVER A BACKTICK ONE. Alloy's match-stage
  // parser rejects a backtick string ("unexpected IDENTIFIER, expecting STRING"), though Loki
  // and lokitool accept it: that crash-looped the DaemonSet on 2026-10-29. Inside the double
  // quotes a backslash is an escape and a quote ends the string, so neither regex holds either
  // one. A `.` stands in for each JSON quote, and `[^ ]*` for logrus's quoted time.
  //
  // A continuation line (a tab-indented error, a ` > key=value` klog tail or a stack
  // frame) is dropped with the info lines; the header line it belongs to is kept.
  stage.match {
    selector            = "{job=\"{{ loki_streams.host_k3s.job }}\"} !~ \"^[WEF][0-9]{4} |^time=[^ ]* level=(warning|error|fatal|panic)|^[{].level.:.(warn|error|dpanic|panic|fatal).|^panic: |^fatal error: \""
    action              = "drop"
    drop_counter_reason = "k3s_below_warn"
  }

  // kube-router warns once per IPv6 ipBlock of the traefik NetworkPolicy on every policy sync,
  // because the cluster is single-stack IPv4: 29400 of daniel-box's 29688 klog warnings in the
  // measured day, and 29701 lines on daniel-server. Shipping it would be the volume the
  // warnings-only filter above keeps k3s out of Loki for. Only that one message is dropped. A match
  // stage rather than a bare stage.drop: test_traefik_access_log_drop.py holds every stage.drop
  // in this file inside a stage.match, so no drop can reach the pod pipeline unscoped.
  stage.match {
    selector            = "{job=\"{{ loki_streams.host_k3s.job }}\"} |~ \"^W[0-9]{4} .* policy[.]go:[0-9]+[]] Ignoring IPv6 source IP blocks \""
    action              = "drop"
    drop_counter_reason = "k3s_kube_router_ipv6_ipblock"
  }
}

// auditd's log on each node (server#8250), so a write to a watched Claude Code guardrail path or
// memory store leaves a record off the host. claude-guardrail-audit, a timer in each node's host
// package, loads those watches under the keys `claude-guardrail` and `claude-memory`. Alloy runs
// as root, and /var/log is already mounted, so the 0640 root:adm file needs no new mount.
//
// The exact file, never `audit.log*`: auditd rotates by renaming to `.1` and opening a new file.
//
// One audit event is several lines that share `msg=audit(<time>:<serial>)`: a SYSCALL line
// carrying the rule's key and the process, a PATH line per file, a CWD and a PROCTITLE line.
// Query a key with `|= "key=\"claude-memory\""`, then the event's other lines by its serial.
local.file_match "host_audit" {
  path_targets = [{"__path__" = "/var/log/audit/audit.log", "job" = "{{ loki_streams.host_audit.job }}", "machine" = sys.env("HOSTNAME")}]
}

loki.source.file "host_audit" {
  targets    = local.file_match.host_audit.targets
  forward_to = [loki.process.host_audit.receiver]
}

// Measured 2026-11-13 over daniel-box's live audit.log, 27487 lines in about 10 hours: the
// kernel's BPF program loads and unloads (6000), netfilter rule changes (3276) and systemd's
// unit start and stop records (5182) carry no watch key, and neither does the SYSCALL line paired
// with a BPF or netfilter record (`key=(null)`). Dropping those keeps every record a keyed
// watch writes. A match stage per drop, because test_traefik_access_log_drop.py holds every
// stage.drop in this file inside a stage.match.
loki.process "host_audit" {
  forward_to = [loki.write.homelab.receiver]

  stage.match {
    selector            = "{job=\"{{ loki_streams.host_audit.job }}\"} |~ \"^type=(BPF|NETFILTER_CFG|SERVICE_START|SERVICE_STOP) \""
    action              = "drop"
    drop_counter_reason = "audit_unkeyed_bookkeeping"
  }

  stage.match {
    selector            = "{job=\"{{ loki_streams.host_audit.job }}\"} |~ \"^type=SYSCALL .* key=[(]null[)]\""
    action              = "drop"
    drop_counter_reason = "audit_unkeyed_syscall"
  }
}

{% if k3s_audit_log_enabled | default(false) %}
// The apiserver audit log. Only daniel-box writes one — the file lives under the k3s SERVER
// data directory and the agent node has no apiserver — but the source is declared on both
// because this is a DaemonSet with one config. On daniel-server the path matches nothing.
//
// Tailed off the host rather than read from the pod's own filesystem: the log is written by
// the apiserver, which on k3s is a process inside the k3s server, not a pod.
//
// JSON, one object per line. Left unparsed on purpose — a stage.json here would index every
// audit field as a label and blow past Loki's series limits. Query it with `| json` instead.
local.file_match "k8s_audit" {
  path_targets = [{"__path__" = "{{ k3s_audit_log_path | default('/var/lib/rancher/k3s/server/logs/audit.log') }}", "job" = "{{ loki_streams.k8s_audit.job }}", "machine" = sys.env("HOSTNAME")}]
}

loki.source.file "k8s_audit" {
  targets    = local.file_match.k8s_audit.targets
  forward_to = [loki.write.homelab.receiver]
}
{% endif %}
