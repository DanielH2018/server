---
apiVersion: v1
kind: ConfigMap
metadata:
  name: loki-homelab-config
  namespace: {{ k8s_namespace }}
data:
  loki.yaml: |
    auth_enabled: false
    analytics:
      reporting_enabled: false
    server:
      http_listen_port: 3100
      grpc_listen_port: 9096
      log_level: warn
    common:
      instance_addr: 127.0.0.1
      path_prefix: /loki
      storage:
        filesystem:
          chunks_directory: /loki/chunks
          rules_directory: /etc/loki-rules
      replication_factor: 1
      ring:
        kvstore:
          store: inmemory
    schema_config:
      configs:
        - from: 2024-01-01
          store: tsdb
          object_store: filesystem
          schema: v13
          index:
            prefix: index_
            period: 24h
    limits_config:
      retention_period: {{ loki_homelab_retention }}
      # DECIDED: the k8s-audit stream keeps 7 days, not the default window. It is about 40
      # percent of ingest on a 5Gi volume, and the apiserver's own file on daniel-box keeps
      # 30 days (k3s_audit_log_maxage).
      retention_stream:
        - selector: '{job="k8s-audit"}'
          priority: 1
          period: 168h
      max_global_streams_per_user: 5000
      ingestion_rate_mb: 50
      per_stream_rate_limit: 50MB
      reject_old_samples: false
    compactor:
      working_directory: /loki/compactor
      # Without retention_enabled the retention_period is inert; Loki 3.x requires
      # delete_request_store with it.
      retention_enabled: true
      retention_delete_delay: 2h
      delete_request_store: filesystem
    # `fake` is the tenant Loki uses when auth_enabled is false. The per-group interval in
    # files/rules/ sets query load.
    ruler:
      storage:
        type: local
        local:
          directory: /etc/loki-rules
      rule_path: /loki/rules-scratch
      alertmanager_url: http://alertmanager.{{ k8s_observability_namespace }}.svc:9093
      enable_api: true
  config.alloy: |
{{ lookup('template', role_file('templates/config/config.alloy.j2')) | indent(4, true) }}
