---
# A directly-invoked script gets only its own directory on `sys.path`, so `import stats_lib`
# resolves only because both keys sit here.
# lookup('file'), not a template: the scripts' exposition strings carry {…} braces, which Jinja
# would eat.
apiVersion: v1
kind: ConfigMap
metadata:
  name: valheim-stats-script
  namespace: {{ k8s_namespace }}
data:
  valheim_stats.py: |
{{ lookup('file', role_file('files/valheim_stats.py')) | indent(4, true) }}
  stats_lib.py: |
{{ lookup('file', role_file('files/stats_lib.py')) | indent(4, true) }}
