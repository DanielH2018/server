{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
{% from 'lsio-env.yml.j2' import lsio_env with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bazarr
  namespace: {{ k8s_namespace }}
spec:
  # The config PVC is ReadWriteOnce: a rolling update deadlocks waiting for a volume the old pod has
  # not released.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: bazarr
  template:
    metadata:
      labels:
        app: bazarr
        netpol-baseline: enforced
    spec:
      # No fsGroup: the LSIO image chowns /config itself, and fsGroup would chown the whole media
      # volume on every mount.
{{ pod_shell('homelab-standard') }}
      containers:
        - name: bazarr
          image: {{ bazarr_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{ container_item.port }}
          # The s6 privilege-drop set; no NET_BIND_SERVICE, since the port is above 1024.
{{ hardened_security_context(add=['CHOWN', 'SETUID', 'SETGID', 'FOWNER', 'DAC_OVERRIDE']) }}
          env:
{{ lsio_env() }}
          volumeMounts:
            - name: bazarr-config
              mountPath: /config
            # /data/media ONLY, via subPath: bazarr writes subtitles beside the media and never
            # imports.
            - name: media
              mountPath: /data/media
              subPath: media
          readinessProbe:
            httpGet:
              path: /ping
              port: {{ container_item.port }}
            initialDelaySeconds: 15
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /ping
              port: {{ container_item.port }}
            initialDelaySeconds: 60
            periodSeconds: 30
{{ container_resources(cpu_limit=bazarr_k8s_cpu_limit, mem_limit=bazarr_k8s_mem_limit, cpu_request=bazarr_k8s_cpu_request, mem_request=bazarr_k8s_mem_request) }}
      volumes:
        - name: bazarr-config
          persistentVolumeClaim:
            claimName: {{ bazarr_k8s_claim }}
        - name: media
          persistentVolumeClaim:
            claimName: {{ bazarr_k8s_media_claim }}
