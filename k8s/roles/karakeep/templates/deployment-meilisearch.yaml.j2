{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: karakeep-meilisearch
  namespace: {{ k8s_namespace }}
spec:
  # ReadWriteOnce PVC, single Longhorn replica: a rolling update would deadlock on the volume.
{{ spec_shell('Recreate') }}
  # The same budget as the drain's wait. See karakeep_k8s_rollout_timeout in defaults/main.yml.
  progressDeadlineSeconds: {{ karakeep_k8s_rollout_timeout[:-1] | int }}
  replicas: 1
  selector:
    matchLabels:
      app: karakeep-meilisearch
  template:
    metadata:
      labels:
        app: karakeep-meilisearch
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-standard') }}
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: meilisearch
          image: {{ karakeep_k8s_meili_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 7700
          # Drop ALL — a Rust binary on a high port whose data is its own volume.
          #
          # DECIDED: no readOnlyRootFilesystem here, though a steady-state meilisearch writes
          # only under /meili_data. MEILI_UPGRADE_DB below runs the in-place index migration on
          # exactly one start — the first after an image bump — and on no other. A read-only
          # root would therefore pass the deploy that introduces it and could still break a
          # future Renovate bump, whose recovery is a full "Reindex All Bookmarks". A change
          # whose riskiest path is structurally unexercised by the deploy that validates it is
          # the shape that lands green and is inert; the migration is the reason to decline it
          # here, not an absence of evidence about the steady state.
{{ hardened_security_context() }}
          env:
            - name: MEILI_NO_ANALYTICS
              value: "true"
            # Inert except on a version mismatch; the migration is not atomic, and recovery is
            # Reindex All Bookmarks.
            - name: MEILI_UPGRADE_DB
              value: "true"
            - name: MEILI_MASTER_KEY
              valueFrom:
                secretKeyRef:
                  name: karakeep
                  key: MEILI_MASTER_KEY
          volumeMounts:
            - name: meilisearch-data
              mountPath: /meili_data
          # /health answers 200 without the master key, so httpGet works.
          readinessProbe:
            httpGet:
              path: /health
              port: 7700
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: 7700
            initialDelaySeconds: 60
            periodSeconds: 30
{{ container_resources(cpu_limit=karakeep_k8s_meili_cpu_limit, mem_limit=karakeep_k8s_meili_mem_limit, cpu_request=karakeep_k8s_meili_cpu_request, mem_request=karakeep_k8s_meili_mem_request) }}
      volumes:
        # Starts empty and is never seeded; rebuild with Reindex All Bookmarks.
        - name: meilisearch-data
          persistentVolumeClaim:
            claimName: {{ karakeep_k8s_meili_claim }}
