{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: karakeep-chrome
  namespace: {{ k8s_namespace }}
spec:
{{ spec_shell('RollingUpdate') }}
  # The same budget as the drain's wait. See karakeep_k8s_rollout_timeout in defaults/main.yml.
  progressDeadlineSeconds: {{ karakeep_k8s_rollout_timeout[:-1] | int }}
  replicas: 1
  selector:
    matchLabels:
      app: karakeep-chrome
  template:
    metadata:
      labels:
        app: karakeep-chrome
        # Exempt from the baseline, which would admit every port and expose unauthenticated DevTools
        # on 9222.
        # networkpolicy-chrome.yaml.j2 admits app=karakeep alone.
        netpol-baseline-exempt: "true"
    spec:
{{ pod_shell('homelab-standard') }}
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: chrome
          image: {{ karakeep_k8s_chrome_image }}
          imagePullPolicy: IfNotPresent
          # Appended to the entrypoint's flags: a trailing --remote-debugging-port=9222 would
          # collide with socat on 9222, because the entrypoint puts headless-shell on 9223.
          args:
            - --disable-gpu
            - --disable-dev-shm-usage
            - --hide-scrollbars
          ports:
            - containerPort: 9222
          # uid 65534 must match the image's USER, so the API server guarantees it. Do not copy it
          # to the sibling deployments: their root-owned /data and /root/.cache/uv would break.
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=65534) }}
          volumeMounts:
            # Default medium, not Memory: --disable-dev-shm-usage files are large per tab and would
            # count against the limit.
            - name: chrome-tmp
              mountPath: /tmp
            # DECIDED: an emptyDir alone, no env var.
            # fontconfig's cache. This is the FIRST entry in the cachedir list the image's
            # fonts.conf ships, so with a read-only root and no mount here fontconfig finds
            # nothing writable — it logs `Fontconfig error: No writable cache directories`
            # once per chrome process and rescans the whole font tree on each start.
            # An emptyDir is the whole fix: fontconfig needs the directory to be writable,
            # not preserved, and one rescan per pod is what it costs. No env var goes with
            # it — the two fallbacks in that log (`$HOME/.cache/fontconfig`,
            # `$HOME/.fontconfig`, with HOME=/nonexistent for uid 65534) are only consulted
            # when this path fails, so XDG_CACHE_HOME would be redundant, and FONTCONFIG_PATH
            # names the CONFIG dir rather than the cache and would change font discovery.
            - name: chrome-fontconfig-cache
              mountPath: /var/cache/fontconfig
          readinessProbe:
            httpGet:
              path: /json/version
              port: 9222
            initialDelaySeconds: 15
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /json/version
              port: 9222
            initialDelaySeconds: 60
            periodSeconds: 30
{{ container_resources(cpu_limit=karakeep_k8s_chrome_cpu_limit, mem_limit=karakeep_k8s_chrome_mem_limit, cpu_request=karakeep_k8s_chrome_cpu_request, mem_request=karakeep_k8s_chrome_mem_request) }}
      volumes:
        - name: chrome-tmp
          emptyDir: {}
        - name: chrome-fontconfig-cache
          emptyDir: {}
