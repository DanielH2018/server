{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: karakeep-time-tagger
  namespace: {{ k8s_namespace }}
spec:
{{ spec_shell('RollingUpdate') }}
  # The same budget as the drain's wait. See karakeep_k8s_rollout_timeout in defaults/main.yml.
  progressDeadlineSeconds: {{ karakeep_k8s_rollout_timeout[:-1] | int }}
  replicas: 1
  selector:
    matchLabels:
      app: karakeep-time-tagger
  template:
    metadata:
      labels:
        app: karakeep-time-tagger
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-standard') }}
      initContainers:
        # A start gate on karakeep being READY, which has NO k8s `depends_on` equivalent —
        # pods start in parallel. Without this
        # the tagger raced the app, failed its initial connection check against
        # /api/v1/users/me with ECONNREFUSED, and crashed; observed on the first deploy.
        #
        # It does not merely fail once. The script's loop only touches /tmp/healthy after a
        # SUCCESSFUL run, so the liveness probe finds no file, restarts the pod, and the whole
        # `uv pip install` runs again — a restart loop that resolves only when a run happens to
        # land after the app is up.
        #
        # A TCP connect to the SERVICE is the faithful translation, not an approximation: a k8s
        # Service routes only to READY endpoints, so this connects exactly when karakeep's
        # readiness probe passes, which is what service_healthy meant.
        - name: wait-for-karakeep
          image: {{ karakeep_k8s_tagger_image }}
          # Built in-cluster, so `Always` rather than the `IfNotPresent` an unchanged content tag
          # would otherwise take from the node's cache — see the
          # `built-images-pull-always` row of tests/k8s/rendered_properties/_workload_property_rows.py.
          imagePullPolicy: Always
          command:
            - python3
            - -c
            - |
              import socket, time
              while True:
                  try:
                      socket.create_connection(("karakeep", {{ container_item.port }}), 5).close()
                      break
                  except OSError:
                      time.sleep(5)
          # read_only, for the same reason as the identically shaped wait-for-deps init
          # container in deployment.yaml.j2: the whole program is the `python3 -c` above, it
          # imports two stdlib modules whose bytecode is already in the image, and it writes
          # nothing — so it needs no writable path and gets no emptyDir. Even if the bytecode
          # were missing, CPython's `__pycache__` write is best-effort and fails soft on a
          # read-only tree, so the container still runs.
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=1000, run_as_group=1000) }}
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: time-tagger
          image: {{ karakeep_k8s_tagger_image }}
          imagePullPolicy: Always
          # Runtime deps are version-pinned rather than floating so a container start does not
          # silently re-resolve them to whatever is newest on PyPI — the same silent drift the
          # base-image digest pin closes, one layer down. Renovate tracks each pin via a custom
          # manager, so they age visibly. The script writes no log file, so the command has no
          # rotated-log prune.
{# DECIDED: a plain (non-subPath) ConfigMap mount under a re-exec loop, so an edited script
   takes effect after kubelet syncs, with no rollout. #}
          command:
            - bash
            - -c
            - >-
              uv pip install karakeep-python-api==1.9.1 fire==0.7.1 tqdm==4.70.1
              beautifulsoup4==4.15.0 loguru==0.7.3 -q --system &&
              while true; do
              python /script/karakeep-time-tagger.py --cache_file /tmp/bookmarks.temp --reset_all=True
              && touch /tmp/healthy;
              sleep 900;
              done
          workingDir: /work
          # uid 1000, and the IMAGE is what makes that possible: a securityContext cannot reach
          # the two reasons the stock uv image needs root, the uv cache under Debian's 0700
          # `/root` and `uv pip install --system` writing into the image's own site-packages.
          # `templates/Dockerfile.j2` chowns site-packages to 1000 and relocates the cache to
          # `/uv-cache` via `UV_CACHE_DIR`; read it before changing either path here. No
          # DAC_OVERRIDE and no added capability: the container owns what it writes instead of
          # overriding the permission check.
          #
          # DECIDED: no readOnlyRootFilesystem here, unlike the wait-for-karakeep init container
          # above. The `uv pip install ... --system` in the command block installs five packages
          # into the interpreter's site-packages, on the image's own root filesystem, on EVERY
          # container start — `--system` is what targets it there rather than a venv. A read-only
          # root makes that first command fail, so the container never reaches the script. The
          # chown changes who may write that path, never whether the path is writable, so the
          # in-cluster build does not reopen this.
          # Redirecting the install into a mounted emptyDir instead (a venv on /work, or
          # PYTHONUSERBASE) would make read-only reachable, but it re-resolves the same install
          # against a cache that no longer persists and changes how the container boots — a
          # bigger change than the hardening it buys.
{{ hardened_security_context(non_root=true, run_as_user=1000, run_as_group=1000) }}
          env:
{# Never set LOGURU_AUTOINIT=false here. setup_logging() drops loguru's default handler itself,
   and KarakeepAPI() then calls logger.remove(0) to drop that same default. Without the default,
   the script's INFO handler is id 0, so the library removes it and installs a DEBUG catch-all,
   and every DEBUG line ships. #}
            - name: TZ
              value: "{{ tz }}"
            - name: KARAKEEP_PYTHON_API_ENDPOINT
              value: http://karakeep:{{ container_item.port }}/api/v1/
            - name: KARAKEEP_PYTHON_API_KEY
              valueFrom:
                secretKeyRef:
                  name: karakeep
                  key: KARAKEEP_PYTHON_API_KEY
          volumeMounts:
            - name: time-tagger-script
              mountPath: /script
              readOnly: true
            # /uv-cache, not /root/.cache/uv: `UV_CACHE_DIR` in templates/Dockerfile.j2 names this
            # path, and the two move together. kubelet creates an emptyDir 0777, so uid 1000 can
            # write it with no fsGroup and nothing to chown.
            - name: time-tagger-uv-cache
              mountPath: /uv-cache
            - name: time-tagger-work
              mountPath: /work
          # /tmp/healthy is touched only after a SUCCESSFUL run, so a hung or persistently
          # failing tagger goes stale even though the process is
          # alive. The loop sleeps 900s, so <2100 allows one missed cycle. No readiness probe —
          # nothing routes to this and nothing waits on it, so readiness would only add a state
          # that means nothing.
          livenessProbe:
            exec:
              command:
                - python3
                - -c
                - "import os,sys,time; sys.exit(0 if time.time()-os.stat('/tmp/healthy').st_mtime<2100 else 1)"
            initialDelaySeconds: 600
            periodSeconds: 60
{{ container_resources(cpu_limit=karakeep_k8s_tagger_cpu_limit, mem_limit=karakeep_k8s_tagger_mem_limit, cpu_request=karakeep_k8s_tagger_cpu_request, mem_request=karakeep_k8s_tagger_mem_request) }}
      volumes:
        - name: time-tagger-script
          configMap:
            name: karakeep-time-tagger
        - name: time-tagger-uv-cache
          emptyDir: {}
        - name: time-tagger-work
          emptyDir: {}
