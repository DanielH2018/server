{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: karakeep
  namespace: {{ k8s_namespace }}
spec:
  # RWO PVC with one replica: a rolling update would deadlock on the volume.
{{ spec_shell('Recreate') }}
  # The same budget as the drain's wait. See karakeep_k8s_rollout_timeout in defaults/main.yml.
  progressDeadlineSeconds: {{ karakeep_k8s_rollout_timeout[:-1] | int }}
  replicas: 1
  selector:
    matchLabels:
      app: karakeep
  template:
    metadata:
      labels:
        app: karakeep
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-standard') }}
      initContainers:
        # Gates on readiness, not start order: a Service has no endpoints until its probe passes.
        - name: wait-for-deps
          image: {{ karakeep_k8s_tagger_image }}
          imagePullPolicy: Always
          command:
            - python3
            - -c
            - |
              import socket, time
              for host, port in (("karakeep-chrome", 9222), ("karakeep-meilisearch", 7700)):
                  while True:
                      try:
                          socket.create_connection((host, port), 5).close()
                          break
                      except OSError:
                          time.sleep(5)
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=1000, run_as_group=1000) }}
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: karakeep
          image: {{ karakeep_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{ container_item.port }}
          # Drop ALL with no cap_add — a Node app on a high port. The seeded tree is
          # root-owned and this image runs as root, so nothing
          # here needs CHOWN or DAC_OVERRIDE.
          #
          # /run is an emptyDir (`karakeep-run` below) because of that missing CHOWN. Since
          # 0.34.0 the image ships `/run` owned by `node`.
          # s6-overlay's preinit chowns /run to the container uid whenever the two differ, and
          # without CHOWN that exits 111 before the app starts. kubelet creates an
          # emptyDir owned by root, so preinit finds uid 0 on uid 0 and changes nothing. The
          # image puts nothing else in /run, so the mount hides nothing.
          #
          # DECIDED: no readOnlyRootFilesystem here, unlike the chrome sidecar and the
          # wait-for-deps init container above. Three facts, and the third is why this is
          # recorded rather than tried:
          #   1. PID 1 is s6-overlay's `/init` (upstream `docker/Dockerfile`'s ENTRYPOINT, and the
          #      process was measured as s6-svscan at uid 0 — see the ("karakeep",
          #      "karakeep") entry in _ENTRYPOINT_DROPS,
          #      tests/k8s/test_container_security_context.py). s6 rebuilds its whole
          #      service tree under /run on every start. /run is already an emptyDir, but a
          #      read-only root also needs S6_READ_ONLY_ROOT=1, which changes how the init
          #      itself boots.
          #   2. The image hardcodes HOME=/root, so anything cache-writing lands on the root
          #      filesystem rather than a mounted path. That is its own open issue; it is not
          #      fixed here.
          #   3. Guessing wrong is a manual recovery, not a rollback: k8s_autodeploy is false,
          #      strategy is Recreate, and the PVC is ReadWriteOnce, so the old pod is gone
          #      before the replacement's mounts are known-good.
          # Measuring the writable-path set would settle 1 and 2, and it needs a deploy — the
          # read-only ServiceAccount is Forbidden on pods/exec, so no live census is possible
          # from a review session.
{{ hardened_security_context() }}
          env:
            - name: TZ
              value: "{{ tz }}"
            - name: DATA_DIR
              value: /data
            # NO_COLOR is truthy on any non-empty string, "false" included.
            - name: LOG_LEVEL
              value: warn
            - name: NO_COLOR
              value: "1"
            # Service names, resolved through the cluster's DNS.
            - name: MEILI_ADDR
              value: http://karakeep-meilisearch:7700
            - name: BROWSER_WEB_URL
              value: http://karakeep-chrome:9222
            # Must be the hostname browsers arrive on; a wrong value breaks login without failing
            # startup.
            - name: NEXTAUTH_URL
              value: "https://{{ container_item.hostname | default(container_item.name) }}.{{ domain }}"
            # Upstream defaults to `*`; list only the two routed origins, and any other is refused.
            - name: AUTH_TRUSTED_ORIGINS
              value: "https://{{ container_item.hostname | default(container_item.name) }}.{{ domain }},https://{{ container_item.hostname | default(container_item.name) }}.local.{{ domain }}"
            # These make the public /api/trpc/ bypass safe: DISABLE_NEW_USERS_REGISTRATION is
            # ignored by the app.
            # RATE_LIMITING_ENABLED defaults to false, so apiKeys.exchange's limit never runs
            # without it.
            - name: DISABLE_SIGNUPS
              value: "true"
            - name: RATE_LIMITING_ENABLED
              value: "true"
            - name: OPENAI_BASE_URL
              value: https://generativelanguage.googleapis.com/v1beta
            - name: INFERENCE_TEXT_MODEL
              value: gemini-2.5-flash-lite
            - name: INFERENCE_IMAGE_MODEL
              value: gemini-2.5-flash-lite
            - name: INFERENCE_TAGS_ENABLED
              value: "true"
            # Tagging is network-bound, so 3 workers; more risk Gemini 429s and silently dropped
            # jobs.
            - name: INFERENCE_NUM_WORKERS
              value: "3"
            - name: MEILI_MASTER_KEY
              valueFrom:
                secretKeyRef:
                  name: karakeep
                  key: MEILI_MASTER_KEY
            - name: NEXTAUTH_SECRET
              valueFrom:
                secretKeyRef:
                  name: karakeep
                  key: NEXTAUTH_SECRET
            - name: OPENAI_API_KEY
              valueFrom:
                secretKeyRef:
                  name: karakeep
                  key: OPENAI_API_KEY
          volumeMounts:
            - name: karakeep-data
              mountPath: /data
            - name: karakeep-next-cache
              mountPath: /app/apps/web/.next/cache
            - name: karakeep-run
              mountPath: /run
          readinessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
            initialDelaySeconds: 20
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
            initialDelaySeconds: 90
            periodSeconds: 30
{{ container_resources(cpu_limit=karakeep_k8s_cpu_limit, mem_limit=karakeep_k8s_mem_limit, cpu_request=karakeep_k8s_cpu_request, mem_request=karakeep_k8s_mem_request) }}
      volumes:
        - name: karakeep-data
          persistentVolumeClaim:
            claimName: {{ karakeep_k8s_claim }}
        # Memory emptyDir: root lacks DAC_OVERRIDE on the node-owned image dir; counts against the
        # memory limit.
        - name: karakeep-next-cache
          emptyDir:
            medium: Memory
            sizeLimit: 256Mi
        # Memory because s6 expects a tmpfs at /run; counts against the memory limit.
        - name: karakeep-run
          emptyDir:
            medium: Memory
            sizeLimit: 64Mi
