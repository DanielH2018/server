{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import pod_shell with context %}
---
# A DaemonSet, not a Deployment: a GPU is a node property and the nodes carry DIFFERENT GPUs
# (amdgpu, i915);
# one replica behind a ClusterIP would flip a single series between two GPUs. Hence no Service.
# UNPRIVILEGED: everything read is a world-readable sysfs file; `intel_gpu_top` would need
# CAP_PERFMON and cover only Intel.
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: gpu-exporter
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  selector:
    matchLabels:
      app: gpu-exporter
  template:
    metadata:
      labels:
        app: gpu-exporter
        # The shared baseline policy already names the scraper, so this role adds no NetworkPolicy.
        netpol-baseline: enforced
    spec:
      # NOT hostNetwork: a pod IP keeps the 9101 listener off the nodes' LAN interfaces, so no ufw
      # allow is needed.
{{ pod_shell('homelab-best-effort') }}
      containers:
        - name: gpu-exporter
          image: {{ gpu_exporter_k8s_image }}
          imagePullPolicy: IfNotPresent
          command:
            - python
            - /opt/gpu-exporter/gpu_exporter.py
            - --port
            - "{{ services | entry_port('gpu-exporter') }}"
            - --sysfs-root
            - /host/sys
          env:
            - name: TZ
              value: "{{ tz }}"
            # readOnlyRootFilesystem leaves nowhere to write a .pyc, and the interpreter would retry
            # on every import.
            - name: PYTHONDONTWRITEBYTECODE
              value: "1"
          # 65534 (nobody): every file the exporter opens is world-readable, so no group or
          # capability is needed.
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=65534, run_as_group=65534) }}
          ports:
            - name: metrics
              containerPort: {{ services | entry_port('gpu-exporter') }}
          # tcpSocket, not httpGet on /metrics: a kubelet probe against a metrics route is the
          # shape tests/k8s/rendered_properties/_scrape_property_rows.py refuses below a 300s period.
          # Whether a GPU is present is `homelab_gpu_info`'s job to report, not a restart cause.
          livenessProbe:
            tcpSocket:
              port: {{ services | entry_port('gpu-exporter') }}
            initialDelaySeconds: 10
            periodSeconds: 30
            failureThreshold: 3
          readinessProbe:
            tcpSocket:
              port: {{ services | entry_port('gpu-exporter') }}
            initialDelaySeconds: 3
            periodSeconds: 10
{{ container_resources(cpu_limit=gpu_exporter_k8s_cpu_limit, mem_limit=gpu_exporter_k8s_mem_limit, cpu_request=gpu_exporter_k8s_cpu_request, mem_request=gpu_exporter_k8s_mem_request) }}
          volumeMounts:
            - name: gpu-exporter-script
              mountPath: /opt/gpu-exporter
              readOnly: true
            - name: gpu-exporter-host-sys
              mountPath: /host/sys
              readOnly: true
      volumes:
        - name: gpu-exporter-script
          configMap:
            name: gpu-exporter
        # The whole of /sys: card directories and the driver link are symlinks resolving into
        # /sys/devices and /sys/bus/pci/drivers, and a dangling driver link reads as "not a GPU" in
        # discover_cards().
        - name: gpu-exporter-host-sys
          hostPath:
            path: /sys
            type: Directory
