---
# lookup('file'), not a template: label sets like `{card="card1",driver="amdgpu"}` would be read as
# Jinja.
# Rendered here so an edit rolls the pods without a `checksum/` annotation.
apiVersion: v1
kind: ConfigMap
metadata:
  name: gpu-exporter
  namespace: {{ k8s_namespace }}
data:
  gpu_exporter.py: |
{{ lookup('file', role_file('files/gpu_exporter.py')) | indent(4, true) }}
