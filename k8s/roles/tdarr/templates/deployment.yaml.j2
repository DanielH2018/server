{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
{% from 'lsio-env.yml.j2' import lsio_env with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_required with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: tdarr
  namespace: {{ k8s_namespace }}
spec:
  # Recreate: both config PVCs are ReadWriteOnce, so a rolling update deadlocks.
{{ spec_shell('Recreate') }}
  # The same budget as Flux's timeout. See tdarr_k8s_rollout_timeout in defaults/main.yml.
  progressDeadlineSeconds: {{ tdarr_k8s_rollout_timeout[:-1] | int }}
  replicas: 1
  selector:
    matchLabels:
      app: tdarr
  template:
    metadata:
      labels:
        app: tdarr
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-best-effort') }}
      # Names the node because the tdarr-prepull Job copies this pod's placement and cannot read a
      # PV's.
{{ node_affinity_required(k8s_primary_node) }}
      # File-mode half of the GPU wiring; the device plugin handles the cgroup half.
      securityContext:
        supplementalGroups:
          - {{ hosts[k8s_primary_node].render_gid }}
      # VAAPI encode with tdarr's own ffmpeg (not jellyfin's); a failure keeps tdarr from starting.
      # Not a Job (no ffmpeg in its image); `timeout` bounds a wedged GPU; the ffmpeg path is
      # located.
      initContainers:
        - name: vaapi-encode
          image: {{ tdarr_k8s_image }}
          imagePullPolicy: IfNotPresent
          command:
            - sh
            - -c
            - |
              set -e
              if command -v ffmpeg >/dev/null; then bin=ffmpeg; else bin=/app/ffmpeg/ffmpeg; fi
              limit=""
              if command -v timeout >/dev/null; then limit="timeout 120"; fi
              echo "using $bin"
              $limit "$bin" -v error -init_hw_device vaapi=va:/dev/dri/renderD128 -filter_hw_device va -f lavfi -i testsrc=size=1280x720:rate=30:duration=3 -vf format=nv12,hwupload -c:v h264_vaapi -f null -
              echo VAAPI_OK
          # Runs as tdarr's PUID/PGID: a root check would pass a render node tdarr's process cannot
          # open.
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=puid, run_as_group=pgid) }}
{{ container_resources(cpu_limit='1', mem_limit='512Mi', cpu_request='100m', mem_request='128Mi', extra=tdarr_k8s_dri_resource) }}
      containers:
        - name: tdarr
          image: {{ tdarr_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{ tdarr_k8s_webui_port }}
          # FOWNER and DAC_OVERRIDE stay: the image chowns its own mounts before dropping to
          # PUID/PGID.
{{ hardened_security_context(add=['CHOWN', 'SETUID', 'SETGID', 'FOWNER', 'DAC_OVERRIDE']) }}
          env:
{{ lsio_env() }}
            - name: serverIP
              value: "0.0.0.0"
            - name: serverPort
              value: "{{ tdarr_k8s_server_port }}"
            - name: webUIPort
              value: "{{ tdarr_k8s_webui_port }}"
            - name: internalNode
              value: "true"
            - name: inContainer
              value: "true"
            - name: maxLogSizeMB
              value: "10"
            # Pins the Rust engine: a 2.x server otherwise asks upstream each start, and a NodeJS
            # draw would come up on pre-migration library state. 3.x runs Rust whatever this says.
            - name: TDARR_ENGINE
              value: "rust"
            # Authelia is the only login: 3.x enables Tdarr's own auth on a new install (no `auth`
            # key in the server config), and the env value outranks the config file.
            - name: auth
              value: "false"
            # Registers as `daniel-box`, where the seeded database was written by a node
            # `daniel-server`.
            # If work looks stuck, check `/api/v2/get-nodes` returns exactly one node.
            - name: nodeID
              value: "{{ k8s_primary_node }}"
          volumeMounts:
            - name: tdarr-server
              mountPath: /app/server
            # Tdarr's internal DB backup zips — backups-of-a-backup (kopia excluded them); the live DB2/ tree stays on the PVC.
            - name: tdarr-db-backups
              mountPath: /app/server/Tdarr/Backups
            - name: tdarr-configs
              mountPath: /app/configs
            # THE PATH CONTRACT, and the one mount here that is read-write.
            - name: media
              mountPath: /media
              subPath: {{ tdarr_k8s_media_subpath }}
            # Not on Longhorn: the transcode cache and logs are regenerable, nothing would restore
            # them.
            - name: tdarr-transcode-cache
              mountPath: /temp
            - name: tdarr-logs
              mountPath: /app/logs
          readinessProbe:
            httpGet:
              path: /api/v2/status
              port: {{ tdarr_k8s_webui_port }}
            initialDelaySeconds: 20
            periodSeconds: 10
{# DECIDED: no startupProbe; its case is a first-boot DOCKER_MODS install, which this image does
   not run, and the liveness initialDelaySeconds covers a measured 60s boot. #}
          # 120s: the pod attaches a 400 G RWX volume and registers its internal node first.
          livenessProbe:
            httpGet:
              path: /api/v2/status
              port: {{ tdarr_k8s_webui_port }}
            initialDelaySeconds: 120
            periodSeconds: 30
          # Extended resources must request exactly what they limit.
{{ container_resources(cpu_limit=tdarr_k8s_cpu_limit, mem_limit=tdarr_k8s_mem_limit, cpu_request=tdarr_k8s_cpu_request, mem_request=tdarr_k8s_mem_request, extra=tdarr_k8s_dri_resource) }}
      volumes:
        - name: tdarr-server
          persistentVolumeClaim:
            claimName: {{ tdarr_k8s_server_claim }}
        - name: tdarr-configs
          persistentVolumeClaim:
            claimName: {{ tdarr_k8s_configs_claim }}
        - name: media
          persistentVolumeClaim:
            claimName: {{ tdarr_k8s_media_claim }}
        - name: tdarr-db-backups
          emptyDir:
            sizeLimit: 2Gi
        # sizeLimit is load-bearing: an unbounded emptyDir fills the node's root fs and takes k3s
        # down.
        # With a limit the kubelet evicts only this pod.
        - name: tdarr-transcode-cache
          emptyDir:
            sizeLimit: 100Gi
        - name: tdarr-logs
          emptyDir:
            sizeLimit: 2Gi
