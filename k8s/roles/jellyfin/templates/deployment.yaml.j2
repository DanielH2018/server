{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
{% from 'lsio-env.yml.j2' import lsio_env with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_required with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: jellyfin
  namespace: {{ k8s_namespace }}
spec:
  # The config PVC is RWO on single-replica Longhorn: a rolling update deadlocks on a volume the old
  # pod has not released.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: jellyfin
  template:
    metadata:
      labels:
        app: jellyfin
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-standard') }}
      # Pinned to the node media-data's PV names: the prepull Job copies this pod's placement and
      # needs a named node.
{{ node_affinity_required(k8s_primary_node) }}
      # Passes the file mode (/dev/dri/renderD128 is crw-rw---- root:render); host-specific, so it
      # lives in host_vars.
      securityContext:
        supplementalGroups:
          - {{ hosts[k8s_primary_node].render_gid }}
      # One-time Intel -> AMD edit of /config/encoding.xml, here because Jellyfin rewrites it on any
      # admin save.
      # Guarded on `qsv` so it converges once; templating the file would revert every UI change.
      initContainers:
        - name: convert-encoding-settings
          image: {{ jellyfin_k8s_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
            - |
              # set -e: without it a sed that failed with EACCES still prints "converted", a
              # false green. The explicit re-read at the end guards the same failure.
              set -eu
              f=/config/encoding.xml
              if [ ! -f "$f" ]; then
                echo "no encoding.xml yet — Jellyfin will write defaults, nothing to convert"
                exit 0
              fi
              if ! grep -q '<HardwareAccelerationType>qsv</HardwareAccelerationType>' "$f"; then
                echo "already converted (or never Intel) — leaving encoding.xml alone"
                exit 0
              fi
              # VppTonemapping is the Intel QSV VPP filter with no AMD equivalent; leaving it on
              # asks ffmpeg for a filter this hardware cannot build.
              sed -i \
                -e 's|<HardwareAccelerationType>qsv</HardwareAccelerationType>|<HardwareAccelerationType>vaapi</HardwareAccelerationType>|' \
                -e 's|<EnableVppTonemapping>true</EnableVppTonemapping>|<EnableVppTonemapping>false</EnableVppTonemapping>|' \
                "$f"
              grep -q '<HardwareAccelerationType>vaapi</HardwareAccelerationType>' "$f"
              echo "converted encoding.xml: qsv -> vaapi, VppTonemapping off"
          # Runs as the OWNER of /config, not root: with all caps dropped root has no DAC_OVERRIDE,
          # so `sed -i`'s temp file fails with "Permission denied" (it looks like a read-only
          # mount).
{{ hardened_security_context(non_root=true, run_as_user=puid, run_as_group=pgid) }}
          volumeMounts:
            - name: jellyfin-config
              mountPath: /config
{{ container_resources(cpu_limit='500m', mem_limit='128Mi', cpu_request='10m', mem_request='32Mi') }}
          # Removes plugins this role does not install: Jellyfin rescans the PVC and the read-only
          # SA cannot exec.
          # Runs BEFORE the installers; `configurations/` is never swept;
          # test_jellyfin_plugin_allowlist.py pins KEEP.
        - name: sweep-unlisted-plugins
          image: {{ jellyfin_k8s_plugin_init_image }}
          imagePullPolicy: IfNotPresent
          command:
            - python3
            - -c
            - |
              import shutil
              from pathlib import Path

              PLUGINS = Path("/config/data/plugins")
              KEEP = ("Ani-Sync", "Intro Skipper", "Webhook", "Merge Versions", "Media Cleaner")
              SETTINGS = "configurations"

              if not PLUGINS.is_dir():
                  print("no " + str(PLUGINS) + " yet, nothing to sweep")
                  raise SystemExit(0)
              unlisted = 0
              for entry in sorted(PLUGINS.iterdir()):
                  if entry.name == SETTINGS:
                      print("keep " + entry.name + " (plugin settings, never swept)")
                  elif not entry.is_dir():
                      print("leave file " + entry.name)
                  elif entry.name.rpartition("_")[0] in KEEP:
                      print("keep " + entry.name)
                  else:
                      print("removing " + entry.name)
                      shutil.rmtree(entry)
                      unlisted += 1
              print("allowlist sweep: " + str(unlisted) + " unlisted plugin(s) removed")
{{ hardened_security_context(non_root=true, run_as_user=puid, run_as_group=pgid) }}
          volumeMounts:
            - name: jellyfin-config
              mountPath: /config
{{ container_resources(cpu_limit='500m', mem_limit='128Mi', cpu_request='10m', mem_request='32Mi') }}
          # Installed from its release so a PVC restored from nothing gets it; settings (AniList
          # OAuth token) are NOT managed.
          # python:3.15-alpine: unzip as the owning uid (root has no DAC_OVERRIDE); stdlib only,
          # nothing installs at runtime.
        - name: install-ani-sync
          image: {{ jellyfin_k8s_plugin_init_image }}
          imagePullPolicy: IfNotPresent
          command:
            - python3
            - -c
            - |
              import hashlib
              import json
              import shutil
              import tempfile
              import urllib.request
              import zipfile
              from pathlib import Path

              VERSION = "{{ jellyfin_k8s_anisync_version }}"
              URL = "{{ jellyfin_k8s_anisync_url }}"
              WANT_MD5 = "{{ jellyfin_k8s_anisync_md5 }}"
              DLL = "jellyfin-ani-sync.dll"
              # /config/data/plugins, not /config/plugins: Jellyfin scans only the former; an
              # install under the latter reports success but GET /Plugins never lists it.
              PLUGINS = Path("/config/data/plugins")
              # `<Name>_<Version>` is Jellyfin's own layout; name and version are meta.json's.
              PLUGIN_DIR = PLUGINS / ("Ani-Sync_" + VERSION)

              # The directory is the marker (its name carries the version, renamed in complete). It
              # guards the DOWNLOAD only;
              # sweeping superseded directories and autoUpdate off run on every start.
              if (PLUGIN_DIR / DLL).exists():
                  print("ani-sync " + VERSION + " already installed")
              else:
                  print("installing ani-sync " + VERSION + " from " + URL)
                  PLUGINS.mkdir(parents=True, exist_ok=True)

                  # Staged INSIDE the plugins directory, not /tmp: same filesystem, so the swap is a
                  # rename and a half-written directory is never visible.
                  with tempfile.TemporaryDirectory(dir=PLUGINS) as tmp:
                      archive = Path(tmp) / "plugin.zip"
                      with urllib.request.urlopen(URL, timeout=60) as response:
                          with archive.open("wb") as handle:
                              shutil.copyfileobj(response, handle)

                      got = hashlib.md5(archive.read_bytes()).hexdigest()
                      if got != WANT_MD5:
                          raise SystemExit("md5 mismatch: got " + got + ", want " + WANT_MD5)

                      staged = Path(tmp) / "staged"
                      with zipfile.ZipFile(archive) as bundle:
                          bundle.extractall(staged)

                      # Checked: an archive that extracts but carries no DLL leaves a directory
                      # Jellyfin silently ignores.
                      if not (staged / DLL).exists():
                          found = sorted(path.name for path in staged.iterdir())
                          raise SystemExit("archive has no " + DLL + ": " + repr(found))

                      # Renamed into place COMPLETE, only once the DLL is present, so a failed
                      # install retries on the next start rather than latching.
                      if PLUGIN_DIR.is_dir():
                          shutil.rmtree(PLUGIN_DIR)
                      shutil.move(staged, PLUGIN_DIR)

                  print("installed ani-sync " + VERSION)

              # Older builds are their own directories, and `Update Plugins` drops a NEWER one
              # beside the pinned build.
              # Swept UNCONDITIONALLY, but AFTER the install, so a failed download keeps the working
              # version.
              for stale in sorted(PLUGINS.glob("Ani-Sync_*")):
                  if stale != PLUGIN_DIR:
                      print("removing superseded " + stale.name)
                      shutil.rmtree(stale)

              # autoUpdate: false stops `Update Plugins` fetching a newer build; the flag defaults
              # to TRUE, so write it on every start.
              meta_path = PLUGIN_DIR / "meta.json"
              if meta_path.is_file():
                  meta = json.loads(meta_path.read_text())
                  if meta.get("autoUpdate") is not False:
                      meta["autoUpdate"] = False
                      meta_path.write_text(json.dumps(meta, indent=4))
                      print("autoUpdate off in " + PLUGIN_DIR.name + "/meta.json")

              # DECIDED: keep this, do not "tidy it away" as dead code. The 2026-08-25 first cut
              # of this container installed to /config/plugins, which Jellyfin never scans, and
              # left ~122 KB there on every config volume it ran against. Nothing else reaches
              # that path — the read-only ServiceAccount cannot exec into the pod — so this
              # container is the only thing that can clear what it created. It is reached on
              # every start, and is inert once it has run.
              legacy = Path("/config/plugins/ani-sync")
              if legacy.is_dir():
                  print("removing " + str(legacy) + " (never scanned; installed there in error)")
                  shutil.rmtree(legacy)
{{ hardened_security_context(non_root=true, run_as_user=puid, run_as_group=pgid) }}
          volumeMounts:
            - name: jellyfin-config
              mountPath: /config
{{ container_resources(cpu_limit='500m', mem_limit='128Mi', cpu_request='10m', mem_request='32Mi') }}
          # ── Intro Skipper (skip-intro / skip-credits) ───────────────────────────────────────
          # A second copy of the container above rather than one loop over both plugins, and
          # deliberately so: the ani-sync installer's paths are asserted as literal strings by
          # tests/services/jellyfin/test_anisync_pin_matches_server.py, and a textual guard
          # stops seeing what it guards the moment the thing moves behind an indirection.
          # The two installs also differ where it matters — see the meta.json note below.
          #
          # Intro Skipper publishes its timestamps through Jellyfin's Media Segments API, so
          # the clients draw the skip button themselves. Nothing here touches
          # /usr/share/jellyfin/web; upstream stopped modifying the web client at Jellyfin
          # 10.10. The plugin's SETTINGS (detection parameters, per-library opt-outs) are
          # deliberately unmanaged, exactly as ani-sync's are.
        - name: install-intro-skipper
          image: {{ jellyfin_k8s_plugin_init_image }}
          imagePullPolicy: IfNotPresent
          command:
            - python3
            - -c
            - |
              import hashlib
              import json
              import shutil
              import tempfile
              import urllib.request
              import zipfile
              from pathlib import Path

              VERSION = "{{ jellyfin_k8s_introskipper_version }}"
              URL = "{{ jellyfin_k8s_introskipper_url }}"
              WANT_SHA256 = "{{ jellyfin_k8s_introskipper_sha256 }}"
              TARGET_ABI = "{{ jellyfin_k8s_introskipper_target_abi }}"
              GUID = "{{ jellyfin_k8s_introskipper_guid }}"
              DLL = "IntroSkipper.dll"
              PLUGINS = Path("/config/data/plugins")
              # `<Name>_<Version>`, with the space Jellyfin's installer writes; "Intro Skipper" is
              # the name the published manifest declares.
              PLUGIN_DIR = PLUGINS / ("Intro Skipper_" + VERSION)

              if (PLUGIN_DIR / DLL).exists():
                  print("intro-skipper " + VERSION + " already installed")
              else:
                  print("installing intro-skipper " + VERSION + " from " + URL)
                  PLUGINS.mkdir(parents=True, exist_ok=True)

                  with tempfile.TemporaryDirectory(dir=PLUGINS) as tmp:
                      archive = Path(tmp) / "plugin.zip"
                      with urllib.request.urlopen(URL, timeout=60) as response:
                          with archive.open("wb") as handle:
                              shutil.copyfileobj(response, handle)

                      # sha256, not the md5: GitHub reports a sha256 for the asset itself, which can
                      # be re-derived from the release.
                      got = hashlib.sha256(archive.read_bytes()).hexdigest()
                      if got != WANT_SHA256:
                          raise SystemExit("sha256 mismatch: got " + got + ", want " + WANT_SHA256)

                      staged = Path(tmp) / "staged"
                      with zipfile.ZipFile(archive) as bundle:
                          bundle.extractall(staged)

                      if not (staged / DLL).exists():
                          found = sorted(path.name for path in staged.iterdir())
                          raise SystemExit("archive has no " + DLL + ": " + repr(found))

                      # No meta.json in the release: Jellyfin would invent one (id an MD5 of the
                      # folder). Write the real manifest to bind the GUID.
                      meta = {
                          "category": "MoviesAndShows",
                          "description": "Analyzes the audio of television episodes and detects introduction sequences.",
                          "guid": GUID,
                          "name": "Intro Skipper",
                          "overview": "Automatically detect and skip intros in television episodes",
                          "autoUpdate": False,
                      "owner": "AbandonedCart, rlauuzo, jumoog (forked from ConfusedPolarBear)",
                          "targetAbi": TARGET_ABI,
                          "version": VERSION,
                      }
                      (staged / "meta.json").write_text(json.dumps(meta, indent=4))

                      if PLUGIN_DIR.is_dir():
                          shutil.rmtree(PLUGIN_DIR)
                      shutil.move(staged, PLUGIN_DIR)

                  print("installed intro-skipper " + VERSION)

              # Older builds are their OWN directories, because the name carries the version —
              # and Jellyfin's `Update Plugins` task writes one too, dropping a NEWER build beside
              # the pinned one seconds after startup. Swept UNCONDITIONALLY, so an unpinned copy
              # goes on the start where the pinned version is already installed. Still swept
              # AFTER the install above, so a failed download leaves the working version
              # untouched.
              for stale in sorted(PLUGINS.glob("Intro Skipper_*")):
                  if stale != PLUGIN_DIR:
                      print("removing superseded " + stale.name)
                      shutil.rmtree(stale)

              # ── and stop Jellyfin fetching a newer one ─────────────────────────────────────────
              # The sweep above only removes an unpinned build until `Update Plugins` runs
              # again. Jellyfin's
              # InstallationManager.GetAvailablePluginUpdates skips a plugin whose manifest carries
              # `autoUpdate: false` (read from Emby.Server.Implementations/Updates/
              # InstallationManager.cs at v10.11.11), and PluginManager preserves the local value
              # when it rewrites the manifest. The flag defaults to TRUE, so it is written on every
              # start rather than at install: a directory on this PVC can predate this container,
              # and the already-installed path above needs it too.
              meta_path = PLUGIN_DIR / "meta.json"
              if meta_path.is_file():
                  meta = json.loads(meta_path.read_text())
                  if meta.get("autoUpdate") is not False:
                      meta["autoUpdate"] = False
                      meta_path.write_text(json.dumps(meta, indent=4))
                      print("autoUpdate off in " + PLUGIN_DIR.name + "/meta.json")
{{ hardened_security_context(non_root=true, run_as_user=puid, run_as_group=pgid) }}
          volumeMounts:
            - name: jellyfin-config
              mountPath: /config
{{ container_resources(cpu_limit='500m', mem_limit='128Mi', cpu_request='10m', mem_request='32Mi') }}
          # A copy, not a loop (see Intro Skipper). The zip carries its own meta.json; the digest is
          # the manifest's MD5.
          # Destinations (HA webhook URL, events, templates) are unmanaged, in
          # /config/data/plugins/configurations/.
        - name: install-webhook
          image: {{ jellyfin_k8s_plugin_init_image }}
          imagePullPolicy: IfNotPresent
          command:
            - python3
            - -c
            - |
              import hashlib
              import json
              import shutil
              import tempfile
              import urllib.request
              import zipfile
              from pathlib import Path

              VERSION = "{{ jellyfin_k8s_webhook_version }}"
              URL = "{{ jellyfin_k8s_webhook_url }}"
              WANT_MD5 = "{{ jellyfin_k8s_webhook_md5 }}"
              DLL = "Jellyfin.Plugin.Webhook.dll"
              PLUGINS = Path("/config/data/plugins")
              # `<Name>_<Version>` from the zip's own meta.json ("name": "Webhook").
              PLUGIN_DIR = PLUGINS / ("Webhook_" + VERSION)

              if (PLUGIN_DIR / DLL).exists():
                  print("webhook " + VERSION + " already installed")
              else:
                  print("installing webhook " + VERSION + " from " + URL)
                  PLUGINS.mkdir(parents=True, exist_ok=True)

                  with tempfile.TemporaryDirectory(dir=PLUGINS) as tmp:
                      archive = Path(tmp) / "plugin.zip"
                      with urllib.request.urlopen(URL, timeout=60) as response:
                          with archive.open("wb") as handle:
                              shutil.copyfileobj(response, handle)

                      got = hashlib.md5(archive.read_bytes()).hexdigest()
                      if got != WANT_MD5:
                          raise SystemExit("md5 mismatch: got " + got + ", want " + WANT_MD5)

                      staged = Path(tmp) / "staged"
                      with zipfile.ZipFile(archive) as bundle:
                          bundle.extractall(staged)

                      # This release ships seven bundled dependency DLLs, so "the archive extracted"
                      # says little; the plugin DLL decides whether Jellyfin loads anything.
                      if not (staged / DLL).exists():
                          found = sorted(path.name for path in staged.iterdir())
                          raise SystemExit("archive has no " + DLL + ": " + repr(found))

                      if PLUGIN_DIR.is_dir():
                          shutil.rmtree(PLUGIN_DIR)
                      shutil.move(staged, PLUGIN_DIR)

                  print("installed webhook " + VERSION)

              # Older builds are their OWN directories, because the name carries the version —
              # and Jellyfin's `Update Plugins` task writes one too, dropping a NEWER build beside
              # the pinned one seconds after startup. Swept UNCONDITIONALLY, so an unpinned copy
              # goes on the start where the pinned version is already installed. Still swept
              # AFTER the install above, so a failed download leaves the working version
              # untouched.
              for stale in sorted(PLUGINS.glob("Webhook_*")):
                  if stale != PLUGIN_DIR:
                      print("removing superseded " + stale.name)
                      shutil.rmtree(stale)

              # ── and stop Jellyfin fetching a newer one ─────────────────────────────────────────
              # The sweep above only removes an unpinned build until `Update Plugins` runs
              # again. Jellyfin's
              # InstallationManager.GetAvailablePluginUpdates skips a plugin whose manifest carries
              # `autoUpdate: false` (read from Emby.Server.Implementations/Updates/
              # InstallationManager.cs at v10.11.11), and PluginManager preserves the local value
              # when it rewrites the manifest. The flag defaults to TRUE, so it is written on every
              # start rather than at install: a directory on this PVC can predate this container,
              # and the already-installed path above needs it too.
              meta_path = PLUGIN_DIR / "meta.json"
              if meta_path.is_file():
                  meta = json.loads(meta_path.read_text())
                  if meta.get("autoUpdate") is not False:
                      meta["autoUpdate"] = False
                      meta_path.write_text(json.dumps(meta, indent=4))
                      print("autoUpdate off in " + PLUGIN_DIR.name + "/meta.json")
{{ hardened_security_context(non_root=true, run_as_user=puid, run_as_group=pgid) }}
          volumeMounts:
            - name: jellyfin-config
              mountPath: /config
{{ container_resources(cpu_limit='500m', mem_limit='128Mi', cpu_request='10m', mem_request='32Mi') }}
          # A copy, not a loop. Intro Skipper's shape: the zip holds the DLL alone, so this writes
          # the manifest. Settings unmanaged.
        - name: install-merge-versions
          image: {{ jellyfin_k8s_plugin_init_image }}
          imagePullPolicy: IfNotPresent
          command:
            - python3
            - -c
            - |
              import hashlib
              import json
              import shutil
              import tempfile
              import urllib.request
              import zipfile
              from pathlib import Path

              VERSION = "{{ jellyfin_k8s_mergeversions_version }}"
              URL = "{{ jellyfin_k8s_mergeversions_url }}"
              WANT_SHA256 = "{{ jellyfin_k8s_mergeversions_sha256 }}"
              TARGET_ABI = "{{ jellyfin_k8s_mergeversions_target_abi }}"
              GUID = "{{ jellyfin_k8s_mergeversions_guid }}"
              DLL = "Jellyfin.Plugin.MergeVersions.dll"
              PLUGINS = Path("/config/data/plugins")
              # "Merge Versions" is the manifest's name and must agree with the meta.json written
              # below, or the dashboard entry and directory describe different plugins.
              PLUGIN_DIR = PLUGINS / ("Merge Versions_" + VERSION)

              if (PLUGIN_DIR / DLL).exists():
                  print("merge-versions " + VERSION + " already installed")
              else:
                  print("installing merge-versions " + VERSION + " from " + URL)
                  PLUGINS.mkdir(parents=True, exist_ok=True)

                  with tempfile.TemporaryDirectory(dir=PLUGINS) as tmp:
                      archive = Path(tmp) / "plugin.zip"
                      with urllib.request.urlopen(URL, timeout=60) as response:
                          with archive.open("wb") as handle:
                              shutil.copyfileobj(response, handle)

                      # sha256, as Intro Skipper's install: GitHub reports one for the asset, which
                      # can be re-derived from the release.
                      got = hashlib.sha256(archive.read_bytes()).hexdigest()
                      if got != WANT_SHA256:
                          raise SystemExit("sha256 mismatch: got " + got + ", want " + WANT_SHA256)

                      staged = Path(tmp) / "staged"
                      with zipfile.ZipFile(archive) as bundle:
                          bundle.extractall(staged)

                      if not (staged / DLL).exists():
                          found = sorted(path.name for path in staged.iterdir())
                          raise SystemExit("archive has no " + DLL + ": " + repr(found))

                      # This container imports json because the release ships the DLL alone; the
                      # real manifest binds the entry to the plugin's GUID.
                      meta = {
                          "category": "General",
                          "description": "Merge all repeated movies and episodes in your library into one",
                          "guid": GUID,
                          "name": "Merge Versions",
                          "overview": "Merge repeated versions of a movie or episode into one entry",
                          "autoUpdate": False,
                      "owner": "danieladov",
                          "targetAbi": TARGET_ABI,
                          "version": VERSION,
                      }
                      (staged / "meta.json").write_text(json.dumps(meta, indent=4))

                      if PLUGIN_DIR.is_dir():
                          shutil.rmtree(PLUGIN_DIR)
                      shutil.move(staged, PLUGIN_DIR)

                  print("installed merge-versions " + VERSION)

              # Older builds are their OWN directories, because the name carries the version —
              # and Jellyfin's `Update Plugins` task writes one too, dropping a NEWER build beside
              # the pinned one seconds after startup. Swept UNCONDITIONALLY, so an unpinned copy
              # goes on the start where the pinned version is already installed. Still swept
              # AFTER the install above, so a failed download leaves the working version
              # untouched.
              for stale in sorted(PLUGINS.glob("Merge Versions_*")):
                  if stale != PLUGIN_DIR:
                      print("removing superseded " + stale.name)
                      shutil.rmtree(stale)

              # ── and stop Jellyfin fetching a newer one ─────────────────────────────────────────
              # The sweep above only removes an unpinned build until `Update Plugins` runs
              # again. Jellyfin's
              # InstallationManager.GetAvailablePluginUpdates skips a plugin whose manifest carries
              # `autoUpdate: false` (read from Emby.Server.Implementations/Updates/
              # InstallationManager.cs at v10.11.11), and PluginManager preserves the local value
              # when it rewrites the manifest. The flag defaults to TRUE, so it is written on every
              # start rather than at install: a directory on this PVC can predate this container,
              # and the already-installed path above needs it too.
              meta_path = PLUGIN_DIR / "meta.json"
              if meta_path.is_file():
                  meta = json.loads(meta_path.read_text())
                  if meta.get("autoUpdate") is not False:
                      meta["autoUpdate"] = False
                      meta_path.write_text(json.dumps(meta, indent=4))
                      print("autoUpdate off in " + PLUGIN_DIR.name + "/meta.json")
{{ hardened_security_context(non_root=true, run_as_user=puid, run_as_group=pgid) }}
          volumeMounts:
            - name: jellyfin-config
              mountPath: /config
{{ container_resources(cpu_limit='500m', mem_limit='128Mi', cpu_request='10m', mem_request='32Mi') }}
          # A copy, not a loop. Webhook's shape; the version's fourth segment encodes the ABI
          # (defaults/main.yml).
          # THIS PLUGIN DELETES MEDIA: this container owns only the install; rules live outside the
          # plugin directory.
        - name: install-media-cleaner
          image: {{ jellyfin_k8s_plugin_init_image }}
          imagePullPolicy: IfNotPresent
          command:
            - python3
            - -c
            - |
              import hashlib
              import json
              import shutil
              import tempfile
              import urllib.request
              import zipfile
              from pathlib import Path

              VERSION = "{{ jellyfin_k8s_mediacleaner_version }}"
              URL = "{{ jellyfin_k8s_mediacleaner_url }}"
              WANT_SHA256 = "{{ jellyfin_k8s_mediacleaner_sha256 }}"
              DLL = "MediaCleaner.dll"
              # The release ships MediaCleaner.Core.dll beside the plugin's own and the plugin does
              # not load without it, so both are checked.
              DEP_DLL = "MediaCleaner.Core.dll"
              PLUGINS = Path("/config/data/plugins")
              # `<Name>_<Version>` from the zip's meta.json; it matches the dashboard installer's
              # name, so a dashboard-installed copy at the pinned version makes the guard match and
              # nothing downloads.
              PLUGIN_DIR = PLUGINS / ("Media Cleaner_" + VERSION)

              if (PLUGIN_DIR / DLL).exists():
                  print("media-cleaner " + VERSION + " already installed")
              else:
                  print("installing media-cleaner " + VERSION + " from " + URL)
                  PLUGINS.mkdir(parents=True, exist_ok=True)

                  with tempfile.TemporaryDirectory(dir=PLUGINS) as tmp:
                      archive = Path(tmp) / "plugin.zip"
                      with urllib.request.urlopen(URL, timeout=60) as response:
                          with archive.open("wb") as handle:
                              shutil.copyfileobj(response, handle)

                      # sha256, the digest GitHub reports; the manifest carries an MD5, and the
                      # stronger digest can be re-derived from the release.
                      got = hashlib.sha256(archive.read_bytes()).hexdigest()
                      if got != WANT_SHA256:
                          raise SystemExit("sha256 mismatch: got " + got + ", want " + WANT_SHA256)

                      staged = Path(tmp) / "staged"
                      with zipfile.ZipFile(archive) as bundle:
                          bundle.extractall(staged)

                      for needed in (DLL, DEP_DLL):
                          if not (staged / needed).exists():
                              found = sorted(path.name for path in staged.iterdir())
                              raise SystemExit(
                                  "archive has no " + needed + ": " + repr(found)
                              )

                      if PLUGIN_DIR.is_dir():
                          shutil.rmtree(PLUGIN_DIR)
                      shutil.move(staged, PLUGIN_DIR)

                  print("installed media-cleaner " + VERSION)

              # Two directories would mean two rule engines deleting from one library.
              for stale in sorted(PLUGINS.glob("Media Cleaner_*")):
                  if stale != PLUGIN_DIR:
                      print("removing superseded " + stale.name)
                      shutil.rmtree(stale)

              # ── and stop Jellyfin fetching a newer one ─────────────────────────────────────────
              # The sweep above only removes an unpinned build until `Update Plugins` runs
              # again. Jellyfin's
              # InstallationManager.GetAvailablePluginUpdates skips a plugin whose manifest carries
              # `autoUpdate: false` (read from Emby.Server.Implementations/Updates/
              # InstallationManager.cs at v10.11.11), and PluginManager preserves the local value
              # when it rewrites the manifest. The flag defaults to TRUE, so it is written on every
              # start rather than at install: a directory on this PVC can predate this container,
              # and the already-installed path above needs it too.
              meta_path = PLUGIN_DIR / "meta.json"
              if meta_path.is_file():
                  meta = json.loads(meta_path.read_text())
                  if meta.get("autoUpdate") is not False:
                      meta["autoUpdate"] = False
                      meta_path.write_text(json.dumps(meta, indent=4))
                      print("autoUpdate off in " + PLUGIN_DIR.name + "/meta.json")
