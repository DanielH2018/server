{{ container_resources(cpu_limit='500m', mem_limit='128Mi', cpu_request='10m', mem_request='32Mi') }}
      containers:
        - name: jellyfin
          image: {{ jellyfin_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{ container_item.port }}
          # The s6 privilege-drop set, without FOWNER and DAC_OVERRIDE.
{{ hardened_security_context(add=['CHOWN', 'SETUID', 'SETGID']) }}
          env:
{{ lsio_env() }}
            - name: JELLYFIN_PublishedServerUrl
              value: "{{ jellyfin_k8s_published_url }}"
{# DECIDED: no nodeSelector; the bound media-data local PV's nodeAffinity pins this pod to
   daniel-box, where the AMD VAAPI device is. The pod-level required affinity above names the
   same `k8s_primary_node` only so the jellyfin-prepull Job can copy it. #}
          volumeMounts:
            - name: jellyfin-config
              mountPath: /config
            # BOTH mounts read-only: jellyfin only reads, which caps the blast radius of the
            # Authelia-less parser.
            # subPath `media`, NOT the root: libraries are /data/tv and /data/movies; the root
            # breaks every playback.
            - name: media
              mountPath: /data
              subPath: media
              readOnly: true
            # THE SAME TREE AGAIN, on purpose: janitorr's leaving-soon symlink targets are
            # /data/media/tv/...; do not tidy it.
            - name: media
              mountPath: /data/media
              subPath: media
              readOnly: true
            # THE WHOLE CACHE, off Longhorn: Longhorn backs up allocated BLOCKS, so a self-rewriting
            # cache leaves freed blocks the weekly backup ships forever. TranscodingTempPath is
            # unset, so transcodes land here too.
            - name: jellyfin-cache
              mountPath: /config/cache
          # Explicit timeoutSeconds (default 1s): a readiness trip drops the Traefik router (404,
          # not 503);
          # three liveness failures at 30s restart the container. 5s costs nothing when healthy.
          readinessProbe:
            httpGet:
              path: /health
              port: {{ container_item.port }}
            initialDelaySeconds: 15
            periodSeconds: 10
            timeoutSeconds: 5
{# DECIDED: no startupProbe; its case is a first-boot DOCKER_MODS install, which this image does
   not run, and the liveness initialDelaySeconds covers a measured 60s boot. #}
          # Start-up on a slow or post-update boot runs a library scan and hardware-init before
          # /health answers.
          livenessProbe:
            httpGet:
              path: /health
              port: {{ container_item.port }}
            initialDelaySeconds: 90
            periodSeconds: 30
            timeoutSeconds: 5
          # Extended resources must request exactly what they limit; Kubernetes rejects a mismatch.
{{ container_resources(cpu_limit=jellyfin_k8s_cpu_limit, mem_limit=jellyfin_k8s_mem_limit, cpu_request=jellyfin_k8s_cpu_request, mem_request=jellyfin_k8s_mem_request, extra=jellyfin_k8s_dri_resource) }}
