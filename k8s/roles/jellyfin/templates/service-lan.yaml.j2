---
apiVersion: v1
kind: Service
metadata:
  name: jellyfin-lan
  namespace: {{ k8s_namespace }}
  annotations:
    # MetalLB's pin annotation; `spec.loadBalancerIP` is deprecated upstream.
    metallb.io/loadBalancerIPs: {{ jellyfin_k8s_lan_ip }}
spec:
  type: LoadBalancer
  # Local preserves the client address; safe because the pod runs on the only node advertising this
  # VIP.
  externalTrafficPolicy: Local
  selector:
    app: jellyfin
  ports:
    - name: http
      port: {{ container_item.port }}
      targetPort: {{ container_item.port }}
