{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: zigbee2mqtt
  namespace: {{ k8s_namespace }}
spec:
  # Recreate: the RWO PVC deadlocks a rolling update, and the SLZB coordinator accepts ONE client.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: zigbee2mqtt
  template:
    metadata:
      labels:
        app: zigbee2mqtt
        netpol-baseline: enforced
    spec:
      # Pinned with the home-critical chain to the VIP node; see home-assistant's DECIDED marker.
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_primary_node }}
{{ pod_shell(services | tier_priority_class('zigbee2mqtt'), run_as_user=puid, run_as_group=pgid, fs_group=pgid) }}
      # Reinstalls the rendered configuration.yaml on every start; the rest of the data dir is z2m's
      # own.
      initContainers:
        - name: config-install
          image: {{ zigbee2mqtt_k8s_init_image }}
          imagePullPolicy: IfNotPresent
          command:
            - sh
            - -c
            - install -m 640 /secret/configuration.yaml /data/configuration.yaml
{{ hardened_security_context(read_only=true, non_root=true) }}
          volumeMounts:
            - name: zigbee2mqtt-config-secret
              mountPath: /secret
              readOnly: true
            - name: zigbee2mqtt-data
              mountPath: /data
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
        # DECIDED: z2m starts only once mosquitto answers an MQTT CONNECT (#8586). A TCP wait
        # passes a broker that accepts the port but sends no CONNACK yet, and z2m exits on
        # that too. The CONNECT is anonymous: mosquitto refuses it with CONNACK code 5, and
        # any CONNACK (first byte 0x20) proves the broker is serving, so no credential sits in
        # the pod spec. After 180 s the init container fails into kubelet's backoff, where the
        # pod shows Init:CrashLoopBackOff instead of hanging unseen.
        - name: mqtt-broker-wait
          image: {{ zigbee2mqtt_k8s_init_image }}
          imagePullPolicy: IfNotPresent
          command:
            - sh
            - -c
            - >-
              timeout 180 sh -c "until printf '\020\024\000\004MQTT\004\002\000\074\000\010z2m-wait'
              | timeout 3 nc {{ zigbee2mqtt_k8s_mqtt_broker }} 1883 | head -c 1 | od -An -tx1
              | grep -qx ' 20'; do echo 'waiting for a CONNACK from {{ zigbee2mqtt_k8s_mqtt_broker }}:1883';
              sleep 2; done"
{{ hardened_security_context(read_only=true, non_root=true) }}
{{ container_resources(cpu_limit='100m', mem_limit='32Mi', cpu_request='10m', mem_request='8Mi') }}
      containers:
        - name: zigbee2mqtt
          image: {{ zigbee2mqtt_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 8080
          # Every persisted path resolves under the data mount.
{{ hardened_security_context(read_only=true, non_root=true) }}
          env:
            - name: TZ
              value: "{{ tz }}"
            # DECIDED: Z2M's in-process watchdog absorbs a coordinator socket reset (#8322).
            # The SLZB drops the TCP link with `read ECONNRESET` and accepts a reconnect 2 s
            # later, so a 3 s in-process restart replaces a container restart. The delays
            # (minutes) sum to 48 s, inside the liveness window (3 x 30 s): the frontend is
            # down while the watchdog waits, so a longer list would only end in a kubelet
            # kill. A coordinator gone for minutes exhausts the list, and the container
            # exits into kubelet's backoff and the crash-loop alert. Liveness stays because
            # it is the only hang detection this pod has. The watchdog arms only after the
            # first successful start; the mqtt-broker-wait init container covers a broker
            # not ready at boot.
            - name: Z2M_WATCHDOG
              value: "0.05,0.25,0.5"
          volumeMounts:
            - name: zigbee2mqtt-data
              mountPath: /app/data
            # z2m's rotating logs; appending logs churn blocks every night.
            - name: zigbee2mqtt-log
              mountPath: /app/data/log
          # Z2M takes a moment to connect to the coordinator before the frontend serves.
          readinessProbe:
            httpGet:
              path: /
              port: 8080
            initialDelaySeconds: 15
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: 8080
            initialDelaySeconds: 60
            periodSeconds: 30
{{ container_resources(cpu_limit=zigbee2mqtt_k8s_cpu_limit, mem_limit=zigbee2mqtt_k8s_mem_limit, cpu_request=zigbee2mqtt_k8s_cpu_request, mem_request=zigbee2mqtt_k8s_mem_request) }}
      volumes:
        - name: zigbee2mqtt-config-secret
          secret:
            secretName: zigbee2mqtt-config
        - name: zigbee2mqtt-data
          persistentVolumeClaim:
            claimName: {{ zigbee2mqtt_k8s_claim }}
        - name: zigbee2mqtt-log
          emptyDir: {}
