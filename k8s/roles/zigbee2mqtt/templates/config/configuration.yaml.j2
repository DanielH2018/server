# Managed by Ansible (k8s/roles/zigbee2mqtt). Source of truth — overwritten on deploy.
# Device pairings + network state live in ./data (database.db, coordinator_backup.json,
# devices.yaml, groups.yaml), owned by Z2M and backed up with the volume. NOT templated here.
homeassistant:
  enabled: true
mqtt:
  base_topic: zigbee2mqtt
  server: mqtt://{{ zigbee2mqtt_k8s_mqtt_broker | default(mqtt_k8s_vip) }}:1883
  user: "{{ mqtt_username }}"
  password: "{{ mqtt_password }}"
serial:
  port: tcp://{{ slzb_ip }}:6638
  adapter: ember
frontend:
  enabled: true
  host: 0.0.0.0
  port: 8080
advanced:
  log_level: info
  # Pinned identity: a templated redeploy must not regenerate it and un-pair every device.
  network_key: {{ zigbee_network_key }}
  pan_id: {{ zigbee_pan_id }}
  ext_pan_id: {{ zigbee_ext_pan_id }}
# Device availability tracking, off by default in Z2M 2.x. It publishes online/offline to
# zigbee2mqtt/<device>/availability and adds availability_topic to the HA MQTT-discovery configs,
# so a dropped device's HA entities go `unavailable` (the bedroom_sensor_offline_alert automation
# reads that). `active` = mains/routed devices (the Hue bulbs), polled every `timeout` min.
# `passive` = battery end-devices (FP300, Tap Dial) that cannot be pinged without draining them,
# so they are judged on last-seen alone. 60 min is a starting point: the Tap Dial self-reports
# every ~7-18 min and the FP300 is very chatty. Z2M's default is 1500 min.
availability:
  enabled: true
  active:
    timeout: 10
  passive:
    timeout: 60
devices: devices.yaml
groups: groups.yaml
