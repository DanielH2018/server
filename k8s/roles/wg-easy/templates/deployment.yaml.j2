{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: wg-easy
  namespace: {{ k8s_namespace }}
spec:
  # ReadWriteOnce PVC on single-replica Longhorn — a rolling update would deadlock on the volume.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: wg-easy
  template:
    metadata:
      labels:
        app: wg-easy
        netpol-baseline: enforced
    spec:
      # Pinned to the VIP node: with ETP Local a pod elsewhere black-holes UDP 51820 while healthy.
      # Moves only with the L2Advertisement nodeSelector; this is the remote-access path.
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_primary_node }}
      # Tier 1, not tier 4: evicting the remote-access path removes the way back in to fix the
      # pressure.
{{ pod_shell(services | tier_priority_class('wg-easy')) }}
      securityContext:
        # /proc/sys is read-only in a pod: sysctls go in the spec, admitted by the kubelet
        # allow-list.
        # src_valid_mark is pre-set so wg-quick skips its own doomed write.
        sysctls:
          - name: net.ipv4.ip_forward
            value: "1"
          - name: net.ipv4.conf.all.src_valid_mark
            value: "1"
      # Seeded files arrive uid-1000, and root without DAC_OVERRIDE cannot read them: wg-easy would
      # then generate a new keypair and invalidate every client. CAP_CHOWN lets the init chown to
      # uid 0.
      initContainers:
        - name: config-chown
          image: {{ wg_easy_k8s_image }}
          imagePullPolicy: IfNotPresent
          command:
            - chown
            - -R
            - "0:0"
            - /etc/wireguard
{{ hardened_security_context(add=['CHOWN']) }}
          volumeMounts:
            - name: wg-easy-config
              mountPath: /etc/wireguard
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
        # Keeps WireGuard peers out of the cluster's pod and service networks. The server
        # MASQUERADEs peer traffic out of this pod (ip_forward above), so without these rules a
        # peer arrives at any ClusterIP or pod IP as the wg-easy pod and reaches every backend
        # that no ingress NetworkPolicy fences, skipping the Authelia gate on its route. Peers
        # keep the LAN: SSH to the nodes and the Pi (the way back in), and the Traefik and DNS
        # VIPs, which are LAN addresses that kube-proxy DNATs in the HOST netns, after this
        # pod's FORWARD chain has already passed them.
        #
        # DECIDED: a one-shot init container, not a re-asserting sidecar. v15 keeps PostUp in
        # its SQLite DB (no env override), and upstream v15.4.0's default PostUp APPENDS
        # `-A FORWARD -i wg0 -j ACCEPT` (migration 0001) while PostDown deletes exactly those
        # rules; its firewall step (src/server/utils/firewall.ts) only ever touches the
        # WG_CLIENTS chain and its jump. So a DROP inserted at position 1 before wg-easy starts
        # stays above the ACCEPT through startup, a container restart (the pod netns survives
        # it) and the UI's Restart Interface; a pod recreate reruns this. Same image as the
        # main container on purpose: it selects iptables-legacy via update-alternatives, and
        # another image could write the rules into the nft tables wg-quick never reads.
        # Enabling per-client filtering in the UI inserts the WG_CLIENTS jump ABOVE these rules.
        - name: peer-cluster-drop
          image: {{ wg_easy_k8s_image }}
          imagePullPolicy: IfNotPresent
          command:
            - sh
            - -ec
            - |
{% for cidr in [k3s_pod_cidr, k3s_service_cidr] %}
              iptables -C FORWARD -i wg0 -d {{ cidr }} -j DROP 2>/dev/null || iptables -I FORWARD 1 -i wg0 -d {{ cidr }} -j DROP
{% endfor %}
              iptables -S FORWARD
          # NET_RAW because iptables-legacy opens a raw socket; NET_ADMIN to write the table.
{{ hardened_security_context(add=['NET_ADMIN', 'NET_RAW']) }}
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
      containers:
        - name: wg-easy
          image: {{ wg_easy_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{ container_item.udp_port }}
              protocol: UDP
            - containerPort: {{ container_item.port }}
              protocol: TCP
          # v15 reads almost no environment: the endpoint hostname, the UDP port, the keepalive and
          # the client DNS live in the app's own SQLite DB, set through the Admin Panel.
          # `container_item.default_dns` in host_vars records what the client DNS should be;
          # nothing renders it.
          env:
            # Plain HTTP from Traefik is refused by v15 without INSECURE; the public route stays
            # https.
            - name: INSECURE
              value: "true"
            # IPv6 off: the kubelet allow-list excludes net.ipv6.* on purpose, and widening it
            # restarts both nodes.
            # The UI still shows unrouted IPv6 addresses; the CLI overrides this, so check new peer
            # configs.
            - name: DISABLE_IPV6
              value: "true"
          # NET_RAW is carried over from v14 and is a candidate to drop once v15 is proven.
          # No SYS_MODULE: the wireguard module loads on the host, and /lib/modules is read-only.
{{ hardened_security_context(add=['NET_ADMIN', 'NET_RAW']) }}
          volumeMounts:
            - name: wg-easy-config
              mountPath: /etc/wireguard
            # Read-only view for v15's wireguard module check; the host loads it, so SYS_MODULE
            # stays dropped.
            - name: host-lib-modules
              mountPath: /lib/modules
              readOnly: true
          # TCP on the admin UI proves the app is up; the wg interface has no cheap in-pod probe.
          readinessProbe:
            tcpSocket:
              port: {{ container_item.port }}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            tcpSocket:
              port: {{ container_item.port }}
            initialDelaySeconds: 15
            periodSeconds: 30
{{ container_resources(cpu_limit=wg_easy_k8s_cpu_limit, mem_limit=wg_easy_k8s_mem_limit, cpu_request=wg_easy_k8s_cpu_request, mem_request=wg_easy_k8s_mem_request) }}
      volumes:
        - name: wg-easy-config
          persistentVolumeClaim:
            claimName: {{ wg_easy_k8s_claim }}
        - name: host-lib-modules
          hostPath:
            path: /lib/modules
            type: Directory
