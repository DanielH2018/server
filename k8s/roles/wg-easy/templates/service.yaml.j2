---
apiVersion: v1
kind: Service
metadata:
  name: wg-easy
  namespace: {{ k8s_namespace }}
spec:
  selector:
    app: wg-easy
  ports:
    - name: web
      port: {{ container_item.port }}
      targetPort: {{ container_item.port }}
---
# On the node's own address: the router's 51820/udp forward targets the device daniel-box.
# Local policy so the pod sees real client addresses.
apiVersion: v1
kind: Service
metadata:
  name: wg-easy-udp
  namespace: {{ k8s_namespace }}
spec:
  # LoadBalancer: externalTrafficPolicy needs an external type; traffic arrives via the externalIP.
  type: LoadBalancer
  externalTrafficPolicy: Local
  externalIPs:
    - {{ hosts[k8s_primary_node].server_ip }}
  selector:
    app: wg-easy
  ports:
    - name: wireguard
      port: {{ container_item.udp_port }}
      targetPort: {{ container_item.udp_port }}
      protocol: UDP
