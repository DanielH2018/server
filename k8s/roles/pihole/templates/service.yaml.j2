---
# Instance 1 ONLY, unlike pihole-dns: admin sessions live in one FTL's memory, so round-robin 401s.
# DNS stays balanced across both because queries are stateless; do not "fix" this split.
apiVersion: v1
kind: Service
metadata:
  name: pihole
  namespace: {{ k8s_namespace }}
spec:
  selector:
    app: pihole
    instance: pihole
  ports:
    - name: web
      port: {{ container_item.port }}
      targetPort: {{ container_item.port }}
---
# Instance 2's web port, for pihole-exporter only: scraping one instance reports half the queries.
# No IngressRoute: a second admin route would reintroduce the random 401s.
apiVersion: v1
kind: Service
metadata:
  name: pihole-2-web
  namespace: {{ k8s_namespace }}
spec:
  selector:
    app: pihole
    instance: pihole-2
  ports:
    - name: web
      port: {{ container_item.port }}
      targetPort: {{ container_item.port }}
---
# The LAN DNS seam: one pinned VIP the router's DHCP DNS option points at.
apiVersion: v1
kind: Service
metadata:
  name: pihole-dns
  namespace: {{ k8s_namespace }}
  annotations:
    metallb.io/loadBalancerIPs: {{ pihole_k8s_lan_ip }}
spec:
  type: LoadBalancer
  # Pinned because CoreDNS forwards here by address — see coredns_upstreams.
  clusterIP: {{ pihole_k8s_dns_cluster_ip }}
  # Preserves real client addresses in Pi-hole's per-client query log. Safe on a single node.
  externalTrafficPolicy: Local
  selector:
    app: pihole
  ports:
    - name: dns-udp
      port: 53
      targetPort: 53
      protocol: UDP
    - name: dns-tcp
      port: 53
      targetPort: 53
      protocol: TCP
