{# The LAN wildcard answers the cluster ingress VIP — k8s services route natively. The
   shared template defaults its wildcard to the rendering host's server_ip, which HERE would
   be daniel-box; pin it to the VIP. #}
{% set pihole_wildcard_ip = k3s_metallb_ingress_vip %}
{% set pihole_unbound_port = pihole_k8s_unbound_port %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: pihole-dns-config
  namespace: {{ k8s_namespace }}
data:
  # Jinja include, not lookup('template'): it shares this template's local set-variables.
  02-wildcard.conf: |
{% filter indent(4, true) %}
{% include 'config/pihole-dnsmasq.conf.j2' %}
{% endfilter %}

  # The blank line above is LOAD-BEARING: an include drops the trailing newline, so this key would
  # concatenate onto the previous block (valid YAML, one key) and unbound crash-loops.
  my_settings.conf: |
{% filter indent(4, true) %}
{% include 'config/pihole-unbound.conf.j2' %}
{% endfilter %}
