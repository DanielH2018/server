server:
{% if pihole_unbound_port is defined %}
    # Pod only: FTL owns :53 in the shared network namespace, so unbound moves off it.
    port: {{ pihole_unbound_port }}
{% endif %}
    verbosity: 1
    do-ip6: no

    # 2 threads so cache-miss bursts do not queue behind one (dnsmasq dns-forward-max=150).
    # outgoing-range is PER THREAD: 2 threads need ~16k sockets, so nofile must cover both.
    num-threads: 2

    # Do not restate prefetch, cache sizes or serve-expired: the base config already sets them.
    # cache-min-ttl is unset there; 60 floors short TTLs, while 300+ would blunt DNS failover.
    cache-min-ttl: 60

    # Set to 0 to use system default and avoid startup warnings
    so-sndbuf: 0

    so-rcvbuf: 0

    access-control: 127.0.0.0/8 allow
    access-control: 10.0.0.0/8 allow
    access-control: 172.16.0.0/12 allow
    access-control: 192.168.0.0/16 allow

    # Ensure privacy of local IP ranges
    private-address: 192.168.0.0/16
    private-address: 172.16.0.0/12
    private-address: 10.0.0.0/8
