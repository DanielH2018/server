{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
{#
  The Deployment body both Pi-hole instances render, parameterised by instance name and claim.

  A macro rather than a loop in one template, and two callers rather than one, because
  `kubectl apply -f <dir>/` applies every file in the directory in a single request: with both
  Deployments in one file, an image-pin bump changes both pod templates in that one apply and
  the controller Recreate-cycles both instances in the same second. Separate
  files are what lets `pihole-deferred` apply the second instance only after the first is
  serving again. Rendering this body twice by hand instead would let the two instances drift
  apart silently — the thing the second instance exists to be a copy of.

  This file renders to nothing on its own, and pihole's include names it in
  `manifests_exclude_files`, so no deploy ever stages it. It is `.yaml.j2` rather than `.yml.j2` all the same: the shell-macro census, the
  workload-shell-comes-from-the-macros row of tests/repo/census_rows/test_census_rows_roles.py, globs
  `templates/*.yaml.j2` and reads
  `kind:` out of the TEXT, and it cannot see through a macro call — so the body has to be the
  file that census scans or pihole's Deployments leave it silently.
#}
{% macro pihole_deployment(name, claim) %}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ name }}
  namespace: {{ k8s_namespace }}
spec:
  # ReadWriteOnce PVC on single-replica Longhorn — a rolling update would deadlock on the volume.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: pihole
  template:
    metadata:
      labels:
        app: pihole
        netpol-baseline: enforced
        # Pod-only: do not add to the immutable selector; `kubectl exec deploy/<name>` picks any
        # pod.
        instance: {{ name }}
    spec:
      # Pinned to the VIP-announcing node while the MetalLB L2Advertisement is pinned
      # to daniel-box: with externalTrafficPolicy Local, a VIP-backed pod on the other
      # node makes the announcer DROP all forwarded LAN traffic (the post-boot
      # DNS blackout). DECIDED: permanent posture (operator 2026-08-14) — with ETP Local
      # load-bearing for client IPs, announcement and placement stay on one node as a
      # unit; this pin only ever moves together with the L2Advertisement nodeSelector.
      # BOTH instances pin here, deliberately. Every VIP is announced from a single node
      # (k8s/roles/metallb/templates/metallb-pool.yaml.j2, marked PERMANENT), and externalTrafficPolicy: Local
      # means a pod on the other node would receive nothing. Redundancy here is against a
      # rollout, not against node loss.
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_primary_node }}
      # Edge/auth/DNS eviction ordering — see k8s/roles/cluster-base/templates/priorityclass.yaml.j2.
{{ pod_shell(services | tier_priority_class('pihole')) }}
      containers:
        # No depends_on: FTL retries its upstream and readiness keeps the Services dark until DNS
        # works.
        - name: pihole
          image: {{ pihole_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 53
              protocol: UDP
            - containerPort: 53
              protocol: TCP
            - containerPort: {{ container_item.port }}
              protocol: TCP
          env:
            - name: TZ
              value: "{{ tz }}"
            - name: FTLCONF_dns_upstreams
              value: "127.0.0.1#{{ pihole_k8s_unbound_port }}"
            - name: FTLCONF_dns_listeningMode
              value: all
            - name: FTLCONF_misc_etc_dnsmasq_d
              value: "true"
          envFrom:
            # envFrom keeps the password out of the pod spec, which the read-only kubeconfig can
            # read.
            - secretRef:
                name: pihole-env
          # Root by image design: FTL sets file caps (SETFCAP) and s6 init chowns /etc/pihole before
          # dropping. No NET_RAW: that was for DHCP raw sockets and this pod is DNS-only.
{{ hardened_security_context(add=['CHOWN', 'DAC_OVERRIDE', 'NET_ADMIN', 'NET_BIND_SERVICE', 'SETFCAP', 'SETUID', 'SETGID', 'SYS_NICE']) }}
          volumeMounts:
            - name: etc-pihole
              mountPath: /etc/pihole
            # items: the ConfigMap also holds unbound's config, and dnsmasq parses EVERY file in its
            # conf-dir. Mounting my_settings.conf here would kill FTL at startup.
            - name: dns-config
              mountPath: /etc/dnsmasq.d/02-wildcard.conf
              subPath: 02-wildcard.conf
              readOnly: true
          # pi.hole is answered by FTL itself, so readiness does not depend on internet
          # reachability.
          readinessProbe:
            exec:
              command: [dig, +short, +tries=1, +time=2, "@127.0.0.1", pi.hole]
            periodSeconds: 10
          livenessProbe:
            tcpSocket:
              port: 53
            periodSeconds: 30
          # First boot builds gravity from scratch (~200k domains), so allow a generous window.
          startupProbe:
            tcpSocket:
              port: 53
            periodSeconds: 10
            failureThreshold: 60
{{ container_resources(cpu_limit=pihole_k8s_cpu_limit, mem_limit=pihole_k8s_mem_limit, cpu_request=pihole_k8s_cpu_request, mem_request=pihole_k8s_mem_request) }}
        - name: unbound
          image: {{ pihole_k8s_unbound_image }}
          imagePullPolicy: IfNotPresent
          # Starts as root to read config, then drops to unbound: SETUID/SETGID only; its port is
          # >1024.
{{ hardened_security_context(add=['SETUID', 'SETGID']) }}
          volumeMounts:
            - name: dns-config
              mountPath: /etc/unbound/custom.conf.d/my_settings.conf
              subPath: my_settings.conf
              readOnly: true
          # drill-hc passes args through to drill; timeout 30s — DNSSEC validation can be slow.
          readinessProbe:
            exec:
              command: [drill-hc, -p, "{{ pihole_k8s_unbound_port }}", "@127.0.0.1", dnssec.works]
            periodSeconds: 30
            timeoutSeconds: 30
          livenessProbe:
            exec:
              command: [drill-hc, -p, "{{ pihole_k8s_unbound_port }}", "@127.0.0.1", dnssec.works]
            periodSeconds: 60
            timeoutSeconds: 30
            failureThreshold: 3
{{ container_resources(cpu_limit=pihole_k8s_unbound_cpu_limit, mem_limit=pihole_k8s_unbound_mem_limit, cpu_request=pihole_k8s_unbound_cpu_request, mem_request=pihole_k8s_unbound_mem_request) }}
      volumes:
        - name: etc-pihole
          persistentVolumeClaim:
            claimName: {{ claim }}
        - name: dns-config
          configMap:
            name: pihole-dns-config
{%- endmacro %}
