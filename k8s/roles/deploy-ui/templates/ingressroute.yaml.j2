{% from 'ingressroute.yml.j2' import ingressroute with context %}
{# Each name sits behind Authelia two_factor: the per-service rule covers the LAN name and the
   `*.<domain>` wildcard the public one. #}
---
{{ ingressroute(
    container_item.name,
    container_item.hostname | default(container_item.name),
    container_item.port,
    container_item.use_authelia
  )
}}
