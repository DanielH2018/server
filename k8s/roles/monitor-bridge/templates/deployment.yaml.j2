{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: monitor-bridge
  namespace: {{ k8s_namespace }}
spec:
  # One evaluator at a time: streak state is in-process, and two pods would interleave contradictory
  # verdicts.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: monitor-bridge
  template:
    metadata:
      labels:
        app: monitor-bridge
        netpol-baseline: enforced
    spec:
      # Without fsGroup the root-owned 0440 credential files are unreadable to the non-root uid and
      # file-mounted checks self-disable.
{{ pod_shell(services | tier_priority_class('monitor-bridge'), run_as_user=puid, run_as_group=pgid, fs_group=pgid, non_root=true) }}
      # Pinned to daniel-box (etcd drill stamp hostPath), off daniel-server so its drain never takes
      # alerting down.
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_primary_node }}
      containers:
        - name: monitor-bridge
          image: {{ monitor_bridge_k8s_image }}
          imagePullPolicy: IfNotPresent
          command: ["python", "/app/cli.py"]
          ports:
            - name: metrics
              containerPort: {{ monitor_bridge_deploy_pipeline_port }}
            - name: checks
              containerPort: {{ services | metrics_port('monitor-bridge') }}
{{ hardened_security_context(read_only=true) }}
          # A quoted number stays out of the Secret (Flux reads "300" as a number); `to_json` writes
          # each value double-quoted.
          env:
{% for name, value in lookup('template', role_file('templates/config/env.yaml.j2')) | from_yaml | dictsort %}
            - name: {{ name }}
              value: {{ value | to_json }}
{% endfor %}
          envFrom:
            - secretRef:
                name: monitor-bridge-env
          # cli.py touches /tmp/heartbeat each cycle; a stale mtime means the loop HUNG.
          livenessProbe:
            exec:
              command:
                - python3
                - -c
                - "import os,sys,time; sys.exit(0 if time.time()-os.stat('/tmp/heartbeat').st_mtime<1000 else 1)"
            initialDelaySeconds: 120
            periodSeconds: 60
            failureThreshold: 3
          volumeMounts:
            - name: monitor-bridge-script
              mountPath: /app
              readOnly: true
            - name: monitor-bridge-credentials
              mountPath: /etc/bridge-credentials
              readOnly: true
            - name: monitor-bridge-tmp
              mountPath: /tmp
            - name: monitor-bridge-etcd-drill-state
              mountPath: /etcd-drill-state
              readOnly: true
          # 1 core, not 200m: a burst-shaped poller throttles at the lower limit.
{{ container_resources(cpu_limit='1', mem_limit='96Mi', cpu_request='20m', mem_request='32Mi') }}
      volumes:
        # Keys are flat (a ConfigMap key cannot contain `/`); `items:` puts each back at its path.
        - name: monitor-bridge-script
          projected:
            sources:
{% for module in monitor_bridge_modules %}
              - configMap:
                  name: monitor-bridge-script-{{ module[:-3] | replace('/', '-') | replace('_', '-') }}
                  items:
                    - key: {{ module | replace('/', '_') }}
                      path: {{ module }}
{% endfor %}
        - name: monitor-bridge-credentials
          # Not monitor-bridge-env: envFrom injects every key of that Secret as an env var.
          secret:
            secretName: monitor-bridge-credentials
            defaultMode: 0440
            items:
              - key: ha_token
                path: ha_token
              - key: b2_probe_application_key # gitleaks:allow — a Secret item NAME, not a value
                path: b2_probe_application_key
              - key: cf_analytics_token # gitleaks:allow — a Secret item NAME, not a value
                path: cf_analytics_token
              - key: speedtest_api_token # gitleaks:allow — a Secret item NAME, not a value
                path: speedtest_api_token
              - key: healthchecks_api_read_only_key # gitleaks:allow — a Secret item NAME, not a value
                path: healthchecks_api_read_only_key
              - key: uptimerobot_api_key # gitleaks:allow — a Secret item NAME, not a value
                path: uptimerobot_api_key
              - key: r2_s3_secret_key # gitleaks:allow — a Secret item NAME, not a value
                path: r2_s3_secret_key
        - name: monitor-bridge-tmp
          emptyDir: {}
        # `DirectoryOrCreate`, not `Directory`: a plain Directory leaves the pod unschedulable until
        # the drill has run.
        - name: monitor-bridge-etcd-drill-state
          hostPath:
            path: /var/lib/etcd-restore-drill
            type: DirectoryOrCreate
