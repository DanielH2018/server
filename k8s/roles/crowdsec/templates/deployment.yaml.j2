{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: crowdsec
  namespace: {{ k8s_namespace }}
spec:
  # RWO DB volume — the old engine must release it before a new one opens the SQLite file.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: crowdsec
  template:
    metadata:
      labels:
        app: crowdsec
        netpol-baseline: enforced
    spec:
      # Pinned to the node announcing the VIPs; the DECIDED marker in home-assistant's
      # deployment.yaml.j2 has why.
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_primary_node }}
      # The token is not automounted: the crowdsec-jobs-token volume projects it into the sidecar
      # alone, so the engine holds no Kubernetes credential. The volume sits off the default path
      # (row no-mount-shadows-the-serviceaccount-token).
{{ pod_shell(services | tier_priority_class('crowdsec'), service_account='crowdsec-jobs', automount=false) }}
      initContainers:
        # The entrypoint overwrites /etc/crowdsec with defaults; seeding first makes it treat ours
        # as existing config.
        - name: config-install
          image: {{ crowdsec_k8s_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
            - >-
              install -m 644 /seed/acquis.yaml /seed/profiles.yaml /etc/crowdsec/ &&
              install -d /etc/crowdsec/parsers/s02-enrich /etc/crowdsec/notifications &&
              install -m 644 /seed/whitelist.yaml /seed/trusted-remote-whitelist.yaml
              /etc/crowdsec/parsers/s02-enrich/ &&
              install -m 600 /seed/discord.yaml /etc/crowdsec/notifications/
{{ hardened_security_context() }}
          volumeMounts:
            - name: crowdsec-seed
              mountPath: /seed
              readOnly: true
            - name: crowdsec-etc
              mountPath: /etc/crowdsec
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
        # Registers every agent machine and creates the two operator allowlists before the LAPI
        # serves;
        # the entrypoint registers only its own agent.
        # cscli writes the SQLite file directly, needing no LAPI; the config is the image's staging
        # copy because the entrypoint writes config.yaml only after initContainers run.
        # A re-run adds nothing (no `--force`), so a rotated password needs the registrations
        # deleted first (docs/secret-rotation.md).
        # An existing allowlist is the one tolerated failure; any other exits non-zero and holds the
        # pod.
        # The password reaches `cscli` in argv, readable by node root in `ps`; the entrypoint does
        # the same.
        - name: lapi-register
          image: {{ crowdsec_k8s_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
            - |
              set -e
              cs() { cscli -c /staging/etc/crowdsec/config.yaml "$@"; }
              for machine in {{ ((crowdsec_k8s_sidecar_agents.values() | list) + crowdsec_k8s_node_agent_machines + ['crowdsec-verify']) | join(' ') }}; do
                if ! cs machines list -o raw | grep -q "^$machine,"; then
                  cs machines add "$machine" --password "$AGENT_PASSWORD" -f /dev/null
                fi
              done
              allowlist() {
                if ! out=$(cs allowlists create "$1" --description "$2" 2>&1); then
                  case "$out" in
                    *"already exist"*) ;;
                    *) echo "$out" >&2; exit 1 ;;
                  esac
                fi
              }
              allowlist home-ips 'Home IPs'
              allowlist remote-ips 'Authenticated remote exits, TTL-managed by remote_allowlist.py'
          env:
            - name: AGENT_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: crowdsec-env
                  key: AGENT_PASSWORD
          # Root with every capability dropped: crowdsec-db and its SQLite file belong to root, so
          # the owner's write bit is enough.
{{ hardened_security_context(read_only=true) }}
          volumeMounts:
            - name: crowdsec-etc
              mountPath: /etc/crowdsec
              readOnly: true
            - name: crowdsec-db
              mountPath: /var/lib/crowdsec/data
            - name: crowdsec-tmp
              mountPath: /tmp
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
        # cscli comes from the engine's own image so the jobs run the same version; it is statically
        # linked, so it runs in the python image.
        - name: jobs-cscli
          image: {{ crowdsec_k8s_image }}
          imagePullPolicy: IfNotPresent
          command: ["cp", "/usr/local/bin/cscli", "/tools/cscli"]
          # nobody: the emptyDir is world-writable and the copy keeps 0755, so the root sidecar runs
          # it as `other`.
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=65534, run_as_group=65534) }}
          volumeMounts:
            - name: crowdsec-jobs-tools
              mountPath: /tools
{{ container_resources(cpu_limit='100m', mem_limit='64Mi', cpu_request='10m', mem_request='16Mi') }}
        - name: jobs-kubectl
          image: {{ crowdsec_k8s_jobs_kubectl_image }}
          imagePullPolicy: IfNotPresent
          command: ["cp", "/usr/bin/kubectl", "/tools/kubectl"]
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=65534, run_as_group=65534) }}
          volumeMounts:
            - name: crowdsec-jobs-tools
              mountPath: /tools
{{ container_resources(cpu_limit='100m', mem_limit='64Mi', cpu_request='10m', mem_request='16Mi') }}
      containers:
        - name: crowdsec
          image: {{ crowdsec_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: lapi
              containerPort: {{ crowdsec_k8s_lapi_port }}
            - name: appsec
              containerPort: {{ crowdsec_k8s_appsec_port }}
            - name: metrics
              containerPort: {{ services | metrics_port('crowdsec') }}
          env:
            - name: TZ
              value: "{{ tz }}"
            - name: COLLECTIONS
              value: "{{ crowdsec_k8s_collections }}"
          envFrom:
            - secretRef:
                name: crowdsec-env
          # Root: the LAPI plugin broker forks the notification plugin and drops it to 'nobody'
          # (SETUID/SETGID);
          # CHOWN+DAC_OVERRIDE cover first-touch ownership of the PVC-backed DB dir.
{{ hardened_security_context(add=['CHOWN', 'DAC_OVERRIDE', 'SETUID', 'SETGID']) }}
          volumeMounts:
            - name: crowdsec-etc
              mountPath: /etc/crowdsec
            - name: crowdsec-db
              mountPath: /var/lib/crowdsec/data
            - name: crowdsec-tmp
              mountPath: /tmp
          # `cscli lapi status` round-trips the LAPI with real credentials, so ready means the
          # WAF/ban chain can answer;
          # cscli reads creds from files, so none appear in the probe spec.
          readinessProbe:
            exec:
              command: ["cscli", "lapi", "status"]
            initialDelaySeconds: 15
            periodSeconds: 15
            timeoutSeconds: 10
          livenessProbe:
            exec:
              command: ["cscli", "lapi", "status"]
            initialDelaySeconds: 60
            periodSeconds: 60
            timeoutSeconds: 10
{{ container_resources(cpu_limit=crowdsec_k8s_cpu_limit, mem_limit=crowdsec_k8s_mem_limit, cpu_request=crowdsec_k8s_cpu_request, mem_request=crowdsec_k8s_mem_request) }}
        # Shares the engine's config and database volumes, so cscli reaches the LAPI's database with
        # no `pods/exec` grant.
        # Root with every capability dropped (the SQLite file belongs to root); /etc/crowdsec is
        # read-only so a job cannot change the engine's config.
        # No probe: a crash takes the pod out of Ready and the LAPI out of its Service, so the
        # scheduler never exits on a job failure.
        - name: crowdsec-jobs
          image: {{ crowdsec_k8s_jobs_image }}
          imagePullPolicy: IfNotPresent
          command: ["python3", "/jobs/crowdsec_jobs.py"]
          ports:
            - name: jobs-metrics
              containerPort: {{ services | metrics_port('crowdsec-jobs') }}
          env:
            # kubectl's discovery cache goes under $HOME.
            - name: HOME
              value: /tmp
            # The ConfigMap mount is read-only, so Python cannot write __pycache__ there.
            - name: PYTHONDONTWRITEBYTECODE
              value: "1"
            # A pipe is block-buffered and an OOM kill discards the buffer, so each verdict line
            # must be unbuffered.
            - name: PYTHONUNBUFFERED
              value: "1"
            - name: KUBECONFIG
              value: /jobs/kubeconfig
            - name: JOBS_METRICS_PORT
              value: "{{ services | metrics_port('crowdsec-jobs') }}"
            - name: HOME_IPS_CONFIGMAP
              value: "{{ crowdsec_k8s_home_ips_configmap }}"
            - name: HOME_IPS_STALE_AFTER_S
              value: "{{ crowdsec_k8s_home_ips_stale_after_seconds }}"
{{ hardened_security_context(read_only=true) }}
          volumeMounts:
            - name: crowdsec-etc
              mountPath: /etc/crowdsec
              readOnly: true
            - name: crowdsec-db
              mountPath: /var/lib/crowdsec/data
            - name: crowdsec-jobs-code
              mountPath: /jobs
              readOnly: true
            - name: crowdsec-jobs-tools
              mountPath: /tools
              readOnly: true
            - name: crowdsec-jobs-token
              mountPath: /var/run/crowdsec-jobs
              readOnly: true
            - name: crowdsec-jobs-tmp
              mountPath: /tmp
            # The entrypoint links /staging/var/lib/crowdsec/data entries into crowdsec-db, `trace`
            # among them; this image has no /staging, so without the mount every cscli call fails
            # (`mkdir .../trace: file exists`).
            - name: crowdsec-jobs-trace
              mountPath: /staging/var/lib/crowdsec/data/trace
{{ container_resources(cpu_limit=crowdsec_k8s_jobs_cpu_limit, mem_limit=crowdsec_k8s_jobs_mem_limit, cpu_request=crowdsec_k8s_jobs_cpu_request, mem_request=crowdsec_k8s_jobs_mem_request) }}
      volumes:
        - name: crowdsec-seed
          secret:
            secretName: crowdsec-config
        - name: crowdsec-etc
          emptyDir: {}
        - name: crowdsec-db
          persistentVolumeClaim:
            claimName: {{ crowdsec_k8s_claim }}
        - name: crowdsec-tmp
          emptyDir: {}
        - name: crowdsec-jobs-code
          configMap:
            name: crowdsec-jobs
        - name: crowdsec-jobs-tools
          emptyDir: {}
        - name: crowdsec-jobs-tmp
          emptyDir: {}
        - name: crowdsec-jobs-trace
          emptyDir: {}
        # What automounting would give, to the sidecar alone: a bound token and the cluster CA the
        # kubeconfig names.
        - name: crowdsec-jobs-token
          projected:
            sources:
              - serviceAccountToken:
                  path: token
                  expirationSeconds: 3607
              - configMap:
                  name: kube-root-ca.crt
                  items:
                    - key: ca.crt
                      path: ca.crt
