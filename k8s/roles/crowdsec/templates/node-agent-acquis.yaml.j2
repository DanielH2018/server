---
apiVersion: v1
kind: ConfigMap
metadata:
  name: crowdsec-node-agent-acquis
  namespace: {{ k8s_namespace }}
data:
  acquis.yaml: |
    # The DIRECTORY /var/log is the hostPath mount, not the file: a single-file hostPath pins the
    # inode, and logrotate's `create` swaps it.
    filenames:
      - /var/log/auth.log
    labels:
      type: syslog
