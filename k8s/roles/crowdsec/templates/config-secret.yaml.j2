---
# A Secret because discord.yaml embeds the webhook URL and MapQuest key; the traefik and authelia
# Secrets read the same whitelist files from here.
apiVersion: v1
kind: Secret
metadata:
  name: crowdsec-config
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  acquis.yaml: |
    source: appsec
    listen_addr: 0.0.0.0:{{ crowdsec_k8s_appsec_port }}
    appsec_config: crowdsecurity/appsec-default
    name: k8s-traefik-appsec
    labels:
      type: appsec
  profiles.yaml: |
    {{ lookup('file', role_file('files/crowdsec-profiles.yaml')) | indent(4) }}
  whitelist.yaml: |
    {{ lookup('file', role_file('files/crowdsec-whitelist.yaml')) | indent(4) }}
  trusted-remote-whitelist.yaml: |
    {{ lookup('file', role_file('files/crowdsec-trusted-remote-whitelist.yaml')) | indent(4) }}
  discord.yaml: |
    {{ lookup('template', role_file('templates/config/crowdsec-discord.yaml.j2')) | indent(4) }}
---
# BOUNCER_KEY_<name> pre-registers a bouncer on LAPI init; AGENT_USERNAME/PASSWORD is the in-pod
# agent's identity;
# the lapi-register initContainer registers every other machine.
apiVersion: v1
kind: Secret
metadata:
  name: crowdsec-env
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  BOUNCER_KEY_k8straefik: "{{ crowdsec_k8s_bouncer_api_key }}"
  # No key for a dead bouncer (attack surface). Removing an env does NOT deregister one the
  # entrypoint already created:
  # run `cscli bouncers delete <name>` in the pod.
  AGENT_USERNAME: "{{ crowdsec_k8s_engine_machine }}"
  AGENT_PASSWORD: "{{ crowdsec_k8s_agent_password }}"
