{% from 'ingressroute.yml.j2' import ingressroute with context %}
---
{# Machine-key API for LAN agents and bouncers, deliberately NOT Authelia-gated: forward-auth would
   break their keys.
   public=false: the ban-management API must never gain a public Host rule, whatever k8s_public_route
   says. #}
{{ ingressroute(
    container_item.name,
    container_item.hostname | default(container_item.name),
    container_item.port,
    false,
    public=false
  )
}}
