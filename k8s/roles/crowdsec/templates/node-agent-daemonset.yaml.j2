{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import pod_shell with context %}
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: crowdsec-node-agent
  namespace: {{ k8s_namespace }}
spec:
  selector:
    matchLabels:
      app: crowdsec-node-agent
  template:
    metadata:
      labels:
        app: crowdsec-node-agent
        netpol-baseline: enforced
    spec:
{{ pod_shell(services | tier_priority_class('crowdsec')) }}
      initContainers:
        - name: config-install
          image: {{ crowdsec_k8s_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
            - >-
              install -m 644 /seed-acquis/acquis.yaml /etc/crowdsec/ &&
              install -d /etc/crowdsec/parsers/s02-enrich &&
              install -m 644 /seed/whitelist.yaml /seed/trusted-remote-whitelist.yaml
              /etc/crowdsec/parsers/s02-enrich/
{{ hardened_security_context() }}
          volumeMounts:
            - name: crowdsec-acquis
              mountPath: /seed-acquis
              readOnly: true
            - name: crowdsec-secret
              mountPath: /seed
              readOnly: true
            - name: crowdsec-etc
              mountPath: /etc/crowdsec
          # Wait for the LAPI before the agent starts: the entrypoint exits FATAL when the LAPI is
          # unreachable and has no retry, so the weekly node reboot racing the LAPI pod leaves
          # auth.log unparsed through crash-backoff.
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
        - name: wait-for-lapi
          image: {{ crowdsec_k8s_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
            # Bounded, 60 x 2s: a LAPI down for two minutes still fails the init container, so this
            # never masks a dead LAPI.
            # The retry also absorbs kube-router's source-pod lookup lagging pod creation.
            - >-
              i=0;
              until nc -z crowdsec {{ crowdsec_k8s_lapi_port }}; do
                i=$((i+1));
                [ "$i" -ge 60 ] && echo "LAPI still unreachable after 120s" >&2 && exit 1;
                sleep 2;
              done;
              echo "LAPI reachable after $((i*2))s"
{{ hardened_security_context() }}
{{ container_resources(cpu_limit='100m', mem_limit='32Mi', cpu_request='10m', mem_request='16Mi') }}
      containers:
        - name: crowdsec-agent
          image: {{ crowdsec_k8s_image }}
          imagePullPolicy: IfNotPresent
          env:
            - name: TZ
              value: "{{ tz }}"
            - name: DISABLE_LOCAL_API
              value: "true"
            - name: LOCAL_API_URL
              value: "http://crowdsec:{{ crowdsec_k8s_lapi_port }}"
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            # Per-node identity: two pods sharing a machine name would fight over its heartbeat;
            # crowdsec_k8s_node_agent_machines must list every node.
            - name: AGENT_USERNAME
              value: "k8s-node-agent-$(NODE_NAME)"
            - name: AGENT_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: crowdsec-env
                  key: AGENT_PASSWORD
            - name: COLLECTIONS
              value: "{{ crowdsec_k8s_node_agent_collections }}"
          # Root: auth.log is 640 syslog:adm on the host; nothing here writes it.
{{ hardened_security_context(add=['DAC_READ_SEARCH']) }}
          ports:
            - name: metrics
              containerPort: 6060
          volumeMounts:
            - name: crowdsec-etc
              mountPath: /etc/crowdsec
            # Hub datafiles re-download on start; the sqlite DB lives only in the LAPI pod.
            - name: crowdsec-data
              mountPath: /var/lib/crowdsec/data
            - name: crowdsec-host-logs
              mountPath: /var/log
              readOnly: true
            - name: crowdsec-tmp
              mountPath: /tmp
          livenessProbe:
            exec:
              command: ["cscli", "lapi", "status"]
            initialDelaySeconds: 30
            periodSeconds: 60
            timeoutSeconds: 15
{{ container_resources(cpu_limit='1', mem_limit='512Mi', cpu_request='50m', mem_request='192Mi') }}
      volumes:
        - name: crowdsec-acquis
          configMap:
            name: crowdsec-node-agent-acquis
        - name: crowdsec-secret
          secret:
            secretName: crowdsec-config
        - name: crowdsec-etc
          emptyDir: {}
        - name: crowdsec-data
          emptyDir: {}
        - name: crowdsec-host-logs
          hostPath:
            path: /var/log
            type: Directory
        - name: crowdsec-tmp
          emptyDir: {}
