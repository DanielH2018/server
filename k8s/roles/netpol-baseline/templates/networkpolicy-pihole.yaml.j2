{# DECIDED: pihole's :53 is open to every source over UDP and TCP, so this fence stays
   bespoke.
   The callers model (`netpol_from` / `netpol_fences`, macro in
   k8s/templates/networkpolicy.yml.j2) renders one TCP port admitting same-namespace `app:`
   peers, and its header rules out growing it to absorb another shape.
   One rule here would fit that model on its own, but splitting it out leaves this file
   behind anyway, doubles the policy objects on one pod and renames a live object under the
   armed prune, so the whole fence keeps one owner.
#}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: pihole
  namespace: {{ k8s_namespace }}
spec:
  # `app: pihole`, not the Service's selector: that covers only instance=pihole and would leave
  # pihole-2 open.
  podSelector:
    matchLabels:
      app: pihole
  policyTypes:
    - Ingress
  ingress:
{# Allow-all when the flag is false, the rollback lever. `| bool`: a string 'false' is truthy to
   Jinja. #}
{% if netpol_baseline_enforced | bool %}
    # :53 stays open: it serves every LAN client and cluster DNS (CoreDNS forwards from a
    # kube-system pod).
    - ports:
        - port: 53
          protocol: UDP
        - port: 53
          protocol: TCP
    # The admin UI and API, fenced to the callers below.
    #
    # pihole-exporter polls the v6 admin API on this same port — Pi-hole serves no separate
    # metrics endpoint — and it polls BOTH instances, which is why this policy's `app: pihole`
    # selector matters here rather than the Service's two-label one.
    #
    # pihole-gravity is pihole's gravity reconcile Job, which writes the declared blocklists
    # through the same API on both instances (pihole/templates/verify-inert/gravity.yaml.j2).
    #
    # airflow-task is the warehouse's dns_daily_rollup, which reads both instances' query
    # databases through the same API (airflow/files/dags/homelab_warehouse/dns_history.py).
    - from:
        - podSelector:
            matchLabels:
              app: airflow-task
        - podSelector:
            matchLabels:
              app: traefik
        - podSelector:
            matchLabels:
              app: homepage
        - podSelector:
            matchLabels:
              app: pihole-exporter
        - podSelector:
            matchLabels:
              app: pihole-gravity
      ports:
        - port: 80
          protocol: TCP
{% else %}
    # OFF. One empty rule admits everything. `ingress: []` would be the exact opposite and deny
    # everything, which is the easiest thing in this file to get backwards.
    - {}
{% endif %}
