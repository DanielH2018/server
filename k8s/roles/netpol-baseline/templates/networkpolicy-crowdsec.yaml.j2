{# DECIDED: crowdsec admits traefik on two ports (LAPI and AppSec) and prometheus from
   another namespace, so this fence stays bespoke.
   The callers model (`netpol_from` / `netpol_fences`, macro in
   k8s/templates/networkpolicy.yml.j2) renders one TCP port admitting same-namespace `app:`
   peers, and its header rules out growing it to absorb another shape.
#}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: crowdsec
  namespace: {{ k8s_namespace }}
spec:
  podSelector:
    matchLabels:
      app: crowdsec
  policyTypes:
    - Ingress
  ingress:
{# Allow-all when the flag is false, the rollback lever. `| bool`: a string 'false' is truthy to
   Jinja. #}
{% if netpol_baseline_enforced | bool %}
    # LAPI (8080) and AppSec (7422): the Traefik bouncer plugin.
    - from:
        - podSelector:
            matchLabels:
              app: traefik
      ports:
        - port: 8080
          protocol: TCP
        - port: 7422
          protocol: TCP
    # Own `from` item: sibling peers share the rule's ports list, which would hand node agents
    # AppSec.
    - from:
        - podSelector:
            matchLabels:
              app: crowdsec-node-agent
        # A crowdsec-agent SIDECAR inherits its pod's labels, so authelia's traffic arrives as `app:
        # authelia`.
        # Omitting it crash-loops the sidecar, unreadies authelia and breaks SSO.
        - podSelector:
            matchLabels:
              app: authelia
        # crowdsec-verify never dials AppSec, so it sits outside traefik's rule.
        - podSelector:
            matchLabels:
              app: crowdsec-verify
        # traefik-precheck never dials AppSec. It must be live before the Job is switched on
        # (`traefik_k8s_bouncer_key_precheck`): a refused precheck holds `traefik`.
        - podSelector:
            matchLabels:
              app: traefik-precheck
      ports:
        - port: 8080
          protocol: TCP
    # Cross-namespace: namespaceSelector and podSelector are siblings in ONE item, so they AND.
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: observability
          podSelector:
            matchLabels:
              app: prometheus
      ports:
        - port: {{ services | metrics_port('crowdsec') }}
          protocol: TCP
        # The sidecar shares the pod's network identity, so its port needs its own entry.
        - port: {{ services | metrics_port('crowdsec-jobs') }}
          protocol: TCP
{% else %}
    # OFF. One empty rule admits everything. `ingress: []` would be the exact opposite and deny
    # everything, which is the easiest thing in this file to get backwards.
    - {}
{% endif %}
