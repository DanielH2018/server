{# DECIDED: nut admits daniel-server's host-side shutdown chain through node-CIDR and flannel.1
   ipBlocks, so this fence stays bespoke.
   The callers model (`netpol_from` / `netpol_fences`, macro in
   k8s/templates/networkpolicy.yml.j2) renders one TCP port admitting same-namespace `app:`
   peers, and its header rules out growing it to absorb another shape.
#}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: nut
  namespace: {{ k8s_namespace }}
spec:
  podSelector:
    matchLabels:
      app: nut
  policyTypes:
    - Ingress
  ingress:
{% if netpol_baseline_enforced | bool %}
    # No ipBlock substitutes for the pod callers (pod -> ClusterIP -> pod preserves the pod IP); the
    # node entries cover host processes.
    # The cni0 entries duplicate the baseline only once nut carries `netpol-baseline: enforced`;
    # keep them until then.
    # The flannel.1 entries are load-bearing: a cross-node host packet arrives as the SENDING node's
    # flannel.1 address.
    - from:
        - podSelector:
            matchLabels:
              app: peanut
        - podSelector:
            matchLabels:
              app: home-assistant
        - podSelector:
            matchLabels:
              app: blackbox-exporter
        - podSelector:
            matchLabels:
              app: nut-exporter
{% for cidr in netpol_baseline_node_cidrs %}
        - ipBlock:
            cidr: {{ cidr }}
{% endfor %}
{% for cidr in k3s_flannel_node_ips %}
        - ipBlock:
            cidr: {{ cidr }}
{% endfor %}
      ports:
        - port: 3493
          protocol: TCP
{% else %}
    # OFF. One empty rule admits everything. `ingress: []` would be the exact opposite and deny
    # everything, which is the easiest thing in this file to get backwards.
    - {}
{% endif %}
