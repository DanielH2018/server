{# DECIDED: loki-homelab admits grafana from the observability namespace, so this fence
   stays bespoke.
   The callers model (`netpol_from` / `netpol_fences`, macro in
   k8s/templates/networkpolicy.yml.j2) renders one TCP port admitting same-namespace `app:`
   peers, and its header rules out growing it to absorb another shape.
   One rule here would fit that model on its own, but splitting it out leaves this file
   behind anyway, doubles the policy objects on one pod and renames a live object under the
   armed prune, so the whole fence keeps one owner.
#}
---
# Not the observability `loki` (networkpolicy-loki.yaml.j2); both listen on 3100.
# Callers beyond the baseline: airflow-task, alloy (both nodes), homelab-mcp, monitor-bridge,
# terraria-stats, valheim-stats, and grafana from the observability namespace.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: loki-homelab
  namespace: {{ k8s_namespace }}
spec:
  podSelector:
    matchLabels:
      app: loki-homelab
  policyTypes:
    - Ingress
  ingress:
{# Allow-all when the flag is false, the rollback lever. `| bool`: a string 'false' is truthy to
   Jinja. #}
{% if netpol_baseline_enforced | bool %}
    - from:
        - podSelector:
            matchLabels:
              app: airflow-task
        - podSelector:
            matchLabels:
              app: alloy
        - podSelector:
            matchLabels:
              app: homelab-mcp
        - podSelector:
            matchLabels:
              app: monitor-bridge
        - podSelector:
            matchLabels:
              app: terraria-stats
        - podSelector:
            matchLabels:
              app: valheim-stats
        # namespaceSelector and podSelector are siblings in ONE item, so they AND; as two items they
        # would OR.
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ k8s_observability_namespace }}
          podSelector:
            matchLabels:
              app: grafana
      ports:
        - port: 3100
          protocol: TCP
{% else %}
    # OFF. One empty rule admits everything. `ingress: []` would be the exact opposite and deny
    # everything, which is the easiest thing in this file to get backwards.
    - {}
{% endif %}
