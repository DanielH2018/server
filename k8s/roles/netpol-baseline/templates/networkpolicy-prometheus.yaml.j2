{# DECIDED: prometheus-callers sits in the observability namespace and admits callers from
   the homelab namespace and from flux-system, so it stays bespoke.
   The callers model (`netpol_from` / `netpol_fences`, macro in
   k8s/templates/networkpolicy.yml.j2) renders one TCP port admitting same-namespace `app:`
   peers, and its header rules out growing it to absorb another shape.
#}
---
# Six callers: monitor-bridge, homepage, homelab-mcp, crowdsec-verify and airflow-task (homelab
# namespace), and the soak Job in flux-system (stable label `app: soak`).
# Headlamp's Prometheus plugin is not admitted by pod: it arrives via the API server proxy on the
# node-CIDR peer.
# INGRESS ONLY: an Egress policy blocks nothing on this cluster.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: prometheus-callers
  namespace: {{ k8s_observability_namespace }}
spec:
  podSelector:
    matchLabels:
      app: prometheus
  policyTypes:
    - Ingress
  ingress:
{# Allow-all when the flag is false, the rollback lever. `| bool`: a string 'false' is truthy to
   Jinja. #}
{% if netpol_baseline_obs_enforced | bool %}
    - from:
        # namespaceSelector and podSelector are siblings in ONE item, so they AND; as two items they
        # would OR.
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ k8s_namespace }}
          podSelector:
            matchExpressions:
              - key: app
                operator: In
                values: [monitor-bridge, homelab-mcp, homepage, crowdsec-verify, airflow-task]
        # The soak Job is ONE item (`app: soak` in flux-system); the label is on the POD template,
        # not the Job.
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: flux-system
          podSelector:
            matchLabels:
              app: soak
      # Port 9090 is as fine as L3/L4 gets: safe only because Prometheus runs without the admin,
      # lifecycle and remote-write flags; adding one turns this into a write grant for every caller.
      ports:
        - protocol: TCP
          port: 9090
{% else %}
    # OFF. One empty rule admits everything. `ingress: []` would be the exact opposite and deny
    # everything, which is the easiest thing in this file to get backwards.
    - {}
{% endif %}
