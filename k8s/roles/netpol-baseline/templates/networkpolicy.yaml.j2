---
# The namespace ingress baseline. Kubernetes admits every pod-to-pod connection by default and a
# NetworkPolicy constrains only the pods it SELECTS, so this is the object that makes every other
# policy in the repo mean something.
#
# INGRESS ONLY. It fences no outbound call. An egress rule here would be enforced, so every pod
# it selects would lose DNS unless the rule admits CoreDNS.
#
# Kubelet probe traffic needs no rule here: flaresolverr admits :8191 only from prowlarr yet is
# probed on that port and runs 1/1, and headlamp corroborates it.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: baseline-ingress
  namespace: {{ k8s_namespace }}
spec:
  podSelector:
{% if netpol_baseline_scope == 'namespace' %}
    # Every pod EXCEPT the ones that opt out. A bare `{}` here would select the workloads carrying a
    # policy tighter than this one and, because policies are additive, ADD this allow-list on top
    # of theirs, widening exactly the fences those policies exist to draw.
    # `netpol_baseline_exempt_workloads` names them, and the exempt-set check in
    # templates/verify/job.yaml.j2 fails if the cluster's exempt set differs.
    #
    # DoesNotExist, not `NotIn: ["true"]`: a pod with no such key satisfies DoesNotExist with no
    # ambiguity, where NotIn against an absent key is the kind of semantics that reads two ways.
    matchExpressions:
      - key: netpol-baseline-exempt
        operator: DoesNotExist
{% else %}
    matchLabels:
      netpol-baseline: enforced
{% endif %}
  policyTypes:
    - Ingress
  ingress:
{# `| bool`, matching `netpol_baseline_probe_active` in defaults/main.yml. Without it the two
   disagree for a STRING: `'false'` is truthy to Jinja (this branch renders, fencing applied) and
   False to that list (the verify Job dials no leg), so enforcement runs with no probe. #}
{% if netpol_baseline_enforced | bool %}
    # Three callers legitimately reach almost every pod; stating them once here replaces
    # restating them in every per-workload policy.
    - from:
        # Traefik is the front door for every web UI. Bare podSelector = this namespace only.
        - podSelector:
            matchLabels:
              app: traefik
        # Prometheus scrapes every workload. namespaceSelector and podSelector are SIBLING KEYS
        # in ONE list item, so they AND together: the prometheus pod in observability. As two
        # separate list items they would OR, admitting the entire observability namespace.
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: observability
          podSelector:
            matchLabels:
              app: prometheus
{% for cidr in netpol_baseline_node_cidrs %}
        - ipBlock:
            cidr: {{ cidr }}
{% endfor %}
{% else %}
    # OFF. One empty rule admits everything. `ingress: []` would be the exact opposite and deny
    # everything, which is the easiest thing in this file to get backwards.
    - {}
{% endif %}
