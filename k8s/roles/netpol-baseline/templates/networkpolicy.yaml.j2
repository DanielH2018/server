---
# Kubernetes admits every connection by default; this baseline makes the other policies mean
# something.
# INGRESS ONLY: an egress rule would be enforced and cut DNS unless it admits CoreDNS.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: baseline-ingress
  namespace: {{ k8s_namespace }}
spec:
  podSelector:
{% if netpol_baseline_scope == 'namespace' %}
    # Selects every pod EXCEPT the opt-outs: a bare `{}` would ADD this allow-list to tighter
    # policies.
    # DoesNotExist, not `NotIn: ["true"]`, which reads two ways for an absent key.
    matchExpressions:
      - key: netpol-baseline-exempt
        operator: DoesNotExist
{% else %}
    matchLabels:
      netpol-baseline: enforced
{% endif %}
  policyTypes:
    - Ingress
  ingress:
{# Allow-all when the flag is false, the rollback lever. `| bool`: a string 'false' is truthy to
   Jinja. #}
{% if netpol_baseline_enforced | bool %}
    - from:
        # Traefik is the front door for every web UI. Bare podSelector = this namespace only.
        - podSelector:
            matchLabels:
              app: traefik
        # namespaceSelector and podSelector are siblings in ONE item, so they AND; as two items they
        # would OR.
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: observability
          podSelector:
            matchLabels:
              app: prometheus
{% for cidr in netpol_baseline_node_cidrs %}
        - ipBlock:
            cidr: {{ cidr }}
{% endfor %}
{% else %}
    # OFF. One empty rule admits everything. `ingress: []` would be the exact opposite and deny
    # everything, which is the easiest thing in this file to get backwards.
    - {}
{% endif %}
