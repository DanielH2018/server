{# DECIDED: mosquitto admits the host-side kubelet probes through netpol_baseline_node_cidrs
   ipBlocks, so this fence stays bespoke.
   The callers model (`netpol_from` / `netpol_fences`, macro in
   k8s/templates/networkpolicy.yml.j2) renders one TCP port admitting same-namespace `app:`
   peers, and its header rules out growing it to absorb another shape.
#}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: mosquitto
  namespace: {{ k8s_namespace }}
spec:
  podSelector:
    matchLabels:
      app: mosquitto
  policyTypes:
    - Ingress
  ingress:
{# Allow-all when the flag is false, the rollback lever. `| bool`: a string 'false' is truthy to
   Jinja. #}
{% if netpol_baseline_enforced | bool %}
    # DO NOT DELETE the zigbee2mqtt and home-assistant podSelectors: they alone admit the MQTT
    # clients, and no ipBlock substitutes (pod -> ClusterIP -> pod preserves the pod IP).
    # The cni0 ipBlocks admit kubelet probes and duplicate the baseline only once the pod carries
    # `netpol-baseline: enforced`; keep them until that label lands.
    - from:
        - podSelector:
            matchLabels:
              app: zigbee2mqtt
        - podSelector:
            matchLabels:
              app: home-assistant
{% for cidr in netpol_baseline_node_cidrs %}
        - ipBlock:
            cidr: {{ cidr }}
{% endfor %}
      ports:
        - port: 1883
          protocol: TCP
    # blackbox-exporter's tcp_connect to the mosquitto-lan VIP arrives as its real pod IP
    # (ETP=Local).
    - from:
        - podSelector:
            matchLabels:
              app: blackbox-exporter
      ports:
        - port: 1883
          protocol: TCP
{% else %}
    # OFF. One empty rule admits everything. `ingress: []` would be the exact opposite and deny
    # everything, which is the easiest thing in this file to get backwards.
    - {}
{% endif %}
