{# DECIDED: mosquitto admits the host-side kubelet probes through netpol_baseline_node_cidrs
   ipBlocks, so this fence stays bespoke.
   The callers model (`netpol_from` / `netpol_fences`, macro in
   k8s/templates/networkpolicy.yml.j2) renders one TCP port admitting same-namespace `app:`
   peers, and its header rules out growing it to absorb another shape.
#}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: mosquitto
  namespace: {{ k8s_namespace }}
spec:
  podSelector:
    matchLabels:
      app: mosquitto
  policyTypes:
    - Ingress
  ingress:
{# Renders allow-all when the flag is false, so `netpol_baseline_enforced` is a real rollback
   lever. `| bool` for the string trap. Both explained in full in
   networkpolicy-traefik.yaml.j2. BOTH rules below sit inside this conditional. #}
{% if netpol_baseline_enforced | bool %}
    # zigbee2mqtt and home-assistant. DO NOT DELETE THESE TWO podSelectors -- they are the only
    # thing admitting the MQTT clients, and a log observation will not show you that. A
    # long-lived MQTT client logs one "New connection" when it first connects and nothing
    # afterwards, so its absence from the log does not mean it never connects. The connections
    # in the log from 10.42.0.1 are kubelet probes (a connect, then "connection closed by
    # client", at the readiness and liveness periods in mosquitto/templates/deployment.yaml.j2),
    # not MQTT clients.
    #
    # No ipBlock substitutes for these podSelectors: pod -> ClusterIP -> pod traffic PRESERVES
    # the caller's pod IP, same-node and cross-node alike. It is NOT masqueraded to the cni0
    # bridge address. Deleting them breaks MQTT at the next reconnect -- delayed, and hard to
    # trace back to this file.
    #
    # The two cni0 ipBlocks are what admits the kubelet probes. They duplicate
    # netpol_baseline_node_cidrs ONLY ONCE mosquitto carries `netpol-baseline: enforced` and the
    # always-on baseline selects it. During the deploy step that applies this policy the label
    # is not on the pod yet, so in that window they are the only admission a host-side caller
    # has. Do not delete them as "redundant with the baseline" without confirming the label has
    # landed.
    - from:
        - podSelector:
            matchLabels:
              app: zigbee2mqtt
        - podSelector:
            matchLabels:
              app: home-assistant
{% for cidr in netpol_baseline_node_cidrs %}
        - ipBlock:
            cidr: {{ cidr }}
{% endfor %}
      ports:
        - port: 1883
          protocol: TCP
    # blackbox-exporter's `tcp_connect` probe connects to the mosquitto-lan VIP
    # (10.0.0.242:1883). It is a pod on either node, and a cross-node hop arrives as its own
    # real pod IP -- not SNAT'd, because ETP=Local on mosquitto-lan preserves the client
    # address for a cross-node LoadBalancer hop.
    - from:
        - podSelector:
            matchLabels:
              app: blackbox-exporter
      ports:
        - port: 1883
          protocol: TCP
{% else %}
    # OFF. One empty rule admits everything. `ingress: []` would be the exact opposite and deny
    # everything, which is the easiest thing in this file to get backwards.
    - {}
{% endif %}
