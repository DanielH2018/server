{# DECIDED: traefik's fence is an ipBlock origin lock on :8443, a from-less :8000 and a
   cross-namespace prometheus grant on :8080, so it stays bespoke.
   The callers model (`netpol_from` / `netpol_fences`, macro in
   k8s/templates/networkpolicy.yml.j2) renders one TCP port admitting same-namespace `app:`
   peers, and its header rules out growing it to absorb another shape.
#}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: traefik
  namespace: {{ k8s_namespace }}
spec:
  podSelector:
    matchLabels:
      app: traefik
  policyTypes:
    - Ingress
  ingress:
{# ROLLBACK LEVER: each bespoke policy renders allow-all when `netpol_baseline_enforced` is false,
   since apply does not prune and `kubectl delete` is denied.
   `| bool`: a string 'false' is truthy to Jinja but False to netpol_baseline_probe_active
   (enforcement, no probe). #}
{% if netpol_baseline_enforced | bool %}
    # THE PORTS ARE POD PORTS (8000, 8443), not Service ports: a NetworkPolicy matches after DNAT,
    # so 80/443 would deny every in-cluster caller.
    # :8000 stays open: it is the http->https redirect entrypoint, and the probe's control legs dial
    # it.
    - ports:
        - port: 8000
          protocol: TCP
    # Origin lock: :8443 admits only netpol_baseline_traefik_https_sources, so an origin-direct
    # client cannot skip Cloudflare's WAF and share one rate-limit bucket. Authenticated Origin
    # Pulls sits on top.
    # The pod CIDR is the WHOLE /16 on purpose: every pod here is a legitimate caller, and host
    # callers need no /32.
    # IPv4 only: an IPv6 ipBlock fences nothing in a single-stack cluster; dual-stack needs the
    # defaults filter removed.
    - from:
{% for cidr in netpol_baseline_traefik_https_sources %}
        - ipBlock:
            cidr: {{ cidr }}
{% endfor %}
      ports:
        - port: 8443
          protocol: TCP
    # :8080: prometheus is cross-namespace; its two selector keys are siblings in ONE item, so they
    # AND.
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: observability
          podSelector:
            matchLabels:
              app: prometheus
      ports:
        - port: 8080
          protocol: TCP
{% else %}
    # OFF: one empty rule admits everything; `ingress: []` would deny everything.
    - {}
{% endif %}
