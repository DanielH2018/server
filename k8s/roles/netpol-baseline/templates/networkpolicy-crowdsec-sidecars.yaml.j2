{# DECIDED: the CrowdSec agent sidecars' :6060 grant admits prometheus from the observability
   namespace, so it stays off the callers model.
   The callers model (`netpol_from` / `netpol_fences`, macro in
   k8s/templates/networkpolicy.yml.j2) renders one TCP port admitting same-namespace `app:`
   peers, and its header rules out growing it to absorb another shape.
#}
{# One additive policy per `crowdsec_k8s_sidecar_agents` entry; the sidecar carries its host pod's
   labels.
   Only prometheus may reach :6060: agent metrics enumerate every parser and scenario.
   Safe only for a pod another ingress policy already selects; otherwise this would isolate it to
   :6060. #}
{% for app in crowdsec_k8s_sidecar_agents %}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ app }}-crowdsec-agent-metrics
  namespace: {{ k8s_namespace }}
spec:
  podSelector:
    matchLabels:
      app: {{ app }}
  policyTypes:
    - Ingress
  ingress:
{% if netpol_baseline_enforced | bool %}
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: observability
          podSelector:
            matchLabels:
              app: prometheus
      ports:
        - port: 6060
          protocol: TCP
{% else %}
    # OFF. One empty rule admits everything. `ingress: []` would be the exact opposite and deny
    # everything, which is the easiest thing in this file to get backwards.
    - {}
{% endif %}
{% endfor %}
