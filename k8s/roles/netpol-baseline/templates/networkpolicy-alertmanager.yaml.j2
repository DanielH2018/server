{# DECIDED: alertmanager-callers sits in the observability namespace and admits loki-homelab
   and karma from the homelab namespace, so it stays bespoke.
   The callers model (`netpol_from` / `netpol_fences`, macro in
   k8s/templates/networkpolicy.yml.j2) renders one TCP port admitting same-namespace `app:`
   peers, and its header rules out growing it to absorb another shape.
#}
---
# INGRESS ONLY: an Egress policy selects pods but blocks nothing on this cluster.
# `app: loki-homelab` admits the ruler and nothing else (one container, no sidecar); other callers
# come from the observability baseline.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: alertmanager-callers
  namespace: {{ k8s_observability_namespace }}
spec:
  podSelector:
    matchLabels:
      app: alertmanager
  policyTypes:
    - Ingress
  ingress:
{% if netpol_baseline_obs_enforced | bool %}
    - from:
        # namespaceSelector and podSelector are siblings in ONE item, so they AND; as two items they
        # would OR.
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ k8s_namespace }}
          podSelector:
            matchExpressions:
              - key: app
                operator: In
                values: [loki-homelab, karma]
      ports:
        - protocol: TCP
          port: 9093
{% else %}
    # OFF. One empty rule admits everything. `ingress: []` would be the exact opposite and deny
    # everything, which is the easiest thing in this file to get backwards.
    - {}
{% endif %}
