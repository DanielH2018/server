{# DECIDED: the observability baseline selects a whole other namespace and admits traefik
   across namespaces plus node ipBlocks, so it stays bespoke.
   The callers model (`netpol_from` / `netpol_fences`, macro in
   k8s/templates/networkpolicy.yml.j2) renders one TCP port admitting same-namespace `app:`
   peers, and its header rules out growing it to absorb another shape.
#}
---
# A NetworkPolicy selects pods only in its own namespace, so observability needs its own baseline.
# INGRESS ONLY: an Egress policy blocks nothing on this cluster.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: netpol-baseline-observability
  namespace: {{ k8s_observability_namespace }}
spec:
  podSelector:
{% if netpol_baseline_obs_scope == 'namespace' %}
    # Same opt-out selector as the homelab baseline, on this namespace's own scope variable.
    # Nothing here is exempt: every pod carries the opt-in label already, and the rule below
    # admits `podSelector: {}` — the whole namespace — so being selected changes nothing for a
    # pod that exists. What it changes is a pod added LATER, which is unfenced by default under
    # label scope and fenced by default under this one.
    matchExpressions:
      - key: netpol-baseline-exempt
        operator: DoesNotExist
{% else %}
    matchLabels:
      netpol-baseline: enforced
{% endif %}
  policyTypes:
    - Ingress
  ingress:
{# Allow-all when the flag is false, the rollback lever. `| bool`: a string 'false' is truthy to
   Jinja. #}
{% if netpol_baseline_obs_enforced | bool %}
    - from:
        # Traefik lives in the homelab namespace, so it needs a namespaceSelector; the two keys AND
        # in ONE item.
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ k8s_namespace }}
          podSelector:
            matchLabels:
              app: traefik
        # Intra-namespace: grafana -> prometheus/loki/tempo, prometheus -> kube-state-metrics /
        # the otel collector. This bare selector leans on the namespace being SOLE-TENANT:
        # observability is the only role that renders into it (guarded by
        # tests/k8s/rendered_properties/test_rendered_properties.py). A second role landing in the namespace would
        # get free ingress to every already-fenced pod here with no policy change of its own.
        # Enumerating each workload's pairwise edges would add review surface without adding a
        # boundary; the boundary that matters is the namespace edge. A bare podSelector means
        # observability only.
        - podSelector: {}
{% for cidr in netpol_baseline_obs_node_cidrs %}
        - ipBlock:
            cidr: {{ cidr }}
{% endfor %}
{% else %}
    # OFF. One empty rule admits everything. `ingress: []` would be the exact opposite and deny
    # everything, which is the easiest thing in this file to get backwards.
    - {}
{% endif %}
