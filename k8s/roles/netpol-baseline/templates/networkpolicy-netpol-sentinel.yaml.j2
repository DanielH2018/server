{# DECIDED: the sentinel admits pods by the `netpol-probe: control` label, not by an
   `app:` label, and its name differs from the app it selects, so it stays bespoke.
   The callers model (`netpol_from` / `netpol_fences`, macro in
   k8s/templates/networkpolicy.yml.j2) renders one TCP port admitting same-namespace `app:`
   peers, and its header rules out growing it to absorb another shape.
#}
---
# Positive control: a FENCED pod that admits the probe proves the admit path works, which an
# unfenced pod cannot.
# speedtest, not littlelink (the verify Job's DENIED target). A new probe's pod gets
# `netpol-probe: control` and dials `speedtest:80`.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: netpol-sentinel
  namespace: {{ k8s_namespace }}
spec:
  podSelector:
    matchLabels:
      app: speedtest
  policyTypes:
    - Ingress
  ingress:
{# Allow-all when the flag is false, the rollback lever. `| bool`: a string 'false' is truthy to
   Jinja. #}
{% if netpol_baseline_enforced | bool %}
    # Adds the probe pods only; speedtest's real callers come from the baseline.
    - from:
        - podSelector:
            matchLabels:
              netpol-probe: control
      ports:
        - port: 80
          protocol: TCP
{% else %}
    # OFF. One empty rule admits everything. `ingress: []` would be the exact opposite and deny
    # everything, which is the easiest thing in this file to get backwards.
    - {}
{% endif %}
