# DIGEST-PINNED. Renovate cannot bump a tag with no version in it, so the explicit -lsNN tag is
# what the built-in dockerfile manager tracks (the linuxserver packageRule in renovate.json
# orders that form). The digest beside it makes the build reproducible from a commit, because
# linuxserver rebuilds a tag in place. Renovate bumps both together. See Dockerfile.j2 in
# k8s/roles/n8n for the full reasoning behind pinning a built image's base.
FROM lscr.io/linuxserver/code-server:4.145.2-ls377@sha256:20ffca4512fcfc85dcd5612fb769233c1553192392d2ec417f0859135805f40c

# 1. Install system dependencies
#    No TeX Live here: LaTeX compiles in the browser through the texbrain workload (a
#    WebAssembly pdfTeX, k8s/roles/texbrain). This image cannot compile a document, and there
#    is no local fallback. texbrain needs the pod, a browser, and a jsDelivr mirror for any
#    package outside its bundled TeX Live subset.
#
#    gcc and libc6-dev are the C toolchain step 3's rustc links through: without them the first
#    `cargo build` fails with "linker `cc` not found". pkg-config and libssl-dev let the common
#    *-sys crates (openssl-sys above all) find their system library.
#
#    These apt packages are the one build input still resolved at build time. A
#    `pkg=version` pin breaks the build the day noble-updates supersedes the version — the
#    archive pool keeps only the current one — and a snapshot.ubuntu.com timestamp has no
#    Renovate datasource, so it would freeze the security updates for git/curl/python3 with
#    nothing raising a PR. DECIDED: build-time apt resolution stays, on those grounds.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    python3 \
    python3-venv \
    curl \
    xz-utils \
    gcc \
    libc6-dev \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/python3 /usr/bin/python

# 2. Node.js from the official tarball, checksum-verified, into /usr/local (node + npm + npx).
#    NodeSource's `setup_22.x` script piped to bash would resolve whatever NodeSource serves on
#    build day and run as root straight off the network.
#    Version and sha256 live in defaults/main.yml (code_server_k8s_node_*), where Renovate
#    tracks the version; `sha256sum -c` is what turns a stale hash into a failed build rather
#    than a silently different node.
RUN curl -fsSL -o /tmp/node.tar.xz \
        "{{ code_server_k8s_node_url }}" \
    && echo "{{ code_server_k8s_node_sha256 }}  /tmp/node.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --no-same-owner \
        --exclude='*/CHANGELOG.md' --exclude='*/LICENSE' --exclude='*/README.md' \
    && rm /tmp/node.tar.xz \
    && node --version && npm --version

# 3. Rust from the official standalone installers, checksum-verified, into /usr/local. The
#    toolchain tarball supplies rustc, cargo, clippy and rustfmt; rust-src supplies the std
#    source that rust-analyzer needs to resolve `std`. The shape is Node's above, for the same
#    reason: rustup's install script piped to sh resolves whatever rustup serves on build day.
#    Version and both sha256s live in defaults/main.yml (code_server_k8s_rust_*). Renovate
#    tracks the version, and `asset_pins.py --refresh rust-lang/rust` rewrites both digests.
#
#    There is no rustup, so a project's `rust-toolchain.toml` and `rustup target add` do nothing
#    here. The image carries one stable toolchain for the host target. DECIDED: standalone
#    tarball over a pinned rustup-init, because it leaves no
#    runtime-writable toolchain state and pins exactly like Node.
#
#    CARGO_HOME holds the registry cache and `cargo install` binaries, so the abc user must be
#    able to write it. CARGO_TARGET_DIR moves every project's build output off
#    /config/workspace, the backed-up claim, because one project's target/ reaches several GiB.
#    Both paths sit on the config volume, which holds derived state and is not backed up.
#    `test_cargo_writes_stay_off_the_backed_up_claim` holds both off the backed-up mounts.
RUN curl -fsSL -o /tmp/rust.tar.xz "{{ code_server_k8s_rust_url }}" \
    && echo "{{ code_server_k8s_rust_sha256 }}  /tmp/rust.tar.xz" | sha256sum -c - \
    && curl -fsSL -o /tmp/rust-src.tar.xz "{{ code_server_k8s_rust_src_url }}" \
    && echo "{{ code_server_k8s_rust_src_sha256 }}  /tmp/rust-src.tar.xz" | sha256sum -c - \
    && mkdir /tmp/rust /tmp/rust-src \
    && tar -xJf /tmp/rust.tar.xz -C /tmp/rust --strip-components=1 --no-same-owner \
    && tar -xJf /tmp/rust-src.tar.xz -C /tmp/rust-src --strip-components=1 --no-same-owner \
    && /tmp/rust/install.sh --prefix=/usr/local --disable-ldconfig \
        --components=rustc,cargo,rust-std-x86_64-unknown-linux-gnu,clippy-preview,rustfmt-preview \
    && /tmp/rust-src/install.sh --prefix=/usr/local --disable-ldconfig \
    && rm -rf /tmp/rust /tmp/rust-src /tmp/rust.tar.xz /tmp/rust-src.tar.xz \
    && rustc --version && cargo --version && cargo clippy --version && rustfmt --version
ENV CARGO_HOME=/config/.cargo
ENV CARGO_TARGET_DIR=/config/.cargo-target
ENV PATH="/config/.cargo/bin:$PATH"

# 4. Python virtual environment outside /config so it survives volume mounts, with its
#    packages and its ownership settled in the SAME layer. `chown -R` rewrites every file,
#    and a rewritten file is a new file to the layer format — so doing it in a later step
#    would store a second full copy of the venv (89 M compressed) on top of the one already
#    written here. The chown must stay last: pip writes into the venv after it exists.
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
#    python3-pip is deliberately NOT installed. `python3 -m venv` builds the venv's own pip
#    from python3-venv's bundled wheel, and the system package would only supply a second
#    /usr/bin/pip that installs into the system interpreter and fails silently. The
#    absolute-path call below makes the target unambiguous rather than PATH-dependent.
#
#    Every package is `==`-pinned: a bare name re-resolved to newest PyPI on every
#    rebuild. Renovate tracks each pin on PyPI (regex manager in renovate.json); transitive
#    dependencies still resolve at build time, which a hashed requirements file would close.
RUN python3 -m venv $VIRTUAL_ENV \
    && $VIRTUAL_ENV/bin/pip install --no-cache-dir \
        uv==0.13.8 \
        pandas==3.1.1 \
        requests==2.34.2 \
        ruff==0.17.5 \
        ty==0.0.104 \
        structlog==26.1.0 \
        python-dotenv==1.2.4 \
    && chown -R {{ puid }}:{{ pgid }} $VIRTUAL_ENV

# 5. Claude Code CLI, pinned to the same release as the Anthropic.claude-code extension in
#    defaults/main.yml — the extension drives this binary, so the two move together. Renovate
#    tracks the pin on npm (regex manager in renovate.json). npm's download cache is ~96 M that
#    the running container never reads, so it is dropped in the same layer that creates it — a
#    later `rm` would not shrink this one.
RUN npm install -g @anthropic-ai/claude-code@2.1.325 \
    && npm cache clean --force

# 6. VS Code extensions, downloaded at build time from the exact URL each entry in
#    code_server_k8s_extensions (defaults/main.yml) names, and kept only when the sha256
#    matches. Asking an API for the CURRENT version takes the first build listed, which for a
#    platform-specific extension is alpine-arm64 (ruff, ty) or win32-x64 (Claude Code). The
#    defaults comment has the details and the bump recipe.
#    The marketplace serves a vspackage gzip-encoded, `--compressed` decodes it, and the
#    recorded hash is over the decoded VSIX. Open VSX serves the file as-is, so `-A` and
#    `--compressed` are inert there.
RUN mkdir -p /opt/vsix
{% for ext in code_server_k8s_extensions %}
# {{ ext.name }} {{ ext.version }}
RUN curl -fsSL --compressed -A "VSCode/1.95.0" -o "/opt/vsix/{{ ext.name }}@{{ ext.version }}.vsix" "{{ ext.url }}" \
    && echo "{{ ext.sha256 }}  /opt/vsix/{{ ext.name }}@{{ ext.version }}.vsix" | sha256sum -c -
{% endfor %}

# 7. Startup script installs each /opt/vsix extension the config volume does not hold. A file
#    is named <id>@<version>, the form `--list-extensions --show-versions` prints, so each
#    entry's version must equal its VSIX manifest's or the script reinstalls it every start.
COPY extensions.sh /custom-cont-init.d/10-extensions.sh
RUN chmod +x /custom-cont-init.d/10-extensions.sh
