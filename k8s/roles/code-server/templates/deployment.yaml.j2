{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_required with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
{% from 'lsio-env.yml.j2' import lsio_env with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: code-server
  namespace: {{ k8s_namespace }}
spec:
  # RWO config PVC on single-replica Longhorn — a rolling update deadlocks on the volume.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: code-server
  template:
    metadata:
      labels:
        app: code-server
        netpol-baseline: enforced
    spec:
      # No fsGroup: the LSIO image chowns /config itself on startup.
{{ pod_shell('homelab-best-effort') }}
      # Pinned to daniel-box; the pre-pull Job copies this placement, so the image is pulled onto
      # the node the pod runs on.
{{ node_affinity_required(k8s_primary_node) }}
      # First boot only: runs before the subPath mounts shadow /config/workspace, .ssh and .config.
      # Nothing is deleted; a marker file makes every later start a no-op.
      initContainers:
        - name: seed-workspace-claim
          image: {{ code_server_k8s_image }}
          imagePullPolicy: Always
          command:
            - /bin/sh
            - -c
            - |
              set -eu
              if [ -e /keep/.migrated ]; then
                echo "workspace claim already migrated"
                exit 0
              fi
              mkdir -p /keep/workspace /keep/ssh /keep/config
              cp -a /config/workspace/. /keep/workspace/ || true
              cp -a /config/.ssh/. /keep/ssh/ || true
              cp -a /config/.config/. /keep/config/ || true
              # The git identity rides inside .config at git's XDG path: a subPath mount on
              # ~/.gitconfig breaks `git config --global`, whose rename() onto a bind-mounted file
              # fails EBUSY.
              if [ -f /config/.gitconfig ] && [ ! -f /keep/config/git/config ]; then
                mkdir -p /keep/config/git
                cp -a /config/.gitconfig /keep/config/git/config
              fi
              # ~/.gitconfig outranks the XDG path, so it must stop existing; renamed, not removed.
              if [ -f /config/.gitconfig ]; then
                mv /config/.gitconfig /config/.gitconfig.pre-split
              fi
              chown -R {{ puid }}:{{ pgid }} /keep
              touch /keep/.migrated
              chown {{ puid }}:{{ pgid }} /keep/.migrated
              echo "migrated workspace, .ssh, .config and the git identity"
          securityContext:
            runAsUser: 0
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
              # A fresh claim's root is root:root and the files are the pod uid's: DAC_OVERRIDE to
              # read, CHOWN to hand back.
              # Root WITHOUT DAC_OVERRIDE is weaker than the pod uid.
              add:
                - CHOWN
                - DAC_OVERRIDE
                - FOWNER
          volumeMounts:
            - name: code-server-config
              mountPath: /config
            - name: code-server-workspace
              mountPath: /keep
{{ container_resources(cpu_limit='1', mem_limit='128Mi', cpu_request='10m', mem_request='32Mi') }}
      containers:
        - name: code-server
          image: {{ code_server_k8s_image }}
          imagePullPolicy: Always  # as on the init container above
          ports:
            - containerPort: {{ container_item.port }}
          # s6/DOCKER_MODS init chmods files it doesn't own; without FOWNER that EPERMs and .ssh
          # stays world-readable 0755.
{{ hardened_security_context(add=['CHOWN', 'SETUID', 'SETGID', 'FOWNER', 'DAC_OVERRIDE']) }}
          env:
{{ lsio_env() }}
            - name: EXTENSIONS_GALLERY
              value: '{"serviceUrl": "https://open-vsx.org/vscode/gallery", "itemUrl": "https://open-vsx.org/vscode/item"}'
          envFrom:
            - secretRef:
                name: code-server-env
          volumeMounts:
            - name: code-server-config
              mountPath: /config
            # Each path must exist in the claim, which the initContainer guarantees.
            - name: code-server-workspace
              mountPath: /config/workspace
              subPath: workspace
            - name: code-server-workspace
              mountPath: /config/.ssh
              subPath: ssh
            - name: code-server-workspace
              mountPath: /config/.config
              subPath: config
          # First boot runs 10-extensions.sh before the listener comes up: allow up to 5 min before
          # liveness takes over.
          startupProbe:
            httpGet:
              path: /healthz/
              port: {{ container_item.port }}
            periodSeconds: 10
            failureThreshold: 30
          readinessProbe:
            httpGet:
              path: /healthz/
              port: {{ container_item.port }}
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /healthz/
              port: {{ container_item.port }}
            periodSeconds: 30
{{ container_resources(cpu_limit=code_server_k8s_cpu_limit, mem_limit=code_server_k8s_mem_limit, cpu_request=code_server_k8s_cpu_request, mem_request=code_server_k8s_mem_request) }}
      volumes:
        - name: code-server-config
          persistentVolumeClaim:
            claimName: {{ code_server_k8s_claim }}
        - name: code-server-workspace
          persistentVolumeClaim:
            claimName: {{ code_server_k8s_workspace_claim }}
