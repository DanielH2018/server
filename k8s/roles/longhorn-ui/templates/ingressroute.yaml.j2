{% from 'ingressroute.yml.j2' import ingressroute with context %}
---
{# The Service is `longhorn-frontend`: the macro's first argument names both the route and its
   Service.
   `public=false`: the UI deletes volumes and backups, and only the authelia middleware gates it. #}
{{ ingressroute(
    'longhorn-frontend',
    container_item.hostname,
    container_item.port,
    container_item.use_authelia,
    namespace=k8s_longhorn_namespace,
    public=false
  )
}}
