---
# Local copies because allowCrossNamespace is off; they can drift from the originals in traefik's
# and authelia's roles.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: rate-limit
  namespace: {{ k8s_longhorn_namespace }}
spec:
  rateLimit:
    average: 300
    burst: 150
    period: 1m
---
# Copy of authelia's forwardauth-middleware.yaml.j2; keep in lockstep,
# tests/k8s/test_forwardauth_rebuilds_request_target.py checks every copy.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: authelia-strip-forwarded-target
  namespace: {{ k8s_longhorn_namespace }}
spec:
  headers:
    customRequestHeaders:
      X-Forwarded-Host: ""
      X-Forwarded-Uri: ""
      X-Forwarded-Method: ""
---
# Never reference this directly from a route: only the `authelia` chain below may name it.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: authelia-forwardauth
  namespace: {{ k8s_longhorn_namespace }}
spec:
  forwardAuth:
    address: http://authelia.{{ k8s_namespace }}.svc.cluster.local:9091/api/authz/forward-auth
    trustForwardHeader: true
    authResponseHeaders:
      - Remote-User
      - Remote-Groups
      - Remote-Name
      - Remote-Email
    maxResponseBodySize: 1048576
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: authelia
  namespace: {{ k8s_longhorn_namespace }}
spec:
  chain:
    middlewares:
      - name: authelia-strip-forwarded-target
      - name: authelia-forwardauth
---
# A TLSOption resolves in the route's namespace; without `modern` here the router never builds and
# TLS resets.
apiVersion: traefik.io/v1alpha1
kind: TLSOption
metadata:
  name: modern
  namespace: {{ k8s_longhorn_namespace }}
spec:
  minVersion: VersionTLS12
  cipherSuites:
    - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
    - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
    - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
    - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
    - TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305
    - TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305
