---
apiVersion: v1
kind: Secret
metadata:
  name: speedtest
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  # Laravel's APP_KEY. It is what decrypts values already stored in database.sqlite, so the
  # k8s copy MUST carry the same key as the Docker twin — a fresh key would leave the seeded
  # database present but unreadable, which looks like data loss and is not.
  APP_KEY: "{{ speedtest_app_key }}"
