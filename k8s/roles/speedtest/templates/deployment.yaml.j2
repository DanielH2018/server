{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
{% from 'lsio-env.yml.j2' import lsio_env with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: speedtest
  namespace: {{ k8s_namespace }}
spec:
  # The PVC is ReadWriteOnce and Longhorn runs one replica, so a rolling update would deadlock:
  # the new pod waits for a volume the old pod still holds.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: speedtest
  template:
    metadata:
      labels:
        app: speedtest
        netpol-baseline: enforced
    spec:
      # No fsGroup on purpose. This LSIO image starts as root and chowns /config to PUID/PGID
      # itself. An fsGroup would recursively rewrite group ownership at mount time, fighting it.
{{ pod_shell('homelab-best-effort') }}
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: speedtest
          image: {{ speedtest_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{ container_item.port }}
          # The s6 privilege-drop set plus NET_BIND_SERVICE for :80.
{{ hardened_security_context(add=['CHOWN', 'SETUID', 'SETGID', 'FOWNER', 'DAC_OVERRIDE', 'NET_BIND_SERVICE']) }}
          env:
{{ lsio_env() }}
            # Laravel builds redirects and asset URLs from APP_URL, so it names the route's
            # only host: the entry sets public_route: false.
            - name: APP_URL
              value: "https://{{ container_item.hostname | default(container_item.name) }}.local.{{ domain }}"
            # Results are stored in UTC by design (APP_TIMEZONE stays default); this is
            # the UI-display timezone, which otherwise also defaults to Etc/UTC.
            - name: DISPLAY_TIMEZONE
              value: "{{ tz }}"
            - name: OOKLA_EULA_GDPR
              value: "true"
            # DECIDED: the schedule stays INTERNAL to the app rather than becoming a k8s
            # CronJob. A CronJob would make a tick visible outside the container, but the internal
            # scheduler is not the flaky part: ticks land on :00 at 05/11/17/23 UTC, and the only
            # miss coincided with a pod reschedule. A CronJob would move the transcript, not the
            # reliability, and it cannot write into the app's own results table without
            # reimplementing the Ookla run.
            # Revisit if a miss ever occurs without a pod restart beside it.
            - name: SPEEDTEST_SCHEDULE
              value: "0 */6 * * *"
            # Pinned to 41671 (x99.cloud, Chicago). Results under auto-select are BIMODAL, and the
            # mode is decided by which server the run draws: runs that landed on 41671 returned a
            # median 910 Mbps, runs on any of six other servers (SUMOFIBER, TNAHosting, Highline,
            # Tata, GigeNET, Sangoma) a median 12.8 Mbps, and the groups do not overlap. Upload
            # read 37-41 Mbps throughout, so only the download leg collapses.
            #
            # A pin is only as good as its last verification: a previously pinned server
            # (1775, Comcast, Baltimore) returned ~900 Mbps, then ~13 Mbps. Re-check 41671 against
            # auto-select periodically — the monitor-bridge `speedtest` check's 100 Mbps floor is
            # what makes a repeat visible rather than silent.
            #
            # NOT A DIAGNOSIS. Six independent providers all congesting to the same ~13 Mbps is
            # odd, and curl to two distant non-Ookla hosts showed the same shape. This pin fixes
            # the measurement, not whatever the measurement is pointing at.
            - name: SPEEDTEST_SERVERS
              value: "41671"
            - name: PRUNE_RESULTS_OLDER_THAN
              value: "30"
          envFrom:
            - secretRef:
                name: speedtest
          volumeMounts:
            - name: speedtest-config
              mountPath: /config
          readinessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
            initialDelaySeconds: 15
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
            initialDelaySeconds: 60
            periodSeconds: 30
{{ container_resources(cpu_limit=speedtest_k8s_cpu_limit, mem_limit=speedtest_k8s_mem_limit, cpu_request=speedtest_k8s_cpu_request, mem_request=speedtest_k8s_mem_request) }}
      volumes:
        - name: speedtest-config
          persistentVolumeClaim:
            claimName: {{ speedtest_k8s_claim }}
