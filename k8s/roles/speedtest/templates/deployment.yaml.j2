{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
{% from 'lsio-env.yml.j2' import lsio_env with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: speedtest
  namespace: {{ k8s_namespace }}
spec:
  # Recreate: the RWO PVC on single-replica Longhorn deadlocks a rolling update.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: speedtest
  template:
    metadata:
      labels:
        app: speedtest
        netpol-baseline: enforced
    spec:
      # No fsGroup: this LSIO image chowns /config itself, and fsGroup would fight it.
{{ pod_shell('homelab-best-effort') }}
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: speedtest
          image: {{ speedtest_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{ container_item.port }}
          # The s6 privilege-drop set plus NET_BIND_SERVICE for :80.
{{ hardened_security_context(add=['CHOWN', 'SETUID', 'SETGID', 'FOWNER', 'DAC_OVERRIDE', 'NET_BIND_SERVICE']) }}
          env:
{{ lsio_env() }}
            # APP_URL names the route's only host: Laravel builds redirects and asset URLs from it.
            - name: APP_URL
              value: "https://{{ container_item.hostname | default(container_item.name) }}.local.{{ domain }}"
            # Results are stored in UTC; this is the UI-display timezone only.
            - name: DISPLAY_TIMEZONE
              value: "{{ tz }}"
            - name: OOKLA_EULA_GDPR
              value: "true"
            # DECIDED: the schedule stays INTERNAL to the app rather than becoming a k8s
            # CronJob. A CronJob would make a tick visible outside the container, but the internal
            # scheduler is not the flaky part: ticks land on :00 at 05/11/17/23 UTC, and the only
            # miss coincided with a pod reschedule. A CronJob would move the transcript, not the
            # reliability, and it cannot write into the app's own results table without
            # reimplementing the Ookla run.
            # Revisit if a miss ever occurs without a pod restart beside it.
            - name: SPEEDTEST_SCHEDULE
              value: "0 */6 * * *"
            # Pinned: auto-select is bimodal by server drawn, ~910 Mbps on 41671 and ~12.8 Mbps
            # elsewhere.
            # Re-verify against auto-select: a past pin degraded; the monitor-bridge 100 Mbps floor
            # flags it.
            - name: SPEEDTEST_SERVERS
              value: "41671"
            - name: PRUNE_RESULTS_OLDER_THAN
              value: "30"
          envFrom:
            - secretRef:
                name: speedtest
          volumeMounts:
            - name: speedtest-config
              mountPath: /config
          readinessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
            initialDelaySeconds: 15
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
            initialDelaySeconds: 60
            periodSeconds: 30
{{ container_resources(cpu_limit=speedtest_k8s_cpu_limit, mem_limit=speedtest_k8s_mem_limit, cpu_request=speedtest_k8s_cpu_request, mem_request=speedtest_k8s_mem_request) }}
      volumes:
        - name: speedtest-config
          persistentVolumeClaim:
            claimName: {{ speedtest_k8s_claim }}
