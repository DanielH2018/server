---
# Declares only the three fields the repo governs, so Flux's apply never takes a manager-written
# field.
# Declarative both ways: armed false renders a BLANK URL, which Flux enforces; it is the incident
# lever for the B2 cap spiral.
apiVersion: longhorn.io/v1beta2
kind: BackupTarget
metadata:
  name: {{ 'b2_target' | longhorn_backup_name }}
  namespace: longhorn-system
spec:
  backupTargetURL: "{% if k3s_longhorn_backup_armed | bool %}s3://{{ k3s_longhorn_b2_bucket }}@{{ k3s_longhorn_b2_region }}/{{ k3s_longhorn_backup_prefix }}{% endif %}"
  credentialSecret: longhorn-b2
  pollInterval: "{{ k3s_longhorn_backupstore_poll_interval }}s"
