{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_required with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: homelab-mcp
  namespace: {{ k8s_namespace }}
spec:
{{ spec_shell('RollingUpdate') }}
  replicas: 1
  selector:
    matchLabels:
      app: homelab-mcp
  template:
    metadata:
      labels:
        app: homelab-mcp
        netpol-baseline: enforced
    spec:
      # uid 1000, read-only root, all caps dropped, /tmp the only writable path.
      # The pod's own read-only cluster identity (rbac.yaml) — get/list on workload
      # shapes + pods/log, the exact surface of the Phase G cluster-API tools.
{{ pod_shell('homelab-best-effort', service_account='homelab-mcp', run_as_user=1000, run_as_group=1000, non_root=true) }}
      # Pinned, not preferred: the source mounts below read the node's checkout, and only the
      # primary node's checkout has a timer (checkout-sync) keeping it at origin/master.
{{ node_affinity_required(k8s_primary_node) }}
      containers:
        - name: homelab-mcp
          image: {{ homelab_mcp_k8s_image }}
          # Rolling tier: the registry tag is rebuilt in place by image-builder, so pod
          # creation must re-pull (see n8n's defaults for the full note).
          imagePullPolicy: Always
          ports:
            - containerPort: {{ container_item.port }}
{{ hardened_security_context(read_only=true) }}
          env:
            - name: HOMELAB_MCP_TOKEN
              valueFrom:
                secretKeyRef:
                  name: homelab-mcp-secrets
                  key: HOMELAB_MCP_TOKEN
            - name: HOMELAB_HA_TOKEN
              valueFrom:
                secretKeyRef:
                  name: homelab-mcp-secrets
                  key: HOMELAB_HA_TOKEN
            # In-cluster service URLs — every backend this server reads is cluster-hosted
            # now. DOCKER_PROXY_URL stays unset on purpose: the cluster is barred from the
            # Docker socket (Security M1), so the container tools raise a clear
            # tools-are-dark error (safe_reads.docker_base_or_raise) until the Phase G
            # cluster-API successor.
            - name: PROMETHEUS_URL
              value: http://prometheus.observability.svc.cluster.local:9090
            - name: LOKI_URL
              value: http://loki-homelab.{{ k8s_namespace }}.svc.cluster.local:3100
            # The observability Loki — verbatim prompt/response content (KL1). Only
            # claude_code_events reads it, and only through the metadata whitelist
            # (k8s_reads.claude_event_rows); the raw store stays without a LAN route.
            - name: CLAUDE_LOKI_URL
              value: http://loki.{{ k8s_observability_namespace }}.svc.cluster.local:3100
            - name: SCRUTINY_URL
              value: http://scrutiny.{{ k8s_namespace }}.svc.cluster.local:8080
            - name: HA_URL
              value: http://home-assistant.{{ k8s_namespace }}.svc.cluster.local:8123
            - name: HOMELAB_FILE_ROOT
              value: /srv/homelab-src
            # Trusted host for the MCP transport's DNS-rebinding guard (else 421).
            - name: MCP_PUBLIC_HOST
              value: mcp.local.{{ domain }}
            # The only destinations cert_expiry may dial: hostnames under the routed zone, on
            # Traefik's HTTPS port. Unset, the tool refuses every target (#1931).
            - name: CERT_EXPIRY_DOMAINS
              value: "{{ domain }}"
            - name: CERT_EXPIRY_PORTS
              value: "443"
            - name: PORT
              value: "{{ container_item.port }}"
            - name: PYTHONDONTWRITEBYTECODE
              value: "1"
            - name: TZ
              value: "{{ tz }}"
          volumeMounts:
            # The checkout's k8s/, inventory/ and tests/, READ-ONLY, under the read_file/list_files
            # jail root. secrets/ is not mounted, secret names are denied in-app
            # (safe_reads.path_is_denied), and the age key isn't under here. hostPath rather than
            # a git-clone sidecar: the pinned node already holds a synced checkout.
{% for dir in homelab_mcp_source_dirs %}
            - name: homelab-mcp-src-{{ dir }}
              mountPath: /srv/homelab-src/{{ dir }}
              readOnly: true
{% endfor %}
            - name: homelab-mcp-tmp
              mountPath: /tmp
          readinessProbe:
            tcpSocket:
              port: {{ container_item.port }}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            tcpSocket:
              port: {{ container_item.port }}
            initialDelaySeconds: 20
            periodSeconds: 30
{{ container_resources(cpu_limit=homelab_mcp_k8s_cpu_limit, mem_limit=homelab_mcp_k8s_mem_limit, cpu_request=homelab_mcp_k8s_cpu_request, mem_request=homelab_mcp_k8s_mem_request) }}
      volumes:
{% for dir in homelab_mcp_source_dirs %}
        - name: homelab-mcp-src-{{ dir }}
          hostPath:
            path: /home/{{ sys_user }}/server/{{ dir }}
            type: Directory
{% endfor %}
        - name: homelab-mcp-tmp
          emptyDir: {}
