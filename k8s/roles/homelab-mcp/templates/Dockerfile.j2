# DIGEST-PINNED — see k8s/roles/ical-proxy/templates/Dockerfile.j2 for why a version tag alone is
# not a pin. Same base, same digest: Renovate groups the two into one PR, so they stay in step.
FROM python:3.15-slim@sha256:63bb298d2b7b88f176f51b5189f54ce6535c997682ea70885d2132f5d473a8a5
WORKDIR /app
# mcp stays on 1.x: 2.0.0 removed mcp.server.fastmcp and crash-loops the container. Lift it
# only with an app.py port to the 2.x API. All three packages are pinned exact, because a range
# re-resolves to the newest release on every rebuild. Renovate tracks each on PyPI (regex
# manager in renovate.json); the packageRule there caps mcp at `<2` so the 1.x line is what it
# offers.
RUN pip install --no-cache-dir mcp==1.30.0 httpx==0.28.1 uvicorn==0.54.0
# COPY . (not `COPY app.py safe_reads.py`): the context is a ConfigMap mount, whose
# files are symlinks into ..data/, and buildkit's followPaths optimization for a
# multi-file COPY drops all but the first symlinked file from the transfer ("not
# found" — a single-file COPY like n8n-runners' works). COPY .
# ships the whole snapshot, so the ..data dir arrives and every symlink resolves.
# The image gains the Dockerfile + ConfigMap dotdirs under /app — harmless.
COPY . ./
CMD ["python", "app.py"]
