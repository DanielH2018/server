---
# A Secret of its own: Flux would type a passphrase such as `yes` or `0123` as a non-string.
apiVersion: v1
kind: Secret
metadata:
  name: vault-mcp-passphrase
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
{# to_json escapes any quote or backslash. Store the value quoted in secrets.yml: SOPS types an
   unquoted all-digit value int, and to_json of an int emits bare digits. #}
  LIVESYNC_PASSPHRASE: {{ livesync_e2ee_passphrase | to_json }}
