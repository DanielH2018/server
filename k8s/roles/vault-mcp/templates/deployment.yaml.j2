{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: vault-mcp
  namespace: {{ k8s_namespace }}
spec:
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: vault-mcp
  template:
    metadata:
      labels:
        app: vault-mcp
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-best-effort', run_as_user=vault_mcp_k8s_uid, run_as_group=vault_mcp_k8s_uid, fs_group=vault_mcp_k8s_uid) }}
      initContainers:
{# JSON.stringify escapes the two secrets. Substituting them into the ConfigMap's JSON would
   not: Flux pastes a value's raw text, so a `"` in the passphrase breaks the file. #}
        - name: write-settings
          image: {{ vault_mcp_k8s_livesync_cli_image }}
          imagePullPolicy: IfNotPresent
          command:
            - node
            - -e
            - >-
              const fs = require("fs");
              const s = JSON.parse(fs.readFileSync("/config/settings.json", "utf8"));
              s.couchDB_PASSWORD = process.env.COUCHDB_PASSWORD;
              s.passphrase = process.env.LIVESYNC_PASSPHRASE;
              fs.writeFileSync("/settings/settings.json", JSON.stringify(s), {mode: 0o600});
          env:
{# DECIDED: the bridge logs in as CouchDB's admin, from livesync's own Secret. The obsidian
   database's _security is empty, so a dedicated user would hold the same access, and creating
   one needs a bootstrap Job; sharing the Secret also means a rotation reaches the bridge with
   no step of its own. #}
            - name: COUCHDB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: livesync
                  key: COUCHDB_PASSWORD
            - name: LIVESYNC_PASSPHRASE
              valueFrom:
                secretKeyRef:
                  name: vault-mcp-passphrase
                  key: LIVESYNC_PASSPHRASE
          volumeMounts:
            - name: vault-mcp-config
              mountPath: /config
            - name: vault-mcp-settings
              mountPath: /settings
{{ hardened_security_context(read_only=true, non_root=true) }}
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='32Mi') }}
      containers:
        - name: livesync-cli
          image: {{ vault_mcp_k8s_livesync_cli_image }}
          imagePullPolicy: IfNotPresent
          args:
            - --settings
            - /settings/settings.json
            - --vault
            - /vault
            - daemon
          env:
            - name: LIVESYNC_DB_PATH
              value: /data
{{ hardened_security_context(read_only=true, non_root=true) }}
          volumeMounts:
            - name: vault-mcp-db
              mountPath: /data
            - name: vault-mcp-vault
              mountPath: /vault
            - name: vault-mcp-settings
              mountPath: /settings
            - name: vault-mcp-tmp
              mountPath: /tmp
{{ container_resources(cpu_limit=vault_mcp_k8s_cpu_limit, mem_limit=vault_mcp_k8s_mem_limit, cpu_request=vault_mcp_k8s_cpu_request, mem_request=vault_mcp_k8s_mem_request) }}
        - name: vault-mcp
          image: {{ vault_mcp_k8s_image }}
          # A rebuild can reuse the tag, so pod creation must re-pull.
          imagePullPolicy: Always
          ports:
            - containerPort: {{ container_item.port }}
{{ hardened_security_context(read_only=true, non_root=true) }}
          env:
            - name: VAULT_MCP_RESOURCE_URL
              value: "{{ vault_mcp_connector_url }}"
            - name: VAULT_MCP_ISSUER
              value: "https://auth.{{ domain }}"
{# The LAN name: the pod reaches Authelia through Traefik, as Grafana does. #}
            - name: VAULT_MCP_JWKS_URL
              value: "https://auth.local.{{ domain }}/jwks.json"
            - name: VAULT_MCP_ROOT
              value: /vault
            - name: VAULT_MCP_EXCLUDE_PATHS
              value: {{ vault_mcp_exclude_paths | join('\n') | to_json }}
            # Trusted hosts for the MCP transport's DNS-rebinding guard (else 421).
            - name: MCP_HOSTS
              value: "vault-mcp.{{ domain }} vault-mcp.local.{{ domain }}"
            - name: PORT
              value: "{{ container_item.port }}"
            - name: PYTHONDONTWRITEBYTECODE
              value: "1"
          volumeMounts:
            - name: vault-mcp-vault
              mountPath: /vault
              readOnly: true
            - name: vault-mcp-server-tmp
              mountPath: /tmp
          readinessProbe:
            httpGet:
              path: /health
              port: {{ container_item.port }}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            tcpSocket:
              port: {{ container_item.port }}
            initialDelaySeconds: 20
            periodSeconds: 30
{{ container_resources(cpu_limit=vault_mcp_k8s_server_cpu_limit, mem_limit=vault_mcp_k8s_server_mem_limit, cpu_request=vault_mcp_k8s_server_cpu_request, mem_request=vault_mcp_k8s_server_mem_request) }}
      volumes:
        - name: vault-mcp-db
          persistentVolumeClaim:
            claimName: vault-mcp-db
        - name: vault-mcp-vault
          persistentVolumeClaim:
            claimName: vault-mcp-vault
        - name: vault-mcp-config
          configMap:
            name: vault-mcp-config
        - name: vault-mcp-settings
          emptyDir:
            medium: Memory
        - name: vault-mcp-tmp
          emptyDir: {}
        - name: vault-mcp-server-tmp
          emptyDir: {}
