---
# A file, not an env var, so the key stays out of the container environment.
# Store it without surrounding whitespace: init-envfile does not strip a trailing newline.
apiVersion: v1
kind: Secret
metadata:
  name: qbittorrent-mullvad
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  key: "{{ wireguard_interface_private_key }}"
