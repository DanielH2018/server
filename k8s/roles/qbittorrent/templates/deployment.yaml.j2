{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
{% from 'wireguard-sidecar.yml.j2' import wireguard_sidecar with context %}
{% from 'lsio-env.yml.j2' import lsio_env with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: qbittorrent
  namespace: {{ k8s_namespace }}
spec:
  # The config PVC is ReadWriteOnce on single-replica Longhorn, so a rolling update deadlocks on
  # a volume the outgoing pod still holds.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: qbittorrent
  template:
    metadata:
      labels:
        app: qbittorrent
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-standard') }}
      securityContext:
        # The whole reason for the kubelet allow-list (D11). wg-quick attempts to set this
        # itself and aborts the tunnel when it cannot — /proc/sys is mounted read-only in a pod
        # even with NET_ADMIN. Pre-set here, wg-quick finds it already 1 and skips the write.
        sysctls:
          - name: net.ipv4.conf.all.src_valid_mark
            value: "1"
{{ wireguard_sidecar('qbittorrent',
                     image=qbittorrent_k8s_wireguard_image,
                     mod=qbittorrent_k8s_mullvad_mod,
                     secret_mount=qbittorrent_k8s_secret_mount,
                     location=qbittorrent_k8s_mullvad_location,
                     lan_networks=qbittorrent_k8s_lan_networks,
                     cpu_limit=qbittorrent_k8s_wg_cpu_limit,
                     mem_limit=qbittorrent_k8s_wg_mem_limit,
                     cpu_request=qbittorrent_k8s_wg_cpu_request,
                     mem_request=qbittorrent_k8s_wg_mem_request) }}
      containers:
        - name: qbittorrent
          image: {{ qbittorrent_k8s_image }}
          imagePullPolicy: IfNotPresent
          # No network configuration of its own: containers in a pod share one network
          # namespace, so it inherits the wireguard sidecar's.
          ports:
            - containerPort: {{ qbittorrent_k8s_webui_port }}
              name: webui
            - containerPort: {{ qbittorrent_k8s_torrenting_port }}
              name: torrent
          # No NET_ADMIN. Networking belongs to the sidecar; this container only needs the
          # LSIO s6 set to chown /config and /data and drop to PUID/PGID.
{{ hardened_security_context(add=['CHOWN', 'SETUID', 'SETGID', 'FOWNER', 'DAC_OVERRIDE']) }}
          env:
{{ lsio_env() }}
            - name: UMASK_SET
              value: "022"
            - name: WEBUI_PORT
              value: "{{ qbittorrent_k8s_webui_port }}"
            - name: TORRENTING_PORT
              value: "{{ qbittorrent_k8s_torrenting_port }}"
          volumeMounts:
            - name: qbittorrent-config
              mountPath: /config
            # subPath, so this container sees ONLY torrents/ out of the shared media volume.
            - name: media
              mountPath: /data/torrents
              subPath: {{ qbittorrent_k8s_torrents_subpath }}
          readinessProbe:
            httpGet:
              path: /
              port: {{ qbittorrent_k8s_webui_port }}
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            # Never present, never deliberately removed (no comment on this container ever
            # explained its absence) — a k3s-migration oversight, not a decision.
            # K8sDeploymentReplicasUnavailable already pages on this, so this probe closes
            # a self-healing gap, not an alerting one: nothing restarted a wedged WebUI in the
            # Docker/autoheal era's absence.
            #
            # Deliberately looser than the sidecar's own liveness (failureThreshold 6 / period
            # 60s = 6 min) — ~10 min of sustained failure before a restart. The kill-switch
            # iptables rules live in the POD network namespace, not this container, and survive a
            # container restart (a recorded incident deadlocked qbittorrent for 9h behind 107
            # restarts before that was understood). Restarting just this container can't touch
            # that netns state, so if a wedge outlives several restarts here, the fault is
            # netns-adjacent — the sidecar's own restart resets it (files/netns-reset.sh);
            # tightening this probe would not.
            httpGet:
              path: /
              port: {{ qbittorrent_k8s_webui_port }}
            initialDelaySeconds: 60
            periodSeconds: 60
            timeoutSeconds: 15
            failureThreshold: 10
{{ container_resources(cpu_limit=qbittorrent_k8s_cpu_limit, mem_limit=qbittorrent_k8s_mem_limit, cpu_request=qbittorrent_k8s_cpu_request, mem_request=qbittorrent_k8s_mem_request) }}
      volumes:
        - name: qbittorrent-config
          persistentVolumeClaim:
            claimName: {{ qbittorrent_k8s_claim }}
        - name: media
          persistentVolumeClaim:
            claimName: {{ qbittorrent_k8s_media_claim }}
        # Both Secrets at qbittorrent_k8s_secret_mount: the WireGuard key from
        # qbittorrent-mullvad, and the account number, which has a Secret of its own because its
        # all-digit value cannot pass through a Flux placeholder
        # (templates/mullvad-account-secret.yaml.j2).
        - name: qbittorrent-mullvad
          projected:
            defaultMode: 0400
            sources:
              - secret:
                  name: qbittorrent-mullvad
              - secret:
                  name: qbittorrent-mullvad-account
        - name: netns-reset
          configMap:
            name: qbittorrent-netns-reset
            defaultMode: 0555
