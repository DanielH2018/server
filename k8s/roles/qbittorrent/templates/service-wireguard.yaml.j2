---
# Alias for the `wireguard:8080` host stored in the *arr databases; same pod as service.yaml.
apiVersion: v1
kind: Service
metadata:
  name: wireguard
  namespace: {{ k8s_namespace }}
spec:
  selector:
    app: qbittorrent
  ports:
    - name: webui
      port: {{ qbittorrent_k8s_webui_port }}
      targetPort: {{ qbittorrent_k8s_webui_port }}
