---
# The Mullvad account number, from the SOPS key mullvad_account. The Deployment projects this
# Secret and qbittorrent-mullvad into one volume at qbittorrent_k8s_secret_mount, so
# FILE__MULLVAD_ACCOUNT still reads <mount>/account.
#
# A Secret of its own because the value is all digits and stands alone in its field: Flux
# substitutes without the template's quotes, so a `${...}` placeholder would type it as a
# number. D3 ships this Secret as a SOPS-encrypted manifest instead (target slice R2, PR 7b).
# `render_sops_manifests` in defaults/main.yml names this file, so a placeholder render leaves
# it out. Store the value without surrounding whitespace: init-envfile does not strip a
# trailing newline, and nothing at deploy refuses one.
apiVersion: v1
kind: Secret
metadata:
  name: qbittorrent-mullvad-account
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  # Quoted, never `| to_json`: SOPS types this key int, and to_json of an int emits bare digits, which the API server refuses as a stringData value.
  account: "{{ mullvad_account }}"
