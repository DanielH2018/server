---
# A Secret of its own: Flux would type an all-digit value as a number.
# Store it without surrounding whitespace: init-envfile does not strip a trailing newline.
apiVersion: v1
kind: Secret
metadata:
  name: qbittorrent-mullvad-account
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  # Quoted, never `| to_json`: SOPS types this key int, and to_json of an int emits bare digits, which the API server refuses as a stringData value.
  account: "{{ mullvad_account }}"
