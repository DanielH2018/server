{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import pod_shell with context %}
{# The dockerhub-mirror-pull sidecar GETs this image's own manifest by digest. docker.io names a
   one-component repository under library/. #}
{% set exporter_repository = node_exporter_k8s_image.split('@')[0].rsplit(':', 1)[0] %}
{% set exporter_repository = exporter_repository if '/' in exporter_repository else 'library/' ~ exporter_repository %}
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: node-exporter
  namespace: {{ k8s_namespace }}
spec:
  selector:
    matchLabels:
      app: node-exporter
  template:
    metadata:
      labels:
        app: node-exporter
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-best-effort') }}
      # Host networking + PID so node_* describes the NODE (network interfaces, /proc)
      # rather than a pod netns — the standard node-exporter posture. The 9100 listener
      # this opens on each node is host-firewalled by ufw's default-deny INPUT except
      # for the server node's LAN IP (k3s_join_agent_ports): under hostNetwork the
      # "pod IP" prometheus scrapes IS the node's LAN IP, and cross-node that traffic
      # arrives masqueraded from the scraping node, NOT over the vxlan the join allows.
      hostNetwork: true
      hostPID: true
      containers:
        - name: node-exporter
          image: {{ node_exporter_k8s_image }}
          imagePullPolicy: IfNotPresent
          args:
            - --path.procfs=/host/proc
            - --path.rootfs=/rootfs
            - --path.sysfs=/host/sys
            # var/lib/kubelet is excluded only down to its pods/ subtree: the per-pod bind mounts
            # there are unbounded (one set per running pod), but Longhorn's CSI global mounts under
            # var/lib/kubelet/plugins/ stay scraped, the only place node_filesystem_readonly can see
            # a CSI volume's ext4 journal abort remount it read-only. That is ~40 attached volumes
            # x ~7 series, not the per-pod cardinality the exclusion cuts off.
            - --collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc|var/lib/kubelet/pods)($|/)
            - --collector.textfile.directory=/textfile
            # The iscsi-sessions sidecar's directory, a second instance of the repeatable flag.
            - --collector.textfile.directory=/iscsi-textfile
            # The ghcr-mirror-pull sidecar's directory, a third instance.
            - --collector.textfile.directory=/ghcr-mirror-textfile
            # The dockerhub-mirror-pull sidecar's directory, a fourth.
            - --collector.textfile.directory=/dockerhub-mirror-textfile
          ports:
            - containerPort: 9100
          # Host access is READ-ONLY and comes from the hostPath mounts below, not from a uid.
          # The image's own USER is 65534; pinning it guards an image bump that changes that.
          # An HTTP probe on /metrics floods the log: kubelet's prober reads a bounded prefix and
          # closes, and node_exporter logs one `connection reset by peer` line per family it could
          # not write (~280 per probe). busybox wget reads the whole body, so nothing resets.
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=65534) }}
          livenessProbe:
            # The one probe that renders metrics, because only a probe that asks for them times
            # out on a WEDGED collector: a dead NFS mount leaves / answering while /metrics hangs.
            exec:
              command: [wget, -q, -T, "5", -O, /dev/null, "http://127.0.0.1:9100/metrics"]
            initialDelaySeconds: 15
            periodSeconds: 60
            # A render takes ~50ms; the headroom covers growth in the mount and disk count.
            timeoutSeconds: 5
          # Without a readiness probe, `rollout status` gates on numberAvailable meaning "Running",
          # and goes green on a container that never served a scrape. `/` gates the rollout as
          # well as /metrics does, because both paths share ONE listener that binds after the
          # collectors register. It does not catch a wedged collector (liveness does) or
          # collectors that all fail: node_exporter answers 200 either way.
          readinessProbe:
            httpGet:
              path: /
              port: 9100
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
          volumeMounts:
            - name: node-exporter-proc
              mountPath: /host/proc
              readOnly: true
            - name: node-exporter-sys
              mountPath: /host/sys
              readOnly: true
            - name: node-exporter-rootfs
              mountPath: /rootfs
              readOnly: true
              # Without this, a mount created on the HOST after pod start never enters /rootfs
              # (hostPath propagation is private by default). Longhorn creates a CSI global mount
              # at attach time, so the filesystem collector would see nothing there. One-way
              # (host -> container), so the pod can never mount INTO the host.
              mountPropagation: HostToContainer
            - name: node-exporter-textfile
              mountPath: /textfile
              readOnly: true
            - name: node-exporter-iscsi-textfile
              mountPath: /iscsi-textfile
              readOnly: true
            - name: node-exporter-ghcr-mirror-textfile
              mountPath: /ghcr-mirror-textfile
              readOnly: true
            - name: node-exporter-dockerhub-mirror-textfile
              mountPath: /dockerhub-mirror-textfile
              readOnly: true
          # 1 core, not 200m. The exporter renders ~320 metric families per request, and at
          # 200m it was throttled on 42% of CFS periods, which slows every scrape and probe.
{{ container_resources(cpu_limit='1', mem_limit='128Mi', cpu_request='20m', mem_request='32Mi') }}
        # Writes iscsi-sessions.prom, the node's iSCSI session states, every 60s. A
        # sidecar rather than a host timer because this DaemonSet reaches both nodes, mounts /sys
        # and is applied by Flux. The script is inlined, not mounted from a ConfigMap, so a change
        # to it rolls the DaemonSet. It reuses the exporter's image for its busybox shell. No
        # probes: pod Ready is the AND of its containers, and a readiness probe here would let
        # this check pull the exporter out of the Kustomization's wait. A wedged loop surfaces
        # as IscsiSessionsNotReporting.
        - name: iscsi-sessions
          image: {{ node_exporter_k8s_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
            - |
              {{ lookup('file', role_file('files/iscsi-sessions.sh')) | indent(14) }}
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=65534) }}
          volumeMounts:
            - name: node-exporter-sys
              mountPath: /host/sys
              readOnly: true
            - name: node-exporter-iscsi-textfile
              mountPath: /iscsi-textfile
{{ container_resources(cpu_limit='100m', mem_limit='16Mi', cpu_request='5m', mem_request='8Mi') }}
        # Writes ghcr-mirror-pull.prom, whether this node's ghcr.io mirror endpoint serves nut's
        # manifest, every 600s. Here because this pod is hostNetwork on every node: its
        # GET leaves the host network namespace as containerd's pulls do, so the mirror's fence
        # judges it by the same node grant. A pod network check would be refused by that fence,
        # which the registry's isolation Job proves. The endpoint is the one registries.yaml
        # names on the node (hosts/components/k3s-{server,agent}/templates/registries.yaml.j2). It
        # reuses the exporter's image for busybox's shell and wget. No probes, as for iscsi-sessions above.
        - name: ghcr-mirror-pull
          image: {{ node_exporter_k8s_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
            - |
              {{ lookup('file', role_file('files/ghcr-mirror-pull.sh')) | indent(14) }}
          env:
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: REGISTRY_NODE
              value: "{{ k8s_registry_node }}"
            - name: LOCAL_ENDPOINT
              value: "http://localhost:{{ k8s_registry_ghcr_mirror_port }}"
            - name: REMOTE_ENDPOINT
              value: "http://{{ k8s_registry_cluster_ip }}:{{ k8s_registry_ghcr_mirror_port }}"
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=65534) }}
          volumeMounts:
            - name: node-exporter-ghcr-mirror-probe
              mountPath: /ghcr-mirror-probe
              readOnly: true
            - name: node-exporter-ghcr-mirror-textfile
              mountPath: /ghcr-mirror-textfile
{{ container_resources(cpu_limit='100m', mem_limit='16Mi', cpu_request='5m', mem_request='8Mi') }}
        # The same script against the docker.io mirror's endpoint, written as
        # dockerhub-mirror-pull.prom. It GETs this pod's own image by digest, which Renovate moves
        # with the exporter, so it needs no other role's ConfigMap. A digest GET is served from the
        # mirror's store once cached and spends none of Docker Hub's anonymous pull limit.
        - name: dockerhub-mirror-pull
          image: {{ node_exporter_k8s_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
            - |
              {{ lookup('file', role_file('files/ghcr-mirror-pull.sh')) | indent(14) }}
          env:
            - name: CHECK
              value: dockerhub-mirror-pull
            - name: REPOSITORY
              value: "{{ exporter_repository }}"
            - name: REFERENCE
              value: "{{ node_exporter_k8s_image.split('@')[1] }}"
            - name: TEXTFILE_DIR
              value: /dockerhub-mirror-textfile
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: REGISTRY_NODE
              value: "{{ k8s_registry_node }}"
            - name: LOCAL_ENDPOINT
              value: "http://localhost:{{ k8s_registry_dockerhub_mirror_port }}"
            - name: REMOTE_ENDPOINT
              value: "http://{{ k8s_registry_cluster_ip }}:{{ k8s_registry_dockerhub_mirror_port }}"
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=65534) }}
          volumeMounts:
            - name: node-exporter-dockerhub-mirror-textfile
              mountPath: /dockerhub-mirror-textfile
{{ container_resources(cpu_limit='100m', mem_limit='16Mi', cpu_request='5m', mem_request='8Mi') }}
      volumes:
        - name: node-exporter-proc
          hostPath:
            path: /proc
        - name: node-exporter-sys
          hostPath:
            path: /sys
        - name: node-exporter-rootfs
          hostPath:
            path: /
        # The textfile collector directory. This role's CLAUDE.md names its producers and the
        # contract a new *.prom file follows.
        - name: node-exporter-textfile
          hostPath:
            path: /var/lib/node-exporter-textfile
            type: DirectoryOrCreate
        # The iscsi-sessions sidecar writes here and the exporter reads it. An emptyDir, not the
        # hostPath above, so the sidecar needs no write access to the host.
        - name: node-exporter-iscsi-textfile
          emptyDir:
            sizeLimit: 1Mi
        # The ghcr-mirror-pull sidecar writes here and the exporter reads it.
        - name: node-exporter-ghcr-mirror-textfile
          emptyDir:
            sizeLimit: 1Mi
        # The dockerhub-mirror-pull sidecar's.
        - name: node-exporter-dockerhub-mirror-textfile
          emptyDir:
            sizeLimit: 1Mi
        # nut's role renders the repository and tag the sidecar GETs. A directory mount, never a
        # subPath, so the kubelet swaps in a new tag without a roll. Optional, so a missing
        # ConfigMap leaves the files absent and the check reports down rather than blocking the
        # pod's start.
        - name: node-exporter-ghcr-mirror-probe
          configMap:
            name: nut-ghcr-mirror-probe
            optional: true
