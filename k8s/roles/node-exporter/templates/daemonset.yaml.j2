{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import pod_shell with context %}
{% set exporter_repository = node_exporter_k8s_image.split('@')[0].rsplit(':', 1)[0] %}
{% set exporter_repository = exporter_repository if '/' in exporter_repository else 'library/' ~ exporter_repository %}
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: node-exporter
  namespace: {{ k8s_namespace }}
spec:
  selector:
    matchLabels:
      app: node-exporter
  template:
    metadata:
      labels:
        app: node-exporter
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-best-effort') }}
      # The 9100 listener is host-firewalled except for the server node's LAN IP
      # (k3s_join_agent_ports);
      # cross-node scrapes arrive masqueraded, not over the vxlan.
      hostNetwork: true
      hostPID: true
      containers:
        - name: node-exporter
          image: {{ node_exporter_k8s_image }}
          imagePullPolicy: IfNotPresent
          args:
            - --path.procfs=/host/proc
            - --path.rootfs=/rootfs
            - --path.sysfs=/host/sys
            # Exclusion stops at var/lib/kubelet/pods: Longhorn's CSI mounts under plugins/ stay
            # scraped so node_filesystem_readonly sees a journal-abort remount.
            - --collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc|var/lib/kubelet/pods)($|/)
            - --collector.textfile.directory=/textfile
            # The iscsi-sessions sidecar's directory, a second instance of the repeatable flag.
            - --collector.textfile.directory=/iscsi-textfile
            # The ghcr-mirror-pull sidecar's directory, a third instance.
            - --collector.textfile.directory=/ghcr-mirror-textfile
            # The dockerhub-mirror-pull sidecar's directory, a fourth.
            - --collector.textfile.directory=/dockerhub-mirror-textfile
          ports:
            - containerPort: 9100
          # Host access is READ-ONLY via hostPath; the pinned uid guards an image bump.
          # No HTTP probe on /metrics: kubelet closes early and node_exporter logs a
          # `connection reset`
          # line per family.
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=65534) }}
          livenessProbe:
            # Renders metrics on purpose: only that times out on a WEDGED collector (a dead NFS
            # mount leaves / answering).
            exec:
              command: [wget, -q, -T, "5", -O, /dev/null, "http://127.0.0.1:9100/metrics"]
            initialDelaySeconds: 15
            periodSeconds: 60
            # A render takes ~50ms; the headroom covers growth in the mount and disk count.
            timeoutSeconds: 5
          # Without a readiness probe the rollout goes green on a container that never served a
          # scrape.
          # `/` gates as well as /metrics (one listener); a wedged collector is liveness's job.
          readinessProbe:
            httpGet:
              path: /
              port: 9100
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
          volumeMounts:
            - name: node-exporter-proc
              mountPath: /host/proc
              readOnly: true
            - name: node-exporter-sys
              mountPath: /host/sys
              readOnly: true
            - name: node-exporter-rootfs
              mountPath: /rootfs
              readOnly: true
              # Without it a mount created on the HOST after pod start never enters /rootfs.
              # One-way, so the pod cannot mount into the host.
              mountPropagation: HostToContainer
            - name: node-exporter-textfile
              mountPath: /textfile
              readOnly: true
            - name: node-exporter-iscsi-textfile
              mountPath: /iscsi-textfile
              readOnly: true
            - name: node-exporter-ghcr-mirror-textfile
              mountPath: /ghcr-mirror-textfile
              readOnly: true
            - name: node-exporter-dockerhub-mirror-textfile
              mountPath: /dockerhub-mirror-textfile
              readOnly: true
          # 1 core, not 200m: at 200m the exporter throttled on 42% of CFS periods, slowing every
          # scrape and probe.
{{ container_resources(cpu_limit='1', mem_limit='128Mi', cpu_request='20m', mem_request='32Mi') }}
        # A sidecar, not a host timer: this DaemonSet reaches both nodes and Flux applies it. The
        # script is inlined so a change rolls it.
        # No probes: a readiness probe would let this check pull the exporter out of the
        # Kustomization's wait.
        - name: iscsi-sessions
          image: {{ node_exporter_k8s_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
            - |
              {{ lookup('file', role_file('files/iscsi-sessions.sh')) | indent(14) }}
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=65534) }}
          volumeMounts:
            - name: node-exporter-sys
              mountPath: /host/sys
              readOnly: true
            - name: node-exporter-iscsi-textfile
              mountPath: /iscsi-textfile
{{ container_resources(cpu_limit='100m', mem_limit='16Mi', cpu_request='5m', mem_request='8Mi') }}
        # Here because this pod is hostNetwork on every node: its GET leaves the host netns as
        # containerd's pulls do, so the mirror's fence judges it by the same node grant. No probes,
        # as for iscsi-sessions.
        - name: ghcr-mirror-pull
          image: {{ node_exporter_k8s_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
            - |
              {{ lookup('file', role_file('files/ghcr-mirror-pull.sh')) | indent(14) }}
          env:
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: REGISTRY_NODE
              value: "{{ k8s_registry_node }}"
            - name: LOCAL_ENDPOINT
              value: "http://localhost:{{ k8s_registry_ghcr_mirror_port }}"
            - name: REMOTE_ENDPOINT
              value: "http://{{ k8s_registry_cluster_ip }}:{{ k8s_registry_ghcr_mirror_port }}"
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=65534) }}
          volumeMounts:
            - name: node-exporter-ghcr-mirror-probe
              mountPath: /ghcr-mirror-probe
              readOnly: true
            - name: node-exporter-ghcr-mirror-textfile
              mountPath: /ghcr-mirror-textfile
{{ container_resources(cpu_limit='100m', mem_limit='16Mi', cpu_request='5m', mem_request='8Mi') }}
        # The same script against the docker.io mirror's endpoint, written as
        # dockerhub-mirror-pull.prom. It GETs this pod's own image by digest, which Renovate moves
        # with the exporter, so it needs no other role's ConfigMap. A digest GET is served from the
        # mirror's store once cached and spends none of Docker Hub's anonymous pull limit.
        - name: dockerhub-mirror-pull
          image: {{ node_exporter_k8s_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
            - |
              {{ lookup('file', role_file('files/ghcr-mirror-pull.sh')) | indent(14) }}
          env:
            - name: CHECK
              value: dockerhub-mirror-pull
            - name: REPOSITORY
              value: "{{ exporter_repository }}"
            - name: REFERENCE
              value: "{{ node_exporter_k8s_image.split('@')[1] }}"
            - name: TEXTFILE_DIR
              value: /dockerhub-mirror-textfile
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: REGISTRY_NODE
              value: "{{ k8s_registry_node }}"
            - name: LOCAL_ENDPOINT
              value: "http://localhost:{{ k8s_registry_dockerhub_mirror_port }}"
            - name: REMOTE_ENDPOINT
              value: "http://{{ k8s_registry_cluster_ip }}:{{ k8s_registry_dockerhub_mirror_port }}"
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=65534) }}
          volumeMounts:
            - name: node-exporter-dockerhub-mirror-textfile
              mountPath: /dockerhub-mirror-textfile
{{ container_resources(cpu_limit='100m', mem_limit='16Mi', cpu_request='5m', mem_request='8Mi') }}
      volumes:
        - name: node-exporter-proc
          hostPath:
            path: /proc
        - name: node-exporter-sys
          hostPath:
            path: /sys
        - name: node-exporter-rootfs
          hostPath:
            path: /
        - name: node-exporter-textfile
          hostPath:
            path: /var/lib/node-exporter-textfile
            type: DirectoryOrCreate
        # An emptyDir, not the hostPath, so the sidecar needs no write access to the host.
        - name: node-exporter-iscsi-textfile
          emptyDir:
            sizeLimit: 1Mi
        # The ghcr-mirror-pull sidecar writes here and the exporter reads it.
        - name: node-exporter-ghcr-mirror-textfile
          emptyDir:
            sizeLimit: 1Mi
        # The dockerhub-mirror-pull sidecar's.
        - name: node-exporter-dockerhub-mirror-textfile
          emptyDir:
            sizeLimit: 1Mi
        # A directory mount, never a subPath, so the kubelet swaps in a new tag without a roll.
        # Optional:
        # a missing ConfigMap reports down.
        - name: node-exporter-ghcr-mirror-probe
          configMap:
            name: nut-ghcr-mirror-probe
            optional: true
