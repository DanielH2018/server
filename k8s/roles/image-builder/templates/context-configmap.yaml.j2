---
# A ConfigMap, not a git-clone initContainer (a second source of truth) or a hostPath (couples the
# build to the node's checkout); templated like every other file here.
apiVersion: v1
kind: ConfigMap
metadata:
  name: build-context-{{ image_builder_name }}
  namespace: {{ k8s_namespace }}
data:
  # `Dockerfile` is the literal name buildctl looks for under --local dockerfile=; do not rename.
  Dockerfile: |
{{ lookup('template', image_builder_dockerfile) | indent(4, true) }}
{% for src, dest in image_builder_context | dictsort %}
  {{ dest }}: |
{{ lookup('template', src) | indent(4, true) }}
{% endfor %}
{% for src, dest in image_builder_context_files | dictsort %}
  {{ dest }}: |
{{ lookup('file', src) | indent(4, true) }}
{% endfor %}
