{% from 'container-resources.yml.j2' import container_resources with context %}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: build-{{ image_builder_name }}
  namespace: {{ k8s_namespace }}
spec:
  activeDeadlineSeconds: {{ image_builder_timeout }}
  # No retry: a failed build is a Dockerfile or registry problem and fails again identically.
  backoffLimit: 0
  # Backstop: the deploy task deletes this Job before re-applying; the TTL covers a skipped step.
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app: build-{{ image_builder_name }}
        # Static, unlike `app`: the registry's NetworkPolicy admits this label on the push port,
        # covering every caller (k8s/registry/templates/networkpolicy.yaml.j2).
        netpol-role: image-builder
    spec:
      restartPolicy: Never
      enableServiceLinks: false
      automountServiceAccountToken: false
      containers:
        - name: buildkit
          image: {{ image_builder_k8s_image }}
          imagePullPolicy: IfNotPresent
          env:
            # Drops the per-RUN user namespace (as upstream's job.rootless.yaml), so the POD is the
            # sandbox boundary.
            - name: BUILDKITD_FLAGS
              value: --oci-worker-no-process-sandbox
          command:
            - buildctl-daemonless.sh
          args:
            - build
            - --frontend
            - dockerfile.v0
            # Context and Dockerfile are the same directory: the ConfigMap mount.
            - --local
            - context=/workspace
            - --local
            - dockerfile=/workspace
            # registry.insecure=true: plain-HTTP registry, acceptable only while unreachable off the
            # node;
            # push to the SERVICE address.
            # Two names (sha-<12 hex>, latest) from one exporter, one digest; `"name=a,b"` is quoted
            # because buildctl parses CSV.
            - --output
            - type=image,"name={{ k8s_registry_push_host }}/{{ image_builder_name }}:{{ image_builder_content_tag }},{{ k8s_registry_push_host }}/{{ image_builder_name }}:{{ image_builder_tag }}",push=true,registry.insecure=true
            # Registry layer cache: buildkitd state dies with the Job. mode=min suffices
            # (single-stage);
            # `:buildcache` is a real tag.
            - --import-cache
            - type=registry,ref={{ k8s_registry_push_host }}/{{ image_builder_name }}:buildcache,registry.insecure=true
            - --export-cache
            - type=registry,ref={{ k8s_registry_push_host }}/{{ image_builder_name }}:buildcache,mode=min,image-manifest=true,oci-mediatypes=true,registry.insecure=true
          # Rootless BuildKit needs Unconfined seccomp and allowPrivilegeEscalation unset: false
          # fails with `newuidmap: Could not set caps`. The one such workload; uid 1000, no added
          # caps, runs only during a deploy.
          securityContext:
            seccompProfile:
              type: Unconfined
            appArmorProfile:
              type: Unconfined
            runAsUser: 1000
            runAsGroup: 1000
          volumeMounts:
            - name: image-builder-context
              mountPath: /workspace
              readOnly: true
            # An emptyDir, not a PVC: cross-build caching lives in the registry, and a Longhorn
            # volume would cost more and pin builds to one node.
            - name: image-builder-buildkitd
              mountPath: /home/user/.local/share/buildkit
{{ container_resources(cpu_limit="2", mem_limit="2048Mi", cpu_request="200m", mem_request="256Mi") }}
      volumes:
        - name: image-builder-context
          configMap:
            name: build-context-{{ image_builder_name }}
        - name: image-builder-buildkitd
          emptyDir: {}
