---
# The exportarr sidecar's credential. Rendered through the manifests role's SECRET list
# (0600 + no_log).
#
# Reuses `sonarr_api_key` rather than minting a second one: it IS sonarr's API key, the same
# value monitor-bridge, configarr and homepage already read, and sonarr offers no scoped
# read-only variant to mint instead. A second entry would only be a second rotation obligation
# for the same secret.
apiVersion: v1
kind: Secret
metadata:
  name: sonarr-exportarr
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  api_key: "{{ sonarr_api_key }}"
