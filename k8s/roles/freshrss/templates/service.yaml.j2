{% from 'service.yml.j2' import service with context %}
---
{{ service('freshrss', container_item.port) -}}
{# Deliberately NOT the service() macro: it sets `selector.app` to the Service name, but here the
   Service is `feed-cache` and the pod label `freshrss-feed-cache`. #}
---
# THE NAME IS LOAD-BEARING. FreshRSS stores subscription URLs in its database as
# `http://feed-cache.homelab.svc.cluster.local/...`, and its internal-host allowlist names the
# same host. Renaming the Service breaks both, and FreshRSS reports an ordinary fetch failure.
apiVersion: v1
kind: Service
metadata:
  name: feed-cache
  namespace: {{ k8s_namespace }}
spec:
  selector:
    app: freshrss-feed-cache
  ports:
    - port: 80
      targetPort: 80
