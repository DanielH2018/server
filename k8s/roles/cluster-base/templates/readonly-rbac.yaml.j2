---
# Bound to `view` PLUS the additive role below: `view` grants no nodes, PVs, storageclasses or CRDs.
# The admin kubeconfig is root:root 0640, reachable only through sudo, which unattended callers
# cannot use.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ cluster_base_readonly_sa_name }}
  namespace: {{ cluster_base_readonly_sa_namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ cluster_base_readonly_sa_name }}-token
  namespace: {{ cluster_base_readonly_sa_namespace }}
  annotations:
    kubernetes.io/service-account.name: {{ cluster_base_readonly_sa_name }}
# Non-expiring on purpose: the unattended caller cannot mint a replacement. Revoke by deleting this
# Secret and the ServiceAccount.
type: kubernetes.io/service-account-token
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: {{ cluster_base_readonly_sa_name }}
rules:
  # The cluster-scoped objects `view` omits.
  - apiGroups: [""]
    resources: ["nodes", "persistentvolumes"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["storage.k8s.io"]
    resources: ["storageclasses", "volumeattachments"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["apiextensions.k8s.io"]
    resources: ["customresourcedefinitions"]
    verbs: ["get", "list", "watch"]
{% for group in k3s_readonly_crd_api_groups %}
  - apiGroups: ["{{ group }}"]
    resources: ["*"]
    verbs: ["get", "list", "watch"]
{% endfor %}
# Deliberately absent: secrets (every credential is in one), pods/exec and pods/portforward (code
# execution, not a read), and rbac.* (reading bindings maps escalation paths).
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ cluster_base_readonly_sa_name }}-view
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: view
subjects:
  - kind: ServiceAccount
    name: {{ cluster_base_readonly_sa_name }}
    namespace: {{ cluster_base_readonly_sa_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ cluster_base_readonly_sa_name }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: {{ cluster_base_readonly_sa_name }}
subjects:
  - kind: ServiceAccount
    name: {{ cluster_base_readonly_sa_name }}
    namespace: {{ cluster_base_readonly_sa_namespace }}
---
# One Lease read for the server-restart guard (`kube-controller-manager`'s acquireTime); `view`
# grants no Lease, and `resourceNames` keeps a list Forbidden.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: homelab-readonly-kcm-lease
  namespace: kube-system
rules:
  - apiGroups: ["coordination.k8s.io"]
    resources: ["leases"]
    resourceNames: ["kube-controller-manager"]
    verbs: ["get"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: homelab-readonly-kcm-lease
  namespace: kube-system
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: homelab-readonly-kcm-lease
subjects:
  - kind: ServiceAccount
    name: {{ cluster_base_readonly_sa_name }}
    namespace: {{ cluster_base_readonly_sa_namespace }}
