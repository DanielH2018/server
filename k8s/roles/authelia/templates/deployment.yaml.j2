{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
{% from 'crowdsec-agent.yml.j2' import crowdsec_agent_init_containers, crowdsec_agent_sidecar, crowdsec_agent_volumes with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: authelia
  namespace: {{ k8s_namespace }}
spec:
  # The SQLite database is ReadWriteOnce: the old pod must stop before the new one starts.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: authelia
  template:
    metadata:
      labels:
        app: authelia
        netpol-baseline: enforced
    spec:
      # Pinned to the node announcing the VIPs; the DECIDED marker in home-assistant's
      # deployment.yaml.j2 has why.
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_primary_node }}
      # Starting as UID 1000 needs no SETUID/SETGID: the entrypoint su-execs only when started as
      # root.
      # fsGroup makes the config PVC writable.
{{ pod_shell(services | tier_priority_class('authelia'), run_as_user=puid, run_as_group=pgid, fs_group=pgid) }}
{# Gate the key on any init-container source being on, so it is absent rather than left with no list. #}
{% if authelia_k8s_manage_crowdsec or authelia_k8s_redis_sessions | bool or authelia_k8s_manage_claude_user | bool %}
      initContainers:
{% endif %}
{% if authelia_k8s_manage_crowdsec %}
{{ crowdsec_agent_init_containers('authelia', log_volume='authelia-logs', log_dir='/var/log/authelia', log_file='authelia.log', uid=puid, gid=pgid) }}
{% endif %}
{% if authelia_k8s_manage_claude_user | bool %}
        # claude-ui's TOTP registration lives in the SQLite database on the claim, not in the
        # rendered users_database.yml, so it is seeded through Authelia's own CLI before the
        # portal starts. `--force` rewrites the row from the fixed `authelia_claude_totp_secret`
        # on every pod start, so a rotation lands when the changed Secret rolls the pod.
        # Neither Ansible nor Flux needs `pods/exec` on authelia.
        #
        # `migrate up` runs first because `totp generate` refuses a schema older than its
        # binary (CheckSchema at v4.39.28), which is the state of the claim on the first start
        # after an Authelia bump that adds a migration, and of a fresh claim. The portal's own
        # startup runs the same migration. The CLI exits non-zero on "schema already up to
        # date", so that text is matched rather than every failure being ignored.
        #
        # stdout goes to /dev/null: `totp generate` prints the otpauth:// URI, which carries the
        # shared secret, and pod logs ship to Loki. The secret arrives through the environment,
        # so it never reaches the pod spec. The Secret carries it as a `|` block, so the
        # `printf` command substitution strips the block's trailing newline before the CLI sees
        # it. The three TOTP parameters are stated rather than left to the CLI defaults, because
        # scripts/diagnostics/ui_login.py derives its codes from the same three constants.
        #
        # DECIDED: the seed fails open. A failure logs to stderr and exits 0, so the portal still
        # starts. Under Recreate a failing init container is an SSO outage for the fleet, which
        # is the trade `disable_startup_check: true` in config-secret.yaml.j2 refuses for SMTP
        # too, and the row this writes serves only claude-ui. A missing row shows as the UI
        # tier's two_factor login failing (`uv run pytest -m ui`), and this container's log
        # names the step that failed.
        - name: seed-claude-totp
          image: {{ authelia_k8s_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
            - >-
              if ! authelia storage migrate up --config /secrets/configuration.yml
              >/tmp/seed-claude-totp.log 2>&1
              && ! grep -q 'schema already up to date' /tmp/seed-claude-totp.log; then
                cat /tmp/seed-claude-totp.log >&2;
                echo "seed-claude-totp: storage migration failed, so the TOTP row was not seeded" >&2;
                exit 0;
              fi;
              s=$(printf '%s' "$CLAUDE_TOTP_SECRET");
              if authelia storage user totp generate {{ authelia_k8s_claude_user }}
              --config /secrets/configuration.yml --secret "$s" --force
              --algorithm SHA1 --digits 6 --period 30 >/dev/null; then
                echo "seed-claude-totp: seeded the TOTP row";
              else
                echo "seed-claude-totp: totp generate failed, so the TOTP row was not seeded" >&2;
              fi
          env:
            - name: TZ
              value: "{{ tz }}"
{% if authelia_k8s_manage_oidc | bool %}
            # The CLI loads the same configuration.yml as the portal, whose `jwks[].key` needs this
            # filter.
            - name: X_AUTHELIA_CONFIG_FILTERS
              value: template
{% endif %}
            - name: CLAUDE_TOTP_SECRET
              valueFrom:
                secretKeyRef:
                  name: authelia-config
                  key: claude-totp-secret
          # Authelia does not start with a read-only root filesystem.
{{ hardened_security_context(non_root=true) }}
          volumeMounts:
            - name: authelia-secrets
              mountPath: /secrets
              readOnly: true
{% if authelia_k8s_manage_oidc | bool %}
            - name: authelia-oidc-jwk
              mountPath: /oidc-jwk
              readOnly: true
{% endif %}
            - name: authelia-config
              mountPath: /config
            - name: authelia-tmp
              mountPath: /tmp
            - name: authelia-logs
              mountPath: /var/log/authelia
{{ container_resources(cpu_limit=authelia_k8s_cpu_limit, mem_limit=authelia_k8s_mem_limit, cpu_request=authelia_k8s_cpu_request, mem_request=authelia_k8s_mem_request) }}
{% endif %}
{% if authelia_k8s_redis_sessions | bool %}
        # LAST, after CrowdSec's three seeding steps and the TOTP seed. Those write a local
        # emptyDir or the claim and need no network, so running them first overlaps their work
        # with the policy lag this container waits out, and it leaves the documented hub →
        # config → data ordering untouched.
        #
        # Authelia writes a startup probe to the session backend, retries it 19 times at 500ms
        # and then EXITS (internal/session/provider.go, StartupCheck at v4.39.21) — about 9.5s
        # of tolerance. The failure is not an image pull: the pod log names an `i/o timeout`,
        # not `connection refused`, so packets are DROPPED. kube-router's source-pod lookup lags
        # pod creation, and it recurs whenever the redis pod is recreated on a node (an eviction,
        # a node reboot, a Renovate bump of authelia_k8s_redis_image). Each occurrence takes SSO
        # down under Recreate, including the tools to fix it.
        #
        # `redis-cli`, not `nc -z`: the sibling gates in crowdsec and n8n use busybox's `nc`
        # because their images are busybox-based, which redis:7.4-alpine is not, and under
        # Recreate an init container that fails on a missing applet is an SSO outage rather
        # than a retry. This role already wires REDISCLI_AUTH for the probes in
        # deployment-redis.yaml.j2. Gate on PONG in the OUTPUT rather than on the exit code:
        # redis-cli exits 0 on a NOAUTH reply.
        #
        # Bounded, not unbounded — 60 x 2s, the same shape as crowdsec's wait-for-lapi. If redis
        # is still unreachable after two minutes this fails and the pod backs off, so it never
        # masks a dead redis.
        - name: wait-for-redis
          image: {{ authelia_k8s_redis_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
            - >-
              i=0;
              until redis-cli -h authelia-redis -p 6379 ping 2>/dev/null | grep -q PONG; do
                i=$((i+1));
                [ "$i" -ge 60 ] && echo "authelia-redis still unreachable after 120s" >&2 && exit 1;
                sleep 2;
              done;
              echo "authelia-redis reachable after $((i*2))s"
          env:
            # redis-cli takes the password from the environment, so it never reaches argv.
            - name: REDISCLI_AUTH
              valueFrom:
                secretKeyRef:
                  name: authelia-redis
                  key: REDISCLI_AUTH
          # read_only: the whole program is the shell loop above and it writes nothing. non_root
          # rather than leaning on the pod-level runAsUser, so the container carries its own
          # assertion — tests/k8s/workloads/test_container_security_context.py requires one here.
{{ hardened_security_context(read_only=true, non_root=true) }}
{{ container_resources(cpu_limit='100m', mem_limit='32Mi', cpu_request='10m', mem_request='16Mi') }}
{% endif %}
      containers:
        - name: authelia
          image: {{ authelia_k8s_image }}
          imagePullPolicy: IfNotPresent
          args:
            - --config
            - /secrets/configuration.yml
          ports:
            - name: http
              containerPort: {{ container_item.port }}
          env:
            - name: TZ
              value: "{{ tz }}"
{% if authelia_k8s_manage_oidc | bool %}
            # Runs Go templating over the config so `jwks[].key` can read the signing key; gated
            # with the mount and Secret.
            - name: X_AUTHELIA_CONFIG_FILTERS
              value: template
{% endif %}
          # NO readOnlyRootFilesystem: with it on, Authelia dies during provider construction,
          # before any startup check, and logs only "Errors occurred performing startup checks" at
          # every level.
{{ hardened_security_context(non_root=true) }}
          volumeMounts:
            # Mounted OUTSIDE /config so the PVC can own /config for the database.
            - name: authelia-secrets
              mountPath: /secrets
              readOnly: true
{% if authelia_k8s_manage_oidc | bool %}
            - name: authelia-oidc-jwk
              mountPath: /oidc-jwk
              readOnly: true
{% endif %}
            - name: authelia-config
              mountPath: /config
            - name: authelia-tmp
              mountPath: /tmp
            # Shared with the crowdsec-agent sidecar below.
            - name: authelia-logs
              mountPath: /var/log/authelia
          readinessProbe:
            httpGet:
              path: /api/health
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /api/health
              port: http
            initialDelaySeconds: 20
            periodSeconds: 30
{{ container_resources(cpu_limit=authelia_k8s_cpu_limit, mem_limit=authelia_k8s_mem_limit, cpu_request=authelia_k8s_cpu_request, mem_request=authelia_k8s_mem_request) }}
{% if authelia_k8s_manage_crowdsec %}
{{ crowdsec_agent_sidecar('authelia', collections=authelia_k8s_agent_collections, log_volume='authelia-logs', log_dir='/var/log/authelia', cpu_limit=authelia_k8s_agent_cpu_limit, mem_limit=authelia_k8s_agent_mem_limit, cpu_request=authelia_k8s_agent_cpu_request, mem_request=authelia_k8s_agent_mem_request) }}
{% endif %}
      volumes:
        - name: authelia-secrets
          secret:
            secretName: authelia-config
            # 0440, not 0400: secret files are owned root:fsGroup and a non-root container reads
            # them via the group bit.
            defaultMode: 0440
{% if authelia_k8s_manage_oidc | bool %}
        - name: authelia-oidc-jwk
          secret:
            secretName: authelia-oidc-jwk
            # 0440 for the reason authelia-secrets above gives.
            defaultMode: 0440
{% endif %}
        - name: authelia-config
          persistentVolumeClaim:
            claimName: authelia-config
        - name: authelia-tmp
          emptyDir: {}
        - name: authelia-logs
          emptyDir:
            sizeLimit: {{ authelia_k8s_log_size }}
{% if authelia_k8s_manage_crowdsec %}
{{ crowdsec_agent_volumes('authelia') }}
{% endif %}
