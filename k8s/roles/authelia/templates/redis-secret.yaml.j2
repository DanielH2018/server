---
# A change to this file moves `checksum/restart` on authelia-redis, rolling redis and logging
# everyone out once.
apiVersion: v1
kind: Secret
metadata:
  name: authelia-redis
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  REDISCLI_AUTH: "{{ authelia_redis_password }}"
  redis.conf: |
    requirepass {{ authelia_redis_password }}
    # `save ''` and appendonly are both named so an image default cannot turn persistence on;
    # session credentials never reach a disk.
    save ''
    appendonly no
    # Below the container limit so redis evicts the oldest sessions rather than being OOM-killed.
    maxmemory {{ authelia_k8s_redis_maxmemory }}
    maxmemory-policy allkeys-lru
