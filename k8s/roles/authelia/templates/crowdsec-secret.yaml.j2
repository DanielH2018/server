---
apiVersion: v1
kind: Secret
metadata:
  name: authelia-crowdsec
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  AGENT_PASSWORD: "{{ crowdsec_k8s_agent_password }}"
  acquis.yaml: |
    filenames:
      - /var/log/authelia/authelia.log
    labels:
      type: authelia
  whitelist.yaml: |
    {{ lookup('file', role_file('files/crowdsec-whitelist.yaml', role='crowdsec')) | indent(4) }}
  trusted-remote-whitelist.yaml: |
    {{ lookup('file', role_file('files/crowdsec-trusted-remote-whitelist.yaml', role='crowdsec')) | indent(4) }}
  authenticated-app-whitelist.yaml: |
    {{ lookup('file', role_file('files/crowdsec-authenticated-app-whitelist.yaml', role='crowdsec')) | indent(4) }}
