---
# Its own Secret: the PEM is multi-line and Flux strips newlines from substituted values, so it
# ships as a SOPS-encrypted manifest. `manifests_files` lists it behind authelia_k8s_manage_oidc; an
# unlisted template never renders.
apiVersion: v1
kind: Secret
metadata:
  name: authelia-oidc-jwk
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  key.pem: {{ authelia_oidc_rsa_key_content | to_json }}
