{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
# Nothing else talks to it. Keep this pod off every ConfigMap and Secret of the portal's:
# each one it named would roll the session store and log everyone out on a portal config change.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: authelia-redis
  namespace: {{ k8s_namespace }}
spec:
  # Recreate: two redis pods would each hold an empty store behind one Service.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: authelia-redis
  template:
    metadata:
      labels:
        app: authelia-redis
        netpol-baseline: enforced
    spec:
      # Pinned to the node announcing the VIPs; the DECIDED marker in home-assistant's
      # deployment.yaml.j2 has why.
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_primary_node }}
{{ pod_shell(services | tier_priority_class('authelia')) }}
      containers:
        - name: redis
          image: {{ authelia_k8s_redis_image }}
          imagePullPolicy: IfNotPresent
          # The password reaches redis through the config file, never argv, where `ps` and
          # `kubectl describe` show it.
          command:
            - redis-server
            - /etc/redis/redis.conf
          ports:
            - containerPort: 6379
          # 6379 is the containerPort, the Service port AND the NetworkPolicy port. All three
          # must agree; tests/services/authelia/test_authelia_redis_sessions.py pins that.
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=999, run_as_group=1000) }}
          env:
            # REDISCLI_AUTH keeps the password out of the probes' argv.
            - name: REDISCLI_AUTH
              valueFrom:
                secretKeyRef:
                  name: authelia-redis
                  key: REDISCLI_AUTH
          volumeMounts:
            - name: redis-config
              mountPath: /etc/redis
              readOnly: true
            - name: redis-data
              mountPath: /data
          readinessProbe:
            exec:
              command: ['redis-cli', 'ping']
            initialDelaySeconds: 2
            periodSeconds: 10
          livenessProbe:
            exec:
              command: ['redis-cli', 'ping']
            initialDelaySeconds: 15
            periodSeconds: 30
{{ container_resources(cpu_limit=authelia_k8s_redis_cpu_limit, mem_limit=authelia_k8s_redis_mem_limit, cpu_request=authelia_k8s_redis_cpu_request, mem_request=authelia_k8s_redis_mem_request) }}
      volumes:
        - name: redis-config
          secret:
            secretName: authelia-redis
            items:
              - key: redis.conf
                path: redis.conf
        # Deliberately NOT a PVC: sessions are a cache, and a Longhorn volume would be a backed-up
        # disk of live session credentials.
        - name: redis-data
          emptyDir: {}
