---
# The exporter's modules, carried from files/blackbox.yml with its domain placeholder replaced.
#
# Rendering it here puts it inside the manifests the shared rollout gate hashes, so an edit to
# a module rolls the pod without this role needing its own `checksum/` pod annotation.
apiVersion: v1
kind: ConfigMap
metadata:
  name: blackbox-exporter
  namespace: {{ k8s_namespace }}
data:
  blackbox.yml: |
{{ lookup('file', role_file('files/blackbox.yml')) | replace('__DOMAIN__', domain) | indent(4, true) }}
