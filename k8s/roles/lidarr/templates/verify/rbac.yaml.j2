{#
  The `lidarr-verify` Jobs' identity, rendered beside `notification.yaml.j2`.

  It is a ServiceAccount with no Role. The seed Job reads lidarr's API over the pod network and
  execs into no pod, so it needs no Kubernetes grant, and its pod mounts no token.
#}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: lidarr-verify
  namespace: {{ k8s_namespace }}
automountServiceAccountToken: false
