{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
# A NUT network client reading upsd anonymously, so no secret and no upsd.users entry.
# A SEPARATE Deployment: the nut pod is privileged, Recreate and pinned, and a sidecar would restart
# the shutdown chain on every exporter bump.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nut-exporter
  namespace: {{ k8s_namespace }}
spec:
{{ spec_shell('RollingUpdate') }}
  replicas: 1
  selector:
    matchLabels:
      app: nut-exporter
  template:
    metadata:
      labels:
        app: nut-exporter
        netpol-baseline: enforced
    spec:
      # Metrics, not power protection — the UPS keeps working when this pod does not.
{{ pod_shell('homelab-best-effort', run_as_user=puid, run_as_group=pgid, non_root=true) }}
      # Reaching upsd costs one ClusterIP hop from either node, so neither placement is privileged here.
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: nut-exporter
          image: {{ nut_exporter_k8s_image }}
          imagePullPolicy: IfNotPresent
          args:
            - --nut.server=nut.{{ k8s_namespace }}.svc.cluster.local
            - --nut.serverport=3493
            - --nut.vars_enable={{ nut_exporter_k8s_variables | join(',') }}
            - --web.listen-address=:{{ services | metrics_port('nut') }}
{{ hardened_security_context(read_only=true, non_root=true) }}
          env:
            - name: TZ
              value: "{{ tz }}"
          ports:
            - name: metrics
              containerPort: {{ services | metrics_port('nut') }}
          # tcpSocket: not /ups_metrics (fails whenever upsd is unreachable, so it would crash-loop
          # this pod on every nut restart), and not /metrics (tests/k8s/_scrape_property_rows.py
          # refuses an httpGet on a metrics route below a 300s period).
          livenessProbe:
            tcpSocket:
              port: {{ services | metrics_port('nut') }}
            initialDelaySeconds: 10
            periodSeconds: 30
            failureThreshold: 3
          readinessProbe:
            tcpSocket:
              port: {{ services | metrics_port('nut') }}
            initialDelaySeconds: 3
            periodSeconds: 10
{{ container_resources(cpu_limit=nut_exporter_k8s_cpu_limit, mem_limit=nut_exporter_k8s_mem_limit, cpu_request=nut_exporter_k8s_cpu_request, mem_request=nut_exporter_k8s_mem_request) }}
