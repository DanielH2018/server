{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nut
  namespace: {{ k8s_namespace }}
spec:
  # Recreate: the USB device and loopback hostPort are node-exclusive.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: nut
  template:
    metadata:
      labels:
        app: nut
        netpol-baseline: enforced
    spec:
      # Physical pin (USB UPS), not a preference: it does NOT unwind with the drain's L2/VIP pins.
      nodeSelector:
        kubernetes.io/hostname: daniel-server
{{ pod_shell(services | tier_priority_class('nut')) }}
      containers:
        - name: nut
          image: {{ nut_k8s_image }}
{# Pulls `Always`: the in-cluster registry's tags are mutable, so a node's cached copy can be stale.
   A Jinja comment, so an edit never changes nut's render. #}
          imagePullPolicy: Always
          ports:
            - containerPort: 3493
              # Loopback publish for the HOST's secondary upsmon, which runs the real
              # `systemctl poweroff`.
              hostIP: 127.0.0.1
              hostPort: 3493
          securityContext:
            # privileged: k8s has no `devices:` whitelist, so a hostPath'd USB node is refused by a
            # non-privileged pod's cgroup.
            # Containment: own built image, pinned node, loopback hostPort only.
            privileged: true
          env:
            - name: TZ
              value: "{{ tz }}"
          volumeMounts:
            - name: nut-config
              mountPath: /nut-config
              readOnly: true
            - name: nut-usb
              mountPath: /dev/bus/usb
          livenessProbe:
            exec:
              command:
                - /bin/sh
                - -c
                - upsc {{ nut_ups_name | default('apc-ups') }}@localhost battery.charge
            initialDelaySeconds: 30
            periodSeconds: 30
          # upsd binds 3493 only after enumerating the USB UPS; without this peanut and HA get
          # connection-refused on every deploy.
          readinessProbe:
            tcpSocket:
              port: 3493
            initialDelaySeconds: 5
            periodSeconds: 10
            failureThreshold: 3
{{ container_resources(cpu_limit=nut_k8s_cpu_limit, mem_limit=nut_k8s_mem_limit, cpu_request=nut_k8s_cpu_request, mem_request=nut_k8s_mem_request) }}
      volumes:
        - name: nut-config
          secret:
            secretName: nut-config
        - name: nut-usb
          hostPath:
            path: /dev/bus/usb
