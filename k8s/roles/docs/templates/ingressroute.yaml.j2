{% from 'ingressroute.yml.j2' import ingressroute with context %}
{# Public as well as LAN. The gate covers EVERY path: one route on the Host rule and an empty
   `bypass_prefixes`, so /healthz and /build-info.json sit behind Authelia too.
   A bypass prefix would put an unauthenticated endpoint on the internet; the readiness probe dials
   the pod directly, so none is needed. #}
---
{{ ingressroute(
    container_item.name,
    container_item.hostname | default(container_item.name),
    container_item.port,
    container_item.use_authelia,
  )
}}
