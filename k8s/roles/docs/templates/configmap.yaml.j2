---
apiVersion: v1
kind: ConfigMap
metadata:
  name: docs-nginx
  namespace: {{ k8s_namespace }}
data:
  default.conf: |
    server {
        listen {{ container_item.port }};
        server_name _;
        root /usr/share/nginx/html;
        index index.html;

        # Every response revalidates: the site's files carry no content hash, so with only
        # Last-Modified and ETag a browser caches heuristically for hours.
        # `no-cache` is revalidate-before-use, not no-store: an unchanged file still answers 304.
        add_header Cache-Control "no-cache";

        # Answered from nginx itself: an unbuilt site leaves the tree empty, and the pod must still
        # pass its probes and serve a 404.
        location = /healthz {
            access_log off;
            add_header Content-Type text/plain;
            return 200 'ok';
        }

        # nginx's add_header does not merge across levels: a location declaring any replaces every
        # inherited one, so this block restates Cache-Control.
        # The build stamp shows the docs-refresh cron is alive, so a cached copy would report a dead
        # cron as healthy: `no-store`, not `no-cache`.
        location = /build-info.json {
            add_header Cache-Control "no-store";
        }

        # `use_directory_urls: true` emits page/index.html; try_files keeps a missing page a 404,
        # not a directory listing.
        location / {
            try_files $uri $uri/ $uri/index.html =404;
        }
    }
