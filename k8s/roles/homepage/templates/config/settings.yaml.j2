---
title: My Awesome Homepage
theme: dark
color: slate
headerStyle: clean
showStats: false
target: _blank
# A group declared in services.yaml but omitted here renders below the laid-out ones, one column
# wide.
layout:
  Top Row:
    style: row
    columns: 2
    header: false
    # THREE columns, and the number is derived from the tile count rather than chosen. Services
    # holds fifteen tiles, which divides by three exactly: five full rows, no orphan on the last
    # one and no hole beside it. See the calendar height in custom.css.j2, which is derived from
    # that row count so the two Top Row columns end level.
    #
    # Keep this in step with the tile count: a sixteenth tile both reintroduces the orphan and
    # leaves the calendar column short. Add three at a time, or re-derive the calendar height
    # alongside.
    Services:
      style: row
      columns: 3
    # FIVE columns because the links sit under the calendar (`#my-calendar { grid-column: 1 / -1 }`
    # in custom.css.j2).
    # `style: row` is load-bearing: `column` renders flex-col, where grid-template-columns does
    # nothing.
    Calendar:
      style: row
      columns: 5
    # Do not put `Bookmarks:` here: a bookmark group cannot live inside `Top Row`; use a SERVICE
    # tile in `Calendar`.
  Admin & Tools:
    style: row
    columns: 4
  # No `Bookmarks:` entry: the personal links are SERVICE tiles in the `Calendar` group.
  # quicklaunch: searchDescriptions also matches the `description:` line.
quicklaunch:
  searchDescriptions: true
  hideInternetSearch: false
  hideVisitURL: false
providers:
  openweathermap: {{ weather_api_key }}
  # The longhorn widget reads its URL from here: a `url:` in widgets.yaml is ignored
  # (`Missing Longhorn URL`).
  longhorn:
    url: http://longhorn-frontend.longhorn-system.svc.cluster.local
