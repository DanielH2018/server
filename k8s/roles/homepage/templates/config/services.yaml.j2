

{#
  The sole services.yaml for Homepage — edit tiles and widgets here and nowhere else. The
  tiles carry no `server:`/`container:` pairs (see docker.yaml.j2 in this role for why).

  DECIDED: the tiles stay hand-placed here, and a services entry supplies only its
  link and its ClusterIP widget URL. Tile order is the page order, and it is measured:
  the Services column's row count sets the calendar height in custom.css.j2, and the
  operator ordered the personal links by hand. Deriving tiles from entries would put that
  order in services, where position means nothing. So a tile's icon, description and
  widget body stay here, and an entry with no tile needs no opt-out key.

  A tile links through `services | homepage_href(<entry>, domain)`, built from the
  entry's `hostname`. A widget dialling a ClusterIP gets its URL only from
  `services | homepage_widget_url(<entry>, k8s_namespace)`. That filter refuses an
  entry without `homepage_widget: true`, and the same key adds homepage to the entry's
  NetworkPolicy callers (scripts/renderer/template_filters/homepage_tiles.py), so the URL and the edge
  cannot disagree.
#}
- Top Row:
    - Services:
        - Headlamp:
            icon: kubernetes.png
            href: {{ services | homepage_href('headlamp', domain) }}
            description: Cluster UI
            # podSelector, not `app:`: homepage's `app:` expands to app.kubernetes.io/name=<value>;
            # pods here use plain `app`.
            namespace: {{ k8s_namespace }}
            podSelector: app=headlamp
            # The widget reads PROMETHEUS, NOT HEADLAMP, and that is the whole design decision.
            # Headlamp has no service API of its own — its backend only proxies the Kubernetes
            # API — so the only "Headlamp widget" would be homepage dialling headlamp's
            # ClusterIP. That is exactly the exposure k8s/roles/headlamp/templates/networkpolicy.yaml.j2
            # closes: the pod runs `-unsafe-use-service-account-token`, so anything that reaches
            # it acts as a cluster-wide reader with no auth, and netpol-probe-job.yaml.j2
            # re-asserts on every deploy that no non-traefik pod can. Admitting homepage there
            # would widen that fence and invalidate the probe. Prometheus gives the same numbers
            # with none of that, so the tile shows CLUSTER STATE and links to Headlamp to act on
            # it. Query and its shape: homepage_k8s_headlamp_cluster_query in defaults/main.yml.
            #
            # ClusterIP, not the `prometheus.local.{{ domain }}` Traefik route: monitor-bridge
            # and homelab-mcp already read prometheus this way, and that route's ClientIP list
            # is written for callers that cannot reach the ClusterIP. Cross-namespace, so
            # `prometheus-callers` (k8s/roles/netpol-baseline/templates/networkpolicy-prometheus.yaml.j2)
            # must name homepage — fenced out, this fails as a widget-proxy error that reads
            # nothing like a NetworkPolicy problem.
            # DECIDED: hand-written, not homepage_widget_url. Prometheus is in another
            # namespace, and its bespoke fence names homepage itself (see above).
            widget:
                type: customapi
                url: "http://prometheus.{{ k8s_observability_namespace }}.svc.cluster.local:9090/api/v1/query?query={{ homepage_k8s_headlamp_cluster_query | urlencode }}"
                # 60s: a Prometheus query per dashboard load per browser.
                refreshInterval: 60000
                # DECIDED: `display: block` (homepage's default), not `dynamic-list` — every
                # other widget on this dashboard renders as blocks, and a list tile reads as a
                # different kind of thing. The cost is that block mode pairs a value to a label
                # by ARRAY POSITION, so the indices below depend on the `or` operand order in
                # homepage_k8s_headlamp_cluster_query. Accepted because a reordering shows up as
                # "97 NODES" — wrong at a glance rather than plausibly wrong. Keep the
                # query's operand order and this list in the same order; changing one alone is
                # the only way to break this quietly. ENFORCED by
                # tests/services/homepage/test_headlamp_widget_mapping_order.py, which fails on a
                # reordered, renamed, missing or duplicated counter.
                #
                # Prometheus wraps its vector as {"data": {"result": [{"metric": {...},
                # "value": [<ts>, "<n>"]}, …]}} — hence `data.result.<n>.value.1` for each number.
                mappings:
                    - field: data.result.0.value.1
                      label: Up
                      format: number
                    - field: data.result.1.value.1
                      label: Down
                      format: number
        - Karma:
            # /icons/, not the CDN: dashboard-icons has no entry for it.
            icon: /icons/karma.png
            # Links the public name; the authelia `karma.<domain>` rules admit `group:admins` only.
            href: {{ services | homepage_href('karma', domain) }}
            description: Alerts
            # Asks Karma, not Prometheus: the Loki ruler's alerts reach Alertmanager alone. Each
            # request repeats Karma's `filters.default`, which its browser UI applies and its API
            # does not; test_homepage_karma_tile.py holds the two lists equal. One widget per
            # severity, because a customapi widget makes one request.
            widgets:
{% for severity in ['critical', 'warning'] %}
                - type: customapi
                  url: {{ services | homepage_widget_url('karma', k8s_namespace) }}/alerts.json
                  method: POST
                  headers:
                      Content-Type: application/json
                      Remote-User: homepage
                  requestBody:
                      filters: ["@state=active", "@receiver!=blackhole", "@receiver!=email", "severity={{ severity }}"]
                      defaultGroupLimit: 1
                  refreshInterval: 60000
                  mappings:
                      - field: totalAlerts
                        label: {{ severity | capitalize }}
                        format: number
{% endfor %}
        - Pihole:
            icon: pi-hole.png
            href: {{ services | homepage_href('pihole', domain, '/admin') }}
            description: DNS Ad Blocker
            widget:
                type: pihole
                # DECIDED: hand-written, not homepage_widget_url. pihole's fence is bespoke
                # (networkpolicy-pihole.yaml.j2 names homepage), and `homepage_widget` on its
                # entry would make the callers loop render a second `pihole` policy.
                url: http://pihole:80
                version: 6
                key: {{ pihole_password }}
                # Dropped: blocked_percent, gravity.
                fields: [queries, blocked]
        - Home Assistant:
            icon: home-assistant.png
            href: {{ services | homepage_href('home-assistant', domain) }}
            description: Air Quality
            widget:
                type: homeassistant
                url: https://home-assistant.local.{{ domain }}
                key: {{ homepage_ha_token }}
                custom:
                    - state: sensor.bedroom_airgradient_one_carbon_dioxide
                      label: CO₂
                    - state: sensor.bedroom_airgradient_one_voc_index
                      label: VOC
        - Karakeep:
            icon: karakeep.png
            href: {{ services | homepage_href('karakeep', domain) }}
            description: Karakeep
            # -k8s monitoring route: the native route's Authelia 401s the widget.
            widget:
                type: karakeep
                url: https://karakeep.local.{{ domain }}
                key: {{ karakeep_homepage_api_key }}
                # karakeep has no unarchived count and no widget can subtract, so both numBookmarks
                # and numArchived are shown.
                fields: [bookmarks, archived]
        - FreshRSS:
            icon: freshrss.png
            href: {{ services | homepage_href('freshrss', domain) }}
            description: RSS Aggregator
            # -k8s monitoring route: the native route's Authelia 401s the widget.
            widget:
                type: freshrss
                url: https://freshrss.local.{{ domain }}
                username: {{ freshrss_username }}
                password: {{ freshrss_password }}
                # Dropped: subscriptions. This is the only single-stat tile on the dashboard.
                fields: [unread]
        - UPS:
            icon: apc.png
            href: {{ services | homepage_href('peanut', domain) }}
            description: APC BR1500MS2
            widget:
                type: peanut
                # Monitoring route (ClientIP-gated, no Authelia); peanut's own basic auth is the
                # gate.
                url: https://peanut.local.{{ domain }}
                key: {{ nut_ups_name | default('apc-ups') }}
                username: {{ peanut_username }}
                password: {{ peanut_password }}
                # peanut names these `battery_charge` and `ups_status`.
                fields: [battery_charge, ups_status]
        - Scrutiny:
            icon: scrutiny.png
            href: {{ services | homepage_href('scrutiny', domain) }}
            description: Disk Health
            # ClusterIP, not a Traefik route: scrutiny's native route is Authelia-gated and 401s
            # this session-less widget.
            widget:
                type: scrutiny
                url: {{ services | homepage_widget_url('scrutiny', k8s_namespace) }}
                # Dropped: unknown.
                fields: [passed, failed]
        - Speedtest:
            icon: speedtest-tracker.png
            href: {{ services | homepage_href('speedtest', domain) }}
            description: Internet tracking
            # -k8s name is the ClientIP-gated monitoring route; the native route's Authelia 401s
            # this session-less widget.
            widget:
                type: speedtest
                url: https://speedtest.local.{{ domain }}
                # Dropped: upload.
                fields: [download, ping]
        # ClusterIP addressed directly, on purpose (do not normalise): the *arr monitoring routes
        # expose only /api/v3/queue.
        - Lidarr:
            icon: lidarr.png
            href: {{ services | homepage_href('lidarr', domain) }}
            description: Music
            widget:
                type: lidarr
                url: {{ services | homepage_widget_url('lidarr', k8s_namespace) }}
                key: {{ lidarr_api_key }}
                # Dropped: artists.
                fields: [wanted, queued]
        - Radarr:
            icon: radarr.png
            href: {{ services | homepage_href('radarr', domain) }}
            description: Movie
            widget:
                type: radarr
                url: {{ services | homepage_widget_url('radarr', k8s_namespace) }}
                key: {{ radarr_api_key }}
                # Dropped: movies, missing.
                fields: [wanted, queued]
        - Sonarr:
            icon: sonarr.png
            href: {{ services | homepage_href('sonarr', domain) }}
            # One word: at 1280px "Download management" wraps to three lines and overshoots the
            # pinned calendar by 16px; all three are shortened together.
            description: Series
            widget:
                type: sonarr
                url: {{ services | homepage_widget_url('sonarr', k8s_namespace) }}
                key: {{ sonarr_api_key }}
                # Dropped: series.
                fields: [wanted, queued]
        - qBittorrent:
            icon: qbittorrent.png
            href: {{ services | homepage_href('qbittorrent', domain) }}
            description: Download
            widget:
                type: qbittorrent
                url: {{ services | homepage_widget_url('qbittorrent', k8s_namespace) }}
                username: {{ qbittorrent_username }}
                password: {{ qbittorrent_password }}
                # Dropped: seed, upload.
                fields: [leech, download]
        - slskd:
            icon: slskd.png
            href: {{ services | homepage_href('slskd', domain) }}
            description: Soulseek
            widget:
                type: slskd
                url: {{ services | homepage_widget_url('slskd', k8s_namespace) }}
                # A placeholder: SLSKD_NO_AUTH accepts any key, but the widget sends one on every
                # call.
                key: slskd-runs-without-auth
                # Dropped: updateStatus, uploads, and downloads, which counts every user in the
                # transfer history rather than what is transferring.
                fields: [slskStatus, sharedFiles]
        # Read from Prometheus: navidrome's own widget sends a Subsonic token in the query string,
        # which proxy.js logs on non-2xx.
        - Navidrome:
            icon: navidrome.png
            href: {{ services | homepage_href('navidrome', domain) }}
            description: Listen
            widget:
                type: prometheusmetric
                url: "http://prometheus.{{ k8s_observability_namespace }}.svc.cluster.local:9090"
                refreshInterval: 300000
                metrics:
                    - label: Artists
                      query: 'db_model_totals{job="navidrome",model="artist"}'
                      format:
                          type: number
                    - label: Albums
                      query: 'db_model_totals{job="navidrome",model="album"}'
                      format:
                          type: number
                    - label: Songs
                      query: 'db_model_totals{job="navidrome",model="media"}'
                      format:
                          type: number
    - Calendar:
        - Calendar:
            id: my-calendar
            href: https://calendar.google.com/calendar/u/0/r
            widget:
              type: calendar
              firstDayInWeek: sunday
              view: monthly
              maxEvents: 8
              showTime: true
              timezone: {{ tz }}
              integrations:
                - type: ical
                  url: {{ services | homepage_widget_url('ical-proxy', k8s_namespace) }}/calendar1.ics
                  name: Daniel
                  color: indigo
                  params:
                      showName: true
                - type: ical
                  url: {{ services | homepage_widget_url('ical-proxy', k8s_namespace) }}/calendar2.ics
                  name: Work
                  color: slate
                  params:
                      showName: true
                - type: ical
                  url: {{ calendar_3 }}
                  name: Holidays
                  color: purple
                  params:
                      showName: true
                - type: ical
                  url: {{ services | homepage_widget_url('ical-proxy', k8s_namespace) }}/calendar4.ics
                  name: Tasks
                  color: emerald
                  params:
                      showName: true
        # SERVICE tiles, not bookmarks: a bookmark group cannot be laid out inside `Top Row`. Order
        # here is the page order.
        - Gmail:
            icon: gmail.png
            href: https://mail.google.com/mail/u/0/#inbox
            description: mail.google.com
        - YouTube:
            icon: youtube.png
            href: https://www.youtube.com
            description: youtube.com
        - Reddit:
            icon: reddit.png
            href: https://old.reddit.com/
            description: old.reddit.com
        - Twitter:
            icon: twitter.png
            href: https://twitter.com/home
            description: twitter.com
        - Jellyfin:
            # Link-only: a widget added later needs `version: 2`
            # (docs/homepage-widgets-and-layout.md).
            icon: jellyfin.png
            href: {{ services | homepage_href('jellyfin', domain) }}
            # Not the bare domain: jellyfin.<domain> would overrun the 165px tile.
            description: Media server
        - GitHub:
            icon: github.png
            href: https://github.com/
            description: github.com
        - Google Maps:
            icon: google-maps.png
            href: https://www.google.com/maps
            description: maps.google.com
        - Monarch:
            # /icons/ is the homepage-icons ConfigMap; templates/icons-configmap.yaml.j2 must carry
            # any file named this way.
            icon: /icons/monarch.png
            href: https://app.monarch.com/dashboard
            # `monarch.com`, not `app.monarch.com`: the longer form needs 170px and clips a 165px
            # tile.
            description: monarch.com
        - AniList:
            # /icons/, not the CDN: dashboard-icons has no entry for it.
            icon: /icons/anilist.png
            href: https://anilist.co/
            description: anilist.co
        - Tactics.tools:
            icon: /icons/tacticstools.png
            href: https://tactics.tools/
            description: tactics.tools
        # custom.css.j2 excludes these from the icon-only rules by their `id:` prefix. The
        # `-#rrggbb`
        # suffix colours an `mdi-` icon.
        - Deploy:
            id: calendar-tool-deploy
            icon: mdi-rocket-launch-#fb923c
            # The queue page starts landings with land.sh, so Authelia two_factor gates both its
            # names.
            href: {{ services | homepage_href('deploy-ui', domain) }}
            description: Deploy queue
        - Artifacts:
            id: calendar-tool-artifacts
            icon: mdi-file-document-multiple-#38bdf8
            href: {{ services | homepage_href('artifacts', domain) }}
            description: Generated reports
        - Docs:
            id: calendar-tool-docs
            icon: mdi-book-open-variant-#34d399
            href: {{ services | homepage_href('docs', domain) }}
            description: Homelab reference

# Link-only on purpose: a widget needs `homepage_widget: true` to open the target's NetworkPolicy; a
# bare `href:` reaches nothing.
- Admin & Tools:
    - Grafana:
        icon: grafana.png
        href: {{ services | homepage_href('observability', domain) }}
        description: Metrics and dashboards
    - Longhorn:
        icon: longhorn.png
        # LAN-only: Authelia is the entire access control on a UI that can delete volumes and their
        # B2 backups.
        href: {{ services | homepage_href('longhorn-ui', domain, lan=true) }}
        description: Cluster storage
    - n8n:
        icon: n8n.png
        href: {{ services | homepage_href('n8n', domain) }}
        description: Workflow automation
    - code-server:
        icon: code-server.png
        href: {{ services | homepage_href('code-server', domain) }}
        description: Browser IDE
