---
apiVersion: v1
kind: ConfigMap
metadata:
  name: homepage-icons
  namespace: {{ k8s_namespace }}
binaryData:
{# Only referenced icons: each is base64'd into the object. These four have no dashboard-icons entry
   (404 at the CDN);
   CDN-served icons are referenced by bare name and must NOT be added. A listed name missing from
   files/ fails the RENDER. #}
{% for icon in ['anilist.png', 'karma.png', 'monarch.png', 'tft-assistant.svg'] %}
  {{ icon }}: {{ lookup('b64file', role_file('files/' ~ icon)) }}
{% endfor %}
