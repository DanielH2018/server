{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
{% from 'lsio-env.yml.j2' import lsio_env with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: homepage
  namespace: {{ k8s_namespace }}
spec:
{{ spec_shell('RollingUpdate') }}
  replicas: 1
  selector:
    matchLabels:
      app: homepage
  template:
    metadata:
      labels:
        app: homepage
        netpol-baseline: enforced
    spec:
      # Without the name the pod uses the `default` SA and every kubernetes widget renders empty,
      # not failing.
      # automount is explicit so an estate-wide automount=false sweep sees a deliberate value.
{{ pod_shell('homelab-best-effort', service_account='homepage', automount=true) }}
      # Copy-not-mount: homepage seeds its skeleton config into /app/config at startup and that set
      # grows with the image, so a read-only Secret mount crash-loops (EROFS). A writable emptyDir
      # seeded from the Secret keeps our files winning.
      initContainers:
        - name: seed-config
          image: {{ homepage_k8s_init_image }}
          imagePullPolicy: IfNotPresent
          command: ["sh", "-c", "cp -L /config-secret/* /config/"]
{{ hardened_security_context(read_only=true) }}
          volumeMounts:
            - name: homepage-config
              mountPath: /config-secret
              readOnly: true
            - name: homepage-config-live
              mountPath: /config
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: homepage
          image: {{ homepage_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{ container_item.port }}
          # docker-entrypoint.sh chowns /app/config to PUID/PGID, best-effort: it warns and
          # continues against the read-only mount.
{{ hardened_security_context(add=['CHOWN', 'SETUID', 'SETGID']) }}
          env:
{{ lsio_env() }}
            # Homepage rejects any Host header not listed: the public host, the .local host over
            # WireGuard, and both -k8s forms.
            - name: HOMEPAGE_ALLOWED_HOSTS
              value: >-
                homepage.{{ domain }},homepage.local.{{ domain }},homepage.{{ domain }},homepage.local.{{ domain }}
          volumeMounts:
            - name: homepage-config-live
              mountPath: /app/config
            # Bookmark icons (see icons-configmap.yaml.j2).
            - name: homepage-icons
              mountPath: /app/public/icons
              readOnly: true
          # Regenerate `/` once at startup: the image's build-time render has no settings, and
          # upstream re-renders only on a browser hash mismatch.
          # It NEVER exits non-zero (a failing postStart kills the container) and breaks on first
          # success.
          lifecycle:
            postStart:
              exec:
                command:
                  - sh
                  - -c
                  - >-
                    i=0;
                    while [ "$i" -lt 60 ]; do
                    wget -q -O /dev/null "http://127.0.0.1:{{ container_item.port }}/api/revalidate" && break;
                    i=$((i+1));
                    sleep 1;
                    done;
                    exit 0
          readinessProbe:
            httpGet:
              path: /api/healthcheck
              port: {{ container_item.port }}
              # kubelet probes carry the pod IP as Host, which HOMEPAGE_ALLOWED_HOSTS rejects (400):
              # pin an allowed Host.
              httpHeaders:
                - name: Host
                  value: "{{ container_item.hostname }}.local.{{ domain }}"
            initialDelaySeconds: 15
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /api/healthcheck
              port: {{ container_item.port }}
              # kubelet probes carry the pod IP as Host, which HOMEPAGE_ALLOWED_HOSTS rejects (400):
              # pin an allowed Host.
              httpHeaders:
                - name: Host
                  value: "{{ container_item.hostname }}.local.{{ domain }}"
            initialDelaySeconds: 30
            periodSeconds: 30
{{ container_resources(cpu_limit=homepage_k8s_cpu_limit, mem_limit=homepage_k8s_mem_limit, cpu_request=homepage_k8s_cpu_request, mem_request=homepage_k8s_mem_request) }}
      volumes:
        - name: homepage-config
          secret:
            secretName: homepage-config
        - name: homepage-config-live
          emptyDir: {}
        - name: homepage-icons
          configMap:
            name: homepage-icons
