---
apiVersion: v1
kind: Secret
metadata:
  name: homepage-config
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
{# Embedded from templates/config/ because the manifest validator parses every templates/*.j2 as a
   Kubernetes manifest. #}
  settings.yaml: |
{{ lookup('template', role_file('templates/config/settings.yaml.j2')) | indent(4, true) }}
  bookmarks.yaml: |
{{ lookup('template', role_file('templates/config/bookmarks.yaml.j2')) | indent(4, true) }}
  widgets.yaml: |
{{ lookup('template', role_file('templates/config/widgets.yaml.j2')) | indent(4, true) }}
  custom.css: |
{{ lookup('template', role_file('templates/config/custom.css.j2')) | indent(4, true) }}
  services.yaml: |
{{ lookup('template', role_file('templates/config/services.yaml.j2')) | indent(4, true) }}
  docker.yaml: |
{{ lookup('template', role_file('templates/config/docker.yaml.j2')) | indent(4, true) }}
  kubernetes.yaml: |
{{ lookup('template', role_file('templates/config/kubernetes.yaml.j2')) | indent(4, true) }}
  # homepage seeds any missing config file at startup, which EROFSes on this read-only mount and
  # crash-loops the pod; empty is valid.
  custom.js: ""
