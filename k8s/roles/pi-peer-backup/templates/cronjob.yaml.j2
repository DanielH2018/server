{% from 'container-resources.yml.j2' import job_container_resources with context %}
{% from 'security-context.yml.j2' import job_hardened_security_context with context %}
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: pi-peer-backup
  namespace: {{ k8s_namespace }}
spec:
  schedule: "{{ pi_peer_backup_k8s_schedule }}"
  # Same local wall-clock slot the daniel-server host cron held.
  timeZone: {{ tz }}
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 2
  jobTemplate:
    spec:
      backoffLimit: 1
      activeDeadlineSeconds: 600
      ttlSecondsAfterFinished: {{ pi_peer_backup_k8s_job_ttl_seconds }}
      template:
        metadata:
          labels:
            app: pi-peer-backup
        spec:
          restartPolicy: Never
          enableServiceLinks: false
          # The token is for the verdict-export PATCH only; the backup never calls the API.
          serviceAccountName: pi-peer-backup
          automountServiceAccountToken: true
          securityContext:
            runAsUser: {{ puid }}
            runAsGroup: {{ pgid }}
            fsGroup: {{ pgid }}
            fsGroupChangePolicy: OnRootMismatch
          priorityClassName: homelab-best-effort
          containers:
            - name: pi-peer-backup
              image: {{ pi_peer_backup_k8s_image }}
              # Mutable :latest tag, so always pull.
              imagePullPolicy: Always
              env:
                - name: PI_SRC
                  value: "{{ pi_peer_backup_ssh_user }}@{{ hosts['daniel-pi'].server_ip }}:{{ pi_peer_backup_src_dir }}"
                # No checksum annotation needed: each scheduled run is a fresh pod that reads the
                # Secret at start.
                - name: HC_PING_URL
                  valueFrom:
                    secretKeyRef:
                      name: pi-peer-backup-ssh
                      key: hc_ping_url
                - name: VERDICT_CONFIGMAP
                  value: "{{ pi_peer_backup_k8s_verdict_configmap }}"
                # ssh insists on resolving HOME even with every path given explicitly.
                - name: HOME
                  value: /tmp
{{ job_hardened_security_context(read_only=true, non_root=true) }}
              volumeMounts:
                - name: pi-peer-backup-data
                  mountPath: /data
                - name: pi-peer-backup-ssh
                  mountPath: /ssh
                  readOnly: true
                - name: pi-peer-backup-tmp
                  mountPath: /tmp
{{ job_container_resources(cpu_limit="500m", mem_limit="128Mi", cpu_request="10m", mem_request="16Mi") }}
          volumes:
            - name: pi-peer-backup-data
              persistentVolumeClaim:
                claimName: {{ pi_peer_backup_k8s_claim }}
            # Both Secrets mount at /ssh; the key has its own Secret since placeholders cannot carry
            # newlines.
            - name: pi-peer-backup-ssh
              projected:
                # Group-readable for the fsGroup; ssh refuses that identity, so the script stages a
                # 0400 copy.
                defaultMode: 0440
                sources:
                  - secret:
                      name: pi-peer-backup-ssh
                  - secret:
                      name: pi-peer-backup-ssh-key
            - name: pi-peer-backup-tmp
              emptyDir: {}
