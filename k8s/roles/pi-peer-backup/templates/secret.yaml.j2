---
# The Pi host key pin is committed, so the manifest renders from git alone. After a host key change
# ("host key differs from the committed pin"), re-pin by step 9 of docs/break-glass.md.
apiVersion: v1
kind: Secret
metadata:
  name: pi-peer-backup-ssh
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  known_hosts: "{{ hosts['daniel-pi'].server_ip }} {{ hosts['daniel-pi'].ssh_host_ed25519_key }}"
  # Bare slug, never ?create=1: a typo would auto-provision an unwatched check that reads green.
  # Rendered empty when healthchecks_ping_key is undefined; the script skips an empty URL.
{% if healthchecks_ping_key is defined %}
  hc_ping_url: "https://hc-ping.com/{{ healthchecks_ping_key }}/pi-peer-backup"
{% else %}
  hc_ping_url: ""
{% endif %}
