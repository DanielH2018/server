# DIGEST-PINNED — see k8s/roles/ical-proxy/templates/Dockerfile.j2 for why a version tag alone is
# not a pin. An alpine minor tag re-points at every patch within it, so the tag reads pinned while
# the base moves. Keep the tag alongside the digest — it BOUNDS the digest bumps Renovate raises,
# so one cannot silently cross a minor. Crossing a minor is therefore a deliberate operator
# decision (a tag-change PR). A merged bump moves the content tag, and promote's `images` job
# builds it.
#
# The version is deliberately NOT named here — a comment that quotes the line it guards is
# falsified by the next bump.
FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

# DECIDED: apk packages resolve at build time — an `=version` pin 404s once the branch
# supersedes it and nothing bumps it; the base digest is the pin.
RUN apk add --no-cache bash rsync openssh-client curl
# ssh refuses a uid with no passwd entry, so give the pod's uid a name.
RUN adduser -D -u {{ puid }} puller

# COPY . not per-file: the build context is a ConfigMap mount (symlink trap; see nut Dockerfile).
COPY . /build-context/
RUN install -m 0755 /build-context/pull-pi-peers.sh /usr/local/bin/pull-pi-peers.sh \
    && rm -rf /build-context

ENTRYPOINT ["/usr/local/bin/pull-pi-peers.sh"]
