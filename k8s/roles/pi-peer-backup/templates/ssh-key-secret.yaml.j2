---
# Flux strips newlines from substituted values, so a multi-line PEM ships as a SOPS-encrypted
# manifest named in `render_sops_manifests`; `to_json` writes it as one quoted scalar.
apiVersion: v1
kind: Secret
metadata:
  name: pi-peer-backup-ssh-key
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  id: {{ pi_peer_backup_ssh_key | to_json }}
