# Flux-managed (k8s/coredns, templates/config/coredns-corefile.j2). Do not edit in the cluster:
# Flux reverts a hand-edit at its next reconcile. k3s does not reconcile this ConfigMap
# (manifests/coredns.yaml.skip), so Flux is its only writer.
#
# k3s's bundled Corefile ends in `forward . /etc/resolv.conf`, which inherits whichever
# resolvers the node CoreDNS happens to land on, under forward's DEFAULT `random` policy.
# That makes Pi-hole a coin flip rather than a primary: about half of all queries bypass its
# blocking. The list below replaces both halves of that — Pi-hole first for every query, and no
# dependence on which node CoreDNS is scheduled to.
#
# Everything above the forward is k3s's bundled Corefile, reproduced verbatim. Keep it that
# way: `NodeHosts` is written into this ConfigMap by k3s's own node controller, which keeps
# running after the addon is skipped, and the two `import` lines are the documented
# customization seam.
.:53 {
    errors
    health
    ready
    kubernetes cluster.local in-addr.arpa ip6.arpa {
      pods insecure
      fallthrough in-addr.arpa ip6.arpa
    }
    hosts /etc/coredns/NodeHosts {
      ttl 60
      reload 15s
      fallthrough
    }
    prometheus :9153
    cache 30
    loop
    reload
    loadbalance
    import /etc/coredns/custom/*.override
    # The Pi-hole entry is the Service's CLUSTER IP, not the LAN VIP: externalTrafficPolicy: Local
    # blackholes VIP traffic.
    forward . {{ coredns_upstreams | join(' ') }} {
      policy sequential
      health_check {{ coredns_health_check }}
      max_fails {{ coredns_max_fails }}
    }
}
import /etc/coredns/custom/*.server
