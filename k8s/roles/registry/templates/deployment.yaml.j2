{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: registry
  namespace: {{ k8s_namespace }}
spec:
  # Recreate: the PVC is ReadWriteOnce and the hostPort is node-exclusive.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: registry
  template:
    metadata:
      labels:
        app: registry
        # The pinned `registry` Service selects on this label; the ghcr-mirror pod carries it too.
        registry-service: "true"
        # Opted out of the baseline, which is additive and looser than networkpolicy.yaml.j2.
        netpol-baseline-exempt: "true"
    spec:
      # Pinned: the hostPort and RWO PVC live on this node, and every registries.yaml mirror assumes
      # it.
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_registry_node }}
{{ pod_shell(services | tier_priority_class('registry'), run_as_user=1000, run_as_group=1000, fs_group=1000) }}
      containers:
        - name: registry
          image: {{ registry_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            # Named because the Service's targetPort names it; keeps the ghcr-mirror pod off this
            # port.
            - name: registry
              containerPort: {{ k8s_registry_port }}
              # Loopback only: without hostIP an unauthenticated plain-HTTP registry is writable
              # from the LAN.
              hostIP: {{ k8s_registry_host_ip }}
              hostPort: {{ k8s_registry_port }}
{{ hardened_security_context(read_only=true, non_root=true) }}
          env:
            # The baked-in `debug` logs a full OTEL span per request, with no OTLP endpoint to
            # receive it.
            - name: REGISTRY_LOG_LEVEL
              value: info
            - name: REGISTRY_STORAGE_FILESYSTEM_ROOTDIRECTORY
              value: /var/lib/registry
            # Without this a deleted tag leaves its blobs behind and the volume only grows.
            - name: REGISTRY_STORAGE_DELETE_ENABLED
              value: "true"
          volumeMounts:
            - name: registry-data
              mountPath: /var/lib/registry
          readinessProbe:
            httpGet:
              path: /v2/
              port: {{ k8s_registry_port }}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /v2/
              port: {{ k8s_registry_port }}
            initialDelaySeconds: 15
            periodSeconds: 30
{{ container_resources(cpu_limit='500m', mem_limit='512Mi', cpu_request='50m', mem_request='64Mi') }}
      volumes:
        - name: registry-data
          persistentVolumeClaim:
            claimName: {{ registry_k8s_claim }}
