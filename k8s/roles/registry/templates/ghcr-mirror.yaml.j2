{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
{% set resume_script = 'ghcr_resume_proxy.py' %}
{% set resume_data = {resume_script: lookup('file', role_file('files/' + resume_script), rstrip=False)} %}
{# Named for its content, so a script edit changes the pod template and rolls the mirror. #}
{% set resume_dial = ['python3', '-c', "import socket; socket.create_connection(('127.0.0.1', " ~ registry_k8s_ghcr_resume_port ~ "), 2).close()"] %}
{% set resume_configmap = 'ghcr-resume-' + (resume_data | to_json(sort_keys=True, separators=(',', ':')) | hash('sha256'))[:8] %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ resume_configmap }}
  namespace: {{ k8s_namespace }}
data:
{% for key, text in resume_data | dictsort %}
  {{ key }}: {{ text | to_json }}
{% endfor %}
---
# The pull-through mirror of ghcr.io. k3s's registries.yaml names it as the
# `ghcr.io` mirror, so containerd pulls a flux-owned GHCR image through it and a node keeps a LAN
# copy for a cold start during a WAN outage. nut is the reason: its pod is half of the UPS
# shutdown chain, and WAN outages arrive with power events.
#
# DECIDED: its own Deployment, not REGISTRY_PROXY_* on the push store and not a second container
# in its pod. A registry in proxy mode refuses every
# manifest Put and Delete (`proxyManifestStore` returns ErrUnsupported in distribution v3.1.2),
# which would break every image-builder push and registry-gc.sh's untag DELETEs. A sidecar would
# share the push store's pod, so the mirror's weekly GC would have to scale `deploy/registry` to
# zero, and with Flux rendering that Deployment's `replicas: 1` a second writer on that field
# restores the pod mid-GC. Its own Deployment gives the mirror a GC that scales only this one,
# and a mirror that cannot start does not take the push store's endpoint down. It keeps
# every consumer's address: the same loopback hostPort on the same node, and the same pinned
# ClusterIP through the shared Service in service.yaml.j2.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ghcr-mirror
  namespace: {{ k8s_namespace }}
spec:
  # Recreate: RWO claim and node-exclusive hostPort, so two registry processes never write the
  # store.
{{ spec_shell('Recreate') }}
  # No `replicas:`: a rendered field lets Flux restore the pod while registry-gc.sh holds it at
  # zero.
  selector:
    matchLabels:
      app: ghcr-mirror
  template:
    metadata:
      labels:
        app: ghcr-mirror
        registry-service: "true"
        netpol-baseline-exempt: "true"
    spec:
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_registry_node }}
{{ pod_shell(services | tier_priority_class('registry'), run_as_user=1000, run_as_group=1000, fs_group=1000) }}
      initContainers:
        # Pod-loopback upstream. Native sidecar: its startupProbe holds the mirror's start, because
        # distribution dials REGISTRY_PROXY_REMOTEURL once at start and panics if it is refused.
        - name: ghcr-resume
          image: {{ registry_k8s_ghcr_resume_image }}
          imagePullPolicy: IfNotPresent
          restartPolicy: Always
          command: ["python3", "/opt/ghcr-resume/{{ resume_script }}"]
{{ hardened_security_context(read_only=true, non_root=true) }}
          env:
            - name: LISTEN_HOST
              value: 127.0.0.1
            - name: LISTEN_PORT
              value: "{{ registry_k8s_ghcr_resume_port }}"
            - name: UPSTREAM
              value: https://ghcr.io
            - name: PYTHONUNBUFFERED
              value: "1"
          volumeMounts:
            - name: ghcr-resume
              mountPath: /opt/ghcr-resume
              readOnly: true
          # An exec probe: httpGet and tcpSocket dial the pod IP, and this binds 127.0.0.1.
          startupProbe:
            exec:
              command: {{ resume_dial | to_json }}
            periodSeconds: 1
            timeoutSeconds: 5
            failureThreshold: 60
          readinessProbe:
            exec:
              command: {{ resume_dial | to_json }}
            periodSeconds: 30
            timeoutSeconds: 5
{{ container_resources(cpu_limit='500m', mem_limit='128Mi', cpu_request='10m', mem_request='40Mi') }}
      containers:
        - name: ghcr-mirror
          image: {{ registry_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            # Named for the Service's targetPort, as the push store's port is.
            - name: ghcr-mirror
              containerPort: {{ k8s_registry_ghcr_mirror_port }}
              # Loopback only: without hostIP the pull-through cache is open to the LAN.
              hostIP: {{ k8s_registry_host_ip }}
              hostPort: {{ k8s_registry_ghcr_mirror_port }}
{{ hardened_security_context(read_only=true, non_root=true) }}
          env:
            - name: REGISTRY_LOG_LEVEL
              value: info
            - name: REGISTRY_HTTP_ADDR
              value: ":{{ k8s_registry_ghcr_mirror_port }}"
            # Loopback only: the baked config binds the debug server to :5001 on every address.
            - name: REGISTRY_HTTP_DEBUG_ADDR
              value: "127.0.0.1:{{ registry_k8s_ghcr_mirror_debug_port }}"
            - name: REGISTRY_STORAGE_FILESYSTEM_ROOTDIRECTORY
              value: /var/lib/registry
{# ghcr.io cuts blob transfers after ~8-10 minutes and distribution refetches from byte 0, so the
   remote is the ghcr-resume sidecar (Range resume). A Jinja comment, so editing it rolls nothing. #}
            - name: REGISTRY_PROXY_REMOTEURL
              value: "http://127.0.0.1:{{ registry_k8s_ghcr_resume_port }}"
            # Zero TTL never expires; the default 168h drops an image a week after its last rebuild.
            - name: REGISTRY_PROXY_TTL
              value: "0s"
          # Own claim, not registry-data: nothing expires mirrored images, so a shared volume would
          # fill.
          volumeMounts:
            - name: ghcr-mirror-data
              mountPath: /var/lib/registry
          # `/v2/` answers locally, so probes do not depend on ghcr.io being reachable in a WAN
          # outage.
          readinessProbe:
            httpGet:
              path: /v2/
              port: {{ k8s_registry_ghcr_mirror_port }}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /v2/
              port: {{ k8s_registry_ghcr_mirror_port }}
            initialDelaySeconds: 15
            periodSeconds: 30
{{ container_resources(cpu_limit='500m', mem_limit='256Mi', cpu_request='20m', mem_request='32Mi') }}
      volumes:
        - name: ghcr-mirror-data
          persistentVolumeClaim:
            claimName: {{ registry_k8s_ghcr_mirror_claim }}
        - name: ghcr-resume
          configMap:
            name: {{ resume_configmap }}
---
# Pull path only, from the two host sources networkpolicy.yaml.j2 admits; no pod-network rule, so a
# pod cannot fill the claim with arbitrary public images.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ghcr-mirror
  namespace: {{ k8s_namespace }}
spec:
  podSelector:
    matchLabels:
      app: ghcr-mirror
  policyTypes:
    - Ingress
  ingress:
    - from:
        - ipBlock:
            cidr: {{ registry_k8s_netpol_cni_gateway }}
        - ipBlock:
            cidr: {{ registry_k8s_netpol_agent_flannel }}
      ports:
        - protocol: TCP
          port: {{ k8s_registry_ghcr_mirror_port }}
