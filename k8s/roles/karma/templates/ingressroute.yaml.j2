{% from 'ingressroute.yml.j2' import ingressroute with context %}
---
{#
  `public=false`: Karma can create silences on every page, so it keeps to the LAN name. A public
  `karma.<domain>` would land on Authelia's `*.<domain>` two_factor wildcard, which carries no
  `group:admins` subject. The authelia role's hand-written karma.local pair is the other half
  of the control. No ClientIP fence: blackbox-exporter probes this route from a pod address.
#}
{{ ingressroute(
    container_item.name,
    container_item.hostname,
    container_item.port,
    container_item.use_authelia,
    public=false
  )
}}
