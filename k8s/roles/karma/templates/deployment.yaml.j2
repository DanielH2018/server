{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: karma
  namespace: {{ k8s_namespace }}
spec:
{{ spec_shell('RollingUpdate') }}
  replicas: 1
  selector:
    matchLabels:
      app: karma
  template:
    metadata:
      labels:
        app: karma
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-standard', run_as_user=karma_k8s_uid, run_as_group=karma_k8s_uid, fs_group=karma_k8s_uid) }}
      containers:
        - name: karma
          image: {{ karma_k8s_image }}
          imagePullPolicy: IfNotPresent
          env:
            - name: CONFIG_FILE
              value: /etc/karma/karma.yaml
          ports:
            - containerPort: {{ container_item.port }}
          volumeMounts:
            - name: karma-config
              mountPath: /etc/karma
              readOnly: true
{{ hardened_security_context(read_only=true, non_root=true) }}
          # /health bypasses karma's Remote-User header auth, which every other path requires.
          readinessProbe:
            httpGet:
              path: /health
              port: {{ container_item.port }}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: {{ container_item.port }}
            initialDelaySeconds: 15
            periodSeconds: 30
{{ container_resources(cpu_limit=karma_k8s_cpu_limit, mem_limit=karma_k8s_mem_limit, cpu_request=karma_k8s_cpu_request, mem_request=karma_k8s_mem_request) }}
      volumes:
        - name: karma-config
          configMap:
            name: karma-config
