{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: livesync
  namespace: {{ k8s_namespace }}
spec:
  # RWO PVC with one replica: a rolling update would deadlock on the volume.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: livesync
  template:
    metadata:
      labels:
        app: livesync
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-best-effort') }}
      initContainers:
        # local.d must be writable: CouchDB's entrypoint writes docker.ini there, so it is an
        # emptyDir copy.
        # Not a seeded volume, since that would freeze a stale docker.ini into the PVC.
        - name: seed-config
          image: {{ livesync_k8s_image }}
          imagePullPolicy: IfNotPresent
          command:
            - sh
            - -c
            - cp /config/local.ini /opt/couchdb/etc/local.d/local.ini
          volumeMounts:
            - name: livesync-config
              mountPath: /config
            - name: livesync-local-d
              mountPath: /opt/couchdb/etc/local.d
{{ hardened_security_context() }}
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: couchdb
          image: {{ livesync_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{ container_item.port }}
          # FOWNER is required: the entrypoint chmods the PVC's lost+found after its chown pass, and
          # without FOWNER that fails EPERM and `set -e` kills the container with nothing logged.
{{ hardened_security_context(add=['CHOWN', 'SETUID', 'SETGID', 'DAC_OVERRIDE', 'FOWNER']) }}
          env:
            - name: COUCHDB_USER
              value: admin
            - name: COUCHDB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: livesync
                  key: COUCHDB_PASSWORD
          volumeMounts:
            - name: livesync-data
              mountPath: /opt/couchdb/data
            - name: livesync-local-d
              mountPath: /opt/couchdb/etc/local.d
          # An exec probe: require_valid_user makes `/` and `/_up` answer 401, which httpGet counts
          # as failure.
          readinessProbe:
            exec:
              command:
                - sh
                - -c
                - curl -sf -u "admin:$COUCHDB_PASSWORD" http://127.0.0.1:{{ container_item.port }}/_up
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            exec:
              command:
                - sh
                - -c
                - curl -sf -u "admin:$COUCHDB_PASSWORD" http://127.0.0.1:{{ container_item.port }}/_up
            initialDelaySeconds: 60
            periodSeconds: 30
{{ container_resources(cpu_limit=livesync_k8s_cpu_limit, mem_limit=livesync_k8s_mem_limit, cpu_request=livesync_k8s_cpu_request, mem_request=livesync_k8s_mem_request) }}
      volumes:
        - name: livesync-data
          persistentVolumeClaim:
            claimName: {{ livesync_k8s_claim }}
        - name: livesync-config
          configMap:
            name: livesync-config
        - name: livesync-local-d
          emptyDir: {}
