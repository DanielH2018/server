{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: navidrome
  namespace: {{ k8s_namespace }}
spec:
  # The data PVC is ReadWriteOnce and Longhorn runs one replica, so a rolling update would
  # deadlock: the new pod waits for a volume the old pod still holds. Navidrome's index is
  # sqlite besides, which wants one writer.
{{ spec_shell('Recreate') }}
  replicas: {{ navidrome_k8s_replicas }}
  selector:
    matchLabels:
      app: navidrome
  template:
    metadata:
      labels:
        app: navidrome
        netpol-baseline: enforced
    spec:
      # Longhorn hands back a root-owned filesystem; without an fsGroup the non-root process
      # cannot create its sqlite index on the fresh volume.
{{ pod_shell('homelab-best-effort', run_as_user=navidrome_k8s_uid, run_as_group=navidrome_k8s_uid, fs_group=navidrome_k8s_uid) }}
{# DECIDED: no node affinity; the bound media-data local PV's nodeAffinity pins this pod to
   daniel-box, where the library lives, and a preference for any other node is dead. #}
      containers:
        - name: navidrome
          image: {{ navidrome_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{ container_item.port }}
{{ hardened_security_context(read_only=true, non_root=true) }}
          env:
            - name: ND_MUSICFOLDER
              value: {{ navidrome_k8s_music_dir }}
            - name: ND_DATAFOLDER
              value: /data
            - name: ND_PORT
              value: "{{ container_item.port }}"
            # On for ListenBrainz scrobbling and Deezer artist images. The same switch also turns
            # on the anonymous insights collector and the Last.fm agent, so both are off below:
            # Last.fm needs an API account this setup does not have.
            - name: ND_ENABLEEXTERNALSERVICES
              value: "true"
            - name: ND_ENABLEINSIGHTSCOLLECTOR
              value: "false"
            - name: ND_LASTFM_ENABLED
              value: "false"
            # /metrics on the UI port, no password: the namespace fence admits only traefik and
            # prometheus, and the route keeps the path behind Authelia. Homepage's tile reads the
            # library counts from Prometheus.
            - name: ND_PROMETHEUS_ENABLED
              value: "true"
            - name: TZ
              value: "{{ tz }}"
          volumeMounts:
            - name: navidrome-data
              mountPath: /data
            # The music subPath only: the volume root would point the scanner at the video library.
            - name: media
              mountPath: {{ navidrome_k8s_music_dir }}
              subPath: {{ navidrome_k8s_media_subpath }}
              readOnly: true
            # readOnlyRootFilesystem is on, and the transcoder writes its scratch files here.
            - name: navidrome-tmp
              mountPath: /tmp
          readinessProbe:
            httpGet:
              path: /ping
              port: {{ container_item.port }}
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /ping
              port: {{ container_item.port }}
            initialDelaySeconds: 30
            periodSeconds: 30
{{ container_resources(cpu_limit=navidrome_k8s_cpu_limit, mem_limit=navidrome_k8s_mem_limit, cpu_request=navidrome_k8s_cpu_request, mem_request=navidrome_k8s_mem_request) }}
      volumes:
        - name: navidrome-data
          persistentVolumeClaim:
            claimName: {{ navidrome_k8s_claim }}
        - name: media
          persistentVolumeClaim:
            claimName: {{ navidrome_k8s_media_claim }}
            readOnly: true
        - name: navidrome-tmp
          emptyDir: {}
