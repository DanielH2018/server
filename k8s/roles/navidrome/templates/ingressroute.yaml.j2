{% from 'ingressroute.yml.j2' import ingressroute with context %}
{# Listed only while replicas > 0: an empty EndpointSlice makes Traefik log `no servers found`
   every ~20s.
   The gate lives in manifests_files: dropping the name makes the prune delete the live route. #}
---
{{ ingressroute(
    container_item.name,
    container_item.hostname | default(container_item.name),
    container_item.port,
    container_item.use_authelia,
    bypass_prefixes=container_item.bridge_bypass_prefixes | default([])
  )
}}
