{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: texbrain
  namespace: {{ k8s_namespace }}
spec:
{{ spec_shell('RollingUpdate') }}
  replicas: 1
  selector:
    matchLabels:
      app: texbrain
  template:
    metadata:
      labels:
        app: texbrain
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-best-effort', run_as_user=texbrain_k8s_uid, run_as_group=texbrain_k8s_uid, fs_group=texbrain_k8s_uid) }}
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: texbrain
          image: {{ texbrain_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{ container_item.port }}
{{ hardened_security_context(read_only=true, non_root=true) }}
          volumeMounts:
            - name: nginx-cache
              mountPath: /var/cache/nginx
            - name: nginx-tmp
              mountPath: /etc/nginx/tmp
            # Mount /tmp too: nginx creates proxy_temp there at startup, and the pod crashloops
            # without it.
            - name: nginx-run
              mountPath: /tmp
          readinessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
            initialDelaySeconds: 15
            periodSeconds: 30
{{ container_resources(cpu_limit=texbrain_k8s_cpu_limit, mem_limit=texbrain_k8s_mem_limit, cpu_request=texbrain_k8s_cpu_request, mem_request=texbrain_k8s_mem_request) }}
      volumes:
        - name: nginx-cache
          emptyDir: {}
        - name: nginx-tmp
          emptyDir: {}
        - name: nginx-run
          emptyDir: {}
