{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mosquitto
  namespace: {{ k8s_namespace }}
spec:
  # ReadWriteOnce PVC on single-replica Longhorn — a rolling update would deadlock on the volume.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: mosquitto
  template:
    metadata:
      labels:
        app: mosquitto
        netpol-baseline: enforced
    spec:
      # Pinned to the VIP-announcing node while the MetalLB L2Advertisement is pinned
      # to daniel-box: with externalTrafficPolicy Local, a VIP-backed pod on the other
      # node makes the announcer DROP all forwarded LAN traffic (the post-boot
      # DNS blackout). DECIDED: permanent posture (operator 2026-08-14) — with ETP Local
      # load-bearing for client IPs, announcement and placement stay on one node as a
      # unit; this pin only ever moves together with the L2Advertisement nodeSelector.
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_primary_node }}
{{ pod_shell(services | tier_priority_class('mosquitto'), run_as_user=puid, run_as_group=pgid, fs_group=pgid) }}
      # The password-file plugin refuses the pwfile on a Secret mount; an init container copies both
      # files into an emptyDir the pod owns.
      initContainers:
        - name: config-copy
          image: {{ mosquitto_k8s_image }}
          imagePullPolicy: IfNotPresent
          command:
            - sh
            - -c
            # install -m 400: mosquitto refuses a world-readable password file, and cp would create
            # one.
            - install -m 444 /secret/mosquitto.conf /config/ &&
              install -m 400 /secret/passwordfile /config/
{{ hardened_security_context(read_only=true, non_root=true) }}
          volumeMounts:
            - name: mosquitto-config-secret
              mountPath: /secret
              readOnly: true
            - name: mosquitto-config
              mountPath: /config
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
      containers:
        - name: mosquitto
          image: {{ mosquitto_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 1883
{{ hardened_security_context(read_only=true, non_root=true) }}
          env:
            - name: TZ
              value: "{{ tz }}"
          volumeMounts:
            - name: mosquitto-config
              mountPath: /mosquitto/config
              readOnly: true
            - name: mosquitto-data
              mountPath: /mosquitto/data
            # Image declares VOLUME /mosquitto/log; scratch over it keeps the read-only rootfs
            # working.
            - name: mosquitto-log
              mountPath: /mosquitto/log
          # TCP probes: an exec probe would embed the MQTT password in the pod spec, readable via
          # the read-only kubeconfig.
          readinessProbe:
            tcpSocket:
              port: 1883
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            tcpSocket:
              port: 1883
            initialDelaySeconds: 15
            periodSeconds: 30
{{ container_resources(cpu_limit=mosquitto_k8s_cpu_limit, mem_limit=mosquitto_k8s_mem_limit, cpu_request=mosquitto_k8s_cpu_request, mem_request=mosquitto_k8s_mem_request) }}
      volumes:
        - name: mosquitto-config-secret
          secret:
            secretName: mosquitto-config
            # 288 = 0440 in decimal: the YAML-1.1 parser behind kubectl reads 0o440 as a string.
            defaultMode: 288
        - name: mosquitto-config
          emptyDir: {}
        - name: mosquitto-data
          persistentVolumeClaim:
            claimName: {{ mosquitto_k8s_claim }}
        - name: mosquitto-log
          emptyDir: {}
