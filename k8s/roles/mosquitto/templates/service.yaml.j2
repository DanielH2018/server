---
apiVersion: v1
kind: Service
metadata:
  name: mosquitto
  namespace: {{ k8s_namespace }}
spec:
  selector:
    app: mosquitto
  ports:
    - name: mqtt
      port: 1883
      targetPort: 1883
---
apiVersion: v1
kind: Service
metadata:
  name: mosquitto-lan
  namespace: {{ k8s_namespace }}
  annotations:
    metallb.io/loadBalancerIPs: {{ mosquitto_k8s_lan_ip }}
spec:
  type: LoadBalancer
  # Preserves the real client address in broker logs.
  externalTrafficPolicy: Local
  selector:
    app: mosquitto
  ports:
    - name: mqtt
      port: 1883
      targetPort: 1883
