---
apiVersion: v1
kind: Secret
metadata:
  name: mosquitto-config
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  # A Secret, not a ConfigMap, because the password file rides along.
  mosquitto.conf: |
    listener 1883
    allow_anonymous false
    password_file /mosquitto/config/passwordfile
    persistence true
    persistence_location /mosquitto/data/
    log_dest stdout
  passwordfile: |
    {{ mqtt_username }}:{{ mqtt_password_hash }}
