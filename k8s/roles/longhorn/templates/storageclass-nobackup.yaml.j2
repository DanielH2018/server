---
# Excluding from backup works through a different group: `daily-backup` claims `default`, which
# Longhorn applies only to volumes with NO recurring-job label, so `no-backup` (deliberately no
# RecurringJob) occupies that slot. PVC labels do not propagate to Volume CRs, so the class
# parameter is the way.
# numberOfReplicas is deliberately ABSENT so `default-replica-count` stays the single source; do not
# paste it back. `force: enabled` recreates the class on an immutable change, which is safe for
# bound PVCs.
kind: StorageClass
apiVersion: storage.k8s.io/v1
metadata:
  name: longhorn-nobackup
  annotations:
    kustomize.toolkit.fluxcd.io/force: enabled
provisioner: driver.longhorn.io
allowVolumeExpansion: true
reclaimPolicy: "Delete"
volumeBindingMode: Immediate
parameters:
  staleReplicaTimeout: "30"
  fromBackup: ""
  fsType: "ext4"
  dataLocality: "disabled"
  unmapMarkSnapChainRemoved: "ignored"
  disableRevisionCounter: "true"
  dataEngine: "v1"
  recurringJobSelector: '[{"name":"no-backup","isGroup":true}]'
