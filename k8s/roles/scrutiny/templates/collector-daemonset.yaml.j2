{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'workload-shell.yml.j2' import pod_shell with context %}
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: scrutiny-collector
  namespace: {{ k8s_namespace }}
spec:
  selector:
    matchLabels:
      app: scrutiny-collector
  template:
    metadata:
      labels:
        app: scrutiny-collector
        netpol-baseline: enforced
    spec:
      # The collector never talks to the API server, and a privileged pod should not mount a token.
{{ pod_shell('homelab-best-effort') }}
      containers:
        - name: collector
          image: {{ scrutiny_k8s_collector_image }}
          imagePullPolicy: IfNotPresent
          securityContext:
            # Privileged: capabilities plus a CharDevice hostPath are not enough, as the device
            # cgroup refuses the open; k8s has no per-device grant short of a device plugin.
            privileged: true
          env:
            - name: COLLECTOR_API_ENDPOINT
              # The in-cluster Service — no route, no Authelia in the path.
              value: http://scrutiny:{{ container_item.port }}
            - name: COLLECTOR_CRON_SCHEDULE
              value: "{{ scrutiny_k8s_collector_cron }}"
            - name: TZ
              value: {{ tz }}
          volumeMounts:
            - name: scrutiny-collector-udev
              mountPath: /run/udev
              readOnly: true
            - name: scrutiny-collector-nvme
              mountPath: /dev/nvme0
            - name: scrutiny-collector-config
              mountPath: /opt/scrutiny/config
{{ container_resources(cpu_limit='500m', mem_limit='256Mi', cpu_request='50m', mem_request='32Mi') }}
      volumes:
        - name: scrutiny-collector-udev
          hostPath:
            path: /run/udev
        - name: scrutiny-collector-nvme
          hostPath:
            path: /dev/nvme0
            type: CharDevice
        - name: scrutiny-collector-config
          configMap:
            name: scrutiny-collector-config
