{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
# The Service is named `scrutiny` so the ingressroute macro and COLLECTOR_API_ENDPOINT resolve.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: scrutiny-web
  namespace: {{ k8s_namespace }}
spec:
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: scrutiny-web
  template:
    metadata:
      labels:
        app: scrutiny-web
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-best-effort') }}
{{ node_affinity_preference('daniel-server') }}
      initContainers:
        # scrutiny-web panics instead of retrying when InfluxDB is down at startup, before any probe
        # runs.
        # Gates on the Service (no endpoints until influx ping passes); needs -f, as curl exits 0 on
        # 5xx.
        - name: wait-for-influxdb
          image: {{ scrutiny_k8s_web_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
            - >-
              i=0;
              until curl -sf --max-time 5 -o /dev/null http://scrutiny-influxdb:8086/api/v2/setup; do
                i=$((i+1));
                [ "$i" -ge 60 ] && echo "scrutiny-influxdb still unreachable after 120s" >&2 && exit 1;
                sleep 2;
              done;
              echo "scrutiny-influxdb reachable after $((i*2))s"
{{ hardened_security_context(read_only=true) }}
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
      containers:
        - name: web
          image: {{ scrutiny_k8s_web_image }}
          imagePullPolicy: IfNotPresent
          # No _FILE convention: a wrapper exports the token from the Secret mount, off the pod
          # spec.
          # Scrutiny's shoutrrr alert is unused: monitor-bridge's check_scrutiny is the single
          # pager.
          command:
            - /bin/sh
            - -c
            - 'export SCRUTINY_WEB_INFLUXDB_TOKEN="$(cat /etc/scrutiny-secrets/influxdb_token)"; exec /opt/scrutiny/bin/scrutiny start'
          # Runs as root writing its SQLite config DB + WAL in the PVC mount.
{{ hardened_security_context(add=['DAC_OVERRIDE']) }}
          env:
            - name: SCRUTINY_WEB_INFLUXDB_HOST
              value: scrutiny-influxdb
            - name: SCRUTINY_WEB_INFLUXDB_PORT
              value: "8086"
            - name: SCRUTINY_WEB_INFLUXDB_ORG
              value: scrutiny
            - name: SCRUTINY_WEB_INFLUXDB_BUCKET
              value: metrics
            - name: TZ
              value: {{ tz }}
          ports:
            - name: http
              containerPort: 8080
          volumeMounts:
            - name: scrutiny-web-config
              mountPath: /opt/scrutiny/config
            # /etc, NOT /run/secrets — see the influxdb manifest's note.
            - name: scrutiny-web-credentials
              mountPath: /etc/scrutiny-secrets
              readOnly: true
          readinessProbe:
            httpGet:
              path: /api/health
              port: 8080
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /api/health
              port: 8080
            initialDelaySeconds: 60
            periodSeconds: 30
{{ container_resources(cpu_limit='500m', mem_limit='512Mi', cpu_request='50m', mem_request='64Mi') }}
      volumes:
        - name: scrutiny-web-config
          persistentVolumeClaim:
            claimName: {{ scrutiny_k8s_config_claim }}
        - name: scrutiny-web-credentials
          secret:
            secretName: scrutiny-influxdb-credentials
            defaultMode: 0o444
---
apiVersion: v1
kind: Service
metadata:
  name: scrutiny
  namespace: {{ k8s_namespace }}
spec:
  selector:
    app: scrutiny-web
  ports:
    - port: {{ container_item.port }}
      targetPort: 8080
