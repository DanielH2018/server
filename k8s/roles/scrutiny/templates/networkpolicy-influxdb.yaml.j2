---
# Ships with this role, not netpol-baseline: scrutiny-web panics when InfluxDB is unreachable.
# No `netpol_baseline_enforced` branch: that lever is role-scoped to netpol-baseline.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: scrutiny-influxdb
  namespace: {{ k8s_namespace }}
spec:
  podSelector:
    matchLabels:
      app: scrutiny-influxdb
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app: scrutiny-web
      ports:
        - port: 8086
          protocol: TCP
