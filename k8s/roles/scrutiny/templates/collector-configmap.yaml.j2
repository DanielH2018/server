---
# Pin the scan to the NVMe: the host's /dev holds Longhorn iSCSI disks that smartctl errors on.
# `allow_listed_devices` restricts the scan; a `devices:` list only customizes detected entries.
apiVersion: v1
kind: ConfigMap
metadata:
  name: scrutiny-collector-config
  namespace: {{ k8s_namespace }}
data:
  collector.yaml: |
    version: 1
    allow_listed_devices:
      - /dev/nvme0
