{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: janitorr
  namespace: {{ k8s_namespace }}
spec:
  # Recreate: two janitorrs at once would both walk the library and act on it.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: janitorr
  template:
    metadata:
      labels:
        app: janitorr
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-best-effort', run_as_user=puid, run_as_group=pgid, fs_group=pgid, non_root=true) }}
      containers:
        - name: janitorr
          image: {{ janitorr_k8s_image }}
          imagePullPolicy: IfNotPresent
          env:
            - name: TZ
              value: "{{ tz }}"
{{ hardened_security_context(read_only=true) }}
          volumeMounts:
            - name: janitorr-config
              mountPath: /config/application.yml
              subPath: application.yml
              readOnly: true
            # READ-WRITE, whole tree: janitorr creates symlinks and deletes files here; a readOnly
            # mount would fail the first cleanup, not make it safe.
            - name: media
              mountPath: /data
            # The JVM writes /tmp/hsperfdata_* and a truststore even with everything else read-only.
            - name: janitorr-tmp
              mountPath: /tmp
{{ container_resources(cpu_limit=janitorr_k8s_cpu_limit, mem_limit=janitorr_k8s_mem_limit, cpu_request=janitorr_k8s_cpu_request, mem_request=janitorr_k8s_mem_request) }}
          livenessProbe:
            # Proves the process is alive and nothing more; janitorr's real failures are logged, not
            # exposed.
            exec:
              command: [sh, -c, "grep -q java /proc/1/comm"]
            initialDelaySeconds: 60
            periodSeconds: 30
      volumes:
        - name: janitorr-config
          secret:
            secretName: janitorr-config
        - name: media
          persistentVolumeClaim:
            claimName: {{ janitorr_k8s_media_claim }}
        - name: janitorr-tmp
          emptyDir: {}
