{% from 'container-resources.yml.j2' import job_container_resources with context %}
{% from 'security-context.yml.j2' import job_hardened_security_context with context %}
{# The Python reader and kubectl ship in neither image alone: the init container copies kubectl from
   alpine/k8s.
   Label `app: janitorr-health`, never `app: janitorr`: the reader and verify.yml pick the first
   Running app=janitorr pod. #}
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: janitorr-health
  namespace: {{ k8s_namespace }}
spec:
  schedule: "{{ janitorr_k8s_health_schedule }}"
  timeZone: Etc/UTC
  concurrencyPolicy: Forbid
  # A run missed by more than one period is not made up: the next one reads the same pod.
  startingDeadlineSeconds: 300
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 2
  jobTemplate:
    metadata:
      labels:
        app: janitorr-health
    spec:
      activeDeadlineSeconds: {{ janitorr_k8s_health_deadline_seconds }}
      ttlSecondsAfterFinished: {{ janitorr_k8s_health_job_ttl_seconds }}
      # No retry: the next run is ten minutes away and re-reads the same state.
      backoffLimit: 0
      template:
        metadata:
          labels:
            app: janitorr-health
            netpol-baseline: enforced
        spec:
          restartPolicy: Never
          enableServiceLinks: false
          serviceAccountName: janitorr-health
          automountServiceAccountToken: true
          securityContext:
            runAsUser: {{ puid }}
            runAsGroup: {{ pgid }}
            runAsNonRoot: true
          priorityClassName: homelab-best-effort
          initContainers:
            - name: kubectl
              image: {{ janitorr_k8s_health_kubectl_image }}
              imagePullPolicy: IfNotPresent
              command: ["cp", "/usr/bin/kubectl", "/kubectl/kubectl"]
{{ job_hardened_security_context(read_only=true) }}
              volumeMounts:
                - name: janitorr-health-kubectl
                  mountPath: /kubectl
{{ job_container_resources(cpu_limit=janitorr_k8s_health_cpu_limit, mem_limit=janitorr_k8s_health_mem_limit, cpu_request=janitorr_k8s_health_cpu_request, mem_request=janitorr_k8s_health_mem_request) }}
          containers:
            - name: janitorr-health
              image: {{ janitorr_k8s_health_image }}
              imagePullPolicy: IfNotPresent
              command: ["python3", "/config/janitorr_health.py"]
              env:
                - name: JANITORR_NAMESPACE
                  value: "{{ k8s_namespace }}"
                - name: JANITORR_WINDOW_H
                  value: "{{ janitorr_k8s_error_window_hours }}"
                - name: JANITORR_STARTUP_GRACE_S
                  value: "{{ janitorr_k8s_startup_grace_seconds }}"
                - name: JANITORR_KUBECTL
                  value: /kubectl/kubectl
                # The ConfigMap the verdict is also written to (health-verdict-configmap.yaml.j2).
                - name: JANITORR_VERDICT_CONFIGMAP
                  value: "{{ janitorr_k8s_health_verdict_configmap }}"
                # kubectl's discovery cache goes under $HOME and the root filesystem is read-only.
                - name: HOME
                  value: /tmp
                # The ConfigMap mount is read-only, so Python cannot write __pycache__ there.
                - name: PYTHONDONTWRITEBYTECODE
                  value: "1"
{{ job_hardened_security_context(read_only=true) }}
              volumeMounts:
                - name: janitorr-health-code
                  mountPath: /config
                  readOnly: true
                - name: janitorr-health-kubectl
                  mountPath: /kubectl
                  readOnly: true
                - name: janitorr-health-tmp
                  mountPath: /tmp
{{ job_container_resources(cpu_limit=janitorr_k8s_health_cpu_limit, mem_limit=janitorr_k8s_health_mem_limit, cpu_request=janitorr_k8s_health_cpu_request, mem_request=janitorr_k8s_health_mem_request) }}
          volumes:
            - name: janitorr-health-code
              configMap:
                name: janitorr-health
                items:
                  - key: janitorr_health.py
                    path: janitorr_health.py
                  - key: janitorr_health_logic.py
                    path: janitorr_health_logic.py
                  - key: host_lib.py
                    path: host_lib.py
                  - key: check_verdict
                    path: lib/check_verdict.py
            - name: janitorr-health-kubectl
              emptyDir: {}
            - name: janitorr-health-tmp
              emptyDir: {}
