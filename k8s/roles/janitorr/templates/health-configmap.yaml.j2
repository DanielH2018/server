{#
  The janitorr-health CronJob's code: the reader, its verdict module, the host_lib.py it
  imports, and the repo's verdict export.

  Flat keys, because a ConfigMap key cannot hold a `/`. The reader puts its own directory on
  sys.path, and the CronJob's volume maps the export's key back under lib/ with `items:`, so
  `from lib.check_verdict import ...` resolves beside the reader.

  The lib/ key carries no `.py` suffix: promote's gitleaks scan reads that volume item as a
  credential, and .gitleaks.toml admits only a snake_case key name.

  No secret goes in here, and the pod takes none from a Secret.
  tests/k8s/flux/test_no_secret_in_a_moved_jobs_configmap.py renders this file with every
  secrets.yml key bound to a sentinel and fails on any sentinel it finds.
#}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: janitorr-health
  namespace: {{ k8s_namespace }}
data:
  janitorr_health.py: |
{{ lookup('file', role_file('files/janitorr_health.py')) | indent(4, true) }}
  janitorr_health_logic.py: |
{{ lookup('file', role_file('files/janitorr_health_logic.py')) | indent(4, true) }}
  host_lib.py: |
{{ lookup('file', repo_file('hosts/lib/host_lib.py')) | indent(4, true) }}
  check_verdict: |
{{ lookup('file', repo_file('scripts/lib/check_verdict.py')) | indent(4, true) }}
