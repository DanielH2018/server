logging:
  level:
    com.github.schaka: INFO

file-system:
  access: true
  leaving-soon-dir: "/data/media/leaving-soon"
  media-server-leaving-soon-dir: "/data/media/leaving-soon"
  from-scratch: true
  free-space-check-dir: "/data"

application:
  # Templated so the role can run dry without forking this file.
  dry-run: {{ janitorr_k8s_dry_run | default('false') }}
  run-once: false
  whole-tv-show: false
  whole-show-seeding-check: false
  leaving-soon: 14d
  # Labels match by EXACT equality and Radarr/Sonarr tags allow only ^[a-z0-9-]+$, so the upstream
  # default `janitorr_keep` can never be created or match; keep these hyphenated.
  exclusion-tags: # Set these tags on movies/TV shows in the *arrs to exclude media from being cleaned up
    - "janitorr-keep"
    - "janitorr-keep-too"

  media-deletion:
    enabled: true
    # Each key is a free-disk percentage: a rung applies while free space is below that many
    # percent, and its value is the age past which media is deleted.
    # DECIDED: the loosest rung is 25, not 20 (#5806, operator ruling 2026-10-22). /srv/media
    # shares daniel-box's root LV with /var/lib/longhorn, and Longhorn stops scheduling on a
    # disk below 25% available (`storage-minimal-available-percentage: 25`). A 20% rung does
    # nothing until the LV is 80% used, which is past Longhorn's line, and the LV cannot grow
    # (the VG has no free extents). The 25 rung makes janitorr start trimming at 75% used.
    # Contradict this with new evidence about the Longhorn setting or the LV layout.
    movie-expiration:
      5: 15d # 15 days
      10: 30d # 1 month - if a movie's files on your system are older than this, they will be deleted
      15: 30d # 2 months
      20: 90d # 3 months
      25: 180d # 6 months - the Longhorn floor, see DECIDED above
    season-expiration:
      5: 15d # 15 days
      10: 20d # 20 days - if a season's files on your system are older than this, they will be deleted
      15: 60d # 2 months
      20: 120d # 4 months
      25: 240d # 8 months - the Longhorn floor, see DECIDED above

  # DISABLED: upstream's demo tags violate the *arr ^[a-z0-9-]+$ rule so neither can match; off
  # because janitorr deletes for real.
  tag-based-deletion:
    enabled: false
    minimum-free-disk-percent: 100
    schedules:
      - tag: 5 - demo
        expiration: 30d
      - tag: 10 - demo
        expiration: 7d

  episode-deletion:
    enabled: false
    clean-older-seasons: false
    tag: janitorr_daily # Shows tagged with this will have all episodes of their LATEST season deleted by the below thresholds
    max-episodes: 10
    max-age: 60d

clients:
  # Media Libraries to Clean
  sonarr:
    enabled: true
    url: "http://sonarr:8989"
    apikey: "{{ sonarr_api_key }}"
    delete-empty-shows: true
    determine-age-by: MOST_RECENT
    import-exclusions: false

  radarr:
    enabled: true
    url: "http://radarr:7878"
    apikey: "{{ radarr_api_key }}"
    only-delete-files: false
    determine-age-by: MOST_RECENT
{# DECIDED: import-exclusions, not Radarr's autoUnmonitor flag; with only-delete-files: false
   Janitorr removes the record, so the state that flag governs never occurs. #}
    # true here, false for sonarr, on purpose: `only-delete-files: false` removes the movie from
    # Radarr, an import list re-adds it and it re-downloads; the exclusion stops that. Cost: clear
    # the exclusion in Radarr to re-add.
    import-exclusions: true

  ## User login is only needed if deletion is enabled.
  jellyfin:
    enabled: true
    url: "http://jellyfin:8096"
    api-key: "{{ jellyfin_api_key }}"
    #username: Janitorr
    #password: janitorr
    delete: false # Jellyfin setup is required for JellyStat. However, if you don't want Janitorr to send delete requests to the Jellyfin API, disable it here
    exclude-favorited: false # When enabled, items favorited by any Jellyfin user will be excluded from deletion and won't appear in Leaving Soon
    leaving-soon-tv: "Shows (Leaving Soon)"
    leaving-soon-movies: "Movies (Leaving Soon)"
    leaving-soon-type: MOVIES_AND_TV # Other valid values are MOVIES, TV and NONE
