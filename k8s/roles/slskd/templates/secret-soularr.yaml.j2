# Soularr's config.ini. It carries Lidarr's API key, so it is a Secret. The slskd api_key is a
# placeholder: slskd runs with SLSKD_NO_AUTH, whose passthrough scheme accepts any key, but
# Soularr refuses to start without one.
---
apiVersion: v1
kind: Secret
metadata:
  name: slskd-soularr
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  config.ini: |
{{ lookup('template', role_file('templates/config/soularr.ini.j2')) | indent(4, true) }}
