{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'workload-shell.yml.j2' import pod_shell with context %}
---
# kube-system: extended resources are a NODE property, so every namespace's pods can request this
# once it is advertised.
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: dri-device-plugin
  namespace: kube-system
  labels:
    app: dri-device-plugin
spec:
  selector:
    matchLabels:
      app: dri-device-plugin
  template:
    metadata:
      labels:
        app: dri-device-plugin
    spec:
      # Losing this plugin makes jellyfin and tdarr unschedulable, so it must not be evicted.
      # The container never talks to the API server, so no token is mounted into a privileged pod.
{{ pod_shell('system-node-critical') }}
      tolerations:
        - operator: Exists
          effect: NoSchedule
      containers:
        - name: generic-device-plugin
          image: {{ dri_device_plugin_k8s_image }}
          imagePullPolicy: IfNotPresent
          args:
            - --device
            - |
              name: dri
              groups:
                - count: {{ dri_device_plugin_count }}
                  paths:
                    - path: /dev/dri/renderD128
          ports:
            - name: http
              containerPort: 8080
          securityContext:
            # The ONE privileged component in the media stack: registering the device-plugin gRPC
            # socket and handing the kubelet device file descriptors need privilege, so consumers
            # stay unprivileged.
            privileged: true
{{ container_resources(cpu_limit='100m', mem_limit='60Mi', cpu_request='10m', mem_request='20Mi') }}
          volumeMounts:
            - name: dri-device-plugin-socket
              mountPath: /var/lib/kubelet/device-plugins
            - name: dri-device-plugin-dev
              mountPath: /dev
      volumes:
        # The kubelet's plugin-registration socket directory — how the plugin announces itself.
        - name: dri-device-plugin-socket
          hostPath:
            path: /var/lib/kubelet/device-plugins
        - name: dri-device-plugin-dev
          hostPath:
            path: /dev
