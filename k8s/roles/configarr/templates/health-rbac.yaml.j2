{#
  The configarr-health CronJob's identity. Its rules are the calls configarr_health.py makes
  and nothing else:

    get jobs -l app=configarr -o json   list on jobs.batch
    logs job/<name>                     get on jobs.batch, list on pods, get on pods/log

  tests/k8s/rbac/test_rbac_against_script.py runs the reader's main with a recording
  runner and holds this Role to the calls it records.
#}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: configarr-health
  namespace: {{ k8s_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: configarr-health
  namespace: {{ k8s_namespace }}
rules:
  - apiGroups: [batch]
    resources: [jobs]
    verbs: [get, list]
  - apiGroups: [""]
    resources: [pods]
    verbs: [list]
  - apiGroups: [""]
    resources: [pods/log]
    verbs: [get]
  # `get` as well as `patch`: `kubectl patch` GETs the object first; the grant names the object so
  # it reaches no other.
  - apiGroups: [""]
    resources: [configmaps]
    verbs: [get, patch]
    resourceNames: [{{ configarr_k8s_health_verdict_configmap }}]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: configarr-health
  namespace: {{ k8s_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: configarr-health
subjects:
  - kind: ServiceAccount
    name: configarr-health
    namespace: {{ k8s_namespace }}
