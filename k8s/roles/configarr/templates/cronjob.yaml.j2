{% from 'container-resources.yml.j2' import job_container_resources with context %}
{% from 'security-context.yml.j2' import job_hardened_security_context with context %}
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: configarr
  namespace: {{ k8s_namespace }}
spec:
  schedule: "{{ configarr_k8s_schedule }}"
  # Without this the schedule is UTC, which is not what "30 4" meant on daniel-server.
  timeZone: "{{ tz }}"
  # Forbid, not Replace: a still-running sync holds custom-format state mid-write, and a second
  # would race the API.
  concurrencyPolicy: Forbid
  # A missed schedule is not made up; the health cron's age gate notices.
  startingDeadlineSeconds: 600
  successfulJobsHistoryLimit: {{ configarr_k8s_successful_history }}
  failedJobsHistoryLimit: {{ configarr_k8s_failed_history }}
  jobTemplate:
    metadata:
      # On the JOB, not just the pod: `kubectl create job --from=cronjob/configarr` copies it, so
      # the health reader counts deploy-time runs.
      labels:
        app: configarr
    spec:
      activeDeadlineSeconds: {{ configarr_k8s_timeout }}
      ttlSecondsAfterFinished: {{ configarr_k8s_job_ttl_seconds }}
      # No retry, load-bearing: a retried failed sync would end as Success, and a transient *arr
      # outage would look like a clean night.
      backoffLimit: 0
      template:
        metadata:
          labels:
            app: configarr
            netpol-baseline: enforced
        spec:
          restartPolicy: Never
          enableServiceLinks: false
          automountServiceAccountToken: false
          securityContext:
            runAsUser: {{ puid }}
            runAsGroup: {{ pgid }}
            runAsNonRoot: true
          priorityClassName: homelab-best-effort
          containers:
            - name: configarr
              image: {{ configarr_k8s_image }}
              imagePullPolicy: IfNotPresent
              # configarr writes its guide clones to /app/repos; /tmp is the one other path Node or
              # git may touch.
{{ job_hardened_security_context(read_only=true) }}
              volumeMounts:
                - name: configarr-tmp
                  mountPath: /tmp
                # readOnly because configarr never writes here: the dir holds one file, config.yml.
                - name: configarr-config
                  mountPath: /app/config
                  readOnly: true
                - name: configarr-repos
                  mountPath: /app/repos
{{ job_container_resources(cpu_limit=configarr_k8s_cpu_limit, mem_limit=configarr_k8s_mem_limit, cpu_request=configarr_k8s_cpu_request, mem_request=configarr_k8s_mem_request) }}
          volumes:
            - name: configarr-config
              secret:
                secretName: configarr-config
            # An emptyDir, not a PVC: a cache of two public git repos, re-cloned in seconds.
            - name: configarr-repos
              emptyDir: {}
            - name: configarr-tmp
              emptyDir: {}
