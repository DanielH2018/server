{#
  The configarr-health CronJob's code: the reader, its two configarr_lib modules, the
  host_lib.py it imports, the repo's condition parser and its verdict export.

  Flat keys, because a ConfigMap key cannot hold a `/`. The CronJob's volume maps each
  configarr_lib key back under configarr_lib/, and the two scripts/lib modules under lib/, with
  `items:`, so `from configarr_lib import ...` and `from lib.<module> import ...` resolve
  beside the reader.

  A lib/ key carries no `.py` suffix: promote's gitleaks scan reads that volume item
  as a credential, and .gitleaks.toml admits only a snake_case key name.

  No secret goes in here, and the pod takes none from a Secret.
  tests/k8s/flux/test_no_secret_in_a_moved_jobs_configmap.py renders this file with every
  secrets.yml key bound to a sentinel and fails on any sentinel it finds.
#}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: configarr-health
  namespace: {{ k8s_namespace }}
data:
  configarr_health.py: |
{{ lookup('file', role_file('files/configarr_health.py')) | indent(4, true) }}
  configarr_health_logic.py: |
{{ lookup('file', role_file('files/configarr_lib/configarr_health_logic.py')) | indent(4, true) }}
  configarr_status.py: |
{{ lookup('file', role_file('files/configarr_lib/configarr_status.py')) | indent(4, true) }}
  host_lib.py: |
{{ lookup('file', repo_file('hosts/lib/host_lib.py')) | indent(4, true) }}
  k8s_conditions: |
{{ lookup('file', repo_file('scripts/lib/k8s_conditions.py')) | indent(4, true) }}
  check_verdict: |
{{ lookup('file', repo_file('scripts/lib/check_verdict.py')) | indent(4, true) }}
