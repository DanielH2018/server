---
apiVersion: v1
kind: Secret
metadata:
  name: configarr-config
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  config.yml: |
{# Rendered from config.yml.j2, not copied, so two grab policies cannot drift. A Secret because it
   embeds both *arr API keys. #}
{{ lookup('template', role_file('templates/config/config.yml.j2')) | indent(4, true) }}
