{#
  The verify Job's identity, rendered into `prowlarr-verify` beside `job.yaml.j2`.

  It is a ServiceAccount with no Role. The Job dials prowlarr and flaresolverr over the pod
  network and execs into no pod, so it needs no Kubernetes grant, and its pod mounts no token.
#}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: prowlarr-verify
  namespace: {{ k8s_namespace }}
automountServiceAccountToken: false
