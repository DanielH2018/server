{#
  The seed Job that writes the SOPS Sonarr, Radarr and Lidarr API keys into Prowlarr's
  application entries; `files/seed_prowlarr_app_keys.py` has the design.

  The renderer emits it into `prowlarr-verify`. That Kustomization waits on `prowlarr` and, by
  `flux_verify_after`, on sonarr, radarr and lidarr, so each app's `<app>-exportarr` Secret is
  applied and its rolled pod answers Prowlarr's test before the Job runs.

  DECIDED: the keys come from the four `<app>-exportarr` Secrets, which each app's own render
  applies with `api_key` filled from `<app>_api_key`. A Secret of its own in `prowlarr-verify`
  would be a second copy of each key to keep in step.

  DECIDED: the spec embeds the `cluster-vars.source` digest of the three app keys, so a
  rotation of any of them alone renames the Job and the seed runs again. A `secretKeyRef` moves
  no spec when the value behind it changes. The digest is of the keys' ciphertext, so no value
  enters the hash. The spec also embeds a digest of prowlarr's rendered Deployment, so the seed
  runs once per revision that rolls prowlarr. A `prowlarr-config` revert changes no render, so
  a key it restores stays stale until that next revision.

  The pod carries `app: prowlarr-verify`, a peer of prowlarr's fence, and it dials only
  prowlarr. Prowlarr dials the apps itself.
#}
{% from 'digest-job.yml.j2' import digest_job with context %}
{% set script = 'seed_prowlarr_app_keys.py' %}
{% set apps = ['sonarr', 'radarr', 'lidarr'] %}
{% set keys = namespace(rows=[]) %}
{% set source = lookup('file', cluster_vars_source()).splitlines() %}
{% for app in apps %}
{% for line in source if line.split()[:1] == [app + '_api_key'] %}
{% set keys.rows = keys.rows + [line] %}
{% endfor %}
{% endfor %}
{% set head %}
# One retry. A rerun tests each entry again and writes only a key Prowlarr still rejects.
backoffLimit: 1
# Below the 600s `manifests_rollout_timeout_default` every `<tag>-verify` Kustomization takes.
# One list call and, per app, a test and a write of 30s each, plus 60s of connect retries.
activeDeadlineSeconds: 300
{% endset %}
{% set env %}
- name: PROWLARR_URL
  value: http://{{ container_item.name }}.{{ k8s_namespace }}.svc.cluster.local:{{ container_item.port }}
- name: PROWLARR_API_KEY
  valueFrom:
    secretKeyRef:
      name: {{ container_item.name }}-exportarr
      key: api_key
{% for app in apps %}
- name: {{ app | upper }}_API_KEY
  valueFrom:
    secretKeyRef:
      name: {{ app }}-exportarr
      key: api_key
{% endfor %}
# Renames the Job whenever an app key rotates; `templates/verify/app-keys.yaml.j2` says why.
- name: APP_KEYS_DIGEST8
  value: "{{ (keys.rows | join('\n') | hash('sha256'))[:8] }}"
# Renames the Job whenever prowlarr's Deployment changes.
- name: PROWLARR_DEPLOYMENT_DIGEST8
  value: "{{ (lookup('template', 'deployment.yaml.j2') | hash('sha256'))[:8] }}"
{% endset %}
{{ digest_job(
     name='prowlarr-app-keys',
     script=script,
     script_text=lookup('file', role_file('files/' + script), rstrip=False),
     head=head,
     env=env,
     sa='prowlarr-verify',
     container='seed',
     token_note='# The Job reads Prowlarr\'s API, not the Kubernetes API, so its pod holds no token.',
     annotations='homelab/job-kind: mutation\nhomelab/rerun-safe: k8s/roles/prowlarr/tests/test_seed_prowlarr_app_keys.py::test_a_second_run_writes_nothing') }}
