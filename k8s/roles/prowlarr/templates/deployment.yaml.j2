{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'exportarr.yml.j2' import exportarr with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
{% from 'lsio-env.yml.j2' import lsio_env with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: prowlarr
  namespace: {{ k8s_namespace }}
spec:
  # ReadWriteOnce config PVC: a rolling update deadlocks, the new pod waiting on the old one's
  # volume.
{{ spec_shell('Recreate') }}
  replicas: 1
  # Same budget as the drain's rollout wait (prowlarr_k8s_rollout_timeout).
  progressDeadlineSeconds: {{ prowlarr_k8s_rollout_timeout[:-1] | int }}
  selector:
    matchLabels:
      app: prowlarr
  template:
    metadata:
      labels:
        app: prowlarr
        netpol-baseline: enforced
    spec:
      # No fsGroup: the LSIO image chowns /config itself on startup.
      # No media mount: prowlarr never reads library files, so it gets no write access to them.
{{ pod_shell('homelab-standard') }}
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: prowlarr
          image: {{ prowlarr_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{ container_item.port }}
          # The s6 privilege-drop set; no NET_BIND_SERVICE because prowlarr's port is above 1024.
{{ hardened_security_context(add=['CHOWN', 'SETUID', 'SETGID', 'FOWNER', 'DAC_OVERRIDE']) }}
          env:
{{ lsio_env() }}
            # Prowlarr:Log via the unprefixed env provider; upstream defaults are debug / 50 files.
            - name: PROWLARR__LOG__LEVEL
              value: "{{ prowlarr_k8s_log_level }}"
            - name: PROWLARR__LOG__ROTATE
              value: "{{ prowlarr_k8s_log_rotate }}"
          volumeMounts:
            - name: prowlarr-config
              mountPath: /config
          readinessProbe:
            httpGet:
              path: /ping
              port: {{ container_item.port }}
            initialDelaySeconds: 15
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /ping
              port: {{ container_item.port }}
            initialDelaySeconds: 60
            periodSeconds: 30
{{ container_resources(cpu_limit=prowlarr_k8s_cpu_limit, mem_limit=prowlarr_k8s_mem_limit, cpu_request=prowlarr_k8s_cpu_request, mem_request=prowlarr_k8s_mem_request) }}
        {{ exportarr('prowlarr', prowlarr_k8s_exportarr_image, container_item.port) }}
      volumes:
        - name: prowlarr-config
          persistentVolumeClaim:
            claimName: {{ prowlarr_k8s_claim }}
