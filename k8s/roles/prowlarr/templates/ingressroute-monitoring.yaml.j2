{% from 'ingressroute.yml.j2' import monitoring_route with context %}
---
{# Host traffic to the VIP SNATs to cni0 (traefik's node) or flannel.1 (other node): grant both.
   include_bridge_ip=false because 10.0.0.161 never arrives here; only postflight reads this route. #}
{{ monitoring_route(container_item.name, container_item.hostname, container_item.port, '/api/v1/indexer',
                    extra_client_cidrs=k3s_cni0_gateways + k3s_flannel_node_ips,
                    include_bridge_ip=false) }}
