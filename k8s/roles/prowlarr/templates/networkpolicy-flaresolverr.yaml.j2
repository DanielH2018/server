# Fences flaresolverr (no role of its own): only prowlarr may reach this headless browser.
# Literal macro args: the port is a role default the inventory cannot read, so it would get two
# sources.
{{ networkpolicy('flaresolverr', prowlarr_k8s_flaresolverr_port, ['prowlarr']) }}
