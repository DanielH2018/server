{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
# Its own Deployment rather than a container in prowlarr's pod, deliberately: a sidecar shares the
# pod's network namespace, and "reachable only on localhost by its own pod" would be tighter
# still but would also mean prowlarr and a headless browser rendering hostile pages share a
# netns and a lifecycle. Kept separate, with the NetworkPolicy beside it doing the isolation.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: flaresolverr
  namespace: {{ k8s_namespace }}
spec:
  # No authoritative state: /config is a browser profile cache the app rebuilds on first use, so
  # it is an emptyDir and no RWO constraint forces Recreate. maxUnavailable 0 and maxSurge 1 are
  # meant to make this zero-downtime — on a single replica maxUnavailable 0 forces the new pod
  # Ready before the old one is removed, where the 25% default would round down to 0 anyway but
  # says nothing about intent. That is intent, not a measured result.
  #
  # maxSurge: 1 means two flaresolverr pods can run behind one Service simultaneously for the
  # duration of a rollout, and nothing confirms from FlareSolverr's own docs that this is safe.
  # Assessed risk is low: Prowlarr drives FlareSolverr with sessionless `request.get`/
  # `request.post` calls (a throwaway browser per request), not `sessions.create`, so there is no
  # per-pod session state for a second pod to diverge from or lose. That is an inference from how
  # Prowlarr's indexer proxy integration is used here, not a documented confirmation.
{{ spec_shell('RollingUpdate', max_surge=1, max_unavailable=0) }}
  replicas: 1
  # A cold pull of this image took 8m54s, inside the 600s default only by chance. See
  # prowlarr_k8s_rollout_timeout in defaults/main.yml.
  progressDeadlineSeconds: {{ prowlarr_k8s_rollout_timeout[:-1] | int }}
  selector:
    matchLabels:
      app: flaresolverr
  template:
    metadata:
      labels:
        app: flaresolverr
        # Opted OUT of the namespace baseline. `networkpolicy.yaml.j2` admits only
        # prowlarr on :8191; the baseline is additive, so selecting this pod would ADD traefik,
        # prometheus and both node CIDRs on top — the widening the guard exemption avoids today.
        netpol-baseline-exempt: "true"
    spec:
{{ pod_shell('homelab-standard') }}
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: flaresolverr
          image: {{ prowlarr_k8s_flaresolverr_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{ prowlarr_k8s_flaresolverr_port }}
          # The comment below is what makes this assertable where its LSIO siblings are not:
          # no config chown means no root phase to preserve. It renders untrusted pages, so pinning the uid is worth
          # more here than on a passive workload.
          # Drop ALL with nothing added back. Unlike the LSIO images this one does not chown a
          # config tree on startup, so it needs none of
          # the s6 privilege-drop set.
{{ hardened_security_context(non_root=true, run_as_user=1000) }}
          env:
            # `warning`, not `info`: at info the bulk of the log is the kubelet's own readiness
            # probe hitting `/` every 10s and being logged as a request. A genuine
            # challenge-solve failure raises, and FlareSolverr logs that at ERROR, so it still
            # prints here.
            #
            # The signal that a challenge is failing is not this log: monitor-bridge
            # reads Prowlarr's /api/v1/indexerstatus (files/checks/service.py's
            # `check_prowlarr_indexers`), which is independent of
            # anything FlareSolverr writes to stdout.
            - name: LOG_LEVEL
              value: warning
            # Rendered from prowlarr_k8s_fs_disable_media so the operator reverts a challenge
            # regression by flipping one default, not by editing this manifest. Quoted because
            # a Kubernetes env value is a string and `true` unquoted is a YAML boolean.
            - name: DISABLE_MEDIA
              value: "{{ prowlarr_k8s_fs_disable_media | bool | string | lower }}"
            - name: TZ
              value: "{{ tz }}"
          volumeMounts:
            - name: flaresolverr-config
              mountPath: /config
          readinessProbe:
            httpGet:
              path: /
              port: {{ prowlarr_k8s_flaresolverr_port }}
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: {{ prowlarr_k8s_flaresolverr_port }}
            initialDelaySeconds: 60
            periodSeconds: 30
{{ container_resources(cpu_limit=prowlarr_k8s_fs_cpu_limit, mem_limit=prowlarr_k8s_fs_mem_limit, cpu_request=prowlarr_k8s_fs_cpu_request, mem_request=prowlarr_k8s_fs_mem_request) }}
      volumes:
        - name: flaresolverr-config
          # sizeLimit caps the profile. Most siblings here
          # use a bare `emptyDir: {}`, but this one holds a Chrome profile: uncapped, runaway
          # growth becomes node ephemeral-storage pressure and the kubelet evicts OTHER pods on
          # the node, turning one browser's disk leak into someone else's outage. Capped, the
          # blast radius is the pod that caused it.
          emptyDir:
            sizeLimit: 1Gi
