{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
# Own Deployment, not a sidecar: a headless browser rendering hostile pages must not share
# prowlarr's netns and lifecycle; the NetworkPolicy beside it does the isolation.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: flaresolverr
  namespace: {{ k8s_namespace }}
spec:
  # maxSurge 1 runs two pods behind one Service mid-rollout; docs do not confirm that is safe.
  # Inferred low risk: Prowlarr's sessionless request.get/post calls leave no per-pod session state.
{{ spec_shell('RollingUpdate', max_surge=1, max_unavailable=0) }}
  replicas: 1
  # Sized by prowlarr_k8s_rollout_timeout; a cold pull of this image takes 8m54s.
  progressDeadlineSeconds: {{ prowlarr_k8s_rollout_timeout[:-1] | int }}
  selector:
    matchLabels:
      app: flaresolverr
  template:
    metadata:
      labels:
        app: flaresolverr
        # Exempt from the baseline: it is additive and would add traefik, prometheus and node CIDRs
        # on top of the NetworkPolicy that admits only prowlarr on :8191.
        netpol-baseline-exempt: "true"
    spec:
{{ pod_shell('homelab-standard') }}
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: flaresolverr
          image: {{ prowlarr_k8s_flaresolverr_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{ prowlarr_k8s_flaresolverr_port }}
          # Drop ALL with nothing added: this image does not chown config at startup, so no root
          # phase exists. Pin the uid: it renders untrusted pages.
{{ hardened_security_context(non_root=true, run_as_user=1000) }}
          env:
            # `warning`, not `info`: at info the log is mostly readiness probes; solve failures log
            # at ERROR.
            # The failing-challenge signal is monitor-bridge's prowlarr_indexers check, not this
            # log.
            - name: LOG_LEVEL
              value: warning
            # Quoted: a Kubernetes env value is a string and bare `true` is a YAML boolean.
            - name: DISABLE_MEDIA
              value: "{{ prowlarr_k8s_fs_disable_media | bool | string | lower }}"
            - name: TZ
              value: "{{ tz }}"
          volumeMounts:
            - name: flaresolverr-config
              mountPath: /config
          readinessProbe:
            httpGet:
              path: /
              port: {{ prowlarr_k8s_flaresolverr_port }}
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: {{ prowlarr_k8s_flaresolverr_port }}
            initialDelaySeconds: 60
            periodSeconds: 30
{{ container_resources(cpu_limit=prowlarr_k8s_fs_cpu_limit, mem_limit=prowlarr_k8s_fs_mem_limit, cpu_request=prowlarr_k8s_fs_cpu_request, mem_request=prowlarr_k8s_fs_mem_request) }}
      volumes:
        - name: flaresolverr-config
          # sizeLimit caps the Chrome profile: runaway growth would cause node ephemeral-storage
          # pressure and evict OTHER pods.
          emptyDir:
            sizeLimit: 1Gi
