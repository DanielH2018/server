{% from 'ingressroute.yml.j2' import ingressroute with context %}
---
{# use_authelia false: forward-auth breaks the companion app, webhooks, and long-lived tokens.
   HA's own login + TOTP is the gate; TLS/CrowdSec/rate-limit still apply. #}
{{ ingressroute(
    container_item.name,
    container_item.hostname | default(container_item.name),
    container_item.port,
    container_item.use_authelia,
  )
}}
