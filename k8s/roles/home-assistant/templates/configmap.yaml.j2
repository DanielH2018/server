---
# lookup('file'), not 'template': verbatim copy, so a regression to real templating fails the deploy
# loudly.
# Keep ConfigMap names: kubectl apply leaves a renamed one live. The lists in defaults/main.yml
# bound each tree.
{% set config_trees = [
     ('home-assistant-config', '', home_assistant_root_files),
     ('home-assistant-automations', 'automations/', home_assistant_automation_files),
     ('home-assistant-scripts', 'scripts/', home_assistant_script_files),
     ('home-assistant-custom-templates', 'custom_templates/', home_assistant_template_files),
   ] %}
{% for configmap_name, subdir, names in config_trees %}
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ configmap_name }}
  namespace: {{ k8s_namespace }}
data:
{% for name in names %}
  {{ name }}: |
{{ lookup('file', role_file('files/' + subdir + name)) | indent(4, true) }}
{% endfor %}
{% if not loop.last %}
---
{% endif %}
{% endfor %}
