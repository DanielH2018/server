---
# Flux strips newlines from a substituted value, so no `${...}` placeholder can carry this JSON;
# it ships SOPS-encrypted.
apiVersion: v1
kind: Secret
metadata:
  name: home-assistant-google-sa
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  google_service_account.json: {{ google_assistant_service_account | to_json }}
