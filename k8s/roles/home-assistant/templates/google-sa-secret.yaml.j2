---
# Home Assistant's Google service account: the whole downloaded JSON key, from the SOPS key
# google_assistant_service_account. The init container installs it beside secrets.yaml, and
# configuration.yaml reads it with `service_account: !include google_service_account.json`.
#
# A Secret of its own because the value is multi-line: Flux strips every newline from a
# substituted value, so no `${...}` placeholder can carry it, and D3 ships this Secret as a
# SOPS-encrypted manifest instead (target slice R2, PR 5). `render_sops_manifests` in
# defaults/main.yml names this file, so a placeholder render leaves it out. `to_json` writes
# the stored JSON text as one double-quoted scalar, newlines escaped.
apiVersion: v1
kind: Secret
metadata:
  name: home-assistant-google-sa
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  google_service_account.json: {{ google_assistant_service_account | to_json }}
