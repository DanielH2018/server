{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
{% from 'lsio-env.yml.j2' import lsio_env with context %}
{# Keyed as in configmap.yaml.j2; the three subdirectories are swept by pattern before the install,
   the root is not. #}
{% set config_trees = [
     ('home-assistant-config', 'root'),
     ('home-assistant-automations', 'automations'),
     ('home-assistant-scripts', 'scripts'),
     ('home-assistant-custom-templates', 'custom_templates'),
   ] %}
{% set config_subdirs = [
     ('automations', '*.yaml'),
     ('scripts', '*.yaml'),
     ('custom_templates', '*.jinja'),
   ] %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: home-assistant
  namespace: {{ k8s_namespace }}
spec:
  # Recreate is load-bearing: the PVC is RWO, and two HAs on one MQTT broker and recorder must never
  # coexist.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: home-assistant
  template:
    metadata:
      labels:
        app: home-assistant
        netpol-baseline: enforced
    spec:
      # DECIDED: every Deployment of a home-critical entry is pinned to k8s_primary_node (#3452).
      # Traefik, pihole and mosquitto must run on the node that announces their MetalLB VIPs, so
      # the house already stops working when that node goes down. HA, authelia and its redis,
      # the crowdsec engine and zigbee2mqtt, left free to land on daniel-server, would make it
      # a second node whose loss breaks SSO and home automation. Pinning them costs no
      # availability the VIP pins had not already spent, and the pin moves with
      # k8s_primary_node. The `home-critical-workloads-pinned-to-the-vip-node`
      # row in tests/k8s/rendered_properties/_edge_property_rows.py derives the set from `tier`.
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_primary_node }}
{{ pod_shell(services | tier_priority_class('home-assistant')) }}
      initContainers:
        # Each ConfigMap is mounted at /cm/<tree> and installed by glob; the root glob is `*`
        # because it carries .py too.
        # automations/, scripts/, custom_templates/ are cleared first (`install` only overwrites); a
        # removed root file needs a manual PVC delete.
        - name: config-install
          image: {{ home_assistant_k8s_init_image }}
          imagePullPolicy: IfNotPresent
          command:
            - sh
            - -ec
            - |
              install -m 644 /cm/root/* /config/
              install -m 600 /sec/secrets.yaml /config/secrets.yaml
              install -m 600 /sec/google_service_account.json /config/google_service_account.json
              rm -f /config/automations.yaml /config/scripts.yaml
{% for subdir, pattern in config_subdirs %}
              mkdir -p /config/{{ subdir }}
              find /config/{{ subdir }} -maxdepth 1 -name '{{ pattern }}' -delete
              install -m 644 /cm/{{ subdir }}/{{ pattern }} /config/{{ subdir }}/
{% endfor %}
          # Run as PUID, not root: all caps are dropped, so root without DAC_OVERRIDE cannot
          # overwrite uid-1000 files.
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=puid, run_as_group=pgid) }}
          volumeMounts:
{% for configmap_name, subdir in config_trees %}
            - name: {{ configmap_name }}-files
              mountPath: /cm/{{ subdir }}
              readOnly: true
{% endfor %}
            - name: home-assistant-config-secrets
              mountPath: /sec
              readOnly: true
            - name: home-assistant-config
              mountPath: /config
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
      containers:
        - name: home-assistant
          image: {{ home_assistant_k8s_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{ container_item.port }}
          # Drop ALL, add the s6 privilege-drop set. No
          # NET_BIND_SERVICE — HA binds 8123. allowPrivilegeEscalation false mirrors
          # no-new-privileges:true (s6 goes root -> PUID, never up).
{{ hardened_security_context(add=['CHOWN', 'SETUID', 'SETGID', 'FOWNER', 'DAC_OVERRIDE']) }}
          env:
{{ lsio_env() }}
          volumeMounts:
            - name: home-assistant-config
              mountPath: /config
            # HA's .cache is re-derived; kopia excluded it (.cache/), and on block-level backups its churn is what costs.
            - name: home-assistant-cache
              mountPath: /config/.cache
          # HA is a slow first-booter: the LSIO permissions pass, then core start before
          # :8123 binds.
          # DECIDED: exec-curl to 127.0.0.1, not httpGet — HA's ip_ban middleware runs on EVERY
          # request, and it keys on the peer address. A kubelet httpGet arrives from the node's
          # pod-network gateway (10.42.0.1), so once anything gets that IP banned HA answers 403
          # and kubelet kills the container it just banned — a self-inflicted crash loop. From inside the container the peer is
          # 127.0.0.1, which no ban can reach. Readiness moves too: fixing liveness alone just
          # relocates the outage to a yanked Service endpoint.
          # curl over tcpSocket: tcpSocket also escapes the ban but stops proving HTTP works, so a
          # wedged HA still holding the listener would pass. curl is present in this image.
          # timeoutSeconds: exec probes default to 1s; curl -m 4 keeps curl's deadline inside it.
          readinessProbe:
            exec:
              command: ["sh", "-c", "curl -fsm 4 http://127.0.0.1:{{ container_item.port }}/ >/dev/null"]
            initialDelaySeconds: 30
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 12
          livenessProbe:
            exec:
              command: ["sh", "-c", "curl -fsm 4 http://127.0.0.1:{{ container_item.port }}/ >/dev/null"]
            initialDelaySeconds: 180
            periodSeconds: 30
            timeoutSeconds: 5
{{ container_resources(cpu_limit=home_assistant_k8s_cpu_limit, mem_limit=home_assistant_k8s_mem_limit, cpu_request=home_assistant_k8s_cpu_request, mem_request=home_assistant_k8s_mem_request) }}
      volumes:
{% for configmap_name, subdir in config_trees %}
        - name: {{ configmap_name }}-files
          configMap:
            name: {{ configmap_name }}
{% endfor %}
        # Both Secrets at /sec: secrets.yaml, and the Google service account, which has a
        # Secret of its own because its multi-line value cannot pass through a Flux placeholder
        # (templates/google-sa-secret.yaml.j2).
        - name: home-assistant-config-secrets
          projected:
            sources:
              - secret:
                  name: home-assistant-secrets
              - secret:
                  name: home-assistant-google-sa
        - name: home-assistant-config
          persistentVolumeClaim:
            claimName: {{ home_assistant_k8s_claim }}
        - name: home-assistant-cache
          emptyDir: {}
