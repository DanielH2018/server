---
# The App has its own rate limit, so a drained operator quota cannot stop a status post.
# A Secret of its own: the PEM is multi-line and Flux types a standalone all-digit value as a
# number, so no placeholder carries these; it ships as a SOPS-encrypted manifest.
# The IDs are quoted, never `| to_json`: SOPS types an all-digit key int and the API server refuses
# bare digits as stringData. A rotation restarts nothing.
apiVersion: v1
kind: Secret
metadata:
  name: flux-github-status
  namespace: {{ flux_namespace }}
type: Opaque
stringData:
  githubAppID: "{{ flux_github_app_id }}"
  githubAppInstallationID: "{{ flux_github_app_installation_id }}"
  githubAppPrivateKey: {{ flux_github_app_private_key | to_json }}
