{#
  Prometheus's scrape path to the controllers' metrics port, and nothing else. It replaces
  upstream's `allow-scraping`, which the vendoring filter drops because it admits every
  namespace to TCP 8080. Upstream's `allow-egress` stays in the vendored file: it selects every
  pod in flux-system and admits ingress only from pods there, so it is the namespace's
  default-deny, and its same-namespace rule carries artifact fetches and controller events.
  Upstream's `allow-webhooks` is dropped too, because no Receiver exists; a change that adds one
  adds its fence with it.
#}
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: flux-allow-prometheus
  namespace: {{ flux_namespace }}
spec:
  podSelector: {}
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ k8s_observability_namespace }}
          podSelector:
            matchLabels:
              app: prometheus
      ports:
        - port: 8080
          protocol: TCP
