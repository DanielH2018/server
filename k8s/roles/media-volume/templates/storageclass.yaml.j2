---
# WaitForFirstConsumer binds the claim only once the consuming pod's node is known, so a pod that
# cannot run on the primary node stays Pending.
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: {{ media_volume_storage_class }}
provisioner: kubernetes.io/no-provisioner
volumeBindingMode: WaitForFirstConsumer
reclaimPolicy: Retain
