---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: {{ media_volume_claim }}
spec:
  capacity:
    # Advisory. See media_volume_size in the role defaults — no quota enforces this.
    storage: {{ media_volume_size }}
  accessModes:
    # RWX is accurate: nodeAffinity pins every pod to this node, which bind-mounts one directory.
    # RWO would also work but misdescribe the intent.
    - ReadWriteMany
  # Retain: deleting the claim must not delete an unbacked library. Recovery trap: deleting the PVC
  # leaves the PV Released holding a stale claimRef UID, so a same-named PVC will not rebind.
  # Clear it: k3s kubectl patch pv {{ media_volume_claim }} -p '{"spec":{"claimRef":null}}'
  persistentVolumeReclaimPolicy: Retain
  storageClassName: {{ media_volume_storage_class }}
  # `local`, not `hostPath`: it supports nodeAffinity, so the scheduler enforces the pin.
  local:
    path: {{ media_volume_host_path }}
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - key: kubernetes.io/hostname
              operator: In
              values:
                - {{ k8s_primary_node }}
  # Pre-bound by name so no other PVC of the same class and size can capture it.
  claimRef:
    namespace: {{ k8s_namespace }}
    name: {{ media_volume_claim }}
