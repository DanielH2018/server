---
# On the node's own address: the router's 7777 forward targets the device daniel-box.
# Local policy keeps real client addresses; no Traefik, since the game is raw TCP.
apiVersion: v1
kind: Service
metadata:
  name: terraria
  namespace: {{ k8s_namespace }}
spec:
  type: LoadBalancer
  externalTrafficPolicy: Local
  externalIPs:
    - {{ hosts[k8s_primary_node].server_ip }}
  selector:
    app: terraria
  ports:
    - name: game
      port: 7777
      targetPort: 7777
      protocol: TCP
