{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: n8n
  namespace: {{ k8s_namespace }}
spec:
  # Recreate: an RWO volume deadlocks a rolling update, and two n8n processes on one SQLite file
  # corrupt it.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: n8n
  template:
    metadata:
      labels:
        app: n8n
        # Exempt here, not on the runners: n8n-broker selects `app: n8n` only, so the baseline is
        # the only fence on the runners.
        netpol-baseline-exempt: "true"
    spec:
{{ pod_shell('homelab-best-effort') }}
      # Prefers daniel-box: CPU-bound workflow execution — daniel-box has 16 threads to daniel-server's 8.
{{ node_affinity_preference(k8s_primary_node) }}
      containers:
        - name: n8n
          image: {{ n8n_k8s_image }}
          # Mutable tag: without Always a rebuilt image is never picked up.
          imagePullPolicy: Always
          ports:
            - containerPort: {{ container_item.port }}
            - containerPort: {{ n8n_k8s_broker_port }}
          # Explicit uid pins the image's `USER node`, a name the kubelet refuses under
          # runAsNonRoot; drop ALL since the tree is uid 1000.
{{ hardened_security_context(non_root=true, run_as_user=1000) }}
          env:
            - name: TZ
              value: "{{ tz }}"
            - name: GENERIC_TIMEZONE
              value: "{{ tz }}"
            - name: NODE_ENV
              value: production
            # N8N_WEBHOOK_URL must be the hostname webhook callers use: a wrong value goes ready but
            # registers webhooks against a name nobody calls.
            # N8N_WEBHOOK_URL, not WEBHOOK_URL; it does not expose /webhook-test/, which Traefik
            # keeps off the public edge.
            - name: N8N_HOST
              value: "{{ container_item.hostname | default(container_item.name) }}.{{ domain }}"
            - name: N8N_WEBHOOK_URL
              value: "https://{{ container_item.hostname | default(container_item.name) }}.{{ domain }}/"
            - name: N8N_PORT
              value: "{{ container_item.port }}"
            - name: N8N_PROTOCOL
              value: https
            # DECIDED: 2 hops, and it must not drop to 1. Getting this wrong does not break
            # routing; it makes n8n attribute every request to the wrong client IP, which is
            # what its login throttling and audit log key on. The two hops on a public request
            # are Cloudflare and the cluster Traefik — Cloudflare's ranges sit in
            # `forwardedHeaders.trustedIPs` on both entrypoints (see the traefik role's
            # cloudflare-ip-drift.sh.j2), so it is a trusted proxy that sets X-Forwarded-For
            # and counts.
            - name: N8N_PROXY_HOPS
              value: "2"
            - name: N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS
              value: "true"
            # N8N_TEMPLATES_ENABLED=false removes the editor's workflow-templates panel; set it back
            # to "true" to restore it.
            - name: N8N_DIAGNOSTICS_ENABLED
              value: "false"
            - name: N8N_VERSION_NOTIFICATIONS_ENABLED
              value: "false"
            - name: N8N_TEMPLATES_ENABLED
              value: "false"
            - name: N8N_HIRING_BANNER_ENABLED
              value: "false"
            # Community node packages, installed from the editor's Settings → Community
            # nodes panel. n8n's default is DISABLED.
            #
            # The install path is PVC state, not image state: n8n npm-installs each package
            # under `$N8N_USER_FOLDER/.n8n/nodes`, N8N_USER_FOLDER is unset fleet-wide, so the
            # path is /home/node/.n8n/nodes — a child of the n8n-data PVC mounted below. The
            # `.cache` emptyDir shadows only /home/node/.n8n/.cache, never `nodes`. So an
            # installed package survives a pod restart and an image rebuild, and NOTHING in
            # this repo records which packages are installed. See this role's CLAUDE.md.
            - name: N8N_COMMUNITY_PACKAGES_ENABLED
              value: "true"
            # Held at "true": installed packages cannot be enumerated, so tightening has an
            # unmeasurable blast radius.
            - name: N8N_UNVERIFIED_PACKAGES_ENABLED
              value: "true"
            # N8N_REINSTALL_MISSING_PACKAGES makes n8n npm-install, at boot, any package the
            # database records but /home/node/.n8n/nodes lacks. Held at upstream's default of
            # false: on this deployment `nodes/` and `database.sqlite` are BOTH children of
            # the n8n-data PVC, so a fresh or restored claim moves them together and the
            # rows-without-files state this flag repairs does not arise. Enabling it would put
            # an npm registry fetch on the startup path for no case that can occur here.
            - name: N8N_REINSTALL_MISSING_PACKAGES
              value: "false"
            # N8N_COMMUNITY_PACKAGES_ALLOW_TOOL_USAGE is not set: the variable does not exist at
            # 2.38.5, so it would be an inert line.
            # N8N_RUNNERS_ENABLED is not set: no longer needed.
            - name: NODE_RUNNERS_ENABLED
              value: "true"
            - name: N8N_RUNNERS_MODE
              value: external
            # The broker binds all interfaces; networkpolicy.yaml.j2 narrows it to the runners pod,
            # and the token is the second layer.
            - name: N8N_RUNNERS_BROKER_LISTEN_ADDRESS
              value: 0.0.0.0
            - name: N8N_NATIVE_PYTHON_RUNNER
              value: "true"
            - name: N8N_RUNNERS_TASK_REQUEST_TIMEOUT
              value: "300"
            # Three defaults n8n 2.41.6 logs as shrinking in a future version, pinned at the
            # upstream defaults of 2.41.6, except the task timeout, which is lowered on purpose. Unset, a
            # Renovate digest bump would cut them silently. Defaults read from
            # packages/@n8n/config/src/configs/{runners,compression}.config.ts at `n8n@2.41.6`.
            #
            # DECIDED: 60 s, the same value deployment-runners.yaml.j2 gives the runners. Two
            # timeouts apply: this one is the BROKER's limit (upstream default 300 s, dropping
            # to 60), and the runner aborts a task at its own. The operator chose 60 because the
            # runners pod executes arbitrary workflow code, and a short task limit backs up its
            # resource cap as the DoS guard.
            # To let Code nodes run longer, raise BOTH, or the lower one still wins.
            - name: N8N_RUNNERS_TASK_TIMEOUT
              value: "60"
            - name: N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES
              value: "2147483648"
            - name: N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES
              value: "5000"
            # Keeps database.sqlite small (execution history once reached 840M, and its daily
            # page churn drove B2 billable growth). The
            # Kopia backup only needs workflows and credentials, so successful-run data is not
            # saved at all (the operator never reads it; errors still are), the rest is pruned
            # after 3 days, and the DB is compacted on startup so the space returns to the
            # filesystem. At 168h with save-all the post-vacuum DB was still 214M.
            - name: EXECUTIONS_DATA_SAVE_ON_SUCCESS
              value: none
            - name: EXECUTIONS_DATA_PRUNE
              value: "true"
            - name: EXECUTIONS_DATA_MAX_AGE
              value: "72"
            - name: DB_SQLITE_VACUUM_ON_STARTUP
              value: "true"
            # Renames /home/node/.n8n/binaryData to /home/node/.n8n/storage at boot, the move
            # n8n v3 makes by default. It is one renameSync inside the n8n-data claim,
            # and no volume mounts either path. n8n then records `fsStorageMigrated` in
            # /home/node/.n8n/config, merged into the settings that hold the encryption key,
            # and skips the check on every later boot, so the flag stays inert once it has run.
            # Boot fails with StoragePathError if `storage` already exists beside `binaryData`;
            # to recover, drop this flag and redeploy. Read from
            # packages/core/src/storage.config.ts at `n8n@2.41.6`.
            - name: N8N_MIGRATE_FS_STORAGE_PATH
              value: "true"
            - name: N8N_RUNNERS_AUTH_TOKEN
              valueFrom:
                secretKeyRef:
                  name: n8n
                  key: N8N_RUNNERS_AUTH_TOKEN
          volumeMounts:
            - name: n8n-data
              mountPath: /home/node/.n8n
            - name: n8n-files
              mountPath: /files
            # n8n's .cache is re-derived (kopia's .cache/ rule).
            - name: n8n-cache
              mountPath: /home/node/.n8n/.cache
          readinessProbe:
            httpGet:
              path: /healthz
              port: {{ container_item.port }}
            initialDelaySeconds: 30
            periodSeconds: 10
          # Generous initialDelay: VACUUM_ON_STARTUP rewrites the database, and killing it
          # mid-vacuum can leave a file a restart does not fix.
          livenessProbe:
            httpGet:
              path: /healthz
              port: {{ container_item.port }}
            initialDelaySeconds: 120
            periodSeconds: 30
{{ container_resources(cpu_limit=n8n_k8s_cpu_limit, mem_limit=n8n_k8s_mem_limit, cpu_request=n8n_k8s_cpu_request, mem_request=n8n_k8s_mem_request) }}
      volumes:
        - name: n8n-data
          persistentVolumeClaim:
            claimName: {{ n8n_k8s_claim }}
        - name: n8n-files
          persistentVolumeClaim:
            claimName: {{ n8n_k8s_files_claim }}
        - name: n8n-cache
          emptyDir: {}
