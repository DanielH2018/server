{% from 'ingressroute.yml.j2' import ingressroute with context %}
---
{# /webhook/ needs no route here: the bridge route carries no Authelia, paired with the Docker edge's
   bridge_bypass_prefixes. #}
{# DECIDED: the UI keeps its public name despite near-zero traffic, by operator ruling 2026-11-15 (#8514). #}
{{ ingressroute(
    container_item.name,
    container_item.hostname | default(container_item.name),
    container_item.port,
    container_item.use_authelia,
    bypass_prefixes=container_item.bridge_bypass_prefixes | default([])
  )
}}
{# No n8n-monitoring route: /api/v1 is read-write, so X-N8N-API-KEY would be the only gate. Add one
   only via monitoring_route(). #}
