{#
  The verify Job's identity, rendered into `n8n-verify` beside `job.yaml.j2`.

  It is a ServiceAccount with no Role. The Job dials traefik and n8n over the pod network and
  execs into no pod, so it needs no Kubernetes grant, and its pod mounts no token.
#}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: n8n-verify
  namespace: {{ k8s_namespace }}
automountServiceAccountToken: false
