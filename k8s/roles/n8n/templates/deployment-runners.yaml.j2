{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: n8n-runners
  namespace: {{ k8s_namespace }}
spec:
{{ spec_shell('RollingUpdate') }}
  replicas: 1
  selector:
    matchLabels:
      app: n8n-runners
  template:
    metadata:
      labels:
        app: n8n-runners
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-best-effort') }}
      initContainers:
        # Gate on the SERVICE (no endpoints until ready), on port 5679 so it also proves the
        # NetworkPolicy admits this pod.
        - name: wait-for-broker
          image: {{ n8n_k8s_wait_image }}
          imagePullPolicy: IfNotPresent
          command:
            - sh
            - -c
            - until nc -z n8n {{ n8n_k8s_broker_port }}; do sleep 5; done
{{ hardened_security_context() }}
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
      # Prefers daniel-box: CPU-bound workflow execution — daniel-box has 16 threads to daniel-server's 8.
{{ node_affinity_preference(k8s_primary_node) }}
      containers:
        - name: n8n-runners
          image: {{ n8n_k8s_runners_image }}
          imagePullPolicy: Always
          # Pinned uid: the image's `USER runner` could move to 0 on a rebuild, and this workload
          # runs arbitrary workflow code.
{{ hardened_security_context(non_root=true, run_as_user=1000) }}
          env:
            - name: N8N_RUNNERS_TASK_BROKER_URI
              value: "http://n8n:{{ n8n_k8s_broker_port }}"
            - name: N8N_RUNNERS_AUTH_TOKEN
              valueFrom:
                secretKeyRef:
                  name: n8n
                  key: N8N_RUNNERS_AUTH_TOKEN
            # Launcher defaults; `allowed-env` passes only what is set in the launcher's
            # environment.
            # 60 s is the Code-node limit and must match the n8n Deployment's
            # N8N_RUNNERS_TASK_TIMEOUT, since the runner aborts at its own timeout.
            - name: N8N_RUNNERS_TASK_TIMEOUT
              value: "60"
            - name: N8N_RUNNERS_AUTO_SHUTDOWN_TIMEOUT
              value: "15"
          # No HTTP endpoint to probe: exec probe on the launcher process.
          livenessProbe:
            exec:
              command:
                - pgrep
                - -f
                - task-runner-launcher
            initialDelaySeconds: 30
            periodSeconds: 30
{{ container_resources(cpu_limit=n8n_k8s_cpu_limit, mem_limit=n8n_k8s_mem_limit, cpu_request=n8n_k8s_cpu_request, mem_request=n8n_k8s_runners_mem_request) }}
