# Use the official n8n image as the base.
#
# PINNED, and it must stay pinned. A `:latest` FROM has no updater: Renovate has no version to
# bump, so there is no PR, no commit, and no gitops tick, and n8n stays on an old release.
# An explicit ref is what Renovate's built-in dockerfile manager reads. It raises a PR (no
# automerge — the automerge rules match custom.regex managers only), a person merges it, and
# promote builds and rolls the merged commit. That is the posture n8n's `k8s_autodeploy: false` asks
# for.
#
# CHANNEL + DIGEST, not a version. `:latest` is an alias for `:stable`, so pinning a bare version
# would move n8n off the STABLE channel and hand the update stream to Renovate's docker datasource,
# which reads every published tag and so runs AHEAD of stable.
#
# The tag names the channel; the digest is what Renovate bumps, so a PR arrives exactly when n8n
# promotes a new stable, and an unpromoted release is never offered.
#
# LOCKSTEP with Dockerfile-runners.j2: n8n and its task runners are version-coupled, both
# repositories publish a `stable` tag, and renovate.json groups them into one PR.
# test_renovate_managers.py asserts the two carry the same TAG — their digests differ by design,
# since they are different images.
#
# EVERY DIGEST BUMP APPENDS A ROW TO ../base-pin-history.tsv. The tag never moves, so a bump
# changes only 64 hex characters and the diff cannot show which way the version went. That file's
# header has the registry commands for resolving a digest to its version, and
# test_renovate_dockerfiles.py fails until the row is appended.
FROM n8nio/n8n:stable@sha256:fabce3e9678a07d2dde83bd8f5124017f3ec457d0a3fc6b63bb4cec465d63861

# Switch to the root user to install packages
USER root

# Force npm to use /usr/local
ENV NPM_CONFIG_PREFIX=/usr/local

# fuzzball, the one npm package this image adds. PINNED: a bare `npm install -g
# fuzzball` takes whatever npm serves on build day, and nothing records which version a running
# pod carries. The renovate.json regex manager over this line (npm datasource) raises a PR when
# a new release ships; it merges by hand, and promote's `images` job then builds the moved
# content tag, since a built image only moves when something rebuilds it.
RUN npm install -g fuzzball@2.2.6

# Switch back to the non-privileged 'node' user
USER node
