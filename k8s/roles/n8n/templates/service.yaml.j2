{% from 'service.yml.j2' import service with context %}
---
# ONE Service with both ports so runners keep http://n8n:5679; a second Service would not isolate
# (any pod can dial a ClusterIP), the NetworkPolicy does.
{{ service(
    'n8n',
    container_item.port,
    extra_ports=[{'name': 'broker', 'port': n8n_k8s_broker_port}]
  ) -}}
