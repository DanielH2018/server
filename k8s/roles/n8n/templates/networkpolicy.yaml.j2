---
# The broker binds 0.0.0.0:5679, and a client holding N8N_RUNNERS_AUTH_TOKEN can register a runner
# (arbitrary code); this narrows it to the runners pod.
# The same policy also fences 5678.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: n8n-broker
  namespace: {{ k8s_namespace }}
spec:
  podSelector:
    matchLabels:
      app: n8n
  policyTypes:
    - Ingress
  ingress:
    # 5678: traefik and monitor-bridge only. A rule with no `from:` would admit every pod; probes
    # need no rule.
    - from:
        - podSelector:
            matchLabels:
              app: traefik
        - podSelector:
            matchLabels:
              app: monitor-bridge
      ports:
        - protocol: TCP
          port: {{ container_item.port }}
    # 5679 is the point of the file.
    - from:
        - podSelector:
            matchLabels:
              app: n8n-runners
      ports:
        - protocol: TCP
          port: {{ n8n_k8s_broker_port }}
