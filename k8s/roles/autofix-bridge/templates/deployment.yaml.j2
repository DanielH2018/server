{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: autofix-bridge
  namespace: {{ k8s_namespace }}
spec:
  # One remediation actor: candidate-grace streaks are in-process, and two pods could act on one
  # item.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: autofix-bridge
  template:
    metadata:
      labels:
        app: autofix-bridge
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-best-effort', run_as_user=puid, run_as_group=pgid, non_root=true) }}
      # Off daniel-server: its drain and cold boot must not take the remediation loop down.
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_primary_node }}
      containers:
        - name: autofix-bridge
          image: {{ autofix_bridge_k8s_image }}
          imagePullPolicy: IfNotPresent
          command: ["python", "/app/autofix.py"]
          ports:
            - name: checks
              containerPort: {{ services | metrics_port('autofix-bridge') }}
{{ hardened_security_context(read_only=true) }}
          # A quoted number belongs here, never in the Secret: Flux's typed patch reads a Secret's
          # "300" back as a number and refuses it.
          env:
            - name: TZ
              value: "{{ tz }}"
            - name: PYTHONUNBUFFERED
              value: "1"
            - name: PYTHONDONTWRITEBYTECODE
              value: "1"
            - name: INTERVAL
              value: "300"
            - name: CHECK_EXPORTER_PORT
              value: "{{ services | metrics_port('autofix-bridge') }}"
            # LIVE remediation: this role's CLAUDE.md autonomous-role contract governs any change.
            - name: DRY_RUN
              value: "false"
            - name: GRACE_CYCLES
              value: "3"
            - name: MAX_ACTIONS_PER_CYCLE
              value: "5"
            - name: DANGEROUS_MSG_PATTERNS
              value: executable file with extension,potentially dangerous,sample
            - name: SONARR_URL
              value: http://sonarr.{{ k8s_namespace }}.svc.cluster.local:8989
            - name: RADARR_URL
              value: http://radarr.{{ k8s_namespace }}.svc.cluster.local:7878
          envFrom:
            - secretRef:
                name: autofix-bridge-env
          # autofix.py touches /tmp/heartbeat after every completed cycle; a stale mtime means the
          # loop HUNG.
          livenessProbe:
            exec:
              command:
                - python3
                - -c
                - "import os,sys,time; sys.exit(0 if time.time()-os.stat('/tmp/heartbeat').st_mtime<1000 else 1)"
            initialDelaySeconds: 120
            periodSeconds: 60
            failureThreshold: 3
          volumeMounts:
            - name: autofix-bridge-script
              mountPath: /app
              readOnly: true
            - name: autofix-bridge-tmp
              mountPath: /tmp
          # 1 core, not 100m: a periodic poller's sub-second burst exhausts a 100m quota while the
          # average reads near zero.
{{ container_resources(cpu_limit='1', mem_limit='64Mi', cpu_request='20m', mem_request='32Mi') }}
      volumes:
        - name: autofix-bridge-script
          configMap:
            name: autofix-bridge-script
            items:
{% for item in autofix_bridge_modules %}
              - key: {{ item.name }}
                path: {{ item.path }}
{% endfor %}
        - name: autofix-bridge-tmp
          emptyDir: {}
