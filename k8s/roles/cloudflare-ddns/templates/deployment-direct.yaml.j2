{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cloudflare-ddns-direct
  namespace: {{ k8s_namespace }}
spec:
{{ spec_shell('RollingUpdate') }}
  replicas: 1
  selector:
    matchLabels:
      app: cloudflare-ddns-direct
  template:
    metadata:
      labels:
        app: cloudflare-ddns-direct
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-best-effort') }}
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: cloudflare-ddns
          image: {{ cloudflare_ddns_k8s_image }}
          imagePullPolicy: IfNotPresent
          # uid pinned with the assertion: `runAsNonRoot` alone does not pin one, and the
          # kubelet refuses a container whose image names its user instead of numbering it.
          # `/bin/ddns` measured at uid 1000 on 2026-08-31.
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=1000) }}
          env:
            - name: CLOUDFLARE_API_TOKEN_FILE
              value: /etc/ddns-secrets/cf_dns_token
            # terraria and valheim (reactivated onto k3s 2026-08-13) are live; minecraft is
            # still archived, and its record stays out — publishing an A record for a game
            # server that does not exist points the unproxied home IP at nothing and
            # needlessly exposes the raw IP. Re-add a domain here when its server comes back.
            - name: DOMAINS
              value: "terraria.{{ domain }},valheim.{{ domain }}"
            - name: PROXIED
              value: "false"
            - name: IP6_PROVIDER
              value: none
          volumeMounts:
            # /etc, not /run/secrets: this image (scratch-based) lacks the /var/run
            # symlink so the old path happened to work, but the convention guard bans the
            # class — on any distro-based image it shadows the ServiceAccount token mount.
            - name: cloudflare-ddns-token
              mountPath: /etc/ddns-secrets
              readOnly: true
{{ container_resources(cpu_limit=cloudflare_ddns_k8s_cpu_limit, mem_limit=cloudflare_ddns_k8s_mem_limit, cpu_request=cloudflare_ddns_k8s_cpu_request, mem_request=cloudflare_ddns_k8s_mem_request) }}
      volumes:
        - name: cloudflare-ddns-token
          secret:
            secretName: cloudflare-ddns
            items:
              - key: cf_dns_token
                path: cf_dns_token
