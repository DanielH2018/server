{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: tft-assistant
  namespace: {{ k8s_namespace }}
spec:
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: tft-assistant
  template:
    metadata:
      labels:
        app: tft-assistant
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-best-effort', run_as_user=tft_assistant_k8s_uid, run_as_group=tft_assistant_k8s_uid, fs_group=tft_assistant_k8s_uid) }}
{# DECIDED: pinned to the node with memory to spare. A page build holds a selection's boards in
   memory, near 1 GB once an hour, and the scheduler places by requests, not by use. #}
      nodeSelector:
        kubernetes.io/hostname: {{ tft_assistant_k8s_node }}
      containers:
{# The image's own command is the crawler. This container serves the page the crawler builds,
   from the same volume, and holds no key. #}
        - name: tft-assistant
          image: {{ tft_assistant_k8s_image }}
          imagePullPolicy: IfNotPresent
          command: ["python", "-m", "http.server", "{{ container_item.port }}", "--directory", "/data/site"]
          ports:
            - containerPort: {{ container_item.port }}
{{ hardened_security_context(read_only=true, non_root=true) }}
          readinessProbe:
            httpGet:
              path: /index.html
              port: {{ container_item.port }}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            tcpSocket:
              port: {{ container_item.port }}
            initialDelaySeconds: 15
            periodSeconds: 30
          volumeMounts:
            - name: tft-assistant-data
              mountPath: /data
              readOnly: true
{{ container_resources(cpu_limit=tft_assistant_k8s_cpu_limit, mem_limit=tft_assistant_k8s_mem_limit, cpu_request=tft_assistant_k8s_cpu_request, mem_request=tft_assistant_k8s_mem_request) }}
        - name: tft-assistant-crawler
          image: {{ tft_assistant_k8s_image }}
          imagePullPolicy: IfNotPresent
          args: ["refresh", "--out", "/data/site"]
          env:
            - name: RIOT_API_KEY
              valueFrom:
                secretKeyRef:
                  name: tft-assistant-secrets
                  key: RIOT_API_KEY
{{ hardened_security_context(read_only=true, non_root=true) }}
          volumeMounts:
            - name: tft-assistant-data
              mountPath: /data
            - name: tft-assistant-tmp
              mountPath: /tmp
{{ container_resources(cpu_limit=tft_assistant_k8s_crawler_cpu_limit, mem_limit=tft_assistant_k8s_crawler_mem_limit, cpu_request=tft_assistant_k8s_crawler_cpu_request, mem_request=tft_assistant_k8s_crawler_mem_request) }}
      volumes:
        - name: tft-assistant-data
          persistentVolumeClaim:
            claimName: {{ tft_assistant_k8s_claim }}
        - name: tft-assistant-tmp
          emptyDir: {}
