{
  "annotations": {
    "list": []
  },
  "description": "Daily rollups from the Warehouse datasource, which Airflow loads each night from Prometheus, Home Assistant and Claude Code's telemetry (k8s/roles/airflow/CLAUDE.md). Prometheus keeps about three weeks and Home Assistant one; these panels keep every day since each DAG began. Volume figures are filesystem usage of mounted claims, from kubelet, not Longhorn's actual size.",
  "editable": true,
  "id": null,
  "panels": [
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "description": "Each claim's largest used size that day. A claim with no running pod has no row for the day.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT day::timestamptz AS time, key AS metric, \"max\" AS value FROM prom.series_daily WHERE metric = 'volume_used_bytes' AND $__timeFilter(day) ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Volume used",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "description": "Change in each claim's largest used size from the day before.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "right",
          "sortBy": "Total",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, metric, value FROM (SELECT day::timestamptz AS time, key AS metric, \"max\" - lag(\"max\") OVER (PARTITION BY key ORDER BY day) AS value, day FROM prom.series_daily WHERE metric = 'volume_used_bytes') growth WHERE value IS NOT NULL AND $__timeFilter(day) ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Volume growth per day",
      "type": "timeseries"
    },
    {
      "datasource": {
