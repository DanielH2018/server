{% from 'origin-pull.yml.j2' import origin_pull_tlsoption with context %}
---
# Copied, not referenced: allowCrossNamespace is off, so a route cannot borrow other namespaces'
# middlewares. Keep in step with the originals in the traefik and authelia roles.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: rate-limit
  namespace: {{ k8s_observability_namespace }}
spec:
  rateLimit:
    average: 300
    burst: 150
    period: 1m
---
# The proxied twin, for the public Host rule the ingressroute() macro emits for grafana. Same
# copy-not-reference reason as above; the keying rationale is with the original in the traefik
# role's dynamic.yaml.j2.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: rate-limit-proxied
  namespace: {{ k8s_observability_namespace }}
spec:
  rateLimit:
    average: 300
    burst: 150
    period: 1m
    sourceCriterion:
      ipStrategy:
        depth: 1
---
# The authelia unit: strip, forwardAuth, then the `authelia` chain the routes name. A copy of
# k8s/roles/authelia/templates/forwardauth-middleware.yaml.j2, which carries the reasoning
# (why these three headers and never X-Forwarded-For or -Proto). Keep it in lockstep;
# tests/k8s/edge/test_forwardauth_rebuilds_request_target.py checks every copy.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: authelia-strip-forwarded-target
  namespace: {{ k8s_observability_namespace }}
spec:
  headers:
    customRequestHeaders:
      X-Forwarded-Host: ""
      X-Forwarded-Uri: ""
      X-Forwarded-Method: ""
---
# Never reference this directly from a route: only the `authelia` chain below may name it.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: authelia-forwardauth
  namespace: {{ k8s_observability_namespace }}
spec:
  forwardAuth:
    address: http://authelia.{{ k8s_namespace }}.svc.cluster.local:9091/api/authz/forward-auth
    trustForwardHeader: true
    authResponseHeaders:
      - Remote-User
      - Remote-Groups
      - Remote-Name
      - Remote-Email
    maxResponseBodySize: 1048576
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: authelia
  namespace: {{ k8s_observability_namespace }}
spec:
  chain:
    middlewares:
      - name: authelia-strip-forwarded-target
      - name: authelia-forwardauth
---
# A TLSOption resolves in the ROUTE's namespace: without a local `modern`, the router fails to build
# and Traefik resets the TLS handshake (curl SSL_ERROR_SYSCALL).
apiVersion: traefik.io/v1alpha1
kind: TLSOption
metadata:
  name: modern
  namespace: {{ k8s_observability_namespace }}
spec:
  minVersion: VersionTLS12
  cipherSuites:
    - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
    - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
    - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
    - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
    - TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305
    - TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305
---
# The public-Host `cloudflare-origin-pull` option must also exist per namespace, with its CA Secret.
{{ origin_pull_tlsoption(k8s_observability_namespace) }}
