---
# A Secret because alertmanager.yml carries `email`, a SOPS key. The three credentials ride beside
# it and are read through `*_file` fields, so the offline validator's `STUB` works (a webhook URL
# `STUB` would fail parsing).
# EVERY GO TEMPLATE EXPRESSION SITS INSIDE A JINJA RAW BLOCK: Jinja would refuse or consume them;
# scripts/validate/alert_rules.py checks each survives the render.
{#
  The weekly-reboot mute, derived from the reboot cron's own variables in estate/vars.yml;
  never a second copy of the schedule.
  It opens the lead before the cron fires and closes after the shutdown delay and the recovery
  allowance, counted in minutes from Sunday 00:00. Alertmanager's `times` cannot cross
  midnight (`end_time` stops at 24:00), so a window that does is split into one entry per day.
  tests/services/alertmanager/test_alertmanager_reboot_mute.py holds it to that sum.
#}
{% set reboot_mute = namespace(entries=[]) %}
{% set mute_opens = (weekly_reboot_weekday | int) * 1440 + (weekly_reboot_hour | int) * 60 + (weekly_reboot_minute | int) - (weekly_reboot_mute_lead_minutes | int) %}
{% set mute_closes = mute_opens + (weekly_reboot_mute_lead_minutes | int) + (weekly_reboot_shutdown_delay_minutes | int) + (weekly_reboot_mute_recovery_minutes | int) %}
{% for day in range(mute_opens // 1440, (mute_closes - 1) // 1440 + 1) %}
{%   set starts = [mute_opens, day * 1440] | max - day * 1440 %}
{%   set ends = [mute_closes, (day + 1) * 1440] | min - day * 1440 %}
{%   set reboot_mute.entries = reboot_mute.entries + [{
       "weekday": ["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"][day % 7],
       "start_time": "%02d:%02d" | format(starts // 60, starts % 60),
       "end_time": "%02d:%02d" | format(ends // 60, ends % 60),
     }] %}
{% endfor %}
{# The grouping routes nest a copy because Alertmanager groups per route and an alert stops at the
   first match.
   A warning that holds by design carries escalate="false" and repeats daily. #}
{% macro paging_routes() %}
- matchers: ['severity="warning"', 'escalate="false"']
  receiver: discord
  repeat_interval: 24h
  mute_time_intervals: [weekly-reboot]
- matchers: ['severity="critical"']
  receiver: discord
  continue: true
  mute_time_intervals: [weekly-reboot]
- matchers: ['severity="critical"']
  receiver: email
  mute_time_intervals: [weekly-reboot]
- receiver: discord
  mute_time_intervals: [weekly-reboot]
{%- endmacro %}
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-config
  namespace: {{ k8s_observability_namespace }}
type: Opaque
stringData:
  alertmanager.yml: |
    global:
      resolve_timeout: 5m
      # Gmail on 465. Port 465 is implicit TLS, which Alertmanager picks from the port alone.
      smtp_smarthost: smtp.gmail.com:465
      smtp_from: "{{ email }}"
      smtp_auth_username: "{{ email }}"
      smtp_auth_password_file: /etc/alertmanager/smtp-password
    # Relative, so it resolves both in the pod and beside the copy amtool checks in CI.
    templates:
      - homelab.tmpl
    # Routes that page carry this mute; the Watchdog route never does.
    time_intervals:
      - name: weekly-reboot
        time_intervals:
{% for entry in reboot_mute.entries %}
          - weekdays: [{{ entry.weekday }}]
            times:
              - start_time: "{{ entry.start_time }}"
                end_time: "{{ entry.end_time }}"
            location: {{ weekly_reboot_timezone }}
{% endfor %}
    route:
      receiver: discord
      group_by: [alertname, service]
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 6h
      routes:
        # First, and never under a mute interval, so no maintenance window silences the off-site
        # watcher.
        - matchers: ['alertname="Watchdog"']
          receiver: healthchecks
          group_wait: 0s
          group_interval: 1m
          repeat_interval: {{ observability_alertmanager_watchdog_repeat_seconds }}s
        # A rule that runs in parallel with another pager carries shadow="true" and pages nobody.
        - matchers: ['shadow="true"']
          receiver: blackhole
        # A unit whose OnFailure=homelab-alert@ hook already paged Discord carries paged_by;
        # WarningUnresolved drops the label, so the 48h escalation still pages.
        - matchers: ['paged_by="homelab-alert"']
          receiver: blackhole
        # A drill alert fails a health gate on purpose and pages nobody, so it sits ahead of both
        # critical routes.
        - matchers: ['drill="true"']
          receiver: blackhole
        # One message per escalated warning, listing each service it escalated for.
        - matchers: ['alertname="WarningUnresolved"']
          group_by: [alertname, escalated_from]
          routes:
            {{ paging_routes() | indent(12) }}
        # A host-plane rule carries its host as `service`, so grouping by alertname alone would send
        # one fault on every host as one message.
        - matchers: ['service=~"{{ observability_expected_hosts | list | sort | join('|') }}"']
          group_by: [alertname]
          routes:
            {{ paging_routes() | indent(12) }}
        {{ paging_routes() | indent(8) }}
    # A bridge row behind a reachability gate exports 0 while the gate reads down, and its rule
    # carries `requires`; the gate's rule sources the inhibit, with no `equal` list.
    # Inhibition runs before routing, so a source and target must both be shadow or both live.
    inhibit_rules:
      - source_matchers: ['alertname="WANUnreachable"']
        target_matchers: ['requires="wan"']
      # The same shape for B2: one cap breach pages once, and `b2_storage` is the dependent.
      - source_matchers: ['alertname="B2Unreachable"']
        target_matchers: ['requires="b2"']
      # A host check's own NotReporting pair outranks the catch-all deadman. Both compare
      # the same timestamp with the same deadline, and HostCheckOverdue's `for: 2m` outlasts the
      # minute by which a pair in another rule group can lag it, so the source is cached before
      # the target fires. `equal` keeps another check or another host's copy paging. This source is shadow on
      # purpose, against the rule above: a shadow pair still has its other pager, and
      # Alertmanager's inhibitor reads every alert whatever its route. A `shadow!="true"` source
      # would let HostCheckOverdue page beside that pager for every paired check.
      - source_matchers: ['alertname=~".+NotReporting"']
        target_matchers: ['alertname="HostCheckOverdue"']
        equal: [check, origin]
      # One dead blackbox_exporter pages once. A single dead target still pages through
      # ScrapeTargetDown, since BlackboxExporterDown fires only when every target reads 0.
      # No `equal` list: the source is a `max()` carrying neither `job` nor `instance`.
      - source_matchers: ['alertname="BlackboxExporterDown"']
        target_matchers: ['alertname="ScrapeTargetDown"', 'job="blackbox-ingress"']
      # `equal` keeps the other controllers paging, and keeps the absent() arm (no `instance`) from
      # holding any scrape page.
      - source_matchers: ['alertname="FluxControllerDown"']
        target_matchers: ['alertname="ScrapeTargetDown"', 'job="flux"']
        equal: [job, instance]
      # AutofixBridgeDown holds the same-job ScrapeTargetDown warning so one outage pages once.
      # No `equal` list: one target, and the source's absent() arm carries only `job`.
      - source_matchers: ['alertname="AutofixBridgeDown"']
        target_matchers: ['alertname="ScrapeTargetDown"', 'job="autofix-bridge"']
      # No `equal` list: PiHostDown carries the exporter's `instance` and PiPortDead the port's, and
      # the estate has one Pi.
      # wg-easy's ExtraProbeFailed is not held, because it pages beside the ping.
      - source_matchers: ['alertname="PiHostDown"']
        target_matchers: ['alertname="PiPortDead"']
      # A failing triage poll pages once through the unit's hook; a stopped timer fails no unit, so
      # ClaudeTriagePollNotReporting still pages.
      # `equal` names `origin` alone, because the source's `check` is `systemd-units`.
      - source_matchers: ['alertname="SystemdUnitsFailed"', 'unit="homelab-claude-triage-poll.service"', 'paged_by="homelab-alert"']
        target_matchers: ['alertname="ClaudeTriagePollNotReporting"']
        equal: [origin]
      # Prometheus cannot see an inhibit, so a held warning still escalates into WarningUnresolved
      # after 48h, naming it in `escalated_from`.
      # Each rule below repeats one above for that escalation (test_warning_escalation_exemptions.py
      # fails one that is missing); a `requires` target needs none.
      - source_matchers: ['alertname=~".+NotReporting"']
        target_matchers: ['alertname="WarningUnresolved"', 'escalated_from="HostCheckOverdue"']
        equal: [check, origin]
      - source_matchers: ['alertname="BlackboxExporterDown"']
        target_matchers: ['alertname="WarningUnresolved"', 'escalated_from="ScrapeTargetDown"', 'job="blackbox-ingress"']
      - source_matchers: ['alertname="FluxControllerDown"']
        target_matchers: ['alertname="WarningUnresolved"', 'escalated_from="ScrapeTargetDown"', 'job="flux"']
        equal: [job, instance]
      - source_matchers: ['alertname="AutofixBridgeDown"']
        target_matchers: ['alertname="WarningUnresolved"', 'escalated_from="ScrapeTargetDown"', 'job="autofix-bridge"']
      - source_matchers: ['alertname="PiHostDown"']
        target_matchers: ['alertname="WarningUnresolved"', 'escalated_from="PiPortDead"']
      - source_matchers: ['alertname="SystemdUnitsFailed"', 'unit="homelab-claude-triage-poll.service"', 'paged_by="homelab-alert"']
        target_matchers: ['alertname="WarningUnresolved"', 'escalated_from="ClaudeTriagePollNotReporting"']
        equal: [origin]
    receivers:
      - name: blackhole
      - name: healthchecks
        webhook_configs:
          - url_file: /etc/alertmanager/watchdog-url
            # When Prometheus stops sending the Watchdog, Alertmanager resolves it after
            # resolve_timeout. A resolved send would count as a ping and hide the outage.
            send_resolved: false
            # Healthchecks.io stores the request body, so the payload carries the status and no
            # labels or URLs.
            payload:
              status: '{% raw %}{{ .Status }}{% endraw %}'
      - name: discord
        discord_configs:
          - webhook_url_file: /etc/alertmanager/discord-webhook-url
            send_resolved: true
            title: '{% raw %}{{ template "homelab.title" . }}{% endraw %}'
            message: '{% raw %}{{ template "homelab.message" . }}{% endraw %}'
      - name: email
        email_configs:
          - to: "{{ email }}"
            send_resolved: true
            headers:
              Subject: '{% raw %}{{ template "homelab.title" . }}{% endraw %}'
            text: '{% raw %}{{ template "homelab.email" . }}{% endraw %}'
            # Empty drops the default HTML part, so the email is the plain-text Discord body without
            # Markdown and with UTC times.
            html: ''
  homelab.tmpl: |
    {{ lookup('file', role_file('files/alertmanager/homelab.tmpl')) | indent(4) }}
  discord-webhook-url: "{{ monitor_discord_webhook_url }}"
  smtp-password: "{{ smtp_notify_app_password }}"
  watchdog-url: "https://hc-ping.com/{{ healthchecks_ping_key }}/alertmanager-watchdog"
