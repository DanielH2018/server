{% from 'checksum-annotation.yml.j2' import checksum_annotation %}
{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'service.yml.j2' import service with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-provisioning
  namespace: {{ k8s_observability_namespace }}
data:
{# Captured so the Deployment below can hash it into checksum/config. #}
{% set observability_grafana_config %}
  datasources.yaml: |
    apiVersion: 1
    # Old lowercase `loki` datasource must go: its uid collides with loki-homelab and crash-loops.
    deleteDatasources:
      - name: loki
        orgId: 1
    datasources:
      - name: Prometheus
        uid: prometheus
        type: prometheus
        access: proxy
        url: http://prometheus:9090
        isDefault: true
        jsonData:
          httpMethod: POST
      - name: Loki
        uid: loki
        type: loki
        access: proxy
        url: http://loki:3100
      - name: Tempo
        uid: tempo
        type: tempo
        access: proxy
        url: http://tempo:3200
        jsonData:
          # Claude Code stamps trace_id/span_id onto its log events, so a span can jump
          # straight to the events emitted inside it. This is the pairing that makes traces
          # worth having: the span says a tool took 40s, the linked logs say which tool and
          # what it returned.
          tracesToLogsV2:
            datasourceUid: loki
            spanStartTimeShift: '-5m'
            spanEndTimeShift: '5m'
            filterByTraceID: true
            customQuery: false
          nodeGraph:
            enabled: true
      # Aliases carrying daniel-server's Grafana uids. Every dashboard in
      # k8s/roles/observability/files/dashboards references its datasource by UID —
      # `EGdsQqhVk` and `bf4q19tuivta8e`, baked into each panel; none references one by NAME,
      # so the alias names are free, and a matching uid makes every board work with no edit.
      #
      # ADDITIVE rather than renaming the two above. The two cluster-native uids are still in
      # use — `prometheus` is the default datasource and `loki` is what the Tempo datasource's
      # tracesToLogsV2 points at — so retagging rather than adding would break both. Two
      # datasources over one backend costs nothing.
      #
      # Names must differ from the two above: Grafana keys update-vs-insert on orgId+name, so
      # reusing `Prometheus` would UPDATE that datasource's uid rather than insert a second.
      - name: Prometheus (daniel-server uid)
        uid: EGdsQqhVk
        type: prometheus
        access: proxy
        url: http://prometheus:9090
        jsonData:
          httpMethod: POST
          # Load-bearing: daniel-server scrapes at 1m; at Grafana's 15s default every rate() panel
          # returns EMPTY.
          timeInterval: "1m"
      - name: loki-homelab
        uid: bf4q19tuivta8e
        type: loki
        access: proxy
        # The HOMELAB Loki, cross-namespace — NOT this stack's own loki (that one keeps
        # uid `loki` for tracesToLogsV2). The ported dashboards bake this uid into their
        # panels, and pointing it at the observability Loki leaves Logs, Loki — Internals
        # and Alert History's log half empty.
        url: http://loki-homelab.{{ k8s_namespace }}.svc.cluster.local:3100
  dashboards.yaml: |
    apiVersion: 1
    providers:
      # Every board, from k8s/roles/observability/files/dashboards — one provider, because
      # foldersFromFilesStructure derives the Grafana folder from the directory name and so
      # reproduces the AI/Apps/Infrastructure/Logs/Networking/Security layout without naming any
      # of them here.
      - name: homelab
        orgId: 1
        type: file
        disableDeletion: false
        updateIntervalSeconds: 30
        allowUiUpdates: true
        options:
          path: /var/lib/grafana/dashboards/homelab
          foldersFromFilesStructure: true
{% endset %}
{{ observability_grafana_config -}}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: grafana
  namespace: {{ k8s_observability_namespace }}
spec:
  # ReadWriteOnce PVC — see the note on the loki Deployment.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: grafana
  template:
    metadata:
      annotations:
        # Rolls THIS workload alone when its own ConfigMap changes. The role skips the
        # shared rollout-restart, so without this the edit reaches the ConfigMap and never
        # the pod. See this role's CLAUDE.md, `## One config change, one restart`.
        {{ checksum_annotation('config', observability_grafana_config | hash('sha1')) }}
      labels:
        app: grafana
        netpol-baseline: enforced
    spec:
      # Tier 4; `DECIDED: observability tiers` in this role's CLAUDE.md names the tier-1
      # exceptions.
{{ pod_shell('homelab-best-effort', run_as_user=472, run_as_group=472, fs_group=472) }}
      # Prefers daniel-box, where the role's other pods run, so the observability-prepull Job
      # (flux_prepull_workloads in defaults/main.yml) has a node to pull onto. A preference,
      # not a pin, so Grafana still schedules with daniel-box cordoned, at a cold pull.
{{ node_affinity_preference(k8s_primary_node) }}
      initContainers:
        # Writes the SOPS admin password into Grafana's database before the server starts.
        # GF_SECURITY_ADMIN_PASSWORD below is read only when Grafana initialises a NEW
        # database, so without this a rotated grafana_admin_password rolls the pod and the
        # admin login keeps the old one. `reset-admin-password` writes the DB directly and needs
        # no knowledge of the current password. A rotation reaches it through
        # `checksum/restart`, which moves with the Secret; every other start re-applies the same
        # value.
        #
        # No server runs beside it: grafana is Recreate, so the old pod is gone before this
        # one's init runs, and the CLI's own `Migrate` pass has the SQLite file to itself.
        # Against a DB a stopped server had initialised, the CLI exits 0 and the next boot
        # accepts the new password and refuses the old one, though the server's env still
        # carries the old. On an empty data directory it creates the DB and the admin user,
        # so a fresh PVC boots too.
        #
        # The password goes in on stdin, not argv, so it never appears in the process list.
        #
        # DECIDED: a failed reset blocks Grafana's start, with no `|| true`. Swallowing the
        # exit would let Grafana serve with a stale admin password and say nothing, which is
        # the silent divergence this initContainer exists to remove. The CLI's inputs are the
        # image, the Secret and the database. A change to the first two rolls the pod in a
        # deploy, so a failure shows up at that deploy's rollout wait, not at a later eviction.
        # Grafana is not the paging path: Alertmanager pages without it. Not-ready dashboards
        # are therefore an outage the operator sees, and that is the trade taken over a login
        # that quietly stops working.
        - name: admin-password
          image: {{ observability_k8s_grafana_image }}
          imagePullPolicy: IfNotPresent
{{ hardened_security_context(non_root=true) }}
          command:
            - sh
            - -c
            - printf %s "$GF_SECURITY_ADMIN_PASSWORD" | grafana cli admin reset-admin-password --password-from-stdin
          env:
            - name: GF_SECURITY_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: grafana-admin
                  key: password
          volumeMounts:
            - name: grafana-data
              mountPath: /var/lib/grafana
{{ container_resources(cpu_limit='500m', mem_limit='512Mi', cpu_request='50m', mem_request='128Mi') }}
      containers:
        - name: grafana
          image: {{ observability_k8s_grafana_image }}
          imagePullPolicy: IfNotPresent
{{ hardened_security_context(non_root=true) }}
          env:
            - name: GF_SECURITY_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: grafana-admin
                  key: password
            # Authelia already authenticates every request reaching this route, but the
            # login page stays on: the forward-auth middleware is the only thing in front,
            # and a Grafana with anonymous admin would be wide open to anything that ever
            # reaches it in-cluster.
            - name: GF_USERS_ALLOW_SIGN_UP
              value: "false"
            # root_url alone sets the OAuth callback, so only one route (the LAN name) can carry
            # OIDC login.
            - name: GF_SERVER_ROOT_URL
              value: "https://grafana.local.{{ domain }}/"
            - name: GF_AUTH_GENERIC_OAUTH_ENABLED
              value: "true"
            - name: GF_AUTH_GENERIC_OAUTH_NAME
              value: "Authelia"
            - name: GF_AUTH_GENERIC_OAUTH_CLIENT_ID
              value: "grafana"
            - name: GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: grafana-admin
                  key: oidc_client_secret
            # `role_attribute_path` reads `groups`; without the scope every user silently lands
            # Viewer.
            - name: GF_AUTH_GENERIC_OAUTH_SCOPES
              value: "openid profile email groups"
            # Authelia derives its issuer from the request host: all three URLs must use the LAN
            # portal name.
            - name: GF_AUTH_GENERIC_OAUTH_AUTH_URL
              value: "https://auth.local.{{ domain }}/api/oidc/authorization"
            - name: GF_AUTH_GENERIC_OAUTH_TOKEN_URL
              value: "https://auth.local.{{ domain }}/api/oidc/token"
            - name: GF_AUTH_GENERIC_OAUTH_API_URL
              value: "https://auth.local.{{ domain }}/api/oidc/userinfo"
            # Must pair with `require_pkce: true` on the Authelia client, or authorize is rejected.
            - name: GF_AUTH_GENERIC_OAUTH_USE_PKCE
              value: "true"
            - name: GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH
              value: "preferred_username"
            # Authelia `admins` maps to Admin; everyone else gets Viewer, so a group change cannot
            # lock out.
            - name: GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH
              value: "contains(groups[*], 'admins') && 'Admin' || 'Viewer'"
            # DELIBERATELY ABSENT: GF_AUTH_DISABLE_LOGIN_FORM and auto-login. The public route
            # cannot complete OAuth while root_url names the LAN host, so the form is its way in and
            # the break-glass path.
            - name: GF_ANALYTICS_REPORTING_ENABLED
              value: "false"
            - name: GF_ANALYTICS_CHECK_FOR_UPDATES
              value: "false"
          ports:
            - name: http
              containerPort: 3000
          volumeMounts:
            - name: grafana-provisioning-datasources
              mountPath: /etc/grafana/provisioning/datasources
            - name: grafana-provisioning-dashboards
              mountPath: /etc/grafana/provisioning/dashboards
            # The provisioner re-reads board ConfigMaps in place; they carry no checksum/config.
{% for folder in observability_dashboard_folders %}
            - name: dashboards-{{ folder | lower }}
              mountPath: /var/lib/grafana/dashboards/homelab/{{ folder }}
{% endfor %}
            - name: grafana-data
              mountPath: /var/lib/grafana
          readinessProbe:
            httpGet:
              path: /api/health
              port: 3000
            initialDelaySeconds: 20
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /api/health
              port: 3000
            initialDelaySeconds: 30
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 6
          # 2Gi: a browser opening four dashboards OOMKills (exit 137) at 512Mi and 1Gi with a clean
          # log.
{{ container_resources(cpu_limit='1', mem_limit='2Gi', cpu_request='50m', mem_request='576Mi') }}
      volumes:
        # Projected, not mounted whole: a whole mount puts datasources.yaml where dashboards are
        # parsed.
        - name: grafana-provisioning-datasources
          projected:
            sources:
              - configMap:
                  name: grafana-provisioning
                  items:
                    - key: datasources.yaml
                      path: datasources.yaml
              - secret:
                  name: grafana-warehouse-datasource
                  items:
                    - key: warehouse.yaml
                      path: warehouse.yaml
        - name: grafana-provisioning-dashboards
          configMap:
            name: grafana-provisioning
            items:
              - key: dashboards.yaml
                path: dashboards.yaml
        # One ConfigMap per folder: a ConfigMap caps at 1 MiB and Infrastructure alone is 538 KB.
{% for folder in observability_dashboard_folders %}
        - name: dashboards-{{ folder | lower }}
          configMap:
            name: grafana-dashboards-{{ folder | lower }}
{% endfor %}
        - name: grafana-data
          persistentVolumeClaim:
            claimName: grafana-data
---
{{ service('grafana', 3000, port_name='http', namespace=k8s_observability_namespace) -}}
