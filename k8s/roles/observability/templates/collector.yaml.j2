{% from 'checksum-annotation.yml.j2' import checksum_annotation %}
{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'service.yml.j2' import service with context %}
{% from 'workload-shell.yml.j2' import pod_shell with context %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: otel-collector-config
  namespace: {{ k8s_observability_namespace }}
data:
  config.yaml: |
{# Captured so the Deployment below can hash it into checksum/config. #}
{% set observability_collector_config %}
    receivers:
      otlp:
        protocols:
          grpc:
            # 0.0.0.0 inside the container; the hostPort's hostIP pins the node-side listener to
            # loopback.
            endpoint: 0.0.0.0:4317
    processors:
      batch:
        timeout: 5s
      # Logs only: on metrics, `node` would collide with Prometheus's own label as `exported_node`.
      resource/node:
        attributes:
          - key: node
            value: ${env:NODE_NAME}
            action: upsert
    extensions:
      health_check:
        # Probe target only — in-cluster, never a hostPort, carries no telemetry.
        endpoint: 0.0.0.0:13133
    exporters:
      prometheus:
        endpoint: 0.0.0.0:8889
        # The 5m default drops idle metrics, so counter panels flicker to "No data" between
        # sessions.
        metric_expiration: 168h
        resource_to_telemetry_conversion:
          enabled: true
      otlp_http/loki:
        # Loki 3.x native OTLP ingest; the exporter appends /v1/logs.
        endpoint: http://loki:3100/otlp
      otlp/tempo:
        endpoint: tempo:4317
        tls:
          insecure: true
    service:
      extensions: [health_check]
      telemetry:
        logs:
          level: info
        metrics:
          readers:
            - pull:
                exporter:
                  prometheus:
                    # 0.0.0.0 so Prometheus can scrape in-cluster; the default localhost bind is
                    # unreachable.
                    host: 0.0.0.0
                    port: 8888
      pipelines:
        metrics:
          receivers: [otlp]
          processors: [batch]
          exporters: [prometheus]
        logs:
          receivers: [otlp]
          processors: [resource/node, batch]
          exporters: [otlp_http/loki]
        traces:
          receivers: [otlp]
          processors: [batch]
          exporters: [otlp/tempo]
{% endset %}
{{ observability_collector_config -}}
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: otel-collector
  namespace: {{ k8s_observability_namespace }}
spec:
  # A DaemonSet: every node carries its own loopback OTLP listener, so a host's Claude Code
  # always exports to 127.0.0.1:4317 locally. DaemonSet updates are delete-then-create per
  # node, so the hostPort cannot deadlock a rollout.
  selector:
    matchLabels:
      app: otel-collector
  template:
    metadata:
      annotations:
        # Rolls THIS workload alone when its own ConfigMap changes. The role skips the
        # shared rollout-restart, so without this the edit reaches the ConfigMap and never
        # the pod. See this role's CLAUDE.md, `## One config change, one restart`.
        {{ checksum_annotation('config', observability_collector_config | hash('sha1')) }}
      labels:
        app: otel-collector
        netpol-baseline: enforced
    spec:
      # Tier 4; `DECIDED: observability tiers` in this role's CLAUDE.md names the tier-1
      # exceptions.
{{ pod_shell('homelab-best-effort') }}
      containers:
        - name: otel-collector
          image: {{ observability_k8s_collector_image }}
          imagePullPolicy: IfNotPresent
          args: ["--config=/conf/config.yaml"]
          env:
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          # `runAsNonRoot` alone does not pin a uid; the kubelet refuses an image that names its
          # user.
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=10001) }}
          ports:
            # hostIP 127.0.0.1 is required: otherwise the port binds 0.0.0.0, exposing prompts to
            # the LAN.
            - name: otlp-grpc
              containerPort: {{ observability_otlp_port }}
              hostPort: {{ observability_otlp_port }}
              hostIP: {{ observability_otlp_host_ip }}
            - name: prom-export
              containerPort: 8889
            - name: self-metrics
              containerPort: 8888
            - name: health
              containerPort: 13133
          # A wedged collector keeps its hostPort bound and blackholes telemetry silently.
          readinessProbe:
            httpGet:
              path: /
              port: health
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: health
            initialDelaySeconds: 15
            periodSeconds: 30
          volumeMounts:
            - name: otel-collector-config
              mountPath: /conf
{{ container_resources(cpu_limit='1', mem_limit='512Mi', cpu_request='50m', mem_request='64Mi') }}
      volumes:
        - name: otel-collector-config
          configMap:
            name: otel-collector-config
---
{{ service('otel-collector', 8889, port_name='prom-export', extra_ports=[{'name': 'self-metrics', 'port': 8888}], namespace=k8s_observability_namespace) -}}
