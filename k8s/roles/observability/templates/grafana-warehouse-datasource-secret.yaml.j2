---
# Grafana's read-only view of Airflow's warehouse database. A provisioning file in a Secret,
# not the grafana-provisioning ConfigMap, because it carries the reader's password; Grafana's
# projected datasources volume mounts it beside datasources.yaml.
#
# `warehouse_reader` holds SELECT on the warehouse's source schemas and nothing else
# (k8s/roles/airflow/templates/postgres.yaml.j2), and airflow-postgres-callers admits Grafana
# on 5432 (k8s/roles/airflow/templates/networkpolicy-postgres.yaml.j2).
apiVersion: v1
kind: Secret
metadata:
  name: grafana-warehouse-datasource
  namespace: {{ k8s_observability_namespace }}
type: Opaque
stringData:
  warehouse.yaml: |
    apiVersion: 1
    datasources:
      - name: Warehouse
        uid: warehouse
        type: grafana-postgresql-datasource
        access: proxy
        url: airflow-postgres.{{ k8s_namespace }}.svc.cluster.local:5432
        user: warehouse_reader
        jsonData:
          database: warehouse
          sslmode: disable
          postgresVersion: 1700
          timescaledb: false
        secureJsonData:
          password: {{ airflow_warehouse_reader_password }}
