{% from 'checksum-annotation.yml.j2' import checksum_annotation %}
{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
{# The cap is bytes: keeping dropped `_bucket` families would silently cut retention under 3 weeks.
   `_count` and `_sum` survive, so rates and averages are intact. #}
{# DECIDED: etcd_request_duration_seconds_bucket is kept, although it is the largest family in
   the TSDB; etcd write latency is the signal the control-plane scrape exists for. It is also,
   usefully, available from the apiserver's side WITHOUT `--etcd-expose-metrics`, so this one
   family delivers a good part of what the gated etcd job would add. #}
{# Explicit list: RE2 has no lookaround, so a negative-lookahead spelling silently drops nothing. #}
{# NOT `-%}` on the opening tag: it strips the 8-space indent and breaks the YAML. #}
{% macro control_plane_bucket_drop() %}
        metric_relabel_configs:
          - source_labels: [__name__]
            action: drop
            regex: >-
              (apiserver_request_duration_seconds|apiserver_request_sli_duration_seconds|apiserver_request_body_size_bytes|apiserver_response_sizes|apiserver_watch_list_duration_seconds|apiserver_watch_cache_read_wait_seconds|apiserver_watch_events_sizes|apiserver_watch_events_dispatch_duration_seconds|apiserver_storage_list_duration_seconds|apiserver_watch_cache_initialization_duration_seconds|scheduler_plugin_execution_duration_seconds|workqueue_work_duration_seconds|workqueue_queue_duration_seconds|storage_operation_duration_seconds|kubelet_runtime_operations_duration_seconds|rest_client_request_duration_seconds)_bucket
{%- endmacro %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: prometheus-config
  namespace: {{ k8s_observability_namespace }}
data:
  prometheus.yml: |
{# Captured so the Deployment below can hash it into checksum/config. #}
{% set observability_prometheus_config %}
    global:
      scrape_interval: 15s
    # The role's own Alertmanager (alertmanager.yaml.j2), by its in-namespace Service name.
    alerting:
      alertmanagers:
        - static_configs:
            - targets: ['alertmanager:9093']
    # --config.auto-reload hashes every file this glob matches, so rule edits reload without a roll.
    rule_files:
      - /etc/prometheus-rules/*.yaml
    scrape_configs:
      # Prometheus scraping itself. Its ingestion rate, TSDB footprint and remote-write receive
      # errors are unreadable without it, and monitor-bridge depends on this instance, so "how
      # full is it and is it keeping up" has to be answerable from inside it.
      - job_name: prometheus
        static_configs:
          - targets: ['localhost:9090']
      # PER-POD discovery, not the Service: each collector pod exports only its own node's metrics,
      # so a Service scrape would round-robin partial views and corrupt counters.
      - job_name: otel-collector
        kubernetes_sd_configs:
          - role: pod
            namespaces:
              names: [{{ k8s_observability_namespace }}]
        relabel_configs:
          - source_labels: [__meta_kubernetes_pod_label_app]
            regex: otel-collector
            action: keep
          - source_labels: [__meta_kubernetes_pod_container_port_number]
            regex: "8889"
            action: keep
          - source_labels: [__meta_kubernetes_pod_node_name]
            target_label: node
        # The fenced triage and Renovate sessions, which read untrusted text, export here too. Any
        # other name would let one forge a series a routed triage alert reads, such as
        # kube_deployment_status_replicas_available.
        metric_relabel_configs:
          - source_labels: [__name__]
            regex: claude_code_.*
            action: keep
      # Carries the send_failed_* counters, the only evidence a batch was dropped on the way to
      # Loki.
      - job_name: otel-collector-internal
        kubernetes_sd_configs:
          - role: pod
            namespaces:
              names: [{{ k8s_observability_namespace }}]
        relabel_configs:
          - source_labels: [__meta_kubernetes_pod_label_app]
            regex: otel-collector
            action: keep
          - source_labels: [__meta_kubernetes_pod_container_port_number]
            regex: "8888"
            action: keep
          - source_labels: [__meta_kubernetes_pod_node_name]
            target_label: node
      # Four jobs scrape at 1m, not the 15s global (kube-state-metrics, cadvisor, kubelet,
      # apiserver).
      # A rule over their families must use no irate() and range windows of at least 4m.
      - job_name: kube-state-metrics
        scrape_interval: 1m
        static_configs:
          - targets: ['kube-state-metrics:8080']
        # The list is explicit because RE2 has no lookaround: a family an upgrade adds is kept until
        # named.
        metric_relabel_configs:
          - source_labels: [__name__]
            action: drop
            regex: kube_replicaset_(annotations|created|labels|metadata_generation|spec_replicas|status_fully_labeled_replicas|status_observed_generation|status_ready_replicas|status_replicas|status_terminating_replicas)
          - source_labels: [__name__]
            action: drop
            regex: kube_service_(annotations|created|deletion_timestamp|info|labels|spec_external_ip|spec_type)
          # kube_job_failed is kept: its condition="true" series is what K3sUpgradeJobFailed reads.
          - source_labels: [__name__]
            action: drop
            regex: kube_job_(annotations|complete|created|info|labels|owner|spec_active_deadline_seconds|spec_completions|spec_parallelism|status_ready|status_suspended)
          # CronJobs are collected for kube_cronjob_status_last_successful_time alone, the run
          # clock files/rules/pod-producers.yaml reads for the two health CronJobs. The
          # other twelve families have no reader.
          - source_labels: [__name__]
            action: drop
            regex: kube_cronjob_(annotations|created|info|labels|metadata_resource_version|next_schedule_time|spec_failed_job_history_limit|spec_starting_deadline_seconds|spec_successful_job_history_limit|spec_suspend|status_active|status_last_schedule_time)
          # Keep only series with the check-verdict annotation; else one empty series per ConfigMap.
          - source_labels: [__name__]
            action: drop
            regex: kube_configmap_(created|info|labels|metadata_resource_version)
          - source_labels: [__name__, annotation_homelab_check_verdict]
            action: drop
            regex: kube_configmap_annotations;
      # Target labels are `app` and `pod` only: `controller`, `name`, `kind`, `namespace` would
      # rename the controllers' own series to exported_*.
      - job_name: flux
        scrape_interval: 1m
        kubernetes_sd_configs:
          - role: pod
            namespaces:
              names: [flux-system]
        relabel_configs:
          - source_labels: [__meta_kubernetes_pod_container_port_name]
            action: keep
            regex: http-prom
          - source_labels: [__meta_kubernetes_pod_label_app]
            target_label: app
          - source_labels: [__meta_kubernetes_pod_name]
            target_label: pod
        metric_relabel_configs:
          - source_labels: [__name__]
            action: drop
            regex: .+_bucket
      # The deploy-pipeline exporter's five homelab_deploy_* gauges, which monitor-bridge serves
      # and the deploy-pipeline rule group reads (docs/archive/deploy/d2-first-leaf.md,
      # *The deploy-pipeline exporter and its alerts*). The bridge refreshes
      # them once per 300s cycle, so 1m loses nothing. Hand-written rather than a `metrics`
      # item on monitor-bridge's entry, because the deploy tags derive a change to that field
      # onto every role that reads it. The port is monitor-bridge's
      # monitor_bridge_deploy_pipeline_port, which this role cannot read, and
      # tests/services/scraping/test_deploy_pipeline_scrape.py holds the two equal.
      # `ScrapeTargetDown` (service monitor-bridge, files/rules/scrape-targets.yaml) pages a
      # failed scrape.
      - job_name: deploy-pipeline
        scrape_interval: 1m
        static_configs:
          - targets: ['monitor-bridge.{{ k8s_namespace }}.svc:9180']
      # Plain exporters: each is a `metrics` item on its containers_list entry, which defines the
      # port.
{% for job in services | scrape_jobs(k8s_namespace) %}
      - job_name: {{ job.job }}
{% if job.interval is defined %}
        scrape_interval: {{ job.interval }}
{% endif %}
{% if job.path is defined %}
        metrics_path: {{ job.path }}
{% endif %}
{% if job.params is defined %}
        params:
{% for name, values in job.params | dictsort %}
          {{ name }}: [{% for value in values %}"{{ value }}"{{ ", " if not loop.last }}{% endfor %}]
{% endfor %}
{% endif %}
        static_configs:
          - targets: ['{{ job.target }}']
{% endfor %}
      # Credentials come from the prometheus-scrape-credentials Secret; never inline them here, this
      # ConfigMap is world-readable.
      - job_name: home-assistant
        scrape_interval: 1m
        metrics_path: /api/prometheus
        authorization:
          credentials_file: /etc/prometheus-scrape-creds/ha_token
        static_configs:
          - targets: ['home-assistant.{{ k8s_namespace }}.svc:{{ services | entry_port('home-assistant') }}']
      # The ingress probes (docs/archive/monitoring/m4-blackbox-ingress.md): one
      # target per entry the `ingress_probe_targets` filter yields, so an entry with a
      # `hostname` gets a probe with no edit here and `probe: false` opts it out. These are the
      # only probes of the ingress names. The
      # rewrite below keeps the probed URL as `instance`, which the alert descriptions name.
      #
      # Each target sets `service` (the entry, which is its deploy tag), so the
      # ingress-probes rules take `service` from this job rather than from a literal.
      # scripts/validate/alert_rules.py refuses those rules if any target here loses
      # `service`, or if a relabel rule below rewrites `service` or `job`. `page_tier`
      # selects which of the two per-target rules fires, so severity stays a literal.
      #
      # No `timeout` on either module: the exporter probes within this job's scrape timeout,
      # less its offset, so a slow backend reads probe_success 0 instead of failing the
      # scrape. A failed scrape would set that target's `up` to 0 and the scrape-target rule
      # would page the same failure a second time.
      - job_name: blackbox-ingress
        scrape_interval: 1m
        metrics_path: /probe
        static_configs:
{% for tile in services | ingress_probe_targets %}
          - targets: ['https://{{ tile.hostname }}.local.{{ domain }}']
            labels:
              service: {{ tile.entry }}
              module: {{ 'http_sso_302' if tile.behind_sso else 'http_2xx' }}
              page_tier: {{ 'critical' if services | in_service_tier(tile.entry, 'home-critical') else 'warning' }}
{% endfor %}
        # The standard blackbox multi-target rewrite: the target becomes the probe's `target`
        # parameter and the series' `instance`, the `module` label becomes the `module`
        # parameter, and the scrape goes to the exporter's Service.
        relabel_configs:
          - source_labels: [__address__]
            target_label: __param_target
          - source_labels: [module]
            target_label: __param_module
          - source_labels: [__param_target]
            target_label: instance
          - target_label: __address__
            replacement: 'blackbox-exporter.{{ k8s_namespace }}.svc:{{ services | entry_port('blackbox-exporter') }}'
      # No Pi ping or Loki /ready target: `up{job="node-pi"}` and ScrapeTargetDown cover them.
      - job_name: blackbox-extra
        scrape_interval: 1m
        metrics_path: /probe
        static_configs:
          # Pi target needs 30s: at the 10s default a loaded Pi's probes stop at blackbox's 9.5s
          # cap.
          - targets: ['http://{{ hosts['daniel-pi'].server_ip }}:51821']
            labels: {service: wg-easy, module: http_2xx, page_tier: warning, __scrape_timeout__: 30s}
          - targets: ['https://email-rss.{{ domain }}/admin/login']
            labels: {service: email-to-rss, module: http_2xx, page_tier: warning}
          - targets: ['http://ical-proxy.{{ k8s_namespace }}.svc.cluster.local:5000/calendar1.ics']
            labels: {service: ical-proxy, module: http_2xx, page_tier: warning}
          - targets: ['https://livesync.local.{{ domain }}/']
            labels: {service: livesync, module: http_401, page_tier: warning}
          - targets: ['https://scrutiny.local.{{ domain }}/api/health']
            labels: {service: scrutiny, module: http_2xx, page_tier: warning}
          - targets: ['https://mcp.local.{{ domain }}/health']
            labels: {service: homelab-mcp, module: http_body_ok, page_tier: warning}
          - targets: ['https://vault-mcp.local.{{ domain }}/mcp']
            labels: {service: vault-mcp, module: http_401, page_tier: warning}
{% if traefik_k8s_manage_crowdsec | default(true) %}
          - targets: ['https://edge-selfcheck.local.{{ domain }}/.well-known/traefik-edge-selfcheck']
            labels: {service: traefik, module: http_body_OK, page_tier: critical}
{% endif %}
          - targets: ['{{ dns_k8s_vip }}:53']
            labels: {service: pihole, module: dns_a_homepage, page_tier: {{ 'critical' if services | in_service_tier('pihole', 'home-critical') else 'warning' }}}
          - targets: ['{{ mqtt_k8s_vip }}:1883']
            labels: {service: mosquitto, module: tcp_connect, page_tier: {{ 'critical' if services | in_service_tier('mosquitto', 'home-critical') else 'warning' }}}
          - targets: ['{{ jellyfin_k8s_lan_ip }}:8096']
            labels: {service: jellyfin, module: tcp_connect, page_tier: warning}
          - targets: ['{{ slzb_ip }}:6638']
            labels: {service: zigbee2mqtt, module: tcp_connect, page_tier: warning}
          - targets: ['nut.{{ k8s_namespace }}.svc.cluster.local:3493']
            labels: {service: nut, module: tcp_connect, page_tier: warning}
          - targets: ['http://airflow-scheduler.{{ k8s_namespace }}.svc.cluster.local:8974/health']
            labels: {service: airflow, module: http_2xx, page_tier: own-rule}
        relabel_configs:
          - source_labels: [__address__]
            target_label: __param_target
          - source_labels: [module]
            target_label: __param_module
          - source_labels: [__param_target]
            target_label: instance
          - target_label: __address__
            replacement: 'blackbox-exporter.{{ k8s_namespace }}.svc:{{ services | entry_port('blackbox-exporter') }}'
      # This job catches a container that comes back attached to no Docker network (port stays
      # closed).
      - job_name: blackbox-pi-ports
        scrape_interval: 1m
        # A contended Pi can take over 10s to accept a connect, reported as a closed port.
        scrape_timeout: 30s
        metrics_path: /probe
        static_configs:
{% for published in ((hosts['daniel-pi'].compose_services | published_ports) | sort) %}
          - targets: ['{{ hosts['daniel-pi'].server_ip }}:{{ published.split(':')[1] }}']
            labels: {service: {{ published.split(':')[0] }}, module: tcp_connect}
{% endfor %}
        relabel_configs:
          - source_labels: [__address__]
            target_label: __param_target
          - source_labels: [module]
            target_label: __param_module
          - source_labels: [__param_target]
            target_label: instance
          - target_label: __address__
            replacement: 'blackbox-exporter.{{ k8s_namespace }}.svc:{{ services | entry_port('blackbox-exporter') }}'
      # Per-pod discovery, not a Service: two different GPUs, so a ClusterIP would flip between
      # cards.
      # amdgpu exports homelab_gpu_busy_percent; i915 an idle counter, rc6_residency (busy = 1 -
      # rate).
      - job_name: gpu
        scrape_interval: 1m
        kubernetes_sd_configs:
          - role: pod
        relabel_configs:
          - source_labels: [__meta_kubernetes_pod_label_app]
            action: keep
            regex: gpu-exporter
          - source_labels: [__meta_kubernetes_pod_container_port_number]
            action: keep
            regex: "{{ services | entry_port('gpu-exporter') }}"
          - source_labels: [__meta_kubernetes_pod_node_name]
            target_label: origin
          - source_labels: [__meta_kubernetes_pod_node_name]
            target_label: instance
      # `origin` carries the node name so monitor-bridge's origin="daniel-server" checks keep their
      # scope.
      - job_name: node
        scrape_interval: 1m
        kubernetes_sd_configs:
          - role: pod
        relabel_configs:
          - source_labels: [__meta_kubernetes_pod_label_app]
            action: keep
            regex: node-exporter
          - source_labels: [__meta_kubernetes_pod_container_port_number]
            action: keep
            regex: "9100"
          - source_labels: [__meta_kubernetes_pod_node_name]
            target_label: origin
          - source_labels: [__meta_kubernetes_pod_node_name]
            target_label: instance
      # The Alloy shipper DaemonSet, scraped per-pod like the otel/crowdsec jobs — one target
      # per node, no origin label (it stays out of the origin-pinned Scrape Targets set and
      # joins the cluster-native count). The port is Alloy's 12345.
      - job_name: alloy
        scrape_interval: 1m
        kubernetes_sd_configs:
          - role: pod
        relabel_configs:
          - source_labels: [__meta_kubernetes_pod_label_app]
            action: keep
            regex: alloy
          - source_labels: [__meta_kubernetes_pod_container_port_number]
            action: keep
            regex: "12345"
          - source_labels: [__meta_kubernetes_pod_node_name]
            target_label: node
      # Discover by port 9707, not the `app` label: the sidecar shares the *arr's pod, so the label
      # would also match the *arr's own port and scrape an HTML page.
      - job_name: exportarr
        scrape_interval: 1m
        kubernetes_sd_configs:
          - role: pod
        relabel_configs:
          - source_labels: [__meta_kubernetes_pod_container_port_number]
            action: keep
            regex: "9707"
          - source_labels: [__meta_kubernetes_pod_label_app]
            target_label: arr
          # DECIDED: no `origin` label here. `ScrapeTargetsMissing` (files/rules/scrape-targets.yaml)
          # counts `up{origin="daniel-server"}` against a floor of 1. The node and gpu jobs both
          # carry that origin, so the floor fires only once both are gone; a single dead
          # exporter pages through ScrapeTargetDown instead. Labelling the exportarr pods would
          # put three more series behind the same floor and weaken it further.
      # daniel-pi, the one host outside the cluster. STATIC targets, not discovery: the two
      # jobs above use `role: pod`, which only ever finds pods, and the Pi runs no kubelet.
      #
      # `origin` is set by hand here. The pod-discovery jobs derive it from the node name via
      # relabel; a static target has no such metadata. Without the label the Pi's series would
      # be indistinguishable from the origin-less ones. The rules select the Pi by `origin`: the
      # `Pi*` rules in files/rules/hosts.yaml and pi-checks.yaml match `origin="daniel-pi"`, and
      # HostCoverageShortfall excludes it with `origin!~"daniel-pi"`.
      #
      # Reached at the LAN IP, not a bridge address: Docker's published-port NAT bypasses the
      # Pi's UFW INPUT chain (see the `ufw:` section of hosts/daniel-pi/package.yml), so no
      # firewall rule is needed and the exporters are LAN-reachable.
      #
      # `scrape_timeout: 30s` on both Pi jobs, against the 10s global default no other job
      # overrides. The Pi is a 4-core Zero 2 W whose load5 reaches 2.4-6.6 and whose CPU PSI
      # sits at ~30% `some`, so a scrape that lands in a contended stretch takes seconds
      # rather than the 0.2-0.6s median, and one that crosses 10s reads `up == 0` with a
      # healthy exporter behind it. 30s costs nothing on a 1m interval, and a Pi that
      # genuinely stops answering still reads down within the minute. Set per job rather than
      # globally so an in-cluster target that takes 30s still reads as the failure it is.
      - job_name: node-pi
        scrape_interval: 1m
        scrape_timeout: 30s
        static_configs:
          - targets: ['{{ k8s_pi_client_ip }}:9100']
            labels:
              origin: daniel-pi
              instance: daniel-pi
      # A log shipper fails quietly (container up, lines stop), so loki_write_*_entries_total expose
      # it.
      - job_name: alloy-pi
        scrape_interval: 1m
        scrape_timeout: 30s
        static_configs:
          - targets: ['{{ k8s_pi_client_ip }}:{{ hosts['daniel-pi'].compose_services | entry_port('alloy') }}']
            labels:
              origin: daniel-pi
              instance: daniel-pi
      # containerd's metrics path is /v1/metrics, not /metrics.
      - job_name: dockerd-pi
        scrape_interval: 1m
        scrape_timeout: 30s
        static_configs:
          - targets: ['{{ k8s_pi_client_ip }}:9323']
            labels:
              origin: daniel-pi
              instance: daniel-pi
      - job_name: containerd-pi
        scrape_interval: 1m
        scrape_timeout: 30s
        metrics_path: /v1/metrics
        static_configs:
          - targets: ['{{ k8s_pi_client_ip }}:1338']
            labels:
              origin: daniel-pi
              instance: daniel-pi
      # Node LAN IP, not 127.0.0.1: Prometheus runs in a pod. UFW default-deny INPUT applies, so the
      # component's `ufw:` allows from the pod CIDR and agent node must match this job.
      - job_name: coredns-host
        scrape_interval: 1m
        static_configs:
          - targets: ['{{ k8s_node_client_ip }}:{{ k8s_node_dns_metrics_port }}']
            labels:
              origin: daniel-box
              instance: daniel-box
      - job_name: crowdsec-node-agents
        scrape_interval: 1m
        kubernetes_sd_configs:
          - role: pod
            namespaces:
              names: [{{ k8s_namespace }}]
        relabel_configs:
          - source_labels: [__meta_kubernetes_pod_label_app]
            regex: crowdsec-node-agent
            action: keep
          - source_labels: [__meta_kubernetes_pod_container_port_number]
            regex: "6060"
            action: keep
          - source_labels: [__meta_kubernetes_pod_node_name]
            target_label: node
      # The keep on containerPort 6060 selects the sidecar: pod-role SD emits one target per
      # declared port. Needs the per-app grant in networkpolicy-crowdsec-sidecars.yaml.j2; grant and
      # job work as a pair.
{% for app in crowdsec_k8s_sidecar_agents %}
      - job_name: crowdsec-{{ app }}-agent
        scrape_interval: 1m
        kubernetes_sd_configs:
          - role: pod
            namespaces:
              names: [{{ k8s_namespace }}]
        relabel_configs:
          - source_labels: [__meta_kubernetes_pod_label_app]
            regex: {{ app }}
            action: keep
          - source_labels: [__meta_kubernetes_pod_container_port_number]
            regex: "6060"
            action: keep
{% endfor %}
      # Longhorn volume robustness/fullness and node storage headroom. Longhorn v1.12 ships
      # NetworkPolicies that admit only its own components, and
      # k8s/roles/longhorn/templates/networkpolicy-metrics.yaml.j2 admits this scrape; without
      # it the target reads `up == 0` with a connection refused.
      #
      # kubernetes_sd_configs with role: endpoints, scoped to longhorn-system, so both
      # longhorn-manager pods behind the Service are scraped independently every interval. A
      # static target on the longhorn-backend ClusterIP holds one keep-alive connection to one
      # manager pod for hours, so `count by (node) (longhorn_disk_usage_bytes)` shows a single
      # node and the other's disk headroom is unobservable.
      # role: endpoints rather than endpointslice because the Endpoints object carries a
      # populated targetRef for both addresses, so
      # __meta_kubernetes_endpoint_address_target_name resolves despite longhorn-manager being
      # DaemonSet-managed. RBAC already grants `get, list, watch` on `endpoints` cluster-wide
      # (ClusterRole below). `instance` is each pod's IP, which no dashboard or check pins.
      #
      # Two traps for a Longhorn panel or check: longhorn_volume_last_backup_at has 14 series
      # that all read 0 (a freshness panel on it would falsely report "no backups ever"), and
      # longhorn_volume_robustness is one-hot over a `state` label (healthy/degraded/faulted/
      # unknown x 14 volumes = 56 series) rather than an attached/detached split, so any panel
      # must select on `state` explicitly.
      - job_name: longhorn
        scrape_interval: 1m
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names: [longhorn-system]
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_name]
            regex: longhorn-backend
            action: keep
          - source_labels: [__meta_kubernetes_endpoint_port_name]
            regex: manager
            action: keep
          - source_labels: [__meta_kubernetes_endpoint_address_target_name]
            target_label: pod
        # Separate from control_plane_bucket_drop(), whose regex names the UNPREFIXED workqueue_*
        # and rest_client_* families: extending it would apply this job's drop to the kubelet job.
        metric_relabel_configs:
          - source_labels: [__name__]
            action: drop
            regex: >-
              (longhorn_rest_client_rate_limiter_latency_seconds|longhorn_rest_client_request_latency_seconds|longhorn_workqueue_queue_duration_seconds|longhorn_workqueue_work_duration_seconds)_bucket
      # This stack's OWN Loki/Tempo internals, distinct from the loki-homelab job above
      # (that one is the general-purpose homelab log store). instance_role separates the
      # two so a dashboard/alert query doesn't accidentally blend observability's internal
      # health series with the homelab's.
      - job_name: loki-internal
        scrape_interval: 1m
        static_configs:
          - targets: ['loki.{{ k8s_observability_namespace }}.svc:3100']
            labels:
              instance_role: observability
      - job_name: tempo-internal
        scrape_interval: 1m
        static_configs:
          - targets: ['tempo.{{ k8s_observability_namespace }}.svc:3200']
            labels:
              instance_role: observability
      # Alertmanager has no route, so this job is how readers see whether it is up and delivering.
      - job_name: alertmanager
        scrape_interval: 1m
        static_configs:
          - targets: ['alertmanager:9093']
      # Dialed at the kubelet's :10250 directly; needs only the `nodes/metrics` subresource.
      # insecure_skip_verify: no usable SAN on the kubelet cert; the token is still verified
      # (TokenReview).
      - job_name: kubernetes-cadvisor
        scrape_interval: 1m
        scheme: https
        metrics_path: /metrics/cadvisor
        tls_config:
          ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
          insecure_skip_verify: true
        bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
        kubernetes_sd_configs:
          - role: node
        relabel_configs:
          - action: labelmap
            regex: __meta_kubernetes_node_label_(.+)
        # NAMED EXPLICITLY, never a glob: container_memory_failcnt is a different family check.py
        # reads, and `container_memory_fail.*` would swallow it.
        metric_relabel_configs:
          - source_labels: [__name__]
            action: drop
            regex: (container_blkio_device_usage_total|container_tasks_state|container_memory_failures_total)
      # The kubelet's OWN metrics, distinct from the cadvisor job above. cadvisor answers "what
      # is each container doing"; these answer "is the kubelet itself healthy" — pod start
      # duration, PLEG relist latency, eviction counts, volume mount failures. A node that is
      # slow to start pods or is quietly evicting them reads as a perfectly Ready node until
      # one of these series is available to look at.
      #
      # Same host, same auth, same RBAC as cadvisor: the kubelet authorizer maps /metrics and
      # /metrics/resource onto `nodes/metrics` exactly as it maps /metrics/cadvisor, so this
      # needs no new grant. insecure_skip_verify is on for the reason stated above.
      # 1m, not the 15s global — see the interval note at the kube-state-metrics job.
      - job_name: kubernetes-kubelet
        scrape_interval: 1m
        scheme: https
        metrics_path: /metrics
        tls_config:
          ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
          insecure_skip_verify: true
        bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
        kubernetes_sd_configs:
          - role: node
        relabel_configs:
          - action: labelmap
            regex: __meta_kubernetes_node_label_(.+)
{{ control_plane_bucket_drop() }}
          # DECIDED: one copy of the server node's registry (#6331). k3s serves the apiserver,
          # etcd client, scheduler and kubelet from one process, so the server node's kubelet
          # /metrics returns the same series as the kubernetes-apiserver job.
          # The `apiserver_` and `etcd_` families stay with that job, and every
          # other family stays here, so each keeps the job label it had. The agent node carries
          # no control-plane label and keeps its own `apiserver_` client series.
          - source_labels: [node_role_kubernetes_io_control_plane, __name__]
            separator: ';'
            action: drop
            regex: 'true;(apiserver|etcd)_.+'
      # Names collide with the cadvisor job and monitor-bridge's cadvisor_sel() is not job-pinned,
      # so check_restarts spans both. 1m stays safe: that arm's crash-loop spacing is 15-19 minutes.
      - job_name: kubernetes-kubelet-resource
        scrape_interval: 1m
        scheme: https
        metrics_path: /metrics/resource
        tls_config:
          ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
          insecure_skip_verify: true
        bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
        kubernetes_sd_configs:
          - role: node
        relabel_configs:
          - action: labelmap
            regex: __meta_kubernetes_node_label_(.+)
      # API server /metrics is a non-resource URL: `nodes/metrics` does not cover it; the
      # ClusterRole below needs a `nonResourceURLs` rule, else this scrape 403s while every other
      # job stays green.
      - job_name: kubernetes-apiserver
        scrape_interval: 1m
        scheme: https
        metrics_path: /metrics
        tls_config:
          ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
        bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
        static_configs:
          - targets: ['kubernetes.default.svc:443']
{{ control_plane_bucket_drop() }}
          # Keeps only `apiserver_` and `etcd_` families; the kubelet job holds the rest.
          - source_labels: [__name__]
            action: keep
            regex: '(apiserver|etcd)_.+'
{% if k3s_etcd_expose_metrics | default(false) %}
      # Embedded etcd, the single existential risk on a one-server control plane: db size
      # against its quota, fsync/commit latency, leader changes, and proposal failures. None of
      # it is visible anywhere else, and the failure it warns about is the one the restore
      # runbook exists for.
      #
      # GATED, because the target does not exist until k3s is restarted with
      # --etcd-expose-metrics. k3s serves this on 2381 either way; the flag only moves the bind
      # from 127.0.0.1 to 0.0.0.0, which is what puts it in reach of a pod-network scrape. Plain
      # HTTP and no auth by k3s's design — the port is protected the same way :10250 is, by the
      # host's default-deny UFW policy, and it carries no cluster data, only counters.
      #
      # ONE switch drives both halves — `k3s_etcd_expose_metrics` in k8s/vars.yml gates
      # this job and the k3s flag alike, so they cannot drift into "port open, nobody scraping"
      # or "job armed, port closed". They still land in two runs: flip the var, run
      # k3s-bringup.yml to rewrite the unit and restart k3s, THEN deploy observability. Deploying
      # this first only means the target reads down until the bringup run catches up.
      - job_name: etcd
        scrape_interval: 30s
        static_configs:
          - targets: ['{{ hosts[k8s_primary_node].server_ip }}:2381']
            labels:
              instance_role: control-plane
{% endif %}
{% endset %}
{{ observability_prometheus_config -}}
---
# Prometheus authenticates to the API server as itself for the kubernetes_sd_configs discovery
# above (enumerating nodes for scrape targets), and its bearer token is presented to each
# kubelet directly for the cadvisor scrape. Read-only and list/watch-only. It cannot mutate
# anything, and it is deliberately NOT granted secrets or configmaps.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: prometheus
  namespace: {{ k8s_observability_namespace }}
automountServiceAccountToken: true
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: prometheus
rules:
  - apiGroups: [""]
    resources: [nodes, nodes/metrics, services, endpoints, pods]
    verbs: [get, list, watch]
  # /metrics on the API server is a non-resource URL that `nodes/metrics` does not cover.
  - nonResourceURLs: ["/metrics"]
    verbs: [get]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: prometheus
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: prometheus
subjects:
  - kind: ServiceAccount
    name: prometheus
    namespace: {{ k8s_observability_namespace }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: prometheus
  namespace: {{ k8s_observability_namespace }}
spec:
  # ReadWriteOnce PVC — see the note on the loki Deployment.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: prometheus
  template:
    metadata:
      annotations:
        # Rolls THIS workload alone when its own ConfigMap changes. The role skips the
        # shared rollout-restart, so without this the edit reaches the ConfigMap and never
        # the pod. See this role's CLAUDE.md, `## One config change, one restart`.
        {{ checksum_annotation('config', observability_prometheus_config | hash('sha1')) }}
      labels:
        app: prometheus
        netpol-baseline: enforced
    spec:
      # Without this the pod runs as the namespace `default` SA, whose token cannot list nodes —
      # kubernetes_sd_configs then discovers zero targets and the cadvisor job silently reports
      # no series rather than erroring.
      # Tier 1: monitor-bridge (itself homelab-critical) reads this Prometheus every cycle for
      # its disk, memory, OOM, restart and PVC verdicts — see `DECIDED: observability tiers` in
      # this role's CLAUDE.md.
{{ pod_shell('homelab-critical', service_account='prometheus', run_as_user=65534, run_as_group=65534, fs_group=65534) }}
      containers:
        - name: prometheus
          image: {{ observability_k8s_prometheus_image }}
          imagePullPolicy: IfNotPresent
{{ hardened_security_context(non_root=true) }}
          args:
            - --config.file=/etc/prometheus/prometheus.yml
            # Checks prometheus.yml and every rule file every 30s (the interval flag's default)
            # and reloads on a change. This is what lets a rule edit skip the pod roll; see the
            # DECIDED marker at the prometheus-rules mount below.
            - --config.auto-reload
            - --storage.tsdb.path=/prometheus
            - --storage.tsdb.retention.time={{ observability_prometheus_retention }}
            # Second cap, in bytes: the time cap alone cannot bound the PVC, and a full PVC wedges
            # Prometheus.
            - --storage.tsdb.retention.size={{ observability_prometheus_retention_size }}
            # No --web.enable-remote-write-receiver: with no NetworkPolicy, any pod could push
            # series.
          ports:
            - name: http
              containerPort: 9090
              hostPort: 9090
              hostIP: {{ observability_query_host_ip }}
          volumeMounts:
            - name: prometheus-config
              mountPath: /etc/prometheus
            # DECIDED: rules reload in place. A rule edit reaches the pod through this mount and
            # --config.auto-reload, and the prometheus-rules ConfigMap carries no checksum
            # annotation, so the edit never rolls Prometheus. A roll of this Recreate pod costs
            # an evaluation gap and a WAL replay, and every monitoring slice edits rules.
            # Once the role is flux-owned, the renderer's checksum/restart skips this ConfigMap
            # too (RELOADED_IN_PLACE in scripts/renderer/renderer_lib/restart.py).
            # prometheus.yml keeps its checksum and still rolls the pod. Two things hold it:
            # the mount is a whole directory, because a subPath mount never sees a ConfigMap
            # update, and it sits beside /etc/prometheus, which is the prometheus-config
            # volume. test_observability_config_rolls_one_workload.py fails if Prometheus
            # mounts the rules without the reload flag.
            - name: prometheus-rules
              mountPath: /etc/prometheus-rules
              readOnly: true
            - name: prometheus-data
              mountPath: /prometheus
            # /etc, not /run/secrets (token-shadow guard); 0444 because prometheus runs as nobody.
            - name: prometheus-scrape-creds
              mountPath: /etc/prometheus-scrape-creds
              readOnly: true
          readinessProbe:
            httpGet:
              path: /-/ready
              port: 9090
            initialDelaySeconds: 15
            periodSeconds: 10
          # 30s + 10x30s: a full-WAL replay after an OOM kill outlasts a clean restart's 20s to Ready.
          livenessProbe:
            httpGet:
              path: /-/healthy
              port: 9090
            initialDelaySeconds: 30
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 10
          # The request governs eviction order: below the working set, Prometheus is evicted early.
          # The limit leaves headroom because an OOMKill loses the unflushed head block.
{{ container_resources(cpu_limit='1', mem_limit='3Gi', cpu_request='50m', mem_request='1728Mi') }}
      volumes:
        - name: prometheus-config
          configMap:
            name: prometheus-config
        - name: prometheus-rules
          configMap:
            name: prometheus-rules
        - name: prometheus-data
          persistentVolumeClaim:
            claimName: prometheus-data
        - name: prometheus-scrape-creds
          secret:
            secretName: prometheus-scrape-credentials
            defaultMode: 0o444
---
apiVersion: v1
kind: Service
metadata:
  name: prometheus
  namespace: {{ k8s_observability_namespace }}
  labels:
    # Headlamp's Prometheus plugin finds its backend by this label (it checks
    # `headlamp-prometheus=true` on a Service before the generic app.kubernetes.io names) and
    # queries it via the API server's service proxy — k8s/roles/headlamp/templates/rbac.yaml.j2
    # holds the matching grant. Dropping the label leaves the plugin loaded and every chart
    # empty, with no error.
    headlamp-prometheus: "true"
spec:
  # Pinned: host-side query tools carry this address as a constant.
  clusterIP: {{ observability_prometheus_cluster_ip }}
  selector:
    app: prometheus
  ports:
    - name: http
      port: 9090
      targetPort: 9090
