{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'service.yml.j2' import service with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
# Only source of kube_pod_status_* / kube_deployment_status_* series; metrics-server exports none.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: kube-state-metrics
  namespace: {{ k8s_observability_namespace }}
automountServiceAccountToken: true
---
# Keep in step with --resources and --custom-resource-state-config: an unmatched grant is unused
# privilege, and an argument without a grant logs RBAC errors every resync.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: kube-state-metrics
rules:
  - apiGroups: [""]
    resources: [pods]
    verbs: [list, watch]
  - apiGroups: [apps]
    resources: [deployments, statefulsets, daemonsets]
    verbs: [list, watch]
  # ReplicaSets, for kube_replicaset_owner alone (pod to Deployment hop in workload-service rules).
  - apiGroups: [apps]
    resources: [replicasets]
    verbs: [list, watch]
  # Nodes, for kube_node_status_allocatable: dri-device-plugin can wedge while its pod stays Ready.
  - apiGroups: [""]
    resources: [nodes]
    verbs: [list, watch]
  # Services, for kube_service_status_load_balancer_ingress alone (the MetalLB VIP check).
  - apiGroups: [""]
    resources: [services]
    verbs: [list, watch]
  # Jobs, for the soak, snapshot and verify Job durations a landing waits on.
  - apiGroups: [batch]
    resources: [jobs]
    verbs: [list, watch]
  # CronJobs, for kube_cronjob_status_last_successful_time alone (the health CronJobs' run clock).
  - apiGroups: [batch]
    resources: [cronjobs]
    verbs: [list, watch]
  # ConfigMaps, for kube_configmap_annotations alone, and for one annotation of it: the
  # `homelab/check-verdict` the two health CronJobs patch onto their own verdict ConfigMaps. A list grant cannot be narrowed by name, so this lets kube-state-metrics read
  # every ConfigMap's data in memory. It exports only metadata: --metric-annotations-allowlist
  # below names the one annotation, no collector exports `data`, and the Prometheus job drops
  # every other kube_configmap_* family and every series without the annotation. No Secret
  # grant is added, and tests/k8s/flux/test_no_secret_in_a_moved_jobs_configmap.py keeps
  # secret values out of ConfigMaps in any case.
  - apiGroups: [""]
    resources: [configmaps]
    verbs: [list, watch]
  # Flux kinds for gotk_resource_info; the collector also watches the CRDs, so it needs those too.
  - apiGroups: [kustomize.toolkit.fluxcd.io]
    resources: [kustomizations]
    verbs: [list, watch]
  - apiGroups: [source.toolkit.fluxcd.io]
    resources: [ocirepositories]
    verbs: [list, watch]
  - apiGroups: [apiextensions.k8s.io]
    resources: [customresourcedefinitions]
    verbs: [list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: kube-state-metrics
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: kube-state-metrics
subjects:
  - kind: ServiceAccount
    name: kube-state-metrics
    namespace: {{ k8s_observability_namespace }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kube-state-metrics
  namespace: {{ k8s_observability_namespace }}
spec:
{{ spec_shell('RollingUpdate') }}
  replicas: 1
  selector:
    matchLabels:
      app: kube-state-metrics
  template:
    metadata:
      labels:
        app: kube-state-metrics
        netpol-baseline: enforced
    spec:
      # Tier 4; `DECIDED: observability tiers` in this role's CLAUDE.md names the tier-1
      # exceptions.
{{ pod_shell('homelab-best-effort', service_account='kube-state-metrics', run_as_user=65534, run_as_group=65534, non_root=true) }}
      containers:
        - name: kube-state-metrics
          image: {{ observability_k8s_kube_state_metrics_image }}
          imagePullPolicy: IfNotPresent
          args:
            # Must match the ClusterRole above, as must --custom-resource-state-config below.
            - --resources=pods,deployments,replicasets,statefulsets,daemonsets,nodes,services,jobs,cronjobs,configmaps
            # The one ConfigMap annotation exported: the verdict the health CronJobs write. It
            # reaches Prometheus as the annotation_homelab_check_verdict label of
            # kube_configmap_annotations.
            - --metric-annotations-allowlist=configmaps=[homelab/check-verdict]
            # homelab/role and kustomize.toolkit.fluxcd.io/name name the deploy tag that applied
            # a Deployment or DaemonSet. They reach Prometheus as label_homelab_role and
            # label_kustomize_toolkit_fluxcd_io_name on kube_<kind>_labels, which the
            # workload-service recording rules read.
            - --metric-labels-allowlist=pods=[app],deployments=[app,homelab/role,kustomize.toolkit.fluxcd.io/name],daemonsets=[homelab/role,kustomize.toolkit.fluxcd.io/name]
            # Quoted as one JSON string: to_json emits `": "`, which a plain YAML scalar cannot
            # hold.
            - {{ ('--custom-resource-state-config=' ~ (observability_ksm_flux_resource_state | to_json)) | to_json }}
          ports:
            - name: metrics
              containerPort: 8080
            - name: telemetry
              containerPort: 8081
          # The probes hit DIFFERENT ports: /livez on 8080, /readyz on 8081. Neither path exists on
          # the other port, so a swapped liveness probe gets 404 and restarts the container after
          # every start.
{{ hardened_security_context(read_only=true) }}
          readinessProbe:
            httpGet:
              path: /readyz
              port: 8081
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /livez
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 10
{{ container_resources(cpu_limit='200m', mem_limit='192Mi', cpu_request='10m', mem_request='32Mi') }}
---
{{ service('kube-state-metrics', 8080, port_name='metrics', extra_ports=[{'name': 'telemetry', 'port': 8081}], namespace=k8s_observability_namespace) -}}
