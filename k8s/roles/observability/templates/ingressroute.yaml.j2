{% from 'ingressroute.yml.j2' import ingressroute with context %}
---
{# The Service is `grafana`, not the services entry `observability`; `namespace` is explicit because
   Traefik has allowCrossNamespace off. #}
{{ ingressroute(
    'grafana',
    container_item.hostname,
    container_item.port,
    container_item.use_authelia,
    namespace=k8s_observability_namespace
  )
}}
