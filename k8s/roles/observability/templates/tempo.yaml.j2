{% from 'checksum-annotation.yml.j2' import checksum_annotation %}
{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: tempo-config
  namespace: {{ k8s_observability_namespace }}
data:
  config.yaml: |
{# Captured so the Deployment below can hash it into checksum/config. #}
{% set observability_tempo_config %}
    server:
      http_listen_port: 3200
    distributor:
      receivers:
        otlp:
          protocols:
            grpc:
              endpoint: 0.0.0.0:4317
    # backend_scheduler replaces compactor; the doubled `compaction` nesting is not a typo.
    # A wrong path silently falls back to 336h retention; read block_retention from /status/config.
    backend_scheduler:
      provider:
        compaction:
          compaction:
            block_retention: {{ observability_tempo_retention }}
    # Set on the worker too: it has its own compaction settings and otherwise reads the 336h
    # default.
    backend_worker:
      compaction:
        block_retention: {{ observability_tempo_retention }}
    storage:
      trace:
        backend: local
        local:
          path: /var/tempo/blocks
        wal:
          path: /var/tempo/wal
    # Opt out of Tempo's anonymous usage stats to grafana.com; nothing here reaches the internet.
    usage_report:
      reporting_enabled: false
{% endset %}
{{ observability_tempo_config -}}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: tempo
  namespace: {{ k8s_observability_namespace }}
spec:
  # ReadWriteOnce PVC — see the note on the loki Deployment.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: tempo
  template:
    metadata:
      annotations:
        # Rolls THIS workload alone when its own ConfigMap changes. The role skips the
        # shared rollout-restart, so without this the edit reaches the ConfigMap and never
        # the pod. See this role's CLAUDE.md, `## One config change, one restart`.
        {{ checksum_annotation('config', observability_tempo_config | hash('sha1')) }}
      labels:
        app: tempo
        netpol-baseline: enforced
    spec:
      # Tier 4; `DECIDED: observability tiers` in this role's CLAUDE.md names the tier-1
      # exceptions.
      # No init container chowns /var/tempo: the kubelet applies fsGroup ownership to the
      # volume at mount time, which is what Tempo's non-root uid 10001 needs.
      #
      # fsGroup ORs group bits onto everything on the volume, which bit Traefik's acme.json
      # (it requires 0600 and refuses group-readable). Tempo wants group ownership, so this
      # is the case fsGroup is for.
{{ pod_shell('homelab-best-effort', run_as_user=10001, run_as_group=10001, fs_group=10001) }}
      containers:
        - name: tempo
          image: {{ observability_k8s_tempo_image }}
          imagePullPolicy: IfNotPresent
          args: ["-config.file=/etc/tempo/config.yaml"]
{{ hardened_security_context(non_root=true) }}
          ports:
            - name: http
              containerPort: 3200
              hostPort: 3200
              hostIP: {{ observability_query_host_ip }}
            - name: otlp-grpc
              containerPort: 4317
          volumeMounts:
            - name: tempo-config
              mountPath: /etc/tempo
            - name: tempo-data
              mountPath: /var/tempo
          readinessProbe:
            httpGet:
              path: /ready
              port: 3200
            initialDelaySeconds: 20
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /ready
              port: 3200
            initialDelaySeconds: 30
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 6
{{ container_resources(cpu_limit='1', mem_limit='1Gi', cpu_request='50m', mem_request='128Mi') }}
      volumes:
        - name: tempo-config
          configMap:
            name: tempo-config
        - name: tempo-data
          persistentVolumeClaim:
            claimName: tempo-data
---
apiVersion: v1
kind: Service
metadata:
  name: tempo
  namespace: {{ k8s_observability_namespace }}
spec:
  # Pinned: host-side query tools carry this address as a constant.
  clusterIP: {{ observability_tempo_cluster_ip }}
  selector:
    app: tempo
  ports:
    - name: http
      port: 3200
      targetPort: 3200
    - name: otlp-grpc
      port: 4317
      targetPort: 4317
