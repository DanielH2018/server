---
# Scrape credentials, file-mounted and referenced via password_file/credentials_file so the
# values stay out of the world-readable prometheus-config ConfigMap.
apiVersion: v1
kind: Secret
metadata:
  name: prometheus-scrape-credentials
  namespace: {{ k8s_observability_namespace }}
type: Opaque
stringData:
  ha_token: "{{ prometheus_ha_token }}"
