{% from 'checksum-annotation.yml.j2' import checksum_annotation %}
{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: loki-config
  namespace: {{ k8s_observability_namespace }}
data:
  loki.yaml: |
{# Captured so the Deployment below can hash it into checksum/config. #}
{% set observability_loki_config %}
    auth_enabled: false
    # The key is analytics.reporting_enabled; Loki rejects an unknown config field at startup.
    analytics:
      reporting_enabled: false
    server:
      http_listen_port: 3100
      grpc_listen_port: 9096
      log_level: warn
    common:
      instance_addr: 127.0.0.1
      path_prefix: /loki
      storage:
        filesystem:
          chunks_directory: /loki/chunks
          rules_directory: /loki/rules
      replication_factor: 1
      ring:
        kvstore:
          store: inmemory
    schema_config:
      configs:
        - from: 2024-01-01
          store: tsdb
          object_store: filesystem
          schema: v13
          index:
            prefix: index_
            period: 24h
    limits_config:
      retention_period: {{ observability_loki_retention }}
      # Default 256KB cap silently drops larger lines; Claude Code logs whole prompts as single
      # lines.
      max_line_size: 2MB
      reject_old_samples: false
      allow_structured_metadata: true
    compactor:
      working_directory: /loki/compactor
      # Without retention_enabled, retention_period is inert and the volume grows without bound.
      retention_enabled: true
      delete_request_store: filesystem
    ruler:
      storage:
        type: local
        local:
          directory: /loki/rules
{% endset %}
{{ observability_loki_config -}}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: loki
  namespace: {{ k8s_observability_namespace }}
spec:
  # ReadWriteOnce PVC on one node: a rolling update would leave the new pod Pending forever.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: loki
  template:
    metadata:
      annotations:
        # Rolls THIS workload alone when its own ConfigMap changes. The role skips the
        # shared rollout-restart, so without this the edit reaches the ConfigMap and never
        # the pod. See this role's CLAUDE.md, `## One config change, one restart`.
        {{ checksum_annotation('config', observability_loki_config | hash('sha1')) }}
      labels:
        app: loki
        netpol-baseline: enforced
    spec:
      # Tier 4; `DECIDED: observability tiers` in this role's CLAUDE.md names the tier-1
      # exceptions.
{{ pod_shell('homelab-best-effort', run_as_user=10001, run_as_group=10001, fs_group=10001) }}
      containers:
        - name: loki
          image: {{ observability_k8s_loki_image }}
          imagePullPolicy: IfNotPresent
          args: ["-config.file=/etc/loki/loki.yaml"]
{{ hardened_security_context(non_root=true) }}
          ports:
            - name: http
              containerPort: 3100
              hostPort: 3100
              hostIP: {{ observability_query_host_ip }}
          volumeMounts:
            - name: loki-config
              mountPath: /etc/loki
            - name: loki-data
              mountPath: /loki
          readinessProbe:
            httpGet:
              path: /ready
              port: 3100
            initialDelaySeconds: 20
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /ready
              port: 3100
            initialDelaySeconds: 30
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 6
{{ container_resources(cpu_limit='1', mem_limit='1Gi', cpu_request='50m', mem_request='128Mi') }}
      volumes:
        - name: loki-config
          configMap:
            name: loki-config
        - name: loki-data
          persistentVolumeClaim:
            claimName: loki-data
---
apiVersion: v1
kind: Service
metadata:
  name: loki
  namespace: {{ k8s_observability_namespace }}
spec:
  # Pinned: host-side query tools carry this address as a constant.
  clusterIP: {{ observability_loki_cluster_ip }}
  selector:
    app: loki
  ports:
    - name: http
      port: 3100
      targetPort: 3100
