---
# The scheduler's KubernetesExecutor creates, watches and deletes one pod per task, and adopts
# its own orphans after a restart by patching their labels.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: airflow-scheduler
  namespace: {{ k8s_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: airflow-scheduler
  namespace: {{ k8s_namespace }}
rules:
  - apiGroups: [""]
    resources: [pods]
    verbs: [create, get, list, watch, patch, delete]
  - apiGroups: [""]
    resources: [pods/log]
    verbs: [get]
  - apiGroups: [""]
    resources: [events]
    verbs: [list]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: airflow-scheduler
  namespace: {{ k8s_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: airflow-scheduler
subjects:
  - kind: ServiceAccount
    name: airflow-scheduler
    namespace: {{ k8s_namespace }}
---
# The api-server reads a running task's log from its pod, since the log file lives only there.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: airflow-api
  namespace: {{ k8s_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: airflow-api
  namespace: {{ k8s_namespace }}
rules:
  - apiGroups: [""]
    resources: [pods]
    verbs: [get, list]
  - apiGroups: [""]
    resources: [pods/log]
    verbs: [get]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: airflow-api
  namespace: {{ k8s_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: airflow-api
subjects:
  - kind: ServiceAccount
    name: airflow-api
    namespace: {{ k8s_namespace }}
---
# Task pods: no Kubernetes grant, and the pod template mounts no token.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: airflow-task
  namespace: {{ k8s_namespace }}
automountServiceAccountToken: false
---
# backup_spend_rollup's load task alone runs as this, through its executor_config, to read each
# Longhorn volume's backup target and claim. Read-only, and on volumes alone.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: airflow-longhorn-reader
  namespace: {{ k8s_namespace }}
automountServiceAccountToken: false
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: airflow-longhorn-reader
  namespace: longhorn-system
rules:
  - apiGroups: [longhorn.io]
    resources: [volumes]
    verbs: [list]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: airflow-longhorn-reader
  namespace: longhorn-system
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: airflow-longhorn-reader
subjects:
  - kind: ServiceAccount
    name: airflow-longhorn-reader
    namespace: {{ k8s_namespace }}
