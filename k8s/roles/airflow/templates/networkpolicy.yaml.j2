{% from 'networkpolicy.yml.j2' import networkpolicy with context %}
---
# The execution API task pods call; the baseline admits only traefik, prometheus and node bridges.
# `netpol_role_owned: true` keeps netpol-baseline from rendering a second copy.
{{ networkpolicy(container_item.name, container_item.port, container_item | netpol_callers) }}
---
{% set health = container_item.netpol_fences | selectattr('app', 'equalto', 'airflow-scheduler') | first %}
{{ networkpolicy(health.app, health.port, health['from']) }}
