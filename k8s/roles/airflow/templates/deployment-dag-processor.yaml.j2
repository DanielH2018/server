{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
{% from 'airflow-env.yaml.j2' import airflow_env, airflow_mounts, airflow_volumes, wait_for_migrations with context %}
---
# Parses the DAG files baked into the image and writes them to the metadata database.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: airflow-dag-processor
  namespace: {{ k8s_namespace }}
spec:
{{ spec_shell('RollingUpdate') }}
  replicas: 1
  selector:
    matchLabels:
      app: airflow-dag-processor
  template:
    metadata:
      labels:
        app: airflow-dag-processor
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-best-effort', run_as_user=airflow_k8s_uid, run_as_group=airflow_k8s_uid, fs_group=airflow_k8s_uid, non_root=true) }}
{{ node_affinity_preference(airflow_k8s_node) }}
      initContainers:
{{ wait_for_migrations() }}
      containers:
        - name: airflow-dag-processor
          image: {{ airflow_k8s_image }}
          imagePullPolicy: Always
          args: ["airflow", "dag-processor"]
{{ hardened_security_context(read_only=true, non_root=true) }}
          env:
{{ airflow_env(true) }}
          volumeMounts:
{{ airflow_mounts() }}
          livenessProbe:
            exec:
              command: ["airflow", "jobs", "check", "--job-type", "DagProcessorJob", "--local"]
            initialDelaySeconds: 120
            periodSeconds: 60
            timeoutSeconds: 30
            failureThreshold: 5
{{ container_resources(cpu_limit=airflow_k8s_dag_processor_cpu_limit, mem_limit=airflow_k8s_dag_processor_mem_limit, cpu_request=airflow_k8s_dag_processor_cpu_request, mem_request=airflow_k8s_dag_processor_mem_request) }}
      volumes:
{{ airflow_volumes() }}
