{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'airflow-env.yaml.j2' import airflow_env with context %}
---
# The pod the KubernetesExecutor starts for each task. The executor fills in the container's
# args and its own labels; the container must be named `base`.
apiVersion: v1
kind: ConfigMap
metadata:
  name: airflow-pod-template
  namespace: {{ k8s_namespace }}
data:
  pod-template.yaml: |
    apiVersion: v1
    kind: Pod
    metadata:
      labels:
        app: airflow-task
        netpol-baseline: enforced
    spec:
      restartPolicy: Never
      enableServiceLinks: false
      priorityClassName: homelab-best-effort
      serviceAccountName: airflow-task
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: {{ airflow_k8s_uid }}
        runAsGroup: {{ airflow_k8s_uid }}
        fsGroup: {{ airflow_k8s_uid }}
      affinity:
        nodeAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              preference:
                matchExpressions:
                  - key: kubernetes.io/hostname
                    operator: In
                    values: [{{ airflow_k8s_node }}]
      containers:
        - name: base
          image: {{ airflow_k8s_task_image }}
          imagePullPolicy: IfNotPresent
{{ hardened_security_context(read_only=true, non_root=true) }}
          env:
{{ airflow_env(false) }}
          volumeMounts:
            - name: airflow-home
              mountPath: /opt/airflow
            - name: airflow-tmp
              mountPath: /tmp
{{ container_resources(cpu_limit=airflow_k8s_task_cpu_limit, mem_limit=airflow_k8s_task_mem_limit, cpu_request=airflow_k8s_task_cpu_request, mem_request=airflow_k8s_task_mem_request) }}
      volumes:
        - name: airflow-home
          emptyDir: {}
        - name: airflow-tmp
          emptyDir: {}
