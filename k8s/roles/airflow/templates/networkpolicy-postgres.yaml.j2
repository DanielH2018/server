{# DECIDED: airflow-postgres-callers stays bespoke, because Grafana reads the warehouse from
   the observability namespace, and the callers macro (k8s/templates/networkpolicy.yml.j2)
   admits same-namespace `app:` peers only. #}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: airflow-postgres-callers
  namespace: {{ k8s_namespace }}
spec:
  podSelector:
    matchLabels:
      app: airflow-postgres
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector:
            matchExpressions:
              - key: app
                operator: In
                values: [airflow, airflow-scheduler, airflow-dag-processor, airflow-task]
{# One list item, so the two selectors AND: grafana, and only inside observability. #}
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ k8s_observability_namespace }}
          podSelector:
            matchLabels:
              app: grafana
      ports:
        - protocol: TCP
          port: 5432
