{#
The `prepare_tree` shell function that the committing host crons (docs-refresh, eval-run) run
in, so neither writes the primary checkout. Each cron keeps its own tree outside $REPO and
outside .claude/worktrees/, which the worktree pruner sweeps.

The caller sets REPO and TREE before calling the function. `job` names the cron in the
worktree's lock reason. Named `.j2`, not `.sh.j2`: it is not a script, and
validate/shell_templates.py lints every `*.sh.j2` as one.
#}
{% macro prepare_tree_function(job) -%}
# `clean -ffdx`: -x drops ignored files that keep a role directory alive; -ff drops nested repos.
# The worktree is locked against prune; `add -f -f` re-adds one whose directory went missing.
prepare_tree() {
  if ! git -C "$TREE" rev-parse --git-dir >/dev/null 2>&1; then
    rm -rf -- "$TREE"
    git -C "$REPO" worktree add -f -f --detach "$TREE" "$1" >/dev/null 2>&1 || return 1
    git -C "$REPO" worktree lock --reason "{{ job }}'s own tree" "$TREE" >/dev/null 2>&1
  fi
  git -C "$TREE" checkout --quiet --force --detach "$1" || return 1
  git -C "$TREE" clean -ffdxq -e /.venv
}
{%- endmacro %}
