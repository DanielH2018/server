{#
  One entry of a role's `render_secrets`, rendered as `secret-<name>.yaml` in the role's own
  manifest directory. `manifests_secret` is the entry: `{name, string_data}`, plus an optional
  `namespace` that defaults to the shared `k8s_namespace`. `string_data` maps each Secret field
  to the SOPS key whose value it carries; `cluster.py:secret_entries` checks the shape and that
  every value names a SOPS key before this renders.

  A key reaches the output only through `lookup('vars', ...) | to_json`, which rule 5 of
  `secret_checks.py` holds to its bare forms, so no edit here can transform a secret unseen.
#}
apiVersion: v1
kind: Secret
metadata:
  name: {{ manifests_secret.name }}
  namespace: {{ manifests_secret.namespace | default(k8s_namespace, true) }}
type: Opaque
stringData:
{% for field, key in manifests_secret.string_data | dictsort(true) %}
  {{ field }}: {{ lookup('vars', key) | to_json }}
{% endfor %}
