{#
  IngressRoute for a k8s-hosted service. It encodes the host rule, entrypoint, TLS resolver
  and SAN set, service port, rate-limit and optional Authelia, written once so each service
  is a one-line call rather than a hand-authored route that drifts from the others.

  Arguments:
    name               Service (and IngressRoute) name; matches the k8s Service
    hostname           Host label, WITHOUT the domain. ONE name per service, the
                       unsuffixed one.
    port               Service port to route to
    authelia           attach the forward-auth Middleware (services use_authelia)
    extra_middlewares  additional Middleware names, applied after the standard two

  The TLS block is explicit rather than relying on the TLSStore default. Omitting it makes
  Traefik request a certificate for the literal Host rule — a separate cert per hostname,
  a separate Let's Encrypt issuance, and the rate-limit exposure that comes with it.
#}
{# DECIDED: no retry middleware in the default chain; the macro has no per-route opt-out, and a
   retry replays a POST body a terminating backend already consumed. #}
{% macro ingressroute(name, hostname, port, authelia, extra_middlewares=[], namespace=none, public=true, bypass_prefixes=[]) -%}
{# One object per host: rate-limit keying and `spec.tls.options` differ, and each is per object.
   Public object only if k8s_public_route and not `public=false`: its absence is the guard, not DNS. #}
{% for host, rate_limit, suffix, tls_option in [(hostname ~ '.local.' ~ domain, 'rate-limit', '', 'modern')] + ([(hostname ~ '.' ~ domain, 'rate-limit-proxied', '-public', 'cloudflare-origin-pull')] if k8s_public_route and public else []) %}
{% if not loop.first %}
---
{% endif %}
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: {{ name }}{{ suffix }}
  namespace: {{ namespace | default(k8s_namespace, true) }}
spec:
  entryPoints:
    - https
  routes:
    - kind: Rule
      match: "Host(`{{ host }}`)"
      middlewares:
        - name: {{ rate_limit }}
{% if authelia %}
        - name: authelia
{% endif %}
{% for middleware in extra_middlewares %}
        - name: {{ middleware }}
{% endfor %}
      services:
        - name: {{ name }}
          port: {{ port }}
{# `tls:` is never conditional (else a non-TLS router); only certResolver and domains are. #}
  tls:
{% if k8s_tls_cert_resolver %}
    certResolver: {{ k8s_tls_cert_resolver }}
{% endif %}
    # Not `default`: Traefik reserves it, so naming it fails with `unknown TLS options`.
    options:
      name: {{ tls_option }}
{% if k8s_tls_cert_resolver %}
    domains:
      - main: "{{ domain }}"
        sans:
          - "*.{{ domain }}"
          - "*.local.{{ domain }}"
{% endif %}
{% endfor %}
{% if k8s_public_route and public %}
{% for prefix in bypass_prefixes %}
{% set slug = prefix | trim('/') | replace('/', '-') %}
---
# Unauthenticated public path: callers are session-less, so an Authelia gate silently breaks them.
# Its name must be in test_k8s_manifests.py's AUTHELIA_BYPASS_ROUTES with a written reason.
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: {{ name }}-public-{{ slug }}
  namespace: {{ namespace | default(k8s_namespace, true) }}
spec:
  entryPoints:
    - https
  routes:
    - kind: Rule
      match: "Host(`{{ hostname }}.{{ domain }}`) && PathPrefix(`{{ prefix }}`)"
      priority: 100
      middlewares:
        # The proxied keying: this Rule matches the public name only (see the loop above).
        - name: rate-limit-proxied
      services:
        - name: {{ name }}
          port: {{ port }}
  tls:
{% if k8s_tls_cert_resolver %}
    certResolver: {{ k8s_tls_cert_resolver }}
{% endif %}
    # Must match the main public object's: routers on one host naming different options fall back to
    # default, which requires no client certificate.
    options:
      name: cloudflare-origin-pull
{% if k8s_tls_cert_resolver %}
    domains:
      - main: "{{ domain }}"
        sans:
          - "*.{{ domain }}"
          - "*.local.{{ domain }}"
{% endif %}
{% endfor %}
{% endif %}
{%- endmacro %}

{% macro monitoring_route(name, hostname, port, path_prefix, namespace=none, extra_client_cidrs=[], service_name=none, include_bridge_ip=true) -%}
{#
  A query-only door for monitor-bridge to reach services that carry no unauthenticated route
  of their own. Modelled on prometheus-monitoring / n8n-monitoring.

  It shares the service's one plain `.local` hostname. What keeps it distinct from the app's own route
  is the ClientIP + PathPrefix pair below plus `priority: 100`, NOT a separate hostname —
  do not "fix" a widget by inventing a second name for it.

  THE `tls:` BLOCK AT THE BOTTOM IS LOAD-BEARING. An IngressRoute on the `https` entrypoint
  with no `spec.tls` becomes a NON-TLS router: this entrypoint sets no entrypoint-level TLS,
  so TLS is decided per router, and an HTTPS request is only ever matched against TLS routers.
  Without the block the route is not losing to the service's plain Host router — it is never a
  candidate at all, so every request falls through to that router and monitor-bridge gets
  Authelia's 401.

  That failure mode is invisible from the object: the route applies cleanly, `kubectl get`
  shows it, and Traefik logs nothing. It also makes the rule look irrelevant, so changing
  priority, the ClientIP matcher or reconciliation timing changes nothing. A field-by-field
  diff against n8n-monitoring, which works from the same caller and carries `tls:`, isolates it.

  Guard: tests/k8s/rendered_properties/test_k8s_manifests.py fails any rendered IngressRoute that serves the
  https entrypoint without a tls block, so this cannot regress silently.

  The guards it is MEANT to provide, kept in the rule so they are real once it routes:
    1. ClientIP — `k8s_bridge_client_ip` (daniel-server's LAN address) plus whatever
       `extra_client_cidrs` adds. `extra_client_cidrs` is a per-caller widening, such as a
       prober whose probes arrive from the pod CIDR.

       `include_bridge_ip=false` drops the prepend for a route whose callers are all in
       `extra_client_cidrs`. The prepend names daniel-server's own address, but a pod arrives
       with its own 10.42.x.y address, and a daniel-server HOST process arrives SNATed to a
       cluster-internal address rather than to 10.0.0.161 — measured, see the three *arr
       `-monitoring` templates, the only callers that pass false. Every other call site keeps the prepend, because none of
       them has had its callers censused.
    2. PathPrefix — only the endpoint the check reads. The *arr APIs are wide, and a bare Host
       rule would expose every write endpoint they have.
    3. LAN-only. Unlike ingressroute() above this does NOT honour k8s_public_route, so the
       public-route flag cannot drag it onto the public internet with the app routes.

  The app's own X-Api-Key remains the authentication behind all of that.
#}
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: {{ name }}-monitoring
  namespace: {{ namespace | default(k8s_namespace, true) }}
spec:
  entryPoints:
    - https
  routes:
    - kind: Rule
{# One ClientIP() per CIDR, OR'd: a two-argument call silently 404s every source. #}
{% set client_cidrs = ([k8s_bridge_client_ip ~ '/32'] if include_bridge_ip else []) + extra_client_cidrs %}
{# An empty set renders `&& ()`, which Traefik rejects; fail at render instead. #}
{% if not client_cidrs %}{{ monitoring_route_with_include_bridge_ip_false_needs_a_non_empty_extra_client_cidrs() }}{% endif %}
      match: "Host(`{{ hostname }}.local.{{ domain }}`) && PathPrefix(`{{ path_prefix }}`) && ({% for cidr in client_cidrs %}ClientIP(`{{ cidr }}`){% if not loop.last %} || {% endif %}{% endfor %})"
      # Explicit: must beat the service's plain Host router, which sends monitor-bridge to Authelia.
      priority: 100
      middlewares:
        - name: rate-limit
      services:
{# `service_name` lets one service carry a second monitoring route with its own path and ClientIP
   set. #}
        - name: {{ service_name | default(name, true) }}
          port: {{ port }}
  # Not optional: without a tls block the router is non-TLS and never matches HTTPS.
{# `tls:` stays unconditional; an empty resolver drops certResolver and domains, never the key. #}
  tls:
{% if k8s_tls_cert_resolver %}
    certResolver: {{ k8s_tls_cert_resolver }}
{% endif %}
    options:
      name: modern
{% if k8s_tls_cert_resolver %}
    domains:
      - main: "{{ domain }}"
        sans:
          - "*.{{ domain }}"
          - "*.local.{{ domain }}"
{#- Keep the dash: without it each route gains a blank line, and a changed manifest rolls the pod. -#}
{%- endif %}
{%- endmacro %}
