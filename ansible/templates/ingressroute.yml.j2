{#
  IngressRoute for a k8s-hosted service — the replacement for traefik.yml.j2's labels()
  macro, which cannot survive the migration: there are no Docker labels in k8s and the
  docker provider is gone. Everything labels() encoded (host rule, entrypoint, TLS resolver
  and SAN set, service port, rate-limit, optional Authelia) is encoded here instead.

  Written once so slice 2's ~33 remaining services are a one-line call each, not 33
  hand-authored routes that drift from one another.

  Arguments mirror labels() where they can:
    name               Service (and IngressRoute) name; matches the k8s Service
    hostname           Host label, WITHOUT the domain. Callers pass the -k8s-suffixed name
                       while the Docker twin still serves the unsuffixed one.
    port               Service port to route to
    authelia           attach the forward-auth Middleware (containers_list use_authelia)
    extra_middlewares  additional Middleware names, applied after the standard two

  The TLS block is explicit rather than relying on the TLSStore default. Omitting it makes
  Traefik request a certificate for the literal Host rule — a separate cert per hostname,
  a separate Let's Encrypt issuance, and rate-limit arithmetic that no longer matches the
  Docker instance's. The Docker side repeats the same block on each hand-rolled file-provider
  router for the same reason.
#}
{% macro ingressroute(name, hostname, port, authelia, extra_middlewares=[], namespace=none, unsuffixed_hostname=none, bridge_rate_limit='rate-limit-bridge', public=true, public_native=true, bypass_prefixes=[]) -%}
{#
  namespace defaults to k8s_namespace — every slice-2 service wants that. It is overridable
  because the telemetry stack runs in its own namespace, and an IngressRoute must live
  alongside the Service it targets: Traefik will not route across namespaces with
  allowCrossNamespace off, which it deliberately is. The referenced middlewares must
  therefore also exist in that namespace.
#}
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: {{ name }}
  namespace: {{ namespace | default(k8s_namespace, true) }}
spec:
  entryPoints:
    - https
  routes:
    - kind: Rule
      # The public Host rule exists only once k8s_public_route flipped (slice-6 B4, with the
      # CrowdSec bouncer on this edge) AND the caller didn't opt out. The absent rule is the
      # guard — not the absent DNS record: the Cloudflare wildcard resolves ANY name.
      # `public=false` is for infrastructure APIs that must never face the internet whatever
      # the flag says — the CrowdSec LAPI is the standing example.
      match: "{% if k8s_public_route and public %}Host(`{{ hostname }}.{{ domain }}`) || {% endif %}Host(`{{ hostname }}.local.{{ domain }}`)"
      middlewares:
        - name: rate-limit
{% if authelia %}
        - name: authelia
{% endif %}
{% for middleware in extra_middlewares %}
        - name: {{ middleware }}
{% endfor %}
      services:
        - name: {{ name }}
          port: {{ port }}
{% if unsuffixed_hostname and public_native %}
    # The service's PRE-MIGRATION names, served natively (bridge-teardown BT1/BT2 — the
    # forward bridge and its ClientIP-gated route are gone; slice-7-bridge-teardown.md).
    # The `.local` leg exists for the LAN wildcard's arrival at this edge (BT3); the public
    # leg for direct internet arrivals since the 80/443 flip. Authelia is applied here (the
    # k8s portal owns the public cookie domain) — one portal, no double login.
    #
    # public_native=false opts a service out — livesync's names stay on the REVERSE bridge
    # (through the Docker edge) because its X-Sync-Token gate lives in that edge's file
    # provider, where the readonly kubeconfig cannot read it; an IngressRoute rule carrying
    # the token would hand it to anything holding that kubeconfig.
    - kind: Rule
      match: "Host(`{{ unsuffixed_hostname }}.local.{{ domain }}`){% if k8s_public_route and public %} || Host(`{{ unsuffixed_hostname }}.{{ domain }}`){% endif %}"
      middlewares:
        - name: rate-limit
{% if authelia %}
        - name: authelia
{% endif %}
{% for middleware in extra_middlewares %}
        - name: {{ middleware }}
{% endfor %}
      services:
        - name: {{ name }}
          port: {{ port }}
{% elif unsuffixed_hostname %}
    # public_native=false: the unsuffixed names TERMINATE at the Docker edge (livesync's
    # token gate lives in its file provider) and its hand-written routers forward here — so
    # this is the return leg of the reverse bridge, not a public route. ClientIP is the
    # whole guard: without it any LAN host could curl the VIP with this Host and skip the
    # edge's token/Authelia gates (`--resolve` is all it takes); the matcher reads the TCP
    # peer, not X-Forwarded-For, and externalTrafficPolicy: Local preserves it. Deleting
    # this leg at the teardown looped cluster ⇄ Docker edge into a 429 (found live,
    # 2026-08-10) — the edge forwards here expecting a terminus.
    - kind: Rule
      match: "(Host(`{{ unsuffixed_hostname }}.{{ domain }}`) || Host(`{{ unsuffixed_hostname }}.local.{{ domain }}`)) && ClientIP(`{{ k8s_bridge_client_ip }}/32`)"
      middlewares:
        # Single-peer route (daniel-server) — the per-IP default limiter would meter every
        # user as one. The edge already metered per real client upstream. Overridable
        # because this hop meters AGAIN after the edge and the tighter of the two wins —
        # livesync's replication needs its high-ceiling exemption here too or a phone
        # 429s mid-sync (measured when the bridges were built).
        - name: {{ bridge_rate_limit }}
{% for middleware in extra_middlewares %}
        - name: {{ middleware }}
{% endfor %}
      services:
        - name: {{ name }}
          port: {{ port }}
{% endif %}
  tls:
    certResolver: cloudflare
    # Explicit, and deliberately not named `default` — Traefik reserves that name for the
    # global default options and never registers it under a namespaced key, so referencing
    # `default` here fails with "unknown TLS options". See the traefik role's dynamic.yaml.j2.
    options:
      name: modern
    domains:
      - main: "{{ domain }}"
        sans:
          - "*.{{ domain }}"
          - "*.local.{{ domain }}"
{% if k8s_public_route and public and public_native and unsuffixed_hostname %}
{% for prefix in bypass_prefixes %}
{% set slug = prefix | trim('/') | replace('/', '-') %}
---
# An unauthenticated public path the service had at the Docker edge (bridge_bypass_prefixes),
# reproduced natively on the UNSUFFIXED name for B5: the callers are automated and
# session-less, so an Authelia gate does not fail loudly — it silently breaks every caller
# while they keep reporting success. Same trailing-slash load-bearing rule as the Docker twin.
# A separate document on purpose: its metadata.name must appear in test_k8s_manifests.py's
# AUTHELIA_BYPASS_ROUTES allow-list with a written reason, so a new public no-auth path is a
# conscious edit there, never a quiet template change.
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: {{ name }}-public-{{ slug }}
  namespace: {{ namespace | default(k8s_namespace, true) }}
spec:
  entryPoints:
    - https
  routes:
    - kind: Rule
      match: "Host(`{{ unsuffixed_hostname }}.{{ domain }}`) && PathPrefix(`{{ prefix }}`)"
      priority: 100
      middlewares:
        - name: rate-limit
      services:
        - name: {{ name }}
          port: {{ port }}
  tls:
    certResolver: cloudflare
    options:
      name: modern
    domains:
      - main: "{{ domain }}"
        sans:
          - "*.{{ domain }}"
          - "*.local.{{ domain }}"
{% endfor %}
{% endif %}
{%- endmacro %}

{% macro monitoring_route(name, hostname, port, path_prefix, namespace=none, extra_client_cidrs=[]) -%}
{#
  A query-only door for monitor-bridge, which runs in Docker on daniel-server and lost its
  route to these services when they left that host (slice 4, B4c). Modelled on
  prometheus-monitoring / n8n-monitoring, which exist for exactly this problem.

  IT MUST BE THE `-k8s` HOSTNAME, not a bridged `*.local` name. The bridged names resolve to
  daniel-server, and a container ON that host cannot reach a port its neighbour publishes on
  the same Docker bridge (same-bridge hairpin NAT — it broke homepage's widgets and check_n8n).
  The suffixed name resolves to the cluster VIP, which is a different machine entirely.

  THE `tls:` BLOCK AT THE BOTTOM IS LOAD-BEARING, and its absence is what broke this macro for
  most of 2026-08-07. An IngressRoute on the `https` entrypoint with no `spec.tls` becomes a
  NON-TLS router: this entrypoint sets no entrypoint-level TLS, so TLS is decided per router,
  and an HTTPS request is only ever matched against TLS routers. The route was therefore not
  losing to the service's plain Host router — it was never a candidate at all, so every request
  fell through to that router and monitor-bridge got Authelia's 401.

  That failure mode is invisible from the object: the route applies cleanly, `kubectl get`
  shows it, and Traefik logs nothing. It also makes the rule look irrelevant, which sent the
  first investigation down three dead ends — priority (raised to 1000), the ClientIP matcher
  (removed entirely, then widened to the whole LAN), and reconciliation lag. None of them could
  have changed anything. What finally isolated it was a field-by-field diff against
  n8n-monitoring, which works from the same caller and carries `tls:`.

  Guard: ansible/tests/test_k8s_manifests.py fails any rendered IngressRoute that serves the
  https entrypoint without a tls block, so this cannot regress silently again.

  The guards it is MEANT to provide, kept in the rule so they are real once it routes:
    1. ClientIP — daniel-server alone, the only intended caller. `extra_client_cidrs` is a
       per-caller widening: added for the Kuma prober's move into the cluster (Phase D),
       whose probes arrive from the pod CIDR.
    2. PathPrefix — only the endpoint the check reads. The *arr APIs are wide, and a bare Host
       rule would expose every write endpoint they have.
    3. LAN-only. Unlike ingressroute() above this does NOT honour k8s_public_route, so slice 6
       cannot drag it onto the public internet with the app routes.

  The app's own X-Api-Key remains the authentication behind all of that.
#}
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: {{ name }}-monitoring
  namespace: {{ namespace | default(k8s_namespace, true) }}
spec:
  entryPoints:
    - https
  routes:
    - kind: Rule
{# One ClientIP() per CIDR, OR'd: Traefik v3's ClientIP takes a single argument, and a
    two-argument call silently kills the whole router — every source 404s, measured
    2026-08-10 when the first extra_client_cidrs caller landed. #}
      match: "Host(`{{ hostname }}.local.{{ domain }}`) && PathPrefix(`{{ path_prefix }}`) && ({% for cidr in [k8s_bridge_client_ip ~ '/32'] + extra_client_cidrs %}ClientIP(`{{ cidr }}`){% if not loop.last %} || {% endif %}{% endfor %})"
      # EXPLICIT, as n8n-monitoring sets it: this must beat the service's plain Host router,
      # which otherwise sends monitor-bridge to Authelia.
      priority: 100
      middlewares:
        - name: rate-limit
      services:
        - name: {{ name }}
          port: {{ port }}
  # Not optional, and not boilerplate — see the header. Without this the router is non-TLS and
  # never matches an HTTPS request. Identical to ingressroute()'s block above.
  tls:
    certResolver: cloudflare
    options:
      name: modern
    domains:
      - main: "{{ domain }}"
        sans:
          - "*.{{ domain }}"
          - "*.local.{{ domain }}"
{%- endmacro %}
