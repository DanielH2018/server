{#
  Service for a k8s-hosted service — the single-port ClusterIP Service every plain web-app role
  ships. 19 roles' service.yaml.j2 were byte-identical but for the name; this macro is that body.

  Arguments mirror ingressroute()'s style:
    name       Service (and selector `app` label) name; matches the Deployment's own label and
               the IngressRoute this Service backs.
    port       Service and target port — this fleet has no services publishing on a different
               container port than their Service port, so there is only the one number.
    port_name  Set when a caller's Service needs a NAMED port (home-assistant, homelab-mcp,
               zigbee2mqtt) rather than the bare port list every other role uses. Omit to get
               the plain form.
    extra_ports  Additional ports as [{name, port}] — a sidecar's, typically. Kubernetes REJECTS
               a Service that mixes named and unnamed ports, and it rejects it at apply time,
               after every repo-side check has read green. So passing extra_ports forces the
               primary port to be named too (`http` unless port_name says otherwise) rather than
               leaving that as something each caller has to remember.
#}
{% macro service(name, port, port_name=none, extra_ports=[]) -%}
apiVersion: v1
kind: Service
metadata:
  name: {{ name }}
  namespace: {{ k8s_namespace }}
spec:
  selector:
    app: {{ name }}
  ports:
{% if port_name or extra_ports %}
    - name: {{ port_name | default('http', true) }}
      port: {{ port }}
      targetPort: {{ port }}
{% else %}
    - port: {{ port }}
      targetPort: {{ port }}
{% endif %}
{% for extra in extra_ports %}
    - name: {{ extra.name }}
      port: {{ extra.port }}
      targetPort: {{ extra.port }}
{% endfor %}
{%- endmacro %}
