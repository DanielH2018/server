{#
  checksum/<name> pod-template annotation: rolls one workload when the input its caller hashes
  changes. observability hashes each workload's own ConfigMap body into it, so a config edit
  rolls that pod alone. `value` is the caller's hash, and an undefined one renders `unstaged`,
  which never rolls the pod. Content a pod mounts through a ConfigMap or Secret needs no
  annotation: `scripts/renderer/renderer_lib/restart.py` stamps the restart for it.

  Invoke at the annotations block's indent:
      annotations:
        {{ checksum_annotation('config', observability_grafana_config | hash('sha1')) }}
#}
{% macro checksum_annotation(name, value) -%}
checksum/{{ name }}: "{{ value | default('unstaged') }}"
{%- endmacro %}
