{#
  checksum/<name> pod-template annotation: restarts a workload when content it reads changes
  but no manifest the renderer emits embeds that content. `value` is the caller's own hash,
  e.g. observability's hash of a ConfigMap body. It renders `unstaged` when undefined, so a
  render with no value never rolls the pod. Content embedded in an emitted manifest needs no
  annotation: `scripts/renderer/renderer_lib/restart.py` stamps the restart for it.

  Invoke at the annotations block's indent:
      annotations:
        {{ checksum_annotation('config', observability_grafana_config | hash('sha1')) }}
#}
{% macro checksum_annotation(name, value) -%}
checksum/{{ name }}: "{{ value | default('unstaged') }}"
{%- endmacro %}
