{#
  The Job shell of a role's NetworkPolicy probe — headlamp, n8n, prowlarr (flaresolverr) and
  registry share it. Each probe is a one-shot pod that must FAIL to reach the fenced port, so
  the Job SUCCEEDS when the connection is refused, after a control step proves the pod has a
  working network at all. The role's `tasks/main.yml` deletes the Job, applies it and waits on
  `job/<name>` by its literal name, which is why `name` is passed as a literal here: the
  auto-deploy batch guard reads that wait from the tasks and the Job name from the render.

  What stays at the call site is the SCRIPT, as the `{% call %}` body, because the control and
  the targets differ role to role: traefik:80 for headlamp and n8n, a DNS lookup for registry
  (its only port is the one under test), and a retrying reach of prowlarr itself for
  flaresolverr. Write the body at the block-scalar indent (14 spaces); it is emitted verbatim.

  netpol-baseline's five probes are NOT on this macro. Each asserts several targets with a
  per-slice label set, and the DECIDED at `netpol-baseline/tasks/main.yml` keeps them apart.

  Arguments:
    name                     the Job's name, and its pod's `app` label.
    image                    the probe image; a role's own `*_k8s_*probe_image`-style default.
    active_deadline_seconds  120 unless the role's script needs longer — registry's cold pull
                             and prowlarr's control retry budget both do, and say why there.
#}
{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% macro netpol_probe_job(name, image, active_deadline_seconds=120) -%}
apiVersion: batch/v1
kind: Job
metadata:
  name: {{ name }}
  namespace: {{ k8s_namespace }}
spec:
  activeDeadlineSeconds: {{ active_deadline_seconds }}
  backoffLimit: 0
  # Backstop cleanup: the deploy task always deletes this Job before re-applying it, but a day's
  # TTL means a completed Job doesn't sit around indefinitely if that step is ever skipped.
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app: {{ name }}
    spec:
      restartPolicy: Never
      enableServiceLinks: false
      automountServiceAccountToken: false
      containers:
        - name: probe
          image: {{ image }}
          command:
            - sh
            - -c
            - |
{{ caller() -}}
{{ hardened_security_context() }}
{{ container_resources(cpu_limit='200m', mem_limit='64Mi', cpu_request='10m', mem_request='16Mi') }}
{% endmacro %}
