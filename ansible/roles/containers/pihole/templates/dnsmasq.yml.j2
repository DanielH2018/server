address=/local.{{ domain }}/{{ server_ip }}
address=/local.{{ domain }}/::

# k3s-hosted services answer with the cluster's MetalLB ingress VIP instead of the wildcard
# above. dnsmasq resolves the most specific `address=` match, so these override
# local.<domain> for exactly these names and nothing else.
#
# Derived from daniel-box's inventory rather than hand-listed: slice 2 moves ~33 more
# services, and a hand-maintained list here is a second source of truth that silently rots
# the first time someone forgets it. Entries without a `hostname` (traefik itself) have no
# route of their own and are skipped.
#
# `extra_hostnames` covers an entry that fronts MORE THAN ONE routed workload — claude-otel
# runs Grafana, Prometheus, Loki and Tempo under a single containers_list entry, so its
# `hostname` can only name one of them. Without this, a second workload's IngressRoute exists
# in the cluster but its name falls through to the local.<domain> wildcard above, resolves to
# daniel-server, and the Docker Traefik answers its own 404 — which reads like a broken route
# rather than a missing DNS record.
{% for svc in hostvars['daniel-box'].containers_list | default([]) | filter_by_platform('k8s') %}
{% if svc.hostname is defined %}
address=/{{ svc.hostname }}.local.{{ domain }}/{{ k3s_metallb_ingress_vip }}
{% endif %}
{% for extra in svc.extra_hostnames | default([]) %}
address=/{{ extra }}.local.{{ domain }}/{{ k3s_metallb_ingress_vip }}
{% endfor %}
{% endfor %}

# daniel-pi is LAN-only. Use a private `.lan` TLD (resolves only here, via Pi-hole) instead
# of a <domain> subdomain: Traefik sets HSTS with stsIncludeSubdomains on the real domain,
# which force-upgrades any *.<domain> name to HTTPS and breaks the Pi's plain-HTTP services
# (SSL_ERROR_RX_RECORD_TOO_LONG). `.lan` sidesteps HSTS entirely. Reach the Pi's LAN-bound
# services at daniel-pi.lan:<port>. IP via hostvars since the Pi isn't the host running Pi-hole.
host-record=daniel-pi.lan,{{ hostvars['daniel-pi'].server_ip }}
