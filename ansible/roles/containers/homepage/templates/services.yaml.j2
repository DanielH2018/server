

- Top Row:
    - Services:
        - Portainer:
            icon: portainer.png
            href: https://portainer.{{ domain }}
            description: Container management
            server: my-docker
            container: portainer
            widget:
                type: portainer
                url: http://portainer:9000
                env: 1
                key: {{ portainer_api_key }}
        - Uptime-Kuma:
            icon: uptime-kuma.png
            href: https://uptime-kuma.{{ domain }}/
            description: Container Monitoring
            server: my-docker
            container: uptime-kuma
            widget:
                type: uptimekuma
                url: http://uptime-kuma:3001
                slug: containers
        - Pihole:
            icon: pi-hole.png
            href: https://pihole.{{ domain }}/admin
            description: DNS Ad Blocker
            server: my-docker
            container: pihole
            widget:
                type: pihole
                url: http://pihole:80
                version: 6
                key: {{ pihole_api_key }}
        - Speedtest:
            icon: speedtest-tracker.png
            href: https://speedtest.{{ domain }}/
            description: Internet tracking
            # No server/container: speedtest runs in k3s now, so there is no Docker container
            # for the status dot. The widget does NOT go through the Docker bridge — compose
            # maps this .local name straight to the cluster ingress VIP via extra_hosts,
            # because the Docker edge is unreachable from this container (same-bridge hairpin
            # NAT; the reasoning is in docker-compose.yml.j2).
            widget:
                type: speedtest
                url: https://speedtest.local.{{ domain }}
        - FreshRSS:
            icon: freshrss.png
            href: https://freshrss.{{ domain }}/
            description: RSS Link Aggregator
            # No server/container: freshrss runs in k3s now. Same as speedtest above — the
            # widget resolves this .local name straight to the cluster VIP.
            widget:
                type: freshrss
                url: https://freshrss.local.{{ domain }}
                username: {{ freshrss_username }}
                password: {{ freshrss_password }}
        - Karakeep:
            icon: karakeep.png
            href: https://karakeep.{{ domain }}/
            description: Karakeep
            # No server/container: karakeep runs in k3s now. Same as speedtest and freshrss
            # above — the widget resolves this .local name straight to the cluster VIP, where
            # the bridge IngressRoute serves it without Authelia; no extra route was needed.
            widget:
                type: karakeep
                url: https://karakeep.local.{{ domain }}
                key: {{ karakeep_homepage_api_key }}
        - UPS:
            icon: apc.png
            href: https://peanut.{{ domain }}/
            description: APC BR1500MS2
            server: my-docker
            container: peanut
            widget:
                type: peanut
                url: http://peanut:8080
                key: {{ nut_ups_name | default('apc-ups') }}
                username: {{ peanut_username }}
                password: {{ peanut_password }}
        - Home Assistant:
            icon: home-assistant.png
            href: https://home-assistant.{{ domain }}/
            description: Bedroom air quality
            server: my-docker
            container: home-assistant
            widget:
                type: homeassistant
                url: http://home-assistant:8123
                key: {{ homepage_ha_token }}
                custom:
                    - state: sensor.bedroom_airgradient_one_carbon_dioxide
                      label: CO₂
                    - template: "{% raw %}{{ states('sensor.bedroom_airgradient_one_temperature') | float | round(1) }}{% endraw %} °F"
                      label: Temp
                    - state: sensor.bedroom_airgradient_one_humidity
                      label: Humidity
                    - state: sensor.bedroom_airgradient_one_voc_index
                      label: VOC
    - Calendar:
        - Calendar:
            id: my-calendar
            href: https://calendar.google.com/calendar/u/0/r
            widget:
              type: calendar
              firstDayInWeek: sunday
              view: monthly
              maxEvents: 8
              showTime: true
              timezone: {{ tz }}
              integrations:
                - type: ical
                  url: http://ical-proxy:5000/calendar1.ics
                  name: Daniel
                  color: indigo
                  params:
                      showName: true
                - type: ical
                  url: http://ical-proxy:5000/calendar2.ics
                  name: Work
                  color: slate
                  params:
                      showName: true
                - type: ical
                  url: {{ calendar_3 }}
                  name: Holidays
                  color: purple
                  params:
                      showName: true
                - type: ical
                  url: http://ical-proxy:5000/calendar4.ics
                  name: Tasks
                  color: emerald
                  params:
                      showName: true

- Media:
    # The four media services moved to the k8s cluster (slice 4), so the Docker-DNS widget URLs
    # (http://jellyfin:8096, …) stopped resolving — each dashboard load burned ~15 widget-proxy
    # 500s (the Traefik `homepage@docker` 5xx signal, 2026-08-08). Jellyfin's -k8s route carries
    # no Authelia, so its widget follows the service. The sonarr/radarr/qbittorrent -k8s routes
    # are Authelia-gated and their monitoring IngressRoutes deliberately expose only
    # /api/v3/queue — restoring those widgets means consciously widening the route path list
    # (see ansible/templates/ingressroute.yml.j2 monitoring_route), so they are dropped, not
    # repointed. The `server:`/`container:` docker-status pairs referenced containers that no
    # longer exist on this host.
    - Jellyfin:
        href: https://jellyfin.{{ domain }}
        icon: jellyfin.png
        description: Mediaserver
        widget:
            type: jellyfin
            url: https://jellyfin{{ k8s_hostname_suffix }}.local.{{ domain }}
            key: {{ jellyfin_api_key }}
    - Sonarr:
        icon: sonarr.png
        href: https://sonarr.{{ domain }}/
        description: Series management
    - Radarr:
        icon: radarr.png
        href: https://radarr.{{ domain }}/
        description: Movie management
    - qBittorrent:
        icon: qbittorrent.png
        href: https://qBittorrent.{{ domain }}
        description: Download management

- Monitoring:
    - CPU Usage:
        href: http://glances.{{ domain }}/
        description: CPU Monitoring
        server: my-docker
        container: glances
        widget:
            type: glances
            url: http://glances:61208
            version: 4
            metric: cpu
    - Memory Usage:
        href: http://glances.{{ domain }}/
        description: Memory Monitoring
        server: my-docker
        container: glances
        widget:
            type: glances
            url: http://glances:61208
            version: 4
            metric: memory
            diskUnits: bytes
    - Network Usage:
        href: http://glances.{{ domain }}/
        description: Network Monitoring
        server: my-docker
        container: glances
        widget:
            type: glances
            url: http://glances:61208
            version: 4
            metric: network:eth0
    - Top Processes:
        href: http://glances.{{ domain }}/
        description: Process Monitoring
        server: my-docker
        container: glances
        widget:
            type: glances
            url: http://glances:61208
            version: 4
            metric: process
    - CPU Temp:
        href: http://glances.{{ domain }}/
        description: CPU Temperature Monitoring
        server: my-docker
        container: glances
        widget:
            type: glances
            url: http://glances:61208
            version: 4
            metric: sensor:Package id 0
    - Disk I/O:
        href: http://glances.{{ domain }}/
        description: Disk I/O Monitoring
        server: my-docker
        container: glances
        widget:
            type: glances
            url: http://glances:61208
            version: 4
            metric: disk:nvme0n1

- Tracking:
    - Crypto:
        widget:
            type: coinmarketcap
            currency: USD # Optional
            symbols: [BTC, ETH, DOGE]
            key: {{ coinmarket_api_key }}
            defaultinterval: 24h # Optional
