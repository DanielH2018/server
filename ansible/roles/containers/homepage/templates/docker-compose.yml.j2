{% from 'traefik.yml.j2' import labels with context %}
{% from 'autokuma.yml.j2' import labels as kuma with context %}
{% from 'networks.yml.j2' import service_networks, external_networks with context %}
{% from 'resources.yml.j2' import resources %}
---

services:
  homepage:
    image: ghcr.io/gethomepage/homepage:latest
    container_name: homepage
    environment:
      - PUID={{ puid }}
      - PGID={{ pgid }}
      - TZ={{ tz }}
      # Both the public (Cloudflare) host and the .local host used over the WireGuard
      # private path — Homepage rejects any Host header not listed here.
      - HOMEPAGE_ALLOWED_HOSTS=homepage.{{ domain }},homepage.local.{{ domain }}
    restart: unless-stopped
    # Widget calls to a MIGRATED service must go straight to the cluster, because the obvious
    # path does not work: `<svc>.local.<domain>` resolves to daniel-server, and a container on
    # daniel-server cannot reach daniel-server's own LAN address (measured 2026-08-06 —
    # 10.0.0.161:443 times out from a container while 10.0.0.240:443 connects). Every widget for
    # a cut-over service was failing with ETIMEDOUT; homepage's own log named freshrss outright.
    #
    # This grants NO new access. Any container here can already dial the VIP with any Host header
    # it likes, so the cluster's bridge route was always reachable from daniel-server — that route
    # carries no Authelia BY DESIGN and is guarded by ClientIP(10.0.0.161/32), which this traffic
    # satisfies because Docker SNATs it to the host's LAN address on the way out. All this does is
    # fix the name resolution; the trust boundary is unchanged, and it is the boundary the bridge
    # was built with.
    #
    # Generated from the same inventory the bridge routers are generated from, so a service
    # migrating in slice 3+ needs no edit here — the alternative was three hand-maintained lines
    # that silently go stale, which is how these widgets broke in the first place.
    extra_hosts:
{% for svc in hostvars['daniel-box'].containers_list | default([]) | selectattr('bridge_hostname', 'defined') | list %}
      - "{{ svc.bridge_hostname }}.local.{{ domain }}:{{ k3s_metallb_ingress_vip }}"
{% endfor %}
    cap_drop:
      - ALL
    cap_add:
      - SETGID
      - SETUID
      - CHOWN
    security_opt:
      - no-new-privileges:true
    {{ service_networks() }}
    volumes:
      - ./config:/app/config
      - ./icons:/app/public/icons
    labels:
      {# Generate labels(container, port, docker_network, use_authelia) -#}
      {{ labels(
          container_item.hostname | default(container_item.name),
          container_item.port | string,
          (container_item.networks | default([docker_network]))[0],
          container_item.use_authelia
        )
      }}
      {{ kuma(container_item.name) }}
    # Resource caps for blast-radius containment (M1); tune from cAdvisor/Grafana.
    {{ resources('0.50', '256M', '0.05', '32M') }}

{{ external_networks() }}
