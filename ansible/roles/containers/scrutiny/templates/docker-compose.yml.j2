{% from 'autokuma.yml.j2' import labels as kuma with context %}
{% from 'networks.yml.j2' import service_networks, external_networks with context %}
{% from 'resources.yml.j2' import resources %}
---
# Slice-7 Phase D SC6 (2026-08-10): the web UI + influxdb moved to the cluster
# (roles/k8s/scrutiny); this compose is now only the COLLECTOR SPOKE — daniel-server is
# not a cluster node yet, so its NVMe reports by pushing to the cluster web API over the
# Authelia /api bypass. The Phase F join replaces this with the collector DaemonSet and
# the whole role retires. The scrutiny_internal net and the Traefik route went with the
# web; the entry's `monitoring` net is only for egress parity with the fleet.
services:
  # Spoke collector: reads SMART data (needs the raw-I/O caps + the NVMe device) and
  # pushes results to the CLUSTER web API. No inbound network surface.
  scrutiny-collector:
    image: ghcr.io/analogj/scrutiny:master-collector
    container_name: scrutiny-collector
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    # Same proven set as before the move: SETUID/SETGID for the entrypoint's `su`
    # privilege-drop, SYS_RAWIO for SMART, SYS_ADMIN because the NVMe health log page
    # goes through NVME_IOCTL_ADMIN_CMD (without it the read silently loses all health
    # metrics).
    cap_drop:
      - ALL
    cap_add:
      - SETUID
      - SETGID
      - SYS_RAWIO
      - SYS_ADMIN
    environment:
      # The cluster web API through its ClientIP-agnostic LAN bypass (^/api/.*). The
      # container resolves the -k8s name to the cluster VIP via Pi-hole; the Go client
      # tolerates the wildcard AAAA `::` answer (unlike grpc-go — see the otel-collector
      # forwarder's VIP pin).
      - COLLECTOR_API_ENDPOINT=https://scrutiny{{ k8s_hostname_suffix }}.local.{{ domain }}
      - TZ={{ tz }}
      # Pin the collector cadence (image default is daily 00:00) so the monitor-bridge
      # "SMART Data Freshness" window (26 h) is decoupled from the upstream default.
      - COLLECTOR_CRON_SCHEDULE=0 0 * * *
    volumes:
      - /run/udev:/run/udev:ro
    devices:
      - "{{ scrutiny_nvme_device }}:{{ scrutiny_nvme_device }}"
    {{ service_networks() }}
    labels:
      # Pinned/manual-update tier: rolling `master-collector` branch tag must NOT ride
      # watchtower's auto-update pool. Update deliberately via
      # `deploy -t scrutiny -e common_pull=always`.
      - "com.centurylinklabs.watchtower.enable=false"
      {{ kuma('scrutiny-collector') }}
    # Resource caps for blast-radius containment (M1); tune from cAdvisor/Grafana.
    {{ resources('0.50', '256M', '0.05', '32M') }}

{{ external_networks() }}
