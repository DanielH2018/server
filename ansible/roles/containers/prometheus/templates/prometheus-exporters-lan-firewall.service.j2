[Unit]
Description=Lock the LAN-published Prometheus-exporter ports to daniel-box in the DOCKER-USER chain
After=docker.service
Requires=docker.service
# PartOf: re-run this oneshot when docker.service restarts — Docker rebuilds DOCKER-USER on
# restart, so the lock must be re-asserted afterward. Same mechanism as peanut's.
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /etc/prometheus-exporters-lan-firewall.sh

[Install]
WantedBy=multi-user.target
