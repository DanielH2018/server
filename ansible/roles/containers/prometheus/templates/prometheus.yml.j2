# my global config
global:
  scrape_interval:     1m
  evaluation_interval: 1m
  # Stamped onto every series leaving this instance via remote_write below, and onto nothing
  # else — external_labels do not touch local storage or local queries, so the Docker Grafana
  # keeps seeing exactly the label sets it saw before. That is what makes the k3s northbound
  # reversible rather than a cutover.
  #
  # Mandatory, not decorative. The cluster Prometheus independently scrapes a job named
  # `otel-collector` at `otel-collector:8889` and (since slice 3 B3) itself as `prometheus` at
  # `localhost:9090` — both live, both verified 2026-08-07. This instance produces those exact
  # two (job, instance) pairs for entirely different processes. Written across unlabelled, the
  # two sources collide into one series and the receiver rejects half the samples as
  # out-of-order, corrupting both sides rather than either.
  external_labels:
    origin: "{{ inventory_hostname }}"

# Northbound to the k3s cluster Prometheus (slice 3, B3). Both stacks hold the same data, which
# is the property that makes the rest of slice 3 reversible: B5 repoints monitor-bridge at the
# cluster and B6 retires this instance, and until B6 either one can serve.
#
# Phase E2 (2026-08-12): the traefik/node/cadvisor/promtail/crowdsec jobs this comment used to
# justify keeping inbound-only moved to native cluster scrape jobs (claude-otel's
# prometheus.yaml.j2) — their exporter ports are now LAN-published, locked to daniel-box only by
# prometheus-exporters-lan-firewall.sh. What remains below (this self-scrape + `loki`) still isn't
# published, so remote_write stays the path for those two until the rest of this instance retires.
#
# The receiving route admits this host only (ClientIP), so the URL is not a shared secret and
# there is no credential here to leak.
remote_write:
  - url: "https://prometheus{{ k8s_hostname_suffix }}.local.{{ domain }}/api/v1/write"

# No Alertmanager: alerting is handled out-of-band by the monitor-bridge sidecar
# (Prometheus metrics -> Uptime Kuma push monitors -> Discord), not by Prometheus
# rules + Alertmanager. See ansible/roles/containers/monitor-bridge/.

scrape_configs:
  - job_name: 'prometheus'
    scrape_interval: 1m
    static_configs:
    - targets: ['localhost:9090']

#################################################################################################

  # traefik/node/cadvisor jobs PORTED to the cluster prometheus at Phase E2 (2026-08-12,
  # Prometheus consolidation) — their exporter ports are now LAN-published on this host and
  # scraped directly by the cluster instead of arriving here first. Same job names + a static
  # instance="daniel-server"/origin="daniel-server" label pair over there, so dashboard
  # queries/legends keep matching. See claude-otel's prometheus.yaml.j2.

#################################################################################################

  # Loki's own /metrics (ingestion rate, chunk-flush errors, request latencies) on its HTTP
  # port — Loki and Prometheus share the `monitoring` net. The failure CASES are already
  # caught out-of-band (monitor-bridge's loki_ingestion check + the Kuma /ready probe); this
  # adds the trendable HISTORY (ingestion/error graphs in Grafana) those point-in-time checks
  # don't retain.
  - job_name: "loki"
    scrape_interval: 1m
    static_configs:
    - targets: ["loki:3100"]

#################################################################################################

  # promtail job PORTED to the cluster prometheus at Phase E2 (2026-08-12) — same reasoning as
  # the traefik/node/cadvisor block above. See claude-otel's prometheus.yaml.j2.

#################################################################################################

