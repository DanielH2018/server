# my global config
global:
  scrape_interval:     1m
  evaluation_interval: 1m
  # Stamped onto every series leaving this instance via remote_write below, and onto nothing
  # else — external_labels do not touch local storage or local queries, so the Docker Grafana
  # keeps seeing exactly the label sets it saw before. That is what makes the k3s northbound
  # reversible rather than a cutover.
  #
  # Mandatory, not decorative. The cluster Prometheus independently scrapes a job named
  # `otel-collector` at `otel-collector:8889` and (since slice 3 B3) itself as `prometheus` at
  # `localhost:9090` — both live, both verified 2026-08-07. This instance produces those exact
  # two (job, instance) pairs for entirely different processes. Written across unlabelled, the
  # two sources collide into one series and the receiver rejects half the samples as
  # out-of-order, corrupting both sides rather than either.
  external_labels:
    origin: "{{ inventory_hostname }}"

# Northbound to the k3s cluster Prometheus (slice 3, B3). Both stacks hold the same data, which
# is the property that makes the rest of slice 3 reversible: B5 repoints monitor-bridge at the
# cluster and B6 retires this instance, and until B6 either one can serve.
#
# Chosen over having the cluster scrape daniel-server: every job above targets a container name
# on the internal `monitoring` network and NONE is published to the host, so scraping inward
# would mean exposing eleven jobs' worth of ports to the LAN. This is one outbound connection.
#
# The receiving route admits this host only (ClientIP), so the URL is not a shared secret and
# there is no credential here to leak.
remote_write:
  - url: "https://prometheus{{ k8s_hostname_suffix }}.local.{{ domain }}/api/v1/write"

# No Alertmanager: alerting is handled out-of-band by the monitor-bridge sidecar
# (Prometheus metrics -> Uptime Kuma push monitors -> Discord), not by Prometheus
# rules + Alertmanager. See ansible/roles/containers/monitor-bridge/.

scrape_configs:
  - job_name: 'prometheus'
    scrape_interval: 1m
    static_configs:
    - targets: ['localhost:9090']

#################################################################################################

  - job_name: 'traefik'
    scrape_interval: 15s
    static_configs:
      - targets: ['traefik:8080']

#################################################################################################

  - job_name: "node"
    scrape_interval: 1m
    static_configs:
    - targets: ["node-exporter:9100"]
    metric_relabel_configs:
      # Pin a single, consistent `instance` across ALL node metrics. The previous rule
      # sourced `instance` from the `nodename` label, which only exists on node_uname_info
      # — so it stripped `instance` off every other node metric and broke node dashboards
      # (panels filtering on instance="$node" matched nothing). A static replacement keeps
      # one stable host identity everywhere.
      - target_label: instance
        replacement: "{{ inventory_hostname }}"

#################################################################################################

  - job_name: "cadvisor"
    scrape_interval: 1m
    static_configs:
    - targets: ["cadvisor:8080"]

#################################################################################################

  # Loki's own /metrics (ingestion rate, chunk-flush errors, request latencies) on its HTTP
  # port — Loki and Prometheus share the `monitoring` net. The failure CASES are already
  # caught out-of-band (monitor-bridge's loki_ingestion check + the Kuma /ready probe); this
  # adds the trendable HISTORY (ingestion/error graphs in Grafana) those point-in-time checks
  # don't retain.
  - job_name: "loki"
    scrape_interval: 1m
    static_configs:
    - targets: ["loki:3100"]

#################################################################################################

  # Promtail's own /metrics (per-target send failures, promtail_dropped_entries_total,
  # positions-file lag) on its :9080 server port — Promtail and Prometheus share `monitoring`.
  # The loki_ingestion bridge check only trips at ZERO lines; this surfaces PARTIAL log-shipping
  # loss (dropped/rate-limited entries) plus the trend history that point-in-time check can't retain.
  - job_name: "promtail"
    scrape_interval: 1m
    static_configs:
    - targets: ["promtail:9080"]

#################################################################################################

#################################################################################################

  # uptime-kuma job PORTED to the cluster prometheus 2026-08-10 (dashboard triage PG1 —
  # it scraped a cluster workload from the wrong side). Same job name over there, so
  # monitor_status consumers kept resolving. (The commented netdata-scrape block retired
  # in the same pass — netdata itself was never deployed.)

#################################################################################################


  - job_name: "crowdsec_{{ inventory_hostname }}"
    scrape_interval: 1m
    static_configs:
    - targets: ["crowdsec:6060"]
      labels:
        machine: "{{ inventory_hostname }}"

  - job_name: "terraria-stats"
    scrape_interval: 1m
    static_configs:
    - targets: ["terraria-stats:9420"]

  # home-assistant job PORTED to the cluster prometheus 2026-08-10 (dashboard triage PG1),
  # after two prior hops (Docker DNS → -k8s route). hass_* consumers query unpinned, so
  # the native cluster series feed them unchanged.

#################################################################################################
