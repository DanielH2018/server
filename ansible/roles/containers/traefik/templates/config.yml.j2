http:
 #region routers
  routers:
    dashboard:
      entryPoints:
        - https
      rule: "Host(`traefik.{{ domain }}`) || Host(`traefik.local.{{ domain }}`)"
      service: api@internal
      middlewares:
        # rate-limit is now applied per-router (it was removed from the https
        # entrypoint so the livesync router can opt into a higher ceiling).
        # default-headers is NOT repeated here — it's already applied globally on the
        # https entrypoint (traefik.yml.j2), so listing it again was a redundant no-op.
        - rate-limit
        - authelia
      tls: {}

    livesync:
      # Obsidian LiveSync sync API — defined HERE (traefik file provider, mode 0600, so only
      # the traefik process reads it) instead of as a Docker label on the couchdb container,
      # so the secret X-Sync-Token stays OUT of container metadata. Any container on the shared
      # `apps` network can read every container's labels via the docker-proxy (CONTAINERS=1),
      # which would have leaked the token from the old label form. A request must carry the
      # matching token or it matches NO router for the host and 404s before reaching CouchDB;
      # CouchDB's own require_valid_user is the second layer (defence in depth). The couchdb
      # service is referenced cross-provider (livesync@docker) — the role still publishes it via
      # its one remaining service label. Default (rule-length) priority is preserved from the old
      # label, so the priority=200 livesync-utils router still wins for /_utils.
      entryPoints:
        - https
      rule: "(Host(`livesync.{{ domain }}`) || Host(`livesync.local.{{ domain }}`)) && Header(`X-Sync-Token`, `{{ livesync_sync_token }}`)"
      service: livesync@docker
      middlewares:
        - rate-limit-livesync
      tls:
        certResolver: cloudflare
        domains:
          - main: "{{ domain }}"
            sans:
              - "*.{{ domain }}"
              - "*.local.{{ domain }}"

    homelab-mcp:
      # Read-only homelab MCP server (roles/containers/homelab-mcp). LAN-ONLY: matches only
      # mcp.local.<domain> (NO public mcp.<domain> router) AND requires the bearer token in the
      # Authorization header. Defined here (file provider, mode 0600) — not as a Docker label —
      # so the token stays out of container metadata (the livesync X-Sync-Token pattern). A
      # request without the exact token matches NO router for the host and 404s before the app;
      # the app re-checks the token too (defence in depth, for shared-net peers skipping Traefik).
      entryPoints:
        - https
      rule: "Host(`mcp.local.{{ domain }}`) && Header(`Authorization`, `Bearer {{ homelab_mcp_token }}`)"
      service: homelab-mcp@docker
      middlewares:
        - rate-limit
      tls:
        certResolver: cloudflare
        domains:
          - main: "{{ domain }}"
            sans:
              - "*.{{ domain }}"
              - "*.local.{{ domain }}"

    happy:
      # Self-hosted happy (roles/containers/happy) — Claude Code session-sync server
      # (slopus/happy, standalone shape). LAN-ONLY: matches only happy.local.<domain> (NO
      # public happy.<domain> router). No bearer/Authelia, unlike homelab-mcp above — happy
      # clients authenticate via their own E2E device-auth crypto pairing and can't send a
      # Traefik bearer or pass Authelia 2FA, so the posture here is network-reachability
      # (WireGuard/LAN + Pi-hole *.local DNS) + native auth. The server never sees plaintext.
      entryPoints:
        - https
      rule: "Host(`happy.local.{{ domain }}`)"
      service: happy@docker
      middlewares:
        - rate-limit
      tls:
        certResolver: cloudflare
        domains:
          - main: "{{ domain }}"
            sans:
              - "*.{{ domain }}"
              - "*.local.{{ domain }}"

    happy-webapp:
      # Self-hosted happy browser dashboard (roles/containers/happy, Phase 3) — the static
      # webapp that talks to the happy server. Same posture as the happy router above:
      # LAN-ONLY (only app.local.<domain>, NO public app.<domain>), and NO Authelia. The
      # bundle holds no secrets and its API/WS calls go to happy.local (which has no Authelia
      # either) — real gate is WireGuard reachability + happy's own account/E2E auth, which
      # the browser prompts for regardless. Gating only the static UI here would add a second
      # login for no data-protection gain, so it matches the sync route: reachability + native auth.
      entryPoints:
        - https
      rule: "Host(`app.local.{{ domain }}`)"
      service: happy-webapp@docker
      middlewares:
        - rate-limit
      tls:
        certResolver: cloudflare
        domains:
          - main: "{{ domain }}"
            sans:
              - "*.{{ domain }}"
              - "*.local.{{ domain }}"

{#
  Strangler-bridge routers (docs/k3s-migration/slice-2-leaf-apps.md, decision 1). A service that
  has moved to k3s keeps its real hostnames pointing here — public DNS is Cloudflare-proxied to
  the home IP and the router forwards :443 to daniel-server until slice 6 — so retiring its
  Docker container means replacing it with a route to the cluster, not repointing a name.

  The list comes from daniel-box's inventory rather than a second list here, so "which services
  are bridged" has one source of truth. A bridge whose k8s side is missing would 404, and one
  whose Docker container is still running would give two routers the same Host rule; both are
  asserted against in ansible/tests/test_strangler_bridge.py.

  ONE ROUTER PER HOSTNAME, not one router with an || rule, because the backend is HTTPS: Traefik
  rejects a request whose Host header disagrees with the TLS SNI it sent, with 421 Misdirected
  Request, and serversTransport.serverName is a single value. Verified against the live cluster
  — an apex serverName with a per-service Host 421s on both h2 and http/1.1, while SNI matching
  the Host returns the app. So each hostname gets its own router, service and transport.
#}
{% set bridged = hostvars['daniel-box'].containers_list | default([]) | selectattr('bridge_hostname', 'defined') | list %}
{% for svc in bridged %}
{% for key, host in [('public', svc.bridge_hostname ~ '.' ~ domain), ('local', svc.bridge_hostname ~ '.local.' ~ domain)] %}
    {{ svc.name }}-bridge-{{ key }}:
      entryPoints:
        - https
      rule: "Host(`{{ host }}`)"
      service: {{ svc.name }}-bridge-{{ key }}
      middlewares:
        - rate-limit
{% if svc.use_authelia | default(false) %}
        # Authelia is applied HERE and nowhere downstream. The k8s copy's bridged route
        # deliberately carries no forward-auth: each portal sets its own cookie, so gating both
        # ends means two logins, and the k8s portal has no public DNS record while
        # k8s_public_route is false. This is the only publicly reachable portal, so it is the
        # one that authenticates.
        - authelia
{% endif %}
      tls:
        certResolver: cloudflare
        domains:
          - main: "{{ domain }}"
            sans:
              - "*.{{ domain }}"
              - "*.local.{{ domain }}"
{% endfor %}
{% for prefix in svc.bridge_bypass_prefixes | default([]) %}
{% set slug = prefix | trim('/') | replace('/', '-') %}
{% for key, host in [('public', svc.bridge_hostname ~ '.' ~ domain), ('local', svc.bridge_hostname ~ '.local.' ~ domain)] %}
    {{ svc.name }}-bridge-bypass-{{ slug }}-{{ key }}:
      # An unauthenticated path the service had BEFORE it moved, reproduced on the bridge.
      # These exist because something automated calls them without a session — healthchecks'
      # /ping/ is called by every monitored cron — so gating them does not fail loudly, it
      # turns every check red while the jobs themselves keep succeeding.
      #
      # PUBLIC on purpose, unlike a probe route, because the callers are not all on the LAN.
      # That makes each one a deliberate hole, so test_strangler_bridge.py requires the prefix
      # to appear in an explicit allow-list with a written reason — a new public unauthenticated
      # path cannot be added by editing inventory alone.
      #
      # The trailing slash is load-bearing, carried across from the Docker label this replaces:
      # PathPrefix(`/ping`) would also match sibling paths like /pingXYZ and widen the hole. The
      # test asserts it.
      entryPoints:
        - https
      rule: "Host(`{{ host }}`) && PathPrefix(`{{ prefix }}`)"
      priority: 100
      service: {{ svc.name }}-bridge-{{ key }}
      middlewares:
        - rate-limit
      tls:
        certResolver: cloudflare
        domains:
          - main: "{{ domain }}"
            sans:
              - "*.{{ domain }}"
              - "*.local.{{ domain }}"
{% endfor %}
{% endfor %}
{% for prefix in svc.bridge_lan_prefixes | default([]) %}
{% set slug = prefix | trim('/') | replace('/', '-') | replace('.', '-') %}
    {{ svc.name }}-bridge-lan-{{ slug }}:
      # An API path another homelab service calls directly, reproduced on the bridge. Before
      # the migration these calls went container-to-container over a Docker network and never
      # touched Traefik at all; once the callee is in the cluster there is no such path, and
      # the caller has no way to pass Authelia. Homepage's widgets are the case that found
      # this — they failed with ENOTFOUND the moment the container was retired.
      #
      # LAN-ONLY, unlike a bypass: the callers are containers on daniel-server, so there is no
      # reason for the internet to reach these. The app's own API auth is the second layer and
      # the reason this is acceptable at all — the posture livesync already uses (network
      # reachability plus the app's own credentials), not an unprotected endpoint.
      entryPoints:
        - https
      rule: "Host(`{{ svc.bridge_hostname }}.local.{{ domain }}`) && PathPrefix(`{{ prefix }}`)"
      priority: 100
      service: {{ svc.name }}-bridge-local
      middlewares:
        - rate-limit
      tls:
        certResolver: cloudflare
        domains:
          - main: "{{ domain }}"
            sans:
              - "*.{{ domain }}"
              - "*.local.{{ domain }}"
{% endfor %}
{% if svc.bridge_probe_path is defined %}
    {{ svc.name }}-bridge-probe:
      # The only route that exercises the whole bridge. Every other monitor of an
      # Authelia-gated bridged service stops at the 302 the edge returns, BEFORE the bridge is
      # consulted, so it stays green whether or not daniel-server can still reach the cluster.
      # This one skips forward-auth, so the request traverses the transport, the cluster's
      # Traefik and the app itself, and only the app can answer it.
      #
      # LAN-ONLY, and that is the security boundary rather than a detail: there is deliberately
      # no `{{ svc.bridge_hostname }}.{{ domain }}` sibling, so this is unreachable from the
      # internet. test_strangler_bridge.py fails if a probe router ever matches a host without
      # `.local.` — the same shape as the ClientIP guard, where the exemption from auth and the
      # thing that makes it safe cannot be separated.
      #
      # Path, not PathPrefix: an exact match cannot widen to whatever else lives underneath it.
      entryPoints:
        - https
      rule: "Host(`{{ svc.bridge_hostname }}.local.{{ domain }}`) && Path(`{{ svc.bridge_probe_path }}`)"
      # Explicit rather than inherited. This rule is longer than the plain Host one so
      # rule-length ordering would pick it anyway, but a length tie is a silent inversion
      # waiting for someone to rename a host — the livesync-utils router states its priority
      # for the same reason.
      priority: 200
      service: {{ svc.name }}-bridge-local
      middlewares:
        - rate-limit
      tls:
        certResolver: cloudflare
        domains:
          - main: "{{ domain }}"
            sans:
              - "*.{{ domain }}"
              - "*.local.{{ domain }}"
{% endif %}
{% endfor %}

#endregion
#region services
  services:
    # (Empty but for the strangler bridges below — api@internal is built-in.)
{% for svc in bridged %}
{% for key, host in [('public', svc.bridge_hostname ~ '.' ~ domain), ('local', svc.bridge_hostname ~ '.local.' ~ domain)] %}
    {{ svc.name }}-bridge-{{ key }}:
      loadBalancer:
        servers:
          # The MetalLB ingress VIP, by address: the hostname would resolve either to Cloudflare
          # (public) or back to this host (LAN), and both are loops.
          - url: "https://{{ k3s_metallb_ingress_vip }}"
        # Default, but stated: the cluster routes on Host, and the apps build redirects from it.
        passHostHeader: true
        serversTransport: {{ svc.name }}-bridge-{{ key }}
{% endfor %}
{% endfor %}

#endregion
#region serversTransports
  serversTransports:
{% for svc in bridged %}
{% for key, host in [('public', svc.bridge_hostname ~ '.' ~ domain), ('local', svc.bridge_hostname ~ '.local.' ~ domain)] %}
    {{ svc.name }}-bridge-{{ key }}:
      # Sets the SNI, which does double duty: it selects the cluster's wildcard certificate and
      # it has to equal the Host header or Traefik answers 421. Certificate verification stays
      # ON — the cluster serves the same Let's Encrypt wildcard this host does.
      serverName: "{{ host }}"
{% endfor %}
{% endfor %}

#endregion
  middlewares:
    # (HTTP→HTTPS redirection lives on the web entrypoint in traefik.yml — a
    # redirectScheme middleware here would be dead config.)
    default-headers:
      headers:
        customResponseHeaders:
          Permissions-Policy: "geolocation=(self), microphone=(), camera=(), fullscreen=(self), usb=()"
          # No global Content-Security-Policy here: Traefik's customResponseHeaders REPLACES the
          # backend's header, so a blanket CSP clobbers the stricter, per-app CSPs that apps like
          # FreshRSS and Homepage set themselves (FreshRSS even self-detects the weakened header and
          # warns of XSS exposure). Clickjacking is already covered by X-Frame-Options SAMEORIGIN
          # below. Set CSP per-app via a dedicated headers middleware where origins are known-good.
        referrerPolicy: "strict-origin-when-cross-origin"
        # No frameDeny: customFrameOptionsValue (SAMEORIGIN, below) takes precedence in Traefik,
        # so frameDeny:true was dead config that misrepresented the effective policy as DENY.
        # SAMEORIGIN is intentional (allows same-origin iframes).
        browserXssFilter: true
        contentTypeNosniff: true
        forceSTSHeader: true
        stsIncludeSubdomains: true
        # No `stsPreload` on purpose: the preload directive is only honoured by
        # browsers at max-age >= 1 year (31536000s), so at 180 days it's a no-op
        # that advertises an intent we can't fulfil. Preloading is also a hard-to-
        # reverse commitment that would force HTTPS on every *.{{ domain }} subdomain
        # baked into browsers — not worth it for a homelab. Keep HSTS without preload.
        stsSeconds: 15552000
        customFrameOptionsValue: SAMEORIGIN
        customRequestHeaders:
          X-Forwarded-Proto: https

    # Per-app Content-Security-Policy — the concrete case the default-headers note above points at
    # ("Set CSP per-app via a dedicated headers middleware where origins are known-good"). There's
    # deliberately no GLOBAL CSP because customResponseHeaders REPLACES the backend header, which
    # would clobber apps that self-set a stricter one (freshrss, homepage). karakeep sends none of
    # its own and renders untrusted saved web pages/snapshots into an authenticated session, so it
    # gets one here. Permissive-but-real: it's a Next.js app that needs 'unsafe-inline'/'unsafe-eval',
    # so inline-script INJECTION isn't blocked — but loading EXTERNAL scripts, plugin objects
    # (object-src none), <base> hijacking, cross-origin exfil via fetch/websocket/form-post, and
    # clickjacking (frame-ancestors) all are. Attached to karakeep's MAIN router only, via the
    # labels() macro's extra_middlewares arg (the /api bypass router serves JSON — a CSP there does
    # nothing). img-src allows https: so cached-page/favicon art isn't broken; tighten to
    # `'self' data: blob:` if karakeep is confirmed to proxy all its images same-origin.
    csp-karakeep:
      headers:
        customResponseHeaders:
          Content-Security-Policy: >-
            default-src 'self'; base-uri 'self'; object-src 'none';
            script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline';
            img-src 'self' data: blob: https:; font-src 'self' data:;
            connect-src 'self'; media-src 'self' data: blob:; frame-src 'self' blob:;
            worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'self';
            form-action 'self'

    crowdsec:
      plugin:
        bouncer:
          enabled: true
          crowdsecLapiKey: "{{ crowdsec_bouncer_api_key }}"
          crowdsecLapiHost: "crowdsec:8080"
          crowdsecMode: stream
          updateIntervalSeconds: 60
          # AppSec Component — inline L7 WAF (see crowdsec-acquis.yaml.j2). stream mode above is the
          # reactive ban-list (bans an IP after a pattern of log lines); this inspects each request
          # inline BEFORE the backend, so a first-hit malicious payload (CVE string / SQLi / path
          # traversal) is blocked, not merely banned-after-the-fact. crowdsec:7422 is the appsec
          # acquisition listener on the shared `proxy` net. UnreachableBlock:false = FAIL OPEN: an
          # appsec-broker/crowdsec hiccup keeps the edge serving (defers to the ban-list) instead of
          # 500ing the fleet — the add-on must not become a new edge SPOF. FailureBlock keeps its
          # secure default (a rule-eval error on a request blocks that one request).
          crowdsecAppsecEnabled: true
          crowdsecAppsecHost: "crowdsec:7422"
          crowdsecAppsecUnreachableBlock: false

    rate-limit:
      rateLimit:
        average: 300
        burst: 150
        period: 1m

    # CouchDB / Obsidian LiveSync only. Replication is extremely chatty (_changes,
    # _revs_diff, _bulk_docs, per-chunk reads), so it gets a much higher ceiling than
    # the shared `rate-limit` default. Applied per-router on the livesync sync router
    # (rate-limit-livesync@file) — see roles/containers/livesync. Keyed on source IP
    # like the default limiter (Traefik's rateLimit default sourceCriterion).
    rate-limit-livesync:
      rateLimit:
        average: 6000
        burst: 600
        period: 1m

    authelia:
      forwardAuth:
        address: "http://authelia:9091/api/authz/forward-auth"
        trustForwardHeader: true
        authResponseHeaders:
          - "Remote-User"
          - "Remote-Groups"
          - "Remote-Name"
          - "Remote-Email"
        maxResponseBodySize: 1048576

tls:
  stores:
    default:
      defaultGeneratedCert:
        resolver: cloudflare
        domain:
          main: "{{ domain }}"
          sans:
            - "*.{{ domain }}"
            - "*.local.{{ domain }}"
  options:
    default:
      minVersion: 'VersionTLS12'
      cipherSuites:
        - 'TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256'
        - 'TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256'
        - 'TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384'
        - 'TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384'
        - 'TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305'
        - 'TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305'
