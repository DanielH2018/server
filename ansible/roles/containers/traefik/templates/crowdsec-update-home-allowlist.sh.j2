#!/bin/bash
# Keeps the operator's current home public IP in CrowdSec's `home-ips` allowlist so browsing the
# public path from home doesn't trip the WAF. Runs every 5 min; most runs are a no-op (IP unchanged).
#
# BOTH FAMILIES. IPv4 is a single address (everything at home shares it via NAT); IPv6 is the home
# LAN's /64 PREFIX, not an address, and that difference is the whole point. With IPv6 there is no
# NAT: every device gets its own globally-routable address, and privacy extensions rotate it — so a
# /128 entry would allowlist one interface of one machine for a few hours and leave the operator's
# phone and laptop exposed. Verified 2026-08-06 that daniel-server and daniel-pi share
# 2601:246:c301:df20::/64, i.e. the home LAN is a single /64, so the prefix is both necessary and
# sufficient. It is also the exact analogue of the IPv4 entry: "every device at home", no wider.
#
# This gap was live and cost an outage: on 2026-08-06 a 120-request burst test against a public
# homelab hostname egressed over IPv6, tripped crowdsecurity/http-crawl-non_statics AND
# crowdsecurity/http-probing, and banned the homelab's own public IPv6 — 403ing every
# *.<domain> for everyone at home. The allowlist that exists to prevent exactly that held IPv4
# only, so it did nothing.
#
# Reporting: writes {"ts","ok","msg"} to STATE on EVERY run (incl. the no-change fast path);
# monitor-bridge's `home_allowlist` check reads it (:ro bind mount) and pushes the "CrowdSec Home
# Allowlist" Kuma monitor — a FAILED run (ipify unreachable, malformed IP, cscli error) or staleness
# (cron broken / never ran) alerts. Without this the updater was the last self-`logger`ing cron with no
# watchdog: a silent failure just meant occasional 403s on the next home-IP rotation, invisible until
# noticed. `set -uo` (not -euo) so a cscli error is captured + reported, not swallowed by an early exit
# (same idiom as the kopia / wg-easy-pull-pi-peers crons).
set -uo pipefail

ALLOWLIST="home-ips"
STATE_FILE="/home/{{ sys_user }}/.crowdsec-home-ip"
# A separate file rather than reformatting the one above, so an existing host needs no first-run
# migration: the IPv4 path reads exactly what it wrote before this change.
STATE_FILE6="/home/{{ sys_user }}/.crowdsec-home-ip6"
STATE=/var/lib/crowdsec-home-allowlist/state.json

# shellcheck source=/dev/null
source /usr/local/lib/traefik-lib.sh
write_state() { traefik_write_state "$STATE" crowdsec-home-allowlist "$@"; } # ok msg

if ! CURRENT_IP=$(curl -sf --max-time 10 https://api4.ipify.org); then
  write_state false "failed to resolve public IPv4 from ipify"
  exit 1
fi

# Validate the response is a well-formed IPv4 before using it. The value is already quoted and the
# source is HTTPS (no injection risk) — this guards against a malformed/MITM'd response adding a junk
# or overly-broad allowlist entry.
if ! [[ $CURRENT_IP =~ ^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$ ]]; then
  write_state false "invalid IPv4 from ipify: $CURRENT_IP"
  exit 1
fi

# ── IPv6 ────────────────────────────────────────────────────────────────────────────────────
# Gated on the host actually HAVING global IPv6, checked locally rather than inferred from a failed
# fetch. The two cases need opposite responses and are indistinguishable from ipify's exit code
# alone: a v4-only host has nothing to allowlist and no IPv6 WAF exposure, so skipping is correct;
# a v6-capable host that cannot reach ipify6 is a real degradation, because the prefix can rotate
# underneath a stale entry and the next rotation 403s everyone at home.
CURRENT_PREFIX6=""
if ip -6 addr show scope global 2>/dev/null | grep -q inet6; then
  if ! CURRENT_IP6=$(curl -sf --max-time 10 https://api6.ipify.org); then
    write_state false "host has global IPv6 but failed to resolve public IPv6 from ipify"
    exit 1
  fi
  # Validate AND mask to the /64 in one step. Deliberately not a hand-rolled regex or an IFS=':'
  # split: an RFC-correct IPv6 pattern is a bug farm, and naive splitting silently produces garbage
  # on compressed forms (it happens to work for 2601:246:c301:df20::5b18 and does not for
  # 2601:246::5b18). ip_network(..., strict=False) rejects junk by raising, so a bad value fails
  # loudly here instead of becoming an allowlist entry.
  if ! CURRENT_PREFIX6=$(python3 -c 'import ipaddress,sys; print(ipaddress.ip_network(sys.argv[1] + "/64", strict=False))' "$CURRENT_IP6" 2>/dev/null); then
    write_state false "invalid IPv6 from ipify: $CURRENT_IP6"
    exit 1
  fi
fi

STORED_IP=$(cat "$STATE_FILE" 2>/dev/null || true)
STORED_PREFIX6=$(cat "$STATE_FILE6" 2>/dev/null || true)

# Fast path: BOTH families unchanged (the common case — neither rotates often). The conjunction is
# load-bearing: gating the whole run on IPv4 alone would mean a rotated IPv6 prefix is never synced
# as long as the IPv4 holds still, which is the same silent-skip bug this change exists to fix, one
# layer down. Still refreshes the watchdog heartbeat so a healthy no-op keeps the monitor green.
#
# Comparing PREFIX to PREFIX, never address to address: the host carries mngtmpaddr temporary
# addresses that rotate within the prefix, so comparing addresses would churn a remove/add cycle
# every five minutes and flap the monitor message.
if [ "$CURRENT_IP" = "$STORED_IP" ] && [ "$CURRENT_PREFIX6" = "$STORED_PREFIX6" ]; then
  write_state true "home IPs unchanged (${CURRENT_IP}${CURRENT_PREFIX6:+, $CURRENT_PREFIX6})"
  exit 0
fi

docker exec crowdsec cscli allowlists create "$ALLOWLIST" --description "Home IPs" 2>/dev/null || true

# Replace one family's entry, leaving the other's alone. Returns non-zero on a failed add so the
# caller can report which family broke — a partial sync must not write a state file, or the next
# run's fast path would treat the un-added value as already applied.
sync_entry() { # stored current state_file label
  local stored=$1 current=$2 state_file=$3 label=$4 add_out summary
  [ "$stored" = "$current" ] && return 0
  if [ -n "$stored" ]; then
    docker exec crowdsec cscli allowlists remove "$ALLOWLIST" "$stored" 2>/dev/null || true
  fi
  if [ -z "$current" ]; then
    # The family went away (IPv6 lost since the last run). The stale entry is removed above and the
    # state file cleared, so a later reappearance is treated as a change rather than a no-op.
    : > "$state_file"
    return 0
  fi
  if ! add_out=$(docker exec crowdsec cscli allowlists add "$ALLOWLIST" "$current" 2>&1); then
    summary=$(printf '%s' "$add_out" | tail -1 | tr -d '"' | tr '\n' ' ')
    write_state false "cscli allowlists add failed for $label: ${summary:-see crowdsec-home-allowlist syslog}"
    return 1
  fi
  echo "$current" > "$state_file"
  return 0
}

sync_entry "$STORED_IP" "$CURRENT_IP" "$STATE_FILE" IPv4 || exit 1
sync_entry "$STORED_PREFIX6" "$CURRENT_PREFIX6" "$STATE_FILE6" IPv6 || exit 1

CHANGES=""
[ "$CURRENT_IP" != "$STORED_IP" ] && CHANGES="IPv4 ${STORED_IP:-<none>} -> $CURRENT_IP"
if [ "$CURRENT_PREFIX6" != "$STORED_PREFIX6" ]; then
  CHANGES="${CHANGES:+$CHANGES; }IPv6 ${STORED_PREFIX6:-<none>} -> ${CURRENT_PREFIX6:-<none>}"
fi
write_state true "home allowlist updated: $CHANGES"
