{% from 'traefik.yml.j2' import labels with context %}
{% from 'autokuma.yml.j2' import labels as kuma with context %}
{% from 'healthcheck.yml.j2' import healthcheck %}
{% from 'networks.yml.j2' import service_networks, external_networks with context %}
{% from 'resources.yml.j2' import resources %}
---

services:
  # The grafana service moved to the cluster grafana (E1, 2026-08-12) — it now owns the
  # unsuffixed name and reads the same dashboards tree. The Docker loki cut (D.2 step 4)
  # executed 2026-08-13, four days early by operator decision — its container, `loki`
  # named volume, and pre-cutover history are gone. promtail stays a Docker-host tailer
  # until the DRAIN step (the F join happened 2026-08-13, but the cluster promtail DS is
  # pinned to daniel-box until then to avoid double-shipping), pushing only to the
  # cluster loki-homelab.
  promtail:
    image: grafana/promtail:latest
    container_name: promtail
    restart: unless-stopped
    {{ healthcheck('["CMD", "bash", "-c", "echo > /dev/tcp/127.0.0.1/9080"]', start_period='15s') }}
    cap_drop:
      - ALL
    cap_add:
      # Reads root-owned /var/log + /var/lib/docker/containers logs; DAC_READ_SEARCH lets
      # root bypass DAC to read non-root-owned log files. Verify logs still ship on deploy
      # (Grafana Explore → Loki). It writes only its own positions file (owner-writable).
      - DAC_READ_SEARCH
    security_opt:
      - no-new-privileges:true
    environment:
      - TZ={{ tz }}
      - DOCKER_HOST=tcp://docker-proxy:2375
    volumes:
      - ./promtail-config.yaml:/etc/promtail/promtail-config.yaml:ro
      # Persist the tailing positions cursor (positions.filename: /tmp/positions.yaml) across
      # recreates — without this every deploy re-reads all tailed sources from the start, which
      # can exceed Loki's ingestion rate limit and silently drop logs mid-deploy. Regenerable
      # cursor state → a named volume (out of Kopia scope), same pattern as loki's volume below.
      - promtail_positions:/tmp
      # Access to mounted log files
      - /var/log/:/logs
      # Access to the host log files
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
    command: -config.file=/etc/promtail/promtail-config.yaml
    ports:
      # Phase E2: LAN-published (host 9102 -> container 9080) for the cluster Prometheus
      # (10.0.0.161:9102). Locked to daniel-box only by the prometheus role's
      # prometheus-exporters-lan-firewall.sh.
      - "{{ server_ip }}:9102:9080"
    {{ service_networks() }}
    labels:
      {{ kuma('promtail') }}
      # Watchtower
      - "com.centurylinklabs.watchtower.depends-on=docker-proxy"
    # Resource caps for blast-radius containment (M1); tune from cAdvisor/Grafana.
    {{ resources('0.50', '256M', '0.05', '32M') }}

{{ external_networks() }}

volumes:
    # Promtail's positions cursor — regenerable, deliberately out of Kopia's bind-mount scope.
    promtail_positions:
