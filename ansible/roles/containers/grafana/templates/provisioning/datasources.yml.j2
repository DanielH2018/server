# Managed by Ansible (grafana role) — do not edit in the container.
# Datasources provisioned as code. The uids below are ADOPTED from the datasources
# that were originally created by hand in this Grafana — keeping them means the 9
# pre-existing dashboards (Crowdsec, Traefik, log views) keep resolving, and a fresh
# rebuild reproduces the same uids so every dashboard (seed + existing) stays wired.
# Provisioning matches by uid and updates in place (no delete/recreate). `editable: true`
# keeps them tweakable in the UI.
apiVersion: 1

datasources:
  - name: Prometheus
    uid: EGdsQqhVk
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true
    editable: true
    jsonData:
      # Tell Grafana the real scrape interval (prometheus.yml global + node job = 1m).
      # Otherwise it defaults to 15s and computes $__rate_interval ≈ 1m, so rate()
      # panels (CPU/network/pressure) return empty over short ranges on 1m-scraped
      # data. With this, $__rate_interval becomes ~4m and rate() panels populate.
      timeInterval: "1m"

  # name must match the existing datasource exactly ("loki", lowercase) — Grafana keys
  # update-vs-insert on orgId+name, so a case change would try to INSERT and collide on uid.
  - name: loki
    uid: bf4q19tuivta8e
    type: loki
    access: proxy
    url: http://loki:3100
    editable: true
    jsonData:
      # Logs -> traces. Claude Code stamps trace_id/span_id onto every event it logs, and
      # the OTLP ingest path lands them as structured metadata, so `trace_id` is a real
      # field on the log line rather than something to regex out of the body. This turns it
      # into a "View trace" button in Explore. matcherRegex is required even for a
      # structured-metadata field; datasourceUid points at the Tempo datasource below.
      derivedFields:
        - name: TraceID
          datasourceUid: tempo
          matcherType: label
          matcherRegex: trace_id
          url: "${__value.raw}"

  # New datasource (no hand-created predecessor to adopt), so the uid is simply `tempo`.
  # Backs the Claude Code spans the otel-collector's traces pipeline forwards.
  - name: Tempo
    uid: tempo
    type: tempo
    access: proxy
    url: http://tempo:3200
    editable: true
    jsonData:
      # Traces -> logs, the reverse of loki's derivedFields above: from a span, jump to the
      # events emitted inside it, matched on the same trace_id. The time shifts widen the
      # window because a span's logs can be written either side of its own start/end.
      tracesToLogsV2:
        datasourceUid: bf4q19tuivta8e
        spanStartTimeShift: '-5m'
        spanEndTimeShift: '5m'
        filterByTraceID: true
        customQuery: false
      nodeGraph:
        enabled: true
