    {
      "id": 24,
      "type": "timeseries",
      "title": "Compactions by trigger",
      "description": "A manual /compact preempts the background-precomputed summary and pays full price; precompute_reuse records whether the cheap path was taken. Check here before concluding compaction is expensive.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 49
      },
      "datasource": {
        "type": "loki",
        "uid": "bf4q19tuivta8e"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
