      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool_name) (count_over_time({service_name=\"claude-code\"} | event_name=`tool_result` [$__auto]))",
          "legendFormat": "{{tool_name}}",
          "queryType": "range"
        }
      ]
    },
