            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (trigger, precompute_reuse) (count_over_time({service_name=\"claude-code\"} | event_name=`compaction` [$__auto]))",
          "legendFormat": "{{trigger}} / reuse={{precompute_reuse}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Code edit decisions",
      "description": "Only interactive diff decisions are counted \u2014 auto-accepted edits never reach this metric, so a flat line here does not mean no edits happened.",
      "gridPos": {
        "h": 7,
        "w": 8,
