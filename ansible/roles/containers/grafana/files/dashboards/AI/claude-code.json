        {
          "refId": "A",
          "expr": "sum by (type) ({__name__=~\"claude_code_token_usage.*\"})",
          "legendFormat": "{{type}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Cumulative cost by model (USD, estimated)",
      "description": "Estimated only \u2014 on a subscription plan this is not real spend. Edit accept/reject shows as tool_decision events in the Recent events panel below (Claude Code only emits the code_edit_tool.decision metric for interactive diff decisions, not auto-accepted edits).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "EGdsQqhVk"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) ({__name__=~\"claude_code_cost_usage.*\"})",
          "legendFormat": "{{model}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Turn latency",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "table",
      "title": "Recent traces",
      "description": "One trace per turn: claude_code.interaction, with llm_request and tool spans beneath it. Click a row for the flame graph \u2014 the only view that separates time spent waiting on a permission prompt (tool.blocked_on_user) from time spent running the tool.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=\"claude-code\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "API request latency p95 by model",
      "description": "Server-side round trip per api_request event, not whole-turn time.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "datasource": {
        "type": "loki",
        "uid": "bf4q19tuivta8e"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {service_name=\"claude-code\"} | event_name=`api_request` | unwrap duration_ms [$__auto]) by (model)",
          "legendFormat": "{{model}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 15,
      "type": "row",
      "title": "Tool activity",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "panels": []
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Tool calls by tool",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "loki",
        "uid": "bf4q19tuivta8e"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
