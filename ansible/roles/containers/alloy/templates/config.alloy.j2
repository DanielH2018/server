// Grafana Alloy on daniel-pi. Ships this host's CONTAINER logs to loki-homelab, which is the
// cluster's general-purpose log store and already holds both k3s nodes' pod logs (shipped by
// the cluster's own Alloy DaemonSet, roles/k8s/loki-homelab).
//
// Scope is deliberately two sources. This is a Zero 2 W with 456 MB of RAM and measurable CPU
// pressure at idle, so every target costs something real — see the resource notes in
// docker-compose.yml.j2.
//
// The host JOURNAL is readable now and still not shipped. Promtail's arm64 build was a
// journal stub; this image is not — measured 2026-09-02, loki.source.journal read 6,573
// lines in ten minutes off /var/log/journal and they landed in Loki. What is shipped is the
// two health crons' verdict lines, via the pi_health source below: the narrow slice
// `probe.py alerts` needs, at ~576 lines/day against the journal's ~38k. Turning the journal
// on is one `loki.source.journal` block with a relabel setting `job` (its default job label is
// the component id), and a decision about Loki volume — not a capability gap any more.
//
// Every label this file emits is a contract with the cluster's streams: `container`, `job`,
// `machine`, `stream` — the same names the cluster shipper writes, so one LogQL query spans
// the estate and `machine` tells the sources apart.
// ansible/tests/services/test_alloy_pi_config_labels.py guards the set.

logging {
  // `warn`, not the default `info`: at info Alloy logs a line per discovery pass, which on a
  // 60s refresh is its own steady write load onto the Pi's SD card.
  level = "warn"
}

// The HTTP server on 12345 is published to the LAN — docker-compose.yml.j2's `ports:` marker
// says why it has to be. Everything it serves besides /metrics is a control surface:
// /-/reload re-reads the config and restarts components on an unauthenticated GET, the UI
// renders the whole config graph, and /api/v0/component/ exposes each component's live state.
// None of the three has a consumer; the only caller from off-box is Prometheus, and it reads
// /metrics.
//
// `authenticate_matching_paths = false` INVERTS the filter — the listed paths are the ones
// left open and everything else needs the credential (internal/service/http/auth.go at
// v1.19.2, where the compare is a prefix match). The password is a lock rather than a login:
// no consumer holds it, and nothing here should start using it. Issue #1130.
http {
  auth {
    basic {
      username = "alloy"
      password = "{{ alloy_pi_http_password }}"
    }
    filter {
      paths                       = ["/metrics"]
      authenticate_matching_paths = false
    }
  }
}

loki.write "homelab" {
  endpoint {
    // The ClientIP-guarded push route, not a ClusterIP — the Pi is outside the cluster and
    // has no route to 10.43.0.0/16. loki-homelab's ingressroute-push.yaml.j2 admits this
    // host's IP for /loki/api/v1/push and nothing else, so every other path 404s by design.
    // The cert is the same *.local wildcard Traefik serves everywhere here, so it verifies
    // against the system trust store and needs no tls_config.
    url = "https://loki-homelab.local.{{ domain }}/loki/api/v1/push"
    // Small batches, long timeout. The default 1 MB / 1s suits a busy node; here it just
    // holds more of a scarce heap, and the Pi's uplink is the slow half of the path.
    batch_size          = "64KiB"
    batch_wait          = "5s"
    remote_timeout      = "30s"
    min_backoff_period  = "1s"
    max_backoff_period  = "5m"
    max_backoff_retries = 10
  }
}

// Container logs via the Docker API, NOT by tailing /var/lib/docker/containers/*-json.log.
// The file path carries only the container ID, so a file source would label every stream
// with a 64-character hash and the container name has to be joined back from
// config.v2.json — which a shipper cannot do. Discovery gets the name from the API directly.
//
// Through docker-proxy, never the raw socket: the proxy is already on this host serving
// glances (and this source — the two are its only consumers), it is read-only (POST=0,
// EXEC=0), and CONTAINERS=1 covers both the container list and the log stream. Handing a
// log shipper the bare socket would give it full control of the daemon.
discovery.docker "pi" {
  host = "tcp://docker-proxy:2375"
  // 60s, matching this host's healthcheck cadence. Each pass is an API round trip plus a
  // relabel over every container; at the 5s default that is a needless steady tick on a box
  // where fork rate was itself the problem worth tuning.
  refresh_interval = "60s"
}

discovery.relabel "pi" {
  targets = discovery.docker.pi.targets

  // Docker reports names with a leading slash — "/glances", not "glances". Left as-is the
  // label does not match the `container` label the cluster shipper writes, and a query
  // spanning both estates silently returns only one of them.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  // `job` and `machine` mirror the cluster shipper's contract (job=k8s there), so one LogQL
  // query can span the estate and `machine` still tells the sources apart.
  rule {
    target_label = "job"
    replacement  = "pi"
  }
  rule {
    target_label = "machine"
    replacement  = "daniel-pi"
  }
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

loki.source.docker "pi" {
  host             = "tcp://docker-proxy:2375"
  targets          = discovery.relabel.pi.output
  forward_to       = [loki.write.homelab.receiver]
  refresh_interval = "60s"
}

// The two host health crons' verdict lines — the ONLY host logs shipped from this box, and
// deliberately not the journal (see the header). `probe.py alerts` reconstructs DOWN
// episodes from `{job="syslog"} |= "status=down"`, and until this source existed every
// daniel-pi cron was invisible to it: a real "Daniel Pi Recovery" outage on 2026-08-29
// (autoheal down ~50 min) left no episode anywhere.
//
// `job = "syslog"` matches the label the cluster hosts' syslog stream already carries, so
// one parser and one Grafana board read both estates. `machine = "daniel-pi"` is what keeps
// the two apart — monitor-bridge's Loki liveness check excludes this machine by that label,
// because a Pi-shipped stream under the same `job` would otherwise stop a total cluster
// file-tail outage from ever reaching the zero-entry threshold that check alerts on.
local.file_match "pi_health" {
  path_targets = [{"__path__" = "/var/log/pi-health/*.log", "job" = "syslog", "machine" = "daniel-pi"}]
}

loki.source.file "pi_health" {
  targets    = local.file_match.pi_health.targets
  forward_to = [loki.write.homelab.receiver]
}
