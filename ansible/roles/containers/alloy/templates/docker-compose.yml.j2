{% from 'autokuma.yml.j2' import labels as kuma with context %}
{% from 'networks.yml.j2' import service_networks, external_networks with context %}
{% from 'resources.yml.j2' import resources %}
---

services:
  alloy:
    container_name: alloy
    # Tag AND digest, unlike the :latest@sha256 the Promtail role carried: Alloy is the shipper
    # the cluster pins by tag in roles/k8s/loki-homelab/defaults/main.yml, and keeping the two
    # on one version keeps one label contract. Renovate does not track roles/containers/** —
    # no manager's matchFileNames reaches it (renovate.json) — so this pin moves by hand when
    # the cluster's does. The digest is the arm64 manifest, resolved on daniel-pi 2026-09-02.
    image: grafana/alloy:v1.19.2@sha256:b8ec653c44235fbe910879145dac3597d66b0aaecf60bcbbe82580767771a839
    restart: unless-stopped
    command:
      - run
      - /etc/alloy/config.alloy
      # Alloy binds 127.0.0.1 by default; Prometheus scrapes this from the LAN.
      - --server.http.listen-addr=0.0.0.0:12345
      # The tailing cursor lives here — see the data volume below. NOT the image's own
      # /var/lib/alloy/data: that parent is 0770 uid 473 in the image, so uid 1000 cannot
      # traverse it to reach a bind mount inside, and Alloy dies at startup with
      # `mkdir /var/lib/alloy/data: permission denied` — every two minutes, on the first
      # deploy of this role (2026-09-02). Root never hits it, which is why the cluster
      # DaemonSet and the spike that sized this container both ran.
      - --storage.path=/data
      # Same reason Loki's own config sets analytics.reporting_enabled false: Pi-hole blocks
      # stats.grafana.org and each report would spend its retry budget on a name that never
      # resolves.
      - --disable-reporting
      # /debug/pprof and /-/support answer by default in this build (v1.19.2's
      # internal/alloycli/cmd_run.go: enablePprof true, disableSupportBundle false) and the
      # port below is published on the LAN. pprof hands any LAN client a profiler that costs
      # this 456 MB Zero 2 W real CPU, and /-/support returns a bundle carrying the running
      # config. Neither has a consumer here. See the DECIDED marker on `ports:` for the rest
      # of the surface and why the port itself stays published (issue #1130).
      - --server.http.enable-pprof=false
      - --server.http.disable-support-bundle
    # The image's own uid is 473, and setup_dirs.yml creates the bind-mount source owned by
    # the deploy user (1000). Left at the default, Alloy cannot write its positions under
    # --storage.path. With no positions to resume from, every restart re-reads every
    # container's log from the beginning and re-ships it. Matches the estate's PUID/PGID.
    # The flip side is the storage path above: as 1000 this process cannot enter the
    # image's /var/lib/alloy at all.
    user: "1000:1000"
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /tmp
    {{ service_networks() }}
    # Docker copies the HOST's resolver options into every container's resolv.conf, and this
    # host's are `timeout:2 attempts:1` (optimize_pi_dns_options) — sized so a dead Pi-hole
    # costs one 2s wait before 1.1.1.1 answers. Inside a container that same single 2s try
    # also governs the hop to Docker's embedded DNS at 127.0.0.11, which is dockerd itself,
    # and dockerd stalls for seconds on this Zero 2 W whenever it is busy with a container or
    # network operation. Every 60s pass here opens a fresh connection per container, so one
    # such stall fails six lookups at once — `lookup docker-proxy on 127.0.0.11:53: i/o
    # timeout`, at level=error, six in one 350ms burst on 2026-09-03 eight seconds before a
    # `kill promtail` event, against 0ms for the same lookup at idle (issue #927). Neither
    # side is broken: the resolver is idle-fast, and CFS throttling at the 0.30 cap can hold
    # this process at most 70ms per period, so it cannot manufacture a 2s timeout. Three 3s
    # tries ride out the stall. `attempts` is rounds over the nameserver list, and the list
    # here is one entry, so this is three tries against dockerd — the upstream failover the
    # host's values were tuned for happens inside dockerd's own forwarder, not on this hop.
    dns_opt:
      - timeout:3
      - attempts:3
    volumes:
      - ./config/config.alloy:/etc/alloy/config.alloy:ro
      # Positions must survive a restart. Without this the container re-reads every
      # container's log from the beginning on each recreate, which both duplicates lines in
      # Loki and spends the Pi's uplink re-sending them.
      - ./data:/data
      # The two host health crons' verdict lines (pi_health source). Read-only, and the same
      # path inside and out so the config's path needs no translation. No group_add: the
      # crons write as uid 1000 and this container already runs as 1000:1000.
      - /var/log/pi-health:/var/log/pi-health:ro
    environment:
      # A soft ceiling on the Go runtime's TOTAL memory (heap, stacks, GC metadata, everything
      # `go_memstats_sys_bytes` counts), not on the live heap. When the total reaches it the
      # runtime collects continuously, and the only thing bounding that is the GC CPU limiter
      # at 50% of GOMAXPROCS. This shipped as 48MiB on 2026-09-02, sized from RSS (34-43 MiB)
      # rather than from the runtime total, and that is exactly the state it ran in: sys_bytes
      # 58.7 MB against a 48 MiB limit, 2 GC cycles per second to ship 1.6 log lines per
      # second, and 0.27-0.29 of a core steady for 7 days — the limiter's 50% of one processor,
      # and the largest single load on the host (#932, the host contention behind #930).
      #
      # Sized 2026-09-03 as ~20 MiB over a 58.7 MB `go_memstats_sys_bytes`. The live heap it
      # was sized against was a first-day reading: the post-GC floor of
      # `go_memstats_heap_alloc_bytes` climbed 29 → 38.5 MB over the three days after that
      # restart and has held at 38.3-38.5 MB every day since (measured 2026-09-18 over 16 days;
      # a fresh process starts at 22 MB, and the cluster's Alloy DaemonSet floors at 27 MB).
      # That is warm-up to a plateau, not a leak, and what is in the 38 MB is unmeasured —
      # pprof is off by decision (#1130). With GOGC=100 below, the heap goal is 78 MB; the
      # runtime's non-heap classes add 8 MB and `heap_sys` runs ~7 MB over the goal, so the
      # total the limit governs (`sys_bytes` − `heap_released_bytes`) peaks around 92 MB.
      # The limit sits ABOVE that on purpose. At 88 MiB it was the pacer: measured
      # 2026-09-18 in the first half hour, 0.44 cycles a minute against the 0.23 the goal and
      # the 145 KB/s allocation rate imply, and the fault rate fell 20% where halving the
      # cycles predicts 50% (the GOGC marker below has the numbers). The 72 MiB limit paced
      # the 58 MB goal of GOGC=50 the same way (#1944); with the limit as pacer GOGC is not
      # the setting that decides the cycle. What a limit that is reached does is force the
      # scavenger to hand idle heap pages back to the kernel, which is cheap, and it stays the
      # ceiling a spike collects under rather than the cadence. The continuous-collection
      # state above needs the limit under the live set plus GC slack, which is why the guard in
      # ansible/tests/services/test_alloy_pi_gomemlimit_headroom.py takes the floor from the
      # measured live heap and GOGC, not from `sys_bytes` — that metric never shrinks and read
      # 96.3 MB on 2026-09-17, above the old limit and the old cap alike.
      - GOMEMLIMIT=104MiB
      # Go's default: collect when the heap has doubled its live size. At the 38 MB live heap
      # above that is a 78 MB goal. CPU is not cheaper than RAM on this host after all: the
      # 1c9592c1 shape spent 0.28 cores to save ~10 MiB, and GOGC=50 (2026-09-03 to
      # 2026-09-18) ran a 58 MB goal at 0.52 cycles a minute.
      #
      # DECIDED: GOGC=100, to halve how often this heap is faulted back in, and the faults that
      # remain are accepted (#1967). This host swaps by design (`vm.swappiness=130` to zram,
      # roles/setup/optimize_pi), global reclaim swaps this heap out between cycles, and the
      # mark phase faults it back in. Measured 2026-09-18 at GOGC=50: 28,423 major faults on
      # this cgroup in 300 s (95/s), a third of the host's 84,938, 0.52 cycles a minute —
      # 10,800 faults a cycle against a 9,500-page heap, so by the next cycle the whole heap is
      # cold. GOGC=25 the same day, after a 16-minute warm-up: 1.0 cycles a minute, 33,667 in
      # 300 s of the host's 100,479 — the same 33.5% share, at the same host pressure (memory
      # PSI `full avg300` 4.0-4.6%), so no reduction; 6,700 faults a cycle, half the heap. The
      # rate is cycles × the part of the heap that went cold, and below one cycle every ~2
      # minutes that part is all of it, so halving the cycles halves the faults. The 20 MB the
      # larger goal adds is exactly the part that sits cold, so it costs RAM as compressed swap
      # only: ~5 MB at zram's measured 4.61:1. Pinning the heap instead (`memswap_limit` equal
      # to the cap) would hold 40-60 MB resident for the ~12 MB zram keeps it in, on a host
      # with 10-25 MB free. First measured at GOGC=100 under an 88 MiB limit, in a clean
      # 300 s window 26 minutes after the start: 24,410 faults (81/s), 26.9% of the host's
      # 90,912 — a 20% cut, at 0.44 cycles a minute, because that limit paced the cycle
      # (the GOMEMLIMIT comment above). Judged the day after by
      # `rate(node_vmstat_pswpin{job="node-pi"}[1d])` against the 136-181/s of 2026-09-03 →
      # 09-17; the Pi memory budget review of 2026-09-18
      # (~/.claude/artifacts/pi-memory-budget-review_2026-09-18.md) has the whole host's numbers.
      - GOGC=100
      # One GC-visible processor. Alloy defaults GOMAXPROCS to the 4 cores on this Pi and
      # spawns a worker set to match, which is pure contention for a job this small on a box
      # that already showed RCU stalls from fork rate.
      - GOMAXPROCS=1
    # NO healthcheck, and this is a correction rather than an omission — inherited from the
    # Promtail role, where a wget probe of /ready shipped and could never work: that image
    # carried no wget, curl, nc or busybox, so every probe exited -1 with "executable file
    # not found in $PATH", the container went `unhealthy` after its third failure, and autoheal
    # restarted it on a loop. Alloy's image (Ubuntu-based, the alloy binary and libc) has no
    # HTTP client either. The general rule stands: on this host a healthcheck is only
    # available to an image that ships an HTTP client, and `test:` failing to EXEC is
    # indistinguishable from the service being down.
    #
    # Liveness is covered from outside instead, and better: Prometheus scrapes 12345 as
    # `alloy-pi`, so a dead shipper is `up == 0` on a target that check_cluster_targets
    # already watches. That check sees a wedged shipper this probe could not have.
    # DECIDED: the port stays published on the LAN and the surface behind it is narrowed
    # instead. Two consumers reach it from off-box and neither can use a loopback or a bridge
    # address: claude-otel's `alloy-pi` Prometheus job scrapes k8s_pi_client_ip:12345 as a
    # STATIC target (roles/k8s/claude-otel/templates/prometheus.yaml.j2), and monitor-bridge's
    # detached-container arm expects `alloy` to report a `->` mapping (PI_PUBLISHED_PORTS,
    # pinned by ansible/tests/services/test_pi_publishing_containers.py). Metrics are why the
    # port exists: dropped entries, batch retries and send latency say whether shipping is
    # keeping up, and a log shipper that silently stops is the failure this makes visible.
    #
    # Everything else that answered here is closed rather than published. Alloy v1.19.2 serves
    # /metrics, /-/healthy, /-/ready, /-/reload (GET *and* POST, and no flag disables it),
    # /-/support, /debug/pprof and the config-graph UI on this one listener
    # (internal/service/http/http.go at that tag). The two flags above drop pprof and the
    # support bundle; config.alloy.j2's `http.auth` block requires basic auth on every path
    # EXCEPT /metrics, so the reload endpoint, the UI and /api/v0/component/ now need a
    # credential no LAN client has. Prometheus keeps scraping /metrics unauthenticated
    # exactly as before (issue #1130).
    ports:
      - "{{ server_ip }}:12345:12345/tcp"
    labels:
      {{ kuma(container_item.name) }}

      # Watchtower
      - "com.centurylinklabs.watchtower.depends-on=docker-proxy"
    # 128M is the containment cap, 24 MiB over the 104 MiB GOMEMLIMIT above so a spike is
    # collected rather than OOM-killed (96M was 24 MiB over the 72 MiB limit it paired with).
    # Startup under the 0.30 CPU cap takes minutes on this host (the binary is large and
    # arm64 decompression is slow); it is not a hang.
    #
    # `process_resident_memory_bytes{job="alloy-pi"}` peaked at 75-82 MB on every day under
    # GOGC=50, and that is the top of the GC sawtooth, not an event: the 58 MB heap goal plus 8 MB of runtime
    # plus up to 23 MB of the binary's own text pages (`RssFile`, file-backed) read at the
    # moment of a scrape. Measured 2026-09-18 over 7 days at the 60s scrape: the samples above
    # 70 MB fall in every one of the 24 hours (10-39 per hour), in 435 runs of median length
    # one sample and at most three; the container-log rate is 1.6-1.7 lines/s in every hour;
    # and no cron or timer on the host fires where the daily maxima fall (#1944). The reading
    # is noisy the other way too — 22 MB one scrape and 70 MB the next — because this host
    # swaps by design (`vm.swappiness=130` to zram, roles/setup/optimize_pi) and every GC
    # cycle faults the swapped heap back in: 66-127 major faults/s, a third of the host's.
    # Do not size from RSS or `max_over_time` of it; the cgroup is what the cap governs.
    #
    # The cgroup reached this cap 1,846 times in the first half hour after the 2026-09-18
    # 00:39Z start — the binary's pages being charged and reclaimed as it was read — and not
    # once in the 40 minutes after; `oom_kill` 0. Anonymous memory peaks around 66 MB, file
    # pages are reclaimable, and Docker's default `memory.swap.max` equals the cap, so an
    # OOM kill needs anon plus swap past twice the cap. "~20 MB under its OOM line" was the
    # RSS reading against the cap, and the two are not the same quantity.
    # DECIDED: the cap is 128M because GOGC=100 above asks for it — the 78 MB heap goal plus
    # 8 MB of runtime plus the binary's text pages clears 96M — and for no other reason. The
    # 2026-09-18 marker here read "raising it buys nothing the process asks for and costs a
    # 456 MB host that already holds 320 MB in swap"; that held for the GOGC=50 pairing and
    # the cost side still does, which is why the extra is taken as compressed swap (see the
    # GOGC marker) rather than resident pages. The cap governs the cgroup; it reserves nothing.
    {{ resources('0.30', '128M', '0.02', '24M') }}

{{ external_networks() }}
