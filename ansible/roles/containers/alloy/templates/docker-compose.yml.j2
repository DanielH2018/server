{% from 'autokuma.yml.j2' import labels as kuma with context %}
{% from 'networks.yml.j2' import service_networks, external_networks with context %}
{% from 'resources.yml.j2' import resources %}
---

services:
  alloy:
    container_name: alloy
    # Tag AND digest, unlike the :latest@sha256 the Promtail role carried: Alloy is the shipper
    # the cluster pins by tag in roles/k8s/loki-homelab/defaults/main.yml, and keeping the two
    # on one version keeps one label contract. Renovate does not track roles/containers/** —
    # no manager's matchFileNames reaches it (renovate.json) — so this pin moves by hand when
    # the cluster's does. The digest is the arm64 manifest, resolved on daniel-pi 2026-09-02.
    image: grafana/alloy:v1.19.2@sha256:b8ec653c44235fbe910879145dac3597d66b0aaecf60bcbbe82580767771a839
    restart: unless-stopped
    command:
      - run
      - /etc/alloy/config.alloy
      # Alloy binds 127.0.0.1 by default; Prometheus scrapes this from the LAN.
      - --server.http.listen-addr=0.0.0.0:12345
      # The tailing cursor lives here — see the data volume below. NOT the image's own
      # /var/lib/alloy/data: that parent is 0770 uid 473 in the image, so uid 1000 cannot
      # traverse it to reach a bind mount inside, and Alloy dies at startup with
      # `mkdir /var/lib/alloy/data: permission denied` — every two minutes, on the first
      # deploy of this role (2026-09-02). Root never hits it, which is why the cluster
      # DaemonSet and the spike that sized this container both ran.
      - --storage.path=/data
      # Same reason Loki's own config sets analytics.reporting_enabled false: Pi-hole blocks
      # stats.grafana.org and each report would spend its retry budget on a name that never
      # resolves.
      - --disable-reporting
    # The image's own uid is 473, and setup_dirs.yml creates the bind-mount source owned by
    # the deploy user (1000). Left at the default, Alloy cannot write its positions under
    # --storage.path. With no positions to resume from, every restart re-reads every
    # container's log from the beginning and re-ships it. Matches the estate's PUID/PGID.
    # The flip side is the storage path above: as 1000 this process cannot enter the
    # image's /var/lib/alloy at all.
    user: "1000:1000"
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /tmp
    {{ service_networks() }}
    volumes:
      - ./config/config.alloy:/etc/alloy/config.alloy:ro
      # Positions must survive a restart. Without this the container re-reads every
      # container's log from the beginning on each recreate, which both duplicates lines in
      # Loki and spends the Pi's uplink re-sending them.
      - ./data:/data
      # The two host health crons' verdict lines (pi_health source). Read-only, and the same
      # path inside and out so the config's path needs no translation. No group_add: the
      # crons write as uid 1000 and this container already runs as 1000:1000.
      - /var/log/pi-health:/var/log/pi-health:ro
    environment:
      # A HARD ceiling on the Go heap, not a hint. The Go runtime will happily grow to whatever
      # the cgroup allows and only collect under pressure; GOMEMLIMIT makes it collect early
      # instead, which is the right trade on a host with ~165 MiB free — CPU is cheaper here
      # than RAM. Measured 2026-09-02 under this limit: 34-43 MiB RSS across twelve 5-minute
      # samples of the spike hour (49 MiB in its first minute), no OOM kill, against
      # Promtail's 15-22 MiB for the same two sources.
      - GOMEMLIMIT=48MiB
      # One GC-visible processor. Alloy defaults GOMAXPROCS to the 4 cores on this Pi and
      # spawns a worker set to match, which is pure contention for a job this small on a box
      # that already showed RCU stalls from fork rate.
      - GOMAXPROCS=1
    # NO healthcheck, and this is a correction rather than an omission — inherited from the
    # Promtail role, where a wget probe of /ready shipped and could never work: that image
    # carried no wget, curl, nc or busybox, so every probe exited -1 with "executable file
    # not found in $PATH", the container went `unhealthy` after its third failure, and autoheal
    # restarted it on a loop. Alloy's image (Ubuntu-based, the alloy binary and libc) has no
    # HTTP client either. The general rule stands: on this host a healthcheck is only
    # available to an image that ships an HTTP client, and `test:` failing to EXEC is
    # indistinguishable from the service being down.
    #
    # Liveness is covered from outside instead, and better: Prometheus scrapes 12345 as
    # `alloy-pi`, so a dead shipper is `up == 0` on a target that check_cluster_targets
    # already watches. That check sees a wedged shipper this probe could not have.
    # Published on the LAN IP so Prometheus can scrape Alloy's own metrics — dropped
    # entries, batch retries and the send latency that says whether shipping is keeping up.
    # A log shipper that silently stops is the failure this port exists to make visible.
    ports:
      - "{{ server_ip }}:12345:12345/tcp"
    labels:
      {{ kuma(container_item.name) }}

      # Watchtower
      - "com.centurylinklabs.watchtower.depends-on=docker-proxy"
    # 96M is the containment cap, ~2x the 48 MiB GOMEMLIMIT above so a spike is collected
    # rather than OOM-killed. Startup under the 0.30 CPU cap takes minutes on this host (the
    # binary is large and arm64 decompression is slow); it is not a hang.
    {{ resources('0.30', '96M', '0.02', '24M') }}

{{ external_networks() }}
