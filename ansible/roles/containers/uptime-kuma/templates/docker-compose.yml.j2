{% from 'traefik.yml.j2' import labels with context %}
{% from 'autokuma.yml.j2' import labels as kuma with context %}
{% from 'networks.yml.j2' import service_networks, external_networks with context %}
{% from 'resources.yml.j2' import resources %}
{% from 'healthcheck.yml.j2' import healthcheck %}
---

services:
  uptime-kuma:
    image: louislam/uptime-kuma:2.4.0
    container_name: uptime-kuma
    volumes:
      - ./data:/app/data
    restart: unless-stopped
    cap_drop:
      - ALL
    cap_add:
      # Ping monitors (daniel-pi-host) need raw ICMP sockets; with cap_drop ALL the
      # ping binary fails with "operation not permitted" and the monitor can never
      # be up. NET_RAW is the narrow, standard grant for monitoring containers.
      - NET_RAW
    security_opt:
      - no-new-privileges:true
    {{ service_networks() }}
    labels:
      {# Generate labels(container, port, docker_network, use_authelia) -#}
      {{ labels(
          container_item.hostname | default(container_item.name),
          container_item.port | string,
          (container_item.networks | default([docker_network]))[0],
          container_item.use_authelia
        )
      }}
      # Disable watchtower update — pinned + Renovate-managed
      - "com.centurylinklabs.watchtower.enable=false"
      {{ kuma(container_item.name) }}
      # AutoKuma-managed Discord notification (id: discord == kuma_notification_id); the kuma()
      # macro links every monitor to it via notification_name_list. Webhook in secrets.yml.
      # Defining notifications via labels is flagged experimental by AutoKuma.
      - "kuma.discord.notification.name=Homelab Alerts"
      - "kuma.discord.notification.active=true"
      - 'kuma.discord.notification.config={"type":"discord","discordWebhookUrl":"{{ monitor_discord_webhook_url }}","discordUsername":"Uptime Kuma"}'
      # AutoKuma-managed EMAIL notification (id: email) — the INDEPENDENT 2nd channel for the
      # alert-delivery SPOF. The whole fleet funnels through the Discord webhook above, and the
      # Discord Delivery monitor that catches a dead webhook can only deliver its own `down` THROUGH
      # that dead webhook (circular). This email notification is attached ONLY to Discord Delivery
      # (extra_notifications=['email'] on its kuma() call, monitor-bridge role), so a rotated/broken
      # Discord webhook still pages via Gmail. Gmail SMTP, implicit TLS on :465; app-password +
      # address (reuses the acme {{ '{{ email }}' }} var) in secrets.yml. Like the discord one above,
      # label-defined notifications are AutoKuma-experimental (harmless ~5s "Updating notification" churn).
      - "kuma.email.notification.name=Homelab Alerts (Email)"
      - "kuma.email.notification.active=true"
      - 'kuma.email.notification.config={"type":"smtp","smtpHost":"smtp.gmail.com","smtpPort":465,"smtpSecure":true,"smtpUsername":"{{ email }}","smtpPassword":"{{ smtp_notify_app_password }}","smtpFrom":"{{ email }}","smtpTo":"{{ email }}","customSubject":"[Homelab] Uptime Kuma alert"}'
      # daniel-pi monitors (static, defined here like the notification above): AutoKuma
      # only reads the SERVER's docker socket, so the kuma() labels rendered on the Pi's
      # own compose files are never seen. Probe the Pi's LAN-bound UIs over HTTP instead
      # (expose_mode: lan already publishes them on the Pi's LAN IP — no new exposure),
      # plus a ping for the host itself.
      - "kuma.daniel-pi-host.ping.name=Daniel Pi Host"
      - "kuma.daniel-pi-host.ping.hostname={{ hostvars['daniel-pi'].server_ip }}"
      - "kuma.daniel-pi-host.ping.interval=60"
      - "kuma.daniel-pi-host.ping.maxretries=2"
      - 'kuma.daniel-pi-host.ping.notification_name_list=["{{ kuma_notification_id }}"]'
      {{ kuma('daniel-pi-glances', name='Daniel Pi Glances', monitor_type='http',
              url='http://' ~ hostvars['daniel-pi'].server_ip ~ ':61208') }}
      {{ kuma('daniel-pi-dozzle', name='Daniel Pi Dozzle', monitor_type='http',
              url='http://' ~ hostvars['daniel-pi'].server_ip ~ ':8080') }}
      {{ kuma('daniel-pi-wg-easy', name='Daniel Pi WG Easy', monitor_type='http',
              url='http://' ~ hostvars['daniel-pi'].server_ip ~ ':51821') }}
      # (daniel-pi-portainer-agent's port monitor retired 2026-08-09 with the agent —
      # slice-7 Phase B, the Portainer cohort.)
      # k3s ingress monitors (static, same reason as the Pi block above): AutoKuma reads only the
      # SERVER's docker socket, and the k8s workloads on daniel-box have no container here at all,
      # so the kuma() labels their compose templates would carry are never seen. Probe the MetalLB
      # ingress VIP over the LAN instead — same path a browser takes, through real DNS.
      #
      # auth-k8s answers 200: it is the login portal, unauthenticated by definition. A green here
      # means the VIP holds, Traefik routes, the LE cert validates and Authelia is serving.
      {{ kuma('auth-k8s', name='k3s Authelia Portal', monitor_type='http',
              url='https://auth' ~ k8s_hostname_suffix ~ '.local.' ~ domain) }}
      # A protected route answers 302 to an unauthenticated prober — that redirect IS the signal:
      # it proves the route exists, the forward-auth middleware is attached, and Authelia issued a
      # challenge. Kuma accepts 200-299 by default, so the expected code has to be stated or this
      # monitor is permanently red.
      #
      # max_redirects=0 is load-bearing, not tuning. Kuma FOLLOWS redirects by default, so it would
      # chase the 302 to the Authelia portal and grade the resulting 200 — which is both the wrong
      # assertion and a dangerous one: if the forward-auth middleware ever silently detached,
      # bento-pdf would answer 200 directly and a follow-redirects monitor would stay green over an
      # ungated service. Refusing to follow is what makes "302" mean "still protected".
      #
      # NOTE what this does NOT prove: forward-auth runs BEFORE the backend, so bento-pdf itself
      # could be dead and this stays green. Backend health is only visible from inside the cluster,
      # which nothing on this host can currently see — see docs/b2-transaction-cap-monitoring-gaps.md,
      # same cross-host gap as the Longhorn backup target.
      {{ kuma('bento-pdf-k8s', name='k3s Ingress (bento-pdf)', monitor_type='http',
              url='https://bento-pdf' ~ k8s_hostname_suffix ~ '.local.' ~ domain,
              accepted_statuscodes=['302'], max_redirects=0) }}
      # Slice 2 migrations. Each k8s copy runs alongside its Docker twin, and the twin keeps its
      # own AutoKuma-generated monitor — so these watch the NEW copy specifically. Without them a
      # migrated service can be dead for hours while its Docker monitor stays green, which is the
      # blind spot the whole coexistence period would otherwise carry. Deleted when slice 3
      # reworks the monitor-generation path.
      #
      # littlelink is the public landing page (use_authelia: false), so 200 is the expected code
      # and no accepted_statuscodes override is needed. It is also the only one of these whose
      # green means the BACKEND is serving, not merely that the route exists.
      {{ kuma('littlelink-k8s', name='k3s littlelink', monitor_type='http',
              url='https://www' ~ k8s_hostname_suffix ~ '.local.' ~ domain) }}
      {{ kuma('speedtest-k8s', name='k3s speedtest', monitor_type='http',
              url='https://speedtest' ~ k8s_hostname_suffix ~ '.local.' ~ domain,
              accepted_statuscodes=['302'], max_redirects=0) }}
      {{ kuma('freshrss-k8s', name='k3s FreshRSS', monitor_type='http',
              url='https://freshrss' ~ k8s_hostname_suffix ~ '.local.' ~ domain,
              accepted_statuscodes=['302'], max_redirects=0) }}
      # healthchecks is probed on its /ping/ bypass rather than its UI, and that is deliberate:
      # /ping/ skips forward-auth, so the request reaches the Django app itself and a 404 for an
      # unknown UUID proves the BACKEND is alive. A 302 on the UI would only prove the route and
      # the middleware, which is exactly the limitation called out for bento-pdf above.
      #
      # It doubles as a guard on the bypass. If the ping route were ever lost, this would answer
      # 302 instead of 404 and go red — and a silently-gated /ping/ turns every check in
      # healthchecks red while the jobs themselves keep succeeding.
      {{ kuma('healthchecks-k8s', name='k3s healthchecks', monitor_type='http',
              url='https://healthchecks' ~ k8s_hostname_suffix ~ '.local.' ~ domain ~ '/ping/00000000-0000-0000-0000-000000000000',
              accepted_statuscodes=['404'], max_redirects=0) }}
      # livesync has no forward-auth (the Obsidian client can't pass 2FA), so 401 is the healthy
      # answer and a strong one: CouchDB itself produced it, having been reached through the
      # route, so this proves the backend the way littlelink's 200 does rather than merely
      # proving a middleware answered. 302 would mean Authelia had crept in front of a client
      # that cannot satisfy it, and 502 means the pod is gone.
      {{ kuma('livesync-k8s', name='k3s LiveSync', monitor_type='http',
              url='https://livesync' ~ k8s_hostname_suffix ~ '.local.' ~ domain ~ '/',
              accepted_statuscodes=['401'], max_redirects=0) }}
      # Slice 5. The cluster broker is raw TCP behind a pinned MetalLB VIP, so a `port` probe
      # is the whole truth available from this host: the listener answering on the VIP is
      # exactly what z2m and HA depend on. Auth can't be probed without embedding the MQTT
      # password here.
      {{ kuma('mosquitto-k8s', name='k3s Mosquitto (VIP)', monitor_type='port',
              hostname=mqtt_k8s_vip, port=1883) }}
      {{ kuma('zigbee2mqtt-k8s', name='k3s Zigbee2MQTT', monitor_type='http',
              url='https://zigbee2mqtt' ~ k8s_hostname_suffix ~ '.local.' ~ domain,
              accepted_statuscodes=['302'], max_redirects=0) }}
      # Moved here from the Docker z2m's labels at its B2 cutover (same monitor id, so AutoKuma
      # keeps the monitor and its history) — the coordinator is infra, not a container, and it
      # needs watching regardless of where z2m runs. Pages even if HA/MQTT are down, catching an
      # EHOSTUNREACH like the 2026-06-18 unplug.
      {{ kuma('slzb-coordinator', port=6638, name='SLZB-06M Coordinator', hostname=slzb_ip, monitor_type='port') }}
      {# CrowdSec Home Allowlist: pushed directly by daniel-box's every-5-min updater cron
         (k8s/crowdsec role) since slice-6 B2 — `cscli allowlists` is LAPI-machine-only, so
         the cron follows the LAPI into the cluster and the monitor-bridge state-file hop is
         gone. Label lives HERE (not monitor-bridge) purely to keep the monitor provisioned. -#}
      {{ kuma('crowdsec-home-allowlist', monitor_type='push', name='CrowdSec Home Allowlist', interval=600, max_retries=0, push_token=monitor_bridge_home_allowlist_push_token) }}
      {# CrowdSec dashboard moved into the cluster engine pod at B2c (Docker role archived);
         Authelia-gated, so an unauthenticated probe sees the 302 to the portal — same
         expectation as the other authelia'd -k8s monitors. -#}
      {{ kuma('crowdsec-dashboard-k8s', name='k3s CrowdSec Dashboard', monitor_type='http',
              url='https://crowdsec-k8s.local.' ~ domain ~ '/', accepted_statuscodes=['302']) }}
      # HA answers 200 on / (its login page — no Authelia on this route by design, so no 302
      # dance). Probing the -k8s name watches the cluster copy specifically; the companion-app
      # path (the unsuffixed Cloudflare-proxied name via the bridge) shares every hop past
      # daniel-server's Traefik.
      {{ kuma('home-assistant-k8s', name='k3s Home Assistant', monitor_type='http',
              url='https://home-assistant' ~ k8s_hostname_suffix ~ '.local.' ~ domain) }}
      # healthchecks' user-facing hostname. Its old monitor was `docker`-type, queried through
      # the socket, so retiring the container took it away entirely rather than merely leaving
      # it stale.
      #
      # Probed on the /ping/ bypass, which is the same route every monitored cron uses — so
      # this watches the path that actually matters, end to end, with no forward-auth in the
      # way. 404 is the healthy answer: Django returning "no such check" for an all-zero UUID
      # proves the app ran. A 400 would mean ALLOWED_HOSTS no longer lists the bridged
      # hostname, and a 302 would mean the bypass was lost and every cron is now being sent to
      # a login page.
      {{ kuma('healthchecks-bridge', name='healthchecks (via bridge)', monitor_type='http',
              url='https://healthchecks.local.' ~ domain ~ '/ping/00000000-0000-0000-0000-000000000000',
              accepted_statuscodes=['404'], max_redirects=0) }}
      # freshrss's user-facing hostname, probed on its bridge_probe_path for the same reason
      # speedtest is: on `/` the edge answers 302 before the bridge is consulted. /api/greader.php
      # returns the bare string `OK`, so a 200 here means PHP ran on the other side of the bridge.
      {% set freshrss_k8s = (hostvars['daniel-box'].containers_list | selectattr('name', 'equalto', 'freshrss') | first) -%}
      {{ kuma('freshrss-bridge', name='FreshRSS (via bridge)', monitor_type='http',
              url='https://freshrss.local.' ~ domain ~ freshrss_k8s.bridge_probe_path,
              max_redirects=0) }}
      # karakeep is Authelia-gated, so 302 is the edge answering and this proves the route and
      # the middleware, not the app — the bento-pdf limitation. Its four workloads are watched
      # from inside the cluster instead, by liveness probes; what this adds is the outside view.
      {{ kuma('karakeep-k8s', name='k3s karakeep', monitor_type='http',
              url='https://karakeep' ~ k8s_hostname_suffix ~ '.local.' ~ domain,
              accepted_statuscodes=['302'], max_redirects=0) }}
      # karakeep's user-facing hostname, after its Docker copy was retired behind the bridge.
      #
      # Probed on /api/health, which sits under the /api/ bypass the browser extension and mobile
      # app already need — so this reuses an existing hole rather than adding a probe route. It
      # answers 200 unauthenticated (measured; /api/v1/* return 401 beside it), which makes this
      # end-to-end like littlelink's: the 200 came from the app, having crossed the edge router,
      # the bridge transport, the cluster's Traefik and the pod. A 302 would mean the bypass
      # router stopped matching and Authelia caught it.
      #
      # ALERTING GAP, deliberate and recorded: karakeep-chrome, karakeep-meilisearch and
      # karakeep-time-tagger had `docker`-type AutoKuma monitors that died with their containers.
      # In-cluster their liveness probes restart them, which is better than autoheal was, but
      # nothing pages — a crash-looping Meilisearch degrades search silently and this monitor
      # stays green. Folded into the pending "Kuma monitors for unrouted k8s workloads" item,
      # which already covers registry and cloudflare-ddns; see the slice-2 doc.
      {{ kuma('karakeep-bridge', name='karakeep (via bridge)', monitor_type='http',
              url='https://karakeep.local.' ~ domain ~ '/api/health',
              accepted_statuscodes=['200'], max_redirects=0) }}
      # livesync's user-facing hostname, after its Docker copy was retired behind the bridge. Its
      # old monitor was AutoKuma-generated from the container, so it went with it.
      #
      # Probed on bridge_probe_path, and this one is end-to-end in a way the other gated services'
      # probes have to be engineered into: CouchDB answers 401 to any unauthenticated request
      # rather than redirecting, so a 401 here was produced by the app itself after crossing the
      # bridge transport and the cluster's Traefik. A 302 would mean Authelia had somehow been
      # attached to a client that cannot satisfy it, and a 502 means the pod is gone.
      {% set livesync_k8s = (hostvars['daniel-box'].containers_list | selectattr('name', 'equalto', 'livesync') | first) -%}
      {{ kuma('livesync-bridge', name='LiveSync (via bridge)', monitor_type='http',
              url='https://livesync.local.' ~ domain ~ livesync_k8s.bridge_probe_path,
              accepted_statuscodes=['401'], max_redirects=0) }}
      # littlelink's user-facing hostname, after its Docker copy was retired behind the bridge.
      #
      # This is the bridge's canary, and the only monitor here that earns that on its own.
      # littlelink is public with no forward-auth, so nothing intercepts the probe: a 200 comes
      # from the app, having crossed the edge router, the bridge transport, the cluster's
      # Traefik and the pod. Every gated service needs a dedicated bridge_probe_path to say as
      # much; this one says it for free, so if the bridge mechanism itself breaks, this goes red
      # whether or not the gated services' probe paths are still configured correctly.
      {{ kuma('littlelink-bridge', name='littlelink (via bridge)', monitor_type='http',
              url='https://www.local.' ~ domain) }}
      # speedtest's user-facing hostname, which AutoKuma stopped providing when the Docker copy
      # was retired behind the strangler bridge.
      #
      # It probes the LAN-only bridge_probe_path rather than `/`, and that is the difference
      # between a monitor and a decoration. On `/`, Authelia answers 302 at the edge BEFORE the
      # bridge is consulted, so the monitor would stay green whether or not daniel-server could
      # still reach the cluster. The probe path skips forward-auth, so a 200 here means the
      # request crossed the bridge transport, the cluster's Traefik and the app — the one thing
      # no other monitor in this file can see.
      #
      # The path comes from daniel-box's inventory, the same place the router's rule does, so
      # the two cannot drift into a monitor probing a path no router matches.
      {% set speedtest_k8s = (hostvars['daniel-box'].containers_list | selectattr('name', 'equalto', 'speedtest') | first) -%}
      {{ kuma('speedtest-bridge', name='speedtest (via bridge)', monitor_type='http',
              url='https://speedtest.local.' ~ domain ~ speedtest_k8s.bridge_probe_path,
              max_redirects=0) }}
      # ical-proxy's cluster copy (slice-7 Phase C). Kuma runs on daniel-server, whose egress
      # IP is exactly what the route's ClientIP guard admits — the probe exercises the whole
      # chain (VIP, route, pod, an actual feed fetch), replacing the docker-type monitor that
      # died with the container.
      {{ kuma('ical-proxy-k8s', name='iCal Proxy k8s', monitor_type='http',
              url='https://ical-proxy' ~ k8s_hostname_suffix ~ '.local.' ~ domain ~ '/calendar1.ics') }}
      # The cluster Pi-hole's DNS VIP (slice-6 B3). A real query — resolve the LAN wildcard
      # via 10.0.0.243 — so up means MetalLB + FTL + the dnsmasq ConfigMap all answered, not
      # merely that something accepted a TCP connection. The Docker Pi-hole keeps its own
      # docker-type monitor through the drain; this one is what survives its retirement.
      {{ kuma('pihole-k8s-dns', name='Pi-hole k8s DNS', monitor_type='dns',
              hostname='homepage.local.' ~ domain, dns_resolve_server=dns_k8s_vip) }}
      # cloudflare-ddns dead-man's-switches, moved here from the Docker role's compose when
      # that copy was retired (slice 2, first cutover). AutoKuma derives monitors from the
      # labels on a running container, so deleting the Docker copy deletes its monitors — and
      # the k3s copy would have gone on pushing to an id that no longer existed, which looks
      # exactly like everything being fine.
      #
      # Same ids and same tokens as the labels they replace: the k3s Deployment reads those
      # tokens from SOPS, so changing them here would mean redeploying it for no reason. Only
      # ONE source may define a given id at a time, which is why these land after the Docker
      # container is gone rather than alongside it.
      {{ kuma('cloudflare-ddns-proxied-push', name='Cloudflare DDNS Proxied', monitor_type='push', interval=300, max_retries=0, push_token=cloudflare_ddns_proxied_push_token) }}
      {{ kuma('cloudflare-ddns-direct-push', name='Cloudflare DDNS Direct', monitor_type='push', interval=300, max_retries=0, push_token=cloudflare_ddns_direct_push_token) }}
      # k3s backup plane: the cluster's ONLY backup path, and until 2026-08-02 it had no monitor
      # at all — Longhorn's backup target went unavailable for 13h and nothing noticed. It
      # surfaced only because Kopia shares the same B2 account and tripped its own freshness
      # check; had the transaction cap been hit by Longhorn alone, nothing would have alerted.
      #
      # Push, not poll: monitor-bridge reads daniel-server's Docker socket and cannot see the
      # cluster, so daniel-box's own cron pushes here (k3s role,
      # templates/longhorn-backup-health.sh.j2) — the same shape as the Pi crons above.
      # interval 1200 = 2x the */10 cron, so a dead cron or a dead daniel-box also trips this.
      # Unwrapped on purpose: test_push_monitor_retries greps per LINE for max_retries=0, so a
      # wrapped kuma() call reads as missing it. Same reason the Pi push monitors above are one-liners.
      {{ kuma('longhorn-backup', name='k3s Longhorn Backup', monitor_type='push', interval=1200, max_retries=0, push_token=longhorn_backup_push_token) }}
      # daniel-box root disk: Longhorn replicas, images and etcd all live on the root LV, and no
      # node-exporter runs there, so monitor-bridge's Prometheus check_disk cannot see it. Pushed
      # by daniel-box's own cron (k3s role, templates/disk-health.sh.j2); pages at 75% used — the
      # line where Longhorn (storageMinimalAvailablePercentage=25) stops scheduling replicas.
      {{ kuma('daniel-box-disk', name='daniel-box Disk', monitor_type='push', interval=1200, max_retries=0, push_token=daniel_box_disk_push_token) }}
      # k3s telemetry stack: watches the thing that watches everything else. A dead collector,
      # a broken hostPort DNAT, or a backend rejecting writes all present as "no data" — which
      # is indistinguishable from "Claude Code was idle" without this. Pushed by daniel-box's
      # own cron (k8s/claude-otel role, templates/telemetry-health.sh.j2) for the same reason
      # as the backup monitor above: monitor-bridge cannot see the cluster.
      # interval 1200 = 2x the */10 cron, so a dead cron or a dead daniel-box also trips this.
      {{ kuma('claude-otel-health', name='k3s Telemetry Stack', monitor_type='push', interval=1200, max_retries=0, push_token=claude_otel_push_token) }}
      # configarr's nightly TRaSH-guide sync. Moved here from monitor-bridge on 2026-08-08 (slice 4,
      # B7a) along with the sync itself: it is a k8s CronJob now, and the state file monitor-bridge
      # used to read lived beside the sync on daniel-server. The push token is UNCHANGED, so this is
      # the same Kuma monitor with its history intact — only the pusher moved (k8s/configarr role,
      # templates/configarr-health.sh.j2, which reads the last Job through the read-only kubeconfig).
      # interval 1200 = 2x the */10 cron, so a dead cron or a dead daniel-box also trips this.
      {{ kuma('configarr', name='Configarr Sync', monitor_type='push', interval=1200, max_retries=0, push_token=monitor_bridge_configarr_push_token) }}
      # janitorr's scheduled-cleanup errors. Moved here from monitor-bridge on 2026-08-08 (slice 4,
      # B7b) with the workload: it counted ERROR lines in Loki and read uptime from
      # container_start_time_seconds, and cluster pod logs reach neither. Same push token, so this
      # is the same monitor with its history — only the pusher moved (k8s/janitorr role,
      # templates/janitorr-health.sh.j2). janitorr DELETES REAL MEDIA and its healthcheck only
      # proves the JVM is alive, so this is the only signal that a cleanup threw.
      # interval 1200 = 2x the */10 cron, so a dead cron or a dead daniel-box also trips this.
      {{ kuma('monitor-bridge-janitorr', name='Janitorr Errors', monitor_type='push', interval=1200, max_retries=0, push_token=monitor_bridge_janitorr_push_token) }}
      # The fake-remux detector + reconciler, moved here from monitor-bridge on 2026-08-08 (slice
      # 4, B7c) with the crons themselves. Their {ts,ok,msg} state files are host-local and the
      # crons now run on daniel-box, so a cron there pushes both through a generic state-file
      # reader. Same tokens, so both monitors keep their history.
      #
      # Intervals differ because the crons do: the scan is daily (26h staleness gate), the
      # reconciler every 20 min (1.2h gate). Both are pushed by the same */10 cron, so 1200 keeps
      # the "dead cron / dead daniel-box" watchdog on each.
      {{ kuma('autofix-fake-remux', name='Fake Remux Scan', monitor_type='push', interval=1200, max_retries=0, push_token=monitor_bridge_fake_remux_push_token) }}
      {{ kuma('autofix-fake-remux-replace', name='Fake Remux Replace', monitor_type='push', interval=1200, max_retries=0, push_token=monitor_bridge_fake_remux_replace_push_token) }}
      # Pi SD-card health: SD cards have no SMART, so a dying card only announces
      # itself via ext4 errors. The Pi's pi-sd-health.sh cron (optimize_pi role)
      # pushes errors_count every 5 min through the LAN-bypassed push API
      # (authelia: ^/api/push/ on this .local host); interval 600 = 2x the cron,
      # so the push watchdog also catches a dead cron/host.
      {{ kuma('daniel-pi-sd-health', name='Daniel Pi SD Health', monitor_type='push', interval=600, max_retries=0, push_token=pi_sd_health_push_token) }}
      # Pi container-recovery: autoheal + docker-proxy have no AutoKuma coverage (it reads
      # the SERVER socket only), so their death is otherwise silent — a dead autoheal stops
      # recovering unhealthy Pi containers, and a dead docker-proxy leaves dozzle serving 200
      # (SPA shell) so its http monitor stays green. The Pi's pi-recovery-health.sh cron
      # (optimize_pi role) pushes both containers' running-state every 5 min through the same
      # LAN-bypassed push API; interval 600 = 2x the cron, so a dead cron/host also trips it.
      {{ kuma('daniel-pi-recovery', name='Daniel Pi Recovery', monitor_type='push', interval=600, max_retries=0, push_token=pi_recovery_push_token) }}
      # Secret rotation: a daily server cron (secret-rotation-audit.sh, initial_setup) runs
      # scripts/secret_rotation.py audit --push — down when any secret is past its
      # per-tier rotation window OR an unregistered secret exists (run `sync`). interval
      # 90000s (25h) = 1 day + slack, so a dead audit cron also trips the push watchdog.
      {{ kuma('secret-rotation', name='Secret Rotation', monitor_type='push', interval=90000, max_retries=0, push_token=secret_rotation_push_token) }}
    # Resource caps for blast-radius containment (M1); tune from cAdvisor/Grafana.
    {{ resources('0.50', '512M', '0.05', '64M') }}

  # AutoKuma lives in this stack so a redeploy of uptime-kuma (recreate: always)
  # also recreates autokuma, refreshing its Kuma Socket.IO session. It needs
  # uptime-kuma (API) and docker-proxy (read-only socket) reachable on this network.
  autokuma:
    image: ghcr.io/bigboot/autokuma:latest
    container_name: autokuma
    restart: unless-stopped
    # Run as 1000:1000 (owner of ./autokuma-data) so it can create its DB without
    # needing root + DAC_OVERRIDE — keeps cap_drop: [ALL] effective.
    user: "{{ puid }}:{{ pgid }}"
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    # Read-only rootfs: `docker diff` shows only its ./autokuma-data:/data volume (the DB),
    # zero rootfs writes — no tmpfs needed.
    read_only: true
    depends_on:
      uptime-kuma:
        condition: service_started
        # Recreating uptime-kuma invalidates AutoKuma's Socket.IO session (endless
        # "You are not logged in" sync errors). Deploys are recreate:auto (only the
        # changed service is recreated), so the old "same stack = recreated together"
        # assumption no longer holds — restart the sidecar with its dependency.
        restart: true
    # The Kuma ADMIN password (AutoKuma authenticates as the human admin — it can silence the whole
    # fleet's alerting) is exported from a 0600 file-mount by this entrypoint wrapper instead of an
    # inline AUTOKUMA__KUMA__PASSWORD env, so it stays out of the container Env the read-only
    # docker-proxy exposes to every monitoring-net neighbor (2026-07-15 review H1). AutoKuma has no
    # working file-ref for it. `$$(cat …)` strips any trailing newline; `exec "$$@"` keeps autokuma
    # as PID 1 (the healthcheck greps /proc/1/comm); `$$` doubled so Compose doesn't interpolate.
    entrypoint:
      - /usr/bin/sh
      - -c
      - 'export AUTOKUMA__KUMA__PASSWORD="$$(cat /run/secrets/kuma_password)"; exec "$$@"'
      - --
    command: ["autokuma"]
    environment:
      - AUTOKUMA__KUMA__URL=http://uptime-kuma:3001
      - AUTOKUMA__KUMA__USERNAME={{ uptime_kuma_username }}
      - AUTOKUMA__DOCKER__HOSTS=tcp://docker-proxy:2375
      - AUTOKUMA__DB_PATH=/data/autokuma.db
    volumes:
      - ./autokuma-data:/data
      - ./autokuma-secrets/kuma_password:/run/secrets/kuma_password:ro
    {{ service_networks() }}
    {{ healthcheck('["CMD", "bash", "-c", "cat /proc/1/comm | grep -q autokuma"]', timeout='5s', start_period='10s') }}
    labels:
      - "com.centurylinklabs.watchtower.depends-on=docker-proxy,uptime-kuma"
      {{ kuma('autokuma') }}
    # Resource caps for blast-radius containment (M1); tune from cAdvisor/Grafana.
    {{ resources('0.50', '256M', '0.05', '32M') }}

{{ external_networks() }}
