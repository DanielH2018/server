{% from 'autokuma.yml.j2' import labels as kuma with context %}
{% from 'networks.yml.j2' import service_networks, external_networks with context %}
{% from 'resources.yml.j2' import resources %}
services:
  ddns-proxied:
    image: favonia/cloudflare-ddns:latest
    container_name: cloudflare-ddns-proxied
    restart: unless-stopped
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    environment:
      # Zone-edit token file-mounted (below), NOT inline, so it stays out of the container Env that
      # the read-only docker-proxy exposes to every monitoring-net neighbor (2026-07-15 review H1).
      - CLOUDFLARE_API_TOKEN_FILE=/run/secrets/cf_dns_token
      - DOMAINS={{ domain }}
      - PROXIED=true
      - IP6_PROVIDER=none
      # Dead-man's-switch: ping a Kuma push monitor after each successful update.
      # Kuma lives in the cluster now — the old `http://uptime-kuma:3001` same-net URL
      # died with the Docker container. The -k8s .local name resolves to the ingress
      # VIP via Pi-hole from inside a container; /api/push carries no Authelia (LAN
      # bypass on the k8s route). Token lives in secrets.yml.
      - UPTIMEKUMA=https://uptime-kuma{{ k8s_hostname_suffix }}.local.{{ domain }}/api/push/{{ cloudflare_ddns_proxied_push_token }}
    volumes:
      - ./data/cf_dns_token:/run/secrets/cf_dns_token:ro
    {{ service_networks() }}
    labels:
      {{ kuma('cloudflare-ddns-proxied') }}
      {{ kuma('cloudflare-ddns-proxied-push', monitor_type='push', interval=300, push_token=cloudflare_ddns_proxied_push_token) }}
    # Resource caps for blast-radius containment (M1); tune from cAdvisor/Grafana.
    {{ resources('0.25', '64M', '0.05', '16M') }}
  ddns-direct:
    image: favonia/cloudflare-ddns:latest
    container_name: cloudflare-ddns-direct
    restart: unless-stopped
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    environment:
      # Zone-edit token file-mounted (below), NOT inline, so it stays out of the container Env that
      # the read-only docker-proxy exposes to every monitoring-net neighbor (2026-07-15 review H1).
      - CLOUDFLARE_API_TOKEN_FILE=/run/secrets/cf_dns_token
      # terraria and valheim (reactivated onto k3s 2026-08-13) are live; minecraft is still
      # archived, and its record stays out — publishing an A record for a game server that
      # does not exist points the unproxied home IP at nothing and needlessly exposes the
      # raw IP. Kept in step with the k8s copy: this role is the rollback, so a domain
      # missing here is a domain that silently stops updating if it is ever used.
      - DOMAINS=terraria.{{ domain }},valheim.{{ domain }}
      - PROXIED=false
      - IP6_PROVIDER=none
      # Dead-man's-switch: ping a Kuma push monitor after each successful update.
      # Kuma lives in the cluster now — the old `http://uptime-kuma:3001` same-net URL
      # died with the Docker container. The -k8s .local name resolves to the ingress
      # VIP via Pi-hole from inside a container; /api/push carries no Authelia (LAN
      # bypass on the k8s route). Token lives in secrets.yml.
      - UPTIMEKUMA=https://uptime-kuma{{ k8s_hostname_suffix }}.local.{{ domain }}/api/push/{{ cloudflare_ddns_direct_push_token }}
    volumes:
      - ./data/cf_dns_token:/run/secrets/cf_dns_token:ro
    {{ service_networks() }}
    labels:
      {{ kuma('cloudflare-ddns-direct') }}
      {{ kuma('cloudflare-ddns-direct-push', monitor_type='push', interval=300, push_token=cloudflare_ddns_direct_push_token) }}
    # Resource caps for blast-radius containment (M1); tune from cAdvisor/Grafana.
    {{ resources('0.25', '64M', '0.05', '16M') }}

{{ external_networks() }}
