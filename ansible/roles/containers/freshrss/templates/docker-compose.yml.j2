{% from 'autokuma.yml.j2' import labels as kuma with context %}
{% from 'networks.yml.j2' import service_networks, external_networks with context %}
{% from 'resources.yml.j2' import resources %}
{% from 'expose.yml.j2' import web_ui_labels, web_ui_ports_block with context %}
---

services:
  freshrss:
    container_name: freshrss
    # Digest verified 2026-08-30 as a multi-arch INDEX carrying arm64.
    image: lscr.io/linuxserver/freshrss:latest@sha256:7ba33d8d9721c2a27bba7780e6072c004c477b9ad27ee770eab5d60c834de0d0
    restart: unless-stopped
    environment:
      - PUID={{ puid }}
      - PGID={{ pgid }}
      - TZ={{ tz }}
    volumes:
      # Bind mount, not a named volume: ./config holds the SQLite feed DB and the
      # unpacked extensions, and it is what the nightly pull from the cluster copies.
      # This directory IS the only copy of FreshRSS's state once the cluster role is
      # retired — the backup slice must be armed before that happens.
      - ./config:/config
    # LSIO image: cap_drop ALL plus the s6 privilege-drop set and NET_BIND_SERVICE for :80.
    # Verify on first deploy (docker logs freshrss) — add back caps if it fails to start.
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETUID
      - SETGID
      - FOWNER
      - DAC_OVERRIDE
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
    {{ service_networks() }}
      - internal
    healthcheck:
      test: ["CMD-SHELL", "curl --fail -s http://localhost:80/ || exit 1"]
      interval: {{ container_healthcheck_interval | default('30s') }}
      timeout: 10s
      retries: 3
      start_period: 30s
    labels:
{{ web_ui_labels('80') }}
      {{ kuma(container_item.name) }}
{{ web_ui_ports_block('80') }}
    # Resource caps for blast-radius containment; tune from cAdvisor/Grafana.
    {{ resources('1.0', '512M', '0.10', '64M') }}

  feed-cache:
    container_name: freshrss-feed-cache
    # Digest verified 2026-08-30 as a multi-arch INDEX carrying arm64.
    image: nginx:alpine@sha256:4a73073bd557c65b759505da037898b61f1be6cbcc3c2c3aeac22d2a470c1752
    restart: unless-stopped
    # nginx binds :80 and forks workers — needs NET_BIND_SERVICE + SETUID/SETGID/CHOWN.
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETUID
      - SETGID
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
    # Read-only rootfs: root nginx writes only its pidfile (/var/run) — the cache is on the
    # feed_cache named volume (use_temp_path=off) and logs go to the image's stdout symlinks.
    read_only: true
    tmpfs:
      - /var/run
      - /tmp
    volumes:
      - ./nginx-feed-cache.conf:/etc/nginx/conf.d/default.conf:ro
      - feed_cache:/var/cache/nginx
    networks:
      - internal
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1/health"]
      interval: {{ container_healthcheck_interval | default('30s') }}
      timeout: 10s
      retries: 3
      start_period: 30s
    labels:
      {{ kuma('freshrss-feed-cache', name='FreshRSS Cache') }}
    # Resource caps for blast-radius containment; tune from cAdvisor/Grafana.
    {{ resources('0.50', '128M', '0.05', '16M') }}

{{ external_networks() }}
  # Despite the name, NOT a true-internal net: the feed-cache nginx proxies
  # rachelbythebay.com outbound, so `internal: true` would break it.
  internal:
    internal: false

volumes:
  feed_cache:
