{% from 'autokuma.yml.j2' import labels as kuma with context %}
{% from 'networks.yml.j2' import service_networks, external_networks with context %}
{% from 'resources.yml.j2' import resources %}
---
services:
  wallabag:
    container_name: wallabag
    image: wallabag/wallabag:latest
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    {{ service_networks() }}
    environment:
      - MYSQL_ROOT_PASSWORD={{ wallabag_mysql_root_password }}
      - SYMFONY__ENV__DATABASE_DRIVER=pdo_mysql
      - SYMFONY__ENV__DATABASE_HOST=db
      - SYMFONY__ENV__DATABASE_PORT=3306
      - SYMFONY__ENV__DATABASE_NAME={{ wallabag_db_name }}
      - SYMFONY__ENV__DATABASE_USER={{ wallabag_db_user }}
      - SYMFONY__ENV__DATABASE_PASSWORD={{ wallabag_db_password }}
      - SYMFONY__ENV__DATABASE_CHARSET=utf8mb4
      - SYMFONY__ENV__DATABASE_TABLE_PREFIX="wallabag_"
      - SYMFONY__ENV__MAILER_DSN=smtp://127.0.0.1
      - SYMFONY__ENV__FROM_EMAIL=wallabag@example.com
      - SYMFONY__ENV__DOMAIN_NAME=https://{{ container_item.hostname | default(container_item.name) }}.{{ domain }}
      - SYMFONY__ENV__SERVER_NAME="Your wallabag instance"
    volumes:
      - wallabag-images:/var/www/wallabag/web/assets/images
      - wallabag_data:/var/www/wallabag/data
    depends_on:
      - db
      - redis
    {% set hc_test = 'curl --fail -s http://localhost:80/ || exit 1' %}{% set hc_start_period = '30s' %}{% set hc_interval = none %}{% set hc_timeout = '10s' %}{% set hc_retries = 3 %}{% set hc_name = '' %}{% if hc_interval is none %}{% set hc_interval = (30 + (((hc_name ~ hc_test) | hash('md5'))[:4] | int(0, 16) % 11)) ~ 's' %}{% endif %}healthcheck:
      test: {{ hc_test }}
      interval: {{ hc_interval }}
      timeout: {{ hc_timeout }}
      retries: {{ hc_retries }}
      start_period: {{ hc_start_period }}
    labels:
{% set tf_container = container_item.hostname | default(container_item.name) %}{% set tf_port = container_item.port | string %}{% set tf_docker_network = (container_item.networks | default([docker_network]))[0] %}{% set tf_authelia = container_item.use_authelia %}{% set tf_extra_middlewares = '' %}
      - "traefik.enable=true"
      - "traefik.docker.network={{ tf_docker_network }}"
      - "traefik.http.routers.{{ tf_container }}.entrypoints=http"
      - "traefik.http.routers.{{ tf_container }}.rule=Host(`{{ tf_container }}.{{ domain }}`) || Host(`{{ tf_container }}.local.{{ domain }}`)"
      - "traefik.http.routers.{{ tf_container }}-secure.entrypoints=https"
      - "traefik.http.routers.{{ tf_container }}-secure.rule=Host(`{{ tf_container }}.{{ domain }}`) || Host(`{{ tf_container }}.local.{{ domain }}`)"
      - "traefik.http.routers.{{ tf_container }}-secure.tls=true"
      - "traefik.http.routers.{{ tf_container }}-secure.tls.certresolver=cloudflare"
      - "traefik.http.routers.{{ tf_container }}-secure.tls.domains[0].main={{ domain }}"
      - "traefik.http.routers.{{ tf_container }}-secure.tls.domains[0].sans=*.{{ domain }},*.local.{{ domain }}"
      - "traefik.http.routers.{{ tf_container }}-secure.service={{ tf_container }}"
      - "traefik.http.services.{{ tf_container }}.loadbalancer.server.port={{ tf_port }}"
      {% if tf_authelia -%}
      - "traefik.http.routers.{{ tf_container }}-secure.middlewares=rate-limit@file,authelia@docker{% if tf_extra_middlewares %},{{ tf_extra_middlewares }}{% endif %}"
      {%- else -%}
      - "traefik.http.routers.{{ tf_container }}-secure.middlewares=rate-limit@file{% if tf_extra_middlewares %},{{ tf_extra_middlewares }}{% endif %}"
      {%- endif +%}
      {{ kuma(container_item.name) }}
    # Resource caps for blast-radius containment (M1); tune from cAdvisor/Grafana.
    {{ resources('1.0', '768M', '0.10', '128M') }}

  db:
    image: mariadb:latest
    container_name: wallabag-db
    restart: unless-stopped
    networks:
      - {{ docker_network }}
    environment:
      - MYSQL_ROOT_PASSWORD={{ wallabag_mysql_root_password }}
    volumes:
      - wallabag-db:/var/lib/mysql
    {% set hc_test = '["CMD", "/usr/local/bin/healthcheck.sh", "--innodb_initialized"]' %}{% set hc_start_period = '30s' %}{% set hc_interval = '20s' %}{% set hc_timeout = '3s' %}{% set hc_retries = 3 %}{% set hc_name = '' %}{% if hc_interval is none %}{% set hc_interval = (30 + (((hc_name ~ hc_test) | hash('md5'))[:4] | int(0, 16) % 11)) ~ 's' %}{% endif %}healthcheck:
      test: {{ hc_test }}
      interval: {{ hc_interval }}
      timeout: {{ hc_timeout }}
      retries: {{ hc_retries }}
      start_period: {{ hc_start_period }}
    labels:
      {{ kuma('wallabag-db', name='Wallabag DB') }}
    # Resource caps for blast-radius containment (M1); tune from cAdvisor/Grafana.
    {{ resources('1.0', '512M', '0.10', '128M') }}

  redis:
    image: redis:alpine
    container_name: wallabag-redis
    restart: unless-stopped
    volumes:
      - wallabag-redis:/data
    networks:
      - {{ docker_network }}
    {% set hc_test = '["CMD", "redis-cli", "ping"]' %}{% set hc_start_period = '30s' %}{% set hc_interval = '20s' %}{% set hc_timeout = '3s' %}{% set hc_retries = 3 %}{% set hc_name = '' %}{% if hc_interval is none %}{% set hc_interval = (30 + (((hc_name ~ hc_test) | hash('md5'))[:4] | int(0, 16) % 11)) ~ 's' %}{% endif %}healthcheck:
      test: {{ hc_test }}
      interval: {{ hc_interval }}
      timeout: {{ hc_timeout }}
      retries: {{ hc_retries }}
      start_period: {{ hc_start_period }}
    labels:
      {{ kuma('wallabag-redis', name='Wallabag Redis') }}
    # Resource caps for blast-radius containment (M1); tune from cAdvisor/Grafana.
    {{ resources('0.50', '128M', '0.05', '16M') }}

{{ external_networks() }}

volumes:
  wallabag-images:
  wallabag_data:
  wallabag-db:
  wallabag-redis:
