---
# Promtail on daniel-pi. Ships this host's CONTAINER logs to loki-homelab, which is the
# cluster's general-purpose log store and already holds both k3s nodes' pod logs.
#
# Scope is deliberately one job. This is a Zero 2 W with 456 MB of RAM and measurable CPU
# pressure at idle, so every target costs something real — see the resource notes in
# docker-compose.yml.j2.
#
# The host JOURNAL is still not shipped, and cannot be: this image's promtail is a stub for
# journal support. Verified 2026-08-29 on the running arm64 3.6.8 binary — it contains the
# string "not compiled into this build", contains no `sd_journal_open`, links no libsystemd
# (`ldd` shows libc and the vdso only), and a 30s `-dry-run` with a `journal:` job over the
# host's persistent /var/log/journal produced zero entries. rsyslog is not an alternative
# either: it is not installed, and this role's debloat section masks it on purpose.
#
# What IS shipped is the two health crons' verdict lines, via the pi-health job below — the
# narrow slice `probe.py alerts` needs, at ~1.5% of the journal's volume.
server:
  http_listen_port: 9080
  # `warn`, not the default `info`: at info promtail logs a line per target discovery pass,
  # which on a 60s refresh is its own steady write load onto the Pi's SD card.
  log_level: warn

positions:
  filename: /positions/positions.yaml

clients:
  # The ClientIP-guarded monitoring route, not a ClusterIP — the Pi is outside the cluster
  # and has no route to 10.43.0.0/16. That guard is an allowlist keyed on source address, so
  # this host's IP must be in loki-homelab's `extra_client_cidrs` or every push 404s. The
  # cert is the same *.local wildcard Traefik serves everywhere here, so it verifies against
  # the system trust store and needs no tls_config.
  - url: https://loki-homelab.local.{{ domain }}/loki/api/v1/push
    # Small batches, long timeout. The default 1 MB / 1s suits a busy node; here it just
    # holds more of a scarce heap, and the Pi's uplink is the slow half of the path.
    batchsize: 65536
    batchwait: 5s
    timeout: 30s
    backoff_config:
      min_period: 1s
      max_period: 5m
      max_retries: 10

scrape_configs:
  # Container logs via the Docker API, NOT by tailing /var/lib/docker/containers/*-json.log.
  # The file path carries only the container ID, so a file-glob job labels every stream with
  # a 64-character hash and the container name has to be joined back from config.v2.json —
  # which promtail cannot do. Service discovery gets the name from the API directly.
  #
  # Through docker-proxy, never the raw socket: the proxy is already on this host serving
  # glances (and this job — the two are its only consumers since dozzle retired 2026-08-29),
  # it is read-only (POST=0, EXEC=0), and CONTAINERS=1 covers both the
  # container list and the log stream. Handing promtail the bare socket would give a log
  # shipper full control of the daemon.
  - job_name: pi-containers
    docker_sd_configs:
      - host: tcp://docker-proxy:2375
        # 60s, matching this host's healthcheck cadence. Each pass is an API round trip plus
        # a relabel over every container; at the 5s default that is a needless steady tick on
        # a box where fork rate was itself the problem worth tuning.
        refresh_interval: 60s
    relabel_configs:
      # Docker reports names with a leading slash — "/glances", not "glances". Left as-is the
      # label does not match the `container` label the cluster's promtail writes, and a query
      # spanning both estates silently returns only one of them.
      - source_labels: ['__meta_docker_container_name']
        regex: '/(.*)'
        target_label: container
      # `job` and `machine` mirror the cluster promtail's contract (job=k8s there), so one
      # LogQL query can span the estate and `machine` still tells the sources apart.
      - target_label: job
        replacement: pi
      - target_label: machine
        replacement: daniel-pi
      - source_labels: ['__meta_docker_container_log_stream']
        target_label: stream

  # The two host health crons' verdict lines — the ONLY host logs shipped from this box, and
  # deliberately not the journal. `probe.py alerts` reconstructs DOWN episodes from
  # `{job="syslog"} |= "status=down"`, and until this job existed every daniel-pi cron was
  # invisible to it: a real "Daniel Pi Recovery" outage on 2026-08-29 (autoheal down ~50 min)
  # left no episode anywhere. Shipping the whole journal would carry ~38k lines/day for these
  # two signals; this is ~576, for the same coverage.
  #
  # `job: syslog` matches the label the cluster hosts' rsyslog stream already carries, so one
  # parser and one Grafana board read both estates. `machine: daniel-pi` is what keeps the two
  # apart — monitor-bridge's Loki liveness check excludes this machine by that label, because
  # a Pi-shipped stream under the same `job` would otherwise stop a total cluster file-tail
  # outage from ever reaching the zero-entry threshold that check alerts on.
  - job_name: pi-health
    static_configs:
      - targets: [localhost]
        labels:
          job: syslog
          machine: daniel-pi
          __path__: /var/log/pi-health/*.log
