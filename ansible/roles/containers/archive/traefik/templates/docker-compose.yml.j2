{% from 'autokuma.yml.j2' import labels as kuma with context %}
{% from 'resources.yml.j2' import resources %}
services:
  crowdsec:
    image: crowdsecurity/crowdsec:latest
    restart: unless-stopped
    container_name: crowdsec
    # Runs as root. DAC_OVERRIDE (read+write bypass) covers reading /var/log/auth.log
    # (mode 640, owned uid107:adm) AND writing into /etc/crowdsec (root dir owned by uid
    # 1000). SETUID/SETGID are required because the LAPI plugin broker forks the
    # notification plugin and drops it to the 'nobody' user — without them it fails with
    # "fork/exec notification-http: operation not permitted". DB is a root-owned volume.
    cap_drop:
      - ALL
    cap_add:
      - DAC_OVERRIDE
      - SETUID
      - SETGID
    security_opt:
      - no-new-privileges:true
    environment:
      GID: "${GID-{{ pgid }}}"
      # Slice-6 B2: demoted to a log-processing AGENT against the in-cluster LAPI. E7
      # (2026-08-13) retired the Docker traefik + Authelia containers this agent used to
      # also feed logs from, and with them the local AppSec listener — this host now
      # originates only auth.log (SSH). The entrypoint logs in as the machine below
      # (registered by the k8s/crowdsec role at B2a). The old local LAPI's DB was purged
      # from the crowdsec-db volume 2026-08-13 (rollback window closed); the volume now
      # holds only regenerable hub data files.
      DISABLE_LOCAL_API: "true"
      LOCAL_API_URL: "https://crowdsec-lapi-k8s.local.{{ domain }}"
      AGENT_USERNAME: "{{ crowdsec_k8s_server_agent_machine }}"
      AGENT_PASSWORD: "{{ crowdsec_k8s_agent_password }}"
      # E7 (2026-08-13): the traefik/authelia/http-cve/appsec collections parsed the
      # Docker edge's HTTP logs and fed the AppSec listener that died with it — the
      # cluster edge's engine (roles/k8s/crowdsec) carries its own copies of those now.
      # linux stays for auth.log/SSH; whitelist-good-actors suppresses good-actor false
      # positives on those scenarios.
      COLLECTIONS: "crowdsecurity/linux crowdsecurity/whitelist-good-actors"
    volumes:
      - ./crowdsec-config:/etc/crowdsec:rw
      - crowdsec-db:/var/lib/crowdsec/data/
      - /var/log/auth.log:/var/log/auth.log:ro
    # `cscli version` exits 0 as soon as the binary runs — before the agent has logged
    # into the cluster LAPI — so `cscli lapi status` (round-trips the cluster LAPI, reads
    # the agent creds) is the real readiness gate; the deploy's "Wait for CrowdSec to be
    # healthy" task polls it.
    {% set hc_test = '["CMD", "cscli", "lapi", "status"]' %}{% set hc_start_period = '20s' %}{% set hc_interval = none %}{% set hc_timeout = '10s' %}{% set hc_retries = 3 %}{% set hc_name = '' %}{% if hc_interval is none %}{% set hc_interval = (30 + (((hc_name ~ hc_test) | hash('md5'))[:4] | int(0, 16) % 11)) ~ 's' %}{% endif %}healthcheck:
      test: {{ hc_test }}
      interval: {{ hc_interval }}
      timeout: {{ hc_timeout }}
      retries: {{ hc_retries }}
      start_period: {{ hc_start_period }}
    ports:
      # Phase E2: LAN-published (host 9103 -> container 6060) for the cluster Prometheus
      # (10.0.0.161:9103), which scrapes this demoted per-host agent's own metrics (a
      # different target than the cluster's in-cluster CrowdSec engine). Locked to daniel-box
      # only by the prometheus role's prometheus-exporters-lan-firewall.sh.
      - "{{ server_ip }}:9103:6060"
    networks:
      - {{ (container_item.networks | default([docker_network]))[0] }}
      # Join monitoring so Prometheus can scrape the CrowdSec metrics endpoint
      # (crowdsec:6060, already bound 0.0.0.0). Without this the crowdsec scrape target
      # is permanently down and the Grafana CrowdSec dashboards have no data.
      - monitoring
    labels:
      # Keep :latest but pin against watchtower auto-updates — an unsupervised pull that
      # breaks this agent would silently blind the host's auth.log/SSH signal to the
      # cluster LAPI, with no health-gated edge left to catch it (the edge dependency
      # retired at E7; this is now a standalone judgment call, not a gate).
      - "com.centurylinklabs.watchtower.enable=false"
      {{ kuma('crowdsec') }}
    # Resource caps for blast-radius containment (M1); tune from cAdvisor/Grafana.
    {{ resources('1.0', '1024M', '0.10', '128M') }}

networks:
  proxy:
    external: true
  monitoring:
    external: true

volumes:
  crowdsec-db:
    name: crowdsec-db
