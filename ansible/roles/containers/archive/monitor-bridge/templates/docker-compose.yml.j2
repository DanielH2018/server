{% from 'autokuma.yml.j2' import labels as kuma with context %}
{% from 'healthcheck.yml.j2' import healthcheck %}
{% from 'networks.yml.j2' import service_networks, external_networks with context %}
{% from 'resources.yml.j2' import resources %}
---

services:
  monitor-bridge:
    image: python:3.14-alpine
    container_name: monitor-bridge
    user: "{{ puid }}:{{ pgid }}"
    restart: unless-stopped
    # Pure stdlib Python over HTTP — no caps, no writable rootfs needed.
    read_only: true
    tmpfs:
      - /tmp
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    command: ["python", "/app/check.py"]
    # check.py touches /tmp/heartbeat (tmpfs) after every completed cycle; stale mtime
    # means the loop HUNG (death alone already exits the container) -> unhealthy -> autoheal
    # restart. 1000s ≈ 3×INTERVAL + slack. Kuma push silence remains the alerting path.
    {{ healthcheck("[\"CMD\", \"python3\", \"-c\", \"import os,sys,time; sys.exit(0 if time.time()-os.stat('/tmp/heartbeat').st_mtime<1000 else 1)\"]", name=container_item.name) }}
    environment:
      - TZ={{ tz }}
      - PYTHONUNBUFFERED=1
      - PYTHONDONTWRITEBYTECODE=1
      - INTERVAL=300
      # THE REMNANT (Phase F drain, 2026-08-14): every metric/API check moved to the
      # cluster twin (roles/k8s/monitor-bridge — the SAME check.py, which sets the
      # mirror-image CHECKS_SKIP). This deployment keeps exactly the checks that read
      # THIS HOST's state files, because their producers are host crons here; each
      # retires with its producer (the host flips in slice-7 §G). check.py refuses to
      # start if this list names an unknown check, so the two lists can't drift apart
      # silently. The twin's env — thresholds, URLs, API keys, the other 25 tokens —
      # lives in the k8s role's env-secret, no longer in this host's container Env
      # (which the read-only docker-proxy exposes to monitoring-net neighbors, the
      # 2026-07-15 H2 concern that file-mounted credentials existed to dodge).
      - CHECKS_ONLY=gitops_alive,gitops_status,disk_prune
      # Re-pointed 2026-08-10 at the Phase D cutover: Kuma moved to the cluster, so the
      # Docker DNS name is gone. The `-k8s` name, NOT the bridged one (same-bridge hairpin —
      # a container here cannot reach this host's own LAN address). /api/push bypasses
      # Authelia LAN-only on the k8s side.
      - KUMA_URL=https://uptime-kuma{{ k8s_hostname_suffix }}.local.{{ domain }}
      # GitOps deployer liveness + deploy-status. State files are written on the host by
      # gitops_deploy.py and bind-mounted read-only at /gitops-state.
      - GITOPS_STATE_DIR=/gitops-state
      - GITOPS_MAX_AGE_MIN=90
      # How long the host may sit behind origin before GitOps Status pages. Deliberately loose:
      # the deployer ticks every 30 min and the dirty-tree path is behind for a whole edit session
      # by design, so only sustained behind-ness is a fault.
      - GITOPS_BEHIND_MAX_MIN=360
      - KUMA_PUSH_GITOPS_ALIVE={{ monitor_bridge_gitops_alive_push_token }}
      - KUMA_PUSH_GITOPS_STATUS={{ monitor_bridge_gitops_status_push_token }}
      # Hourly disk-autoprune host cron (autofix-bridge role): conservative docker/builder/
      # container prune when `/` used% crosses a threshold. Alert on a FAILED prune command
      # or >3h staleness — a disk still full of real data after a clean prune is the twin's
      # Root Disk alert, not this one.
      - DISK_PRUNE_STATE=/autofix-disk/state.json
      - DISK_PRUNE_MAX_AGE_H=3
      - KUMA_PUSH_DISK_PRUNE={{ monitor_bridge_disk_prune_push_token }}
    volumes:
      - ./check.py:/app/check.py:ro
      - /var/lib/gitops-deploy:/gitops-state:ro
      - /var/lib/autofix-disk-prune:/autofix-disk:ro
    {{ service_networks() }}
    labels:
      {# Container-liveness monitor + one push monitor per remnant check (three since the
         2026-08-14 host flips — WG Pi Peer Backup and Renovate Notifier — Alive are now
         pushed by their successors and declared only in the static Secret). The twin-owned
         push monitors' declarations live in the cluster's kuma-static-monitors Secret
         (they already did before the split — transcribed at the Kuma cutover); these five
         stay label-declared HERE because their pusher is this container (declaration
         follows pusher, the configarr/janitorr convention). max_retries=0 on every push
         monitor: with retries, Kuma parks a pushed `down` in PENDING and the watchdog —
         which only an `up` push satisfies — crosses maxretries first, so the DOWN event
         reads "No heartbeat in the time window" instead of the check's named-offender msg. -#}
      {{ kuma('monitor-bridge') }}
      {{ kuma('gitops-deploy-alive', monitor_type='push', name='GitOps Deploy — Alive', interval=600, max_retries=0, push_token=monitor_bridge_gitops_alive_push_token) }}
      {{ kuma('gitops-deploy-status', monitor_type='push', name='GitOps Deploy — Status', interval=600, max_retries=0, push_token=monitor_bridge_gitops_status_push_token) }}
      {{ kuma('autofix-disk-prune', monitor_type='push', name='Disk Autoprune', interval=600, max_retries=0, push_token=monitor_bridge_disk_prune_push_token) }}
    # Resource caps for blast-radius containment (M1); tune from cAdvisor/Grafana.
    {{ resources('0.10', '64M', '0.02', '16M') }}

{{ external_networks() }}
