{% from 'autokuma.yml.j2' import labels as kuma with context %}
{% from 'networks.yml.j2' import service_networks, external_networks with context %}
{% from 'resources.yml.j2' import resources %}
---

services:
  healthchecks:
    image: lscr.io/linuxserver/healthchecks:latest
    container_name: healthchecks
    environment:
      - PUID={{ puid }}
      - PGID={{ pgid }}
      - SITE_ROOT=https://healthchecks.{{ domain }}
      - SITE_NAME=Home Server healthchecks
      - DEFAULT_FROM_EMAIL={{ email }}
      # Include the .local. host so WireGuard access (Traefik routes both) doesn't 400.
      - ALLOWED_HOSTS=localhost,healthchecks.{{ domain }},healthchecks.local.{{ domain }} #optional
      - EMAIL_HOST=smtp.gmail.com
      - EMAIL_PORT=587
      - EMAIL_HOST_USER={{ healthchecks_smtp_user }}
      - EMAIL_HOST_PASSWORD={{ healthchecks_smtp_password }}
      - EMAIL_USE_TLS=True
      - SUPERUSER_EMAIL={{ email }}
      - SUPERUSER_PASSWORD={{ healthchecks_password }}
      - REGISTRATION_OPEN=False
    volumes:
      - ./config:/config
    cap_drop:
      - ALL
    cap_add:
      - SETGID
      - SETUID
      - CHOWN
      - FOWNER
      - DAC_OVERRIDE
    security_opt:
      - no-new-privileges:true
    {{ service_networks() }}
    # -sL follows the "/" 302 (Django login redirect) to a real 200 — `curl --fail` treats a bare
    # 302 as success, so without -L the check greens on an up-but-broken app that still 302s (the
    # DB isn't even touched to serve the redirect). -o /dev/null discards the body.
    {% set hc_test = 'curl --fail -sL http://localhost:8000/ -o /dev/null || exit 1' %}{% set hc_start_period = '30s' %}{% set hc_interval = none %}{% set hc_timeout = '10s' %}{% set hc_retries = 3 %}{% set hc_name = '' %}{% if hc_interval is none %}{% set hc_interval = (30 + (((hc_name ~ hc_test) | hash('md5'))[:4] | int(0, 16) % 11)) ~ 's' %}{% endif %}healthcheck:
      test: {{ hc_test }}
      interval: {{ hc_interval }}
      timeout: {{ hc_timeout }}
      retries: {{ hc_retries }}
      start_period: {{ hc_start_period }}
    restart: unless-stopped
    labels:
{% set tf_container = container_item.hostname | default(container_item.name) %}{% set tf_port = container_item.port | string %}{% set tf_docker_network = (container_item.networks | default([docker_network]))[0] %}{% set tf_authelia = container_item.use_authelia %}{% set tf_extra_middlewares = '' %}
      - "traefik.enable=true"
      - "traefik.docker.network={{ tf_docker_network }}"
      - "traefik.http.routers.{{ tf_container }}.entrypoints=http"
      - "traefik.http.routers.{{ tf_container }}.rule=Host(`{{ tf_container }}.{{ domain }}`) || Host(`{{ tf_container }}.local.{{ domain }}`)"
      - "traefik.http.routers.{{ tf_container }}-secure.entrypoints=https"
      - "traefik.http.routers.{{ tf_container }}-secure.rule=Host(`{{ tf_container }}.{{ domain }}`) || Host(`{{ tf_container }}.local.{{ domain }}`)"
      - "traefik.http.routers.{{ tf_container }}-secure.tls=true"
      - "traefik.http.routers.{{ tf_container }}-secure.tls.certresolver=cloudflare"
      - "traefik.http.routers.{{ tf_container }}-secure.tls.domains[0].main={{ domain }}"
      - "traefik.http.routers.{{ tf_container }}-secure.tls.domains[0].sans=*.{{ domain }},*.local.{{ domain }}"
      - "traefik.http.routers.{{ tf_container }}-secure.service={{ tf_container }}"
      - "traefik.http.services.{{ tf_container }}.loadbalancer.server.port={{ tf_port }}"
      {% if tf_authelia -%}
      - "traefik.http.routers.{{ tf_container }}-secure.middlewares=rate-limit@file,authelia@docker{% if tf_extra_middlewares %},{{ tf_extra_middlewares }}{% endif %}"
      {%- else -%}
      - "traefik.http.routers.{{ tf_container }}-secure.middlewares=rate-limit@file{% if tf_extra_middlewares %},{{ tf_extra_middlewares }}{% endif %}"
      {%- endif +%}
      {{ kuma(container_item.name) }}

      ## Ping Bypass (Public)
      # Trailing slash anchors to the /ping/ path SEGMENT (pings are /ping/<uuid>): a bare
      # PathPrefix(`/ping`) also matches sibling paths like /pingXYZ, extending this public
      # no-Authelia bypass to them.
      - "traefik.http.routers.healthchecks-ping.rule=(Host(`healthchecks.{{ domain }}`) || Host(`healthchecks.local.{{ domain }}`)) && PathPrefix(`/ping/`)"
      - "traefik.http.routers.healthchecks-ping.entrypoints=https"
      - "traefik.http.routers.healthchecks-ping.tls=true"
      - "traefik.http.routers.healthchecks-ping.service=healthchecks"
      # rate-limit moved off the https entrypoint to per-router; re-acquire the default.
      - "traefik.http.routers.healthchecks-ping.middlewares=rate-limit@file"
      # Priority must be higher than the UI router so Traefik matches this first
      - "traefik.http.routers.healthchecks-ping.priority=100"
    # Resource caps for blast-radius containment (M1); tune from cAdvisor/Grafana.
    {{ resources('0.50', '512M', '0.05', '64M') }}

{{ external_networks() }}
