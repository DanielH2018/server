{% from 'autokuma.yml.j2' import labels as kuma with context %}
{% from 'networks.yml.j2' import service_networks, external_networks with context %}
{% from 'resources.yml.j2' import resources %}
services:
  autoheal:
    restart: unless-stopped
    image: willfarrell/autoheal:latest@sha256:602fe408fdf08ee421b00fc1c063333cbec9b38ce9d0a73779c05e2469d2319d
    tty: true
    container_name: autoheal
    # Read-only rootfs: `docker diff` shows zero writes (busybox sh polling the lifecycle
    # proxy; jq streams in memory) — no tmpfs needed. Host-agnostic, so this covers the Pi too.
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    environment:
      - AUTOHEAL_CONTAINER_LABEL=all
      # Default poll is 5s: each cycle fetches the full container list through the
      # proxy and parses it with jq — constant CPU churn on the Pi (Zero 2 W), where
      # the jq pass alone was visible in top under load (2026-06-11). 30s detection
      # latency for an unhealthy container is fine for this fleet.
      - AUTOHEAL_INTERVAL=30
      # A restart used to leave no trace outside the Pi's own docker logs, so a container
      # flapping was invisible until someone went looking. Reuses the general-purpose
      # `monitor_discord_webhook_url` — the same channel Uptime Kuma and monitor-bridge post
      # to — rather than minting a webhook nobody would remember to rotate.
      - WEBHOOK_URL={{ monitor_discord_webhook_url }}
      # The image POSTs `{"<WEBHOOK_JSON_KEY>": "<message>"}` and defaults the key to `text`
      # (read out of /docker-entrypoint on the live container, 2026-09-10). Discord's webhook
      # API reads `content` and rejects `text` with a 400, so the default would notify nobody
      # while every other signal — container healthy, deploy green — read fine.
      - WEBHOOK_JSON_KEY=content
      # A startup sleep before the FIRST poll, not a per-container grace period: Docker
      # already suppresses `unhealthy` during a container's own healthcheck start_period.
      # What this covers is the Pi rebooting, when autoheal and everything it watches come up
      # together and the slow starters would otherwise be restarted mid-boot. The cost is that
      # a deploy that recreates autoheal also blinds it for this long, which is why it is 120s
      # and not the several minutes a full boot takes.
      - AUTOHEAL_START_PERIOD=120
      - DOCKER_SOCK=tcp://docker-proxy-lifecycle:2375
    healthcheck:
      # Interval-only override: `test` is deliberately omitted, so Docker inherits the
      # image's own probe (pgrep -f autoheal). The image bakes interval=5s — that's a
      # sh+pgrep exec (2 runc invocations) every 5s, the single largest source of
      # process churn on the Pi (2026-06-11). A self-pgrep doesn't need 5s cadence.
      interval: {{ container_healthcheck_interval | default('30s') }}
    {{ service_networks() }}
    labels:
      # Watchtower
      - "com.centurylinklabs.watchtower.depends-on=docker-proxy-lifecycle"
      {{ kuma(container_item.name) }}
    # Resource caps for blast-radius containment (M1); tune from cAdvisor/Grafana.
    {{ resources('0.25', '64M', '0.05', '16M') }}

{{ external_networks() }}
