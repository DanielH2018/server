{% from 'autokuma.yml.j2' import labels as kuma with context %}
{% from 'networks.yml.j2' import service_networks, external_networks with context %}
{% from 'resources.yml.j2' import resources %}
{# Only stand up the code-server read proxy on the host that runs code-server — gated on the
   has_code_server host_var (group_vars/all.yml), not containers_list: a tagged
   `deploy.yml --tags docker-proxy` set_facts containers_list to the filtered dependency closure
   (docker-proxy + deps, no code-server), so a containers_list probe would render False and drop
   the service. has_code_server is a plain host_var, stable across that filtering. -#}
---

services:
  docker-proxy:
    image: lscr.io/linuxserver/socket-proxy:latest
    container_name: docker-proxy
    environment:
      - CONTAINERS=1  # Allow access to viewing containers
      - SERVICES=1    # Allow access to viewing services (necessary when using Docker Swarm)
      - TASKS=1       # Allow access to viewing tasks (necessary when using Docker Swarm)
      - POST=0        # Read-only: no write/lifecycle ops on this broadly-reachable proxy
      - EXEC=0        # Read-only: no container exec (Portainer + lifecycle automation use dedicated proxies)
      - INFO=1        # Portainer checks this to validate connection
      - VERSION=1     # Portainer checks this to validate connection
      - PING=1        # Portainer checks this to validate connection
      - IMAGES=1
      - VOLUMES=1
      - NETWORKS=1
      - EVENTS=1
    {{ service_networks() }}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro # Mounted as read-only
    read_only: true
    tmpfs:
      - /run
    # LSIO socket-proxy is haproxy on a high port — already read_only + tmpfs.
    # Empty add; if haproxy can't drop to its user, add [SETUID, SETGID]. Verify on deploy.
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null http://localhost:2375/version || exit 1"]
      # Host-tunable cadence: 10s is fine on the server, but each probe forks runc twice —
      # real CPU/PID churn on the Pi (see container_healthcheck_interval in its host_vars).
      interval: {{ container_healthcheck_interval | default('10s') }}
      timeout: 5s
      retries: 3
      start_period: 10s
    labels:
      # Disable watchtower update
      - "com.centurylinklabs.watchtower.enable=false"
      {{ kuma(container_item.name) }}
    # Resource caps for blast-radius containment (M1); tune from cAdvisor/Grafana.
    {{ resources('0.50', '128M', '0.05', '16M') }}

  # Write-capable proxy for lifecycle automation only — Autoheal, and nothing else since
  # Watchtower was retired (35c0dc8d, Renovate owns image updates). It lives solely on the
  # private `lifecycle` network autoheal joins, so write access to the Docker API is NOT
  # exposed to the proxy/monitoring/apps networks.
  #
  # IMAGES, NETWORKS, ALLOW_START and ALLOW_STOP were dropped 2026-08-29 (review M-11). Each
  # existed for Watchtower alone and said so in its own comment; the retirement commit's diff
  # on this file is empty, so they outlived their only consumer by three weeks. Autoheal issues
  # POST /containers/{id}/restart and nothing else, which ALLOW_RESTARTS gates on its own —
  # verified against a canary container before and after this change, not inferred.
  #
  # EVENTS dropped 2026-08-31 (review L-2), the fifth of the same class. Watchtower watched the
  # event stream; autoheal POLLS on AUTOHEAL_INTERVAL=30 and never opens /events. Measured, not
  # inferred: 24h of this proxy's own logs served /containers/json?filters={"health":["unhealthy"]}
  # and /version, nothing else. Autoheal is the only container on the `lifecycle` network, so
  # there is no second consumer to break.
  #
  # POST=1 STAYS: a restart is a POST, so this proxy remains write-capable by design. The
  # narrowing is real but partial, and the residual below is unchanged.
  docker-proxy-lifecycle:
    image: lscr.io/linuxserver/socket-proxy:latest
    container_name: docker-proxy-lifecycle
    environment:
      - CONTAINERS=1
      - INFO=1
      - VERSION=1
      - PING=1
      - POST=1           # Allow write methods (POST/PUT/DELETE) — Autoheal's restart is a POST
      - ALLOW_RESTARTS=1 # Autoheal: restart unhealthy containers
      # EXEC=0 blocks the exec *run* path (/exec/{id}/start -> 403, verified). Note: create-exec
      # (/containers/{id}/exec) still slips through via CONTAINERS+POST, but with /exec/start
      # blocked it can't execute. Accepted: this proxy is already create-capable (POST=1, needed
      # by Autoheal's restart) and isolated to the lifecycle net, where Autoheal is now the only
      # member — Watchtower, which this sentence used to name, was retired in 35c0dc8d.
      - EXEC=0
    networks:
      - lifecycle
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    read_only: true
    tmpfs:
      - /run
    # LSIO socket-proxy is haproxy on a high port — already read_only + tmpfs.
    # Empty add; if haproxy can't drop to its user, add [SETUID, SETGID]. Verify on deploy.
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null http://localhost:2375/version || exit 1"]
      interval: {{ container_healthcheck_interval | default('10s') }}
      timeout: 5s
      retries: 3
      start_period: 10s
    labels:
      - "com.centurylinklabs.watchtower.enable=false"
      {{ kuma('docker-proxy-lifecycle') }}
    # Resource caps for blast-radius containment (M1); tune from cAdvisor/Grafana.
    {{ resources('0.50', '128M', '0.05', '16M') }}

{% if has_code_server %}
  # Read-only proxy dedicated to code-server's in-IDE `docker` CLI (Security M1). Same
  # least-privilege env as the main docker-proxy (POST=0/EXEC=0), but it lives SOLELY on the
  # private `codeserver` network shared only with code-server — so the shared docker-proxy can
  # stay off `apps` and the internet-facing app fleet can no longer read every container's Env
  # (secrets) via CONTAINERS=1. code-server is the only apps-side consumer, hence its own proxy.
  docker-proxy-codeserver:
    image: lscr.io/linuxserver/socket-proxy:latest
    container_name: docker-proxy-codeserver
    environment:
      - CONTAINERS=1
      - SERVICES=1
      - TASKS=1
      - POST=0        # Read-only: no write/lifecycle ops
      - EXEC=0        # Read-only: no container exec
      - INFO=1
      - VERSION=1
      - PING=1
      - IMAGES=1
      - VOLUMES=1
      - NETWORKS=1
      - EVENTS=1
    networks:
      - codeserver
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    read_only: true
    tmpfs:
      - /run
    # LSIO socket-proxy is haproxy on a high port — already read_only + tmpfs.
    # Empty add; if haproxy can't drop to its user, add [SETUID, SETGID]. Verify on deploy.
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null http://localhost:2375/version || exit 1"]
      interval: {{ container_healthcheck_interval | default('10s') }}
      timeout: 5s
      retries: 3
      start_period: 10s
    labels:
      - "com.centurylinklabs.watchtower.enable=false"
      {{ kuma('docker-proxy-codeserver') }}
    # Resource caps for blast-radius containment (M1); tune from cAdvisor/Grafana.
    {{ resources('0.50', '128M', '0.05', '16M') }}
{% endif %}

{{ external_networks() }}
  lifecycle:
    external: true
{% if has_code_server %}
  codeserver:
    external: true
{% endif %}
