FROM n8nio/runners:latest

USER root

# Install JS packages.
#
# `pnpm install` first, and it is not redundant. The base image ships node_modules linked from a
# pnpm store at .../store/v10, while the pnpm its corepack resolves at build time is now 11.20.0
# and wants .../store/v11 — so `pnpm add` alone aborts with ERR_PNPM_UNEXPECTED_STORE. Installing
# relinks the dependencies into the store the current pnpm expects, which is what pnpm's own
# error text tells you to do.
#
# CI=true because that reinstall PURGES node_modules first, and pnpm refuses to do that without
# a TTY (ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY) — a prompt no image build can ever answer.
# It is the variable pnpm's message names, and it is true here in the literal sense.
#
# Found 2026-08-06 by building this in-cluster. The running image was built 2026-07-03, so this
# has been latent since a `:latest` push between those dates and would fail an ordinary
# `docker compose build` on daniel-server identically.
RUN cd /opt/runners/task-runner-javascript && CI=true pnpm install && pnpm add fuzzball

# Install Python packages
#RUN cd /opt/runners/task-runner-python && uv pip install numpy pandas

# Copy the config file
COPY n8n-task-runners.json /etc/n8n-task-runners.json

USER runner
