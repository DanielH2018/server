#!/usr/bin/env bash
# Reap Longhorn Backup objects left stranded by a tier move — managed by Ansible; edits overwritten.
#
# Thin on purpose. Everything that decides what is stranded, kept, or safe to delete is in
# longhorn_reap_orphan_backups.py + longhorn_reap_logic.py, which are plain files with unit
# tests (ansible/roles/setup/k3s/tests/); this exists only to forward argv and set the two
# kubeconfig paths, one of which is host-specific and has to be templated. Same shape as
# configarr-health.sh.j2.
#
# DRY RUN BY DEFAULT. Pass --apply to delete, --apply-deleted-volumes for backups whose volume
# no longer exists, --max-deletions N to raise the per-run deletion cap. There is deliberately
# no cron for this — it is an operator-invoked tool. See the Python module's docstring for the
# floor it enforces, why it shipped inoperative once, the B2 transaction cost --apply does not
# show in the dry run, and what the deletion cap is sized against.
#
# --apply is documented as `sudo /usr/local/bin/longhorn-reap-orphan-backups.sh --apply`, and
# sudo resets HOME to /root by default, where uv finds no pinned interpreter — it was installed
# `become: false` under /home/{{ sys_user }}/.local/share/uv/python. Pointing UV_PYTHON_INSTALL_DIR
# there explicitly makes uv find it regardless of which HOME invoked this script.
set -uo pipefail

export LONGHORN_REAP_READONLY_KUBECONFIG="/home/{{ sys_user }}/.kube/config"
export UV_PYTHON_INSTALL_DIR="/home/{{ sys_user }}/.local/share/uv/python"

exec /usr/local/bin/uv run --no-project --no-python-downloads --python {{ host_python_version }} \
  /opt/longhorn-reap/longhorn_reap_orphan_backups.py "$@"
