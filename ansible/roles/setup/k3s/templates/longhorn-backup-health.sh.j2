#!/usr/bin/env bash
# Longhorn backup-plane heartbeat — managed by Ansible (k3s role); edits overwritten.
#
# Until this existed, the cluster's backup path had no monitor at all: `grep -ic longhorn` over
# monitor-bridge's check.py returned 0. On 2026-08-02 the Longhorn backup target went
# unavailable at 10:02 and nothing anywhere noticed — the outage surfaced only because Kopia,
# sharing the same B2 account, tripped its own freshness check nine minutes later. Had the cap
# been hit by Longhorn alone, nothing would have alerted.
#
# monitor-bridge runs on the SERVER and cannot see this cluster, so this pushes rather than
# being polled — the same shape as the Pi's health crons (optimize_pi role), for the same
# reason. The curl is inlined rather than sharing optimize_pi's pi-kuma-push-lib.sh: that lib
# lives in a Pi-only role, and promoting it to a shared location is a refactor worth doing
# when monitoring itself moves onto this host, not before.
#
# Reads the cluster through the read-only ServiceAccount kubeconfig (k3s role), so the cron
# needs no sudo and cannot mutate anything.
set -uo pipefail

export KUBECONFIG=/home/{{ sys_user }}/.kube/config
KUBECTL="k3s kubectl -n longhorn-system"
AGE_S=0

KUMA_HOST="uptime-kuma.local.{{ domain }}"
# Pinned to the cluster ingress VIP: Kuma serves from the k8s edge, and the Docker
# edge's bridge route for this name was removed in the slice-7 bridge teardown.
KUMA_RESOLVE_IP="{{ k3s_metallb_ingress_vip }}"
PUSH_URL="https://${KUMA_HOST}/api/push/{{ longhorn_backup_push_token }}"
MAX_AGE_S=$(( {{ k3s_longhorn_backup_max_age_hours }} * 3600 ))
WEEKLY_MAX_AGE_S=$(( {{ k3s_longhorn_weekly_backup_max_age_hours }} * 3600 ))

PROBLEMS=""
add() { PROBLEMS="${PROBLEMS:+$PROBLEMS; }$1"; }

# 1. Is the backup store reachable at all? This is the condition that was false for 13h on
#    2026-08-02. Note what it does NOT prove — slice 0 flagged this — reachability is not
#    evidence any object was ever written, which is what check 2 is for.
#    Both targets are checked by name. Until 2026-08-15 only `default` (B2) was, so R2 going
#    unavailable had no fast signal at all: its four volumes are caught by check 4, but only once
#    they age past MAX_AGE_S, and that message names no target — triage would start in the wrong
#    place. Naming the target in the message is the point of the loop.
BACKUP_TARGETS=(default{% if k3s_longhorn_r2_armed %} r2{% endif %})
for TARGET in "${BACKUP_TARGETS[@]}"; do
  AVAILABLE=$($KUBECTL get backuptarget "$TARGET" -o jsonpath='{.status.available}' 2>&1)
  if [[ "$AVAILABLE" != "true" ]]; then
    REASON=$($KUBECTL get backuptarget "$TARGET" -o jsonpath='{.status.conditions[0].message}' 2>/dev/null | head -c 160)
    add "backup target ${TARGET} unavailable: ${REASON:-$AVAILABLE}"
  fi
done

# 2. Has anything actually landed recently? A recurring job that silently stops producing
#    backups leaves the target perfectly "available" and the backup plane perfectly dead.
NEWEST=$($KUBECTL get backups.longhorn.io \
  -o jsonpath='{range .items[*]}{.status.snapshotCreatedAt}{"\n"}{end}' 2>/dev/null \
  | grep -v '^$' | sort -r | head -1)

if [[ -z "$NEWEST" ]]; then
  add "no backups exist"
else
  NEWEST_S=$(date -d "$NEWEST" +%s 2>/dev/null)
  if [[ -z "$NEWEST_S" ]]; then
    add "unparseable backup timestamp: $NEWEST"
  else
    AGE_S=$(( $(date +%s) - NEWEST_S ))
    if (( AGE_S > MAX_AGE_S )); then
      add "newest backup is $(( AGE_S / 3600 ))h old (limit {{ k3s_longhorn_backup_max_age_hours }}h)"
    fi
  fi
fi

# 3. A backup that reached Error state is a failure the two checks above both miss: the target
#    stays available, and an older Completed backup keeps the freshness check green.
ERRORED=$($KUBECTL get backups.longhorn.io \
  -o jsonpath='{range .items[?(@.status.state=="Error")]}{.metadata.name}{" "}{end}' 2>/dev/null)
if [[ -n "${ERRORED// /}" ]]; then
  add "backups in Error state: ${ERRORED% }"
fi

# 4. Is every backed-up volume covered, or just the loud ones? Checks 2 and 3 are fleet-wide:
#    a volume whose recurring job silently stops producing backups emits NO Backup object, so
#    there is nothing to reach Error state, and the other volumes keep newest-overall fresh.
#    Nothing goes red. That is exactly how freshrss sat unverified after its 2026-08-05 cutover
#    — its Kopia sentinel still resolved against a frozen directory on the server while the live
#    PVC had no per-volume assertion at all. This is the Longhorn analogue of monitor-bridge's
#    BACKUP_SENTINELS guard, and it is DERIVED from the cluster rather than hand-listed: a
#    service that joins the backup group is covered the moment its volume binds, with no list to
#    remember to edit.
#
#    Selected by the `default` recurring-job-group LABEL, not by storageClassName. Those agreed
#    until 2026-08-08, when eight slice-4 config volumes were taken out of the backup set to get
#    under B2's transaction cap — and a PVC's storageClassName is IMMUTABLE, so they still read
#    `longhorn` while no longer being backed up. Class is a creation-time proxy; the label is what
#    `daily-backup` actually selects on, so it is the only filter that cannot drift from reality.
#    Filtering by class here would have paged all eight as uncovered, forever.
COVERAGE=$($KUBECTL get backups.longhorn.io \
  -o jsonpath='{range .items[*]}{.status.volumeName}{" "}{.status.snapshotCreatedAt}{"\n"}{end}' 2>/dev/null)
NOW_S=$(date +%s)
UNCOVERED=""
CHECKED=0

# Run once per backup TIER. Until 2026-08-15 only the `default` group was walked, so the eleven
# volumes moved to the weekly group (k3s_longhorn_weekly_volumes) had no per-volume staleness check
# at all — they could stop backing up indefinitely with every tile green. They cannot share the
# daily bound either: a weekly volume is legitimately ~7 days old, so MAX_AGE_S would page all
# eleven every day. Each tier carries its own bound, and the message names which tier is late.
check_tier() {
  local selector="$1" max_age_s="$2" tier="$3"
  local VOL CREATED CLAIM LATEST CREATED_S LATEST_S

  while read -r VOL CREATED CLAIM; do
    # A Pending PVC has no volumeName yet — nothing to back up, and not a fault.
    [[ -z "$VOL" ]] && continue

    LATEST=$(printf '%s\n' "$COVERAGE" | awk -v v="$VOL" '$1 == v && $2 != "" { print $2 }' | sort -r | head -1)

    # Grace applies ONLY to a volume with no backup at all, and only until it has had time for a
    # scheduled run — a service deployed this afternoon must not redden the backup plane before
    # its first 03:30. It deliberately does NOT extend to a volume that HAS a backup: freshrss and
    # healthchecks bound their PVCs 21h before this check was written and were already backed up,
    # so a blanket young-PVC skip would have excused the two volumes the check exists for.
    if [[ -z "$LATEST" ]]; then
      CREATED_S=$(date -d "$CREATED" +%s 2>/dev/null) || CREATED_S=0
      if (( CREATED_S > 0 && NOW_S - CREATED_S < max_age_s )); then
        continue
      fi
      UNCOVERED="${UNCOVERED:+$UNCOVERED, }${CLAIM} (${tier}, no backup)"
      continue
    fi

    CHECKED=$(( CHECKED + 1 ))
    LATEST_S=$(date -d "$LATEST" +%s 2>/dev/null) || LATEST_S=0
    if (( LATEST_S == 0 )); then
      UNCOVERED="${UNCOVERED:+$UNCOVERED, }${CLAIM} (${tier}, unparseable timestamp)"
    elif (( NOW_S - LATEST_S > max_age_s )); then
      UNCOVERED="${UNCOVERED:+$UNCOVERED, }${CLAIM} (${tier}, $(( (NOW_S - LATEST_S) / 3600 ))h)"
    fi
  done < <($KUBECTL get volumes.longhorn.io -l "$selector" \
    -o jsonpath='{range .items[*]}{.metadata.name}{" "}{.metadata.creationTimestamp}{" "}{.status.kubernetesStatus.namespace}/{.status.kubernetesStatus.pvcName}{"\n"}{end}' 2>/dev/null)
}

check_tier "recurring-job-group.longhorn.io/default=enabled" "$MAX_AGE_S" daily
# One tier per weekday shard (2026-08-16). The retired flat `weekly-backup` label is walked
# too: no RecurringJob selects it any more, so a volume stuck with it is backed up by nothing
# — exactly the state this check exists to page on, once it ages past the weekly bound.
for SHARD in 0 1 2 3 4 5 6; do
  check_tier "recurring-job-group.longhorn.io/weekly-backup-d${SHARD}=enabled" "$WEEKLY_MAX_AGE_S" "weekly-d${SHARD}"
done
check_tier "recurring-job-group.longhorn.io/weekly-backup=enabled" "$WEEKLY_MAX_AGE_S" weekly-legacy

if [[ -n "$UNCOVERED" ]]; then
  add "backed-up volumes stale or missing: ${UNCOVERED}"
fi

# 5. Is the daily backup COUNT outgrowing B2's transaction allowance? Gap G2 in
#    docs/b2-transaction-cap-monitoring-gaps.md, open until the cap fired a SECOND time on
#    2026-08-08. Everything above this line is about whether backups happened; none of it can see
#    the thing that stopped them, because B2 caps TRANSACTIONS separately from bytes and the byte
#    monitors read 6.22 GB of 10 GB — 62%, comfortably green — throughout.
#
#    Deliberately a PROXY, and the message says so. B2 exposes no cap-headroom API, so nothing can
#    measure the remaining allowance; what CAN be measured is the input that grew. Longhorn's daily
#    run went 4 -> 7 -> 15 backups over three days as slice 4 moved config PVCs into the cluster,
#    which is why the free tier's 2500-transaction ceiling stopped absorbing it.
#
#    What it cannot see: kopia's and the b2-usage rclone's share of the same ACCOUNT-wide cap. That
#    is why the budget sits well under what Longhorn alone could spend — the slack is theirs. So a
#    green reading here is "Longhorn is within its share", never "the account has headroom".
DAY_AGO_S=$(( NOW_S - 86400 ))
RECENT_N=0
RECENT_BYTES=0

#    Counts B2-destined backups ONLY. The four volumes routed to R2 (k3s_longhorn_r2_volumes)
#    spend Cloudflare's allowance, not B2's, so counting them here inflates a number compared
#    against a B2-shaped budget — the direction that slowly desensitises the check until it stops
#    meaning anything. R2 has its own headroom monitor (check_r2_usage in monitor-bridge).
#    The routed set is read from the volumes' own spec.backupTargetName rather than from the
#    inventory list: that is what Longhorn actually acts on, it is already in the same name space
#    as a Backup's .status.volumeName (pvc-<uuid>, not namespace/pvcName), and it cannot drift
#    from the inventory the way a second copy of the list would.
R2_VOLUMES=$($KUBECTL get volumes.longhorn.io \
  -o jsonpath='{range .items[?(@.spec.backupTargetName=="r2")]}{.metadata.name}{" "}{end}' 2>/dev/null)
is_r2_volume() {
  local vol="$1" candidate
  for candidate in $R2_VOLUMES; do
    [[ "$vol" == "$candidate" ]] && return 0
  done
  return 1
}

while read -r VOL CREATED SIZE; do
  [[ -z "$CREATED" ]] && continue
  is_r2_volume "$VOL" && continue
  CREATED_S=$(date -d "$CREATED" +%s 2>/dev/null) || continue
  (( CREATED_S < DAY_AGO_S )) && continue
  RECENT_N=$(( RECENT_N + 1 ))
  RECENT_BYTES=$(( RECENT_BYTES + ${SIZE:-0} ))
done < <($KUBECTL get backups.longhorn.io \
  -o jsonpath='{range .items[*]}{.status.volumeName}{" "}{.status.snapshotCreatedAt}{" "}{.status.size}{"\n"}{end}' 2>/dev/null)

if (( RECENT_N > {{ k3s_longhorn_daily_backup_budget }} )); then
  add "$RECENT_N backups in 24h exceeds the {{ k3s_longhorn_daily_backup_budget }} budget \
($(( RECENT_BYTES / 1048576 )) MiB) — Longhorn's share of B2's transaction cap; \
cut backup scope or raise the cap before it 403s"
fi

if [[ -z "$PROBLEMS" ]]; then
  STATUS=up
  # The counts are in the green message on purpose: "newest backup 8h old" was true even while a
  # volume had no backup at all, and it was true throughout the 2026-08-08 transaction-cap outage.
  # The two numbers are what make this green mean something.
  MSG="backup target(s) ${BACKUP_TARGETS[*]} available, newest backup $(( AGE_S / 3600 ))h old, ${CHECKED} backed-up volume(s) covered across daily+weekly, ${RECENT_N} B2 backup(s)/24h (budget {{ k3s_longhorn_daily_backup_budget }})"
else
  STATUS=down
  MSG="$PROBLEMS"
fi

curl -fsS --max-time 10 -G \
  --resolve "${KUMA_HOST}:443:${KUMA_RESOLVE_IP}" \
  --data-urlencode "status=${STATUS}" \
  --data-urlencode "msg=${MSG}" \
  "$PUSH_URL" >/dev/null \
  || logger -t longhorn-backup-health "push failed (status=${STATUS}: ${MSG})"

# Off-premises dead-man's switch. The push above targets Kuma, which runs ON the cluster this
# script watches — a cluster or WAN outage kills the push AND the monitor waiting for it, so
# nothing alerts and the failure is invisible until someone looks. hc-ping.com is off-site and
# alerts on SILENCE, the one signal an on-prem monitor structurally cannot produce. Optional:
# with no key configured this renders empty and the block is skipped, leaving the host unchanged.
# Sourced rather than inlined: this script is 0755 so the {{ sys_user }} cron can execute it,
# which would make an inlined key readable by every local account. The env file is 0640.
HC_PING_KEY=""
# shellcheck source=/dev/null
[[ -r /etc/healthchecks/ping.env ]] && . /etc/healthchecks/ping.env
if [[ -n "$HC_PING_KEY" ]]; then
  # Bare slug, deliberately NOT ?create=1 — auto-provisioning turns a typo'd slug into a brand
  # new check that nobody is watching and that reads green forever.
  HC_URL="https://hc-ping.com/${HC_PING_KEY}/longhorn-backup-health"
  [[ "$STATUS" == "up" ]] || HC_URL="${HC_URL}/fail"
  curl -fsS --max-time 10 --retry 3 --data-raw "$MSG" "$HC_URL" >/dev/null \
    || logger -t longhorn-backup-health "healthchecks ping failed (status=${STATUS})"
fi
