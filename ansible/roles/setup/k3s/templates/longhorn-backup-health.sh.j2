#!/usr/bin/env bash
# Longhorn backup-plane heartbeat — managed by Ansible (k3s role); edits overwritten.
#
# Thin on purpose. Everything that decides up-or-down is in longhorn_backup_health.py + its pure
# core (longhorn_backup_health_logic.py), which are plain files with unit tests; this exists only
# because the Kuma push token has to be templated in, and a secret-carrying file should hold as
# little logic as possible. Same shape as configarr-health.sh and telemetry-health.sh.
#
# Until this existed at all, the cluster's backup path had no monitor: `grep -ic longhorn` over
# monitor-bridge's check.py returned 0. On 2026-08-02 the Longhorn backup target went unavailable
# at 10:02 and nothing anywhere noticed — the outage surfaced only because Kopia, sharing the same
# B2 account, tripped its own freshness check nine minutes later. Had the cap been hit by Longhorn
# alone, nothing would have alerted. The eight checks that now exist to prevent a repeat of that,
# and every incident that shaped one of their thresholds, are documented in
# longhorn_backup_health_logic.py rather than here.
#
# monitor-bridge runs on the SERVER and cannot see this cluster, so this pushes rather than being
# polled — the same shape as the Pi's health crons (optimize_pi role), for the same reason. The
# push itself comes from /usr/local/lib/kuma-push-lib.sh, which the initial_setup role installs on
# every host.
#
# Reads the cluster through the read-only ServiceAccount kubeconfig (k3s role), so the cron needs
# no sudo and cannot mutate anything.
#
# Rollback skew, unique to this cron among the three: the shim ships via the versioned-release
# mechanism (release_bin.yml) while the reader + its logic module ship via a plain `copy:`
# (health-crons.yml), so a release rollback can move the shim to an older commit while the
# reader/env-var contract underneath it stays current. Every LONGHORN_* tunable the shim exports
# is REQUIRED by the reader (no hardcoded fallback — see `_require_env()` in
# longhorn_backup_health.py): a shim that drops one on the way to matching an older reader, or a
# reader that starts expecting a var an older shim never exported, exits nonzero and reports
# "reader failed" naming the variable, rather than silently substituting a stale constant.
#
# The reader issues up to 19 kubectl calls across its eight checks (2 armed targets x up to 2
# calls, +1 freshness, +1 errored-backups, +1 coverage +9 per-tier, +1 recent-budget +1 r2-set,
# +1 failed-jobs), each with a 30s timeout — an 570s worst case against this script's 600s cron
# period. Left as-is: `k3s kubectl` calls against the local API server return in well under a
# second in practice, and 30s is a timeout for a wedged cluster, not an expected duration.
set -uo pipefail

# shellcheck source=/dev/null
source /usr/local/lib/kuma-push-lib.sh || {
  logger -t longhorn-backup-health "kuma-push-lib.sh missing — run initial_setup on this host"
  exit 1
}

export KUBECONFIG=/home/{{ sys_user }}/.kube/config

KUMA_HOST="uptime-kuma.local.{{ domain }}"
# Pinned to the cluster ingress VIP: Kuma serves from the k8s edge, and the Docker
# edge's bridge route for this name was removed in the slice-7 bridge teardown.
KUMA_RESOLVE_IP="{{ k3s_metallb_ingress_vip }}"
# Token sourced, never inlined: this script lands 0755, so an inlined token is readable by every
# local account and is enough to forge or suppress a heartbeat — which on THIS monitor would hide
# a missing backup. 0640 root:{{ sys_user }} env file, same split as ping.env below.
LONGHORN_BACKUP_PUSH_TOKEN=""
# shellcheck source=/dev/null
[[ -r /etc/rancher/k3s/kuma-push.env ]] && . /etc/rancher/k3s/kuma-push.env
if [[ -z "$LONGHORN_BACKUP_PUSH_TOKEN" ]]; then
  logger -t longhorn-backup-health "kuma push token unreadable — skipping push (run initial_setup.yml)"
  exit 0
fi
PUSH_URL="https://${KUMA_HOST}/api/push/${LONGHORN_BACKUP_PUSH_TOKEN}"
# The token has to be sourced this early: the boot-grace push below also needs PUSH_URL, so
# sourcing can't wait until after the reader runs. Once folded into PUSH_URL the raw value has
# no further use in this script, so drop it from the shell's own variable table right away —
# kuma-push.env.j2 does not `export` any of its six tokens today, so none of them currently
# reach a child process's environ, but this makes that true by construction rather than by the
# env file staying in a particular shape, and closes the same class of risk for good.
unset -v LONGHORN_BACKUP_PUSH_TOKEN

# Skip the first run after a boot. This script carries BOTH healthchecks.io dead-men
# (longhorn-backup-health and uptime-kuma-alive) and sends `/fail` on a failed run, which pages
# immediately whatever grace the check is configured with — so this guard, not a grace value, is
# what makes a restart quiet. Exit 0, not 1: a skipped run must not itself read as a failure.
#
# The Kuma beat still goes, which is why the guard sits AFTER PUSH_URL rather than at the top of
# the script. The `k3s Longhorn Backup` tile has a 1200s window against this 600s cron, so it
# tolerates exactly one missed push — the one a silent skip would consume, leaving the tile's
# margin decided by cron jitter and how long the k8s API call takes. Pushing `up` with a skip
# message keeps the heartbeat alive without claiming a reading, the same thing run_once does for
# a gated bridge check.
#
# Kept in shell rather than routed through the Python reader: it reads /proc/uptime, which the
# reader has no reason to touch, and the two checks below (`test_a_guarded_cron_still_beats_its_
# kuma_tile`, `test_a_skipped_run_pings_no_healthchecks_slug`) assert on this exact block's text
# and position — before PUSH_URL's dependents run, after PUSH_URL is set.
#
# Neither healthchecks.io slug is pinged here. Their graces are sized for exactly one skipped
# slot (docs/healthchecks-io-deadman.md), and a success ping for a run that did not happen would
# be a lie the dead-man exists to catch.
if boot_grace_active {{ k3s_health_cron_boot_grace_s }} longhorn-backup-health; then
  kuma_push up "skipped — host still booting" "$PUSH_URL" "$KUMA_HOST" "$KUMA_RESOLVE_IP" longhorn-backup-health
  exit 0
fi

# Every Jinja-templated role default the reader needs, exported as env vars — the reader is a
# plain host script and takes no other input. `| bool` on the armed flags matches
# longhorn-backup.yml's `when:` rather than an unfiltered render: `-e k3s_longhorn_backup_armed=false`
# passes the STRING "false", which is truthy in Jinja, and an unfiltered render would put `default`
# back into the armed set on an ad-hoc disarm — reverting the 2026-08-17 fix silently, in exactly
# the incident-response case it is most likely to be used.
# The three transport settings are exported here for the same reason as the thresholds below
# them: the reader requires every LONGHORN_* var it reads, so a value only this shim knows
# cannot sit in the reader as a hardcoded default that a wrong export would silently shadow.
# The kubectl binary is absolute rather than the bare `k3s kubectl` longhorn-restore-drill.sh.j2
# uses: cron's PATH omits /usr/local/bin, and validate_shell_templates.py fails a cron target that
# names it bare (host_lib.kubectl_runner also prepends that directory, so this is the second of
# two guards, not the only one). The 30s timeout is the per-call deadline this file's header
# sizes the worst-case run against.
export LONGHORN_BACKUP_NAMESPACE="{{ k8s_longhorn_namespace }}"
export LONGHORN_BACKUP_KUBECTL="/usr/local/bin/k3s kubectl"
export LONGHORN_BACKUP_KUBECTL_TIMEOUT_S="30"
export LONGHORN_BACKUP_ARMED="{{ k3s_longhorn_backup_armed | bool }}"
export LONGHORN_R2_ARMED="{{ k3s_longhorn_r2_armed | bool }}"
export LONGHORN_BACKUP_MAX_AGE_HOURS="{{ k3s_longhorn_backup_max_age_hours }}"
export LONGHORN_WEEKLY_BACKUP_MAX_AGE_HOURS="{{ k3s_longhorn_weekly_backup_max_age_hours }}"
export LONGHORN_BACKUP_ERROR_MAX_AGE_HOURS="{{ k3s_longhorn_backup_error_max_age_hours }}"
export LONGHORN_DAILY_BACKUP_BUDGET="{{ k3s_longhorn_daily_backup_budget }}"
export LONGHORN_BACKUP_CRON="{{ k3s_longhorn_backup_cron }}"
export LONGHORN_WEEKLY_BACKUP_MINUTE_HOUR="{{ k3s_longhorn_weekly_backup_minute_hour }}"
export LONGHORN_RESTORE_DRILL_STAMP_DIR="{{ k3s_longhorn_restore_drill_stamp_dir }}"
export LONGHORN_RESTORE_DRILL_MAX_AGE_DAYS="{{ k3s_longhorn_restore_drill_max_age_days }}"
export LONGHORN_RESTORE_DRILL_COVERAGE_SLACK_DAYS="{{ k3s_longhorn_restore_drill_coverage_slack_days }}"

# The reader prints `up<TAB>msg` or `down<TAB>msg` on its LAST stdout line and always exits 0,
# having already logged the full (unranked) verdict to syslog itself. A nonzero exit or empty
# output therefore means the reader ITSELF broke — report that rather than pushing nothing, which
# would leave the monitor to time out with no explanation.
#
# Stdout and stderr are captured SEPARATELY (not `2>&1` into one pipe): this reader is the only
# one of the three host health crons (configarr-health, telemetry-health are the others) that
# spawns a subprocess of its own — it shells out to `logger` to write the full verdict before
# printing the ranked one. `logger: socket /dev/log: ...`, or any uv/Python warning, landing on
# stderr ahead of Python's own stdout flush used to become STATUS once `2>&1` merged the two
# streams, silently turning an `up` into whatever garbage text preceded it — which Kuma reads as
# DOWN and pings healthchecks.io `/fail` on a backup plane that was fine. Taking the verdict from
# the LAST LINE of stdout (rather than the whole capture) is a second, independent guard against
# the same class of contamination: even a stray stdout line ahead of the reader's own print
# doesn't reach STATUS/MSG. longhorn_backup_health.py additionally redirects its own `logger`
# subprocess's stdout/stderr to /dev/null so this can't happen even from inside the reader.
ERR_FILE=$(mktemp /tmp/longhorn-backup-health.XXXXXX)
OUT=$(/usr/local/bin/uv run --no-project --no-python-downloads --python {{ host_python_version }} /opt/longhorn-backup-health/longhorn_backup_health.py 2>"$ERR_FILE")
RC=$?
ERR=$(cat "$ERR_FILE" 2>/dev/null || true)
rm -f "$ERR_FILE"
LAST_LINE="${OUT##*$'\n'}"
if [[ $RC -ne 0 || -z "$LAST_LINE" ]]; then
  STATUS=down
  MSG="longhorn backup health reader failed: ${ERR:-${OUT:-(no output)}}"
  # The reader logs its own verdict on a normal run; on THIS path it never got that far, so log
  # here instead — otherwise the one failure mode where the local trail matters most (the reader
  # itself broke) is the one case with no journalctl record at all.
  logger -t longhorn-backup-health "status=${STATUS} ${MSG}"
else
  STATUS="${LAST_LINE%%$'\t'*}"
  MSG="${LAST_LINE#*$'\t'}"
fi

kuma_push "$STATUS" "$MSG" "$PUSH_URL" "$KUMA_HOST" "$KUMA_RESOLVE_IP" longhorn-backup-health

# Off-premises dead-man's switch. The push above targets Kuma, which runs ON the cluster this
# script watches — a cluster or WAN outage kills the push AND the monitor waiting for it, so
# nothing alerts and the failure is invisible until someone looks. hc-ping.com is off-site and
# alerts on SILENCE, the one signal an on-prem monitor structurally cannot produce. Optional:
# with no key configured this renders empty and the block is skipped, leaving the host unchanged.
# Sourced rather than inlined: this script is 0755 so the {{ sys_user }} cron can execute it,
# which would make an inlined key readable by every local account. The env file is 0640.
HC_PING_KEY=""
# shellcheck source=/dev/null
[[ -r /etc/healthchecks/ping.env ]] && . /etc/healthchecks/ping.env
if [[ -n "$HC_PING_KEY" ]]; then
  # Bare slug, deliberately NOT ?create=1 — auto-provisioning turns a typo'd slug into a brand
  # new check that nobody is watching and that reads green forever.
  HC_URL="https://hc-ping.com/${HC_PING_KEY}/longhorn-backup-health"
  [[ "$STATUS" == "up" ]] || HC_URL="${HC_URL}/fail"
  curl -fsS --max-time 10 --retry 3 --data-raw "$MSG" "$HC_URL" >/dev/null \
    || logger -t longhorn-backup-health "healthchecks ping failed (status=${STATUS})"

  # A SECOND slug, reporting on Kuma itself rather than on backups. The ping above goes out
  # whether or not the Kuma push above it succeeded, which is correct for a backup check and
  # leaves one case uncovered: Kuma alone being broken. Every alert in this homelab terminates
  # in Kuma — there is no Alertmanager — so a dead pod, a wedged SQLite or a fenced-off port
  # silences all ~82 tiles while every other off-site check keeps reporting green. The cluster
  # being down is already caught by this script's own silence; Kuma being down was not caught
  # by anything.
  #
  # This carries the Kuma push's exit status off-site, so a Kuma-only outage becomes silence
  # on hc-ping within one grace period. Chosen here because this script runs every 10 minutes
  # and already talks to Kuma — no new cron, no new credential, one of the 14 free slots.
  #
  # No body: the status IS the signal, and MSG belongs to the other check.
  HC_ALIVE_URL="https://hc-ping.com/${HC_PING_KEY}/uptime-kuma-alive"
  (( KUMA_PUSH_OK )) || HC_ALIVE_URL="${HC_ALIVE_URL}/fail"
  curl -fsS --max-time 10 --retry 3 "$HC_ALIVE_URL" >/dev/null \
    || logger -t longhorn-backup-health "healthchecks kuma-alive ping failed (push_ok=${KUMA_PUSH_OK})"
fi
