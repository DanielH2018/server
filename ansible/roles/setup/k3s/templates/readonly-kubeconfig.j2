---
# Read-only kubeconfig for {{ sys_user }} — rendered by the k3s role, do not hand-edit.
# The identity is the {{ k3s_readonly_sa_name }} ServiceAccount (see readonly-rbac.yaml.j2);
# it cannot read Secrets, exec into pods, or change anything.
apiVersion: v1
kind: Config
current-context: {{ k3s_readonly_sa_name }}
clusters:
  - name: default
    cluster:
      server: {{ k3s_readonly_kubeconfig_server }}
      certificate-authority-data: {{ k3s_readonly_ca_b64 }}
contexts:
  - name: {{ k3s_readonly_sa_name }}
    context:
      cluster: default
      user: {{ k3s_readonly_sa_name }}
users:
  - name: {{ k3s_readonly_sa_name }}
    user:
      token: {{ k3s_readonly_token_plain }}
