#!/usr/bin/env bash
# Reap Longhorn Snapshots left stranded by a tier move — managed by Ansible; edits overwritten.
#
# Thin on purpose, same shape as its sibling longhorn-reap-orphan-backups.sh.j2: everything that
# decides what is stranded, kept, or safe to delete is in longhorn_reap_orphan_snapshots.py +
# longhorn_reap_logic.py, which are plain files with unit tests
# (ansible/roles/setup/k3s/tests/). This exists only to forward argv and set the templated
# kubeconfig path and the two knobs (age floor, delete timeout) Ansible owns.
#
# DRY RUN BY DEFAULT. Pass --apply to delete. No cron, for the same reason as its sibling: the
# safe-to-delete set depends on live state this script can check now but cannot guarantee a
# week from now. See the Python module's docstring for why this problem differs from stranded
# backups (local reclamation, not B2 storage) and why remove-snapshots-during-filesystem-trim
# was rejected in favour of this.
set -uo pipefail

export LONGHORN_REAP_READONLY_KUBECONFIG="/home/{{ sys_user }}/.kube/config"
export LONGHORN_REAP_MIN_AGE_DAYS="{{ k3s_longhorn_snapshot_reap_min_age_days }}"
export LONGHORN_REAP_DELETE_TIMEOUT="{{ k3s_longhorn_snapshot_reap_delete_timeout }}"

exec /usr/local/bin/uv run --no-project --no-python-downloads --python {{ host_python_version }} \
  /opt/longhorn-reap/longhorn_reap_orphan_snapshots.py "$@"
