apiVersion: v1
kind: Secret
metadata:
  name: longhorn-b2
  namespace: longhorn-system
type: Opaque
# `data:` with b64encode, not `stringData:`, for the reason longhorn-r2-secret.yaml.j2 gives (#4341).
data:
  AWS_ACCESS_KEY_ID: "{{ longhorn_b2_key_id | b64encode }}"
  AWS_SECRET_ACCESS_KEY: "{{ longhorn_b2_application_key | b64encode }}"
  AWS_ENDPOINTS: "{{ ('https://s3.' ~ k3s_longhorn_b2_region ~ '.backblazeb2.com') | b64encode }}"
