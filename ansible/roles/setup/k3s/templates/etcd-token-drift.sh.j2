#!/usr/bin/env bash
# Cluster-token drift check — managed by Ansible (k3s role); edits overwritten.
#
# Usage: etcd-token-drift.sh [-h|--help]
# Takes no arguments. Root cron job "etcd token drift" (cron file etcd-token-drift) runs it daily at
# k3s_etcd_s3_cron_hour:k3s_etcd_s3_cron_minute. It reads the token and the stamp and changes no
# state, so running it by hand is safe, but it pings Healthchecks.io. It reads the optional
# healthchecks ping URL from /etc/healthchecks/ping.env. Each run writes its verdict to
# $TEXTFILE_DIR/etcd-snapshot-offbox.prom for node_exporter's textfile collector. Prometheus rules
# in host-checks.yaml page the verdict through Alertmanager.
#
# The check, the Healthchecks.io slug and the syslog tag keep the name etcd-snapshot-offbox, so no
# rule or dead-man changes name. k3s's own schedule writes the off-box snapshots, and check 12 of
# longhorn-backup-health reports when they stop.
#
# Since --secrets-encryption was armed (2026-08-20) Secrets are encrypted in etcd, so restoring a
# snapshot onto a REBUILT host needs the CLUSTER TOKEN (/var/lib/rancher/k3s/server/token) supplied
# first. The token is deliberately NOT uploaded beside the snapshots: storing it in that bucket would
# hand anyone with the bucket both halves and undo the encryption entirely. Restoring onto daniel-box
# with its disk intact is unaffected.
#
# encryption-config.json need not be preserved. Its CONTENTS ride inside the snapshot's own
# /bootstrap blob (verified against k3s v1.36.3+k3s1), encrypted with the token, so the token is the
# only artifact that must survive daniel-box. docs/k3s-etcd-restore.md carries the evidence.
set -uo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

# shellcheck source=/dev/null
source /usr/local/lib/homelab-check-lib.sh || {
  logger -t etcd-snapshot-offbox "homelab-check-lib.sh missing — run initial_setup on this host"
  exit 1
}

# The longest legitimate gap between two textfile writes: a day plus an hour.
# `k3s_daily_check_deadline_s` names it in defaults/main.yml, and
# ansible/tests/services/test_b1_rule_literals.py pins the rule's literal to this value.
DEADLINE_S={{ k3s_daily_check_deadline_s }}
TEXTFILE_DIR=${TEXTFILE_DIR:-/var/lib/node-exporter-textfile}

# Off-premises dead-man's switch — see longhorn-backup-health.sh.j2 for the full rationale.
# Prometheus runs on the cluster this backs up, so an outage silences both the textfile and the
# rules; hc-ping.com alerts on the silence instead. Sourced, not inlined: this script is 0755.
push_healthchecks() {
  local status="$1"
  HC_PING_KEY=""
  # shellcheck source=/dev/null
  [[ -r /etc/healthchecks/ping.env ]] && . /etc/healthchecks/ping.env
  # Positive `-n` guard rather than an early `-z` return: test_healthchecks_pings.py matches this
  # shape specifically, so that an unconfigured host provably cannot curl a malformed URL.
  if [[ -n "$HC_PING_KEY" ]]; then
    # Bare slug, never ?create=1 — a typo would silently create an unwatched, permanently-green check.
    local url="https://hc-ping.com/${HC_PING_KEY}/etcd-snapshot-offbox"
    [[ "$status" == "up" ]] || url="${url}/fail"
    # No `-S`, stderr discarded — see longhorn-backup-health.sh.j2 (#2511).
    curl -fs --max-time 10 --retry 3 "$url" >/dev/null 2>&1 \
      || logger -t etcd-snapshot-offbox "healthchecks ping failed (status=${status})"
  fi
}

# Every exit path reports through here, and the log line is UNCONDITIONAL — see
# longhorn-backup-health.sh.j2 for the full rationale, and manifest-prune-check.sh.j2 for the same
# pattern. Short version: the `|| logger` inside the ping helper only fires when the curl itself
# fails, so a successfully-pinged status leaves no durable local record. That makes journald
# silence ambiguous — a run that succeeded quietly and a cron that never fired look identical —
# and that line is the check's only history in Loki.
report() {
  local status="$1" msg="$2" success=0
  logger -t etcd-snapshot-offbox "status=${status} ${msg}"
  # Every path out of this script reports through here, so the textfile carries each verdict. It
  # is written before the ping, which must not delay it. A failed write logs and the ping goes on.
  [[ "$status" == "up" ]] && success=1
  write_check_textfile etcd-snapshot-offbox "$success" "$(date +%s)" "$DEADLINE_S" \
    || logger -t etcd-snapshot-offbox "textfile write to ${TEXTFILE_DIR} failed (status=${status})"
  push_healthchecks "$status"
}

# Has the cluster token drifted from the copy that can actually decrypt the off-box snapshots?
#
# The token is what decrypts the /bootstrap blob in every snapshot (see the header). It is held out
# of band, in the password manager, and docs/k3s-etcd-restore.md correctly says nothing can check
# THAT COPY STILL EXISTS. But that exemption is narrower than it reads: whether the LIVE token still
# matches what was copied is a sha256 comparison. `k3s token rotate --new-token` exists on the
# installed binary, so one deliberate command leaves the cluster Ready, every monitor green, and
# every snapshot from that moment on undecryptable with the copy anyone holds. The weekly restore
# drill cannot see it either — it reads the LIVE token off this disk, so it passes identically
# before and after a rotation.
#
# The stamp is written BY THE OPERATOR, at the moment the out-of-band copy is taken, and by nothing
# else. Ansible must never create it: an absent -> create step would cure the condition before this
# check could report it, making the check a tautology on any host that lost the stamp. That is the
# same self-re-baselining hole that rules out recording the hash in host_vars.
#
# What it proves is narrow, and saying so here is deliberate: "unchanged since stamped", NOT "the
# off-box copy is valid". A green check is not a reason to skip re-copying the token.
TOKEN_FILE=/var/lib/rancher/k3s/server/token
TOKEN_STAMP=/var/lib/homelab/etcd-token.sha256
DRIFT_MSG=""
if [[ ! -r "$TOKEN_FILE" ]]; then
  # Fails closed: unreadable is reported, never assumed fine.
  DRIFT_MSG="cannot read ${TOKEN_FILE} — cluster-token drift UNVERIFIED"
elif [[ ! -f "$TOKEN_STAMP" ]]; then
  DRIFT_MSG="cluster-token baseline missing — copy the token out of band, then run: sha256sum ${TOKEN_FILE} | awk '{print \$1}' | install -m 0600 -D /dev/stdin ${TOKEN_STAMP}"
elif [[ ! -r "$TOKEN_STAMP" ]]; then
  DRIFT_MSG="${TOKEN_STAMP} exists but is unreadable — cluster-token drift UNVERIFIED"
else
  LIVE_HASH=$(sha256sum "$TOKEN_FILE" 2>/dev/null | awk '{print $1}')
  STAMPED_HASH=$(tr -d '[:space:]' < "$TOKEN_STAMP")
  if [[ -z "$LIVE_HASH" || -z "$STAMPED_HASH" ]]; then
    DRIFT_MSG="cluster-token hash unreadable on one side — drift UNVERIFIED"
  elif [[ "$LIVE_HASH" != "$STAMPED_HASH" ]]; then
    # Only the first 8 hex chars, and only of a HASH — enough to tell two states apart in a
    # message, never enough to reconstruct the token.
    DRIFT_MSG="CLUSTER TOKEN ROTATED since the off-box copy was taken (live ${LIVE_HASH:0:8}… vs stamped ${STAMPED_HASH:0:8}…) — every off-box snapshot is undecryptable with the held copy until you re-copy it and re-stamp"
  fi
fi

if [[ -n "$DRIFT_MSG" ]]; then
  # A snapshot nobody can decrypt is not a backup, so this also fails the off-premises dead-man.
  report down "$DRIFT_MSG"
else
  report up "cluster token unchanged since stamped"
fi
