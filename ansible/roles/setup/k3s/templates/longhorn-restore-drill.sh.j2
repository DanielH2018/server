#!/usr/bin/env bash
# Longhorn restore drill — managed by Ansible (k3s role); edits overwritten.
#
# Restores the newest backup of one small volume from B2 into a NEW volume, mounts it in a
# throwaway pod, checks the data is real, then tears everything down. The live volume is never
# touched.
#
# This exists because "the backup completed" and "the backup restores" are different claims and
# only the first was ever checked. The backup-plane heartbeat watches Longhorn's own objects;
# none of them can tell you whether the bytes in B2 come back. The first drill, run by hand on
# 2026-08-15, FAILED — not on the data, but on a B2 Class-B cap at 100%, which surfaced as
# `cannot find volume.cfg in backupstore` and reads exactly like data loss. The retry on
# 2026-08-16 passed. Nothing recurred after that, and a drill that silently stops looks
# identical to one that was never scheduled — which is what this script and check 7 of
# longhorn-backup-health.sh fix between them.
#
# Runs as ROOT from cron, and has to: it creates and deletes Volume/PV/PVC objects and runs a
# pod. The read-only ServiceAccount the heartbeat uses cannot do any of that, so do not try to
# convert this to that credential.
set -uo pipefail

# Cron's PATH is /usr/bin:/bin, which omits /usr/local/bin where k3s lives.
export PATH="/usr/local/bin:${PATH}"
KUBECTL="k3s kubectl"

PIN="{{ k3s_longhorn_restore_drill_pvc }}"
FALLBACK_NS="{{ k3s_longhorn_restore_drill_namespace }}"
MAX_BYTES="{{ k3s_longhorn_restore_drill_max_actual_bytes }}"
STAMP_DIR="{{ k3s_longhorn_restore_drill_stamp_dir }}"
STAMP="${STAMP_DIR}/last-success"
# Per-volume bookkeeping, and the two directories do different jobs. ATTEMPT_DIR drives the
# rotation and is stamped on every run whatever the outcome; SUCCESS_DIR records proof and is
# written only after the assertions pass. Selecting on attempts rather than successes is what
# stops one permanently broken volume from starving the other 24 — it would otherwise stay the
# least-recently-succeeded forever and be picked every single day.
ATTEMPT_DIR="${STAMP_DIR}/attempts"
SUCCESS_DIR="${STAMP_DIR}/success"
SEEN_DIR="${STAMP_DIR}/seen"
# The eligible set, refreshed every run for the heartbeat's coverage check to read. Check 8 has
# no cluster credential worth the name, so the drill — which already computes this — publishes it.
CANDIDATES="${STAMP_DIR}/candidates"
MANIFEST=$(mktemp /tmp/restore-drill.XXXXXX.yaml)
DRILL=""

fail() { logger -t longhorn-restore-drill "FAIL: $*"; echo "restore drill FAILED: $*" >&2; exit 1; }

# Teardown runs on EVERY exit path including the failures above, because a half-restored volume
# left attached would block the next run and, being a Longhorn volume with a replica, occupies
# real disk. `--ignore-not-found` throughout so cleanup is idempotent whatever stage we died at.
cleanup() {
  # Guarded: the candidate query runs before a volume is chosen, so an early failure reaches this
  # trap with DRILL empty — and `delete pod restore-drill--probe` is a confusing no-op at best.
  [[ -n "$DRILL" ]] || { rm -f "$MANIFEST"; return; }
  $KUBECTL -n "$PVC_NS" delete pod "${DRILL}-probe" --ignore-not-found --now >/dev/null 2>&1
  $KUBECTL -n "$PVC_NS" delete pvc "$DRILL" --ignore-not-found >/dev/null 2>&1
  $KUBECTL delete pv "$DRILL" --ignore-not-found >/dev/null 2>&1
  $KUBECTL -n longhorn-system delete volume "$DRILL" --ignore-not-found >/dev/null 2>&1
  rm -f "$MANIFEST"
}
trap cleanup EXIT

# Everything below is resolved from the cluster, never hardcoded. The hand-run one-shot this
# replaces pinned the backup ID, the volume name and the size as literals — all three of which
# were true only on 2026-08-16. A pinned backup ID is the worst of them: retention deletes it,
# and the drill then fails forever on a missing backup while reading as a restore failure.
#
# ELIGIBILITY is by the `recurring-job-group.longhorn.io/*` LABEL, the same selector check 4 of
# the heartbeat uses, and for the same reason: the label is what a RecurringJob actually selects
# on, so it cannot drift from what is really being backed up the way storageClassName does (a
# PVC's class is immutable and still reads `longhorn` on volumes dropped from the backup set on
# 2026-08-08). The `no-backup` group is an explicit opt-OUT and is excluded by name.
#
# A volume with no Completed Backup CR is SKIPPED, not failed. That looks like the drill hiding a
# problem, and it would be if nothing else watched — but check 4 already pages per-volume when a
# declared volume has no fresh backup, and it owns that alarm. Failing here as well would burn a
# rotation slot re-reporting it, and after the 16 MiB migration recreated volumes faster than
# their weekday shards refilled, it would have failed most slots for a week.
BACKED=$($KUBECTL -n longhorn-system get backups.longhorn.io -o json 2>/dev/null \
  | jq -c '[.items[] | select(.status.state == "Completed") | .status.volumeName] | unique')
[[ -n "$BACKED" ]] || fail "cannot list backups — is the backup target reachable?"

# actualSize, not spec.size: spec is the declared ceiling and says nothing about what a restore
# has to pull down. The cap bounds one run's egress and wall-clock, and excludes nothing today
# (the largest candidate is valheim-config at ~1.3 GB) — it is a guard against a volume growing
# into a restore that cannot finish inside the timeout, which would read as a restore failure.
ELIGIBLE=$($KUBECTL -n longhorn-system get volume -o json 2>/dev/null \
  | jq -r --argjson backed "$BACKED" --argjson max "$MAX_BYTES" --arg pin "$PIN" '
      [.items[]
       | select([.metadata.labels // {} | keys[]
                 | select(startswith("recurring-job-group.longhorn.io/"))
                 | sub("recurring-job-group.longhorn.io/"; "")
                 | select(. != "no-backup")] | length > 0)
       # .metadata.name, NOT .status.volumeName: a Volume CR has no status.volumeName — that
       # field belongs to Backup CRs, and comparing the null it yields here matched nothing at
       # all, leaving the drill with an empty candidate set every night.
       | select(.metadata.name as $v | $backed | index($v))
       | select(((.status.actualSize // 0) | tonumber) <= $max)
       | {pvc: (.status.kubernetesStatus.pvcName // ""),
          ns: (.status.kubernetesStatus.namespace // ""),
          vol: .metadata.name,
          size: (.spec.size | tostring),
          bs: ((.spec.backupBlockSize // 16777216) | tostring),
          target: (.spec.backupTargetName // "default")}
       | select(.pvc != "")
       | select($pin == "" or .pvc == $pin)]
      | sort_by(.pvc)[]
      | [.pvc, .ns, .vol, .size, .bs, .target] | @tsv')
[[ -n "$ELIGIBLE" ]] || fail "no eligible volume has a Completed backup${PIN:+ (pin: ${PIN})}"

mkdir -p "$STAMP_DIR" "$ATTEMPT_DIR" "$SUCCESS_DIR" "$SEEN_DIR"
chmod 0755 "$STAMP_DIR" "$ATTEMPT_DIR" "$SUCCESS_DIR" "$SEEN_DIR"
printf '%s\n' "$ELIGIBLE" | cut -f1 >"$CANDIDATES"
chmod 0644 "$CANDIDATES"

# When each candidate JOINED the rotation, written once and never refreshed. Check 8 needs it to
# tell "this volume has had a full cycle of chances and never restored" from "this volume joined
# on Tuesday and its turn has not come". Neither other stamp can answer that: the attempt stamp
# is refreshed every time the volume comes up, so it is never older than one cycle for a volume
# in steady rotation, and a whole-rotation start date flags a newly joined volume immediately.
while IFS= read -r cand; do
  [[ -n "$cand" && ! -e "${SEEN_DIR}/${cand}" ]] || continue
  touch "${SEEN_DIR}/${cand}"
  chmod 0644 "${SEEN_DIR}/${cand}"
done <"$CANDIDATES"

# Least-recently-ATTEMPTED wins, so the rotation self-corrects: a volume that joins the backup
# set has no attempt stamp, sorts first, and is drilled the next night rather than waiting out a
# cycle. A missing stamp is epoch 0 for exactly that reason.
CHOICE=$(while IFS=$'\t' read -r pvc rest; do
  [[ -n "$pvc" ]] || continue
  at=0
  [[ -f "${ATTEMPT_DIR}/${pvc}" ]] && at=$(stat -c %Y "${ATTEMPT_DIR}/${pvc}" 2>/dev/null || echo 0)
  printf '%s\t%s\t%s\n' "$at" "$pvc" "$rest"
done <<<"$ELIGIBLE" | sort -n -k1,1 | head -1 | cut -f2-)

IFS=$'\t' read -r PVC PVC_NS VOL SIZE BLOCKSIZE TARGET <<<"$CHOICE"
[[ -n "$PVC" && -n "$VOL" && -n "$SIZE" ]] || fail "could not select a volume to drill"
PVC_NS="${PVC_NS:-$FALLBACK_NS}"
DRILL="restore-drill-${PVC}"

# Stamped BEFORE the restore, and that ordering is the whole anti-starvation property. Stamping
# on success only would make a volume that always fails permanently the oldest, so it would be
# picked every night and the other 24 would never be drilled again.
touch "${ATTEMPT_DIR}/${PVC}"
chmod 0644 "${ATTEMPT_DIR}/${PVC}"

# Newest Completed backup, by snapshot time. `sort_by` over a string is fine here: these are
# RFC3339 stamps in a fixed zone, so lexical and chronological order agree.
BACKUP=$($KUBECTL -n longhorn-system get backups.longhorn.io -o json 2>/dev/null \
  | jq -r --arg vol "$VOL" '
      [.items[]
       | select(.status.volumeName == $vol and .status.state == "Completed")]
      | sort_by(.status.snapshotCreatedAt)
      | last
      | .metadata.name // ""')
[[ -n "$BACKUP" ]] || fail "no Completed backup for ${PVC} (volume ${VOL})"

URL=$($KUBECTL -n longhorn-system get backuptarget "$TARGET" -o jsonpath='{.spec.backupTargetURL}' 2>/dev/null)
[[ -n "$URL" ]] || fail "backup target ${TARGET} has no URL — is it disarmed?"

# A restore Volume CR needs spec.backupTargetName since the v1.12 multi-target change, or it
# resolves against the volume's default target and silently restores from the wrong store.
#
# backupBlockSize is carried from the SOURCE volume rather than left to default. Omitted, the new
# volume takes the global `backup-block-size` setting, which is 16 MiB since 2026-08-19 — while
# the four R2 volumes are still 2 MiB and only convert on recreation. Longhorn refuses a size that
# is not a multiple of the block size, so a mismatch strands the restore on exactly the volumes
# the rotation added. Every candidate size is a 16 MiB multiple today, so nothing is stranded
# right now; pinning it means that stays true when a volume of an awkward size joins.
cat >"$MANIFEST" <<YAML
apiVersion: longhorn.io/v1beta2
kind: Volume
metadata:
  name: ${DRILL}
  namespace: longhorn-system
spec:
  frontend: blockdev
  backupTargetName: ${TARGET}
  backupBlockSize: "${BLOCKSIZE}"
  fromBackup: "${URL}?backup=${BACKUP}&volume=${VOL}"
  numberOfReplicas: 1
  size: "${SIZE}"
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: ${DRILL}
spec:
  capacity:
    storage: ${SIZE}
  accessModes: ["ReadWriteOnce"]
  persistentVolumeReclaimPolicy: Retain
  storageClassName: longhorn-static
  csi:
    driver: driver.longhorn.io
    volumeHandle: ${DRILL}
    fsType: ext4
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ${DRILL}
  namespace: ${PVC_NS}
spec:
  accessModes: ["ReadWriteOnce"]
  storageClassName: longhorn-static
  volumeName: ${DRILL}
  resources:
    requests:
      storage: ${SIZE}
YAML

$KUBECTL apply -f "$MANIFEST" >/dev/null 2>&1 || fail "could not create the drill volume"

# Poll rather than `kubectl wait`: restoreRequired is a plain status field, not a Condition, so
# there is nothing for --for=condition to watch.
DEADLINE=$(( $(date +%s) + {{ k3s_longhorn_restore_drill_timeout_s }} ))
while :; do
  STATE=$($KUBECTL -n longhorn-system get volume "$DRILL" \
    -o jsonpath='{.status.state} {.status.restoreRequired}' 2>/dev/null)
  [[ "$STATE" == "detached false" ]] && break
  (( $(date +%s) > DEADLINE )) && fail "restore did not finish in {{ k3s_longhorn_restore_drill_timeout_s }}s (last state: ${STATE:-unknown})"
  sleep 10
done

# Generic on purpose: counts files and sums their bytes rather than looking for a known
# filename. The drill has to be repointable at any volume — the original one-off checked
# `acme.json` for a domain string, which tied it to traefik-acme forever — and a restored volume
# that mounts but is EMPTY is the failure this must catch. Contents are never printed: these are
# service config volumes and several hold credentials.
#
# Create-then-read, NOT `kubectl run --rm -i`. The attach form returned an EMPTY string on
# 2026-08-19 — no pod output, no error — and the drill reported "restored volume has no files"
# with nothing after the colon. An empty capture is indistinguishable from an empty volume, which
# is the one thing this check exists to tell apart. Creating the pod, waiting for it to reach a
# terminal phase, and then reading its logs makes both the result and any failure legible.
$KUBECTL -n "$PVC_NS" run "${DRILL}-probe" --restart=Never \
  --image={{ k3s_longhorn_restore_drill_image }} \
  --overrides="$(cat <<JSON
{"spec":{"containers":[{"name":"${DRILL}-probe","image":"{{ k3s_longhorn_restore_drill_image }}",
"command":["sh","-c","echo files=\$(find /drill -type f | wc -l) bytes=\$(find /drill -type f -exec cat {} + | wc -c)"],
"volumeMounts":[{"name":"d","mountPath":"/drill","readOnly":true}]}],
"volumes":[{"name":"d","persistentVolumeClaim":{"claimName":"${DRILL}"}}],"restartPolicy":"Never"}}
JSON
)" >/dev/null 2>&1 || fail "could not create the probe pod"

PROBE_DEADLINE=$(( $(date +%s) + 300 ))
while :; do
  PHASE=$($KUBECTL -n "$PVC_NS" get pod "${DRILL}-probe" -o jsonpath='{.status.phase}' 2>/dev/null)
  [[ "$PHASE" == "Succeeded" || "$PHASE" == "Failed" ]] && break
  (( $(date +%s) > PROBE_DEADLINE )) && fail "probe pod stuck in ${PHASE:-unknown} — could not read the restored volume"
  sleep 5
done

PROBE=$($KUBECTL -n "$PVC_NS" logs "${DRILL}-probe" 2>&1)
[[ "$PHASE" == "Succeeded" ]] || fail "probe pod ${PHASE}: ${PROBE:-<no logs>}"
[[ -n "$PROBE" ]] || fail "probe pod produced no output — the volume state is unknown, not empty"

FILES=$(sed -n 's/.*files=\([0-9]\{1,\}\).*/\1/p' <<<"$PROBE" | head -1)
BYTES=$(sed -n 's/.*bytes=\([0-9]\{1,\}\).*/\1/p' <<<"$PROBE" | head -1)

[[ -n "$FILES" && "$FILES" -gt 0 ]] || fail "restored volume has no files: ${PROBE}"
MIN_BYTES="{{ k3s_longhorn_restore_drill_min_bytes }}"
[[ -n "$BYTES" && "$BYTES" -ge "$MIN_BYTES" ]] \
  || fail "restored volume holds ${BYTES:-0} bytes, under the ${MIN_BYTES} floor: ${PROBE}"

# The stamp is written ONLY here, after both assertions pass. Check 7 reads its contents, so
# stamping earlier — or on any failure path — would report a broken drill as a healthy one.
# Modes are set EXPLICITLY on every file and directory the drill writes — here and at the
# candidate query above — because the reader is a different user. This script runs as root, whose
# umask here is 027, so `mkdir -p` alone produced drwxr-x--- root:root and the heartbeat (which
# runs as {{ sys_user }} under its own cron) could not read the stamp. Check 7 fails closed on an
# unreadable stamp, so a PASSING drill would have paged "no restore drill has ever succeeded"
# forever. Observed 2026-08-19, on the first green run.
date +%s >"$STAMP"
chmod 0644 "$STAMP"
# The per-volume record check 8 reads for coverage. The global stamp above answers "is the drill
# alive"; this one answers "has THIS volume been proven", which rotation makes a different
# question — a green global stamp now means one of 25 volumes restored, not all of them.
cp "$STAMP" "${SUCCESS_DIR}/${PVC}"
chmod 0644 "${SUCCESS_DIR}/${PVC}"
logger -t longhorn-restore-drill "PASS: ${PVC} restored from ${BACKUP} (files=${FILES}, bytes=${BYTES})"
