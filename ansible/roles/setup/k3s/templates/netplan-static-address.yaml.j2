# Ansible-managed (setup/k3s, tasks/static-address.yml). Do not edit by hand.
#
# Pin this node's LAN address so k3s can start while the gateway's DHCP server is down.
# k3s binds {{ server_ip }} itself (etcd's peer listener, the apiserver's advertise address),
# so with no address on the link it crash-loops on `bind: cannot assign requested
# address`. A WAN outage that took the gateway's DHCP with it, spanning a reboot, kept the
# whole cluster down for ~70h from 2026-10-05 (#3882).
#
# DHCPv4 is switched OFF rather than kept alongside the static address: with both, the lease
# and the static config claim the same address, and whether networkd removes it when the
# lease is lost is not something this config should depend on. DNS does not come from the
# lease (this role renders resolv.conf), so the address and the default route are all the lease
# supplied. IPv6 router advertisements are still accepted, with their route metric pinned below.
#
# The gateway must keep {{ server_ip }} out of its DHCP pool (a reservation for this NIC's
# MAC, or a pool that ends below it). With DHCP off, nothing renews a lease, and an address
# the gateway thinks is free can be handed to another device.
#
# Lexically before 99-homelab-dns.yaml and after the installer's 00-/50- files, so these keys
# override the installer's `dhcp4: true` and the DNS file's overrides still merge on top.
network:
  version: 2
  # A loop over at most one link, so the empty default renders `ethernets:` with no links rather than a
  # bare `:` (static-address.yml skips the task then anyway).
  ethernets:
{% for link in [k3s_node_static_link] | select %}
    {{ link }}:
      dhcp4: false
      # The IPv6 default route arrives by router advertisement, and networkd gives it the
      # `[DHCP] RouteMetric`, or 1024 with none. netplan 1.1.2 has no `ra-overrides` metric key
      # and emits `[DHCP]` only with a DHCP client on, so `dhcp4: false` alone left the RA route
      # at 1024, behind wifi's 600, and IPv6 egress took wlo1 (#4561). `dhcp6: true` adds no
      # client in practice: the gateway's RA sets the M flag, so networkd already runs DHCPv6.
      dhcp6: true
      dhcp6-overrides:
        route-metric: 100
      # Configure the address even with no link. Carrier held through the 2026-10-05 outage,
      # but a gateway that is also the switch and loses power takes the link with it, and k3s
      # on this node needs the address to bind whether or not anything can reach it.
      # This also keeps the default route below installed with no carrier, so static-address.yml
      # sets ignore_routes_with_linkdown on the link, for IPv4 and IPv6, to let a fallback route
      # win (#4510).
      ignore-carrier: true
      addresses:
        - "{{ server_ip }}/{{ lan_subnet.split('/')[1] }}"
      routes:
        # Metric 100 matches the DHCP route this replaces.
        - to: default
          via: "{{ lan_router_ip }}"
          metric: 100
{% endfor %}
