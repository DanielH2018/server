---
# A read-only cluster identity for {{ sys_user }}, so day-to-day inspection and automated
# diagnostics don't need the admin kubeconfig at /etc/rancher/k3s/k3s.yaml (root:root 0640,
# reachable only through passworded sudo — which needs a TTY and so blocks anything
# unattended). Writes keep going through Ansible, which escalates properly.
#
# Bound to the built-in `view` ClusterRole PLUS the additive role below. `view` alone is not
# enough on this cluster: it grants no `nodes`, no `persistentvolumes`, no storageclasses,
# and nothing for the CRDs this homelab runs on. Nothing here aggregates into `view` either
# — only system:aggregate-to-view and system:aggregated-metrics-reader carry that label, so
# installing Traefik/MetalLB/Longhorn did not widen it.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ k3s_readonly_sa_name }}
  namespace: {{ k3s_readonly_sa_namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ k3s_readonly_sa_name }}-token
  namespace: {{ k3s_readonly_sa_namespace }}
  annotations:
    kubernetes.io/service-account.name: {{ k3s_readonly_sa_name }}
# A non-expiring token, deliberately. `kubectl create token` issues a bounded one, but it
# expires and the unattended caller it exists for has no way to mint a replacement. Revoke
# by deleting this Secret and the ServiceAccount.
type: kubernetes.io/service-account-token
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: {{ k3s_readonly_sa_name }}
rules:
  # The cluster-scoped objects `view` omits.
  - apiGroups: [""]
    resources: ["nodes", "persistentvolumes"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["storage.k8s.io"]
    resources: ["storageclasses", "volumeattachments"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["apiextensions.k8s.io"]
    resources: ["customresourcedefinitions"]
    verbs: ["get", "list", "watch"]
  # The CRDs this homelab actually runs on — IngressRoute/Middleware, IPAddressPool, and
  # the Longhorn volume/backup objects. Without these, checking whether a route or a backup
  # exists falls back to sudo.
{% for group in k3s_readonly_crd_api_groups %}
  - apiGroups: ["{{ group }}"]
    resources: ["*"]
    verbs: ["get", "list", "watch"]
{% endfor %}
# Deliberately absent, and each for a reason:
#   secrets      — `view` excludes them and so does this. Every credential the cluster holds
#                  is in one, so granting read here would hand over the whole secret store.
#   pods/exec    — a shell in any pod is arbitrary code execution as that workload, not a read.
#   pods/portforward — same reach as exec, over the network instead.
#   rbac.*       — reading the bindings maps the escalation paths without granting any.
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ k3s_readonly_sa_name }}-view
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: view
subjects:
  - kind: ServiceAccount
    name: {{ k3s_readonly_sa_name }}
    namespace: {{ k3s_readonly_sa_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ k3s_readonly_sa_name }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: {{ k3s_readonly_sa_name }}
subjects:
  - kind: ServiceAccount
    name: {{ k3s_readonly_sa_name }}
    namespace: {{ k3s_readonly_sa_namespace }}
