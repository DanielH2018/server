apiVersion: v1
kind: Secret
metadata:
  name: longhorn-r2
  namespace: longhorn-system
type: Opaque
stringData:
  # Same three keys as the B2 secret — Longhorn speaks S3 to both. Only the endpoint differs,
  # and R2's is account-scoped rather than region-scoped.
  AWS_ACCESS_KEY_ID: "{{ r2_access_key_id }}"
  AWS_SECRET_ACCESS_KEY: "{{ r2_secret_access_key }}"
  AWS_ENDPOINTS: "https://{{ r2_account_id }}.r2.cloudflarestorage.com"
