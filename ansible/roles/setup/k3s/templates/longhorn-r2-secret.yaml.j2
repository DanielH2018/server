apiVersion: v1
kind: Secret
metadata:
  name: longhorn-r2
  namespace: longhorn-system
type: Opaque
# `data:` with b64encode, not `stringData:`. Client-side `kubectl apply` reports `configured` for a
# stringData Secret on every run: the live object stores only `data`, so the three-way patch
# re-adds stringData and is never empty, and the apply task's changed_when never reads ok (#4341).
data:
  # Same three keys as the B2 secret — Longhorn speaks S3 to both. Only the endpoint differs,
  # and R2's is account-scoped rather than region-scoped.
  AWS_ACCESS_KEY_ID: "{{ r2_access_key_id | b64encode }}"
  AWS_SECRET_ACCESS_KEY: "{{ r2_secret_access_key | b64encode }}"
  AWS_ENDPOINTS: "{{ ('https://' ~ r2_account_id ~ '.r2.cloudflarestorage.com') | b64encode }}"
