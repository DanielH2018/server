# Kuma push credentials for live-drift-check.py — managed by Ansible (k3s role).
#
# Kept out of the script itself, which lands 0755 and is world-readable. Same split, and the
# same reasoning, as ping.env for the Healthchecks.io key.
# Single-quoted for the same reason as kuma-push.env: this is `set -a`-sourced by a root shell
# before the Python consumer runs, so an unquoted value is shell input rather than data
# (2026-08-23b review L5).
PUSH_TOKEN='{{ live_drift_push_token | default("") }}'
KUMA_HOST='uptime-kuma.local.{{ domain }}'
