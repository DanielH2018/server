#!/usr/bin/env bash
# Deployed-artifact drift check — managed by Ansible (k3s role); edits overwritten.
#
# Three arms, all answering "is what is live still what the repo says?": orphaned cluster objects
# that no staged manifest declares (below); copy:-deployed setup code that differs byte-for-byte
# from its source (second arm); and template:-rendered setup scripts whose SOURCE has changed
# since this host last rendered them (third arm, which the second structurally cannot cover).
#
# `kubectl apply -f <staged-dir>/` (k8s/manifests role) only ADDS/UPDATES what is IN the
# staged manifest set — it never removes a live object whose entry was deleted from the
# templates. Nothing else in this repo checks for that, so an apply-only deploy can leave a
# cluster object running forever after its template entry is gone. This is the exact shape of
# two live incidents on 2026-08-13: the claude-otel-ingest IngressRoute (observability
# namespace) is STILL RUNNING right now with no ownerReferences and no mention anywhere in
# ansible/roles/k8s/claude-otel/templates/ — confirmed live while writing this check — and Kuma
# monitors 300/301 outlived their static-monitors.yaml.j2 entries at E7.
#
# LIMITATION, by design: Kuma monitors are NOT checked here. AutoKuma reconciles those from a
# mix of live Docker labels and this role's static Secret, and a bash diff against that split
# source would be unreliable — see the header of static-monitors.yaml.j2 for why "removing an
# entry here may not reach the cluster" is already a known trap for THAT reconciliation path.
# The Kuma-monitor drift class needs its own fix, not a bolt-on here.
#
# Compares live objects against the STAGED rendered manifests under /etc/rancher/k3s/manifests/,
# not the .j2 templates: the staged copies are what `kubectl apply` actually acted on and are
# always current after a deploy, whereas re-rendering the templates here would need every
# role's vars and secrets. Runs as ROOT because those staged directories are mode 0700
# (k8s/manifests role) — root is needed for filesystem access, not extra cluster power: the
# kubectl calls stay scoped to the read-only ServiceAccount kubeconfig, same as the heartbeats
# beside it, so a bug here still cannot mutate the cluster.
#
# Matching is a plain `grep` for `name: <object-name>` in the staged YAML — textual, not
# structured. Known false-negative: a container/key that happens to be named identically to the
# orphaned object (in ANY staged file, not just its own kind) reads as "still declared" and the
# real orphan is missed.
#
# THE STAGED-FILE HOLE THIS USED TO WARN ABOUT IS CLOSED. It was real: k8s/manifests only wrote
# the files currently listed in manifests_files/manifests_secret_files and never deleted a staged
# file whose entry had been removed, so a stale render kept getting swept into every
# `kubectl apply -f <dir>/` — and this script's own grep then found the orphan's name in that
# stale file and reported a false "up" on exactly the incident it exists to catch. The
# "Prune staged manifests dropped from the file lists" task in roles/k8s/manifests/tasks/main.yml
# now deletes those files before the apply, so a name dropped from the list disappears from the
# staged set on the next deploy and this check sees the orphan. Deploy the owning role once after
# retiring a manifest: until that role next runs, its stale staged file is still on disk.
set -uo pipefail

# shellcheck source=/dev/null
source /usr/local/lib/kuma-push-lib.sh || {
  logger -t manifest-prune-check "kuma-push-lib.sh missing — run initial_setup on this host"
  exit 1
}

# Runs as root under cron, whose default PATH (/usr/bin:/bin) omits /usr/local/bin — where
# the k3s install script puts the binary. Without this, `k3s` resolves to nothing, the
# `kubectl get` calls below silently no-op (stderr swallowed by check_kind's 2>/dev/null),
# ORPHANS stays empty, and the check pushes a permanent false "up". Same trap as
# cron-path-omits-usr-local-bin.md; the sibling heartbeats beside this one (disk-health.sh.j2,
# longhorn-backup-health.sh.j2) don't set this either and should be checked for the same bug.
export PATH="/usr/local/bin:${PATH}"

export KUBECONFIG=/home/{{ sys_user }}/.kube/config
KUBECTL="k3s kubectl"
MANIFEST_ROOT=/etc/rancher/k3s/manifests

# A non-root `stat`/`-d` test on MANIFEST_ROOT itself still succeeds (only traverse permission
# on the parent is needed), but `grep -r` into its mode-0700 per-service subdirs then fails
# permission-denied on every one, and that failure is swallowed by check_kind's 2>/dev/null —
# indistinguishable from "no template declares this name". Every live object would misclassify
# as an orphan, and both push blocks below are unconditional, so a hand-run as a non-root user
# corrupts the real Kuma monitor and fires the healthchecks.io dead-man's switch on entirely
# false data. Must precede PUSH_TOKEN handling, the grep, the early -d push path, and both push
# blocks, so a non-root run pushes nothing at all.
if [[ $EUID -ne 0 ]]; then
  echo "must run as root: the staged manifest dirs under $MANIFEST_ROOT are mode 0700 (try: sudo $0)" >&2
  exit 64
fi

KUMA_HOST="uptime-kuma.local.{{ domain }}"
# Pinned to the cluster ingress VIP: Kuma serves from the k8s edge, and the Docker
# edge's bridge route for this name was removed in the slice-7 bridge teardown.
KUMA_RESOLVE_IP="{{ k3s_metallb_ingress_vip }}"
# Sourced, never inlined: this script lands 0755, so an inlined token is readable by every local
# account. 0640 root:{{ sys_user }} env file, same split as ping.env further down.
MANIFEST_PRUNE_PUSH_TOKEN=""
# shellcheck source=/dev/null
[[ -r /etc/rancher/k3s/kuma-push.env ]] && . /etc/rancher/k3s/kuma-push.env
PUSH_TOKEN="$MANIFEST_PRUNE_PUSH_TOKEN"

# The role must deploy cleanly before the operator has registered this secret (/add-secret) —
# skip the push rather than fail the cron until manifest_prune_push_token exists.
if [[ -z "$PUSH_TOKEN" ]]; then
  logger -t manifest-prune-check "manifest_prune_push_token not set — skipping push (see /add-secret)"
  exit 0
fi
PUSH_URL="https://${KUMA_HOST}/api/push/${PUSH_TOKEN}"

if [[ ! -d "$MANIFEST_ROOT" ]]; then
  STATUS=down
  MSG="${MANIFEST_ROOT} missing — no staged manifests to compare against"
  kuma_push "$STATUS" "$MSG" "$PUSH_URL" "$KUMA_HOST" "$KUMA_RESOLVE_IP" manifest-prune-check
  exit 0
fi

# Namespace/kind pairs this check does not own. kube-system and metallb-system ship their own
# objects outside our staged manifests, and `default` carries the kubectl-provisioned
# `kubernetes` Service, so every kind ("*") is excluded in those.
#
# longhorn-system was a blanket exclusion on the same reasoning, and that stopped being true on
# 2026-08-15: a9f32939 gave the Longhorn UI an ingress, making it the first namespace we stage
# objects into. A retired or renamed route there would have kept serving the storage control
# plane while every repo-side check read green. Its Services are still Longhorn's own (five, none
# carrying an ownerReference to skip them by), so `service` stays excluded there while the kinds
# we DO own are checked.
#
# longhorn-system gained two more kind exclusions on 2026-08-16 with the workload kinds below:
# Longhorn's own six Deployments (csi-*, longhorn-ui, longhorn-driver-deployer) and two
# DaemonSets carry no ownerReference — they come from the Longhorn install, not from a staged
# manifest, so every one of them would report as an orphan. longhorn-ui's IngressRoute is ours
# and stays checked; the workloads behind it are not.
#
# longhorn-system:networkpolicy joined on 2026-08-16 with the networkpolicy kind. The upstream
# Longhorn chart ships seven of them (backing-image-data-source, backing-image-manager,
# instance-manager, longhorn-manager, longhorn-manager-allow-metrics-scrape,
# longhorn-recovery-backend, longhorn-webhook), none carrying an ownerReference, and this repo
# renders none of them — every one would report as an orphan on the first tick.
EXCLUDED_NS_KINDS=(
  "kube-system:*"
  "metallb-system:*"
  "default:*"
  "longhorn-system:service"
  "longhorn-system:deployment"
  "longhorn-system:daemonset"
  "longhorn-system:networkpolicy"
)

ORPHANS=""
add_orphan() { ORPHANS="${ORPHANS:+$ORPHANS; }$1"; }

is_excluded_ns() {
  local ns="$1" kind="$2" entry entry_kind
  for entry in "${EXCLUDED_NS_KINDS[@]}"; do
    [[ "$ns" == "${entry%%:*}" ]] || continue
    entry_kind="${entry#*:}"
    [[ "$entry_kind" == "*" || "$entry_kind" == "$kind" ]] && return 0
  done
  return 1
}

check_kind() {
  local kind="$1" ns name owner
  while IFS=' ' read -r ns name owner; do
    [[ -z "$ns" || -z "$name" ]] && continue
    is_excluded_ns "$ns" "$kind" && continue
    # An ownerReference means a controller (Longhorn, MetalLB, ...) created this object as a
    # child of something else — our templates would never declare it, so its absence here is
    # expected, not drift.
    [[ -n "$owner" ]] && continue
    if ! grep -rlE "name: ${name}[[:space:]]*\$" "$MANIFEST_ROOT" >/dev/null 2>&1; then
      add_orphan "${kind}/${ns}/${name}"
    fi
  done < <($KUBECTL get "$kind" -A \
    -o jsonpath='{range .items[*]}{.metadata.namespace}{" "}{.metadata.name}{" "}{.metadata.ownerReferences}{"\n"}{end}' \
    2>/dev/null)
}

# tlsoption joined on 2026-08-15: the Longhorn UI stages one, and the kind had never been checked
# at all, so an orphan of it was invisible everywhere rather than in one namespace.
#
# deployment/daemonset/cronjob joined on 2026-08-16. Until then the check covered only routing
# objects, so a retired *workload* — the thing that actually consumes CPU, memory and a PVC —
# was invisible to it: drop a Deployment from manifests_files and its pods keep running forever
# while every repo-side check reads green. The routing kinds were the ones that had bitten us,
# not the ones with the most to lose.
#
# WHICH KINDS ARE DELIBERATELY ABSENT, from a live survey on 2026-08-16 rather than from taste —
# each would make this monitor red on day one, and a monitor nobody trusts is worse than none:
#   configmap  — 8 kube-root-ca.crt (one per namespace, no owner, injected by the apiserver) and
#                7 build-context-* ConfigMaps that k8s/image-builder creates at build time and
#                no template declares.
#   secret     — the read-only ServiceAccount this runs as is Forbidden on Secrets entirely
#                ("get list watch" does not cover them), so the query returns an error, not a
#                list, and every Secret would read as absent-from-live rather than orphaned.
#   pvc        — 43 unowned claims whose staging path (k8s/seed-volume creates some of them
#                outside the owning role's manifests_files) has not been audited. A false red on
#                the storage plane is the most expensive kind here; add it after the audit, not
#                before.
#
# networkpolicy joined on 2026-08-16 with the default-deny ingress baseline
# (docs/networkpolicy-default-deny.md). That design's central safety argument is that the
# baseline template must always be rendered, because deleting it leaves the live policy
# ENFORCING with nothing in the repo describing it — an orphan class whose failure mode is
# silent connection refusals rather than a missing route, and which nothing watched until now.
# The homelab namespace's four live policies (flaresolverr, headlamp, n8n-broker, registry) are
# all staged by their own roles, so this kind starts green; longhorn-system's seven are excluded
# above.
for KIND in ingressroute middleware service tlsoption deployment daemonset cronjob networkpolicy; do
  check_kind "$KIND"
done

# SECOND ARM: is the code deployed on this host the code in the repo?
#
# The k8s plane is deployed by the gitops tick and re-rendered on every run, so it converges on
# its own. The setup plane does not: /opt/gitops-deploy and /usr/local/bin are written only by a
# manual `initial_setup.yml`, and nothing compared them against the repo. On 2026-08-16 the
# deployer had been running 2-day-old code since a batch of fixes merged — with every monitor
# green, because a stale deployer still writes its `last_run` heartbeat exactly like a current
# one would. Nothing about the failure was visible from anything that watches it.
#
# Only `copy:`-deployed artifacts are compared. The heartbeat scripts beside this one are
# `template:`-rendered, so their on-disk form legitimately differs from the .j2 source and a
# digest comparison against it would report permanent drift — the shape this check exists to
# catch, rebuilt one level up. Rendering them here would need every role's vars and secrets, the
# same reason the orphan arm above reads staged manifests rather than templates.
REPO_DIR=/home/{{ sys_user }}/server
DRIFTED=""

check_deployed() {
  local live="$1" src="$2"
  [[ -r "$src" ]] || return 0            # not a file this repo ships on this host
  if [[ ! -r "$live" ]]; then
    DRIFTED="${DRIFTED:+$DRIFTED, }${live} (missing)"
    return 0
  fi
  cmp -s "$live" "$src" || DRIFTED="${DRIFTED:+$DRIFTED, }${live}"
}

check_deployed /opt/gitops-deploy/gitops_deploy.py \
  "${REPO_DIR}/ansible/roles/setup/gitops_deploy/files/gitops_deploy.py"
check_deployed /opt/gitops-deploy/deploy_logic.py \
  "${REPO_DIR}/ansible/roles/setup/gitops_deploy/files/deploy_logic.py"
check_deployed /opt/gitops-deploy/host_lib.py \
  "${REPO_DIR}/ansible/roles/setup/common/files/host_lib.py"

# THIRD ARM: are the TEMPLATE-rendered scripts current?
#
# The arm above deliberately cannot answer this — a rendered file differs from its .j2 by design.
# So the comparison happens one level up, on the source: health-crons.yml stamps each template's
# sha256 into the manifest below at render time, and this recomputes them from the repo. A
# mismatch means this host has not run initial_setup.yml since that template changed, so it is
# still executing the old rendered copy. Found 2026-08-23: longhorn-backup-health.sh was two
# commits stale for two days, and THIS script was six days stale, while the message below still
# read "deployed scripts match the repo".
#
# Missing manifest is NOT drift: initial_setup.yml writes it, so its absence means this host
# predates the mechanism. Say so rather than paging — the arm is unproven, not failing.
# A DIRECTORY of fragments, one per role and tag family, each written by the run that rendered
# those templates. Two things changed here on 2026-08-23b and both were coverage bugs:
#
#   * It was a single file whose entries were bare filenames joined onto a hardcoded k3s
#     templates dir, so this arm was structurally incapable of seeing any other role's
#     artifacts. Nine on this host were watched by nothing — both gitops-deploy units, both
#     renovate-notify units, secret-rotate.sh and its audit sibling, and fake-remux-health.sh.
#     The exit-75 unit fix sat merged-and-undeployed here for exactly that reason (review H1).
#     Entries now carry their own repo-relative path and this joins nothing.
#   * That one file was rewritten wholesale by every partial run, so `--tags manifest-prune`
#     declared all eight k3s scripts current while rendering one (review M6). A fragment is
#     rewritten only by a run carrying its own tags, so the others stay as they were — stale,
#     and reported as such.
#
# Per-host by construction: a fragment exists only where its role ran. daniel-pi's optimize_pi
# scripts are NOT covered by anything — that host runs no manifest-prune-check — and a flat glob
# over the repo would have stamped them here as if this host rendered them.
#
# Missing manifest is NOT drift: initial_setup.yml writes it, so its absence means this host
# predates the mechanism. Say so rather than paging — the arm is unproven, not failing.
RENDER_MANIFEST_DIR=/var/lib/homelab/setup-render-manifest.d
STALE=""
MANIFEST_NOTE=""
MANIFEST_ENTRIES=0

# `-s`, not `-r`: a zero-byte fragment is readable, contributes no lines, and would otherwise
# take the present branch and disarm this arm behind a confident green (review L2). The entry
# counter below is the same guard one level up, for a directory of empty or absent fragments.
for FRAGMENT in "$RENDER_MANIFEST_DIR"/*; do
  [[ -s "$FRAGMENT" ]] || continue
  while read -r TPL WANT; do
    [[ -n "$TPL" && -n "$WANT" ]] || continue
    MANIFEST_ENTRIES=$((MANIFEST_ENTRIES + 1))
    if [[ ! -r "${REPO_DIR}/${TPL}" ]]; then
      STALE="${STALE:+$STALE, }${TPL} (template gone from the repo)"
      continue
    fi
    HAVE=$(sha256sum "${REPO_DIR}/${TPL}" | cut -d' ' -f1)
    [[ "$HAVE" == "$WANT" ]] || STALE="${STALE:+$STALE, }${TPL}"
  done < "$FRAGMENT"
done

if [[ "$MANIFEST_ENTRIES" -eq 0 ]]; then
  MANIFEST_NOTE="; render manifest absent or empty (run initial_setup.yml once to arm the stale-script arm)"
fi

if [[ -z "$ORPHANS" && -z "$DRIFTED" && -z "$STALE" ]]; then
  STATUS=up
  # Names the arms it actually covered. The old wording — "deployed scripts match the repo" —
  # was true of the three copy:-deployed files and silently claimed the other twenty.
  MSG="no orphaned routing (IngressRoute/Middleware/Service/TLSOption), workload (Deployment/DaemonSet/CronJob) or policy (NetworkPolicy) objects found; deployed code and rendered setup scripts match the repo${MANIFEST_NOTE}"
else
  STATUS=down
  MSG=""
  [[ -n "$ORPHANS" ]] && MSG="live but absent from staged manifests: ${ORPHANS}"
  [[ -n "$DRIFTED" ]] && MSG="${MSG:+$MSG; }deployed code differs from the repo (run initial_setup.yml): ${DRIFTED}"
  [[ -n "$STALE" ]] && MSG="${MSG:+$MSG; }host is running an OLD render of (run initial_setup.yml): ${STALE}"
  MSG="${MSG}${MANIFEST_NOTE}"
fi

# Unconditional, before the push — see longhorn-backup-health.sh.j2 for the full rationale.
# Short version: the `|| logger` below only fires when the curl fails, so a successfully-pushed
# DOWN leaves no durable record and `probe.py alerts` can never reconstruct this monitor.
logger -t manifest-prune-check "status=${STATUS} ${MSG}"

kuma_push "$STATUS" "$MSG" "$PUSH_URL" "$KUMA_HOST" "$KUMA_RESOLVE_IP" manifest-prune-check

# Off-premises dead-man's switch — see longhorn-backup-health.sh.j2 for the full rationale.
# Short version: Kuma runs on the cluster this watches, so an outage silences both the push and
# the monitor. hc-ping.com alerts on the silence instead. Skipped when no key is configured.
# Sourced rather than inlined: this script is 0755, so an inlined key would be readable by
# every local account. The env file is 0640 root:{{ sys_user }} and this cron runs as root.
HC_PING_KEY=""
# shellcheck source=/dev/null
[[ -r /etc/healthchecks/ping.env ]] && . /etc/healthchecks/ping.env
if [[ -n "$HC_PING_KEY" ]]; then
  # Bare slug, never ?create=1 — a typo would silently create an unwatched, permanently-green check.
  HC_URL="https://hc-ping.com/${HC_PING_KEY}/manifest-prune-check"
  [[ "$STATUS" == "up" ]] || HC_URL="${HC_URL}/fail"
  # Deliberately NOT $MSG. That names live IngressRoute/Middleware objects — internal service
  # and hostname fragments — and Healthchecks.io stores ping bodies (first 100 kB). The status
  # is what has to escape the house; the detail stays in Kuma, which is on the LAN.
  curl -fsS --max-time 10 --retry 3 --data-raw "drift detected; object names withheld, see Kuma" \
    "$HC_URL" >/dev/null \
    || logger -t manifest-prune-check "healthchecks ping failed (status=${STATUS})"
fi
