---
# kube-apiserver audit policy — managed by Ansible (k3s role); edits overwritten.
#
# The apiserver reads this ONCE, at startup. A change here does not take effect until k3s
# restarts, which is why the task that writes it notifies the restart handler.
#
# LEVELS, and why this one. `Metadata` records who did what to which object, without request
# or response bodies. That answers the question this log exists for — "which session deleted
# that" — at a fraction of the volume of `Request`/`RequestResponse`, which would write every
# manifest this cluster applies into a file on the control-plane disk.
#
# Secrets are the deliberate exception, and in both directions. Secret WRITES reach the
# `Metadata` catch-all at the bottom, like every other write. Secret READS have their own
# `Metadata` rule ahead of the blanket read drop, because --secrets-encryption defends the
# etcd snapshot and does nothing against an API-level read. That rule is the only record
# that anyone read a credential, including a read RBAC refused. The control plane's own
# machine identities are dropped just ahead of it, so kubelet and apiserver Secret reads
# stay out of the file. How much volume that rule adds is unmeasured: this Prometheus does
# not scrape apiserver_request_total, so nobody can report the event rate.
#
# No level here ever records a Secret body. Logging bodies would write every credential in
# the cluster to a plaintext file on disk, which is the exact exposure --secrets-encryption
# is armed to close. An audit log that leaks what encryption protects is worse than none.
apiVersion: audit.k8s.io/v1
kind: Policy

# Requests that never reach a rule are not logged at all, so the omissions below are real
# filtering, not cosmetic ordering.
omitStages:
  # RequestReceived doubles the entry count and carries nothing the later stage lacks.
  - RequestReceived

rules:
  # ── dropped first: high-volume, low-value ─────────────────────────────────────────────
  # Ordering matters — the FIRST matching rule wins, so every `level: None` rule has to
  # precede the catch-all at the bottom or the catch-all logs everything anyway.

  # Secret reads by the control plane's own machine identities. The apiserver and kube-proxy
  # are dropped unconditionally at the `system:kube-proxy` rule below, but the Secret-read
  # rule that follows this one sits above that drop and would start logging them. The
  # `system:nodes` rule below is scoped to leases, so it never dropped a kubelet Secret read
  # at all — every kubelet mounting a Secret would land in the file without this.
  #
  # Both rules name the read verbs. A kubelet Secret WRITE is refused by the Node authorizer,
  # so an attempt is anomalous and must keep reaching the catch-all at the bottom.
  - level: None
    users: ["system:kube-proxy", "system:apiserver"]
    verbs: ["get", "list", "watch"]
    resources:
      - group: ""
        resources: ["secrets"]
  - level: None
    userGroups: ["system:nodes"]
    verbs: ["get", "list", "watch"]
    resources:
      - group: ""
        resources: ["secrets"]

  # Secret reads by everyone else — the one access --secrets-encryption cannot defend. It
  # encrypts what etcd stores, so an API-level read returns the value regardless, and this
  # rule is the only thing that records the read happened. It has to precede the blanket
  # read drop below, which would otherwise swallow it, and it deliberately precedes the
  # readonly ServiceAccount's own drop, because that SA's refused Secret reads are exactly
  # the signal wanted. `Metadata` names the reader, the Secret and the time, never the value.
  - level: Metadata
    verbs: ["get", "list", "watch"]
    resources:
      - group: ""
        resources: ["secrets"]

  # Pod logs, for the same reason and with the same placement constraint as Secret reads above:
  # reading a pod's log is a `get` on pods/log, so the blanket read drop below swallowed it and
  # nothing recorded it. The kept pod-subresource rule further down does NOT cover this — exec,
  # attach and portforward are connect/create verbs and so never meet the read drop, while this
  # one does. Logs are part of the same auto-approved reach into a container that rule exists to
  # record, and for several of these workloads they carry request detail, tokens in error traces,
  # and Authelia/CrowdSec specifics. Metadata names the reader, the pod and the time, never a line.
  - level: Metadata
    verbs: ["get", "list", "watch"]
    resources:
      - group: ""
        resources: ["pods/log"]

  # Reads. This cluster's controllers watch continuously, and a `get`/`list`/`watch` cannot
  # change state, so logging them buys nothing and would dominate the file.
  - level: None
    verbs: ["get", "list", "watch"]

  # The readonly ServiceAccount Claude sessions authenticate as. It holds `get list watch`
  # and nothing else (k3s_readonly_sa_name), so every request it makes except a Secret read
  # is already covered by the read rule above; this is belt-and-braces against the SA ever
  # being widened by accident, which would otherwise flood the log rather than surface. Keep
  # it below the Secret-read rule: this SA's Secret attempts must stay logged, refused or not.
  - level: None
    users: ["system:serviceaccount:{{ k3s_readonly_sa_namespace }}:{{ k3s_readonly_sa_name }}"]
    verbs: ["get", "list", "watch"]

  # Kubelet and node-lease heartbeats: one write per node every few seconds, forever.
  - level: None
    users: ["system:kube-proxy", "system:apiserver"]
  - level: None
    userGroups: ["system:nodes"]
    resources:
      - group: "coordination.k8s.io"
        resources: ["leases"]

  # Leader-election churn from Longhorn, MetalLB and the k3s controllers. Same shape as the
  # node leases: constant writes that say nothing about operator or agent activity.
  - level: None
    resources:
      - group: "coordination.k8s.io"
        resources: ["leases"]

  # Health and discovery endpoints — unauthenticated probes, no state.
  - level: None
    nonResourceURLs:
      - /healthz*
      - /livez*
      - /readyz*
      - /version
      - /metrics
      - /openapi/*
      - /api*

  # ── kept: everything that changes state, plus pod access ──────────────────────────────

  # Pod subresources are the reason this log exists. `exec`, `attach` and `portforward` are
  # auto-approved for agent sessions here and several of those pods mount Longhorn PVCs, so
  # an entry naming the user, the pod and the time is the only record that a session reached
  # inside a container at all.
  - level: Metadata
    resources:
      - group: ""
        resources: ["pods/exec", "pods/attach", "pods/portforward"]

  # Catch-all: every remaining request, which after the drops above means the writes —
  # create, update, patch, delete, deletecollection — plus anything a future resource adds.
  - level: Metadata
