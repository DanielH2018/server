#!/usr/bin/env bash
# Release-staleness drift check — managed by Ansible (k3s role); edits overwritten.
#
# Usage: release-staleness-check.sh [-h|--help]
# Takes no arguments. Cron job "Release staleness drift check" runs it as the deploy user every
# k3s_release_staleness_cron_minute minutes (cron file release-staleness-check). It reads the Kuma
# push token from /etc/rancher/k3s/kuma-push.env, fetches origin, and pushes the verdict. Running
# it by hand is safe, but it pushes to the Kuma monitor.
#
# THE GAP THIS CLOSES (issue #947). When gitops_deploy.py defers a non-auto-deployable k8s role
# change (`alert_deferred`'s `cs.k8s` branch), it fast-forwards the tree and pages Discord ONCE
# per SHA. The ff-merge clears `behind_since` -- the deployer's own durable "still behind" signal
# -- so every OTHER monitored marker reads clean while the cluster keeps running the old
# manifests. Renovate automerges digest bumps on the 20+ `k8s_autodeploy: false` roles, so this
# path runs unattended with one Discord line as its entire signal. See the `# DECIDED:` at the
# `cs.k8s` branch of `deploy_alerts.alert_deferred` (roles/setup/gitops_deploy/files/), the
# `#947` bullet in roles/setup/gitops_deploy/CLAUDE.md for the full account, and this role's
# CLAUDE.md for where this check sits among the other drift crons.
#
# THE SIGNAL. `roles/k8s/manifests/tasks/release_stamp.yml` records, per service, the commit that
# produced its applied manifests. `probe.py releases --stale-only` reads those records and
# compares each one's role paths (the service's own role, plus the entry-less shared roles that
# supply bytes to every service's manifests -- manifests, image-builder, arr-notification;
# `manifest_affecting_shared_roles()` derives the set, and the
# deploy-time roles beside them are deliberately out of it, #1636) against origin/master, and
# since #1993 also the inventory keys and shared macros that service's render reads --
# derived per changed path by `scripts/deploy_tools/narrow_broad.py`, the same rules the
# deployer's tick narrows a broad range with, so a merged `group_vars` or `ansible/templates/`
# change reads stale for exactly the services the tick would apply it to. A service whose
# role paths or read keys moved past its applied commit, or with no record at all, is stale.
# Unlike this role's other drift checks, this one needs no `kubectl` at all -- it is pure git
# history plus the JSON records already on disk.
#
# `git fetch` runs FIRST. Without it, `origin/master` is whatever this checkout last fetched, so
# a parked deployer (a broad hold, a dead timer) would read GREEN forever instead of catching up
# to what actually landed -- the exact failure mode this check exists to close.
set -uo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

# shellcheck source=/dev/null
source /usr/local/lib/kuma-push-lib.sh || {
  logger -t release-staleness-check "kuma-push-lib.sh missing — run initial_setup on this host"
  exit 1
}

KUMA_HOST="uptime-kuma.local.{{ domain }}"
# Pinned to the cluster ingress VIP, same reasoning as manifest-prune-check.sh beside this one:
# Kuma serves from the k8s edge and the Docker edge's bridge route for this name is gone.
KUMA_RESOLVE_IP="{{ k3s_metallb_ingress_vip }}"
# Sourced, never inlined: this script lands 0755, so an inlined token would be readable by every
# local account. 0640 root:{{ sys_user }} env file, shared with the other k3s health crons.
RELEASE_STALENESS_PUSH_TOKEN=""
# shellcheck source=/dev/null
[[ -r /etc/rancher/k3s/kuma-push.env ]] && . /etc/rancher/k3s/kuma-push.env
PUSH_TOKEN="$RELEASE_STALENESS_PUSH_TOKEN"

# The role must deploy cleanly before the operator has registered this secret (/add-secret) —
# skip the push rather than fail the cron until the token exists. Names the env var, not the
# registry secret, for the same reason as manifest-prune-check.sh beside this one: the secrets
# guard matches whole-word registry names against raw template text and would flag a log line
# that only names the variable.
if [[ -z "$PUSH_TOKEN" ]]; then
  logger -t release-staleness-check "RELEASE_STALENESS_PUSH_TOKEN not set — skipping push (see /add-secret)"
  exit 0
fi
PUSH_URL="https://${KUMA_HOST}/api/push/${PUSH_TOKEN}"

# The stale set the last DOWN pushed, for the re-alert below (#2378).
STATE_DIR=/var/lib/homelab/release-staleness
PREV_SET="${STATE_DIR}/stale-set"
NEW_SET="${STATE_DIR}/stale-set.new"
TRACK_SET=""
[[ -d "$STATE_DIR" && -w "$STATE_DIR" ]] && TRACK_SET=1

# A DOWN that is not a staleness verdict (the fetch or the probe itself failing) records an
# empty set when none is recorded yet. Without it, the first real verdict after one finds no
# previous set, pushes a plain DOWN onto a tile that is already DOWN, and Kuma sends nothing.
seed_empty_set() {
  [[ -n "$TRACK_SET" && ! -f "$PREV_SET" ]] && : > "$PREV_SET"
  return 0
}

REPO_DIR=/home/{{ sys_user }}/server
if ! FETCH_ERR="$(git -C "$REPO_DIR" fetch --quiet origin master 2>&1)"; then
  # The fetch reaches github.com, so one WAN outage would otherwise light this tile beside the WAN
  # tile — it did on 2026-09-18, for 3h ("git fetch origin master failed"). reachout_verdict probes
  # the link and reports a skip only when neither provider answers; a fetch GitHub itself refused
  # still pushes down. See kuma-push-lib.sh for why the probe classifies and not the error text.
  STATUS=down
  REACHOUT_NOTE=""
  # The library is deployed by initial_setup, while this cron is rendered by its own role, so a
  # narrowed apply can put the new script on a host whose /usr/local/lib copy predates
  # reachout_verdict. Without this the read below aborts on an unbound variable under `set -u` and
  # NO push happens at all — the tile reads stale-green to its heartbeat deadline, which is worse
  # than the page this change exists to stop. Same guard docs-refresh.sh.j2 carries.
  if command -v reachout_verdict >/dev/null 2>&1; then
    reachout_verdict release-staleness-check {{ wan_probe_urls | join(' ') }}
    STATUS="$REACHOUT_STATUS"
  fi
  MSG="${REACHOUT_NOTE}git fetch origin master failed in ${REPO_DIR}: ${FETCH_ERR}"
  logger -t release-staleness-check "status=${STATUS} ${MSG}"
  kuma_push "$STATUS" "$MSG" "$PUSH_URL" "$KUMA_HOST" "$KUMA_RESOLVE_IP" release-staleness-check
  seed_empty_set
  exit 0
fi

# UV absolute-pathed: cron's PATH lacks ~/.local/bin. --frozen: never rewrite uv.lock on this
# host — a rewrite would dirty the tree and wedge the GitOps deployer's dirty-skip, the same
# reason secret-rotation-audit.sh uses it.
UV=/home/{{ sys_user }}/.local/bin/uv
# --kuma: the verdict as ONE line grouped by reason (bridge.msgfmt). The per-service list ran
# to ~7,500 chars when a refused narrowing marked the whole fleet stale, and Discord rejects an
# embed field past 1024 chars, so the DOWN reached nobody (#2013). Names-only was the first fix;
# grouping keeps the reason. kuma_push caps the msg as a backstop. Not the journal either:
# `logger` cuts a line at 1 KiB, so the full list is one `--stale-only` run away.
# --grace-minutes: a merge younger than this is named but not counted, so a landing still
# deploying its own merge does not page (k3s_release_staleness_grace_minutes in defaults).
# --names-out: the counted set, one name per line, for the re-alert below. Passed only when the
# state directory is writable, so a host whose k3s role has not created it yet still gets a
# verdict rather than a traceback that reads as the check breaking.
NAMES_ARGS=()
if [[ -n "$TRACK_SET" ]]; then
  rm -f "$NEW_SET"
  NAMES_ARGS=(--names-out "$NEW_SET")
fi
OUTPUT="$(cd "$REPO_DIR" && "$UV" run --quiet --frozen python scripts/diagnostics/probe.py releases --stale-only --kuma --grace-minutes {{ k3s_release_staleness_grace_minutes }} "${NAMES_ARGS[@]}" 2>&1)"
RC=$?

if [[ $RC -eq 0 ]]; then
  STATUS=up
elif [[ $RC -eq 1 ]]; then
  STATUS=down
else
  # Anything else (a Python traceback, uv failing to sync) is the check itself breaking, not a
  # verdict about staleness — reported as down so it pages rather than reading as a clean fleet.
  STATUS=down
  OUTPUT="probe.py releases --stale-only exited ${RC}: ${OUTPUT}"
fi
MSG="$OUTPUT"

# RE-ALERT ON A CHANGED SET (#2378). Kuma notifies on a status TRANSITION only, plus the
# resendInterval count, and its push route accepts only `up` or `down`. So while the tile sat
# DOWN, a stale set that grew or shrank (one service redeployed, another merge landing) changed
# the tile's message and never reached Discord. When this run's counted set differs from the
# one the last DOWN pushed, the script pushes an `up` that says it is not a recovery, then the
# `down`: Kuma sends both notifications, and the second carries the current list.
# Considered and rejected: posting to Discord directly. That needs a webhook secret on this
# host and bypasses the Discord template every Kuma monitor shares (uptime-kuma CLAUDE.md).
# Grace-window services are not in the set: they do not move the verdict, so they do not
# re-alert either. The first DOWN has no previous set, and its own transition is the alert.
# No bash length or array-count expansions below: their brace-hash reads to Jinja as the start
# of a comment, so counts come from `wc` instead.
REALERT=""
if [[ $RC -eq 1 && -f "$PREV_SET" && -f "$NEW_SET" ]] && ! cmp -s "$PREV_SET" "$NEW_SET"; then
  ADDED_NAMES="$(LC_ALL=C comm -13 "$PREV_SET" "$NEW_SET" | paste -sd, -)"
  CLEARED_NAMES="$(LC_ALL=C comm -23 "$PREV_SET" "$NEW_SET" | paste -sd, -)"
  ADDED_N="$(LC_ALL=C comm -13 "$PREV_SET" "$NEW_SET" | wc -l)"
  CLEARED_N="$(LC_ALL=C comm -23 "$PREV_SET" "$NEW_SET" | wc -l)"
  # Names while they are short, counts alone past that, so a fleet-wide change cannot crowd the
  # current list out of the capped DOWN message.
  if [[ "$(printf '%s%s' "$ADDED_NAMES" "$CLEARED_NAMES" | wc -c)" -gt 300 ]]; then
    ADDED_NAMES=""
    CLEARED_NAMES=""
  fi
  PARTS=()
  [[ $ADDED_N -gt 0 ]] && PARTS+=("${ADDED_N} newly stale${ADDED_NAMES:+ (${ADDED_NAMES})}")
  [[ $CLEARED_N -gt 0 ]] && PARTS+=("${CLEARED_N} cleared${CLEARED_NAMES:+ (${CLEARED_NAMES})}")
  REALERT="Stale set changed: ${PARTS[0]}${PARTS[1]:+; ${PARTS[1]}}"
fi

if [[ -n "$REALERT" ]]; then
  UP_MSG="Not a recovery. ${REALERT}. The DOWN that follows carries the current list."
  logger -t release-staleness-check "status=up ${UP_MSG}"
  kuma_push up "$UP_MSG" "$PUSH_URL" "$KUMA_HOST" "$KUMA_RESOLVE_IP" release-staleness-check
  MSG="${REALERT}. ${OUTPUT}"
fi

logger -t release-staleness-check "status=${STATUS} ${MSG}"
kuma_push "$STATUS" "$MSG" "$PUSH_URL" "$KUMA_HOST" "$KUMA_RESOLVE_IP" release-staleness-check

# The set is recorded whatever the push outcome. A lost DOWN push is paged by monitor-bridge's
# swallowed-verdicts check, which reads kuma_push's failure line out of Loki. Reading the push
# result here would move this script into that check's HC_ROUTED_TAGS (verdicts/logs.py), the
# scripts it skips because they page their own lost push. A broken check (rc > 1) keeps the
# last good set, or seeds an empty one.
if [[ -n "$TRACK_SET" ]]; then
  if [[ $RC -eq 0 ]]; then
    rm -f "$PREV_SET"
  elif [[ $RC -eq 1 && -f "$NEW_SET" ]]; then
    mv -f "$NEW_SET" "$PREV_SET"
  else
    seed_empty_set
  fi
fi
rm -f "$NEW_SET"
