#!/usr/bin/env bash
# Release-staleness drift check — managed by Ansible (k3s role); edits overwritten.
#
# Usage: release-staleness-check.sh [-h|--help]
# Takes no arguments. Cron job "Release staleness drift check" runs it as the deploy user every
# k3s_release_staleness_cron_minute minutes (cron file release-staleness-check). It fetches origin
# and writes the verdict to $TEXTFILE_DIR/release-staleness-check.prom for node_exporter's
# textfile collector. Prometheus rules in host-checks.yaml page it through Alertmanager. Running
# it by hand is safe.
#
# THE GAP THIS CLOSES (issue #947). When gitops_deploy.py defers a non-auto-deployable k8s role
# change (`alert_deferred`'s `cs.k8s` branch), it fast-forwards the tree and pages Discord ONCE
# per SHA. The ff-merge clears `behind_since` -- the deployer's own durable "still behind" signal
# -- so every OTHER monitored marker reads clean while the cluster keeps running the old
# manifests. Renovate automerges digest bumps on the 20+ `k8s_autodeploy: false` roles, so this
# path runs unattended with one Discord line as its entire signal. See the `# DECIDED:` at the
# `cs.k8s` branch of `deploy_alerts.alert_deferred` (roles/setup/gitops_deploy/files/), the
# `#947` bullet in roles/setup/gitops_deploy/CLAUDE.md for the full account, and this role's
# CLAUDE.md for where this check sits among the other drift crons.
#
# THE SIGNAL. `roles/k8s/manifests/tasks/release_stamp.yml` records, per service, the commit that
# produced its applied manifests. `probe.py releases --stale-only` reads those records and
# compares each one's role paths (the service's own role, plus the entry-less shared roles that
# supply bytes to every service's manifests -- manifests, image-builder, arr-notification;
# `manifest_affecting_shared_roles()` derives the set, and the
# deploy-time roles beside them are deliberately out of it, #1636) against origin/master, and
# since #1993 also the inventory keys and shared macros that service's render reads --
# derived per changed path by `scripts/deploy_tools/narrow_lib/broad.py`, the same rules the
# deployer's tick narrows a broad range with, so a merged `group_vars` or `ansible/templates/`
# change reads stale for exactly the services the tick would apply it to. A service whose
# role paths or read keys moved past its applied commit, or with no record at all, is stale.
# Unlike this role's other drift checks, this one needs no `kubectl` at all -- it is pure git
# history plus the JSON records already on disk.
#
# `git fetch` runs FIRST. Without it, `origin/master` is whatever this checkout last fetched, so
# a parked deployer (a broad hold, a dead timer) would read GREEN forever instead of catching up
# to what actually landed -- the exact failure mode this check exists to close.
set -uo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

# shellcheck source=/dev/null
source /usr/local/lib/homelab-check-lib.sh || {
  logger -t release-staleness-check "homelab-check-lib.sh missing — run initial_setup on this host"
  exit 1
}

# The longest legitimate gap between two textfile writes: two cron periods plus 300s. One period is
# the normal gap, the second is a slot that a boot grace or a failed run skips, and the 300s covers
# cron start jitter, the 1m `node` scrape and the 1m rule evaluation. Rendered from the cron's own
# minute, read as `*/N`. Any other shape has no single period, so the render fails rather than
# publish a deadline shorter than the real gap. ansible/tests/services/test_b1_rule_literals.py
# pins the rule's literal to this value.
{% set _every_n = k3s_release_staleness_cron_minute | string | regex_replace('^[*]/([0-9]+)$', '\\1') %}
{% if _every_n.isdigit() and '*/' ~ _every_n == k3s_release_staleness_cron_minute | string %}
DEADLINE_S={{ 2 * 60 * (_every_n | int) + 300 }}
{% else %}
{{ release_staleness_cron_minute_not_every_n | mandatory('k3s_release_staleness_cron_minute must be */N for this script to derive DEADLINE_S, got ' ~ k3s_release_staleness_cron_minute) }}
{% endif %}
TEXTFILE_DIR=${TEXTFILE_DIR:-/var/lib/node-exporter-textfile}

# The stale set the last DOWN recorded, for the changed-set log line below (#2378).
STATE_DIR=/var/lib/homelab/release-staleness
PREV_SET="${STATE_DIR}/stale-set"
NEW_SET="${STATE_DIR}/stale-set.new"
TRACK_SET=""
[[ -d "$STATE_DIR" && -w "$STATE_DIR" ]] && TRACK_SET=1

# A DOWN that is not a staleness verdict (the fetch or the probe itself failing) records an
# empty set when none is recorded yet. Without it, the first real verdict after one finds no
# previous set, so its log line cannot say that the set changed.
seed_empty_set() {
  [[ -n "$TRACK_SET" && ! -f "$PREV_SET" ]] && : > "$PREV_SET"
  return 0
}

# The run's verdict as one line, `status=<up|down> <text>`, which the SessionStart banner reads
# (.claude/hooks/hooklib/service_lines.py:stale_release_problems, #6183). The text is the probe's
# own output, never the re-alert's `Stale set changed:` prefix, so the banner's parser always sees
# one of msgfmt's shapes. chmod by hand: sessions run as another user than this cron, and the file
# is replaced by a rename so the banner never reads a half-written line.
VERDICT_FILE="${STATE_DIR}/verdict"
write_verdict() {
  [[ -n "$TRACK_SET" ]] || return 0
  if ! { printf 'status=%s %s\n' "$1" "$2" > "${VERDICT_FILE}.tmp" \
    && chmod 0644 "${VERDICT_FILE}.tmp" \
    && mv -f "${VERDICT_FILE}.tmp" "$VERDICT_FILE"; }; then
    logger -t release-staleness-check "verdict write to ${VERDICT_FILE} failed (status=$1)"
  fi
  return 0
}

REPO_DIR=/home/{{ sys_user }}/server
# The link is probed BEFORE the fetch as well as after a failed one (#5308). A fetch started inside
# an outage can hang until the link is back, so a probe run only after it fails sees a healthy link
# and reports the outage as a staleness fault. On 2026-10-16 the 19:00 run's fetch hung ~2 minutes,
# failed as the link returned, and the tile read DOWN until 19:30 with no service stale. A fetch
# that fails while EITHER probe saw the link down is a skip. A healthy run pays one request.
LINK_DOWN_AT_START=""
if command -v wan_reachable >/dev/null 2>&1 \
  && ! wan_reachable release-staleness-check {{ wan_probe_urls | join(' ') }}; then
  LINK_DOWN_AT_START=1
fi
FETCH_OK=1
FETCH_ERR="$(git -C "$REPO_DIR" fetch --quiet origin master 2>&1)" || FETCH_OK=""
# `cannot lock ref` is another fetch of origin/master in this checkout holding its .lock: the
# GitOps tick fetches every 10 minutes, so every */30 run of this cron shares a minute with one.
# On 2026-10-25 that read DOWN for 30 minutes (#6816). The lock lasts as long as the other fetch,
# so one retry after it finishes is enough; a lock still held then is reported as before.
if [[ -z "$FETCH_OK" && "$FETCH_ERR" == *"cannot lock ref"* ]]; then
  sleep 20
  FETCH_OK=1
  FETCH_ERR="$(git -C "$REPO_DIR" fetch --quiet origin master 2>&1)" || FETCH_OK=""
  [[ -z "$FETCH_OK" ]] && FETCH_ERR="(retried once after a ref-lock failure) ${FETCH_ERR}"
fi
if [[ -z "$FETCH_OK" ]]; then
  # The fetch reaches github.com, so one WAN outage would otherwise light this tile beside the WAN
  # tile — it did on 2026-09-18, for 3h ("git fetch origin master failed"). reachout_verdict probes
  # the link and reports a skip only when neither provider answers; a fetch GitHub itself refused
  # still reads down. See homelab-check-lib.sh for why the probe classifies and not the error text.
  STATUS=down
  REACHOUT_NOTE=""
  if [[ -n "$LINK_DOWN_AT_START" ]]; then
    STATUS=up
    REACHOUT_NOTE="skipped: WAN unreachable when the fetch started — "
  fi
  # The library is deployed by initial_setup, while this cron is rendered by its own role, so a
  # narrowed apply can put the new script on a host whose /usr/local/lib copy predates
  # reachout_verdict. Without this the read below aborts on an unbound variable under `set -u` and
  # NO verdict is written at all — the check reads stale-green until its deadline, which is worse
  # than the page this change exists to stop. Same guard docs-refresh.sh.j2 carries.
  if [[ -z "$LINK_DOWN_AT_START" ]] && command -v reachout_verdict >/dev/null 2>&1; then
    reachout_verdict release-staleness-check {{ wan_probe_urls | join(' ') }}
    STATUS="$REACHOUT_STATUS"
  fi
  MSG="${REACHOUT_NOTE}git fetch origin master failed in ${REPO_DIR}: ${FETCH_ERR}"
  logger -t release-staleness-check "status=${STATUS} ${MSG}"
  write_verdict "$STATUS" "$MSG"
  # The textfile, as at the end of the script. This run's verdict is the fetch's.
  SUCCESS=0
  [[ "$STATUS" == "up" ]] && SUCCESS=1
  write_check_textfile release-staleness-check "$SUCCESS" "$(date +%s)" "$DEADLINE_S" \
    || logger -t release-staleness-check "textfile write to ${TEXTFILE_DIR} failed (status=${STATUS})"
  seed_empty_set
  exit 0
fi

# UV absolute-pathed: cron's PATH lacks ~/.local/bin. --frozen: never rewrite uv.lock on this
# host — a rewrite would dirty the tree and wedge the GitOps deployer's dirty-skip, the same
# reason secret-rotation-audit.sh uses it.
UV=/home/{{ sys_user }}/.local/bin/uv
# --kuma: the verdict as ONE line grouped by reason (bridge.msgfmt). The per-service list ran
# to ~7,500 chars when a refused narrowing marked the whole fleet stale, and Discord rejects an
# embed field past 1024 chars, so the DOWN reached nobody (#2013). Names-only was the first fix;
# grouping keeps the reason. Not the journal either: `logger` cuts a line at 1 KiB, so the full
# list is one `--stale-only` run away.
# --grace-minutes: a merge younger than this is named but not counted, so a landing still
# deploying its own merge does not page (k3s_release_staleness_grace_minutes in defaults).
# --names-out: the counted set, one name per line, for the re-alert below. Passed only when the
# state directory is writable, so a host whose k3s role has not created it yet still gets a
# verdict rather than a traceback that reads as the check breaking.
NAMES_ARGS=()
if [[ -n "$TRACK_SET" ]]; then
  rm -f "$NEW_SET"
  NAMES_ARGS=(--names-out "$NEW_SET")
fi
OUTPUT="$(cd "$REPO_DIR" && "$UV" run --quiet --frozen python scripts/diagnostics/probe.py releases --stale-only --kuma --grace-minutes {{ k3s_release_staleness_grace_minutes }} "${NAMES_ARGS[@]}" 2>&1)"
RC=$?

if [[ $RC -eq 0 ]]; then
  STATUS=up
elif [[ $RC -eq 1 ]]; then
  STATUS=down
else
  # Anything else (a Python traceback, uv failing to sync) is the check itself breaking, not a
  # verdict about staleness — reported as down so it pages rather than reading as a clean fleet.
  STATUS=down
  OUTPUT="probe.py releases --stale-only exited ${RC}: ${OUTPUT}"
fi
MSG="$OUTPUT"

# CHANGED SET (#2378). While the check stays DOWN, a stale set that grew or shrank (one service
# redeployed, another merge landing) changes the verdict's text and does not notify again:
# Alertmanager repeats a firing alert on its own interval and the alert carries no list. When this
# run's counted set differs from the one the last DOWN recorded, the script logs the change, and
# `probe.py releases --stale-only` prints the current list. Kuma's re-notify on a changed set
# went with its tile (M6 batch B1), an accepted loss: D6.17 disarms this check.
# Grace-window services are not in the set: they do not move the verdict, so they do not count
# as a change either. The first DOWN has no previous set, and its own alert is the notice.
# No bash length or array-count expansions below: their brace-hash reads to Jinja as the start
# of a comment, so counts come from `wc` instead.
REALERT=""
if [[ $RC -eq 1 && -f "$PREV_SET" && -f "$NEW_SET" ]] && ! cmp -s "$PREV_SET" "$NEW_SET"; then
  ADDED_NAMES="$(LC_ALL=C comm -13 "$PREV_SET" "$NEW_SET" | paste -sd, -)"
  CLEARED_NAMES="$(LC_ALL=C comm -23 "$PREV_SET" "$NEW_SET" | paste -sd, -)"
  ADDED_N="$(LC_ALL=C comm -13 "$PREV_SET" "$NEW_SET" | wc -l)"
  CLEARED_N="$(LC_ALL=C comm -23 "$PREV_SET" "$NEW_SET" | wc -l)"
  # Names while they are short, counts alone past that, so a fleet-wide change cannot crowd the
  # current list out of the capped DOWN message.
  if [[ "$(printf '%s%s' "$ADDED_NAMES" "$CLEARED_NAMES" | wc -c)" -gt 300 ]]; then
    ADDED_NAMES=""
    CLEARED_NAMES=""
  fi
  PARTS=()
  [[ $ADDED_N -gt 0 ]] && PARTS+=("${ADDED_N} newly stale${ADDED_NAMES:+ (${ADDED_NAMES})}")
  [[ $CLEARED_N -gt 0 ]] && PARTS+=("${CLEARED_N} cleared${CLEARED_NAMES:+ (${CLEARED_NAMES})}")
  REALERT="Stale set changed: ${PARTS[0]}${PARTS[1]:+; ${PARTS[1]}}"
fi

if [[ -n "$REALERT" ]]; then
  MSG="${REALERT}. ${OUTPUT}"
fi

logger -t release-staleness-check "status=${STATUS} ${MSG}"
write_verdict "$STATUS" "$OUTPUT"
# The textfile: this is the run's one verdict. The producer metric contract is
# docs/target-architecture/monitoring/m3-textfile-timer.md, and homelab-check-lib.sh writes the
# file atomically. A failed write logs and the run goes on.
SUCCESS=0
[[ "$STATUS" == "up" ]] && SUCCESS=1
write_check_textfile release-staleness-check "$SUCCESS" "$(date +%s)" "$DEADLINE_S" \
  || logger -t release-staleness-check "textfile write to ${TEXTFILE_DIR} failed (status=${STATUS})"

# The set is recorded whatever the textfile outcome. A broken check (rc > 1) keeps the last good
# set, or seeds an empty one.
if [[ -n "$TRACK_SET" ]]; then
  if [[ $RC -eq 0 ]]; then
    rm -f "$PREV_SET"
  elif [[ $RC -eq 1 && -f "$NEW_SET" ]]; then
    mv -f "$NEW_SET" "$PREV_SET"
  else
    seed_empty_set
  fi
fi
rm -f "$NEW_SET"
