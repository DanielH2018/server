#!/usr/bin/env bash
# Off-box etcd snapshot — managed by Ansible (k3s role); edits overwritten.
#
# k3s's own scheduled snapshots write to ${data-dir}/server/db/snapshots on this host's disk.
# That covers an accidental `kubectl delete` and nothing else: the disk holding the snapshots is
# the disk whose loss the snapshot exists for. This uploads one to R2 daily so a copy survives
# daniel-box. See k3s_etcd_s3_* in the role defaults for why this is a cron rather than the
# `--etcd-s3` server flags (short version: a server-arg change restarts the control plane, and
# LAN DNS is behind it).
#
# WHAT THIS DOES NOT COVER. An etcd snapshot restores the cluster's OBJECTS — Deployments,
# Services, Secrets, PVC bindings. It does not restore PVC *contents*: that is Longhorn's
# backups, in the same bucket under the `longhorn` prefix. A full recovery needs both, and the
# order matters — restore etcd first so the PVC objects exist, then restore the volumes.
# docs/k3s-etcd-restore.md has the procedure.
#
# IT ALSO NO LONGER CARRIES THE SECRETS IN A USABLE FORM. Since --secrets-encryption was armed
# (2026-08-20) Secrets are encrypted in etcd, so restoring this snapshot onto a REBUILT host
# needs the CLUSTER TOKEN (/var/lib/rancher/k3s/server/token) supplied first. The token is
# deliberately NOT uploaded beside the snapshot: storing it in this bucket would hand anyone with
# the bucket both halves and undo the encryption entirely. Restoring onto daniel-box with its
# disk intact is unaffected.
#
# Corrected 2026-08-23: this comment used to name encryption-config.json as the thing to preserve.
# That file's CONTENTS ride inside the snapshot's own /bootstrap blob (verified against k3s
# v1.36.3+k3s1), encrypted with the token — so the token is the artifact that must survive
# daniel-box, and it is the only one. docs/k3s-etcd-restore.md carries the evidence.
set -uo pipefail

# shellcheck source=/dev/null
source /usr/local/lib/kuma-push-lib.sh || {
  logger -t etcd-snapshot-offbox "kuma-push-lib.sh missing — run initial_setup on this host"
  exit 1
}

# Cron's PATH (/usr/bin:/bin) omits /usr/local/bin, where the k3s install script puts the binary.
# Without this the snapshot silently never runs and this script pushes a permanent false "up" —
# the same trap documented in cron-path-omits-usr-local-bin.md and guarded the same way in
# manifest-prune-check.sh beside it.
export PATH="/usr/local/bin:${PATH}"

KUMA_HOST="uptime-kuma.local.{{ domain }}"
# Pinned to the cluster ingress VIP, same as the sibling heartbeats: this name resolves through
# Pi-hole's wildcard, and a DNS outage is exactly when the push must still land.
KUMA_RESOLVE_IP="{{ k3s_metallb_ingress_vip }}"
# Sourced, never inlined: this script lands 0755, so an inlined token is readable by every local
# account. 0640 root:{{ sys_user }} env file, the same split the R2 credentials below already use
# (one tier stricter there, because those are write credentials for the backup store).
ETCD_SNAPSHOT_PUSH_TOKEN=""
# shellcheck source=/dev/null
[[ -r /etc/rancher/k3s/kuma-push.env ]] && . /etc/rancher/k3s/kuma-push.env
PUSH_TOKEN="$ETCD_SNAPSHOT_PUSH_TOKEN"

push_kuma() {
  local status="$1" msg="$2"
  [[ -z "$PUSH_TOKEN" ]] && return 0
  kuma_push "$status" "$msg" "https://${KUMA_HOST}/api/push/${PUSH_TOKEN}" \
    "$KUMA_HOST" "$KUMA_RESOLVE_IP" etcd-snapshot-offbox
}

# Off-premises dead-man's switch — see longhorn-backup-health.sh.j2 for the full rationale. Kuma
# runs on the cluster this backs up, so an outage silences both the push and the monitor;
# hc-ping.com alerts on the silence instead. Sourced, not inlined: this script is 0755.
push_healthchecks() {
  local status="$1"
  HC_PING_KEY=""
  # shellcheck source=/dev/null
  [[ -r /etc/healthchecks/ping.env ]] && . /etc/healthchecks/ping.env
  # Positive `-n` guard rather than an early `-z` return: test_healthchecks_pings.py matches this
  # shape specifically, so that an unconfigured host provably cannot curl a malformed URL.
  if [[ -n "$HC_PING_KEY" ]]; then
    # Bare slug, never ?create=1 — a typo would silently create an unwatched, permanently-green check.
    local url="https://hc-ping.com/${HC_PING_KEY}/etcd-snapshot-offbox"
    [[ "$status" == "up" ]] || url="${url}/fail"
    curl -fsS --max-time 10 --retry 3 "$url" >/dev/null \
      || logger -t etcd-snapshot-offbox "healthchecks ping failed (status=${status})"
  fi
}

# Every exit path reports through here, and the log line is UNCONDITIONAL — see
# longhorn-backup-health.sh.j2 for the full rationale, and manifest-prune-check.sh.j2 for the same
# pattern. Short version: the `|| logger` inside the push helpers only fires when the curl itself
# fails, so a successfully-pushed status leaves no durable local record. That makes journald
# silence ambiguous — a run that succeeded quietly and a cron that never fired look identical —
# and it is what `probe.py alerts` reads to reconstruct a monitor's history from Loki. Bit for
# real on 2026-08-16: the first manual run of this script produced no output and no journal entry,
# and proving it had worked needed root and a `kubectl get etcdsnapshotfile`.
report() {
  local status="$1" msg="$2"
  logger -t etcd-snapshot-offbox "status=${status} ${msg}"
  push_kuma "$status" "$msg"
  push_healthchecks "$status"
}

# Armed state is rendered as a value and branched on at RUNTIME rather than with a Jinja
# `{% raw %}{% if %}{% endraw %}` around an early exit: a template that renders two different
# shapes makes half the script unreachable in whichever shape validate_shell_templates renders,
# and shellcheck flags it (SC2317). Also no `| bool` — that validator renders with a plain Jinja
# environment which has no Ansible filters.
ARMED="{{ 1 if k3s_etcd_s3_armed else 0 }}"
if [[ "$ARMED" != "1" ]]; then
  # Report the disarmed state rather than exiting silently green, so a deliberate pause is
  # visible in Kuma instead of looking like a healthy backup.
  report down "off-box etcd snapshots are DISARMED (k3s_etcd_s3_armed=false)"
  exit 0
fi

# Credentials come from a 0600 root-only env file, not from this 0755 script and not from the
# command line: k3s reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from the environment, so the
# keys never appear in `ps` output the way --s3-access-key would.
if [[ ! -r /etc/rancher/k3s/etcd-s3.env ]]; then
  report down "/etc/rancher/k3s/etcd-s3.env missing — cannot authenticate to R2"
  exit 0
fi
# shellcheck source=/dev/null
. /etc/rancher/k3s/etcd-s3.env

if [[ -z "${AWS_ACCESS_KEY_ID:-}" || -z "${AWS_SECRET_ACCESS_KEY:-}" || -z "${ETCD_S3_BUCKET:-}" || -z "${ETCD_S3_ENDPOINT:-}" ]]; then
  report down "etcd-s3.env is present but incomplete — check r2_* secrets in SOPS"
  exit 0
fi
export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY

# --name is a BASE name; k3s appends the node name and a UNIX timestamp, so successive runs do
# not overwrite each other and --s3-retention has distinct objects to age out.
OUTPUT=$(k3s etcd-snapshot save \
  --name offbox \
  --snapshot-compress \
  --s3 \
  --s3-bucket "$ETCD_S3_BUCKET" \
  --s3-folder "{{ k3s_etcd_s3_folder }}" \
  --s3-endpoint "$ETCD_S3_ENDPOINT" \
  --s3-region "{{ k3s_longhorn_r2_region }}" \
  --s3-retention {{ k3s_etcd_s3_retention }} 2>&1)
RC=$?

if [[ $RC -eq 0 ]]; then
  SNAP_STATUS=up
  SNAP_MSG="etcd snapshot uploaded to s3://${ETCD_S3_BUCKET}/{{ k3s_etcd_s3_folder }}"
else
  # The message reaches Kuma on the LAN and the local journal. It can name the bucket; the keys
  # are never in $OUTPUT because they were passed through the environment.
  SUMMARY=$(printf '%s' "$OUTPUT" | tail -n 3 | tr '\n' ' ')
  SNAP_STATUS=down
  SNAP_MSG="etcd snapshot FAILED (rc=${RC}): ${SUMMARY}"
fi

# --- Has the cluster token drifted from the copy that can actually decrypt these snapshots? ---
#
# The token is what decrypts the /bootstrap blob in every snapshot above (see the header). It is
# held out of band, in the password manager, and docs/k3s-etcd-restore.md correctly says nothing
# can check THAT COPY STILL EXISTS. But that exemption is narrower than it reads: whether the LIVE
# token still matches what was copied is a sha256 comparison, and until 2026-08-31 nothing did it.
# `k3s token rotate --new-token` exists on the installed binary, so one deliberate command leaves
# the cluster Ready, every monitor green, and every snapshot from that moment on undecryptable
# with the copy anyone holds. The weekly restore drill cannot see it either — it reads the LIVE
# token off this disk, so it passes identically before and after a rotation.
#
# The stamp is written BY THE OPERATOR, at the moment the out-of-band copy is taken, and by
# nothing else. Ansible must never create it: an absent -> create step would cure the condition
# before this arm could report it, making the check a tautology on any host that lost the stamp.
# That is the same self-re-baselining hole that rules out recording the hash in host_vars.
#
# It runs AFTER the upload on purpose. The snapshot is the thing being protected — a token
# problem must never stop one being taken, which is why this is not an early `report down; exit`
# like the disarmed and missing-credentials branches above.
#
# What it proves is narrow, and saying so here is deliberate: "unchanged since stamped", NOT "the
# off-box copy is valid". A green arm is not a reason to skip re-copying the token.
TOKEN_FILE=/var/lib/rancher/k3s/server/token
TOKEN_STAMP=/var/lib/homelab/etcd-token.sha256
DRIFT_MSG=""
if [[ ! -r "$TOKEN_FILE" ]]; then
  # Fails closed: unreadable is reported, never assumed fine.
  DRIFT_MSG="cannot read ${TOKEN_FILE} — cluster-token drift UNVERIFIED"
elif [[ ! -f "$TOKEN_STAMP" ]]; then
  DRIFT_MSG="cluster-token baseline missing — copy the token out of band, then run: sha256sum ${TOKEN_FILE} | awk '{print \$1}' | install -m 0600 -D /dev/stdin ${TOKEN_STAMP}"
elif [[ ! -r "$TOKEN_STAMP" ]]; then
  DRIFT_MSG="${TOKEN_STAMP} exists but is unreadable — cluster-token drift UNVERIFIED"
else
  LIVE_HASH=$(sha256sum "$TOKEN_FILE" 2>/dev/null | awk '{print $1}')
  STAMPED_HASH=$(tr -d '[:space:]' < "$TOKEN_STAMP")
  if [[ -z "$LIVE_HASH" || -z "$STAMPED_HASH" ]]; then
    DRIFT_MSG="cluster-token hash unreadable on one side — drift UNVERIFIED"
  elif [[ "$LIVE_HASH" != "$STAMPED_HASH" ]]; then
    # Only the first 8 hex chars, and only of a HASH — enough to tell two states apart in a
    # message, never enough to reconstruct the token.
    DRIFT_MSG="CLUSTER TOKEN ROTATED since the off-box copy was taken (live ${LIVE_HASH:0:8}… vs stamped ${STAMPED_HASH:0:8}…) — every off-box snapshot is undecryptable with the held copy until you re-copy it and re-stamp"
  fi
fi

if [[ -n "$DRIFT_MSG" ]]; then
  # Down even when the upload succeeded: a snapshot nobody can decrypt is not a backup. This does
  # fail the off-premises dead-man alongside Kuma, and that is the intended reading — the restore
  # path is genuinely unproven in every branch above.
  report down "${SNAP_MSG}; ${DRIFT_MSG}"
else
  report "$SNAP_STATUS" "${SNAP_MSG}; cluster token unchanged since stamped"
fi
