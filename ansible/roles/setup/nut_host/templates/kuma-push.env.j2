# Kuma push token for the UPS secondary watchdog — managed by Ansible (nut_host role).
# Sourced by /usr/local/bin/ups-secondary-health.sh, never inlined into it: the token is enough
# to forge or suppress this heartbeat, and a sourced 0640 file keeps it out of any world-readable
# script and out of curl's argv.
#
# This role renders its OWN file rather than adding a key to /etc/rancher/k3s/kuma-push.env.
# That one is a whole-content template owned by roles/setup/k3s, so a key added from here would
# vanish on that role's next run.
#
# Selected per host, not shared: this role is now armed on both daniel-box and ups_host
# (daniel-server), and two pushers writing the SAME token would let either host's `up` satisfy
# Kuma's push deadline — daniel-server's beat would mask a dead daniel-box watchdog (issue #952).
# `| mandatory` turns a missed selection into a deploy-time failure instead of silence: the
# script's own empty-token branch is a bare `logger …; exit 0` (ups-secondary-health.sh.j2),
# so nothing downstream would ever surface a token that resolved empty.
{% if inventory_hostname == ups_host %}
UPS_SECONDARY_PUSH_TOKEN="{{ ups_secondary_daniel_server_push_token | mandatory }}"
{% else %}
UPS_SECONDARY_PUSH_TOKEN="{{ ups_secondary_push_token | mandatory }}"
{% endif %}
