#!/usr/bin/env bash
# Host-side UPS secondary watchdog — managed by Ansible (nut_host role); edits overwritten.
#
# Usage: ups-secondary-health.sh [-h|--help]
# Takes no arguments. Root cron job "UPS secondary watchdog" (cron file ups-secondary-health) runs
# it every nut_host_watchdog_interval_minutes minutes on daniel-server, only while
# nut_host_watchdog_armed is true. It reads /etc/nut/upsmon.conf and the Kuma push token from
# /etc/nut/kuma-push.env. Running it by hand needs root and pushes to the Kuma monitor. Each run
# also writes its verdict to $TEXTFILE_DIR/ups-secondary-health.prom for node_exporter's textfile
# collector, before the push (M6 batch B4; rules in other-setup-checks.yaml run in shadow).
#
# Answers the one question nothing else in this estate asks: can THIS host's upsmon still
# reach upsd, right now?
#
# The role's `wait_for` assert proves that at deploy time and never again. Two things break it
# silently in between, and both stay invisible until the power cut the chain exists for:
#   * the nut Service is recreated with a different ClusterIP, stranding the address frozen
#     into /etc/nut/upsmon.conf (the Service does not pin its clusterIP — see defaults/main.yml)
#   * nut-monitor dies or is left disabled
#
# WHY THE NEIGHBOURING CHECKS DO NOT COVER THIS, all three for the same reason — they observe a
# different path from the one that carries the shutdown:
#   * monitor-bridge's check_ups reads Home Assistant's Prometheus-scraped NUT sensors, i.e. the
#     UPS as seen THROUGH the pod. It says the UPS is fine, not that this host can hear it.
#   * the "k3s nut (upsd)" Kuma tile is a TCP probe from the Kuma POD over Service DNS,
#     re-resolved every cycle. A ClusterIP change that strands this host's frozen literal leaves
#     that tile green — it is the wrong side of the exact thing in dispute.
#   * node-exporter runs without --collector.systemd, so no node_systemd_unit_state series
#     exists for anything to alert on nut-monitor being dead.
#
# THE ADDRESS IS READ OUT OF THE DEPLOYED FILE, not re-templated from an Ansible var. A var
# would be resolved fresh at render time, so a tag-scoped run that touched this cron without
# re-rendering upsmon.conf would bake a CURRENT ClusterIP into the check while upsmon kept using
# the stale one — the check would pass against an address upsmon does not use, reproducing the
# blindness it exists to remove.
#
# The MONITOR line carries nut_monitor_password in field 5, which is why the read is
# field-scoped awk and never a bare grep: printing that line prints the credential into syslog
# and into any agent transcript that ran the check. This estate has rotated three secrets after
# exactly that mistake.
#
# Runs as root because /etc/nut/upsmon.conf is 0640 root:nut. Same trade-off as
# manifest-prune-check.sh: root buys the file read, nothing more. The consequence worth knowing
# is that an agent session cannot trigger a beat to verify this one by hand.
set -uo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

{# H4.3b3: the packaged branch. Only the component's render context sets
   nut_host_watchdog_packaged, so every host the role applies to renders the Ansible-era
   branch. The branch differs in exactly three lines: the push library's path, the token's
   source and the upsmon.conf path. #}
# shellcheck source=/dev/null
{% if nut_host_watchdog_packaged | bool %}
source /usr/lib/homelab/kuma-push-lib.sh || {
{% else %}
source /usr/local/lib/kuma-push-lib.sh || {
{% endif %}
  logger -t ups-secondary-health "kuma-push-lib.sh missing — run initial_setup on this host"
  exit 1
}
# shellcheck source=/dev/null
source /usr/local/lib/homelab-check-lib.sh || {
  logger -t ups-secondary-health "homelab-check-lib.sh missing — run initial_setup on this host"
  exit 1
}

# The longest legitimate gap between two textfile writes: two cron periods plus 300s, the rule
# M3 fixed (docs/target-architecture/monitoring/m3-textfile-timer.md, "The deadline for
# disk-health"). It renders from the same variable as the cron, and
# ansible/tests/setup/test_b4_rule_literals.py pins the rules' literals to this value.
DEADLINE_S={{ 2 * 60 * (nut_host_watchdog_interval_minutes | int) + 300 }}
TEXTFILE_DIR=${TEXTFILE_DIR:-/var/lib/node-exporter-textfile}

KUMA_HOST="uptime-kuma.local.{{ domain }}"
# Pinned to the cluster ingress VIP, like every sibling: Kuma serves from the k8s edge and the
# push must not depend on DNS.
KUMA_RESOLVE_IP="{{ k3s_metallb_ingress_vip }}"

# This role's OWN env file, deliberately not /etc/rancher/k3s/kuma-push.env. That one is a
# whole-content template owned by roles/setup/k3s, so adding a key to it from here would be
# clobbered on that role's next run — and nut_host also has to work on a host where the k3s
# role's file does not exist.
UPS_SECONDARY_PUSH_TOKEN=""
# shellcheck source=/dev/null
{% if nut_host_watchdog_packaged | bool %}
[[ -r "${CREDENTIALS_DIRECTORY:-/nonexistent}/kuma_push_token" ]] && UPS_SECONDARY_PUSH_TOKEN="$(< "${CREDENTIALS_DIRECTORY}/kuma_push_token")"
{% else %}
[[ -r /etc/nut/kuma-push.env ]] && . /etc/nut/kuma-push.env
{% endif %}
PUSH_URL="https://${KUMA_HOST}/api/push/${UPS_SECONDARY_PUSH_TOKEN}"

{% if nut_host_watchdog_packaged | bool %}
UPSMON_CONF=/var/lib/homelab-secrets/etc/nut/upsmon.conf
{% else %}
UPSMON_CONF=/etc/nut/upsmon.conf
{% endif %}

# Field 2 only: `MONITOR <ups>@<host> <powervalue> <user> <password> <mode>`.
ENDPOINT="$(awk '$1 == "MONITOR" { print $2; exit }' "$UPSMON_CONF" 2>/dev/null)"
UNIT_STATE="$(systemctl is-active nut-monitor 2>/dev/null || true)"

# stdout and stderr are kept APART. upsc writes "Init SSL without certificate database" to
# stderr on every successful call here, so folding the two with 2>&1 puts that line inside the
# value: the pushed message goes multi-line, and the empty-status branch below becomes
# unreachable because the noise is never empty. Both were live for one cycle on 2026-08-29.
UPSC_STDERR="$(mktemp)"
UPS_STATUS="$(upsc "$ENDPOINT" ups.status 2>"$UPSC_STDERR")"
UPSC_RC=$?
# Collapsed to one line: ups.status is legitimately multi-token ("OL CHRG"), and a newline in
# either half would break the syslog line and the push message.
UPS_STATUS="$(printf '%s' "$UPS_STATUS" | tr '\n' ' ' | sed 's/  */ /g; s/^ //; s/ $//')"
UPSC_ERR="$(tr '\n' ' ' < "$UPSC_STDERR" | sed 's/  */ /g; s/^ //; s/ $//')"
rm -f "$UPSC_STDERR"

if [[ ! -r "$UPSMON_CONF" ]]; then
  STATUS=down
  MSG="${UPSMON_CONF} is unreadable — the secondary is not configured on this host"
elif [[ -z "$ENDPOINT" ]]; then
  STATUS=down
  MSG="no MONITOR line in ${UPSMON_CONF} — upsmon has no upsd to watch"
elif [[ "$UNIT_STATE" != "active" ]]; then
  STATUS=down
  MSG="nut-monitor is ${UNIT_STATE:-unknown} — nothing on this host will act on FSD"
elif (( UPSC_RC != 0 )); then
  STATUS=down
  MSG="upsd unreachable at ${ENDPOINT}: ${UPSC_ERR:-upsc exited ${UPSC_RC} with no diagnostic}"
elif [[ -z "$UPS_STATUS" ]]; then
  STATUS=down
  MSG="upsd at ${ENDPOINT} returned an empty ups.status"
else
  # Deliberately does NOT page on OB/LB. Battery state is check_ups's job; alerting on it here
  # would double-page the same event from two mechanisms. This check is about the LINK.
  STATUS=up
  MSG="nut-monitor active, upsd reachable at ${ENDPOINT} (ups.status=${UPS_STATUS})"
fi

# Unconditional and before the push — a successfully-pushed DOWN otherwise leaves no durable
# record, and `probe.py alerts` reconstructs host-cron episodes by matching status=down in
# syslog. NOTICE rather than INFO: journald here is capped at MaxLevelStore=notice, so an
# info-level line is dropped from the journal AND from forwarding to rsyslog, never reaching
# Loki (2026-08-29 review M-15, which was exactly that bug in live_drift_check.py).
logger -p daemon.notice -t ups-secondary-health "status=${STATUS} ${MSG}"

# The textfile carries the verdict before the push, which retries for over a minute and must not
# age it. A failed write logs and the run goes on to its push. The token gates the push only: a
# host without the token still reports its verdict to Prometheus.
SUCCESS=0
[[ "$STATUS" == "up" ]] && SUCCESS=1
write_check_textfile ups-secondary-health "$SUCCESS" "$(date +%s)" "$DEADLINE_S" \
  || logger -t ups-secondary-health "textfile write to ${TEXTFILE_DIR} failed (status=${STATUS})"

if [[ -z "$UPS_SECONDARY_PUSH_TOKEN" ]]; then
  logger -t ups-secondary-health "push token unreadable — skipping push (see /add-secret)"
  exit 0
fi
kuma_push "$STATUS" "$MSG" "$PUSH_URL" "$KUMA_HOST" "$KUMA_RESOLVE_IP" ups-secondary-health
