REPO={{ renovate_agent_repo }}
REPO_DIR={{ renovate_agent_repo_dir }}
DISCORD_WEBHOOK={{ gitops_deploy_discord_webhook }}
STATE_DIR=/var/lib/renovate-agent
WORKTREE={{ renovate_agent_worktree }}
BRANCH={{ renovate_agent_branch }}
PROMPT_FILE=/opt/renovate-agent/prompt.txt
# Absolute: the native installer puts claude under the user's home and systemd's PATH omits it.
CLAUDE_BIN=/home/{{ sys_user }}/.local/bin/claude
MODEL={{ renovate_agent_model }}
PERMISSION_MODE={{ renovate_agent_permission_mode }}
BUDGET_USD={{ renovate_agent_budget_usd }}
RUN_TIMEOUT_S={{ renovate_agent_run_timeout_s }}
