[Unit]
Description=Land Renovate PR #%i for the unattended Renovate agent
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The operator's user, because land.sh deploys: it decrypts secrets and runs Ansible with
# become. The agent's session runs as {{ renovate_agent_user }} and can only START this unit,
# through the polkit rule 50-renovate-agent-land.rules. land_renovate_pr.py re-reads the PR
# from GitHub before landing anything, so the instance name is the only input the session gives.
User={{ sys_user }}
WorkingDirectory={{ renovate_agent_repo_dir }}
Environment=PATH=/home/{{ sys_user }}/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/{{ sys_user }}
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=RENOVATE_AGENT_REPO={{ renovate_agent_repo }}
Environment=RENOVATE_AGENT_REPO_DIR={{ renovate_agent_repo_dir }}
# land.sh's own author check, behind the lander's: --arm-merge refuses any other author.
Environment=LAND_REQUIRE_AUTHOR=app/renovate
# land_renovate_pr.py's LAND_TIMEOUT_S, so land.sh ends a long promotion wait `deferred`
# before the script kills it with no verdict (#5199). Both count from land.sh's start, after the
# flock wait below has already spent part of TimeoutStartSec (#5203). A pin bump on a tag Flux
# applies waits on the soak, so this leaves land-wait room for `verify`'s wait on the rendered
# soak plus promote's `render`, `images` and `publish`, after the merge and CI waits (#5427,
# #5466).
Environment=LAND_DEADLINE=28800
# The reboot window's grace, as claude-land sets it. The session's own run_timeout_s does not
# bound a landing: this unit runs on after the session ends, so one started late on a Saturday
# can still be waiting on Sunday's window (#5457).
Environment=LAND_WINDOW_GRACE=22200
# /var/lib/renovate-agent-land/<n>.verdict is the one thing the session reads back, so the
# directory is world-readable and only this unit writes it.
StateDirectory=renovate-agent-land
StateDirectoryMode=0755
SyslogLevel=notice
# Room for the flock wait below, the script's own checks and LAND_TIMEOUT_S, so the script
# reports a slow landing itself rather than systemd killing it inside an Ansible run. systemd
# counts the lock wait too: a landing queued 40 minutes behind another would otherwise be
# killed 20 minutes in, with no verdict line (#5203).
TimeoutStartSec=860min
# Replaces any earlier run's verdict before the lock wait. land_renovate_pr.py writes PENDING only
# once it holds the lock, so a wait that times out would otherwise leave yesterday's verdict for
# this PR for the session to read as today's. The prompt stops landing on any VERDICT line but
# `settled`, which is the right answer when another landing holds the lock.
ExecStartPre=/bin/sh -c 'echo "VERDICT: none (the lander did not get its lock)" > "$1"' sh /var/lib/renovate-agent-land/%i.verdict
# One landing at a time: two would race for the same tick and the same service locks. The wait
# is short because the session lands one PR at a time and blocks on each, so only a hand-started
# unit queues here, and a longer wait would come out of the landing's share of TimeoutStartSec.
ExecStart=/usr/bin/flock -w 180 /var/lock/renovate-agent-land.lock \
  /usr/local/bin/uv run --no-project --no-python-downloads --python {{ host_python_version }} \
  /opt/renovate-agent/land_renovate_pr.py %i
