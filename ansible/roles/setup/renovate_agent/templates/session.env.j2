# Managed by Ansible (roles/setup/renovate_agent). Read by systemd as root through
# renovate-agent.service's EnvironmentFile=, so neither value appears in a unit line.
# GH_TOKEN: a fine-grained token for {{ renovate_agent_repo }} alone, with no contents write,
# so the session can neither push nor merge. CLAUDE_CODE_OAUTH_TOKEN: from `claude setup-token`.
GH_TOKEN={{ renovate_agent_gh_token | default('') }}
CLAUDE_CODE_OAUTH_TOKEN={{ renovate_agent_claude_oauth_token | default('') }}
