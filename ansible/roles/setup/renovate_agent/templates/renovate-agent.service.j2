[Unit]
Description=Unattended Renovate agent (one headless Claude session over the open Renovate PRs)
After=network-online.target
Wants=network-online.target
OnFailure=renovate-agent-alert.service

[Service]
Type=oneshot
# Its own user, not {{ sys_user }}: the session reads third-party release notes and PR text, so
# it holds nothing that can reach master. No sudo, no read on /home/{{ sys_user }}, and a GitHub
# token that cannot push or merge. Landing is renovate-agent-land@<n>.service, which polkit
# lets this user start and which runs land.sh as {{ sys_user }} on a PR it re-checks itself.
User={{ renovate_agent_user }}
WorkingDirectory={{ renovate_agent_clone_dir }}
# The wrapper's own RUN_TIMEOUT_S ({{ renovate_agent_run_timeout_s }}s) should always trip
# first: it kills the session and still posts a digest naming the timeout, where this ceiling
# kills the whole cgroup and posts only the OnFailure alert. Keep this strictly above
# RUN_TIMEOUT_S plus the two `gh pr list` censuses either side of it. A landing in flight runs
# in the lander's own unit, so this kill no longer reaches an Ansible run.
TimeoutStartSec={{ renovate_agent_unit_timeout }}
# The user's own ~/.local/bin for `claude` and `uv`; systemd supplies a minimal PATH exactly as
# cron does. `gh` and `git` are in /usr/bin.
Environment=PATH={{ renovate_agent_home }}/.local/bin:/usr/bin:/bin
Environment=HOME={{ renovate_agent_home }}
Environment=PYTHONDONTWRITEBYTECODE=1
# A landing blocks in `systemctl start` for up to the lander's 60-minute TimeoutStartSec, and
# Claude Code caps a Bash call at 10 minutes unless this raises it. A call killed early leaves
# the landing running, but the session would then read a verdict file the lander has not yet
# rewritten (it writes PENDING only once it holds its lock).
Environment=BASH_MAX_TIMEOUT_MS={{ renovate_agent_bash_timeout_ms }}
# The GitHub token and the Claude credential. Read by systemd as root, so the file is root 0600
# and neither value appears in a unit line `systemctl show` publishes.
EnvironmentFile=/etc/renovate-agent/session.env
# journald stores only notice+ on these hosts, and a unit's stdout logs at info by default —
# so without this every wrapper line is discarded at the source and a post-mortem has nothing
# to read. Same reasoning as gitops-deploy.service.
SyslogLevel=notice
# The user boundary does the containment; these close what a same-host user can still read.
# ProtectHome hides every /home, ProtectProc hides other users' processes and their argv, and
# NoNewPrivileges rules out a setuid binary. None of them stops a `systemctl start` of the
# lander, which goes to systemd over D-Bus and is decided by polkit.
NoNewPrivileges=yes
ProtectHome=yes
ProtectProc=invisible
PrivateTmp=yes
#
# `-n`: never queue. Two of these overlapping would fight over the same worktree, and the timer
# is daily, so a run still going when the next one fires means something is wrong and the second
# should say so rather than wait. The lock sits in the user's own home: fs.protected_regular=2
# refuses an O_CREAT open of another user's file in sticky /run/lock, and the old lock there
# belongs to {{ sys_user }}.
ExecStart=/usr/bin/flock -n {{ renovate_agent_home }}/run.lock \
  {{ renovate_agent_home }}/.local/bin/uv run --no-project --no-python-downloads --python {{ host_python_version }} \
  /opt/renovate-agent/renovate_agent.py
{% if renovate_agent_kuma_push_token | default('') %}
# The alive beat, sent only when ExecStart succeeded. The URL embeds the push token, so it is
# read from the 0600 /etc/renovate-agent/config.env at run time and reaches curl on stdin as a
# config file (`-K -`). It appears in neither the unit line nor any argv: /proc is mounted
# without hidepid here, and `systemctl show <unit> -p ExecStartPost` publishes this line over
# the system bus to any local user. Interpolating the token straight into this line — which is
# what it did until #1489 — put the whole push URL in both places, and the guard that denies
# `systemctl cat` named `systemctl show -p <Property>` as the safe alternative.
# `%%s`, not `%s` — systemd expands a bare `%s` to the service user's shell.
# ENFORCED: ansible/tests/setup/test_renovate_agent_unit.py.
ExecStartPost=/bin/sh -c '. /etc/renovate-agent/config.env && printf "url = \"%%s\"\n" "$KUMA_PUSH_URL" | curl -fsS -m 15 -K - --get --data-urlencode "msg=agent ran" >/dev/null'
{% endif %}
