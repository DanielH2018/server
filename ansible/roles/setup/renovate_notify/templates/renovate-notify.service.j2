[Unit]
Description=Renovate manual-action notifier (query open PRs, alert on change)
After=network-online.target
Wants=network-online.target
OnFailure=renovate-notify-alert.service

[Service]
Type=oneshot
# This host's journald stores notice and above (MaxLevelStore=notice), so stdout logs at notice.
SyslogLevel=notice
User={{ sys_user }}
# Sandbox: a narrow notifier — queries open PRs over HTTPS and writes ONLY its state dir — so it
# can be confined, unlike the gitops-deploy unit which deploys the whole fleet. Limits blast radius
# once a read-only GitHub PAT (renovate_notify_github_token) is wired in and it parses attacker-
# influenceable API JSON. ReadWritePaths is the only writable path (last_run/last_notified markers);
# the script + config are read-only (reads are always allowed under ProtectSystem).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/renovate-notify
Environment=PYTHONDONTWRITEBYTECODE=1
# uv opens its cache for WRITE at startup on every invocation, warm or cold, and the cache
# defaults to $HOME/.cache/uv — which ProtectHome=read-only above makes unwritable. Without this
# the unit dies with exit 2 before Python starts, at every tick, and OnFailure pages for it.
# Point the cache at the private /tmp that PrivateTmp already gives this unit, rather than at
# ReadWritePaths: this is the unit that parses attacker-influenceable API JSON, so a cache that
# survives between runs is state one compromised run could poison for the next. PrivateTmp is
# destroyed at exit, and a cold cache costs nothing here — the script is stdlib-only and
# --no-project means there are no packages to fetch (measured: 28K, 56ms).
# NB the interpreter itself lives under $HOME (~/.local/share/uv/python) and is only *read*,
# which ProtectHome=read-only permits.
Environment=UV_CACHE_DIR=/tmp/uv-cache
ExecStart=/usr/local/bin/uv run --no-project --no-python-downloads --python {{ host_python_version }} /opt/renovate-notify/renovate_notify.py
# The same run's verdict for node_exporter's textfile collector (M6 batch B4). It runs only when
# ExecStart succeeded. A crash writes nothing, which is the rule's own reading: the missing file
# is the signal, and the rules in other-setup-checks.yaml carry only a NotReporting arm for it.
#
# `+` runs this one line unsandboxed, because ProtectSystem=strict above leaves the textfile
# directory read-only and ReadWritePaths= should not widen for a single file. `env -i
# PATH=/usr/bin:/bin` pins the command's environment, the same form the agent unit uses. It is
# /bin/bash, not /bin/sh, since homelab-check-lib.sh is bash-shaped. Both write failures end in a logged
# line and exit 0, so the unit never fails over its own telemetry. 129600 is the DEADLINE_S: a
# daily run plus a missed one and slack, and ansible/tests/setup/test_b4_rule_literals.py pins the
# rule's literal to it. `%%s` is systemd's escape for the date format's `%s`.
ExecStartPost=+/usr/bin/env -i PATH=/usr/bin:/bin /bin/bash -c 'source /usr/local/lib/homelab-check-lib.sh && write_check_textfile renovate-notify 1 "$(date +%%s)" 129600 || logger -t renovate-notify "textfile write failed (homelab-check-lib.sh missing or the textfile directory unwritable)"'
