REPO=DanielH2018/server
DISCORD_WEBHOOK={{ gitops_deploy_discord_webhook }}
# Optional fine-grained read-only PAT to lift the GitHub API rate limit 60->5000 req/hr (see
# renovate_notify.py). Empty = stay unauthenticated (the default until the operator adds the secret).
GITHUB_TOKEN={{ renovate_notify_github_token | default('') }}
STATE_DIR=/var/lib/renovate-notify
# Host flip 2 (2026-08-14): the unit's ExecStartPost pushes this "Renovate Notifier —
# Alive" Kuma monitor directly after each successful run — the monitor-bridge
# renovate_alive state-file check retired with the flip. LAN route: this is a host
# process, not a pod.
KUMA_PUSH_URL=https://uptime-kuma{{ k8s_hostname_suffix }}.local.{{ domain }}/api/push/{{ monitor_bridge_renovate_alive_push_token }}
