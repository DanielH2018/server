{{ ansible_managed | comment }}
# Read by renovate-notify-alert.service via EnvironmentFile=, and by nothing else.
#
# Separate from config.env for the reason the alert unit's own header gives: config.env is
# exactly what can be broken or unreadable when the notifier fails, so an alert that depended on
# it would be unable to page for the failure most likely to need it. systemd's built-in
# EnvironmentFile parser runs no application code, so a one-key file read this way does not
# reintroduce that risk. Mirrors gitops_deploy/templates/alert-webhook.env.j2.
ALERT_WEBHOOK={{ gitops_deploy_discord_webhook }}
