# The builder's settings (h3-pi-pilot.md, builder step 4). The builder reads them from here only,
# never from a path in its clone, because the clone holds the commit it is judging.
#
# A read-only token: the builder never polls GitHub anonymously, because anonymous reads share
# one quota with the tick's gate.
GITHUB_TOKEN={{ homelab_builder_github_token }}
GITHUB_REPO={{ homelab_builder_github_repo }}
# The deployer's own gate and walk bound, through the template task's vars, rendered
# with the expression the deployer's config.env uses. An empty list, or a bound that is not a
# positive integer, builds nothing (reason="ci").
CI_CONTEXTS={{ homelab_builder_ci_contexts | join(',') }}
CI_ANCESTOR_WALK_MAX={{ homelab_builder_ci_walk_max }}
# Prometheus, loopback first and then the pinned ClusterIP, space-separated. The rollout gate
# asks the first that answers whether the canary applied its version (*Staged rollout*).
PROMETHEUS_URLS={{ homelab_builder_prom_urls | join(' ') }}
