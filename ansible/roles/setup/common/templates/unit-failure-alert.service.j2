[Unit]
Description={{ alert_unit_description }}

[Service]
Type=oneshot
# Rendered by roles/setup/common/tasks/alert_unit.yml for every setup role whose unit pages
# Discord through OnFailure=; that file's header lists the callers' variables.
#
# The webhook comes from a dedicated one-key file, NOT from the failing service's config.env.
# config.env is exactly what can be broken or unreadable when the service fails (gitops_deploy's
# cfg() parses it at import, before its crash handler), and a hard EnvironmentFile= on it would
# leave THIS alert unable to start. systemd's own EnvironmentFile parser runs no application
# code, so a one-key file does not reintroduce that failure mode. curl's own UA is fine:
# Cloudflare 1010-blocks python-urllib, not curl.
#
# It is NOT embedded in this unit. Embedding it plus `mode: 0600` was the previous arrangement,
# and the mode did not protect the value: systemd serves unit content over the system bus, so
# `systemctl show <unit> -p ExecStart` printed the full webhook to any local user with no sudo
# (2026-08-23b review M5, and again for claude-rc in the 2026-08-24 review, a copy made after
# the first two units had moved off the embed). Referencing "${ALERT_WEBHOOK}" makes that
# command print the literal variable name instead. One template is what keeps a fix like that
# from landing in some copies and not others.
EnvironmentFile={{ alert_unit_env_dir }}/alert-webhook.env
# Retries every failure, a refused connection and a failed DNS lookup included: one attempt
# lost the page for claude-rc's 2026-10-04 07:46 crash to a DNS failure (#3523). Plain
# --retry skips a refused connection. Worst case about two minutes; a oneshot has no start timeout.
#
# Two minutes does not cover an outage, so systemd re-runs a failed delivery until it succeeds.
# daniel-box could reach nothing off the host from its 2026-10-05 23:55 boot until about
# 2026-10-08 21:55 UTC. Every alert that fired in that window exited 6 and was never retried,
# so the outage's pages were lost (#3902). A resolver pin would not have helped: the host
# forwarder already falls back to 1.1.1.1 and 1.0.0.1, and those were unreachable too.
# Restart=on-failure is accepted for Type=oneshot (systemd 255; only always/on-success are
# refused). While a retry is pending the unit reads `activating (auto-restart)`, not `failed`.
# Another failure of the parent in that state starts one immediate attempt and leaves the unit
# pending again (measured with a transient user unit), so a repeating parent failure adds
# attempts, not queued pages. `systemctl stop <name>-alert` abandons the retry. A reboot
# abandons it too, because a pending restart is not persisted.
#
# RestartPreventExitStatus= lists the one exit another attempt cannot fix: curl exits 3 on a
# malformed URL, as an empty ALERT_WEBHOOK gives, and that unit stays `failed`. Exit 22 is
# deliberately NOT final. curl -f exits 22 on any status >= 400, so a Cloudflare 502 or a
# Discord 429 that outlasts curl's own retries, as a burst of pages after an outage can,
# looks the same as a revoked webhook. Retrying a revoked webhook costs one err line every
# 5 minutes; making 22 final would lose the transient page. Every other exit keeps retrying.
Restart=on-failure
RestartSec=5min
RestartPreventExitStatus=3
# A page that arrives hours late must say when the failure happened, or it reads as a fresh
# failure (#3906). The first attempt writes the time to failed-at, and every retry posts that
# same time. systemd keeps a RuntimeDirectory across an automatic restart only with
# RuntimeDirectoryPreserve=restart, and removes it when the unit stops for good: after a
# delivery, a `systemctl stop`, or the final exit 3. The next failure therefore records a
# fresh time. Measured on systemd 255 with this template rendered as a user unit behind an
# OnFailure= parent: three attempts posted one timestamp, and the directory was gone after the
# third was delivered, and after a `systemctl stop` while a retry was pending. A transient unit
# from systemd-run left the directory behind, so test this with a unit file. A parent failure
# while a retry is pending keeps the first time, which is the oldest failure not yet paged.
#
# The ExecStartPre `sh -c` carries no payload, so the no-wrapper reason below does not apply to
# it. curl builds the payload itself: --variable reads the file and {{ '{{' }}failed_at:trim:json}}
# expands it JSON-escaped. curl exits 26 when the file is missing, and Restart= would retry that
# forever. The file cannot be missing when ExecStart runs: systemd creates the directory before
# ExecStartPre, and a failed ExecStartPre ends the attempt before ExecStart.
RuntimeDirectory={{ alert_unit_name }}-alert
RuntimeDirectoryPreserve=restart
ExecStartPre=/bin/sh -c 'test -s %t/{{ alert_unit_name }}-alert/failed-at || date --utc "+%%Y-%%m-%%d %%H:%%M UTC" > %t/{{ alert_unit_name }}-alert/failed-at'
ExecStart=/usr/bin/curl -fsS -m 10 --retry 5 --retry-delay 10 --retry-all-errors -H "Content-Type: application/json" \
  --variable 'failed_at@%t/{{ alert_unit_name }}-alert/failed-at' \
  --expand-data '{"content":"{{ alert_unit_message }} Failed at {% raw %}{{failed_at:trim:json}}{% endraw %}."}' \
  "${ALERT_WEBHOOK}"
# A delivered page left NO on-host record: `curl -fsS` is silent on success, and systemd's own
# Starting/Finished lines are info-level, which journald drops here (MaxLevelStore=notice). So
# `journalctl -u <name>-alert` read `-- No entries --` against real failures, which looks
# identical to "the alert unit never fired". Both directives below are required and neither is
# sufficient alone: SyslogLevel= governs only THIS unit's own stdout, never PID 1's lifecycle
# messages, so without the echo it stores nothing; without SyslogLevel the echo lands at info and
# is dropped. ExecStartPost runs only when ExecStart succeeded, so the line means "delivered",
# not "attempted" — and a FAILED curl already logs at err, which survives the cap. Deliberately
# not a `/bin/sh -c '… && echo …'` wrapper: that would re-quote the single-quoted JSON payload
# for no gain.
SyslogLevel=notice
ExecStartPost=/bin/echo {{ alert_unit_name }} failure alert delivered
