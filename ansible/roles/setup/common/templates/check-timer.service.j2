# {{ check_timer_description }} — managed by Ansible (roles/setup/common/tasks/check_timer.yml);
# edits overwritten. Rendered from roles/setup/common/templates/check-timer.service.j2.
#
# THE CONTRACT IS THE EXIT CODE. The check writes its verdict to a textfile a Prometheus rule
# reads, then exits non-zero after `down`, 0 after `up`. Restart=on-failure reruns it every
# RestartSec until it exits 0, so a failing verdict clears as soon as the fault is fixed rather
# than at the next scheduled slot.
[Unit]
Description={{ check_timer_description }}
After=network-online.target
Wants=network-online.target
# No OnFailure= alert unit, deliberately. A down verdict is a unit failure by this contract,
# and the *-alert.service units page Discord on a unit that BROKE. The rule already pages
# the verdict.

[Service]
Type=oneshot
# This host's journald stores notice and above (MaxLevelStore=notice), so stdout logs at notice.
SyslogLevel=notice
User={{ check_timer_user }}
{% if check_timer_env_file | default('') %}
EnvironmentFile={{ check_timer_env_file }}
{% endif %}
{% for assignment in check_timer_environment | default([]) %}
Environment={{ assignment }}
{% endfor %}
ExecStart={{ check_timer_exec }}
# Only Restart=always and Restart=on-success are refused for Type=oneshot (systemd 255).
Restart=on-failure
RestartSec={{ check_timer_restart_sec }}
# The restart loop lives in memory, so a reboot ends it. This marker survives the reboot and
# gates kuma-check-{{ check_timer_name }}-boot.service, which reruns the check once at boot while
# the last verdict was not up (#4495). `+` runs it as root whatever User= is, and `$$` hands the
# variable to the shell rather than to systemd's own substitution. SERVICE_RESULT is `success`
# only after an exit 0; a down verdict, a crash and a run killed by shutdown all keep the marker.
ExecStopPost=+/bin/sh -c 'if [ "$$SERVICE_RESULT" = success ]; then rm -f /var/lib/kuma-check/{{ check_timer_name }}.down; else mkdir -p /var/lib/kuma-check && touch /var/lib/kuma-check/{{ check_timer_name }}.down; fi'
