{{ ansible_managed | comment }}
# Read by one *-alert.service via EnvironmentFile=, and by nothing else. Rendered by
# roles/setup/common/tasks/alert_unit.yml into the failing service's own /etc directory.
#
# It is a separate file from that service's config.env on purpose, for the reason
# unit-failure-alert.service.j2's header gives: config.env is exactly what can be broken or
# unreadable when the service fails, so an alert that sourced the webhook from it would be
# unable to page for the failure most likely to need it.
ALERT_WEBHOOK={{ gitops_deploy_discord_webhook }}
