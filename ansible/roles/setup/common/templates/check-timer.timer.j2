# {{ check_timer_description }} (timer) — managed by Ansible
# (roles/setup/common/tasks/check_timer.yml); edits overwritten.
[Unit]
Description={{ check_timer_description }} (timer)

[Timer]
OnCalendar={{ check_timer_on_calendar }}
# Persistent=true, decided 2026-09-19. Cron skips a slot that falls inside an outage, and the
# verdict then stays red until the next slot because nothing wrote a fresh one. A stamped
# timer runs the check once at boot instead. That run can land before k3s is ready
# and write a false down; the service's Restart=on-failure bounds that to one RestartSec.
# Persistent=true catches up only a slot that never fired. A check that went red before a reboot
# already fired its slot, so kuma-check-{{ check_timer_name }}-boot.service reruns it instead (#4495).
Persistent=true
Unit=kuma-check-{{ check_timer_name }}.service

[Install]
WantedBy=timers.target
