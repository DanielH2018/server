# {{ kuma_check_description }} — managed by Ansible (roles/setup/common/tasks/kuma_check_timer.yml);
# edits overwritten. Rendered from roles/setup/common/templates/kuma-check.service.j2.
#
# THE CONTRACT IS THE EXIT CODE. The check pushes its verdict to a Kuma push monitor and then
# exits 1 after `down`, 0 after `up`. Restart=on-failure reruns it every RestartSec until it
# exits 0, so a tile that went red clears as soon as the fault is fixed rather than at the
# next scheduled slot. kuma_push itself keeps returning 0 on a dropped push, as its header
# requires; the exit line sits in the caller, after the push.
[Unit]
Description={{ kuma_check_description }}
After=network-online.target
Wants=network-online.target
# No OnFailure= alert unit, deliberately. A down verdict is a unit failure by this contract,
# and the *-alert.service units page Discord on a unit that BROKE. The tile already carries
# the verdict and its message.

[Service]
Type=oneshot
# This host's journald stores notice and above (MaxLevelStore=notice), so stdout logs at notice.
SyslogLevel=notice
User={{ kuma_check_user }}
{% if kuma_check_env_file | default('') %}
EnvironmentFile={{ kuma_check_env_file }}
{% endif %}
{% for assignment in kuma_check_environment | default([]) %}
Environment={{ assignment }}
{% endfor %}
ExecStart={{ kuma_check_exec }}
# Only Restart=always and Restart=on-success are refused for Type=oneshot (systemd 255).
Restart=on-failure
RestartSec={{ kuma_check_restart_sec }}
# The restart loop lives in memory, so a reboot ends it. This marker survives the reboot and
# gates kuma-check-{{ kuma_check_name }}-boot.service, which reruns the check once at boot while
# the last verdict was not up (#4495). `+` runs it as root whatever User= is, and `$$` hands the
# variable to the shell rather than to systemd's own substitution. SERVICE_RESULT is `success`
# only after an exit 0; a down verdict, a crash and a run killed by shutdown all keep the marker.
ExecStopPost=+/bin/sh -c 'if [ "$$SERVICE_RESULT" = success ]; then rm -f /var/lib/kuma-check/{{ kuma_check_name }}.down; else mkdir -p /var/lib/kuma-check && touch /var/lib/kuma-check/{{ kuma_check_name }}.down; fi'
