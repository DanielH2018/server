# Managed by ansible (roles/setup/hypervisor). Read by etcd-restore-drill-vm and copied into
# the drill guest as /etc/rancher/k3s/etcd-s3.env for the run. Same shape as the k3s role's
# copy on daniel-box (health-crons.yml), so the drill script reads it unchanged.
AWS_ACCESS_KEY_ID={{ r2_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ r2_secret_access_key }}
ETCD_S3_BUCKET={{ r2_bucket }}
ETCD_S3_ENDPOINT={{ r2_account_id }}.r2.cloudflarestorage.com
