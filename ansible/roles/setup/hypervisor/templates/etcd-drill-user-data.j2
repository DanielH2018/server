#cloud-config
# Managed by ansible (roles/setup/hypervisor). The etcd restore drill guest's seed. Unlike the
# staging guest's, this is read on EVERY run: the orchestrator recreates the disk from the base
# image each time, so each run is a first boot.
hostname: {{ hypervisor_etcd_drill_vm_hostname }}
fqdn: {{ hypervisor_etcd_drill_vm_hostname }}
preserve_hostname: false

users:
  - name: {{ sys_user }}
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - "{{ hypervisor_etcd_drill_vm_ssh_key }}"

ssh_pwauth: false
disable_root: true

# The pinned host key, generated once on the hypervisor by etcd_drill.yml. A fresh disk would
# otherwise mint a new host key every run and the orchestrator would have to accept any key —
# which, with the staging guest on the same bridge, is an address anyone there could answer for
# while the cluster token is in flight. ed25519 only, so no other key type can be offered.
ssh_genkeytypes: [ed25519]
ssh_keys:
  ed25519_private: |
{{ hypervisor_etcd_drill_vm_hostkey_private | indent(4, first=True) }}
  ed25519_public: "{{ hypervisor_etcd_drill_vm_hostkey_public }}"

# Nothing installed on first boot. The k3s binary, the token and the R2 env file are copied in by
# the orchestrator over ssh for the run, so the image stays the reviewed cloud image and nothing
# a drill needs comes from the internet at boot.
package_update: false
package_upgrade: false

growpart:
  mode: auto
  devices: ["/"]
resize_rootfs: true
