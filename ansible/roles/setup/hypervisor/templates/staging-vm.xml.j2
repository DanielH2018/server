<!-- Managed by ansible (roles/setup/hypervisor). Edits here are overwritten. -->
<domain type='kvm'>
  <name>{{ staging_vm_hostname }}</name>
  <memory unit='MiB'>{{ hypervisor_staging_vm_memory_mib }}</memory>
  <currentMemory unit='MiB'>{{ hypervisor_staging_vm_memory_mib }}</currentMemory>
  <vcpu placement='static'>{{ hypervisor_staging_vm_vcpus }}</vcpu>
  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <boot dev='hd'/>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <!-- host-passthrough so the guest's k3s sees the same CPU features prod's does. The
       staging cluster exists to run prod's manifests; a different feature set is a
       difference the gate would not be measuring on purpose. -->
  <cpu mode='host-passthrough' check='none'/>
  <clock offset='utc'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
  </clock>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>restart</on_crash>
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2' discard='unmap'/>
      <source file='{{ hypervisor_staging_vm_disk }}'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <!-- The cloud-init NoCloud seed. Read once on first boot; left attached so a rebuild of
         the guest from the same disk still finds its identity. -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='{{ hypervisor_staging_vm_seed }}'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
    </disk>
    <interface type='network'>
      <source network='{{ hypervisor_staging_net_name }}'/>
      <!-- Fixed, and matched by the DHCP reservation in the staging network. The guest's
           address is therefore a property of the repo rather than of lease order. -->
      <mac address='{{ staging_vm_mac }}'/>
      <model type='virtio'/>
      <!-- The egress fence. libvirt applies a filter when the interface is CREATED, so
           adding this line reaches a running guest only after the domain is stopped and
           started — which guest.yml does when it finds a live interface without it. -->
      <filterref filter='{{ hypervisor_staging_nwfilter_name }}'/>
    </interface>
    <!-- Serial console only. There is no graphics device on purpose: nothing should need a
         framebuffer to reach this guest, and `virsh console` is the recovery path when ssh
         is what is broken. -->
    <serial type='pty'>
      <target type='isa-serial' port='0'/>
    </serial>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
    <channel type='unix'>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
    </channel>
    <memballoon model='virtio'/>
    <rng model='virtio'>
      <backend model='random'>/dev/urandom</backend>
    </rng>
  </devices>
</domain>
