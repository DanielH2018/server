# Managed by ansible (roles/setup/hypervisor). Sourced by etcd-restore-drill-vm; kept out of
# that script because it lands 0755. Empty until the secret exists, and the script pushes
# nothing while it is empty.
ETCD_DRILL_FULL_PUSH_TOKEN='{{ etcd_drill_full_push_token | default("") }}'
# The egress-fence leg's own tile. Separate from the drill's above, because the fence has an
# outcome the drill does not fail on — a target that could not be measured.
ETCD_DRILL_FENCE_PUSH_TOKEN='{{ etcd_drill_fence_push_token | default("") }}'
