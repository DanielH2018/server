#cloud-config
# Managed by ansible (roles/setup/hypervisor). Read by cloud-init on FIRST BOOT ONLY —
# editing this after the guest exists changes the seed ISO and nothing else. Rebuilding the
# guest is what re-applies it.
hostname: {{ staging_vm_hostname }}
fqdn: {{ staging_vm_hostname }}
preserve_hostname: false

users:
  - name: {{ sys_user }}
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - "{{ hypervisor_staging_vm_ssh_key }}"

# Password auth stays off: the only way in is the key above, which is daniel-server's own.
# A host whose stated purpose is being broken should not also be reachable by password.
ssh_pwauth: false
disable_root: true

# No package work on first boot. The k3s install is a later slice and is driven by ansible,
# so doing it here would split the same job across two mechanisms.
package_update: false
package_upgrade: false

# Grow the root filesystem into the resized disk. Without this the guest keeps the cloud
# image's own small partition regardless of how large the qcow2 is.
growpart:
  mode: auto
  devices: ["/"]
resize_rootfs: true
