#!/usr/bin/env bash
# etcd-restore-drill-vm — run the FULL etcd restore drill in a throwaway guest, unattended.
# Rendered by roles/setup/hypervisor onto daniel-server; scheduled by the cron in etcd_drill.yml.
#
# The drill itself is scripts/backup/etcd_restore_drill.sh, which restores the newest off-box
# snapshot into a scratch data-dir and reads the object graph back. It cannot pass beside a live
# k3s (its header lists five structural reasons), so this script gives it a host with no k3s at
# all: a transient libvirt guest built from the reviewed cloud image, made to look like a k3s
# server node whose k3s is stopped — the binary, the cluster token and the R2 env file placed at
# the paths the drill already reads. The drill runs there unmodified (issue #1175, path 1).
#
# LIFECYCLE, and why every step is where it is:
#   1. lock, prune old evidence, preflight      — fail fast, and never two guests
#   2. destroy any guest a previous run left    — an aborted run must not block the next
#   3. fresh disk from the base image, `virsh create` (transient: never a defined domain)
#   4. wait for ssh against the PINNED host key — the staging guest shares this bridge
#   5. probe the egress fence FROM the guest     — before it is handed any credential, and push
#                                                  that verdict to its OWN Kuma tile
#   6. stage binary + token + env + scripts in one tar over ssh, then delete the staging dir
#   7. run the guest-side script; pull restore.log / server.log out as evidence
#   8. destroy the guest and delete its disk    — also from the EXIT trap, pass or fail
#   9. stamp on success, push the verdict to Kuma, log it unconditionally
# Evidence (the drill's stdout, k3s's two logs and the fence leg's report) is the only thing that
# outlives a run, under LOG_ROOT/<utc-run-id>/, and it is pruned at LOG_RETENTION_DAYS. The
# restored etcd database, the token copy and the R2 credentials live on the guest's disk, which
# step 8 deletes.
#
# Exit 0 = the drill passed. Non-zero = it did not, or this script could not get as far as running
# it; the Kuma message and the syslog line say which.
set -uo pipefail

# shellcheck source=/dev/null
source /usr/local/lib/kuma-push-lib.sh || {
  logger -t etcd-restore-drill-vm "kuma-push-lib.sh missing — run initial_setup on this host"
  exit 1
}

# Cron's PATH omits /usr/local/bin, where k3s lives; the same trap as every other cron here.
export PATH="/usr/local/bin:${PATH}"

ARMED="{{ 1 if hypervisor_etcd_drill_armed else 0 }}"
NAME="{{ hypervisor_etcd_drill_vm_hostname }}"
XML="{{ hypervisor_etcd_drill_vm_xml }}"
BASE_IMAGE="{{ hypervisor_base_image_path }}"
DISK="{{ hypervisor_etcd_drill_vm_disk }}"
DISK_SIZE="{{ hypervisor_etcd_drill_vm_disk_size }}"
SEED="{{ hypervisor_etcd_drill_vm_seed }}"
GUEST_IP="{{ hypervisor_etcd_drill_vm_ip }}"
GUEST_USER="{{ sys_user }}"
GUEST_HOSTKEY_PUB="{{ hypervisor_etcd_drill_vm_hostkey }}.pub"
# The guest's only authorised key is this host's own (etcd-drill-user-data.j2), same as the
# staging guest. Root reads it here; nothing else on the host uses it as root.
IDENTITY="/home/{{ sys_user }}/.ssh/id_ed25519"
BOOT_TIMEOUT="{{ hypervisor_etcd_drill_vm_boot_timeout }}"
S3_ENV="{{ hypervisor_etcd_drill_s3_env }}"
# K3S_TOKEN lives here since the agent join (roles/setup/k3s/tasks/agent.yml). k3s writes the same
# value to server/token and server/node-token when no --agent-token is set, so this IS the token
# a rebuilt server would need; a mismatch fails the restore stage loudly rather than passing.
AGENT_ENV=/etc/systemd/system/k3s-agent.service.env
DRILL_SCRIPT="{{ hypervisor_etcd_drill_script_path }}"
GUEST_RUN_SCRIPT="{{ hypervisor_etcd_drill_guest_script_path }}"
STAMP_DIR="{{ hypervisor_etcd_drill_stamp_dir }}"
LOG_ROOT="{{ hypervisor_etcd_drill_log_dir }}"
LOG_RETENTION_DAYS="{{ hypervisor_etcd_drill_log_retention_days }}"
LOCK="{{ hypervisor_etcd_drill_lock }}"
# Whole-run ceiling. The drill's own stages are bounded (600 s restore, 180 s ready) and the
# boot at BOOT_TIMEOUT; this catches a hung ssh or a download that never finishes.
RUN_TIMEOUT=1800
# The egress-fence leg's own bounds. It sits OUTSIDE RUN_TIMEOUT (that deadline starts once the
# drill is launched), so without one of its own a wedged dial would hang the monthly cron. A
# dropped packet burns the whole per-target timeout, so the deadline is sized for every target
# timing out at once with ssh setup on top.
FENCE_PROBE_TIMEOUT="{{ hypervisor_etcd_drill_fence_probe_timeout }}"
FENCE_DEADLINE="{{ hypervisor_etcd_drill_fence_deadline }}"
FENCE_LONGHORN_URL="{{ hypervisor_etcd_drill_fence_longhorn_url }}"
# What the run reports about the fence. "not-checked" until the leg runs, so a failure BEFORE it
# does not claim a verdict it never took.
FENCE_VERDICT=not-checked
TAG=etcd-restore-drill-vm

ETCD_DRILL_FULL_PUSH_TOKEN=""
ETCD_DRILL_FENCE_PUSH_TOKEN=""
# shellcheck source=/dev/null
[[ -r "{{ hypervisor_etcd_drill_kuma_env }}" ]] && . "{{ hypervisor_etcd_drill_kuma_env }}"
PUSH_TOKEN="$ETCD_DRILL_FULL_PUSH_TOKEN"
# The fence leg reports to a tile of its own, so an unproven range alarms as an unproven range
# rather than riding along in the message of a passing drill push. See report_fence.
FENCE_PUSH_TOKEN="$ETCD_DRILL_FENCE_PUSH_TOKEN"

VIRSH=(virsh --connect qemu:///system)
RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)"
LOG_DIR="$LOG_ROOT/$RUN_ID"
WORK=""
KNOWN_HOSTS=""

log() { echo "[$(date -u +%H:%M:%S)] $*"; }

push_kuma() {
  local status="$1" msg="$2" token="${3:-$PUSH_TOKEN}"
  [[ -z "$token" ]] && return 0
  kuma_push "$status" "$msg" "$token" "$TAG"
}

# Every exit path reports through here, and the syslog line is unconditional — a push that lands
# leaves no local record otherwise, and `probe.py alerts` reconstructs history from Loki.
report() {
  local status="$1" msg="$2"
  logger -t "$TAG" "status=${status} run=${RUN_ID} ${msg}"
  log "status=${status} ${msg}"
  push_kuma "$status" "$msg"
}

# The fence leg's own report, to its own tile. The drill's tile answers "did the restore pass",
# and it cannot also answer "was the fence measured": a run that passes with a range unmeasured
# is `up` on that tile by construction. This one is `up` only when every fenced range was dialled
# and refused.
#
# Called from inside fence_check, BEFORE the two fatal paths call `fail` — a leak exits the run,
# and a push made afterwards would never happen. A run that dies before the leg ever executes
# pushes nothing here on purpose: the tile's deadline then expires and it goes DOWN by itself,
# which is the honest reading of a fence nobody measured this month.
report_fence() {
  local status="$1" msg="$2"
  logger -t "$TAG" "fence=${status} run=${RUN_ID} ${msg}"
  log "fence=${status} ${msg}"
  push_kuma "$status" "$msg" "$FENCE_PUSH_TOKEN"
}

# A fence verdict that also ends the run: report it to the fence tile first, then take the
# orchestrator's normal failure path, which reports the same text to the drill's tile and exits.
fence_fail() {
  report_fence down "$1"
  fail "$1"
}

guest_running() {
  "${VIRSH[@]}" domstate "$NAME" 2>/dev/null | grep -q running
}

# Idempotent, and called from the EXIT trap as well as inline: a guest that is already gone and a
# disk that is already deleted are both fine. Ordering matters — destroy before deleting the
# disk, or qemu keeps the deleted inode open until it exits and the space is not returned.
teardown() {
  if guest_running; then
    log "destroying guest $NAME"
    "${VIRSH[@]}" destroy "$NAME" >/dev/null 2>&1 || true
  fi
  [[ -e "$DISK" ]] && { rm -f "$DISK"; log "deleted $DISK"; }
  [[ -n "$WORK" && -d "$WORK" ]] && rm -rf "$WORK"
  [[ -n "$KNOWN_HOSTS" && -f "$KNOWN_HOSTS" ]] && rm -f "$KNOWN_HOSTS"
  # Evidence stays readable by the deploy user however the run ended — the failing runs are the
  # ones that get read. Runs here because teardown is what the EXIT trap calls.
  if [[ -d "${LOG_DIR:-}" ]]; then
    chgrp "{{ sys_user }}" "$LOG_DIR"/* 2>/dev/null || true
    chmod 640 "$LOG_DIR"/* 2>/dev/null || true
  fi
  return 0
}

fail() {
  report down "$*"
  exit 1
}

prune_old_evidence() {
  [[ -d "$LOG_ROOT" ]] || return 0
  find "$LOG_ROOT" -mindepth 1 -maxdepth 1 -type d -mtime "+${LOG_RETENTION_DAYS}" \
    -exec rm -rf {} + 2>/dev/null || true
}

# One argv for every ssh to the guest, so the timed drill call below can hand it to `timeout`
# — which execs a program and cannot run a shell function (the first run failed with
# "timeout: failed to run command 'ssh_guest'"). KNOWN_HOSTS is set before the first use.
ssh_argv() {
  printf '%s\n' ssh -i "$IDENTITY" -o IdentitiesOnly=yes \
      -o UserKnownHostsFile="$KNOWN_HOSTS" -o StrictHostKeyChecking=yes \
      -o HostKeyAlgorithms=ssh-ed25519 \
      -o BatchMode=yes -o ConnectTimeout=10 -o LogLevel=ERROR \
      "${GUEST_USER}@${GUEST_IP}"
}

ssh_guest() {
  local -a argv
  mapfile -t argv < <(ssh_argv)
  "${argv[@]}" "$@"
}

# ── The egress-fence leg ─────────────────────────────────────────────────────────────────────
# Dials every production range the staging nwfilter drops, plus an internet control target, from
# INSIDE the guest — in the window between "the guest answers ssh" and "the guest is handed the
# cluster token and the R2 write credentials", which is the only point where a broken fence can
# still be acted on.
#
# WHY IT RUNS FROM INSIDE THE GUEST. A filter that is present and INERT reads exactly like a
# working one from the host: `virsh nwfilter-dumpxml` lists it either way, and whether it is
# attached to the live tap device is not in that output. Reachability from the far side is the
# only signal that separates the two — which is the failure the fence was added after (the inert
# ufw `route deny`, #508). ansible/tests/staging/test_staging_egress_fence.py holds the filter's
# SHAPE; this leg is the half that measures whether it FIRES. It replaces
# scripts/diagnostics/staging_egress_probe.py, which dialled these same targets from the
# persistent daniel-stage guest and was retired with it (#2941, restored here as #2943).
#
# WHY THE CONTROL TARGET IS LOAD-BEARING. A fence that severed all egress makes every production
# target fail too, and that reads as a pass to anyone skimming. INTERNET must stay REACHABLE for
# a refused production target to mean anything, so a lost control is a FAILURE of the fence's
# design rather than a success of its blocking.
#
# WHY SOME TARGETS CARRY A HOST-SIDE CONTROL LEG. A ClusterIP and a pod IP are allocated, not
# pinned in the inventory. A target that has simply MOVED answers from nowhere, which is
# indistinguishable from a fence that holds. Each allocated target is therefore dialled from
# daniel-server too, where kube-proxy's DNAT makes it reachable at all.
#
# DECIDED: a leak aborts the run before any credential is staged; a target that answers from
# NEITHER side is reported and not fatal. Staleness only degrades the meaning of a NEGATIVE — a
# target answering from inside the guest is a leak whether or not it is stale, so leak detection
# survives it — and losing a month of restore-drill coverage because a ClusterIP moved is the
# worse trade. An unproven target is named per-target in egress-fence.log and rides along in this
# run's own Kuma message as `fence=hold,unproven=<labels>`.
#
# DECIDED: the fence verdict pushes a Kuma tile of its own, `etcd Restore Drill (egress fence)`.
# This reverses the "there is no separate Kuma tile; the drill's own tile carries it" decision
# this marker used to carry (#2943), on the evidence of #3021: the drill tile cannot express the
# non-fatal half. An unproven range leaves the drill PASSING, so the drill's tile is `up` and the
# only record that a fenced range went unmeasured is the message text of a green push — which
# alerts nobody. The leg exists so that an unmeasured fence does not read as a held one, and at
# the monitor layer it did. report_fence below carries the wiring.

fence_curl() { printf 'curl -sk --max-time %s -o /dev/null %s' "$FENCE_PROBE_TIMEOUT" "$1"; }

# One `label|what the guest runs|what THIS host runs as the control leg` row per target; an
# empty third field means the address is pinned in the inventory and cannot go stale without a
# commit, so a second dial would prove nothing. Read ONCE per run — `ip neigh` is live, and a
# table built twice could name two different pod IPs.
fence_targets() {
  # The control, and the only row that is not a production address.
  printf '%s|%s|\n' INTERNET "$(fence_curl https://1.1.1.1)"
  # lan_subnet: the cluster edge, the API server, and daniel-pi's wg-easy admin UI — which is
  # unauthenticated, and whose only protection is the LAN-only premise this guest sits outside.
  printf '%s|%s|\n' PRODVIP "$(fence_curl http://{{ k3s_metallb_ingress_vip }})"
  printf '%s|%s|\n' K3SAPI "$(fence_curl https://{{ hostvars['daniel-box'].server_ip }}:6443/version)"
  printf '%s|%s|\n' WGEASY "$(fence_curl http://{{ hostvars['daniel-pi'].server_ip }}:51821)"
  # k3s_service_cidr. Longhorn's frontend Service is the thing actually found exposed on
  # 2026-08-28, answering unauthenticated with a mutating `diskUpdate` action in its payload.
  printf '%s|%s|%s\n' LONGHORNSVC "$(fence_curl "$FENCE_LONGHORN_URL")" "$(fence_curl "$FENCE_LONGHORN_URL")"
  # k3s_pod_cidr. Discovered rather than pinned, because a pod IP is ephemeral: whichever pod on
  # this host's CNI bridge the neighbour table currently holds. Read from `ip neigh` and not
  # kubectl, because daniel-server is an agent node with no kubeconfig — kubectl here dials
  # localhost:8080 and is refused. ICMP rather than HTTP: the neighbour is whichever pod happens
  # to be up and its listening port is unknown, while the nwfilter rule carries no protocol, so a
  # ping proves the same rule an HTTP dial would.
  #
  # STALE, DELAY and PROBE count alongside REACHABLE: an idle entry ages out of REACHABLE while
  # its address stays good, and the ping re-resolves it. Taking REACHABLE alone would fall to the
  # no-neighbour row below on a quiet bridge, leaving the pod CIDR unmeasured most months.
  local pod_ip
  # Matched as a FIELD, not with a `$` anchor: `ip neigh` pads every line with a trailing space,
  # so an anchored state matches nothing and every run falls to the no-neighbour row.
  pod_ip="$(ip -4 neigh show dev cni0 2>/dev/null |
    awk '{for (i = 2; i <= NF; i++) if ($i ~ /^(REACHABLE|STALE|DELAY|PROBE)$/) {print $1; exit}}')"
  if [[ -n "$pod_ip" ]]; then
    printf '%s|%s|%s\n' PODNET "ping -c1 -W3 $pod_ip" "ping -c1 -W3 $pod_ip"
  else
    # Emitted rather than skipped. A row that is simply absent leaves no evidence line and no
    # label, so the run reports a clean `hold` with the pod CIDR never dialled — this issue's own
    # failure, one level down. The sentinel makes it an `unproven` target instead.
    printf '%s|%s|\n' PODNET "SKIP: no usable neighbour on cni0 to dial"
  fi
  return 0
}

# Every dial in ONE ssh session, reading the table on stdin and printing `LABEL rc` per target.
# Not one session per target: six sessions are six chances to hang, and this orchestrator has
# already paid for a hung session once (run 20260911T135526Z). `na` is printed when the dial
# needs a tool the guest does not have — a missing tool must never read as `refused`, which is
# the same bug shape as an inert fence.
fence_dial_guest() {
  local -a argv script
  mapfile -t argv < <(ssh_argv)
  # Single-quoted on purpose: every expansion in here belongs to the guest's shell, not this
  # one, so the text has to travel unexpanded.
  # shellcheck disable=SC2016
  script=(
    'dial() { label="$1"; shift; command -v "$1" >/dev/null 2>&1 || { echo "$label na"; return; };'
    '         if "$@" >/dev/null 2>&1; then echo "$label 0"; else echo "$label $?"; fi; }'
  )
  local label probe _control
  while IFS='|' read -r label probe _control; do
    [[ -z "$label" || "$probe" == SKIP:* ]] && continue
    script+=("dial $label $probe")
  done
  printf '%s\n' "${script[@]}" | timeout "$FENCE_DEADLINE" "${argv[@]}" bash -s
}

# Reads the table, dials it, writes the evidence file, and sets FENCE_VERDICT. Fatal on a leak
# or a lost control target, both through `fail` — so the EXIT trap still destroys the guest.
fence_check() {
  local fence_log="$LOG_DIR/egress-fence.log" table
  table="$(fence_targets)"

  local -A dialled=()
  local label code
  while read -r label code; do
    [[ -n "$label" ]] && dialled["$label"]="$code"
  done < <(printf '%s\n' "$table" | fence_dial_guest)

  local -a leaked=() unproven=()
  local probe control state
  : >"$fence_log"
  while IFS='|' read -r label probe control; do
    [[ -n "$label" ]] || continue
    code="${dialled[$label]-}"
    if [[ "$probe" == SKIP:* ]]; then
      state="UNPROVEN (${probe#SKIP: })"
    else
      case "$code" in
        0)  state=REACHABLE ;;
        "") state="UNPROVEN (the guest reported no result for this target)" ;;
        na) state="UNPROVEN (the dial needs a tool the guest does not have)" ;;
        127) state="UNPROVEN (the dial exited 127: it could not be run in the guest)" ;;
        *)  state="refused (exit $code)" ;;
      esac
      if [[ -n "$control" && "$code" != 0 ]] \
        && ! timeout $((FENCE_PROBE_TIMEOUT + 4)) bash -c "$control" >/dev/null 2>&1; then
        state="UNPROVEN (stale: answered from neither the guest nor this host)"
      fi
    fi
    printf '%-12s %-58s %s\n' "$label" "$state" "$probe" >>"$fence_log"
    case "$state" in
      REACHABLE) [[ "$label" == INTERNET ]] || leaked+=("$label") ;;
      UNPROVEN*) unproven+=("$label") ;;
    esac
  done <<<"$table"

  log "egress fence, dialled from inside the guest:"
  cat "$fence_log"

  [[ "${dialled[INTERNET]-}" == 0 ]] || fence_fail "egress fence UNPROVEN: the internet control target did \
not answer from the guest, so every production target refused below did so only because nothing \
can leave at all. That is a broken fence, not a working one; nothing was staged into the guest. \
See $fence_log"
  # Emptiness tested with -z rather than the array-length form, here and below: a literal
  # dollar-brace-hash in a .j2 opens a Jinja comment, and the template then never renders.
  [[ -z "${leaked[*]}" ]] || fence_fail "egress fence BROKEN: ${leaked[*]} answered from inside guest \
$NAME, which is about to be handed the cluster token and the R2 write credentials. Nothing was \
staged. Traffic arrives at production SNATed as daniel-server, so source-IP controls do not see \
the guest as foreign. Check the LIVE tap device carries the filter — a defined-but-unreferenced \
filter reads identical from the host: virsh -c qemu:///system dumpxml $NAME | grep -A2 filterref. \
See $fence_log"

  if [[ -n "${unproven[*]}" ]]; then
    FENCE_VERDICT="hold,unproven=$(IFS=,; printf '%s' "${unproven[*]}")"
    log "fence verdict: $FENCE_VERDICT — those targets were not tested, so the fence was not \
proven against their range. The run continues: a leak is still detected whether or not a target \
is stale, and a moved address is not worth a skipped restore drill."
    report_fence down "egress fence UNMEASURED against ${unproven[*]}: those targets answered \
from neither the guest nor daniel-server, so refusal from the guest proves nothing about their \
range and the fence is unproven there. The restore drill itself continues and is unaffected. \
Fix the probe, not the fence: re-read the target's live address (Longhorn's ClusterIP, or a pod \
on this host's cni0 bridge) in $fence_log, then correct it in roles/setup/hypervisor."
  else
    FENCE_VERDICT=hold
    report_fence up "egress fence holds: every fenced range refused from inside guest $NAME, \
with the internet control target reachable. See $fence_log"
  fi
}

main() {
  if [[ "$ARMED" != "1" ]]; then
    logger -t "$TAG" "disarmed (hypervisor_etcd_drill_armed=false); nothing run"
    exit 0
  fi

  exec 9>"$LOCK"
  flock -n 9 || fail "another run holds $LOCK"

  # Group-readable by the deploy user: the evidence carries no credential by construction (the
  # token and the R2 env never leave the guest), and a run is diagnosed from a non-root shell.
  install -d -m 750 -g "{{ sys_user }}" "$LOG_DIR"
  # From here on the orchestrator's own lines go into the run's evidence dir, so they are pruned
  # with it. cron.log (the cron's redirect) then holds only what escapes before this point.
  exec >>"$LOG_DIR/orchestrator.log" 2>&1
  prune_old_evidence

  # Preflight: everything the guest will be handed must exist HERE first, so a missing piece
  # fails before a guest is built rather than half-way through a run.
  [[ -r "$XML" ]]              || fail "guest definition $XML missing — run initial_setup --tags hypervisor"
  [[ -r "$BASE_IMAGE" ]]       || fail "base image $BASE_IMAGE missing"
  [[ -r "$SEED" ]]             || fail "seed ISO $SEED missing"
  [[ -r "$GUEST_HOSTKEY_PUB" ]] || fail "pinned guest host key $GUEST_HOSTKEY_PUB missing"
  [[ -r "$IDENTITY" ]]         || fail "ssh identity $IDENTITY missing"
  [[ -r "$S3_ENV" ]]           || fail "R2 env $S3_ENV missing"
  [[ -r "$AGENT_ENV" ]]        || fail "$AGENT_ENV missing — is this host a k3s agent?"
  [[ -x "$DRILL_SCRIPT" ]]     || fail "drill script $DRILL_SCRIPT missing — run initial_setup --tags hypervisor"
  [[ -x "$GUEST_RUN_SCRIPT" ]] || fail "guest-side script $GUEST_RUN_SCRIPT missing"
  command -v k3s >/dev/null    || fail "k3s not on PATH"
  command -v qemu-img >/dev/null || fail "qemu-img not on PATH"

  local k3s_version
  k3s_version="$(k3s --version | head -1)"
  log "run $RUN_ID; shipping $k3s_version into the guest"

  # A previous run that died between create and destroy leaves a running guest and its disk.
  teardown

  log "creating $DISK from $BASE_IMAGE"
  qemu-img convert -O qcow2 "$BASE_IMAGE" "$DISK" || fail "qemu-img convert failed"
  qemu-img resize "$DISK" "$DISK_SIZE" >/dev/null || fail "qemu-img resize failed"

  log "starting transient guest $NAME"
  "${VIRSH[@]}" create "$XML" >/dev/null || fail "virsh create $XML failed"

  # The pinned host key: one line, this address, the public half ansible generated. Anything else
  # answering at GUEST_IP is refused, which is the whole point of pinning.
  KNOWN_HOSTS="$(mktemp)"
  printf '%s %s\n' "$GUEST_IP" "$(cut -d' ' -f1,2 < "$GUEST_HOSTKEY_PUB")" > "$KNOWN_HOSTS"

  log "waiting up to ${BOOT_TIMEOUT}s for ssh at $GUEST_IP"
  local deadline=$((SECONDS + BOOT_TIMEOUT))
  until ssh_guest true 2>/dev/null; do
    guest_running || fail "guest exited during boot"
    (( SECONDS < deadline )) || fail "guest never answered on ssh in ${BOOT_TIMEOUT}s"
    sleep 5
  done
  log "guest is up"

  # Before the token and the R2 credentials go in, not after: this is the last point at which a
  # guest that can reach production has not yet been handed anything to reach it with.
  fence_check

  # Stage everything the drill reads, at the paths it reads them, as one tar. Root-owned here
  # so the modes and owners land as-is on the far side. The token is read from the agent env
  # file and written to disk only inside this 0700 staging dir, which is deleted the moment the
  # tar has been sent.
  WORK="$(mktemp -d)"
  chmod 700 "$WORK"
  local K3S_TOKEN=""
  # shellcheck source=/dev/null
  . "$AGENT_ENV"
  [[ -n "$K3S_TOKEN" ]] || fail "K3S_TOKEN is empty in $AGENT_ENV"
  install -D -m 755 "$(command -v k3s)" "$WORK/root/usr/local/bin/k3s"
  install -d -m 700 "$WORK/root/var/lib/rancher/k3s/server"
  (umask 077; printf '%s\n' "$K3S_TOKEN" > "$WORK/root/var/lib/rancher/k3s/server/token")
  install -D -m 600 "$S3_ENV" "$WORK/root/etc/rancher/k3s/etcd-s3.env"
  install -D -m 755 "$DRILL_SCRIPT" "$WORK/root/usr/local/bin/etcd-restore-drill"
  install -D -m 755 "$GUEST_RUN_SCRIPT" "$WORK/root/usr/local/bin/etcd-drill-guest-run"

  log "staging k3s, token, R2 env and the drill into the guest"
  tar -C "$WORK/root" -cf - . | ssh_guest sudo tar -C / --warning=no-timestamp -xpf - || fail "staging into the guest failed"
  rm -rf "$WORK"; WORK=""

  # The drill runs DETACHED in the guest and this side polls for its exit file. Holding one ssh
  # session open for the whole run is what the first design did, and run 20260911T135526Z hung
  # that session for 20 minutes after the drill's own k3s had already been killed — with the
  # guest still answering a fresh ssh throughout. A detached run cannot take the orchestrator
  # down with it, its exit code survives in a file, and drill.out is pulled whatever happened.
  log "starting the drill in the guest (log: $LOG_DIR/drill.out)"
  ssh_guest sudo /usr/local/bin/etcd-drill-guest-run --detached \
    || fail "could not start the drill in the guest"

  local rc="" deadline=$((SECONDS + RUN_TIMEOUT))
  while :; do
    rc="$(ssh_guest sudo cat /var/tmp/etcd-drill.rc 2>/dev/null || true)"
    [[ -n "$rc" ]] && break
    if (( SECONDS >= deadline )); then
      rc=124
      log "run exceeded ${RUN_TIMEOUT}s; guest process listing follows in $LOG_DIR/ps.out"
      ssh_guest sudo ps -eo pid,ppid,etimes,stat,args >"$LOG_DIR/ps.out" 2>&1 || true
      ssh_guest sudo pkill -TERM -f /usr/local/bin/etcd-drill-guest-run >/dev/null 2>&1 || true
      break
    fi
    guest_running || { rc=125; log "guest exited during the drill"; break; }
    sleep 15
  done
  [[ "$rc" =~ ^[0-9]+$ ]] || rc=1

  # Evidence out BEFORE teardown, on every path: the diagnosis and the thing that explains it
  # must not be removed by the same exit path (the drill script's own rule, kept here).
  ssh_guest sudo cat /var/tmp/etcd-drill.out >"$LOG_DIR/drill.out" 2>/dev/null || true
  local f
  for f in restore.log server.log; do
    ssh_guest "sudo sh -c 'cat /var/tmp/etcd-restore-drill.*/$f'" >"$LOG_DIR/$f" 2>/dev/null || true
  done

  teardown

  local snapshot counts
  snapshot="$(sed -n 's/.*drilling snapshot: //p' "$LOG_DIR/drill.out" | head -1)"
  counts="$(grep -E '^(namespaces|deployments|PVCs|CRDs) ' "$LOG_DIR/drill.out" | tr -s ' ' | paste -sd, -)"

  if [[ $rc -eq 0 ]]; then
    install -d -m 755 "$STAMP_DIR"
    printf 'mode=%s\nsnapshot=%s\nutc=%s\nepoch=%s\nhost=%s\n' \
      full "${snapshot:-unknown}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(date -u +%s)" "$NAME" \
      > "$STAMP_DIR/last-success-full"
    chmod 0644 "$STAMP_DIR/last-success-full"
    report up "full restore drill passed in guest $NAME: snapshot=${snapshot:-unknown} ${counts} k3s=${k3s_version} fence=${FENCE_VERDICT}"
    exit 0
  fi
  local reason
  reason="$(grep -m1 -E 'etcd-restore-drill: |etcd-drill-guest-run: ' "$LOG_DIR/drill.out" | tail -c 200)"
  [[ $rc -eq 124 ]] && reason="run exceeded ${RUN_TIMEOUT}s and was killed"
  [[ $rc -eq 125 ]] && reason="guest exited during the drill"
  fail "full restore drill FAILED (exit $rc): ${reason:-see $LOG_DIR/drill.out} snapshot=${snapshot:-unknown} fence=${FENCE_VERDICT}"
}

trap teardown EXIT
main "$@"
