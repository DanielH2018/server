# Managed by Ansible (roles/setup/claude_code) — edits here are overwritten.
#
# A login shell as {{ claude_code_agent_user }}. Its own claude and uv come first on PATH:
# /usr/local/bin/uv is a symlink into /home/{{ sys_user }}, which this user cannot read.
PATH="$HOME/.local/bin:$PATH"
# The repo's hook shim (.claude/hooks/run-hook.sh) defaults to the operator's checkout and uv,
# so without these every guarded hook fails its cd and asks instead of running. renovate-agent's
# unit sets the same two.
export RUN_HOOK_PROJECT_DIR={{ claude_code_agent_user_clone_dir }}
export RUN_HOOK_UV={{ claude_code_agent_user_home }}/.local/bin/uv
# scripts/dev/fanout_lib/target.py:branch_name names a fan-out batch's branch
# `worktree-<prefix>+fanout-<batch>` from this, the one shape the agent branch fence lets this
# user push (#3618). A script that names branches itself never reads the agent's CLAUDE.md.
export CLAUDE_WORKTREE_PREFIX={{ claude_code_agent_worktree_prefix }}
{% if claude_code_lander_enabled %}
# land.sh hands each landing this user starts to claude-land@<n>.service, which lands it as
# {{ sys_user }} under the landing policy (scripts/deploy_tools/land_lib/handoff.py). This user's
# token cannot merge and it has no sudo, so a landing of its own would fail at the merge.
export LAND_HANDOFF_UNIT=claude-land
{% endif %}
