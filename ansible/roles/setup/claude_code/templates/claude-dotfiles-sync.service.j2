[Unit]
Description=Apply the operator's dotfiles to the {{ claude_code_agent_user }} agent user
{% if claude_code_sync_alert_unit is defined %}
OnFailure={{ claude_code_sync_alert_unit }}
{% else %}
OnFailure={{ claude_code_agent_user }}-dotfiles-sync-alert.service
{% endif %}
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# This host's journald stores notice and above (MaxLevelStore=notice), so stdout logs at notice.
SyslogLevel=notice
# As the agent: chezmoi writes into its home, and git refuses a source another user owns.
User={{ claude_code_agent_user }}
Environment=HOME={{ claude_code_agent_user_home }}
Environment=USER={{ claude_code_agent_user }}
Environment=TMPDIR=/tmp
# The dotfiles' scripts expect ~/.local/bin, where the agent's uv and chezmoi live, first on
# PATH, and /usr/local/bin for kubectl.
Environment=PATH={{ claude_code_agent_user_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin
# The script refuses, failing the unit, when the source does not render the agent variant.
ExecStart=/usr/local/bin/claude-dotfiles-sync.sh {{ claude_code_agent_user_home }}/.local/bin/chezmoi {{ claude_code_agent_user_home }}/.config/chezmoi/seed.toml
# The textfile that tells a timer which stopped firing from one that runs clean (#6165).
# timer-textfile.j2 has the shape and the deadline rule.
{% from 'timer-textfile.j2' import timer_textfile with context %}
{{ timer_textfile(claude_code_agent_user ~ '-dotfiles-sync', claude_code_agent_dotfiles_sync_interval) }}
