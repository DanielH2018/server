{% import 'claude-triage-pins.j2' as pins with context -%}
[Unit]
Description=Unattended triage of monitor episode %i, as the agent user
After=network-online.target
Wants=network-online.target
# A run that crashes, or that systemd kills, pages here. A run that finishes pages through
# claude-triage-report-alert@<episode>:<state>.service instead, which the script starts itself.
OnFailure=homelab-alert@%n.service

[Service]
Type=oneshot
# The agent user, never {{ sys_user }}: the episode text is untrusted, and this user has no
# sudo, no age key, read-only kubectl and no read on /home. docs/claude-agent-user.md,
# "Alert-triggered triage", has the design.
User={{ pins.agent_user }}
WorkingDirectory={{ pins.agent_home }}/server
Environment=HOME={{ pins.agent_home }}
# systemd's PATH is as minimal as cron's: without /usr/local/bin the session loses kubectl and
# reports an empty cluster rather than failing.
Environment=PATH={{ pins.agent_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=KUBECONFIG={{ pins.agent_home }}/.kube/config
# The repo's hook shim resolves the clone and uv from these. A guard that cannot start turns
# every Bash call into an ask, and nobody answers one here.
Environment=RUN_HOOK_PROJECT_DIR={{ pins.agent_home }}/server
Environment=RUN_HOOK_UV={{ pins.agent_home }}/.local/bin/uv
Environment=PYTHONDONTWRITEBYTECODE=1
# The Claude credential from `claude setup-token`, read by systemd as root (0600), so it is in
# no unit line `systemctl show` publishes. It is this unit's own token: the interactive login
# claude-rc.service uses can lapse while idle (#4618).
EnvironmentFile=/etc/claude-triage/session.env
SyslogLevel=notice
# SIGINT ends the session's turn cleanly; SIGTERM exits 143 with the turn unrecorded.
KillSignal=SIGINT
# Above the script's own RUN_TIMEOUT_S ({{ pins.run_timeout_s }}s), which should
# trip first: it still writes the record, the report and the page.
TimeoutStartSec={{ pins.run_timeout_s + 600 }}
NoNewPrivileges=yes
# DECIDED: UMask=0027, as claude-rc.service.j2 sets it. homelab-claude-triage.conf gives the
# operator's group traverse on the state directory, so under systemd's default 0022 a record, a log or a
# directory this unit creates there would be world-readable by its fixed name. A report lands
# in the setgid artifacts directory, where 0640 keeps the operator's group read.
UMask=0027
ProtectHome=yes
ProtectProc=invisible
PrivateTmp=yes
# One run at a time. A busy lock exits 75, which is not a failure: the episode stays in the
# inbox for the next start, and nothing pages.
SuccessExitStatus=75
# The state directories and their modes, before the lock inside them is taken.
ExecStartPre=+/usr/bin/systemd-tmpfiles --create /usr/lib/tmpfiles.d/homelab-claude-triage.conf
ExecStart=/usr/bin/flock -n -E 75 {{ pins.state_dir }}/run.lock \
  {{ pins.agent_home }}/.local/bin/uv run --no-project --no-python-downloads \
  --python {{ host_python_version }} /opt/claude-triage/claude_triage_run.py %i
