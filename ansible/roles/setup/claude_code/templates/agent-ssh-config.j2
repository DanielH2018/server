# {{ ansible_managed }}
# The agent reaches each peer as that peer's own agent user, `{{ claude_code_agent_user }}`, which
# has no sudo. A peer appears here while its host_vars set claude_agent_ssh_login_enabled.
{% for peer in groups['all'] if peer != claude_agent_ssh_key_host and hostvars[peer].claude_agent_ssh_login_enabled | default(false) | bool %}

Host {{ peer }}
    HostName {{ hostvars[peer].server_ip }}
    User {{ claude_code_agent_user }}
    IdentityFile {{ claude_agent_ssh_key_path }}
    # Offer this key and no other, so a peer never sees a key the agent was not meant to use.
    IdentitiesOnly yes
    # DECIDED: accept-new rather than a pinned host key. The agent has no read on the operator's
    # known_hosts, and the key it offers authorizes a no-sudo account, so a spoofed peer learns
    # nothing it can use. A changed host key is still refused.
    StrictHostKeyChecking accept-new
{% endfor %}
