# Managed by Ansible (roles/setup/claude_code) — edits here are overwritten.
# Read by systemd as root for claude-triage@.service; root 0600. The token is a one-year
# `claude setup-token` credential minted as the agent user, kept out of the agent's own files so
# a session cannot copy it into the clone or a report.
#
# Whitespace is stripped: `setup-token` wraps the token onto an indented second line, and the
# first copy pasted on 2026-10-17 carried two spaces from the wrap, which Claude rejected as
# "Not logged in" (401). A token never contains whitespace, so removing it loses nothing.
CLAUDE_CODE_OAUTH_TOKEN={{ claude_code_triage_claude_oauth_token | default('') | regex_replace('\\s', '') }}
