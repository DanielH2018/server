# Managed by Ansible (roles/setup/claude_code) — edits here are overwritten.
# Read by systemd as root for claude-triage@.service; root 0600. The token is a one-year
# `claude setup-token` credential minted as the agent user, kept out of the agent's own files so
# a session cannot copy it into the clone or a report.
CLAUDE_CODE_OAUTH_TOKEN={{ claude_code_triage_claude_oauth_token | default('') }}
