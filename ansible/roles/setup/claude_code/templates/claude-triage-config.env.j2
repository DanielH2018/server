{% import 'claude-triage-pins.j2' as pins with context -%}
# Shipped by the claude-code host component (roles/setup/claude_code's template).
# claude_triage_run.py's settings. Root-owned and world-readable: it holds no secret, and a
# session steered by text it read must not be able to raise its own budget or point the next
# run at a prompt of its own. claude-triage-pins.j2 pins every cap as a literal, and that file is
# on the lander's approval list.
STATE_DIR={{ pins.state_dir }}
REPORT_DIR={{ pins.agent_home }}/.claude/artifacts
REPORT_BASE_URL=https://artifacts.{{ domain }}/a/{{ inventory_hostname }}-{{ pins.agent_user }}/
PROMPT_FILE=/opt/claude-triage/prompt.txt
WORKDIR={{ pins.agent_home }}/server
CLAUDE_BIN={{ pins.agent_home }}/.local/bin/claude
MODEL={{ pins.model }}
BUDGET_USD={{ pins.budget_usd }}
MAX_TURNS={{ pins.max_turns }}
RUN_TIMEOUT_S={{ pins.run_timeout_s }}
DAILY_CAP={{ pins.daily_cap }}
# claude_triage_poll.py's settings.
POLL_MODE={{ pins.poll_mode }}
PROM_URLS={{ claude_code_triage_prom_urls | join(' ') }}
POLL_STREAK={{ claude_code_triage_poll_streak }}
POLL_STORM_SIZE={{ claude_code_triage_poll_storm_size }}
# The weekly reboot, from the same group_vars the Kuma and Alertmanager mutes read. The grace
# runs from the cron firing: the shutdown delay, then the recovery.
REBOOT_WEEKDAY={{ weekly_reboot_weekday }}
REBOOT_HOUR={{ weekly_reboot_hour }}
REBOOT_MINUTE={{ weekly_reboot_minute }}
REBOOT_BEFORE_MIN={{ weekly_reboot_mute_lead_minutes }}
REBOOT_GRACE_MIN={{ weekly_reboot_shutdown_delay_minutes + weekly_reboot_mute_recovery_minutes }}
