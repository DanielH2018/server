# Managed by Ansible (roles/setup/claude_code) — edits here are overwritten.
# claude_triage_run.py's settings. Root-owned and world-readable: it holds no secret, and a
# session steered by text it read must not be able to raise its own budget or point the next
# run at a prompt of its own. tasks/triage.yml pins every cap as a literal, and that file is on
# the lander's approval list.
STATE_DIR={{ claude_code_triage_state_dir }}
REPORT_DIR={{ claude_code_triage_agent_home }}/.claude/artifacts
REPORT_BASE_URL=https://artifacts.{{ domain }}/a/{{ inventory_hostname }}-{{ claude_code_triage_agent_user }}/
PROMPT_FILE=/opt/claude-triage/prompt.txt
WORKDIR={{ claude_code_triage_agent_home }}/server
CLAUDE_BIN={{ claude_code_triage_agent_home }}/.local/bin/claude
MODEL={{ claude_code_triage_model }}
BUDGET_USD={{ claude_code_triage_budget_usd }}
MAX_TURNS={{ claude_code_triage_max_turns }}
RUN_TIMEOUT_S={{ claude_code_triage_run_timeout_s }}
