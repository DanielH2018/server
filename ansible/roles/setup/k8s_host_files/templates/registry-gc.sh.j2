#!/usr/bin/env bash
# Registry garbage collection — managed by Ansible (k8s/registry role); edits overwritten.
#
# WHY THIS EXISTS: the ghcr-mirror Deployment (ghcr-mirror.yaml.j2) runs with REGISTRY_PROXY_TTL
# 0s, so nothing expires an image it cached, and its store grows with every upgrade of any
# ghcr.io image in the cluster until the 30Gi claim fills (#5541). The registry never collects
# on its own, so this weekly run prunes the store offline and garbage-collects it.
#
# TWO STORES, ONE AT A TIME. The dockerhub-mirror (dockerhub-mirror.yaml.j2) runs with a zero
# TTL too (#6536): a TTL counts from the fetch, so it deleted an image a pod still ran one TTL
# after its first pull. Each store gets the same phase in turn: stamp, scale-down, prune Job,
# restore, warm. The globals below describe the ghcr-mirror, and use_dockerhub_store points them
# at the dockerhub-mirror between the two phases, so at most one mirror is ever down and the
# EXIT trap restores whichever one is.
#
# STOP-THE-WORLD, NOT OPTIONAL. Upstream: "You should ensure that the registry is in read-only
# mode or not running at all. If you were to upload an image while garbage collection is running,
# there is the risk that the image's layers are mistakenly deleted leading to a corrupted image."
# A pull-through mirror uploads into its own store on every cache miss, so the same holds here.
# A corrupt image still PULLS, and only crashloops the workload later, with nothing pointing back
# at GC. Hence scale-to-0 for the duration. containerd falls back to ghcr.io meanwhile.
#
# THE PUSH STORE IS NOT COLLECTED. Its phase scaled deploy/registry, whose `replicas: 1` Flux
# renders after registry's flip, so Flux would restore the pod mid-GC. No image-builder caller is
# Ansible-owned any more, so no build reaches that store, and D5 retired its GC rather than
# moving it (docs/target-architecture/deploy/d5-bulk-move.md, Wave D's registry bullet). The
# verify Job's seed still adds about 20 MB per flux_job_image pin, which nothing reclaims (#5752).
#
# Neither mirror's Deployment renders `replicas:`, so Flux's server-side apply does not own
# `spec.replicas`, and this script is that field's only writer. The operator accepted that
# exception to contract C4 on field ownership for deploy/ghcr-mirror (#5732), and #6536 extends
# it to deploy/dockerhub-mirror.
#
# ROOT KUBECONFIG, unlike every sibling script deployed by this repo. disk-health.sh,
# longhorn-backup-health.sh and manifest-prune-check.sh all use the read-only ServiceAccount
# precisely so a bug there cannot mutate the cluster. This one MUST scale a Deployment, so it
# holds a credential that can. Everything it does is scoped to the two mirror Deployments, their
# own Jobs and their keep-set ConfigMaps; keep it that way.
#
# ONE LOCK FOR THE WHOLE RUN. The script holds an flock on registry_k8s_gc_lock_file from
# before the scale-down until after the restore, and the registry deploy restores a mirror it
# finds at zero only under the same lock (tasks/main.yml), so the deploy can never put the pod
# back while this run prunes the store (#5736). The kernel drops the lock when the process
# dies, however it dies.
#
# A STAMP THAT OUTLIVES THE RUN. /var/lib/registry-gc/ghcr-mirror-down, and dockerhub-mirror-down
# beside it, exists from just before the scale-down until that mirror is serving again. A run killed in between leaves it behind,
# and the next run's phase for that mirror starts by restoring it. No deploy restores either.
#
# A WARM PHASE AFTER THE RESTORE. Once the mirror serves again, the run GETs every linux/amd64
# blob of every ghcr.io image the cluster names, through the mirror, so the mirror caches what it
# missed: images a node pulled before the mirror existed, and pulls that fell back to ghcr.io
# while a GC held the mirror at zero. A cold start during a WAN outage finds only what the store
# already holds, and a cold blob fetched while GHCR is slow takes many minutes even though the
# mirror's ghcr-resume sidecar now completes it (#5654, #6401). So a weekly warm fetches those
# blobs ahead of need, at GHCR's normal speed (49 MB/s cold through the mirror, measured
# 2026-10-24). The dockerhub-mirror's warm reads Docker Hub only for a manifest or blob its store
# lacks, and Docker Hub's anonymous limit counts manifest GETs, so a cold first warm may be
# refused partway. Each refusal is a named failure that leaves the run up, and the refs warm in
# a fixed order, so the store fills over the following weeks.
#
# Usage: registry-gc.sh (no arguments)
# Runs from the registry-gc root cron on daniel-box, weekly at the time set by
# registry_k8s_gc_cron_weekday, _hour and _minute. For each mirror in turn it scales the
# Deployment to 0, runs its Job from /etc/rancher/k3s/manifests/registry-jobs/ (the prune and
# garbage-collect), scales the mirror back and warms it. It pushes the result to Kuma when
# registry_gc_push_token is set. It reads /etc/rancher/k3s/k3s.yaml and
# /usr/local/lib/kuma-push-lib.sh, and keeps its state in /var/lib/registry-gc.

set -uo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

# shellcheck source=/dev/null
source /usr/local/lib/kuma-push-lib.sh || {
  logger -t registry-gc "kuma-push-lib.sh missing — run initial_setup on this host"
  exit 1
}

# Cron's default PATH (/usr/bin:/bin) omits /usr/local/bin, where the k3s installer puts the
# binary. Without this every kubectl call below silently resolves to nothing.
export PATH="/usr/local/bin:${PATH}"
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml

NS="{{ k8s_namespace }}"
KUBECTL="k3s kubectl -n ${NS}"
MIRROR_DEPLOY=ghcr-mirror
MIRROR_UPSTREAM=ghcr.io
MIRROR_REFS=ghcr_refs
MIRROR_JOB=registry-gc-ghcr-mirror
MIRROR_KEEP_CM=registry-gc-ghcr-mirror-keep
MIRROR_STARTED=0
MIRROR_DONE=0
MIRROR_NOTE=""
MIRROR_JOB_MANIFEST=/etc/rancher/k3s/manifests/registry-jobs/ghcr-mirror-gc-job.yaml
DOCKERHUB_JOB_MANIFEST=/etc/rancher/k3s/manifests/registry-jobs/dockerhub-mirror-gc-job.yaml
# Set while deploy/ghcr-mirror may be scaled down, so the EXIT trap knows to restore it.
MIRROR_DOWN=0
MIRROR_MSG=""
# The finished phases' messages, joined with the current one into the run's message.
DONE_MSG=""
FAILED=0
COMPLETED=0
STATE_DIR=/var/lib/registry-gc
STATE_FILE="${STATE_DIR}/state.json"
# The stamp and the lock the header describes. tasks/main.yml names the lock too.
MIRROR_STAMP="${STATE_DIR}/ghcr-mirror-down"
LOCK_FILE={{ registry_k8s_gc_lock_file }}
# The mirror's loopback hostPort. This cron runs on the registry node, which reaches it there,
# as that node's registries.yaml entry does.
MIRROR_URL="http://{{ k8s_registry_host_ip }}:{{ k8s_registry_ghcr_mirror_port }}"
# Every manifest type a registry can store, as node-exporter's mirror pull checks send.
ACCEPT=application/vnd.oci.image.index.v1+json,application/vnd.oci.image.manifest.v1+json,application/vnd.docker.distribution.manifest.list.v2+json,application/vnd.docker.distribution.manifest.v2+json
WARM_BUDGET_S={{ k8s_host_files_ghcr_mirror_warm_budget_s }}
# The upstream's refs write_mirror_keep_set read, one `<repo>@<digest>` or `<repo>:<tag>` per line.
WARM_REFS=""

# Points every per-mirror global above at the dockerhub-mirror and resets the phase's state.
# Called only once the ghcr-mirror's phase has restored that mirror.
use_dockerhub_store() {
  MIRROR_DEPLOY=dockerhub-mirror
  MIRROR_UPSTREAM=docker.io
  MIRROR_REFS=dockerhub_refs
  MIRROR_JOB=registry-gc-dockerhub-mirror
  MIRROR_KEEP_CM=registry-gc-dockerhub-mirror-keep
  MIRROR_JOB_MANIFEST=$DOCKERHUB_JOB_MANIFEST
  MIRROR_STAMP="${STATE_DIR}/dockerhub-mirror-down"
  MIRROR_URL="http://{{ k8s_registry_host_ip }}:{{ k8s_registry_dockerhub_mirror_port }}"
  WARM_BUDGET_S={{ k8s_host_files_dockerhub_mirror_warm_budget_s }}
  WARM_REFS=""
  MIRROR_STARTED=0 MIRROR_DONE=0 MIRROR_DOWN=0 MIRROR_NOTE="" MIRROR_MSG=""
}

KUMA_HOST="uptime-kuma.local.{{ domain }}"
KUMA_RESOLVE_IP="{{ k3s_metallb_ingress_vip }}"
PUSH_TOKEN="{{ registry_gc_push_token | default('') }}"

STATUS=down
MSG="did not complete"

finish() {
  mkdir -p "$STATE_DIR"
  # jq, not printf: MSG carries crane and kubectl error text, and a backslash, newline or
  # control character in it made the file unreadable by the jq an operator reads it with (#4606).
  jq -nc --arg ts "$(date -Is)" --arg status "$STATUS" --arg msg "$MSG" \
    '{ts: $ts, status: $status, msg: $msg}' > "$STATE_FILE"
  # Explicit, because root's umask here renders this 0640 and the operator reading it after a
  # run is not root. Nothing secret is in it — a status, a timestamp and a count.
  chmod 0644 "$STATE_FILE"

  if [[ -n "$PUSH_TOKEN" ]]; then
    kuma_push "$STATUS" "$MSG" "https://${KUMA_HOST}/api/push/${PUSH_TOKEN}" \
      "$KUMA_HOST" "$KUMA_RESOLVE_IP" registry-gc
  else
    logger -t registry-gc "registry_gc_push_token not set — skipping push (see /add-secret)"
  fi

  # Off-premises dead-man's switch — see longhorn-backup-health.sh.j2 for the full rationale.
  # Kuma runs on the cluster this mutates, so a cluster outage silences both the push above and
  # the monitor waiting for it. Skipped when no key is configured.
  # Names mirror longhorn-backup-health.sh.j2 exactly: test_healthchecks_pings.py selects the
  # files it audits by matching HC_PING_KEY / HC_URL, so a locally-renamed variable drops this
  # script out of the parametrization and the guards silently stop being checked.
  local HC_PING_KEY=""
  # shellcheck source=/dev/null
  [[ -r /etc/healthchecks/ping.env ]] && . /etc/healthchecks/ping.env
  if [[ -n "$HC_PING_KEY" ]]; then
    local HC_URL="https://hc-ping.com/${HC_PING_KEY}/registry-gc"
    [[ "$STATUS" == "up" ]] || HC_URL="${HC_URL}/fail"
    # No `-S`, stderr discarded — see longhorn-backup-health.sh.j2 (#2511).
    curl -fs --max-time 10 --retry 3 --data-raw "$MSG" "$HC_URL" >/dev/null 2>&1 \
      || logger -t registry-gc "healthchecks ping failed (status=${STATUS})"
  fi
}

# Scales Deployment $1 to zero and waits for its pod to exit. Scaling returns immediately, and
# GC must not start while the old process still holds the store. Each Deployment's pods carry
# `app: <its name>`.
stop_deploy() {
  $KUBECTL scale "deploy/${1}" --replicas=0 >/dev/null 2>&1
  $KUBECTL wait --for=delete pod -l app="${1}" --timeout=120s >/dev/null 2>&1
}

start_deploy() {
  $KUBECTL scale "deploy/${1}" --replicas=1 >/dev/null 2>&1
  $KUBECTL rollout status "deploy/${1}" --timeout=180s >/dev/null 2>&1
}

# The mirror Job mounts the same RWO claim the ghcr-mirror pod does, and both land on one node,
# so nothing stops the pod starting while the prune is still unlinking revisions. A Job not
# known to have finished is deleted, and waited for, before the mirror serves the store again.
# One that succeeded or failed stays until its TTL, so the log a failure MSG names is still
# there. Either way its prune lines reach the journal first.
restore_mirror_store() {
  [[ "$MIRROR_DOWN" == 1 ]] || return 0
  MIRROR_DOWN=0
  if [[ "$MIRROR_STARTED" == 1 && "$MIRROR_DONE" != 1 ]]; then
    journal_mirror_prune >/dev/null
    local finished
    finished=$($KUBECTL get job "$MIRROR_JOB" \
                 -o jsonpath='{.status.succeeded}{.status.failed}' 2>/dev/null)
    if [[ -z "$finished" ]]; then
      $KUBECTL delete job "$MIRROR_JOB" --ignore-not-found --cascade=foreground --wait=true \
        --timeout=120s >/dev/null 2>&1
    fi
  fi
  if start_deploy "$MIRROR_DEPLOY"; then
    rm -f "$MIRROR_STAMP"
    return 0
  fi
  MIRROR_MSG="${MIRROR_MSG:-${MIRROR_DEPLOY} store not collected}; ${MIRROR_DEPLOY} did NOT come back — check deploy/${MIRROR_DEPLOY}"
  return 1
}

# The mirror MUST come back even if GC dies, the deadline trips, or cron kills us. Without this
# a failed run leaves the cluster unable to pull that upstream's images during a WAN outage until
# a human notices, which is the outage the mirror exists to prevent.
scale_up_and_report() {
  restore_mirror_store || FAILED=1
  if [[ "$COMPLETED" == 1 && "$FAILED" == 0 ]]; then
    STATUS=up
  else
    STATUS=down
  fi
  local msg="${DONE_MSG}${DONE_MSG:+${MIRROR_MSG:+; }}${MIRROR_MSG}"
  [[ -n "$msg" ]] && MSG="$msg"
  finish
}
trap scale_up_and_report EXIT

# Copies the mirror prune's per-revision lines to the journal and prints them. The prune names
# every revision it removed, and the Job log goes when the Job's TTL runs out.
journal_mirror_prune() {
  local lines
  lines=$($KUBECTL logs "job/${MIRROR_JOB}" -c prune 2>/dev/null \
            | grep -E '^(pruned|keeping|could not) ')
  [[ -n "$lines" ]] || return 0
  logger -t registry-gc <<<"$lines"
  printf '%s\n' "$lines"
}

# ── keep set ─────────────────────────────────────────────────────────────────────────────────
# Each mirror's store is pruned offline by its GC Job (files/ghcr-mirror-prune.sh, #5541), which
# has no API access. It reads the digests to keep from a ConfigMap this function writes before
# the scale-down.
#
# EVERY NAMESPACE, AND SPECS AS WELL AS STATUSES. A `registries.yaml` mirror covers the whole
# ghcr.io host, so Flux's controllers in flux-system pull through it as much as anything here.
# A CronJob's pod is not running at 04:20 on a Sunday, so its pinned digest comes from its spec.
# Every sha256 digest in the JSON is kept, for either store, which can only keep more than
# strictly needed.
#
# LSCR.IO REFS COUNT AS GHCR.IO REFS. registries.yaml points lscr.io at this same mirror
# (#6257), and lscr.io serves ghcr.io's repositories under the same paths, so
# `lscr.io/linuxserver/x` is cached as `linuxserver/x` beside the ghcr.io refs. Both prefixes
# strip to that one repo path.
#
# TAG REFS TOO. A flux-owned built image runs as `ghcr.io/danielh2018/<name>:<tag>` with no
# digest, so a workload of one scaled to zero leaves no digest anywhere. Its spec still names
# the tag, and the prune keeps whatever revision that tag points at in the store. Each ref goes
# in as `<repo>:<tag>`; a digest-pinned ref also yields one, which only keeps more. MIRROR_REFS
# names the function that reads the store's refs out of the JSON.
#
# FAIL CLOSED. The previous run's ConfigMap is deleted first, and the Job mounts it as optional,
# so a run that could not build the set prunes nothing rather than pruning by last week's. A
# skip reports the run down: a cause that persists would otherwise skip every week behind a
# green tile while the claim fills. A cluster running pods always has an imageID digest, so an
# empty set is a fault as well.
write_mirror_keep_set() {
  local json refs keep tags
  if ! $KUBECTL delete configmap "$MIRROR_KEEP_CM" --ignore-not-found >/dev/null 2>&1; then
    MIRROR_MSG="could not delete the previous ${MIRROR_DEPLOY} keep set (configmap/${MIRROR_KEEP_CM}) — aborted before scaling down"
    return 1
  fi
  if ! json=$($KUBECTL get pods,deployments,statefulsets,daemonsets,cronjobs,jobs -A -o json \
                2>/dev/null); then
    MIRROR_NOTE="${MIRROR_DEPLOY} prune skipped, workloads unreadable"
    return 0
  fi
  refs=$("$MIRROR_REFS" <<<"$json")
  # A ref that carries a digest is warmed by it, its tag dropped. A bare repository is no ref.
  WARM_REFS=$(sed -E 's|^([^:@]+):[^@]+@|\1@|' <<<"$refs" | grep -E '[:@]' | sort -u)
  keep=$(grep -o 'sha256:[0-9a-f]\{64\}' <<<"$json" | sort -u)
  if [[ -z "$keep" ]]; then
    MIRROR_NOTE="${MIRROR_DEPLOY} prune skipped, no digest found in any workload"
    return 0
  fi
  tags=$(awk -F@ '$1 ~ /:/ { print $1 }' <<<"$refs" | sort -u)
  [[ -n "$tags" ]] && keep="${keep}"$'\n'"${tags}"
  if ! $KUBECTL create configmap "$MIRROR_KEEP_CM" --from-literal=digests="$keep" \
         >/dev/null 2>&1; then
    MIRROR_NOTE="${MIRROR_DEPLOY} prune skipped, could not write configmap/${MIRROR_KEEP_CM}"
  fi
}

# Prints each ghcr.io or lscr.io ref in the JSON on stdin as `<repo>[:<tag>][@<digest>]`, the
# path the ghcr-mirror caches it under.
ghcr_refs() {
  grep -oE '(ghcr|lscr)\.io/[a-z0-9._/-]+(:[A-Za-z0-9._-]+)?(@sha256:[0-9a-f]{64})?' \
    | sed -E 's#^(ghcr|lscr)\.io/##' | sort -u
}

# Prints each docker.io ref in the JSON on stdin as `<repo>[:<tag>][@<digest>]`, the path the
# dockerhub-mirror caches it under (#6536). A docker.io ref has no host to grep for, so this reads
# every `image` and `imageID` value. A first path component holding `.` or `:`, or `localhost`,
# names another registry. `docker.io/` and `index.docker.io/` are stripped, and a one-component
# name such as `alpine` is `library/alpine`, as containerd asks the mirror for it.
dockerhub_refs() {
  jq -r '.. | objects | (.image?, .imageID?) | strings' 2>/dev/null \
    | sed -E 's#^(index\.)?docker\.io/##' \
    | awk -F/ '/^sha256:/ { next }
               NF > 1 && ($1 ~ /[.:]/ || $1 == "localhost") { next }
               NF == 1 { $0 = "library/" $0 }
               { print }' \
    | grep -E '^[a-z0-9._/-]+(:[A-Za-z0-9._-]+)?(@sha256:[0-9a-f]{64})?$' | sort -u
}

# Waits for the mirror Job and records its result in MIRROR_MSG. Returns 1 when the Job did not
# complete, or when the keep set was skipped.
report_mirror_job() {
  local pruned blobs
  if ! $KUBECTL wait --for=condition=complete "job/${MIRROR_JOB}" \
         --timeout={{ registry_k8s_gc_deadline_s }}s >/dev/null 2>&1; then
    MIRROR_MSG="${MIRROR_DEPLOY} job did not complete — see: kubectl -n ${NS} logs job/${MIRROR_JOB} -c prune"
    return 1
  fi
  MIRROR_DONE=1
  pruned=$(journal_mirror_prune | grep -c '^pruned ')
  blobs=$($KUBECTL logs "job/${MIRROR_JOB}" -c gc 2>/dev/null | grep -c 'Deleting blob')
  MIRROR_MSG="${MIRROR_DEPLOY}: ${pruned} revision(s) pruned, ${blobs} blob(s) deleted"
  # The store collected, but a skipped prune is a fault write_mirror_keep_set explains.
  if [[ -n "$MIRROR_NOTE" ]]; then
    MIRROR_MSG="${MIRROR_MSG} (${MIRROR_NOTE})"
    return 1
  fi
}

# ── A mirror store's phase ───────────────────────────────────────────────────────────────────
# Scales only deploy/${MIRROR_DEPLOY}, never the push store (operator ruling on #5680).
# containerd falls back to the upstream while it is down. The stamp goes down before the
# scale-down, so a run killed at any point after it is one the next run repairs.
collect_mirror_store() {
  write_mirror_keep_set || return 1
  [[ -n "$MIRROR_NOTE" ]] && logger -t registry-gc "$MIRROR_NOTE"
  if ! mkdir -p "$STATE_DIR" || ! : > "$MIRROR_STAMP"; then
    MIRROR_MSG="could not write ${MIRROR_STAMP} — aborted before scaling down"
    return 1
  fi
  MIRROR_DOWN=1
  if ! stop_deploy "$MIRROR_DEPLOY"; then
    MIRROR_MSG="${MIRROR_DEPLOY} pod did not terminate within 120s — aborted before touching its store"
    return 1
  fi
  $KUBECTL delete job "$MIRROR_JOB" --ignore-not-found >/dev/null 2>&1
  MIRROR_STARTED=1
  if ! $KUBECTL apply -f "$MIRROR_JOB_MANIFEST" >/dev/null 2>&1; then
    MIRROR_MSG="could not apply ${MIRROR_JOB_MANIFEST}"
    return 1
  fi
  report_mirror_job
}

# ── Warming a mirror ─────────────────────────────────────────────────────────────────────────
# Prints manifest $2 (a tag or a digest) of repository $1, read through the mirror.
mirror_manifest() {
  curl -fs --max-time 60 -H "Accept: ${ACCEPT}" "${MIRROR_URL}/v2/${1}/manifests/${2}"
}

# Prints the config and layer digests of image $1 at $2, one per line. An index resolves to its
# linux/amd64 child, the platform both nodes run. An index with no such child prints nothing.
mirror_blob_digests() {
  local manifest child
  manifest=$(mirror_manifest "$1" "$2") || return 1
  child=$(jq -r '[.manifests[]? | select(.platform.os == "linux" and .platform.architecture == "amd64")
                  | .digest][0] // empty' <<<"$manifest") || return 1
  if [[ -n "$child" ]]; then
    manifest=$(mirror_manifest "$1" "$child") || return 1
  fi
  jq -r 'if .manifests then empty else (.config.digest // empty), (.layers[]?.digest) end' \
    <<<"$manifest"
}

# GETs each distinct blob of every ref in WARM_REFS through the mirror, and appends the counts to
# MIRROR_MSG. A cached blob streams from the mirror's own store, so a warm store costs a local
# read and no WAN. The whole phase stops starting new blobs after WARM_BUDGET_S, and each GET is
# bounded by the budget left.
# DECIDED: a blob that fails to warm is named in the journal and the message but leaves the run
# up. It costs a cold pull later, never a corrupt store, and the likely cause is a slow GHCR
# episode that a Kuma page cannot fix. #5654 has the measurements.
warm_mirror() {
  local ref repo id blobs blob got left
  local -A seen=()
  local warmed=0 failed=0 skipped=0 bytes=0 start=$SECONDS
  if [[ -z "$WARM_REFS" ]]; then
    MIRROR_MSG="${MIRROR_MSG}; mirror not warmed, no ${MIRROR_UPSTREAM} ref read"
    return 0
  fi
  while read -r ref; do
    if [[ "$ref" == *@* ]]; then
      repo=${ref%@*} id=${ref#*@}
    else
      repo=${ref%:*} id=${ref##*:}
    fi
    if ! blobs=$(mirror_blob_digests "$repo" "$id"); then
      failed=$((failed + 1))
      logger -t registry-gc "could not read the manifest of ${repo} ${id} through ${MIRROR_DEPLOY}"
      continue
    fi
    for blob in $blobs; do
      [[ -n "${seen[$blob]:-}" ]] && continue
      seen[$blob]=1
      left=$((WARM_BUDGET_S - (SECONDS - start)))
      if ((left <= 0)); then
        skipped=$((skipped + 1))
        continue
      fi
      if got=$(curl -fs -o /dev/null --max-time "$left" -w '%{size_download}' \
                 "${MIRROR_URL}/v2/${repo}/blobs/${blob}"); then
        warmed=$((warmed + 1))
        bytes=$((bytes + got))
      else
        failed=$((failed + 1))
        logger -t registry-gc "could not warm ${repo}@${blob} through ${MIRROR_DEPLOY}"
      fi
    done
  done <<<"$WARM_REFS"
  MIRROR_MSG="${MIRROR_MSG}; warmed ${warmed} blob(s), $((bytes / 1000000)) MB in $((SECONDS - start))s"
  ((failed)) && MIRROR_MSG="${MIRROR_MSG}, ${failed} failed (journalctl -t registry-gc)"
  ((skipped)) && MIRROR_MSG="${MIRROR_MSG}, ${skipped} skipped past the ${WARM_BUDGET_S}s budget"
  return 0
}

# A previous run that died between its scale-down and its restore left the stamp. Its Job may
# still be pruning, so restore_mirror_store deletes an unfinished one before the pod returns.
restore_stranded_mirror() {
  [[ -e "$MIRROR_STAMP" ]] || return 0
  logger -t registry-gc "a previous run left deploy/${MIRROR_DEPLOY} scaled down — restoring it first"
  MIRROR_STARTED=1
  MIRROR_DOWN=1
  restore_mirror_store
}

# One mirror's whole phase. A stranded mirror that does not come back skips the rest of it.
run_mirror_phase() {
  restore_stranded_mirror || return 1
  MIRROR_STARTED=0
  collect_mirror_store || FAILED=1
  # Only a mirror known to serve again is warmed. Against one still at zero every GET would fail.
  if restore_mirror_store; then
    warm_mirror
  else
    return 1
  fi
}

# Waits up to a minute: the registry deploy holds the lock only for one `kubectl scale`.
take_lock() {
  exec 9>"$LOCK_FILE" && flock -w 60 9
}

if ! take_lock; then
  MIRROR_MSG="could not take ${LOCK_FILE} — another registry-gc run, or a registry deploy, holds it"
  exit 1
fi
run_mirror_phase || FAILED=1
# The next phase starts only with this mirror serving, so both are never down at once. The stamp,
# not MIRROR_DOWN, says so: a failed restore clears MIRROR_DOWN and leaves the stamp.
if [[ -e "$MIRROR_STAMP" ]]; then
  MIRROR_MSG="${MIRROR_MSG}; dockerhub-mirror not collected"
  exit 1
fi
DONE_MSG=$MIRROR_MSG
use_dockerhub_store
run_mirror_phase || FAILED=1
COMPLETED=1
