# Managed by Ansible (setup/k8s_host_files, tasks/crowdsec.yml). Started by
# crowdsec-edge-probe.timer.
[Unit]
Description=Probe the edge VIP from daniel-pi for crowdsec's off-cluster verify

[Service]
Type=oneshot
User={{ sys_user }}
# jellyfin's hostname matches a real router from any client address (the script's header).
ExecStart=/usr/local/bin/crowdsec-edge-probe jellyfin.local.{{ domain }} {{ k3s_metallb_ingress_vip }}
# /var/log/pi-health is the pi-heartbeats component's directory, owned by User=. systemd
# creates it with that owner if this unit starts first.
LogsDirectory=pi-health
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
