# Kuma push credentials for fake-remux-health.sh — managed by Ansible (setup/fake_remux role).
#
# Kept out of the script itself, which lands 0755 root:root and is therefore readable by every
# local account. `no_log: true` on a template task hides the value from Ansible's OUTPUT, not from
# the filesystem — until this file existed both tokens sat inline in the rendered script, so any
# local user could read one and forge or suppress a heartbeat, hiding a real outage.
#
# DECIDED: rendered by THIS role, not reused from /etc/rancher/k3s/kuma-push.env. fake_remux is
# host-conditional and tag-scoped (`initial_setup.yml --tags fake_remux`), and the k3s role's env
# file is written under other tags entirely — so a tag-scoped run of this role would render a
# script whose env file the same run never wrote. The script then exits 0 without pushing, which
# is the silent failure this split exists to avoid.
#
# 0640 root:{{ sys_user }}: the health cron runs as {{ sys_user }} (tasks/main.yml), and the group
# bit is what lets it read. Same split, and the same reasoning, as the k3s role's kuma-push.env.
#
# Single-quoted because this file is `.`-sourced by a shell script, which means an unquoted value
# is shell input rather than data: whitespace would truncate the token, and `$(...)` or a backtick
# would execute as the cron user. Kuma tokens are alphanumeric today, so this is defence in depth
# against a future rotation producing something less tame.
FAKE_REMUX_SCAN_PUSH_TOKEN='{{ monitor_bridge_fake_remux_push_token | default("") }}'
FAKE_REMUX_REPLACE_PUSH_TOKEN='{{ monitor_bridge_fake_remux_replace_push_token | default("") }}'
