# The deployer config the test suite imports gitops_deploy.py against. conftest.py points
# GITOPS_DEPLOY_CONFIG here before any test imports the module, so no test opens the host's
# /etc/gitops-deploy/config.env. Nothing here is real: the repo path does not exist and the
# webhook host is reserved for documentation.
REPO_DIR=/tmp/gitops-test-repo
HOSTNAME=test-host
DISCORD_WEBHOOK=https://discord.example/webhook
