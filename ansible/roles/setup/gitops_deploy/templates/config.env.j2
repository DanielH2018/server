REPO_DIR=/home/{{ sys_user }}/server
BRANCH=master
HOSTNAME={{ inventory_hostname }}
# ── CI gate (defaults/main.yml carries the reasoning) ─────────────────────────────────────────
# Don't deploy a master tip whose CI is red or unfinished. An empty CI_CONTEXTS or GITHUB_REPO
# disarms the gate rather than passing everything — see the fail-closed guard in gitops_deploy.py.
REQUIRE_CI={{ gitops_deploy_require_ci | bool | lower }}
CI_CONTEXTS={{ gitops_deploy_ci_contexts | join(',') }}
GITHUB_REPO={{ gitops_deploy_github_repo }}
# Most CI verdicts one tick may fetch, the tip's own included. When the tip is pending or red
# the gate walks back to the newest green ancestor and fast-forwards to THAT commit instead of
# deferring the whole range; this bounds the walk. 0 disarms it (gate on the tip alone).
CI_ANCESTOR_WALK_MAX={{ gitops_deploy_ci_ancestor_walk_max }}
DISCORD_WEBHOOK={{ gitops_deploy_discord_webhook }}
# ── k8s auto-deploy denylist (each role's own defaults/main.yml carries its reason) ─────────────
# The tick deploys no k8s role since D6.12. These three lines stay until D6.2a, because the
# deployer re-renders the denylist and the Renovate lander reads it. An empty denylist disables
# the feature rather than allowing everything — see gitops_deploy.py.
K8S_AUTODEPLOY_ENABLED={{ gitops_deploy_k8s_autodeploy_enabled | bool | lower }}
K8S_AUTODEPLOY_PILOT={{ gitops_deploy_k8s_autodeploy_pilot | join(',') }}
K8S_AUTODEPLOY_DENYLIST={{ gitops_deploy_k8s_autodeploy_denylist | join(',') }}
# Bounds ONE broad-plane apply (initial_setup.yml --tags <role>). That arm is forward-only — see
# defaults/main.yml for why no rollback is funded on top of it.
BROAD_DEPLOY_TIMEOUT_S={{ gitops_deploy_broad_timeout_s }}
