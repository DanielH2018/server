REPO_DIR=/home/{{ sys_user }}/server
BRANCH=master
HOSTNAME={{ inventory_hostname }}
HEALTH_TIMEOUT_S=300
# Wall-clock budget for the health-gate phase (see gitops_deploy.py RUN_BUDGET_S). RUN_START is
# measured AFTER flock acquires (gitops-deploy.service ExecStart), but TimeoutStartSec (25min=1500s)
# counts from unit activation and so INCLUDES up to the `flock -w 180` wait. Budget for the worst
# case: 180 (max flock wait) + 1020 (this gate) + 300 (HEALTH_TIMEOUT_S rollback redeploy) = 1500, so
# the ~5min rollback window survives even under max lock contention with the weekly secret-rotate.
RUN_BUDGET_S=1020
# ── CI gate (defaults/main.yml carries the reasoning) ─────────────────────────────────────────
# Don't deploy a master tip whose CI is red or unfinished. An empty CI_CONTEXTS or GITHUB_REPO
# disarms the gate rather than passing everything — see the fail-closed guard in gitops_deploy.py.
REQUIRE_CI={{ gitops_deploy_require_ci | bool | lower }}
CI_CONTEXTS={{ gitops_deploy_ci_contexts | join(',') }}
GITHUB_REPO={{ gitops_deploy_github_repo }}
DISCORD_WEBHOOK={{ gitops_deploy_discord_webhook }}
# ── k8s auto-deploy (each role's own defaults/main.yml carries its reason) ─────────────────────
# Eligibility is (image-only diff) AND (not denylisted) AND (in the pilot scope, while it is set).
# An empty denylist disables the feature rather than allowing everything — see gitops_deploy.py.
K8S_AUTODEPLOY_ENABLED={{ gitops_deploy_k8s_autodeploy_enabled | bool | lower }}
K8S_AUTODEPLOY_PILOT={{ gitops_deploy_k8s_autodeploy_pilot | join(',') }}
K8S_AUTODEPLOY_DENYLIST={{ gitops_deploy_k8s_autodeploy_denylist | join(',') }}
# Most services one tick may promote. The whole promoted set shares ONE ansible-playbook run
# and one K8S_DEPLOY_TIMEOUT_S below, and a timeout rolls all of them back together — so this
# bounds the blast radius the timeout is sized against. Surplus defers and alerts.
K8S_AUTODEPLOY_MAX_PER_TICK={{ gitops_deploy_k8s_autodeploy_max_per_tick }}
# Most services declaring k8s_autodeploy_snapshot_pvcs one tick may promote. A second, tighter
# cap because only those services pay a snapshot+revert phase on the rollback path, serially,
# while K8S_ROLLBACK_TIMEOUT_S below is sized for the worst SINGLE one. Claim-free services still
# batch up to K8S_AUTODEPLOY_MAX_PER_TICK. Surplus defers and alerts.
K8S_AUTODEPLOY_MAX_CLAIM_SERVICES_PER_TICK={{ gitops_deploy_k8s_autodeploy_max_claim_services_per_tick }}
# Bounds ONE ansible-playbook run on the k8s path — the FORWARD deploy only. RUN_BUDGET_S does
# not: it gates only the Docker health-gate phase, which is inert on an all-k8s host, leaving
# systemd's TimeoutStartSec SIGTERM as the sole bound — which can land mid-rollback.
K8S_DEPLOY_TIMEOUT_S={{ gitops_deploy_k8s_timeout_s }}
# Bounds the ROLLBACK redeploy, which also reverts each claimed volume to its pre-deploy
# snapshot and so does strictly more work (see defaults/main.yml for the sizing, against Task
# 6's drill). Sequential with K8S_DEPLOY_TIMEOUT_S inside one systemd unit activation — see
# gitops-deploy.service.j2's TimeoutStartSec.
K8S_ROLLBACK_TIMEOUT_S={{ gitops_deploy_k8s_rollback_timeout_s }}
# Bounds ONE broad-plane apply (initial_setup.yml --tags <role>, or a full deploy.yml). That arm
# is forward-only — see defaults/main.yml for why no rollback is funded on top of it.
BROAD_DEPLOY_TIMEOUT_S={{ gitops_deploy_broad_timeout_s }}
# The staging gate (Phase C slice 3). ADVISORY while this exists: the deployer asks
# daniel-stage about the commit and deploys prod regardless of the answer. Off by default —
# see defaults/main.yml.
STAGING_GATE={{ gitops_deploy_staging_gate | bool | lower }}
