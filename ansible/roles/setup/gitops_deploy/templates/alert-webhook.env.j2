{{ ansible_managed | comment }}
# Read by gitops-deploy-alert.service via EnvironmentFile=, and by nothing else.
#
# It is a separate file from config.env on purpose, and the reason is the one the alert unit's
# own header gives: config.env is exactly what can be broken or unreadable when the deployer
# fails, since gitops_deploy.py's cfg() parses it at import — before the crash handler is
# installed. An alert that sourced the webhook from that file would be unable to page for the
# failure most likely to need it. systemd's built-in EnvironmentFile parser has no application
# code in the path, so a one-key file read this way does not reintroduce that risk.
ALERT_WEBHOOK={{ gitops_deploy_discord_webhook }}
