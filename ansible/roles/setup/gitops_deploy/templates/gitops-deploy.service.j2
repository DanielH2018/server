[Unit]
Description=GitOps deployer (pull origin/master, deploy changed services)
After=network-online.target docker.service
Wants=network-online.target
OnFailure=gitops-deploy-alert.service

[Service]
Type=oneshot
# Kill a wedged run (hung ansible/docker) so it can't hold the unit "active" forever and starve
# the 30-min timer (OnUnitActiveSec) — without this a hang stalls the whole pipeline until manual
# intervention.
#
# One worst case must fit inside this ceiling since D6.12 deleted the k8s path: the broad arm,
# 180 (max flock wait) + BROAD_DEPLOY_TIMEOUT_S (1800) = 1980s. The arm is FORWARD-ONLY, so no
# rollback budget stacks on top.
#
# 70min was sized for the k8s path, a forward deploy and its rollback in sequence
# (180 + 1440 + 1620 = 3240s). It stays at 70min rather than shrinking with that path: four
# tree-lock waiters, the lander deadlines and `deploy.sh`'s LOCK_WAIT were derived from the
# same budgets, so a smaller ceiling is a change of its own. A ceiling above the worst case
# costs nothing on a healthy run, which finishes in well under a minute.
#
# An overrun never produces a second or concurrent run: systemd finds the unit already
# `activating` and coalesces the timer's start request into the run already in flight, rather
# than spawning another one (docs/gitops-pipeline.md, verified live against this unit on
# daniel-box). The practical effect is a delayed or absorbed tick, not a stacked deploy.
#
# The lock this unit's ExecStart holds (`{{ server_git_tree_lock }}`, below) is held for up to
# the broad arm's worst case, which EXCEEDS the 30-min timer interval — a concurrent
# `./scripts/deploy.sh` waits its own `deploy_lib/under_locks.py:LOCK_WAIT` (not this `-w 180`, which
# governs only this unit), then returns exit 75 (nothing deployed) if the lock stays busy past
# it — so it normally OUTLASTS this hold and deploys. The weekly secret-rotate cron waits on the same lock, with the
# same wait, derived from the same budgets. See
# ansible/roles/setup/gitops_deploy/CLAUDE.md.
#
# What that operator deploy waits for is now SHORT by construction: since ADR-0017 it holds the
# tree lock only to snapshot HEAD, and does its playbook under one lock per service. The
# direction that still contends is this one — this unit holds the tree lock for its whole run,
# so an operator deploy launched mid-tick still queues for the snapshot alone.
#
# This unit takes those per-service locks too, inside the tree-lock hold above, and the wait for
# them comes out of the SAME budget as the playbook it is waiting to run
# (deploy_locks.locked_budget). That is what keeps the four terms below a true ceiling: give the
# wait a budget of its own and each of them doubles, past this TimeoutStartSec.
TimeoutStartSec=70min
User={{ sys_user }}
WorkingDirectory=/home/{{ sys_user }}/server
# Need ~/.local/bin on PATH for `uv` (the deployer runs `uv run ansible-playbook`,
# the same repo-pinned env the operator uses); systemd's default PATH omits it.
Environment=PATH=/home/{{ sys_user }}/.local/bin:/usr/local/bin:/usr/bin:/bin
# journald stores only notice+ on these hosts (initial_setup caps MaxLevelStore=notice), and a
# unit's stdout logs at info by default — so every log() line the deployer printed was discarded
# at the source, leaving nothing to read after the 2026-08-08 false-rollback hold. The output is
# a handful of lines per eventful tick; store it at notice so failures are diagnosable after the
# fact.
SyslogLevel=notice
# flock serializes against the weekly secret-rotate cron (secret-rotate.sh) — both mutate
# this same git working tree, and this deployer's `git reset --hard` on a failed health gate
# could silently discard a half-rotated secret. The phase budget, BROAD_DEPLOY_TIMEOUT_S, starts
# when its phase starts, AFTER flock acquires, so time spent waiting here is pure overhead against this unit's
# TimeoutStartSec and is not counted by it. -w 180 outlasts any normal deploy-step
# contention (secret-rotate is short — 0-2
# tokens) but fails fast enough to leave the apply budget intact; /run/lock is
# world-writable+sticky, so the unprivileged {{ sys_user }} can create the lockfile.
#
# DECIDED: contention exits 75 and the unit SUCCEEDS — do not "fix" this back to a failure, and
# do not raise -w to compensate. Until 2026-08-23 a timeout exited 1, so every long operator
# `./scripts/deploy.sh` (~20min, holding this same lock for its whole run back then; it now
# holds it only for a snapshot of HEAD) paged via OnFailure: seven such silent
# exit-1 ticks in the seven days to 2026-08-23, each logging nothing at all because flock died
# before the deployer started. Raising -w could not fix it: when this was decided the unit's own
# worst case was the k8s path's 3060s against TimeoutStartSec 4200s, so the largest legal -w was
# 1140s, still short of a routine 20-minute deploy. Since D6.12 the worst case is the broad
# arm's BROAD_DEPLOY_TIMEOUT_S, and test_gitops_deploy_timeout_budgets.py::
# test_the_deployers_hold_survives_max_flock_contention asserts the bound. So
# -E 75 + SuccessExitStatus=75
# instead, the same "lock busy, nothing deployed" contract as deploy.sh's DEPLOY_LOCK_BUSY.
# Contention is not silent starvation: the flock path never writes last_run, so contention
# lasting past GITOPS_MAX_AGE_S (90min, check.py:148) still pages via GitOps-Alive. (ADR-0011)
SuccessExitStatus=75
# Deliberately WITHOUT --no-python-downloads, unlike every other host invocation in this repo.
# Elsewhere the flag turns a missing pinned interpreter into a loud failure instead of a silent
# fetch, which is what makes the pin a pin. Here the loud failure would be the deploy pipeline
# refusing to start — removing the machine that would ship the correction — so this one keeps uv's
# self-healing download. The asymmetry is intentional and is pinned by
# ansible/tests/setup/test_host_python_invocations.py; do not "fix" it for consistency.
#
# DECIDED: the deployer runs `--no-project` and stdlib-only, never from a venv, for the same
# reason as the paragraph above. The process that fetches, gates on CI, writes hold_sha, alerts
# and stamps last_run imports nothing a dependency set can break. A broken or half-synced env
# then fails only the `uv run --frozen ansible-playbook` child (deploy_io.PLAYBOOK_ARGV), and the
# tick still holds, alerts, and ff-merges the commit that fixes it. Two venv shapes were rejected
# (#3393):
#   - Running `uv run` without the flag syncs the repo project from WorkingDirectory. That ties
#     the deployer's startup to the checkout's `.venv`, while the tick holds the tree lock and
#     sessions sync the same `.venv`. docs/archive/host-python-314-plan.md, Task 6, has the
#     2026-08-16 measurements.
#   - A venv that this role builds from uv.lock goes stale with no signal.
#     deploy_changes._BROAD_DEPLOY_PREFIXES deliberately leaves pyproject.toml and uv.lock out, so a
#     lock bump ff-merges with no setup apply and the venv never rebuilds. Rebuilding it on every
#     lock bump would turn the daily lockFileMaintenance into a self-applied setup-plane change.
# The price is the subprocess-plus-JSON derivations in deploy_narrow.py and the stdlib YAML
# readers listed in docs/gitops-pipeline.md. A venv would remove them, but it puts a dependency
# set in the way of the one process that ships the fix for that dependency set.
ExecStart=/usr/bin/flock -w 180 -E 75 {{ server_git_tree_lock }} /usr/local/bin/uv run --no-project --python {{ host_python_version }} /opt/gitops-deploy/gitops_deploy.py
# SOPS age key is already in the user's home; filter plugins auto-load next to
# ansible/deploy.yml, so no ANSIBLE_CONFIG is needed.

# 2026-08-23b review M12. SuccessExitStatus=75 above is the right call, but it also removed the
# last on-host trace of contention: a 75 tick logs only "Deactivated successfully" at info.
# initial_setup/tasks/system-tuning.yml sets MaxLevelStore=notice, so the journal drops it.
# It sets MaxLevelSyslog=info, but its rsyslog info filter (49-homelab-info-filter.conf) stops
# every info line outside auth, authpriv, kern and mail. So that line reaches neither the
# journal nor /var/log/syslog, and therefore never reaches Loki's job="syslog" stream either. ExecStopPost= is the only hook that sees $EXIT_STATUS
# (ExecStartPost= genuinely cannot), and SyslogLevel=notice above puts this line at PRIORITY=5,
# above both caps. This restores the forensic record without re-arming the false OnFailure pages
# the DECIDED block above rejects — the unit still succeeds and OnFailure still cannot fire.
# `|| true` matters: a non-zero ExecStopPost would itself fail the unit.
#
# The marker text is a contract, not a log line: this unit is Type=oneshot with no
# RemainAfterExit, and systemd RESETS ExecMainStatus to 0 once such a unit goes inactive —
# measured 2026-08-23 on systemd 255.4, where a control unit exiting 75 read back
# `Result=success ExecMainStatus=0` after completing. (A *failed* unit keeps its code, because
# it stays in `failed` until reset-failed.) So after a contention tick the 75 is genuinely
# unreadable from `systemctl show`, and this line is the only durable record of it.
# scripts/deploy_tools/gitops_tick.sh greps for the parenthesised phrase; ansible/tests/
# test_gitops_manual_trigger.py pins the two together. Do not reword it in isolation.
ExecStopPost=/bin/sh -c 'test "$EXIT_STATUS" = 75 && echo "gitops-deploy: tick skipped (lock contention) — {{ server_git_tree_lock }} was held for the full flock wait; nothing deployed, last_run untouched" || true'
# The same skip as a metric (#5676). gitops_deploy.py never ran, so it cannot count the tick
# itself, and this adds one to gitops_tick_runs_total{outcome="skipped-lock"}. It is a second
# line rather than a longer first one, so the marker line above stays the contract it is.
ExecStopPost=/bin/sh -c 'test "$EXIT_STATUS" = 75 && /usr/local/bin/uv run --no-project --python {{ host_python_version }} /opt/gitops-deploy/gitops_tick_metrics.py skipped-lock || true'
