[Unit]
Description=GitOps deployer (pull origin/master, deploy changed services)
After=network-online.target docker.service
Wants=network-online.target
OnFailure=gitops-deploy-alert.service

[Service]
Type=oneshot
# Kill a wedged run (hung ansible/docker) so it can't hold the unit "active" forever and starve
# the 30-min timer (OnUnitActiveSec) — without this a hang stalls the whole pipeline until manual
# intervention.
#
# Two independent worst cases must fit inside this ceiling, and task 6b's k8s one is why it is
# 45min rather than 25min (the staging gate below is why it is now 60min):
#   - Docker path: 180s max flock wait + RUN_BUDGET_S (1020s, the health-gate phase) +
#     HEALTH_TIMEOUT_S (300s, the rollback redeploy) = 1500s = 25min exactly, still true and
#     now with slack under the larger ceiling. See config.env.j2.
#   - k8s path: a failed forward deploy can spend its whole K8S_DEPLOY_TIMEOUT_S (900s) before
#     gitops_deploy.py catches the timeout, THEN the rollback redeploy can spend its whole
#     K8S_ROLLBACK_TIMEOUT_S (1320s, re-sized against the real per-service ceiling — see
#     defaults/main.yml) — the two run SEQUENTIALLY in one unit activation, not concurrently,
#     and neither shares the Docker path's RUN_BUDGET_S. That pair alone is 180 (max flock
#     wait) + 900 + 1320 = 2400s, which needs more than 25min (1500s) — see
#     ansible/roles/k8s/volume-revert/CLAUDE.md for the drill that sized the two revert-role
#     timeouts feeding K8S_ROLLBACK_TIMEOUT_S.
#   - k8s path WITH the staging gate armed (STAGING_GATE, off by default), which is why this is
#     60min rather than 45min. consult_staging runs INSIDE the same `if cs.k8s_deploy:` block,
#     before deploy_k8s, so its two budgets are additive to the pair above rather than
#     alternative to them: 180 + STAGING_GATE_TIMEOUT_S (600) + STAGING_EXPECT_TIMEOUT_S (120)
#     + 900 + 1320 = 3120s. The BROAD arm does not stack with any of it — it returns before the
#     k8s block, so the true ceiling is max(broad 1800 + 180, 3120), not a sum.
#
# Sized against a MEASURED staging deploy (defaults/main.yml carries the number), and the
# 480s of remaining slack is deliberate: shrinking the staging budget to avoid raising this
# ceiling would turn a slow staging into NO VERDICT, which is the one failure the gate exists
# to measure.
#
# This deliberately GIVES UP the old invariant ("stay under the 30-min interval so the next tick
# always fires on schedule") in exchange for the k8s rollback getting a budget that can actually
# finish. That is a considered trade, not a bug to tighten back: a normal run finishes in well
# under a minute, so the 30-min tick is only at risk in the pathological case both k8s timeouts
# get spent in full — and per `ansible/roles/setup/gitops_deploy/CLAUDE.md`'s rollback-timeout
# section (verified live against this unit on daniel-box, not inferred from the man page alone),
# an overrun never produces a second or concurrent run: systemd finds the unit already
# `activating` and coalesces the timer's start request into the run already in flight, rather
# than spawning another one. The practical effect is a delayed/absorbed tick, not a stacked
# deploy — see that CLAUDE.md section for what is and is not verified about the cadence.
#
# The lock this unit's ExecStart holds (`/var/lock/server-git-tree.lock`, below) is now held for
# up to this same pathological duration, which EXCEEDS the 30-min timer interval — a concurrent
# `./scripts/deploy.sh` waits its own LOCK_WAIT (not this `-w 180`, which governs only this
# unit), then returns exit 75 (nothing deployed) if the lock stays busy past it — so it normally
# OUTLASTS this hold and deploys. The weekly secret-rotate cron waits on the same lock, with the
# same wait, derived from the same budgets. See
# ansible/roles/setup/gitops_deploy/CLAUDE.md.
TimeoutStartSec=60min
User={{ sys_user }}
WorkingDirectory=/home/{{ sys_user }}/server
# Need ~/.local/bin on PATH for `uv` (the deployer runs `uv run ansible-playbook`,
# the same repo-pinned env the operator uses); systemd's default PATH omits it.
Environment=PATH=/home/{{ sys_user }}/.local/bin:/usr/local/bin:/usr/bin:/bin
# journald stores only notice+ on these hosts (initial_setup caps MaxLevelStore=notice), and a
# unit's stdout logs at info by default — so every log() line the deployer printed was discarded
# at the source, leaving nothing to read after the 2026-08-08 false-rollback hold. The output is
# a handful of lines per eventful tick; store it at notice so failures are diagnosable after the
# fact.
SyslogLevel=notice
# flock serializes against the weekly secret-rotate cron (secret-rotate.sh) — both mutate
# this same git working tree, and this deployer's `git reset --hard` on a failed health gate
# could silently discard a half-rotated secret. RUN_START (and so RUN_BUDGET_S, see
# gitops_deploy.py) is measured from process start, AFTER flock acquires — so time spent
# waiting here is pure overhead against this unit's TimeoutStartSec, uncounted by that
# budget. -w 180 outlasts any normal deploy-step contention (secret-rotate is short — 0-2
# tokens) but fails fast enough to leave the health-gate/rollback budget intact; /run/lock is
# world-writable+sticky, so the unprivileged {{ sys_user }} can create the lockfile.
#
# DECIDED: contention exits 75 and the unit SUCCEEDS — do not "fix" this back to a failure, and
# do not raise -w to compensate. Until 2026-08-23 a timeout exited 1, so every long operator
# `./scripts/deploy.sh` (~20min, holding this same lock) paged via OnFailure: seven such silent
# exit-1 ticks in the seven days to 2026-08-23, each logging nothing at all because flock died
# before the deployer started. Raising -w cannot fix it — this unit's own worst case is
# STAGING_GATE_TIMEOUT_S + STAGING_EXPECT_TIMEOUT_S + K8S_DEPLOY_TIMEOUT_S +
# K8S_ROLLBACK_TIMEOUT_S = 2940s against TimeoutStartSec 3600s, so the largest legal -w is 660s,
# still short of a routine 20-minute deploy; test_gitops_discord_contract.py::test_k8s_deploy_
# timeout_budget_survives_max_flock_contention asserts that bound and goes red if you try. So
# -E 75 + SuccessExitStatus=75
# instead, the same "lock busy, nothing deployed" contract scripts/deploy.sh:281 already uses.
# Contention is not silent starvation: the flock path never writes last_run, so contention
# lasting past GITOPS_MAX_AGE_S (90min, check.py:148) still pages via GitOps-Alive. (ADR-0011)
SuccessExitStatus=75
# Deliberately WITHOUT --no-python-downloads, unlike every other host invocation in this repo.
# Elsewhere the flag turns a missing pinned interpreter into a loud failure instead of a silent
# fetch, which is what makes the pin a pin. Here the loud failure would be the deploy pipeline
# refusing to start — removing the machine that would ship the correction — so this one keeps uv's
# self-healing download. The asymmetry is intentional and is pinned by
# ansible/tests/setup/test_host_python_invocations.py; do not "fix" it for consistency.
ExecStart=/usr/bin/flock -w 180 -E 75 /var/lock/server-git-tree.lock /usr/local/bin/uv run --no-project --python {{ host_python_version }} /opt/gitops-deploy/gitops_deploy.py
# SOPS age key is already in the user's home; filter plugins auto-load next to
# ansible/deploy.yml, so no ANSIBLE_CONFIG is needed.

# 2026-08-23b review M12. SuccessExitStatus=75 above is the right call, but it also removed the
# last on-host trace of contention: a 75 tick logs only "Deactivated successfully" at info, and
# initial_setup/tasks/system-tuning.yml:27-28 sets MaxLevelStore=notice AND MaxLevelSyslog=notice
# — so that line reaches neither the journal nor /var/log/syslog, and therefore never reaches
# Loki's job="syslog" stream either. ExecStopPost= is the only hook that sees $EXIT_STATUS
# (ExecStartPost= genuinely cannot), and SyslogLevel=notice above puts this line at PRIORITY=5,
# above both caps. This restores the forensic record without re-arming the false OnFailure pages
# the DECIDED block above rejects — the unit still succeeds and OnFailure still cannot fire.
# `|| true` matters: a non-zero ExecStopPost would itself fail the unit.
#
# The marker text is a contract, not a log line: this unit is Type=oneshot with no
# RemainAfterExit, and systemd RESETS ExecMainStatus to 0 once such a unit goes inactive —
# measured 2026-08-23 on systemd 255.4, where a control unit exiting 75 read back
# `Result=success ExecMainStatus=0` after completing. (A *failed* unit keeps its code, because
# it stays in `failed` until reset-failed.) So after a contention tick the 75 is genuinely
# unreadable from `systemctl show`, and this line is the only durable record of it.
# scripts/deploy_tools/gitops_tick.sh greps for the parenthesised phrase; ansible/tests/
# test_gitops_manual_trigger.py pins the two together. Do not reword it in isolation.
ExecStopPost=/bin/sh -c 'test "$EXIT_STATUS" = 75 && echo "gitops-deploy: tick skipped (lock contention) — /var/lock/server-git-tree.lock was held for the full flock wait; nothing deployed, last_run untouched" || true'
