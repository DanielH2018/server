#!/bin/bash
# Daily drift check: does the LIVE GitHub ruleset still require the contexts this repo declares,
# does the branch-protection ruleset still exclude Renovate's branches, does the review ruleset
# still require a review of everyone outside its declared bypass list, and does the fence still
# keep the agent's account to its own branches? Four arms, one push. Ahead of all four, the repo
# must be public: on the free plan GitHub enforces no ruleset on a private repo (#3610).
#
# Usage: github-ruleset-drift.sh [-h|--help]
# Takes no arguments and changes nothing on GitHub. systemd timer
# kuma-check-github-ruleset-drift.timer runs it as root once a day
# (gitops_deploy_ruleset_drift_cron_hour and _minute), and again every 30 minutes while the last
# run failed. It reads the live rulesets with the deploy user's gh login (anonymous when there is
# none), compares them with the values rendered into this file, and pushes to the
# github-ruleset-drift Kuma monitor. Exit 0 = no drift; exit 1 = drift or an unverifiable read.
#
# The ruleset is what stops an un-CI'd commit reaching master, and the deployer trusts that: a
# tick reads the check runs for the origin SHA and deploys on a green verdict. Nothing in the
# repo watched the ruleset itself, so an edit in the GitHub UI — dropping a required context,
# adding a bypass actor, flipping enforcement to `evaluate` — changed the gate with no commit,
# no PR and no signal. That is not hypothetical: by 2026-08-31 TWO in-repo records had gone stale
# unnoticed. The standing review memory recorded one required context and
# roles/setup/gitops_deploy/CLAUDE.md recorded none at all ("no branch protection on master",
# from a genuine `branches/master/protection` 404 — legacy protection is a SEPARATE API from
# rulesets), while the live ruleset required three with no bypass actors.
#
# WHY THIS IS A CRON AND NOT A TEST. A pytest asserting the same list would be a third hand-copy
# of the same remote state, going stale by the identical mechanism and reading green while it did
# — the reason exactly that fix was rejected in the 2026-08-31 review. The declaration below is
# still a copy; the difference is that this compares it against the LIVE endpoint every day, so
# the copy going stale is the thing being detected rather than the thing being trusted.
#
# It ALERTS on drift, it never reconciles. Changing a ruleset is a deliberate act; this only makes
# it a visible one.
#
# Authenticated through the deploy user's `gh auth token` when that CLI is logged in, anonymous
# otherwise. The endpoint returns 200 with `enforcement` and every
# `rules[].parameters.required_status_checks[].context` to an anonymous caller, and the repo holds
# no GitHub token in SOPS — the same call shape renovate_notify.py uses from this host, and the
# same token source the deployer's CI gate uses since 2026-09-01. Note `bypass_actors` is null
# anonymously rather than empty: GitHub returns the list only to a caller with admin on the repo.
# The contexts, enforcement and the Renovate exclusion are checked either way. The bypass lists
# are checked only on an authenticated read, and an anonymous one reports them UNVERIFIED and
# pushes down (check_bypass below), because the review ruleset's bypass list is the whole of
# what it protects. github-interaction-limit.sh already pushes down without a token.
#
# Rate limit: anonymous GitHub allows 60 req/hr per source IP, shared by EVERY caller on this
# host (the deployer's gate, a landing's await_ci.py poll, renovate_notify). Authenticated it is
# 5000/hr per token. Once a day is still the right cadence — rulesets change on a human clock.
# The token never lands in argv: curl reads it from a config file handed over as a process
# substitution (`-K <(...)`), for the same reason the push library feeds the Kuma URL on
# stdin — /proc is mounted without hidepid here.
#
# set -uo (not -euo): a failed curl must be captured + reported, not swallowed by an early exit.
set -uo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin # cron ships a bare PATH
# What scripts/lib/gh.py sets for every Python caller, and this cron calls `gh` directly. A `gh`
# that prompts hangs an unattended run forever, and the update notifier writes to stderr on the
# first call of the day — which a caller reading stderr as an error message then reports as one.
export GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1

# shellcheck source=/dev/null
source /usr/local/lib/kuma-push-lib.sh || {
  logger -t github-ruleset-drift "kuma-push-lib.sh missing — run initial_setup on this host"
  exit 1
}

KUMA_HOST="uptime-kuma.local.{{ domain }}"
KUMA_RESOLVE_IP="{{ k3s_metallb_ingress_vip }}"
PUSH_URL="https://${KUMA_HOST}/api/push/{{ ruleset_drift_push_token }}"

# Via the shared library, which feeds the token-bearing URL to curl on stdin (`-K -`) rather than
# as an argv element: /proc is mounted without hidepid here.
# The journal line comes first, on every run: the library logs only a FAILED push, so until
# 2026-09-17 a clean run left no trace on this host and the tile's message was the only record
# of the verdict. `journalctl -t github-ruleset-drift` now reads the outcome the way it does for
# manifest-prune-check and the other daily drift checks (#1781).
push() { # up|down msg
  logger -t github-ruleset-drift "status=$1 $2"
  kuma_push "$1" "$2" "$PUSH_URL" "$KUMA_HOST" "$KUMA_RESOLVE_IP" github-ruleset-drift
}

# push_reachout MSG — report a failure whose cause was reaching api.github.com.
#
# Only the two fetch arms use it. One WAN outage lit this tile beside the WAN tile on 2026-09-18
# (#2793), and a link that is gone is the WAN tile's page, not this one's. A 200 carrying the wrong
# shape keeps `push down`: GitHub answered, so the link is fine and the body is the fault.
#
# The exit 1 at each call site is unchanged. `kuma-check-github-ruleset-drift.timer` restarts
# on-failure, so a skipped run retries rather than waiting out the day — which is what should
# happen while the link is down.
push_reachout() { # msg
  REACHOUT_STATUS=down
  REACHOUT_NOTE=""
  # The library is deployed by initial_setup, while this cron is rendered by its own role, so a
  # narrowed apply can put the new script on a host whose /usr/local/lib copy predates
  # reachout_verdict. Without this the read below aborts on an unbound variable under `set -u` and
  # NO push happens at all — the tile reads stale-green to its heartbeat deadline, which is worse
  # than the page this change exists to stop. Same guard docs-refresh.sh.j2 carries.
  if command -v reachout_verdict >/dev/null 2>&1; then
    reachout_verdict github-ruleset-drift {{ wan_probe_urls | join(' ') }}
  fi
  push "$REACHOUT_STATUS" "${REACHOUT_NOTE}$1"
}

# check_bypass ID BODY EXPECTED — push down and exit 1 unless ruleset ID's bypass list is exactly
# EXPECTED: one `<actor_type>:<actor_id>:<bypass_mode>` per line, sorted.
#
# It branches on the TYPE of `.bypass_actors`, not on its contents. null is a caller that cannot
# see the list (anonymous, or a token without admin), while `[]` is a list emptied in the UI.
# `.bypass_actors[]?` would read both as nothing.
check_bypass() {
  local id=$1 body=$2 expected=$3 kind live added removed
  kind=$(printf '%s' "$body" | jq -r '.bypass_actors | type')
  if [ "$kind" != "array" ]; then
    push down "ruleset ${id} returned no bypass_actors list (${kind}) — GitHub shows it only to an admin token, so check gh auth status for {{ sys_user }}; bypass list UNVERIFIED"
    exit 1
  fi
  live=$(printf '%s' "$body" \
    | jq -r '.bypass_actors[] | "\(.actor_type):\(.actor_id):\(.bypass_mode)"' | sort)
  if [ "$live" != "$expected" ]; then
    added=$(comm -23 <(printf '%s\n' "$live") <(printf '%s\n' "$expected") | grep . | tr '\n' ' ')
    removed=$(comm -13 <(printf '%s\n' "$live") <(printf '%s\n' "$expected") | grep . | tr '\n' ' ')
    push down "ruleset ${id} bypass actors DRIFTED — newly-allowed:[${added}] no-longer-allowed:[${removed}] — an added actor merges past this ruleset; reconcile roles/setup/gitops_deploy/defaults/main.yml only if the change was deliberate"
    exit 1
  fi
}

RULESET_URL="https://api.github.com/repos/{{ gitops_deploy_github_repo }}/rulesets/{{ gitops_deploy_ruleset_id }}"

# The expected set, baked in at template time from defaults/main.yml. Quoted heredoc so nothing
# in a context name is shell-expanded — they contain spaces, parentheses and `+`.
# The blank-line filter is not belt-and-braces: whether the `{% raw %}{% for %}{% endraw %}` above
# leaves an empty line per iteration depends on Jinja's trim_blocks, which Ansible sets and a bare
# Environment does not. Filtering makes the comparison identical either way, so the rendered file
# cannot differ from the one a test renders.
EXPECTED=$(
  sed '/^[[:space:]]*$/d' <<'CONTEXTS' | sort
{% for ctx in gitops_deploy_expected_ruleset_contexts %}
{{ ctx }}
{% endfor %}
CONTEXTS
)
# Each ruleset's declared bypass list, baked in the same way. An empty list renders to "".
EXPECTED_CI_BYPASS=$(
  sed '/^[[:space:]]*$/d' <<'ACTORS' | sort
{% for actor in gitops_deploy_ruleset_bypass_actors %}
{{ actor }}
{% endfor %}
ACTORS
)
EXPECTED_REVIEW_BYPASS=$(
  sed '/^[[:space:]]*$/d' <<'ACTORS' | sort
{% for actor in gitops_deploy_review_ruleset_bypass_actors %}
{{ actor }}
{% endfor %}
ACTORS
)
EXPECTED_FENCE_BYPASS=$(
  sed '/^[[:space:]]*$/d' <<'ACTORS' | sort
{% for actor in gitops_deploy_fence_ruleset_bypass_actors %}
{{ actor }}
{% endfor %}
ACTORS
)

# This cron runs as root; the gh login belongs to the deploy user, so the lookup drops to that
# user. `-H` matters: gh finds its login under $HOME, and a plain runuser/sudo keeps root's.
# Every failure — no sudo, no gh, logged out — leaves TOKEN empty and the fetch anonymous,
# which is what this script did for its whole life before 2026-09-01.
TOKEN=$(sudo -n -u "{{ sys_user }}" -H gh auth token 2>/dev/null || true)
AUTH_CONFIG=""
if [ -n "$TOKEN" ]; then
  AUTH_CONFIG=$(printf 'header = "Authorization: Bearer %s"\n' "$TOKEN")
fi

# --- First, before any ruleset: is the repo public? ---
#
# On the free plan GitHub does not enforce rulesets on a private repo. Each ruleset still reads
# `enforcement: active`, so every arm below would pass while no merge is gated. From 13:07 to
# 22:17 UTC on 2026-09-21 the repo was private, and 29 PRs merged before their required check
# reported success (#3610). An anonymous read of a private repo answers 404, which until then
# surfaced here only as a failed ruleset fetch and hid the cause. So this read comes first and
# names visibility in both shapes: `.visibility` to a token, a 404 `Not Found` to no token.
#
# No `-f` on this one fetch: the 404 body is the evidence, and `-f` would discard it. curl still
# exits non-zero on a transport failure, which is the reachout case.
REPO_URL="https://api.github.com/repos/{{ gitops_deploy_github_repo }}"
if ! REPO_BODY=$(curl -s --max-time 20 -K <(printf '%s\n' "$AUTH_CONFIG") \
  -H "Accept: application/vnd.github+json" "$REPO_URL"); then
  push_reachout "failed to fetch repo {{ gitops_deploy_github_repo }} — visibility and every ruleset UNVERIFIED"
  exit 1
fi
VISIBILITY=$(printf '%s' "$REPO_BODY" | jq -r '.visibility // empty' 2>/dev/null)
REPO_ERROR=$(printf '%s' "$REPO_BODY" | jq -r '.message // empty' 2>/dev/null)
if [ -n "$VISIBILITY" ] && [ "$VISIBILITY" != "public" ]; then
  push down "repo is ${VISIBILITY}: rulesets are not enforced on the free plan, the CI merge gate is open — make {{ gitops_deploy_github_repo }} public again"
  exit 1
fi
if [ -z "$VISIBILITY" ] && [ "$REPO_ERROR" = "Not Found" ]; then
  push down "repo {{ gitops_deploy_github_repo }} answers Not Found — most likely private, and rulesets are not enforced on a private repo on the free plan, so the CI merge gate is open"
  exit 1
fi
if [ -z "$VISIBILITY" ]; then
  push down "repo {{ gitops_deploy_github_repo }} response had no .visibility (${REPO_ERROR:-no message}) — bad fetch, UNVERIFIED"
  exit 1
fi

# Process substitution, not a pipe. Under `set -o pipefail` a `printf | curl -K -` pipeline
# reports printf's EPIPE when curl exits before reading stdin — which the test harness's curl
# stub does, so the drift tests failed intermittently with "failed to fetch" under xdist load
# (2026-09-01). `<(...)` keeps the token off argv and out of the pipeline's exit status.
if ! BODY=$(curl -sf --max-time 20 -K <(printf '%s\n' "$AUTH_CONFIG") \
  -H "Accept: application/vnd.github+json" "$RULESET_URL"); then
  # Unreachable is NOT "no drift". A check whose source is down must say it could not look,
  # or it is a deadman reporting a pass.
  push_reachout "failed to fetch ruleset {{ gitops_deploy_ruleset_id }} — branch protection UNVERIFIED"
  exit 1
fi

ENFORCEMENT=$(printf '%s' "$BODY" | jq -r '.enforcement // empty')
if [ -z "$ENFORCEMENT" ]; then
  # A 200 carrying something that is not a ruleset — an error object, an HTML interstitial, a
  # truncated body. Reported as a bad fetch, never as "the contexts are gone".
  push down "ruleset {{ gitops_deploy_ruleset_id }} response had no .enforcement — bad fetch, UNVERIFIED"
  exit 1
fi

LIVE=$(printf '%s' "$BODY" \
  | jq -r '.rules[]?.parameters?.required_status_checks[]?.context // empty' \
  | sed '/^[[:space:]]*$/d' | sort)
LIVE_COUNT=$(printf '%s\n' "$LIVE" | grep -c .)

# A parsed-but-empty context list is the same shape as "someone removed every required check".
# Those need different responses, and only one of them is an emergency — but both are wrong, so
# both are reported. The count is stated so the message distinguishes them by eye.
if [ "$LIVE_COUNT" -eq 0 ]; then
  push down "ruleset {{ gitops_deploy_ruleset_id }} requires NO status checks (enforcement=${ENFORCEMENT}) — every merge gate is open, or the response shape changed"
  exit 1
fi

if [ "$ENFORCEMENT" != "active" ]; then
  push down "ruleset {{ gitops_deploy_ruleset_id }} enforcement is '${ENFORCEMENT}', not active — required checks are advisory"
  exit 1
fi

if [ "$LIVE" != "$EXPECTED" ]; then
  # Drift: name the direction. "removed" = we expect it and GitHub no longer requires it, the
  # dangerous way round — that check stops gating merges. "added" = required upstream but not
  # declared here, which usually means someone added a check and this list needs updating.
  REMOVED=$(comm -13 <(printf '%s\n' "$LIVE") <(printf '%s\n' "$EXPECTED") | tr '\n' ' ')
  ADDED=$(comm -23 <(printf '%s\n' "$LIVE") <(printf '%s\n' "$EXPECTED") | tr '\n' ' ')
  push down "ruleset {{ gitops_deploy_ruleset_id }} DRIFTED — no-longer-required:[${REMOVED}] newly-required:[${ADDED}] — reconcile gitops_deploy_expected_ruleset_contexts in roles/setup/gitops_deploy/defaults/main.yml"
  exit 1
fi

# --- Second ruleset: the branch-protection one must leave Renovate's branches alone ---
#
# "Default" applies `deletion` and `non_fast_forward` to every ref with an admin-only bypass.
# Renovate is not an admin, so with no exclusion GitHub refuses the app's post-merge branch
# delete and its rebase force-push — 26 `Default/deletion` and `Default/non_fast_forward`
# refusals for renovate[bot] in the month to 2026-09-11 (rule-suites API). A merged branch then
# survives at its green SHA, Renovate opens the next version's PR onto it, and the stale verdict
# automerges an empty squash before CI can run (#1741, #1743; issues #1755, #1759, #1565).
# The exclusion below is what lets the app delete and rebase under `renovate/`; this arm alerts
# when it is missing. Same rule as above: reconcile the ruleset, never this default.
BRANCH_RULESET_URL="https://api.github.com/repos/{{ gitops_deploy_github_repo }}/rulesets/{{ gitops_deploy_branch_ruleset_id }}"
if ! BRANCH_BODY=$(curl -sf --max-time 20 -K <(printf '%s\n' "$AUTH_CONFIG") \
  -H "Accept: application/vnd.github+json" "$BRANCH_RULESET_URL"); then
  push_reachout "failed to fetch ruleset {{ gitops_deploy_branch_ruleset_id }} — renovate branch exclusion UNVERIFIED"
  exit 1
fi

if [ -z "$(printf '%s' "$BRANCH_BODY" | jq -r '.enforcement // empty')" ]; then
  push down "ruleset {{ gitops_deploy_branch_ruleset_id }} response had no .enforcement — bad fetch, UNVERIFIED"
  exit 1
fi

# -x -F: the whole line, literally. `**` is a glob in the pattern, not in the comparison.
if ! printf '%s' "$BRANCH_BODY" | jq -r '.conditions.ref_name.exclude[]? // empty' \
  | grep -qxF '{{ gitops_deploy_branch_ruleset_renovate_exclude }}'; then
  push down "ruleset {{ gitops_deploy_branch_ruleset_id }} does not exclude {{ gitops_deploy_branch_ruleset_renovate_exclude }} — Renovate cannot delete or rebase its branches, and a merged branch's stale green automerges the next PR empty (#1759)"
  exit 1
fi

# --- Third ruleset: a PR to master waits for a review unless a bypass actor merges it ---
#
# "master review gate" requires an approving review on a PR to master and dismisses a stale
# approval on push. The agent's GitHub account is a write collaborator and no bypass actor, so
# its PRs reach master only through the lander, which merges as the operator. Each check below
# names one way that stops being true: the ruleset switched off or aimed at another branch, or
# the review rule gone or weakened. An actor added to the bypass list is the last check.
REVIEW_RULESET_URL="https://api.github.com/repos/{{ gitops_deploy_github_repo }}/rulesets/{{ gitops_deploy_review_ruleset_id }}"
if ! REVIEW_BODY=$(curl -sf --max-time 20 -K <(printf '%s\n' "$AUTH_CONFIG") \
  -H "Accept: application/vnd.github+json" "$REVIEW_RULESET_URL"); then
  push_reachout "failed to fetch ruleset {{ gitops_deploy_review_ruleset_id }} — review requirement UNVERIFIED"
  exit 1
fi

REVIEW_ENFORCEMENT=$(printf '%s' "$REVIEW_BODY" | jq -r '.enforcement // empty')
if [ -z "$REVIEW_ENFORCEMENT" ]; then
  push down "ruleset {{ gitops_deploy_review_ruleset_id }} response had no .enforcement — bad fetch, UNVERIFIED"
  exit 1
fi
if [ "$REVIEW_ENFORCEMENT" != "active" ]; then
  push down "ruleset {{ gitops_deploy_review_ruleset_id }} enforcement is '${REVIEW_ENFORCEMENT}', not active — PRs to master merge with no review"
  exit 1
fi

if ! printf '%s' "$REVIEW_BODY" | jq -r '.conditions.ref_name.include[]? // empty' \
  | grep -qxF '{{ gitops_deploy_review_ruleset_ref }}'; then
  push down "ruleset {{ gitops_deploy_review_ruleset_id }} no longer targets {{ gitops_deploy_review_ruleset_ref }} — PRs to master merge with no review"
  exit 1
fi

REVIEW_RULE=$(printf '%s' "$REVIEW_BODY" \
  | jq -c 'first(.rules[]? | select(.type == "pull_request") | .parameters) // empty')
if [ -z "$REVIEW_RULE" ]; then
  push down "ruleset {{ gitops_deploy_review_ruleset_id }} has no pull_request rule — PRs to master merge with no review"
  exit 1
fi
# `tostring`, not `// empty`: jq's `//` treats false as missing, and false is the value to catch.
APPROVALS=$(printf '%s' "$REVIEW_RULE" | jq -r '.required_approving_review_count | tostring')
DISMISS_STALE=$(printf '%s' "$REVIEW_RULE" | jq -r '.dismiss_stale_reviews_on_push | tostring')
# GitHub stops only a PR's author approving it. Without this, a collaborator could push onto
# someone else's PR, approve it and merge it.
LAST_PUSH=$(printf '%s' "$REVIEW_RULE" | jq -r '.require_last_push_approval | tostring')
if [ "$APPROVALS" != "{{ gitops_deploy_review_ruleset_approvals }}" ] || [ "$DISMISS_STALE" != "true" ] \
  || [ "$LAST_PUSH" != "true" ]; then
  push down "ruleset {{ gitops_deploy_review_ruleset_id }} review rule DRIFTED — required_approving_review_count=${APPROVALS} (declared {{ gitops_deploy_review_ruleset_approvals }}), dismiss_stale_reviews_on_push=${DISMISS_STALE} (declared true), require_last_push_approval=${LAST_PUSH} (declared true); reconcile gitops_deploy_review_ruleset_approvals only if the change was deliberate"
  exit 1
fi

# --- Fourth ruleset: the agent's account pushes only under its own prefix ---
#
# "agent branch fence" restricts creating, updating and deleting every branch outside the
# declared exclusions, and the agent's account is no bypass actor. Without it, the agent could
# push onto a branch an operator session opened, and land.sh's admin merge, pinned to whatever
# head GitHub reports, would carry its commit to master. An added exclusion is a branch the agent
# can push to, so the list is compared exactly rather than for one member.
FENCE_RULESET_URL="https://api.github.com/repos/{{ gitops_deploy_github_repo }}/rulesets/{{ gitops_deploy_fence_ruleset_id }}"
if ! FENCE_BODY=$(curl -sf --max-time 20 -K <(printf '%s\n' "$AUTH_CONFIG") \
  -H "Accept: application/vnd.github+json" "$FENCE_RULESET_URL"); then
  push_reachout "failed to fetch ruleset {{ gitops_deploy_fence_ruleset_id }} — agent push fence UNVERIFIED"
  exit 1
fi

FENCE_ENFORCEMENT=$(printf '%s' "$FENCE_BODY" | jq -r '.enforcement // empty')
if [ -z "$FENCE_ENFORCEMENT" ]; then
  push down "ruleset {{ gitops_deploy_fence_ruleset_id }} response had no .enforcement — bad fetch, UNVERIFIED"
  exit 1
fi
if [ "$FENCE_ENFORCEMENT" != "active" ]; then
  push down "ruleset {{ gitops_deploy_fence_ruleset_id }} enforcement is '${FENCE_ENFORCEMENT}', not active — the agent can push to any branch"
  exit 1
fi

if ! printf '%s' "$FENCE_BODY" | jq -r '.conditions.ref_name.include[]? // empty' | grep -qxF '~ALL'; then
  push down "ruleset {{ gitops_deploy_fence_ruleset_id }} no longer covers ~ALL — the agent can push to the branches it dropped"
  exit 1
fi

EXPECTED_FENCE_EXCLUDE=$(
  sed '/^[[:space:]]*$/d' <<'REFS' | sort
{% for ref in gitops_deploy_fence_ruleset_exclude %}
{{ ref }}
{% endfor %}
REFS
)
FENCE_EXCLUDE=$(printf '%s' "$FENCE_BODY" | jq -r '.conditions.ref_name.exclude[]? // empty' | sort)
if [ "$FENCE_EXCLUDE" != "$EXPECTED_FENCE_EXCLUDE" ]; then
  OPENED=$(comm -23 <(printf '%s\n' "$FENCE_EXCLUDE") <(printf '%s\n' "$EXPECTED_FENCE_EXCLUDE") | grep . | tr '\n' ' ')
  CLOSED=$(comm -13 <(printf '%s\n' "$FENCE_EXCLUDE") <(printf '%s\n' "$EXPECTED_FENCE_EXCLUDE") | grep . | tr '\n' ' ')
  push down "ruleset {{ gitops_deploy_fence_ruleset_id }} exclusions DRIFTED — newly-open-to-the-agent:[${OPENED}] no-longer-excluded:[${CLOSED}]; reconcile gitops_deploy_fence_ruleset_exclude only if the change was deliberate"
  exit 1
fi

UNRESTRICTED=""
for rule in creation update deletion; do
  if ! printf '%s' "$FENCE_BODY" | jq -e --arg r "$rule" 'any(.rules[]?; .type == $r)' >/dev/null; then
    UNRESTRICTED="${UNRESTRICTED}${rule} "
  fi
done
if [ -n "$UNRESTRICTED" ]; then
  push down "ruleset {{ gitops_deploy_fence_ruleset_id }} no longer restricts [${UNRESTRICTED}] — the agent can do that on any branch"
  exit 1
fi

# Last, because only these need an admin token: an anonymous run has judged every other property
# above before it stops here.
check_bypass {{ gitops_deploy_ruleset_id }} "$BODY" "$EXPECTED_CI_BYPASS"
check_bypass {{ gitops_deploy_review_ruleset_id }} "$REVIEW_BODY" "$EXPECTED_REVIEW_BYPASS"
check_bypass {{ gitops_deploy_fence_ruleset_id }} "$FENCE_BODY" "$EXPECTED_FENCE_BYPASS"

push up "repo public; ruleset {{ gitops_deploy_ruleset_id }} active, ${LIVE_COUNT} required contexts, matches the declared set; ruleset {{ gitops_deploy_branch_ruleset_id }} excludes {{ gitops_deploy_branch_ruleset_renovate_exclude }}; ruleset {{ gitops_deploy_review_ruleset_id }} requires {{ gitops_deploy_review_ruleset_approvals }} approving review; ruleset {{ gitops_deploy_fence_ruleset_id }} fences the agent to {{ gitops_deploy_fence_ruleset_exclude | join(', ') }}; all bypass lists as declared"
exit 0
