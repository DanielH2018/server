# Kuma push token for the Loki read-route witness — managed by Ansible (initial_setup role).
# Sourced by /usr/local/bin/loki-read-route-health.sh, never inlined into it: that script lands
# 0755, so an inlined token would be readable by every local account, and a push token is enough
# to forge or suppress a heartbeat.
#
# Its own file rather than a key in /etc/homelab/kuma-push.env: that one is a whole-content
# template deployed only on `setup_drift_check_hosts` (daniel-server), and this cron runs on both
# cluster nodes.
#
# Selected per host, not shared. Each node arrives at the route as a different source address —
# that is the whole reason two witnesses exist — and two pushers on one token would let
# daniel-server's `up` satisfy the deadline for a dead daniel-box witness (issue #952, the same
# trap the UPS secondary watchdog records).
#
# `| default('')`, not `| mandatory`: initial_setup.yml is in `_BROAD_MANUAL_PREFIXES` and runs by
# hand on both nodes, so a token that resolves empty must not fail the play for whoever is running
# it. The script's own empty-token branch logs and skips, so an unarmed host says so in its journal.
{% if inventory_hostname == 'daniel-server' %}
LOKI_ROUTE_WITNESS_PUSH_TOKEN='{{ loki_route_witness_daniel_server_push_token | default("") }}'
{% else %}
LOKI_ROUTE_WITNESS_PUSH_TOKEN='{{ loki_route_witness_push_token | default("") }}'
{% endif %}
