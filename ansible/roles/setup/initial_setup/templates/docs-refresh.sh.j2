#!/usr/bin/env bash
# Regenerate docs/reference/, rebuild the MkDocs site, commit and push any change.
#
# THE LOCK IS THE POINT. This mutates the primary git tree, which gitops-deploy.service
# rewrites with `git pull` on a 30-minute timer and which every deploy renders its
# templates from. /var/lock/server-git-tree.lock is what makes those mutually exclusive.
# Without it a `git pull` mid-run would leave this committing a tree it never read.
#
# IT DOES NOT PULL. gitops-deploy already fast-forwards this checkout, and it CI-gates the
# range first: a commit whose master CI is red or pending is refused, and a failed health
# gate parks the SHA in hold_sha. A bare pull here would take the lock correctly and still
# skip all of that, fast-forwarding onto a commit the tick would have refused -- and the
# next deploy renders templates from that tree. The tick runs 48 times a day to this
# script's twice, so reading whatever it has already admitted costs at most one interval.
#
# WHY IT COMMITS. The generated pages are reviewable in a diff and survive the pod. The
# alternative -- rendering at serve time -- is always current and completely invisible: a
# generator bug would reach the page with nothing to catch it.
#
# IT OPENS A PR. It used to write straight to master, on the stated grounds that
# secret-rotate.sh already did and "the path and its permissions are proven". They were
# not. A repository ruleset rejects every direct write to master:
#
#   remote: - Required status check "prek (lint + validate + tests + secrets)" is expected.
#   ! [remote rejected]   (declined due to repository rule violations)
#
# So this cron could never publish. It committed locally, failed to push, and left the
# commit sitting on master -- which made the tree dirty-by-being-ahead and, worse, meant
# the generated pages silently stopped being updated. Confirmed 2026-08-25 by running the
# rejected command by hand; the error had been invisible because both the commit and the
# push discarded their output to /dev/null.
#
# A PR satisfies the ruleset (the check runs on the PR) and auto-merge lands it without a
# human in the loop, so the cron stays unattended. Review is still bypassed in substance,
# which remains acceptable for the same reason as before: every byte it commits was
# produced by a generator whose output is itself tested.
#
# secret-rotate.sh had the same bug and got its own change (#427), for the reason noted here:
# it rotates live credentials, so its failure mode and its remedy are different. It publishes
# through a PR too now, and gates on the remote branch rather than an open PR — a `gh pr
# create` failure lands after the push, which no local check can see.
#
# ONE OPEN PR AT A TIME. After opening one this script resets master back to origin, so
# the next run regenerates the same diff and would open a duplicate. It checks for an
# already-open PR first and exits instead.
#
# NO DEADMAN. Deliberate, and the same call the infra-map cron makes. Every generated page
# carries the timestamp its content was last built from, and the served site carries
# build-info.json saying when this script last ran -- so a cron that stops working shows up
# on the page rather than needing its own alert channel.
#
# THAT ARGUMENT STILL HOLDS, AND IT COVERS ONLY A CRON THAT STOPS. A deadman detects silence.
# Neither failure this script has had was silence. On 2026-08-27 it ran, build_docs.py
# succeeded, the site was rebuilt from the working tree, and build-info.json stamped
# `"built_at": "2026-08-27 18:17 UTC", "generators": "ok"` -- written by the very run whose
# commit a prek hook rejected, which left the published pages frozen. Every signal named above
# read healthy through it, and nothing noticed for hours. The earlier ruleset rejection
# (see IT OPENS A PR) went undiagnosed for a day the same way.
#
# So this pushes a FAILURE REPORT, which is a different mechanism from the deadman that block
# declines: the trap below reports the outcome of every exit path, and `down` is the load-bearing
# half. The up-beat is a side effect of having a push monitor at all, not the reason for it.
set -uo pipefail

REPO="/home/{{ sys_user }}/server"
UV="/home/{{ sys_user }}/.local/bin/uv"
SITE_DIR="{{ docs_host_site_dir | default('/home/' + sys_user + '/docs-site') }}"
PR_BRANCH_PREFIX="docs-refresh/"

# The token is interpolated here rather than sourced from /etc/rancher/k3s/kuma-push.env,
# matching secret-rotate.sh -- the sibling pusher in this same role. `| default('')` gates it:
# the push is skipped until the secret exists, and the monitor in static-monitors.yaml.j2 is
# gated on the same variable, so neither half sits red waiting for the other.
DOCS_REFRESH_PUSH_TOKEN="{{ docs_refresh_push_token | default('') }}"
PUSH_URL="https://uptime-kuma.local.{{ domain }}/api/push/${DOCS_REFRESH_PUSH_TOKEN}"
KUMA_HOST="uptime-kuma.local.{{ domain }}"
KUMA_RESOLVE_IP="{{ k3s_metallb_ingress_vip }}"

# kuma_push, not an inline curl: the URL embeds the push token, and passing it as an argv
# element exposes it through /proc/<pid>/cmdline, which is world-readable here (no hidepid).
#
# A missing library does NOT abort, unlike secret-rotate.sh. Publishing the docs is worth doing
# on a host whose monitoring wiring is broken, and the trap below re-checks that kuma_push
# actually exists before calling it.
# shellcheck source=/dev/null
source /usr/local/lib/kuma-push-lib.sh 2>/dev/null \
  || logger -t docs-refresh "kuma-push-lib.sh missing — run initial_setup on this host"

# DEFAULTS TO down. Every exit path that is genuinely fine says so explicitly; anything else --
# a crash, a `set -u` abort, or a path added later that forgets to -- reports down. Failing
# closed is the whole point: this exists because a real failure read green for hours.
PUSH_STATUS=down
PUSH_MSG="docs-refresh exited without setting a status"
# Separate from PUSH_STATUS because a generator failure does not stop the run: the site is still
# built and the surviving pages are still worth committing (see below). Without this flag the
# successful publish at the end would overwrite the degradation and report a clean up.
GENERATORS_OK=1

# ONE trap doing both jobs. The temp-file cleanup used to be its own `trap ... EXIT` further
# down, and a second trap on the same signal REPLACES the first -- so adding this one later in
# the file would have silently disabled whichever lost. LOG is unset on the early exits, hence
# "${LOG:-}".
on_exit() {
  rm -f "${LOG:-}"
  # `status=` prefix, matching secret-rotate.sh: probe.py alerts reconstructs DOWN episodes for
  # host-cron pushers by matching that token in syslog, and a push straight to Kuma leaves no
  # other durable trace.
  logger -t docs-refresh "status=${PUSH_STATUS} ${PUSH_MSG}"
  [ -n "$DOCS_REFRESH_PUSH_TOKEN" ] || return 0
  command -v kuma_push >/dev/null 2>&1 || return 0
  kuma_push "$PUSH_STATUS" "$PUSH_MSG" "$PUSH_URL" "$KUMA_HOST" "$KUMA_RESOLVE_IP" docs-refresh
}
trap on_exit EXIT

# Records the message as well as logging it, so every existing call site feeds the push without
# needing its own push call -- there are eleven exit paths and one of them is a bare crash.
alert() { logger -t docs-refresh "$1"; PUSH_MSG="$1"; }

# Errors used to go to /dev/null, which is why a ruleset rejection went undiagnosed for a
# day: the alert said the push failed and nothing said why. logger takes one line, so
# flatten and cap -- the first few hundred characters of a git or gh failure carry the
# reason, and the full text stays in the file until the run ends.
say_failure() { alert "$1: $(tr '\n' ' ' < "$2" | tail -c 400)"; }

cd "$REPO" || { alert "docs-refresh: $REPO missing"; exit 1; }

# fd 9 held for the script's life. -w 2700 matches secret-rotate: longer than a full
# gitops deploy plus rollback, so a legitimately busy tree waits rather than skipping.
exec 9>/var/lock/server-git-tree.lock
flock -w 2700 9 || { alert "docs-refresh: git-tree lock held >45m; skipped"; exit 1; }

# A dirty tree means a human or another job is mid-edit. Committing on top of that would
# mix their work into a docs commit. Build the site anyway -- serving current docs costs
# nothing and is the useful half -- but change no files.
if ! git diff --quiet || ! git diff --cached --quiet; then
  alert "docs-refresh: working tree dirty; rebuilt site only, no regeneration"
  # up BEFORE the build, down inside the `||`. The other order reports up on a failed build,
  # because the failure branch runs first and the blanket assignment then overwrites it.
  PUSH_STATUS=up
  "$UV" run --frozen python scripts/docs/build_docs.py --skip-generators --site-dir "$SITE_DIR" \
    || { alert "docs-refresh: site build failed on dirty tree"; PUSH_STATUS=down; }
  exit 0
fi

# An unmerged PR from a previous run means its diff is still pending. Regenerating now
# would produce the same diff again and open a duplicate, so build the site (the useful
# half, and it does not need the PR) and stop. If CI is stuck the PRs would otherwise
# accumulate one per run, twice a day, with nobody looking.
# `gh pr list --head` matches one exact branch, and each run's branch is timestamped, so
# the filter has to be a prefix match over the open list rather than a --head lookup.
OPEN_PR="$(gh pr list --state open --json number,headRefName \
  --jq "[.[] | select(.headRefName | startswith(\"$PR_BRANCH_PREFIX\"))][0].number" \
  2>/dev/null || true)"
if [ -n "$OPEN_PR" ]; then
  alert "docs-refresh: PR #$OPEN_PR still open; rebuilt site only, no regeneration"
  PUSH_STATUS=up
  "$UV" run --frozen python scripts/docs/build_docs.py --skip-generators --site-dir "$SITE_DIR" \
    || { alert "docs-refresh: site build failed while a PR was open"; PUSH_STATUS=down; }
  exit 0
fi

# --frozen: install from the committed uv.lock, never rewrite it on the host. A lock
# rewrite here would show up as an unrelated dirty file on the next run.
if ! "$UV" run --frozen python scripts/docs/build_docs.py --site-dir "$SITE_DIR"; then
  alert "docs-refresh: one or more generators failed (site was still built)"
  # Deliberately NOT an exit. build_docs already skipped the failing generator and built
  # the site from what succeeded, so the pages that did regenerate are worth committing.
  # It IS a down, though: a page silently generated from a failing generator is the class of
  # fault this whole script exists to keep out of the published docs.
  GENERATORS_OK=0
fi

# Only the generated trees. A generator that wrote elsewhere would otherwise be committed
# silently by a cron, which is exactly the class of change that must go through a PR.
git add docs/reference docs/assets/generated

if git diff --cached --quiet; then
  # The common outcome: the inputs are repo files and they only move when a PR merges, so most
  # runs have nothing to publish. Up, with the reason named -- "nothing to do" must never read
  # the same as "everything is fine", which is what the sibling host crons say too.
  PUSH_STATUS=up
  PUSH_MSG="no change"
  exit 0
fi

# Hooks run. Unlike secret-rotate, this commit has no live-but-uncommitted state to
# strand: if a hook rejects it, nothing has been deployed and the right outcome is a clean
# abort.
#
# A hook that can fail on GENERATED content wedges this cron permanently -- it would abort,
# alert and exit 1 on every run until someone fixed the generator. Two already tried:
# end-of-file-fixer rewrote both generated files until the generators were fixed to emit
# exactly one trailing newline. Vale is scoped to exclude docs/reference/ for the same
# reason. Before adding any hook that matches a path staged above, check it cannot fail on
# generator output.
# No `trap ... EXIT` here any more: on_exit above already removes this file, and a second trap
# on the same signal would REPLACE that one and take the push with it.
LOG="$(mktemp)"

if ! git commit -m "docs: refresh generated reference pages" >"$LOG" 2>&1; then
  git reset >/dev/null 2>&1
  say_failure "docs-refresh: commit failed (hook rejection?); unstaged, nothing published" "$LOG"
  exit 1
fi

# Branch, PR, auto-merge -- see the header. The ORDER matters: the branch reaches the
# remote before master is reset, so the commit is never only on a branch this script is
# about to throw away.
BRANCH="${PR_BRANCH_PREFIX}$(date -u +%Y-%m-%d-%H%M)"
if ! git branch "$BRANCH" HEAD >"$LOG" 2>&1; then
  say_failure "docs-refresh: could not create $BRANCH; commit is local on master" "$LOG"
  exit 1
fi

if ! git push -u origin "$BRANCH" >"$LOG" 2>&1; then
  say_failure "docs-refresh: publishing $BRANCH failed; commit is local on master" "$LOG"
  exit 1
fi

# From here the commit is safe on the remote, so master gives it up. Leaving master ahead
# would break gitops-deploy's --ff-only once the squash lands under a new SHA, which parks
# the deployer behind origin until someone resets it by hand.
#
# HEAD~1, not origin/master: this undoes exactly the commit made above. `origin/master` is
# only as fresh as the last fetch, and this script deliberately never fetches, so resetting
# to it could discard something else or move master backwards.
git reset --hard HEAD~1 >/dev/null 2>&1

# The commit lives on the remote branch now. Keeping the local ref would leave one dead
# branch per run, and -d refuses it because master no longer contains the commit.
git branch -D "$BRANCH" >/dev/null 2>&1

if ! gh pr create --head "$BRANCH" --title "docs: refresh generated reference pages" \
  --body "Generated output only, from the twice-daily docs-refresh cron: the pages under docs/reference/ and the infra map. Both are reproducible by scripts/docs/build_docs.py. Opened as a PR because a repository ruleset rejects direct writes to master." \
  >"$LOG" 2>&1; then
  say_failure "docs-refresh: $BRANCH published but PR creation failed" "$LOG"
  exit 1
fi

# --auto lands it when the required check passes, so the cron stays unattended. Without
# this the PR waits for a human and the next run skips on the open-PR guard above.
if ! gh pr merge --auto --squash --delete-branch "$BRANCH" >"$LOG" 2>&1; then
  say_failure "docs-refresh: PR opened for $BRANCH but auto-merge could not be enabled" "$LOG"
  exit 1
fi

logger -t docs-refresh "regenerated, committed, PR opened for $BRANCH with auto-merge"
# The publish succeeded either way; GENERATORS_OK decides whether it published a COMPLETE set.
# Reporting up here regardless would let a failing generator ride out on a successful PR, which
# is the same "the run worked, the content did not" split that made 2026-08-27 invisible.
if [ "$GENERATORS_OK" -eq 1 ]; then
  PUSH_STATUS=up
  PUSH_MSG="regenerated, committed, PR opened for $BRANCH with auto-merge"
else
  PUSH_STATUS=down
  PUSH_MSG="PR opened for $BRANCH, but one or more generators had failed — the published set is incomplete"
fi
