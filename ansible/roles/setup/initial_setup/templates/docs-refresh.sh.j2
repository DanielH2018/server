#!/usr/bin/env bash
# Regenerate docs/reference/, rebuild the MkDocs site, commit and push any change.
#
# THE LOCK IS THE POINT. This mutates the primary git tree, which gitops-deploy.service
# rewrites with `git pull` on a 30-minute timer and which every deploy renders its
# templates from. /var/lock/server-git-tree.lock is what makes those mutually exclusive.
# Without it a `git pull` mid-run would leave this committing a tree it never read.
#
# IT DOES NOT PULL. gitops-deploy already fast-forwards this checkout, and it CI-gates the
# range first: a commit whose master CI is red or pending is refused, and a failed health
# gate parks the SHA in hold_sha. A bare pull here would take the lock correctly and still
# skip all of that, fast-forwarding onto a commit the tick would have refused -- and the
# next deploy renders templates from that tree. The tick runs 48 times a day to this
# script's twice, so reading whatever it has already admitted costs at most one interval.
#
# WHY IT COMMITS. The generated pages are reviewable in a diff and survive the pod. The
# alternative -- rendering at serve time -- is always current and completely invisible: a
# generator bug would reach the page with nothing to catch it.
#
# IT OPENS A PR. It used to write straight to master, on the stated grounds that
# secret-rotate.sh already did and "the path and its permissions are proven". They were
# not. A repository ruleset rejects every direct write to master:
#
#   remote: - Required status check "prek (lint + validate + tests + secrets)" is expected.
#   ! [remote rejected]   (declined due to repository rule violations)
#
# So this cron could never publish. It committed locally, failed to push, and left the
# commit sitting on master -- which made the tree dirty-by-being-ahead and, worse, meant
# the generated pages silently stopped being updated. Confirmed 2026-08-25 by running the
# rejected command by hand; the error had been invisible because both the commit and the
# push discarded their output to /dev/null.
#
# A PR satisfies the ruleset (the check runs on the PR) and auto-merge lands it without a
# human in the loop, so the cron stays unattended. Review is still bypassed in substance,
# which remains acceptable for the same reason as before: every byte it commits was
# produced by a generator whose output is itself tested.
#
# secret-rotate.sh had the same bug and got its own change (#427), for the reason noted here:
# it rotates live credentials, so its failure mode and its remedy are different. It publishes
# through a PR too now.
#
# ONE UNLANDED BRANCH AT A TIME. After publishing one this script resets master back to
# origin, so the next run regenerates the same diff and would publish a duplicate. It asks
# `publish_pr.py unlanded` first and exits instead. That gate reads origin rather than the
# open-PR list, which is secret-rotate's reasoning: `gh pr create` runs after the push, so a
# create failure leaves the branch on origin with no PR and no local trace at all, and an
# open-PR check reads exactly that state as clean (#1066).
#
# NO DEADMAN. Deliberate, and the same call the infra-map cron makes. Every generated page
# carries the timestamp its content was last built from, and the served site carries
# build-info.json saying when this script last ran -- so a cron that stops working shows up
# on the page rather than needing its own alert channel.
#
# THAT ARGUMENT STILL HOLDS, AND IT COVERS ONLY A CRON THAT STOPS. A deadman detects silence.
# Neither failure this script has had was silence. On 2026-08-27 it ran, build_docs.py
# succeeded, the site was rebuilt from the working tree, and build-info.json stamped
# `"built_at": "2026-08-27 18:17 UTC", "generators": "ok"` -- written by the very run whose
# commit a prek hook rejected, which left the published pages frozen. Every signal named above
# read healthy through it, and nothing noticed for hours. The earlier ruleset rejection
# (see IT OPENS A PR) went undiagnosed for a day the same way.
#
# So this pushes a FAILURE REPORT, which is a different mechanism from the deadman that block
# declines: the trap below reports the outcome of every exit path, and `down` is the load-bearing
# half. The up-beat is a side effect of having a push monitor at all, not the reason for it.
set -uo pipefail

REPO="/home/{{ sys_user }}/server"
UV="/home/{{ sys_user }}/.local/bin/uv"
SITE_DIR="{{ docs_host_site_dir | default('/home/' + sys_user + '/docs-site') }}"
PR_BRANCH_PREFIX="docs-refresh/"

# State this script keeps ACROSS runs, and it lives OUTSIDE $REPO deliberately: an untracked file
# inside the checkout parks gitops-deploy exactly as a modified one does, so a stamp whose job is
# to record dirt must never be dirt itself. /var/lib/homelab is the setup plane's state directory
# (root-owned, 0755); crons.yml creates this subdirectory owned by the cron user, because the cron
# runs without become.
STAMP_DIR="/var/lib/homelab/docs-refresh.d"
COMMIT_FAILED_STAMP="$STAMP_DIR/commit-failed"
COMMIT_FAILED_LOG="$STAMP_DIR/last-commit-failure.log"

# The token is interpolated here rather than sourced from /etc/rancher/k3s/kuma-push.env,
# matching secret-rotate.sh -- the sibling pusher in this same role. `| default('')` gates it:
# the push is skipped until the secret exists, and the monitor in static-monitors.yaml.j2 is
# gated on the same variable, so neither half sits red waiting for the other.
DOCS_REFRESH_PUSH_TOKEN="{{ docs_refresh_push_token | default('') }}"
PUSH_URL="https://uptime-kuma.local.{{ domain }}/api/push/${DOCS_REFRESH_PUSH_TOKEN}"
KUMA_HOST="uptime-kuma.local.{{ domain }}"
KUMA_RESOLVE_IP="{{ k3s_metallb_ingress_vip }}"

# kuma_push, not an inline curl: the URL embeds the push token, and passing it as an argv
# element exposes it through /proc/<pid>/cmdline, which is world-readable here (no hidepid).
#
# A missing library does NOT abort, unlike secret-rotate.sh. Publishing the docs is worth doing
# on a host whose monitoring wiring is broken, and the trap below re-checks that kuma_push
# actually exists before calling it.
# shellcheck source=/dev/null
source /usr/local/lib/kuma-push-lib.sh 2>/dev/null \
  || logger -t docs-refresh "kuma-push-lib.sh missing — run initial_setup on this host"

# DEFAULTS TO down. Every exit path that is genuinely fine says so explicitly; anything else --
# a crash, a `set -u` abort, or a path added later that forgets to -- reports down. Failing
# closed is the whole point: this exists because a real failure read green for hours.
PUSH_STATUS=down
PUSH_MSG="docs-refresh exited without setting a status"
# Separate from PUSH_STATUS because a generator failure does not stop the run: the site is still
# built and the surviving pages are still worth committing (see below). Without this flag the
# successful publish at the end would overwrite the degradation and report a clean up.
GENERATORS_OK=1

# ONE trap doing both jobs. The temp-file cleanup used to be its own `trap ... EXIT` further
# down, and a second trap on the same signal REPLACES the first -- so adding this one later in
# the file would have silently disabled whichever lost. LOG is unset on the early exits, hence
# "${LOG:-}".
on_exit() {
  rm -f "${LOG:-}"
  # `status=` prefix, matching secret-rotate.sh: probe.py alerts reconstructs DOWN episodes for
  # host-cron pushers by matching that token in syslog, and a push straight to Kuma leaves no
  # other durable trace.
  logger -t docs-refresh "status=${PUSH_STATUS} ${PUSH_MSG}"
  [ -n "$DOCS_REFRESH_PUSH_TOKEN" ] || return 0
  command -v kuma_push >/dev/null 2>&1 || return 0
  kuma_push "$PUSH_STATUS" "$PUSH_MSG" "$PUSH_URL" "$KUMA_HOST" "$KUMA_RESOLVE_IP" docs-refresh
}
trap on_exit EXIT

# Records the message as well as logging it, so every existing call site feeds the push without
# needing its own push call -- there are eleven exit paths and one of them is a bare crash.
alert() { logger -t docs-refresh "$1"; PUSH_MSG="$1"; }

# Errors used to go to /dev/null, which is why a ruleset rejection went undiagnosed for a
# day: the alert said the push failed and nothing said why. logger takes one line, so
# flatten and cap -- the first few hundred characters of a git or gh failure carry the
# reason, and the full text stays in the file until the run ends.
#
# FILTER BEFORE THE TAIL. prek runs every hook and keeps going past a failure, printing Passed and
# Skipped lines after it, and mkdocs-strict is the last hook -- so a plain tail of the whole run
# always ends `...Passed` and names no hook at all. The 2026-09-04 alert did exactly that, and two
# readers failed to identify the failing hook from it afterwards.
#
# THE FALLBACK IS LOAD-BEARING. `git commit` also fails for reasons whose output carries none of
# these tokens (a signing failure, "nothing to commit"), and this script runs without `set -e`, so
# a non-matching grep would otherwise produce an EMPTY alert -- worse than the uninformative one.
say_failure() {
  local detail
  detail="$(grep -E -A2 'Failed|^- hook id:|files were modified by this hook' "$2" 2>/dev/null \
    | tr '\n' ' ' | tail -c 400)"
  [ -n "$detail" ] || detail="$(tr '\n' ' ' < "$2" | tail -c 400)"
  alert "$1: $detail"
}

# on_exit removes the temp log, the cron entry redirects nothing and Loki has no stream for this
# script, so without this copy the cause of a commit failure is unrecoverable the moment the run
# ends. Bounded, and outside $REPO for the same reason as the stamp.
keep_failure_log() {
  mkdir -p "$STAMP_DIR" 2>/dev/null || return 0
  tail -c 65536 "$1" >"$COMMIT_FAILED_LOG" 2>/dev/null || return 0
}

# Puts the checkout back the way it was before `git add`. $1 is the output of
# `git diff --cached --name-status --no-renames`, captured BEFORE the commit.
#
# `git reset` alone -- all this path used to do -- unstages and nothing else, leaving every
# regenerated page MODIFIED in the primary checkout. deploy_git.py reads any porcelain output as
# dirty and gitops_deploy.py takes its healthy-skip path, still writing last_run, so ONE failed
# commit here parks every deploy on the box behind a green deployer. Four commit failures are on
# record (2026-08-25 twice, 08-27, 09-04) and a human cleaned up each time before the next run.
#
# A newly generated page needs `rm`, not `git checkout HEAD --`: it has no HEAD version, the
# checkout fails on it, and the file is left UNTRACKED -- which parks the deployer just as surely.
#
# Scoped to the staged paths, never a blanket `git checkout -- docs/reference`: topology.md is
# hand-written prose in that tree, and a blanket checkout would destroy an uncommitted human edit.
restore_generated_tree() {
  local status path rc=0
  while IFS=$'\t' read -r status path; do
    [ -n "${path:-}" ] || continue
    case "$status" in
      A) rm -f -- "$path" ;;
      *) git checkout HEAD -- "$path" >/dev/null 2>&1 || rc=1 ;;
    esac
  done <<EOF
$1
EOF
  git reset >/dev/null 2>&1
  # THE ACTION IS PER-PATH; THE CHECK IS PER-TREE, AND THE ASYMMETRY IS DELIBERATE.
  #
  # A prek hook can modify a file AFTER `git add` ran -- gen-doc-fragments regenerates the whole
  # fragment set, so it rewrites fragments this run's generators never touched. Those files are
  # dirty, they park the deployer, and they are absent from $1 by construction. A check scoped to
  # $1 would report "tree restored" over exactly the leftover that made 2026-09-04's alert wrong.
  #
  # The cost is a false TREE-STILL-DIRTY if a human edits topology.md (the one hand-written page
  # in docs/reference) inside the run window. That window is small -- the top-of-script gate exits
  # on any dirty tree, so everything tracked and modified here arrived during this run -- and
  # fail-closed is the direction this script's own header demands.
  [ -z "$(git status --porcelain -- docs/reference docs/assets/generated)" ] || rc=1
  return "$rc"
}

mark_commit_failed() {
  mkdir -p "$STAMP_DIR" 2>/dev/null || return 0
  printf '%s\n' "$1" >"$COMMIT_FAILED_STAMP" 2>/dev/null || return 0
}

clear_commit_failed() { rm -f "$COMMIT_FAILED_STAMP"; }

# The status to report for a dirty tree. Foreign dirt is `up`: somebody else is mid-edit and this
# run legitimately did nothing. This script's OWN leftover dirt is `down` -- run N fails its commit
# and pushes down, run N+1 meets that dirt, takes the dirty branch and used to push `up`, clearing
# the alarm run N raised while nothing had been published and the deployer was still parked. The
# stamp tells the two apart; paths cannot, because a human running build_docs.py by hand in this
# checkout dirties exactly the same files.
dirty_tree_status() { if [ -e "$COMMIT_FAILED_STAMP" ]; then printf down; else printf up; fi; }

cd "$REPO" || { alert "docs-refresh: $REPO missing"; exit 1; }

# fd 9 held for the script's life. -w 3000 matches secret-rotate and deploy.sh: longer than a
# full gitops deploy plus rollback, so a legitimately busy tree waits rather than skipping.
#
# This said "-w 2700 matches secret-rotate" while secret-rotate was 3000, and 2700 was 240s
# SHORT of the deployer's 2940s worst-case hold. PR #585 resized the staging gate and raised
# secret-rotate; this copy and eval-run's were hand-written and nothing recomputed them. A wait
# that expires during a legitimate rollback is not a safe failure — it fires this unit's
# OnFailure= for ordinary contention AND skips the run.
# ENFORCED by gitops_deploy/tests/test_gitops_deploy_timeout_budgets.py, which now derives every
# waiter's floor from the same four deploy budgets rather than pinning two of the four by hand.
exec 9>/var/lock/server-git-tree.lock
flock -w 3000 9 || { alert "docs-refresh: git-tree lock held >50m; skipped"; exit 1; }

# A dirty tree is usually a human or another job mid-edit. Committing on top of that would mix
# their work into a docs commit. Build the site anyway -- serving current docs costs nothing and
# is the useful half -- but change no files.
#
# THE DIRT IS NOT ALWAYS SOMEBODY ELSE'S. It may be this script's own, left by a commit failure a
# run ago, and reporting up on that is how a failed run clears the alarm it just raised.
# dirty_tree_status reads the stamp to tell the two apart.
if ! git diff --quiet || ! git diff --cached --quiet; then
  # up BEFORE the build, down inside the `||`. The other order reports up on a failed build,
  # because the failure branch runs first and the blanket assignment then overwrites it.
  PUSH_STATUS="$(dirty_tree_status)"
  if [ "$PUSH_STATUS" = down ]; then
    alert "docs-refresh: tree still dirty from this cron's own failed commit ($(tr '\n' ' ' \
      < "$COMMIT_FAILED_STAMP" 2>/dev/null | tail -c 200)); rebuilt site only, nothing published"
  else
    alert "docs-refresh: working tree dirty; rebuilt site only, no regeneration"
  fi
  "$UV" run --frozen python scripts/docs/build_docs.py --skip-generators --site-dir "$SITE_DIR" \
    || { alert "docs-refresh: site build failed on dirty tree"; PUSH_STATUS=down; }
  exit 0
fi

# Unlanded work from a previous run means its diff is still pending. Regenerating now would
# produce the same diff again and publish a duplicate, so build the site (the useful half,
# and it does not need the PR) and stop. If CI is stuck the PRs would otherwise accumulate
# one per run, twice a day, with nobody looking.
#
# GATED ON ORIGIN, not on the open-PR list, which is secret-rotate's reasoning applied here:
# `gh pr create` runs AFTER the push inside the publisher, so a create failure -- a `gh`
# timeout against the 60/hour quota is enough -- leaves docs-refresh/<stamp> on origin with no
# PR and no local trace at all. An open-PR check reads that state as "nothing open" and
# publishes a second orphan branch, twice a day, which is the accumulation this guard exists
# to prevent. Merged branches are deleted on this repo, so a surviving head means unlanded work.
UNLANDED="$("$UV" run --frozen python scripts/deploy_tools/publish_pr.py unlanded \
  --prefix "$PR_BRANCH_PREFIX" 2>&1)"
UNLANDED_RC=$?
if [ "$UNLANDED_RC" -ne 0 ]; then
  alert "docs-refresh: $UNLANDED; rebuilt site only, no regeneration"
  # 2 is a PR waiting on CI: benign, it clears itself, and the docs are only a run behind.
  # 1 (origin unreadable) and 3 (a branch with no PR) both need a human, so they report down.
  if [ "$UNLANDED_RC" -eq 2 ]; then
    PUSH_STATUS=up
  else
    PUSH_STATUS=down
  fi
  "$UV" run --frozen python scripts/docs/build_docs.py --skip-generators --site-dir "$SITE_DIR" \
    || { alert "docs-refresh: site build failed while a previous run was unlanded"; PUSH_STATUS=down; }
  exit 0
fi

# --frozen: install from the committed uv.lock, never rewrite it on the host. A lock
# rewrite here would show up as an unrelated dirty file on the next run.
if ! "$UV" run --frozen python scripts/docs/build_docs.py --site-dir "$SITE_DIR"; then
  alert "docs-refresh: one or more generators failed (site was still built)"
  # Deliberately NOT an exit. build_docs already skipped the failing generator and built
  # the site from what succeeded, so the pages that did regenerate are worth committing.
  # It IS a down, though: a page silently generated from a failing generator is the class of
  # fault this whole script exists to keep out of the published docs.
  GENERATORS_OK=0
fi

# Only the generated trees. A generator that wrote elsewhere would otherwise be committed
# silently by a cron, which is exactly the class of change that must go through a PR.
git add docs/reference docs/assets/generated

if git diff --cached --quiet; then
  # The common outcome: the inputs are repo files and they only move when a PR merges, so most
  # runs have nothing to publish. Up, with the reason named -- "nothing to do" must never read
  # the same as "everything is fine", which is what the sibling host crons say too.
  #
  # GATED ON GENERATORS_OK, and this is the branch that matters: a failing generator typically
  # writes nothing, so the staged diff is quiet and control arrives HERE rather than at the
  # terminal gate below. Reporting up unconditionally laundered both the status and the reason,
  # because `exit 0` skips that gate entirely (2026-08-27b review H-2). Leave PUSH_MSG alone on
  # the down arm -- it still holds the failure `alert()` set, and overwriting it with "no change"
  # would fix the status while re-laundering the reason.
  if [ "$GENERATORS_OK" -eq 1 ]; then
    PUSH_STATUS=up
    PUSH_MSG="no change"
    # A clean tree with nothing left to publish means a previous run's failed commit is behind us.
    clear_commit_failed
  else
    PUSH_STATUS=down
  fi
  exit 0
fi

# Hooks run. Unlike secret-rotate, this commit has no live-but-uncommitted state to
# strand: if a hook rejects it, nothing has been deployed and the right outcome is a clean
# abort.
#
# A hook that can fail on GENERATED content wedges this cron permanently -- it would abort,
# alert and exit 1 on every run until someone fixed the generator. Two already tried:
# end-of-file-fixer rewrote both generated files until the generators were fixed to emit
# exactly one trailing newline. Vale is scoped to exclude docs/reference/ for the same
# reason. Before adding any hook that matches a path staged above, check it cannot fail on
# generator output.
# No `trap ... EXIT` here any more: on_exit above already removes this file, and a second trap
# on the same signal would REPLACE that one and take the push with it.
LOG="$(mktemp)"

# Captured BEFORE the commit. The index survives a failed commit, but the restore has to know
# which paths were newly ADDED and which merely modified, and `git reset` erases that distinction.
# --no-renames so a rename never arrives as the three-field line the restore would misread.
STAGED_STATUS="$(git diff --cached --name-status --no-renames)"

# NOT `if ! git commit`: inside that branch `$?` is the status of the negation, which is always 0,
# so the exit code has to be captured from the plain command first. It is reported because
# "hook rejection?" was only ever this script's guess -- the 2026-09-05 06:18 failure was filed
# undiagnosed (#1155) precisely because the alert named no cause, and git's own code separates a
# rejected hook (1) from a signing or ref failure.
git commit -m "docs: refresh generated reference pages" >"$LOG" 2>&1
COMMIT_RC=$?
if [ "$COMMIT_RC" -ne 0 ]; then
  keep_failure_log "$LOG"
  if restore_generated_tree "$STAGED_STATUS"; then
    RESTORE_NOTE="tree restored"
  else
    RESTORE_NOTE="TREE STILL DIRTY - gitops-deploy is parked until it is cleaned"
  fi
  # Stamped whichever way the restore went, and cleared only by a run that publishes or finds
  # nothing to publish: it is what lets the NEXT run recognise leftover dirt as its own.
  mark_commit_failed "commit failed $(date -u '+%Y-%m-%dT%H:%M:%SZ') (git exit ${COMMIT_RC}); ${RESTORE_NOTE}; full log: ${COMMIT_FAILED_LOG}"
  say_failure "docs-refresh: commit failed (git exit ${COMMIT_RC}); ${RESTORE_NOTE}, nothing published" "$LOG"
  exit 1
fi

# Branch, push, reset master, PR, auto-merge: scripts/deploy_tools/publish_pr.py, shared with
# eval-run and secret-rotate. Its header carries the ordering and the HEAD~1 reasoning. It
# prints one line to alert with, and its exit code says where the commit is: 1 while it is
# still local on master, 2 once the branch is on origin without a PR.
PUB_MSG="$("$UV" run --frozen python scripts/deploy_tools/publish_pr.py publish \
  --prefix "$PR_BRANCH_PREFIX" --title "docs: refresh generated reference pages" \
  --body "Generated output only, from the twice-daily docs-refresh cron: the pages under docs/reference/ and the infra map. Both are reproducible by scripts/docs/build_docs.py. Opened as a PR because a repository ruleset rejects direct writes to master." \
  2>&1)"
PUB_RC=$?
# The publisher prints one line, but 2>&1 also captures uv's own resolver chatter after a lock
# bump, and logger and Kuma each take one. Same flatten-and-cap as say_failure, and safe to run
# a pipeline here because PUB_RC above already holds the status this branches on. Bash's own
# `${PUB_MSG: -400}` is NOT the shorter way to write it: a negative offset larger than the
# string returns the EMPTY string, so it would silently drop every message under 400 characters.
PUB_MSG="$(printf '%s' "$PUB_MSG" | tr '\n' ' ' | tail -c 400)"
# Exit 1 and exit 2 are both reported the same way here, deliberately. At 2 the publisher has
# already reset the local master, so the tree is clean either way and there is nothing for this
# script to undo; the unlanded arm above is what catches the orphaned branch on the next run.
if [ "$PUB_RC" -ne 0 ]; then
  alert "docs-refresh: $PUB_MSG"
  exit 1
fi

logger -t docs-refresh "regenerated, committed, $PUB_MSG"
# Published: whatever an earlier run failed to commit is on origin now, so the stamp has done its
# job and the next dirty tree this script meets belongs to somebody else.
clear_commit_failed
# The publish succeeded either way; GENERATORS_OK decides whether it published a COMPLETE set.
# Reporting up here regardless would let a failing generator ride out on a successful PR, which
# is the same "the run worked, the content did not" split that made 2026-08-27 invisible.
if [ "$GENERATORS_OK" -eq 1 ]; then
  PUSH_STATUS=up
  PUSH_MSG="regenerated, committed, $PUB_MSG"
else
  PUSH_STATUS=down
  # $PUB_MSG, not a re-derived branch name: the publisher already names the branch it opened,
  # and the BRANCH variable this line used to read was deleted when that logic moved into
  # publish_pr.py -- leaving a `set -u` abort on exactly the path that reports a degraded run.
  PUSH_MSG="$PUB_MSG, but one or more generators had failed — the published set is incomplete"
fi
