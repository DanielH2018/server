# Kuma push token for the weekly AIDE check — managed by Ansible (initial_setup role).
# Sourced by /usr/local/bin/aide-check.sh, never inlined into it: that script lands 0755, so an
# inlined token would be readable by every local account, and a push token is enough to forge or
# suppress a heartbeat.
#
# Selected per host, not shared. Each host runs its own check against its own baseline, and two
# pushers on one token would let one host's `up` satisfy the deadline for a host whose check
# stopped running (issue #952, the trap the Loki witness and the UPS watchdog record).
#
# `| default('')`, not `| mandatory`: initial_setup.yml is in `_BROAD_MANUAL_PREFIXES` and runs by
# hand on every host, so a token that resolves empty must not fail the play for whoever is running
# it. The script still runs the check with no token and logs that it skipped the push.
{% if inventory_hostname == 'daniel-box' %}
AIDE_PUSH_TOKEN='{{ aide_daniel_box_push_token | default("") }}'
{% elif inventory_hostname == 'daniel-server' %}
AIDE_PUSH_TOKEN='{{ aide_daniel_server_push_token | default("") }}'
{% elif inventory_hostname == 'daniel-pi' %}
AIDE_PUSH_TOKEN='{{ aide_daniel_pi_push_token | default("") }}'
{% else %}
AIDE_PUSH_TOKEN=''
{% endif %}
