# Anthropic API key for the weekly eval sweep — managed by Ansible (initial_setup role).
# Sourced by /usr/local/bin/eval-run.sh, never rendered into it: a script is read as code, and
# a grep, cat or diff over one prints any secret inside it (#4607). This file is rendered only
# while the key exists; with no key the task removes it and the script reports a disarmed UP.
ANTHROPIC_API_KEY='{{ anthropic_api_key }}'
