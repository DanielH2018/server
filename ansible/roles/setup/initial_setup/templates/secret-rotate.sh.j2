#!/usr/bin/env bash
# Weekly unattended rotation of coming-due auto-tier secrets — managed by Ansible; edits overwritten.
#
# Rotates only `auto` push tokens that (a) are due within ROTATE_LEAD_DAYS (rotated the run
# BEFORE they go overdue, so the daily audit never pages on a scheduled rotation) and (b) have a
# single-redeploy consumer (monitor-bridge / cloudflare-ddns). Cross-host tokens stay manual.
# Because due-dates are staggered, most weeks this rotates 0-2 tokens. On any failure it
# REVERTS the working tree (so a half-rotated secret is never left committed) and alerts via
# the "Secret Rotation" Kuma monitor.
#
# IT PUBLISHES THROUGH A PR, and must. It used to write straight to master, which a
# repository ruleset rejects outright:
#
#   remote: - Required status check "prek (lint + validate + tests + secrets)" is expected.
#   ! [remote rejected]   (declined due to repository rule violations)
#
# so every rotation it ever performed stayed local. That is worse here than in docs-refresh,
# where the same bug was found (2026-08-25) and fixed first: this script has ALREADY changed
# the live credential and redeployed its consumer by the time it publishes. An unpublished
# rotation leaves the running value and the repo disagreeing, and the next deploy from origin
# re-applies the superseded one.
#
# Auto-merge is deliberate, not copied. The commit carries `ansible/vars/secrets.yml`, which
# is SOPS-encrypted, plus `ansible/secret_rotation.yml`, which is names and dates and no
# values -- so there is nothing in the diff a reviewer could read anyway, and holding it for
# review is the failure mode above rather than a safeguard against it.
#
# ONE ROTATION IN FLIGHT AT A TIME. A rotation whose PR has not landed is exactly the state
# this cron must not stack on: rotating again would move the live value a second time while
# the first is still unrecorded. It refuses and pages instead.
set -uo pipefail

REPO=/home/{{ sys_user }}/server
# sops lives in /usr/local/bin (outside cron's PATH); uv resolves ansible from the pinned env.
export PATH=/usr/local/bin:/usr/bin:/bin:/home/{{ sys_user }}/.local/bin
UV=/home/{{ sys_user }}/.local/bin/uv
KUMA="https://uptime-kuma.local.{{ domain }}/api/push/{{ secret_rotation_push_token }}"
# Array (not a plain string) so each path survives as its own argument below without
# relying on unquoted word-splitting (shellcheck SC2086).
TRACKED=(ansible/vars/secrets.yml ansible/secret_rotation.yml)
PR_BRANCH_PREFIX="secret-rotate/"

cd "$REPO" || exit 1

alert() { curl -fsS --max-time 10 -G "$KUMA" --data-urlencode "status=down" \
            --data-urlencode "msg=$1" >/dev/null 2>&1 || true; logger -t secret-rotate "$1"; }
revert() { git checkout -- "${TRACKED[@]}" 2>/dev/null || true; }

# The push used to fail into /dev/null, so the alert said it failed and nothing said why --
# the ruleset rejection above went unread for as long as it had been happening. Kuma and
# logger both take one line, so flatten and cap; the reason is always in the first few
# hundred characters of a git or gh failure.
say_failure() { alert "$1: $(tr '\n' ' ' < "$2" | tail -c 400)"; }

# Serialize against the GitOps deployer — both mutate this same working tree, and gitops's
# `git reset --hard` on a failed deploy would silently discard a concurrent half-rotation here.
# flock makes every git-tree mutation mutually exclusive; fd 9 is held for the script's life.
exec 9>/var/lock/server-git-tree.lock
# The wait must clear the DEPLOYER's worst-case hold, not a round number. gitops-deploy.service
# wraps its whole ExecStart in this lock, and one activation can run two sequential playbook
# budgets: the forward deploy (gitops_deploy_k8s_timeout_s, 900s) and then, in the failure path,
# the rollback redeploy (gitops_deploy_k8s_rollback_timeout_s, 1320s) — 2220s, plus its own
# `flock -w 180`. A single failing service reaches that; it does not need a batch.
#
# At the old 1200s this cron gave up mid-incident, paged "gitops deploy stuck?" (a duplicate —
# the unit's OnFailure= has already fired) and, the part that matters, SKIPPED that week's
# rotation entirely. There is no retry: crons.yml installs one weekly entry, so the next attempt
# is +7 days, and ROTATE_LEAD_DAYS=8 against a 7-day cadence means a token usually gets exactly
# one eligible run.
flock -w 2700 9 || { alert "secret-rotate: git-tree lock held >45m — longer than a full gitops deploy+rollback; skipped, no rotation this week"; exit 1; }

# Start from a clean, current tree — a dirty tree means a prior failure to investigate.
if [ -n "$(git status --porcelain "${TRACKED[@]}")" ]; then
  alert "secret-rotate aborted: working tree dirty (manual review needed)"; exit 1
fi

# A previous rotation whose PR has not landed means the live value and origin still disagree.
# Rotating again would move the live value a second time while the first is still unrecorded,
# so refuse and page. This is a stuck state needing a human, not a skip: `gh pr list --head`
# matches one exact branch and each run's is timestamped, so the filter is a prefix match.
OPEN_PR="$(gh pr list --state open --json number,headRefName \
  --jq "[.[] | select(.headRefName | startswith(\"$PR_BRANCH_PREFIX\"))][0].number" \
  2>/dev/null || true)"
if [ -n "$OPEN_PR" ]; then
  alert "secret-rotate aborted: PR #$OPEN_PR from a previous rotation is still open — the live value and origin disagree until it lands; no rotation this week"
  exit 1
fi
# On a rebase conflict (a committed-but-unpushed local change vs an advanced origin) the pull leaves
# the tree mid-rebase, which then trips the dirty-guard and pages weekly until a manual `git rebase
# --abort`. Abort it here so the next run self-recovers once origin is reconcilable; the `|| true`
# makes it a harmless no-op when no rebase is in progress (e.g. a network failure before the rebase).
git pull --rebase --autostash >/dev/null 2>&1 || {
  git rebase --abort >/dev/null 2>&1 || true
  alert "secret-rotate: git pull failed"; exit 1
}

# Rotate + redeploy consumers. On failure, discard the partial change and alert.
# --frozen: install from the committed uv.lock, never rewrite it on the host — a lock rewrite
# would dirty the tree and wedge the GitOps deployer's dirty-skip (matches gitops_deploy's deploy()).
if ! $UV run --frozen python scripts/secret_rotation.py rotate --commit --deploy; then
  revert; alert "secret-rotate: rotate/deploy failed — reverted"; exit 1
fi

if [ -n "$(git status --porcelain "${TRACKED[@]}")" ]; then
  git add "${TRACKED[@]}"
  # --no-verify skips the prek pre-commit chain: this is a mechanical two-file `sops set` commit
  # and the chain's ansible-lint step does a network galaxy-install, so a transient flake there
  # would abort the commit. The rotation is ALREADY live in the container by now, so a failed
  # commit must be caught (never fall through to the misleading success log) but must NOT be
  # reverted — discarding it would strand the live-but-uncommitted new value. CI re-validates the
  # push server-side. Without this guard the abort left the tree dirty and false-logged success,
  # wedging the GitOps deployer's dirty-skip with no signal.
  LOG="$(mktemp)"
  trap 'rm -f "$LOG"' EXIT
  if git -c user.name="secret-rotate" -c user.email="{{ email }}" \
      commit --no-verify -m "chore(secrets): auto-rotate due auto-tier push tokens" \
      >"$LOG" 2>&1; then
    # Branch, publish, PR, auto-merge -- see the header. Nothing below reverts: the rotation
    # is already live, so on any failure the commit stays put and a human lands it. That is
    # the same reasoning the commit guard above has always used.
    BRANCH="${PR_BRANCH_PREFIX}$(date -u +%Y-%m-%d-%H%M)"
    if ! git branch "$BRANCH" HEAD >"$LOG" 2>&1; then
      say_failure "secret-rotate: rotated + deployed, but could not create $BRANCH; commit is local" "$LOG"
      exit 1
    fi
    if ! git push -u origin "$BRANCH" >"$LOG" 2>&1; then
      say_failure "secret-rotate: rotated + deployed but publishing $BRANCH FAILED; commit is local" "$LOG"
      exit 1
    fi
    # Only now is the commit safe off this host. Leaving it on master would put the checkout
    # ahead of origin, and gitops-deploy's --ff-only then parks behind origin until someone
    # resets by hand. HEAD~1 undoes exactly the commit above; this script DOES pull, but the
    # remote ref is still only as fresh as that pull, so resetting to it is the wrong target.
    git reset --hard HEAD~1 >/dev/null 2>&1
    git branch -D "$BRANCH" >/dev/null 2>&1
    if ! gh pr create --head "$BRANCH" \
        --title "chore(secrets): auto-rotate due auto-tier push tokens" \
        --body "Automated weekly rotation of coming-due auto-tier push tokens. The diff is the SOPS-encrypted secrets file and the plaintext rotation registry (names and dates, no values). The new value is ALREADY live and its consumer redeployed, so until this lands the running credential and origin disagree." \
        >"$LOG" 2>&1; then
      say_failure "secret-rotate: rotated + deployed, $BRANCH published but PR creation FAILED" "$LOG"
      exit 1
    fi
    if ! gh pr merge --auto --squash --delete-branch "$BRANCH" >"$LOG" 2>&1; then
      say_failure "secret-rotate: rotated + deployed, PR opened for $BRANCH but auto-merge could not be enabled" "$LOG"
      exit 1
    fi
    logger -t secret-rotate "rotated + deployed due auto-tier tokens; PR opened for $BRANCH with auto-merge"
  else
    say_failure "secret-rotate: rotated + deployed but git commit FAILED — tree left dirty, commit by hand" "$LOG"
  fi
fi
