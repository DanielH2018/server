#!/usr/bin/env bash
# Witness for the Loki read route — managed by Ansible (initial_setup role); edits overwritten.
#
# Usage: loki-read-route-health.sh [-h|--help]
# Takes no arguments. systemd timer kuma-check-loki-read-route.timer runs it as the deploy user at
# minute 23 of every hour on each host in loki_route_witness_hosts, and again every 15 minutes
# while the last run failed. M6 batch B2's Cutover-2 removed its Kuma push. Each run
# writes its verdict to $TEXTFILE_DIR/loki-read-route-health.prom for node_exporter's textfile
# collector (default /var/lib/node-exporter-textfile; a test points it elsewhere).
#
# WHAT THIS WATCHES (issue #1712). loki-homelab's IngressRoute has exactly one caller —
# `probe.py loki-query` / `loki-labels`, running as a host process — and nothing watched it. It
# was dead from daniel-server for as long as traefik sat on daniel-box (#1693) and nothing
# noticed; the operator saw `404 page not found`, which does not distinguish a broken route from
# a broken query.
#
# WHY A POD CANNOT BE THE WITNESS. The route's guard is a ClientIP set of node-owned addresses
# (roles/k8s/loki-homelab/templates/ingressroute.yaml.j2), so monitor-bridge's request would
# arrive with a pod IP and fail for a reason unrelated to the operator's path. What broke was a
# HOST-sourced grant, and only a host process can witness it.
#
# WHY THIS RUNS ON BOTH NODES. Which address a host process arrives as depends on where the
# traefik pod is: same node, the packet carries that node's cni0 gateway; other node, it crosses
# the VXLAN overlay and carries the sending node's flannel.1 address. #1693 was invisible from
# daniel-box and fatal from daniel-server, so one witness would have reported green throughout.
# Each host writes its OWN verdict, which Prometheus labels with the host's origin, and the
# LokiReadRoute rules select each host's series apart.
#
# THE VERDICT IS THE BODY, NOT THE EXIT CODE. probe.py's curl carries no `-f`, so `404 page not
# found` comes back with exit 0. loki_route_health.py is what decides, and its tests hold that
# 404 as a DOWN case.
set -uo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

# shellcheck source=/dev/null
source /usr/local/lib/homelab-check-lib.sh || {
  logger -t loki-read-route-health "homelab-check-lib.sh missing — run initial_setup on this host"
  exit 1
}

# A boot that lands on the slot reports the route down while k3s is still starting. Exit 1
# without a verdict instead: the timer's Restart=on-failure reruns this in RestartSec, which is
# what carries the real verdict. The lib's log line still names the dead-man grace, which also
# covers the gap.
if boot_grace_active {{ loki_route_witness_boot_grace_s }} loki-read-route-health; then
  exit 1
fi

# The longest legitimate gap between two textfile writes: the timer fires at minute 23 of every
# hour (3600s), and a run skipped by the boot grace may take one slot, so 7200s.
# ansible/tests/services/test_initial_setup_check_rule_literals.py pins the rules' literals to it.
DEADLINE_S=7200

REPO_DIR=/home/{{ sys_user }}/server
# UV absolute-pathed: cron's PATH lacks ~/.local/bin. --frozen: never rewrite uv.lock on this
# host — a rewrite would dirty the tree and wedge the GitOps deployer's dirty-skip, the same
# reason release-staleness-check.sh uses it.
UV=/home/{{ sys_user }}/.local/bin/uv
BODY="$(cd "$REPO_DIR" && "$UV" run --quiet --frozen python scripts/diagnostics/probe.py loki-labels 2>&1)"
RC=$?

# `--no-project`, so the reader runs on the pinned interpreter without resolving whatever project
# the working directory sits in — a broken lockfile in the checkout above must not read as a broken
# route. Same shape as the Longhorn backup-health reader in the k3s role.
if MSG="$(printf '%s' "$BODY" | /usr/local/bin/uv run --no-project --no-python-downloads --python {{ host_python_version }} /opt/loki-route-health/loki_route_health.py "$RC")"; then
  STATUS=up
else
  STATUS=down
fi

# Unconditional, for the same reason as setup-drift-check.sh: this line is the durable record of
# the verdict's message, and `probe.py alerts` reconstructs DOWN episodes from it. NOTICE rather
# than INFO — journald caps MaxLevelStore=notice here.
logger -p daemon.notice -t loki-read-route-health "status=${STATUS} ${MSG}"

# The textfile verdict, which LokiReadRouteFailed and LokiReadRouteNotReporting read. A failed
# write logs and the run goes on to its exit code.
write_check_textfile loki-read-route-health "$([[ "$STATUS" == up ]] && echo 1 || echo 0)" "$(date +%s)" "$DEADLINE_S" \
  || logger -t loki-read-route-health "textfile write failed (status=${STATUS})"

# The exit code is the timer's contract (roles/setup/common/tasks/kuma_check_timer.yml): 1 after
# a down verdict so Restart=on-failure reruns the check until the route answers, 0 after up.
[[ "$STATUS" == up ]] || exit 1
