# Local AIDE exclusions for Docker homelab.
# Named 98_* so it loads before 99_aide_root's "/ Full" catch-all.
# AIDE uses first-match-wins, so these exclusions take precedence.

# Docker image layers and overlay2 filesystem — change on every pull/deploy
!/var/lib/docker/

# Container application data — media, downloads, app databases (high-churn)
!/home/{{ sys_user }}/server/containers/data/

# k3s workload data, the cluster nodes' counterpart of the Docker paths above. Each changes on
# every write, pull or pod start, so AIDE would hash it weekly and report it every week. The
# root filesystem it sits on held 469 GB on daniel-box on 2026-10-12. The k3s binaries
# (/var/lib/rancher/k3s/data), its certificates and staged manifests (the rest of
# /var/lib/rancher/k3s/server) and /etc/rancher stay checked. Absent on daniel-pi; a rule for a
# missing path matches nothing.
# Longhorn replica images: every volume's block data
!/var/lib/longhorn/
# containerd image layers and container snapshots
!/var/lib/rancher/k3s/agent/containerd/
# The same container filesystems again, mounted: containerd mounts every running container's
# root filesystem as an overlay under its runtime state directory, so the snapshot exclusion
# above does not keep AIDE out of them. daniel-box held 176 such mounts on 2026-10-20, and the
# 2026-10-19 scan was still hashing files inside them 35 hours in (#5785). The Pi's Docker
# containerd keeps its runtime state under /run/containerd.
!/run/k3s/
!/run/containerd/
# Network namespace handles, one per pod: nsfs mounts, not files
!/run/netns/
# The embedded etcd's data and its local snapshots
!/var/lib/rancher/k3s/server/db/
# Pod volumes: emptyDirs and projected Secrets and ConfigMaps
!/var/lib/kubelet/pods/
# Container logs
!/var/log/pods/
!/var/log/containers/

# Claude Code worktrees: each is a full checkout of this repo with its own .venv, created and
# removed by agent sessions every day. On 2026-10-20 daniel-box held 83 of them, 2.19M of the
# 5.1M inodes on its root filesystem, and the weekly check ran 35 hours without finishing
# (#5785). The primary checkout beside them stays checked.
!/home/{{ sys_user }}/server/\.claude/worktrees/

# Per-user caches and session state: package-manager download caches (uv, prek, npm) and
# per-session review scratch, all rewritten by ordinary use. ~/.local/share stays checked,
# because the uv-managed Pythons, uv tools and node versions there are executables.
!/home/[^/]+/\.cache/
!/home/[^/]+/\.npm/
!/home/[^/]+/\.local/state/

# Virtual/pseudo filesystems — not real files, cause inflated read counts
!/proc/
!/sys/
