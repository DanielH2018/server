# Managed by Ansible; edits overwritten. Sourced by the TLS cert-expiry watch cron
# (scripts/watchers/cert_expiry.py) so the webhook URL never sits in the crontab line itself
# -- a cron job's command is world-readable via /proc/<pid>/cmdline while it runs, the same
# reason setup-drift-kuma-push.env exists as its own file instead of an inline value.
CERT_EXPIRY_DISCORD_WEBHOOK_URL={{ monitor_discord_webhook_url }}
