#!/usr/bin/env bash
# Daily secret-rotation audit — managed by Ansible (initial_setup); edits overwritten.
#
# Runs scripts/secret_rotation.py audit --push, which reads the rotation registry
# (ansible/secret_rotation.yml) and pushes up/down to the "Secret Rotation" Kuma monitor:
# DOWN when any secret is past its per-tier rotation window, or when a secret exists in
# secrets.yml but not the registry (reminding the operator to `secret_rotation.py sync`
# + commit). Read-only by design — the cron never edits the git-tracked registry, so git
# stays the source of truth; rotation is an explicit operator action.
#
# Mode 0700: the Kuma push URL embeds the monitor token. Pushes through the LAN-only
# Authelia bypass on ^/api/push/ (uptime-kuma.local.<domain> → split-horizon → 10.x).
set -uo pipefail

export SECRET_ROTATION_KUMA="https://uptime-kuma.local.{{ domain }}/api/push/{{ secret_rotation_push_token }}"
KUMA_HOST="uptime-kuma.local.{{ domain }}"
KUMA_RESOLVE_IP="{{ k3s_metallb_ingress_vip }}"

# shellcheck source=/dev/null
source /usr/local/lib/kuma-push-lib.sh || {
  logger -t secret-rotation-audit "kuma-push-lib.sh missing — run initial_setup on this host"
  exit 1
}

cd /home/{{ sys_user }}/server || exit 1

# A prior weekly secret-rotate that failed to COMMIT (tree left dirty) or to PUSH (local ahead of
# origin) leaves real un-actioned rotation state — but it shares THIS "Secret Rotation" monitor, so
# the normal audit below would push UP and mask secret-rotate's own DOWN within ~23h (2026-07-15
# review L4). Short-circuit to a sticky DOWN here instead — this is the only durable signal once the
# weekly page ages out. (rotate/pull failures REVERT to a clean tree and are legitimately transient,
# so they don't trip this.)
TRACKED=(ansible/vars/secrets.yml ansible/secret_rotation.yml)
if [ -n "$(git status --porcelain "${TRACKED[@]}" 2>/dev/null)" ]; then
  reason="secret-rotate left uncommitted changes in secrets.yml/registry — commit by hand"
# Scope the unpushed check to TRACKED (mirroring the dirty check above): an operator's
# fix-forward-local commit that doesn't touch secrets.yml/registry shouldn't flip the Secret
# Rotation monitor DOWN with a rotation-blaming message — only a genuinely unpushed rotation
# commit should (2026-07-15 review L3).
elif [ "$(git rev-list --count '@{u}..HEAD' -- "${TRACKED[@]}" 2>/dev/null || echo 0)" != 0 ]; then
  reason="a local rotation commit touching secrets.yml/registry is unpushed (secret-rotate push failed?) — push by hand"
fi
if [ -n "${reason:-}" ]; then
  # kuma_push, not an inline curl: the URL embeds the push token, and an argv element is
  # readable through /proc/<pid>/cmdline, which is not hidepid-protected here. 0700 on the
  # rendered script closed the on-disk half; this closes the argv half (2026-08-25 M-9).
  kuma_push down "$reason" "$SECRET_ROTATION_KUMA" "$KUMA_HOST" "$KUMA_RESOLVE_IP" \
    secret-rotation-audit
  # `status=down` prefix, not a bare reason: `probe.py alerts` and the Alert History board
  # reconstruct DOWN episodes for host-cron pushers by matching that token in syslog, since a
  # push straight to Kuma leaves no other durable record (Kuma keeps current state only). A bare
  # reason pushed a real DOWN that no consumer could ever replay (2026-08-22 review M3).
  logger -t secret-rotation-audit "status=down $reason"
  exit 0
fi

# Third fault, and the only one with NO local evidence: a `secret-rotate/*` branch on origin
# whose PR was never created. `gh pr create` runs after `git push`, and the publish block then
# resets the local tree clean — so a create failure leaves a live rotated credential with a
# clean tree, an unrotated registry, and nothing in `git log` on HEAD. Both arms above read
# purely local state and miss it by construction (2026-08-25 review H-1).
#
# ADDITIVE, not a short-circuit: unlike a dirty tree or an unpushed commit, a stray branch says
# nothing about whether the OTHER secrets are overdue, so this arm forces DOWN through the
# auditor rather than exiting ahead of it.
#
# Age it out of the branch NAME, which secret-rotate builds as `secret-rotate/%Y-%m-%d-%H%M`.
# `ls-remote` returns a SHA and no date, and asking the API for one needs a network round trip
# this cron does not otherwise make. A branch that does not match the pattern parses to no date
# and is reported immediately — a hand-created branch under this prefix does need a human.
#
# The floor keeps a legitimately-pending rotation PR from flipping the monitor DOWN while its
# CI runs, and 6h is chosen against the two crontab entries rather than picked round: rotate is
# Sunday 09:00 and this audit is daily at 08:00 (crons.yml), so the FIRST audit after a failed
# publish is 23h later. A 24h floor would have let that one push UP — the operator's Monday
# morning look would read green, and the DOWN this arm exists to make sticky would not appear
# until Tuesday. 6h puts that first audit well inside the reporting band while still leaving
# an auto-merge (one prek run, minutes) far short of it.
EXTRA_DOWN=""

# The `gh` OAuth token both publishing crons authenticate with. It is not in secrets.yml and
# not in the rotation registry -- deliberately, since a hand-added registry entry for a
# non-SOPS credential permanently fails CI (registry_drift -> cmd_audit exit 1 -> prek) -- so
# nothing watched it at all. If it is revoked or expires, secret-rotate and docs-refresh both
# keep running and both silently stop publishing: they push a branch, fail at `gh pr create`,
# and the rotation half is exactly the H-1 state above (2026-08-25 review M-6).
#
# Gate on the EXIT STATUS only. A network timeout prints a failure line and still exits 0
# (observed 2026-08-25), so exit status is the conservative signal: it moves only on a real
# auth failure, which is the one that needs a human. Scope drift is NOT checked here -- that
# needs a scoped PAT to replace this token first, which is an operator action.
if ! gh auth status >/dev/null 2>&1; then
  EXTRA_DOWN="the gh CLI token is not authenticated — secret-rotate and docs-refresh can still commit but cannot open a PR, so both stop publishing silently; re-run \`gh auth login\`"
  logger -t secret-rotation-audit "status=down $EXTRA_DOWN"
fi

if [ -z "$EXTRA_DOWN" ] \
   && STALE_HEADS="$(git ls-remote --heads origin 'secret-rotate/*' 2>/dev/null)" \
   && [ -n "$STALE_HEADS" ]; then
  STALE_BRANCH="$(printf '%s\n' "$STALE_HEADS" | head -1 | sed 's|.*refs/heads/||')"
  STAMP="${STALE_BRANCH#secret-rotate/}"
  BRANCH_EPOCH="$(date -u -d "${STAMP:0:10} ${STAMP:11:2}:${STAMP:13:2}" +%s 2>/dev/null || echo 0)"
  if [ "$BRANCH_EPOCH" -eq 0 ] || [ $(( $(date -u +%s) - BRANCH_EPOCH )) -gt 21600 ]; then
    EXTRA_DOWN="unlanded rotation branch $STALE_BRANCH is on origin >6h — a rotated credential may be live but unpublished; check for a missing PR"
    logger -t secret-rotation-audit "status=down $EXTRA_DOWN"
  fi
fi

# uv (absolute path — cron's PATH lacks it) syncs the pinned env, then runs the auditor.
# --frozen: never rewrite uv.lock on the host — a rewrite would dirty the tree (this daily audit
# has no clean-tree guard) and wedge the GitOps deployer's dirty-skip.
UV=/home/{{ sys_user }}/.local/bin/uv
if [ -n "$EXTRA_DOWN" ]; then
  exec $UV run --frozen python scripts/secret_rotation.py audit --push --extra-down "$EXTRA_DOWN"
fi
exec $UV run --frozen python scripts/secret_rotation.py audit --push
