#!/usr/bin/env bash
# Pi container-recovery heartbeat — managed by Ansible (optimize_pi role); edits overwritten.
#
# AutoKuma only reads the SERVER's docker socket, so the Pi's containers have no liveness
# monitor of their own. autoheal (restarts unhealthy containers) and docker-proxy (read-only
# socket serving Alloy's container-log discovery and glances) die silently: if autoheal dies,
# unhealthy Pi containers stop self-recovering; if docker-proxy dies, Alloy's docker_sd finds
# no targets and this host's container logs stop reaching Loki, while glances keeps serving
# its own HTTP and Alloy keeps running with zero targets. Kuma sees wg-easy and glances from
# outside; docker-proxy-lifecycle it does not. This cron watches EVERY container the host
# deploys (containers_list, plus the docker-proxy role's sub-proxies, which are services
# inside its compose file rather than list entries) and pushes `up` only while all of them
# run, to the static "Daniel Pi Recovery" Kuma push monitor (uptime-kuma role), every 5 min.
# Dead-man's-switch: an explicit `down` names the dead container fast, while a dead cron/host
# stops pushing and trips the monitor's 600s heartbeat watchdog. Route + auth are the
# SD-health heartbeat's: Traefik's .local router resolved straight to the server LAN IP,
# Authelia bypasses ^/api/push/ on this host LAN-only — the URL token is the credential.
set -uo pipefail

# shellcheck source=/dev/null
source /usr/local/lib/kuma-push-lib.sh || {
  logger -t pi-recovery-health "kuma-push-lib.sh missing — run initial_setup on this host"
  exit 1
}

{# `domain` is the SOPS-loaded server domain (same reasoning as pi-sd-health.sh.j2). #}
KUMA_HOST="uptime-kuma.local.{{ domain }}"
# Pinned to the cluster ingress VIP: Kuma serves from the k8s edge, and the Docker
# edge's bridge route for this name was removed in the slice-7 bridge teardown.
KUMA_RESOLVE_IP="{{ k3s_metallb_ingress_vip }}"
PUSH_URL="https://${KUMA_HOST}/api/push/{{ pi_recovery_push_token }}"

{# The watch set is DERIVED, not listed: every containers_list entry this host deploys, plus
    the sub-proxies the docker-proxy role's compose file declares beside its list entry
    (docker-proxy-lifecycle always; docker-proxy-codeserver only under has_code_server, the
    same gate the compose template uses). A blanket `docker ps -a --filter status=exited`
    would catch those for free and also resurrect a container an operator `docker stop`ped
    on purpose, every 5 minutes — `restart: unless-stopped` leaves those alone, and so does
    this. Until #1910 the set was hardcoded to autoheal + docker-proxy, so glances, wg-easy
    and docker-proxy-lifecycle sat Exited/RestartCount 0 after a failed start until a human
    noticed. #}
{% set _names = containers_list | map(attribute='name') | list %}
{% if 'docker-proxy' in _names %}
{%   set _names = _names + ['docker-proxy-lifecycle'] %}
{%   if has_code_server | default(false) %}
{%     set _names = _names + ['docker-proxy-codeserver'] %}
{%   endif %}
{% endif %}
CONTAINERS=({{ _names | join(' ') }})

DOWN=""
RECOVERED=""
FAILED=""
for c in "${CONTAINERS[@]}"; do
  # `docker ps` reads the REAL docker socket via the docker group (not docker-proxy), so it
  # still reports docker-proxy's own state when docker-proxy is the container that's down.
  # `-q` + name/status filters print only IDs — no Go-template `--format` needed here.
  if [ -n "$(docker ps -q --filter "name=^${c}$" --filter status=running)" ]; then
    continue
  fi

  # RECORD WHY before touching it. `docker inspect` state is per container lifetime: the
  # `docker start` below (or the next deploy's recreate) erases the exit code, the daemon's
  # `Error` string and `FinishedAt` of the instance that died, the Pi's journal rotates in
  # about a day (SystemMaxUse=32M), and this cron's own line is the only record that reaches
  # Loki. Diagnosing #1789 fourteen days on was impossible for exactly that reason (#1912).
  # Go-template braces are Jinja syntax, hence the raw block. `Error` is free text from the
  # OCI runtime and may span lines; the health.log parser reads ONE line per record, so it is
  # flattened and capped before it joins the message.
  WHY="$(docker inspect --format '{% raw %}status={{.State.Status}} exit={{.State.ExitCode}} finished={{.State.FinishedAt}} error={{.State.Error}}{% endraw %}' "$c" 2>/dev/null |
    tr '\n' ' ' | cut -c1-300)"
  [ -z "$WHY" ] && WHY="inspect failed"
  DOWN="${DOWN:+$DOWN, }${c} [${WHY% }]"

  # ATTEMPT RECOVERY, because nothing else will. `restart: unless-stopped` covers a container
  # whose PROCESS exits; it does not cover one whose `create` fails at the OCI runtime, and
  # that is the failure this host actually produces under memory pressure — on 2026-08-29
  # autoheal died with "unable to start unit ... Timeout waiting for systemd to create scope"
  # and sat there with RestartCount 0 until a human ran `docker start`. Detection worked that
  # day; the 50-minute outage was the missing remediation. One `docker start` from the cron
  # that already runs every 5 minutes and already reads this state closes the loop with no
  # new process on a box that cannot spare one.
  if docker start "$c" >/dev/null 2>&1 &&
    [ -n "$(docker ps -q --filter "name=^${c}$" --filter status=running)" ]; then
    RECOVERED="${RECOVERED:+$RECOVERED, }$c"
  else
    FAILED="${FAILED:+$FAILED, }$c"
  fi
done

# WHEN THE DAEMON ITSELF IS THE FAILURE, name it from its own journal. `inspect failed` is
# what every container reads while dockerd is down, restarting, or wedged — the 2026-09-13
# boot's "Timeout waiting for systemd to create scope", an OOM kill, a restart loop — and the
# inspect above cannot say why, because the daemon that would answer is the thing that is
# gone. The reason sits in `journalctl -u docker`, which SystemMaxUse=32M on the RAM-backed
# /var/log rotates away in about a day; this line is the only copy that reaches Loki (the
# Pi ships no journal — see roles/containers/alloy/CLAUDE.md for the RSS measurement that
# decided against a journal reader, #1922). The newest five lines of the last ten minutes
# that are not dockerd's own info/debug chatter — its `level=warning`/`error` lines and
# systemd's own unit lines ("Main process exited", "Scheduled restart job"), which carry no
# `level=` at all. NOT `journalctl -p warning`: dockerd writes to stderr, so every line sits
# at journal PRIORITY 6 whatever its `level=` says (measured 2026-09-17), and a priority
# filter returns nothing. The `Security options with ':'` deprecation warning goes too: dockerd
# emits one per container create (every compose file here writes `no-new-privileges:true`),
# and over a 48h window it was the ONLY non-info line, so it would crowd out the five kept.
# dockerd's own `time="…"` prefix is dropped as redundant with the record's timestamp; the
# rest is flattened and capped like `Error` above so the record stays one line. The cron
# user reads the journal through the `adm` group; no privilege.
#
# The gate asks the DAEMON, not a container: `docker version` is one /version round trip,
# and a daemon that answers it now was up for the loop above. One `inspect failed` alone is
# not evidence against the daemon — a container mid-recreate under a deploy reads the same
# way for a few seconds while every other container answers — so a single entry would blame
# dockerd for a recreate. The second arm covers a daemon that died during the loop and was
# back by the time this ran: with dockerd gone every watched container reads `inspect
# failed`, and nothing else makes all of them read it at once. The count is rendered rather
# than read off the bash array: the array-length syntax starts with the two characters that
# open a Jinja comment, and the template stops rendering there.
DAEMON=""
if ! docker version --format '{% raw %}{{.Server.Version}}{% endraw %}' >/dev/null 2>&1 ||
  [ "$(grep -o 'inspect failed' <<<"$DOWN" | wc -l)" -eq {{ _names | length }} ]; then
  DAEMON="$(journalctl -u docker --since -10min -n 40 -o cat --no-pager 2>/dev/null |
    grep -vE 'level=(info|debug)|Security options with' | tail -n 5 | sed -E 's/^time="[^"]*" //' |
    tr '\n' ' ' | cut -c1-400)"
fi

if [ -z "$DOWN" ]; then
  STATUS=up;   MSG="all {{ _names | length }} containers running"
else
  # DECIDED: STATUS stays `down` even when the restart worked. Pushing `up` after a
  # successful recovery would make an auto-restart loop invisible: a container crashing every
  # 5 minutes would read green forever, which is the failure mode that makes self-healing
  # worse than no healing. One DOWN beat per cycle that needed intervention keeps the episode
  # in Kuma and in the alert history, and the next clean cycle clears it.
  # Re-proposed by #1784 as "an UP with a warning would read more honestly", after two
  # single-cycle `not running: autoheal; restarted: autoheal` episodes on 2026-09-02/03, and
  # declined 2026-09-11: those two episodes ARE the loop this rule exists to keep visible, and
  # no evidence was offered against the original reasoning. The recurring fault worth fixing is
  # that autoheal stops at all, filed separately.
  STATUS=down; MSG="not running: ${DOWN}"
  [ -n "$RECOVERED" ] && MSG="${MSG}; restarted: ${RECOVERED}"
  [ -n "$FAILED" ] && MSG="${MSG}; restart FAILED: ${FAILED}"
  [ -n "$DAEMON" ] && MSG="${MSG}; dockerd: ${DAEMON% }"
fi

kuma_push "$STATUS" "$MSG" "$PUSH_URL" "$KUMA_HOST" "$KUMA_RESOLVE_IP" pi-recovery-health

# Durable record of this cycle, so `probe.py alerts` can reconstruct the episode.
#
# Kuma keeps only CURRENT state, so a DOWN that clears is gone. The server's health crons
# survive that by logging their own verdict unconditionally (longhorn-backup-health,
# manifest-prune-check), and `probe_lib/alerts.py` reconstructs episodes from those lines.
# `kuma_push` calls `logger` ONLY when the push itself fails, so this cron recorded nothing
# for a successful DOWN push — which is why the real 2026-08-29 autoheal outage read as "no
# DOWN alerts in the last 7d" while the monitor was live-DOWN.
#
# It goes to a FILE rather than to `logger`, because daniel-pi ships no journal: rsyslog is
# masked here on purpose (see the debloat section of this role's tasks — journald is the log
# of record, and a second text logger would write into the RAM-backed /var/log), and the
# Pi's promtail scrapes only container logs. `logger` would reach the local journal and stop.
# The Pi's promtail tails this path under `job="syslog"` instead, matching the label the
# server's own syslog stream carries so one parser reads both estates.
#
# The LINE SHAPE is load-bearing: `_SYSLOG_LINE_RE` wants exactly two whitespace-free tokens
# before the tag. `date -Is` is one token; traditional syslog format ("Aug 29 19:12:26 host")
# is four and does not parse. `status=up` lines are shipped too and the parser ignores them —
# they are the heartbeat that distinguishes "nothing wrong" from "nothing shipping".
HEALTH_LOG="/var/log/pi-health/health.log"
mkdir -p "${HEALTH_LOG%/*}" 2>/dev/null || true
if [ "${KUMA_PUSH_OK:-1}" = "1" ]; then
  DETAIL="status=${STATUS} ${MSG}"
else
  DETAIL="push failed (status=${STATUS}: ${MSG})"
fi
printf '%s %s %s: %s\n' "$(date -Is)" "$(hostname)" pi-recovery-health "$DETAIL" >>"$HEALTH_LOG"
