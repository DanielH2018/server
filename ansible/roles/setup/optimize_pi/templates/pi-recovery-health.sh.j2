#!/usr/bin/env bash
# Pi container-recovery heartbeat — managed by Ansible (optimize_pi role); edits overwritten.
#
# AutoKuma only reads the SERVER's docker socket, so the Pi's own autoheal (restarts
# unhealthy containers) and docker-proxy (read-only socket that dozzle's log UI reads) have
# no liveness monitor: if autoheal dies, unhealthy Pi containers stop self-recovering; if
# docker-proxy dies, dozzle still serves 200 (its SPA shell) so its http monitor stays green.
# Both deaths are otherwise silent. This cron pushes `up` only while BOTH run, to the static
# "Daniel Pi Recovery" Kuma push monitor (uptime-kuma role), every 5 min. Dead-man's-switch:
# an explicit `down` names the dead container fast, while a dead cron/host stops pushing and
# trips the monitor's 600s heartbeat watchdog. Route + auth are the SD-health heartbeat's:
# Traefik's .local router resolved straight to the server LAN IP, Authelia bypasses ^/api/push/
# on this host LAN-only — the URL token is the credential.
set -uo pipefail

# shellcheck source=/dev/null
source /usr/local/lib/kuma-push-lib.sh || {
  logger -t pi-recovery-health "kuma-push-lib.sh missing — run initial_setup on this host"
  exit 1
}

{# `domain` is the SOPS-loaded server domain (same reasoning as pi-sd-health.sh.j2). #}
KUMA_HOST="uptime-kuma.local.{{ domain }}"
# Pinned to the cluster ingress VIP: Kuma serves from the k8s edge, and the Docker
# edge's bridge route for this name was removed in the slice-7 bridge teardown.
KUMA_RESOLVE_IP="{{ k3s_metallb_ingress_vip }}"
PUSH_URL="https://${KUMA_HOST}/api/push/{{ pi_recovery_push_token }}"

DOWN=""
RECOVERED=""
FAILED=""
for c in autoheal docker-proxy; do
  # `docker ps` reads the REAL docker socket via the docker group (not docker-proxy), so it
  # still reports docker-proxy's own state when docker-proxy is the container that's down.
  # `-q` + name/status filters print only IDs — no Go-template `--format` for Jinja to choke on.
  if [ -n "$(docker ps -q --filter "name=^${c}$" --filter status=running)" ]; then
    continue
  fi
  DOWN="${DOWN:+$DOWN, }$c"

  # ATTEMPT RECOVERY, because nothing else will. `restart: unless-stopped` covers a container
  # whose PROCESS exits; it does not cover one whose `create` fails at the OCI runtime, and
  # that is the failure this host actually produces under memory pressure — on 2026-08-29
  # autoheal died with "unable to start unit ... Timeout waiting for systemd to create scope"
  # and sat there with RestartCount 0 until a human ran `docker start`. Detection worked that
  # day; the 50-minute outage was the missing remediation. One `docker start` from the cron
  # that already runs every 5 minutes and already reads this state closes the loop with no
  # new process on a box that cannot spare one.
  if docker start "$c" >/dev/null 2>&1 &&
    [ -n "$(docker ps -q --filter "name=^${c}$" --filter status=running)" ]; then
    RECOVERED="${RECOVERED:+$RECOVERED, }$c"
  else
    FAILED="${FAILED:+$FAILED, }$c"
  fi
done

if [ -z "$DOWN" ]; then
  STATUS=up;   MSG="autoheal + docker-proxy running"
else
  # STATUS stays `down` even when the restart worked, deliberately. Pushing `up` after a
  # successful recovery would make an auto-restart loop invisible: a container crashing every
  # 5 minutes would read green forever, which is the failure mode that makes self-healing
  # worse than no healing. One DOWN beat per cycle that needed intervention keeps the episode
  # in Kuma and in the alert history, and the next clean cycle clears it.
  STATUS=down; MSG="not running: ${DOWN}"
  [ -n "$RECOVERED" ] && MSG="${MSG}; restarted: ${RECOVERED}"
  [ -n "$FAILED" ] && MSG="${MSG}; restart FAILED: ${FAILED}"
fi

kuma_push "$STATUS" "$MSG" "$PUSH_URL" "$KUMA_HOST" "$KUMA_RESOLVE_IP" pi-recovery-health

# Durable record of this cycle, so `probe.py alerts` can reconstruct the episode.
#
# Kuma keeps only CURRENT state, so a DOWN that clears is gone. The server's health crons
# survive that by logging their own verdict unconditionally (longhorn-backup-health,
# manifest-prune-check), and `probe_alerts.py` reconstructs episodes from those lines.
# `kuma_push` calls `logger` ONLY when the push itself fails, so this cron recorded nothing
# for a successful DOWN push — which is why the real 2026-08-29 autoheal outage read as "no
# DOWN alerts in the last 7d" while the monitor was live-DOWN.
#
# It goes to a FILE rather than to `logger`, because daniel-pi ships no journal: rsyslog is
# masked here on purpose (see the debloat section of this role's tasks — journald is the log
# of record, and a second text logger would write into the RAM-backed /var/log), and the
# Pi's promtail scrapes only container logs. `logger` would reach the local journal and stop.
# The Pi's promtail tails this path under `job="syslog"` instead, matching the label the
# server's own syslog stream carries so one parser reads both estates.
#
# The LINE SHAPE is load-bearing: `_SYSLOG_LINE_RE` wants exactly two whitespace-free tokens
# before the tag. `date -Is` is one token; traditional syslog format ("Aug 29 19:12:26 host")
# is four and does not parse. `status=up` lines are shipped too and the parser ignores them —
# they are the heartbeat that distinguishes "nothing wrong" from "nothing shipping".
HEALTH_LOG="/var/log/pi-health/health.log"
mkdir -p "${HEALTH_LOG%/*}" 2>/dev/null || true
if [ "${KUMA_PUSH_OK:-1}" = "1" ]; then
  DETAIL="status=${STATUS} ${MSG}"
else
  DETAIL="push failed (status=${STATUS}: ${MSG})"
fi
printf '%s %s %s: %s\n' "$(date -Is)" "$(hostname)" pi-recovery-health "$DETAIL" >>"$HEALTH_LOG"
