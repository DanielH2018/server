# Ansible-managed (setup/optimize_pi, tasks/main.yml). Do not edit by hand.
# Route this host's DNS to the cluster Pi-hole, with a public resolver behind it.
#
# Why: every `*.local.{{ domain }}` name the Pi resolves is answered by the public
# Cloudflare wildcard today, because the DHCP lease hands this host the ISP's resolvers
# (75.75.75.75 and friends). Those are internal hostnames and they do not belong in an
# ISP query log. `Domains=~.` sends every query to the servers below instead, overriding
# the per-link lease servers without editing netplan.
#
# Blast radius: Docker's embedded resolver forwards to this host's stub — a container's
# /etc/resolv.conf reads `ExtServers: [host(127.0.0.53)]` — so all seven Pi containers
# follow this file too. promtail's push URL (loki-homelab.local.{{ domain }}) is the one
# that matters; it resolves through Pi-hole after this change.
#
# The second entry is a real failover, not decoration: systemd-resolved moves to it when
# the first stops answering. It is NOT the 2-second cutover daniel-server gets, which
# comes from glibc's `timeout:2 attempts:1` in a static resolv.conf. resolved retries a
# server over several seconds and then caches its choice, so a Pi-hole outage costs this
# host slow lookups before it settles on the fallback. Accepted, because the ordering is
# what matters: the Pi is the break-glass host and its wg-easy tunnel is the documented
# way in when the cluster is unreachable (roles/containers/wg-easy/CLAUDE.md), so it must
# never DEPEND on the cluster for DNS — only prefer it.
[Resolve]
DNS={{ optimize_pi_dns_servers | join(' ') }}
Domains=~.
