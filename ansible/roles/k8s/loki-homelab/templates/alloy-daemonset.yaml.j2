{% from 'container-resources.yml.j2' import container_resources with context %}
---
# KL3: the cluster pod-log shipper, Grafana Alloy since 2026-09-02 (Promtail reached end of
# life on 2026-03-02). A DaemonSet (not a Deployment) so a joining node adds its own pod and
# host logs automatically. The config it runs is templates/config/config.alloy.j2.
#
# This is NOT the only shipper: daniel-pi runs its own Docker copy
# (roles/containers/promtail/) and pushes over the LAN through ingressroute-push.yaml.j2.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: alloy
  namespace: {{ k8s_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: alloy
rules:
  - apiGroups: [""]
    resources: [pods]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: alloy
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: alloy
subjects:
  - kind: ServiceAccount
    name: alloy
    namespace: {{ k8s_namespace }}
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: alloy
  namespace: {{ k8s_namespace }}
spec:
  selector:
    matchLabels:
      app: alloy
  template:
    metadata:
      labels:
        # `app: alloy` is what netpol-baseline's loki-homelab policy admits and what the
        # claude-otel Prometheus job keeps — both move with this label.
        app: alloy
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      serviceAccountName: alloy
      priorityClassName: homelab-best-effort
      containers:
        - name: alloy
          image: {{ loki_homelab_alloy_image }}
          args:
            - run
            - /etc/alloy/config.alloy
            # Alloy binds 127.0.0.1 by default; the probes and the Prometheus scrape need the
            # pod IP.
            - --server.http.listen-addr=0.0.0.0:12345
            # The tailing cursor lives here — see the positions volume below.
            - --storage.path=/var/lib/alloy/data
            # Same reason Loki's config sets analytics.reporting_enabled false: Pi-hole blocks
            # stats.grafana.org and each report would spend its retry budget on a name that
            # never resolves.
            - --disable-reporting
          env:
            # The node name, for the `machine` label and the discovery field selector. A pod's
            # own HOSTNAME is the POD name, which would label every stream with a value that
            # changes on every restart and match no node in the selector.
            - name: HOSTNAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          ports:
            - name: http-metrics
              containerPort: 12345
          readinessProbe:
            httpGet:
              path: /-/ready
              port: http-metrics
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /-/ready
              port: http-metrics
            # A generous cold-start budget rather than Loki's tight 60s/30s: the shipper's
            # readiness waits on discovery, which is slower and less predictable than a store's.
            initialDelaySeconds: 60
            periodSeconds: 30
            failureThreshold: 10
          securityContext:
            runAsUser: 0
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
              add:
                # syslog/auth.log are owned by the `syslog` user (640), so root WITHOUT
                # this cannot read them — the recurring root-without-DAC lesson, read-only
                # variant. Same cap the Docker shipper on the Pi carries for the same files.
                - DAC_READ_SEARCH
          volumeMounts:
            - name: alloy-config
              mountPath: /etc/alloy
            - name: alloy-varlog
              mountPath: /var/log
              readOnly: true
            # The tailing cursor — losing it re-reads every log from the start, which is
            # what the Loki ingest limits guard against.
            - name: alloy-positions
              mountPath: /var/lib/alloy/data
{% if k3s_audit_log_enabled | default(false) %}
            # The apiserver audit log, mounted at its real host path so the config's path
            # needs no translation. Read-only: nothing here should ever write to the control
            # plane's data directory.
            - name: k8s-audit
              mountPath: {{ k3s_audit_log_dir }}
              readOnly: true
{% endif %}
          # 1 core, not 250m: a shipper's work arrives in bursts as log lines do, and a quota
          # clipped them for no benefit on a node running ~1.5 of 24 cores. Throttled seconds
          # measured 0.0076/s on 2026-08-29 — small, but the ceiling bought nothing against
          # it. The request (50m) is what reserves capacity under contention and is unchanged.
{{ container_resources(cpu_limit='1', mem_limit='256Mi', cpu_request='50m', mem_request='64Mi') }}
      volumes:
        - name: alloy-config
          configMap:
            name: loki-homelab-config
            items:
              - key: config.alloy
                path: config.alloy
        - name: alloy-varlog
          hostPath:
            path: /var/log
        - name: alloy-positions
          hostPath:
            # A new path, not the Promtail one: Alloy cannot read positions.yaml, and sharing
            # the directory would leave a stale file beside the live cursor forever.
            path: /var/lib/alloy-positions
            type: DirectoryOrCreate
{% if k3s_audit_log_enabled | default(false) %}
        - name: k8s-audit
          hostPath:
            path: {{ k3s_audit_log_dir }}
            # DirectoryOrCreate, not Directory: this DaemonSet also lands on daniel-server,
            # which has no apiserver and therefore no such directory. `Directory` would leave
            # that pod stuck in ContainerCreating, taking the node's syslog and pod tailing
            # down with it — a mount for a file one node does not have must not be able to
            # stop the other logs that pod is responsible for.
            type: DirectoryOrCreate
{% endif %}
