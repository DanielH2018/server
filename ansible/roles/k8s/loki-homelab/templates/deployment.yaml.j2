---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: loki-homelab
  namespace: {{ k8s_namespace }}
spec:
  replicas: 1
  # RWO PVC on single-replica Longhorn — a rolling update deadlocks on the volume.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: loki-homelab
  template:
    metadata:
      labels:
        app: loki-homelab
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      securityContext:
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
      automountServiceAccountToken: false
      priorityClassName: homelab-best-effort
      # Preference, never a pin: daniel-box carries the storage- and VIP-pinned workloads and runs the hotter of the two nodes, so latency-insensitive services default here.
      # Weighted so the pod still schedules if daniel-server is cordoned or full.
      affinity:
        nodeAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              preference:
                matchExpressions:
                  - key: kubernetes.io/hostname
                    operator: In
                    values:
                      - daniel-server
      containers:
        - name: loki
          image: {{ loki_homelab_image }}
          args: ["-config.file=/etc/loki/loki.yaml"]
          # No readOnlyRootFilesystem: Loki writes its WAL and compactor scratch outside the
          # /loki mount, and the fleet-standard pair is what actually closes the gap here.
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
          ports:
            - name: http
              containerPort: 3100
          volumeMounts:
            - name: config
              mountPath: /etc/loki
            - name: data
              mountPath: /loki
          readinessProbe:
            httpGet:
              path: /ready
              port: 3100
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /ready
              port: 3100
            initialDelaySeconds: 60
            periodSeconds: 30
          resources:
            limits:
              cpu: "{{ loki_homelab_cpu_limit }}"
              memory: {{ loki_homelab_mem_limit }}
            requests:
              cpu: "{{ loki_homelab_cpu_request }}"
              memory: {{ loki_homelab_mem_request }}
      volumes:
        - name: config
          configMap:
            name: loki-homelab-config
            items:
              - key: loki.yaml
                path: loki.yaml
        - name: data
          persistentVolumeClaim:
            claimName: {{ loki_homelab_claim }}
