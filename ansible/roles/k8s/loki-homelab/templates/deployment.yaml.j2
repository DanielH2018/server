{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: loki-homelab
  namespace: {{ k8s_namespace }}
spec:
  # RWO PVC on single-replica Longhorn — a rolling update deadlocks on the volume.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: loki-homelab
  template:
    metadata:
      labels:
        app: loki-homelab
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-best-effort', run_as_user=10001, run_as_group=10001, fs_group=10001) }}
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: loki
          image: {{ loki_homelab_k8s_image }}
          args: ["-config.file=/etc/loki/loki.yaml"]
          # No readOnlyRootFilesystem: Loki writes its WAL and compactor scratch outside the
          # /loki mount, and the fleet-standard pair is what actually closes the gap here.
{{ hardened_security_context(non_root=true) }}
          ports:
            - name: http
              containerPort: 3100
          volumeMounts:
            - name: loki-homelab-config
              mountPath: /etc/loki
            - name: loki-homelab-data
              mountPath: /loki
            # The ruler's tenant directory (configmap.yaml.j2's ruler block). A whole-directory
            # mount of its own, outside /etc/loki, so the config volume's atomic swap never
            # touches it. Loki skips the mount's `..data` directories and loads each key.
            - name: loki-homelab-rules
              mountPath: /etc/loki-rules/fake
              readOnly: true
          readinessProbe:
            httpGet:
              path: /ready
              port: 3100
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /ready
              port: 3100
            initialDelaySeconds: 60
            periodSeconds: 30
{{ container_resources(cpu_limit=loki_homelab_cpu_limit, mem_limit=loki_homelab_mem_limit, cpu_request=loki_homelab_cpu_request, mem_request=loki_homelab_mem_request) }}
      volumes:
        - name: loki-homelab-config
          configMap:
            name: loki-homelab-config
            items:
              - key: loki.yaml
                path: loki.yaml
        - name: loki-homelab-rules
          configMap:
            name: loki-homelab-rules
        - name: loki-homelab-data
          persistentVolumeClaim:
            claimName: {{ loki_homelab_claim }}
