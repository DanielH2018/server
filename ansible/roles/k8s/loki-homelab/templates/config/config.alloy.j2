// Grafana Alloy config for the cluster log shipper (KL3). Rendered by Ansible into the
// loki-homelab ConfigMap as `config.alloy` and read by alloy-daemonset.yaml.j2 on both nodes.
//
// The labels this file emits are a contract: monitor-bridge's LogQL selectors, terraria-stats'
// and valheim-stats' `{container="…"}` queries and the `{job="syslog"}` deploy annotation on
// every Grafana dashboard were written against `job`, `container`, `pod`, `namespace`,
// `machine` and `stream` — and against the ABSENCE of `app`, which is how the HA ban check
// went blind on 2026-08-23. The `alloy-emits-the-loki-labels-consumers-select-on` row of
// ansible/tests/k8s/_config_property_rows.py guards the set.
//
// Replaced Promtail on 2026-09-02, six months after Promtail's 2026-03-02 end of life. Three
// things Promtail did implicitly are explicit here: node scoping is a field selector (Alloy
// has no `__host__` filter); the positions cursor lives under --storage.path in Alloy's own
// format (a first start re-tails each current file from offset 0, which Loki dedupes where
// timestamp and line match); and the env lookup is sys.env() rather than -config.expand-env.

logging {
  level = "warn"
}

loki.write "homelab" {
  endpoint {
    url = "http://loki-homelab:3100/loki/api/v1/push"
  }
}

// ---- Cluster pod logs: this node's pods only. ------------------------------------------
// HOSTNAME is the downward-API nodeName (see the DaemonSet). Without the field selector every
// node discovers every pod, tails the other node's /var/log/pods paths, finds nothing there,
// and warns about each missing file on every refresh.
discovery.kubernetes "pods" {
  role = "pod"
  selectors {
    role  = "pod"
    field = "spec.nodeName=" + sys.env("HOSTNAME")
  }
}

discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
  rule {
    target_label = "job"
    replacement  = "{{ loki_streams.cluster_pods.job }}"
  }
  // The node name, mirroring the prometheus origin convention — one config, both nodes.
  rule {
    target_label = "machine"
    replacement  = sys.env("HOSTNAME")
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
    separator     = "/"
    target_label  = "__path__"
    replacement   = "/var/log/pods/*$1/*.log"
  }
}

local.file_match "pods" {
  path_targets = discovery.relabel.pods.output
}

loki.source.file "pods" {
  targets    = local.file_match.pods.targets
  forward_to = [loki.process.pods.receiver]
}

loki.process "pods" {
  forward_to = [loki.write.homelab.receiver]

  // Strip containerd's per-line envelope ("<rfc3339> stdout F <message>") so what lands in
  // Loki is the application's own line. Without it a START-ANCHORED parser keeps matching and
  // captures the envelope as payload: measured 2026-08-13, terraria-stats' join regex turned
  // "Ben" into "2026-08-13T21:14:28.159801911Z stdout F Ben", one new player per join.
  stage.cri {}

  // Drop routine Traefik access lines — ~172 MB/day measured 2026-08-29, of which nothing
  // reads 2xx/3xx out of Loki (every Traefik panel and bridge check is Prometheus-backed).
  //
  // THIS DOES NOT TOUCH CROWDSEC. The crowdsec agent sidecar tails /var/log/traefik/access.log
  // directly; this stage reads the access-log-rotate sidecar's STDOUT copy of the same file,
  // so a drop here is invisible to the WAF. Scoped to that container name and nothing else.
  //
  // 302 is deliberately KEPT — Authelia redirects are the cheapest evidence of an auth loop.
  // The expression pairs a routine status with a sub-second Duration (nanoseconds, at most 9
  // digits); Traefik emits fields alphabetically, which puts DownstreamStatus before Duration.
  //
  // The counter this bumps is loki_process_dropped_lines_total, NOT the
  // loki_write_dropped_entries_total that monitor-bridge's dropped-entries check watches at
  // 1000/hour — a deliberate drop here cannot self-page as shipping loss.
  stage.match {
    selector = "{container=\"access-log-rotate\"}"
    stage.drop {
      expression          = "\"DownstreamStatus\":(200|204|304),.*\"Duration\":[0-9]{1,9},"
      drop_counter_reason = "traefik_routine_access_log"
    }
  }

  // Redact the Google Cast user's refresh_token out of Home Assistant's lines (issue #3015).
  // HA formats the `cast_show_view` signal args into the message whenever a cast fails in
  // `_handle_signal_show_view`, and those args carry the cast system user's refresh_token in
  // plaintext. `homeassistant.util.logging` is not silenced, so the record reaches Loki, where
  // anyone with the LAN route can read a live HA API credential out of a 744h store.
  //
  // This REPLACES, it does not drop: `stage.replace` substitutes only the CAPTURE GROUP, so the
  // rest of the record survives intact. That is load-bearing — `docs/platform.md` tells the
  // operator to query `|= "_handle_signal_show_view"` to catch a cast that timed out on a worker
  // thread, and a stage that ate the marker would break the one detection query that still
  // works. No line is dropped, so no dropped-lines counter moves.
  //
  // The key appears as a Python dict repr (`'refresh_token': '<64 hex>'`); the class also
  // accepts the JSON spelling. The `{32,}` floor keeps `'refresh_token': None` unmatched.
  //
  // Prospective only. Records already in Loki keep the token until the 744h retention window
  // expires, and HA's own `system_log` / `/api/error_log` are upstream of this stage —
  // `probe.py` redacts those on the way out (probe_lib/core.py:redact_log_secrets).
  stage.match {
    selector = "{container=\"home-assistant\"}"
    stage.replace {
      expression = "refresh_token[\"']?: ?[\"']?([0-9a-f]{32,})"
      replace    = "<redacted>"
    }
  }
}

// ---- Host files. Root + DAC_READ_SEARCH in the DaemonSet exist for these. ---------------
// Same job labels on both nodes so monitor-bridge's freshness arm sees them together.
local.file_match "syslog" {
  path_targets = [{"__path__" = "/var/log/syslog", "job" = "{{ loki_streams.host_syslog.job }}", "machine" = sys.env("HOSTNAME")}]
}

loki.source.file "syslog" {
  targets    = local.file_match.syslog.targets
  forward_to = [loki.write.homelab.receiver]
}

local.file_match "authlog" {
  path_targets = [{"__path__" = "/var/log/auth.log", "job" = "{{ loki_streams.host_authlog.job }}", "machine" = sys.env("HOSTNAME")}]
}

loki.source.file "authlog" {
  targets    = local.file_match.authlog.targets
  forward_to = [loki.write.homelab.receiver]
}

{% if k3s_audit_log_enabled | default(false) %}
// The apiserver audit log. Only daniel-box writes one — the file lives under the k3s SERVER
// data directory and the agent node has no apiserver — but the source is declared on both
// because this is a DaemonSet with one config. On daniel-server the path matches nothing.
//
// Tailed off the host rather than read from the pod's own filesystem: the log is written by
// the apiserver, which on k3s is a process inside the k3s server, not a pod.
//
// JSON, one object per line. Left unparsed on purpose — a stage.json here would index every
// audit field as a label and blow past Loki's series limits. Query it with `| json` instead.
local.file_match "k8s_audit" {
  path_targets = [{"__path__" = "{{ k3s_audit_log_path | default('/var/lib/rancher/k3s/server/logs/audit.log') }}", "job" = "{{ loki_streams.k8s_audit.job }}", "machine" = sys.env("HOSTNAME")}]
}

loki.source.file "k8s_audit" {
  targets    = local.file_match.k8s_audit.targets
  forward_to = [loki.write.homelab.receiver]
}
{% endif %}
