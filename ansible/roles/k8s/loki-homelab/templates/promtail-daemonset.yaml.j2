---
# KL3: the cluster pod-log shipper. A DaemonSet (not a Deployment) so the Phase F join adds
# daniel-server's pod logs automatically when it becomes a node.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: promtail
  namespace: {{ k8s_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: promtail
rules:
  - apiGroups: [""]
    resources: [pods]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: promtail
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: promtail
subjects:
  - kind: ServiceAccount
    name: promtail
    namespace: {{ k8s_namespace }}
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: promtail
  namespace: {{ k8s_namespace }}
spec:
  selector:
    matchLabels:
      app: promtail
  template:
    metadata:
      labels:
        app: promtail
        netpol-baseline: enforced
    spec:
      # Unpinned at the drain step (2026-08-14): the Docker promtail retired with it, so
      # this DaemonSet is the only shipper and covers both nodes' host + pod logs.
      enableServiceLinks: false
      serviceAccountName: promtail
      priorityClassName: homelab-best-effort
      containers:
        - name: promtail
          image: {{ loki_homelab_promtail_image }}
          # expand-env resolves ${HOSTNAME} (the downward-API nodeName) in the machine labels.
          args: ["-config.file=/etc/promtail/promtail.yaml", "-config.expand-env=true"]
          env:
            # promtail drops any discovered target whose __host__ label doesn't match its
            # own hostname — which in a pod is the POD name, never the node name the
            # kubernetes_sd relabel writes into __host__. Without this override every
            # pod-log target is silently filtered and {job="k8s"} stays empty.
            - name: HOSTNAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          ports:
            - name: http
              containerPort: 9080
          readinessProbe:
            httpGet:
              path: /ready
              port: 9080
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /ready
              port: 9080
            # promtail's /ready returns 503 until it has discovered targets, which is
            # slower and less predictable than Loki's own readiness — a generous
            # cold-start budget here, not Loki's tight 60s/30s.
            initialDelaySeconds: 60
            periodSeconds: 30
            failureThreshold: 10
          securityContext:
            runAsUser: 0
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
              add:
                # syslog/auth.log are owned by the `syslog` user (640), so root WITHOUT
                # this cannot read them — the recurring root-without-DAC lesson, read-only
                # variant. Same cap the Docker promtail carries for the same files.
                - DAC_READ_SEARCH
          volumeMounts:
            - name: promtail-config
              mountPath: /etc/promtail
            - name: promtail-varlog
              mountPath: /var/log
              readOnly: true
            # The tailing cursor — losing it re-reads every log from the start, which is
            # what the Loki ingest limits guard against (the Docker promtail_positions
            # volume's whole reason to exist).
            - name: promtail-positions
              mountPath: /positions
{% if k3s_audit_log_enabled | default(false) %}
            # The apiserver audit log, mounted at its real host path so the promtail config's
            # __path__ needs no translation. Read-only: nothing here should ever write to the
            # control plane's data directory.
            - name: k8s-audit
              mountPath: {{ k3s_audit_log_dir }}
              readOnly: true
{% endif %}
          resources:
            limits:
              cpu: "250m"
              memory: 256Mi
            requests:
              cpu: "50m"
              memory: 64Mi
      volumes:
        - name: promtail-config
          configMap:
            name: loki-homelab-config
            items:
              - key: promtail.yaml
                path: promtail.yaml
        - name: promtail-varlog
          hostPath:
            path: /var/log
        - name: promtail-positions
          hostPath:
            path: /var/lib/promtail-positions
            type: DirectoryOrCreate
{% if k3s_audit_log_enabled | default(false) %}
        - name: k8s-audit
          hostPath:
            path: {{ k3s_audit_log_dir }}
            # DirectoryOrCreate, not Directory: this DaemonSet also lands on daniel-server,
            # which has no apiserver and therefore no such directory. `Directory` would leave
            # that pod stuck in ContainerCreating, taking the node's syslog and pod tailing
            # down with it — a mount for a file one node does not have must not be able to
            # stop the other logs that pod is responsible for.
            type: DirectoryOrCreate
{% endif %}
