---
# KL3: the cluster pod-log shipper. A DaemonSet (not a Deployment) so the Phase F join adds
# daniel-server's pod logs automatically when it becomes a node.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: promtail
  namespace: {{ k8s_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: promtail
rules:
  - apiGroups: [""]
    resources: [pods]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: promtail
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: promtail
subjects:
  - kind: ServiceAccount
    name: promtail
    namespace: {{ k8s_namespace }}
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: promtail
  namespace: {{ k8s_namespace }}
spec:
  selector:
    matchLabels:
      app: promtail
  template:
    metadata:
      labels:
        app: promtail
    spec:
      enableServiceLinks: false
      serviceAccountName: promtail
      containers:
        - name: promtail
          image: {{ loki_homelab_promtail_image }}
          args: ["-config.file=/etc/promtail/promtail.yaml"]
          env:
            # promtail drops any discovered target whose __host__ label doesn't match its
            # own hostname — which in a pod is the POD name, never the node name the
            # kubernetes_sd relabel writes into __host__. Without this override every
            # pod-log target is silently filtered and {job="k8s"} stays empty.
            - name: HOSTNAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          securityContext:
            runAsUser: 0
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
              add:
                # syslog/auth.log are owned by the `syslog` user (640), so root WITHOUT
                # this cannot read them — the recurring root-without-DAC lesson, read-only
                # variant. Same cap the Docker promtail carries for the same files.
                - DAC_READ_SEARCH
          volumeMounts:
            - name: config
              mountPath: /etc/promtail
            - name: varlog
              mountPath: /var/log
              readOnly: true
            # The tailing cursor — losing it re-reads every log from the start, which is
            # what the Loki ingest limits guard against (the Docker promtail_positions
            # volume's whole reason to exist).
            - name: positions
              mountPath: /positions
          resources:
            limits:
              cpu: "250m"
              memory: 256Mi
            requests:
              cpu: "50m"
              memory: 64Mi
      volumes:
        - name: config
          configMap:
            name: loki-homelab-config
            items:
              - key: promtail.yaml
                path: promtail.yaml
        - name: varlog
          hostPath:
            path: /var/log
        - name: positions
          hostPath:
            path: /var/lib/promtail-positions
            type: DirectoryOrCreate
