---
# KL3: the cluster pod-log shipper. A DaemonSet (not a Deployment) so the Phase F join adds
# daniel-server's pod logs automatically when it becomes a node.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: promtail
  namespace: {{ k8s_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: promtail
rules:
  - apiGroups: [""]
    resources: [pods]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: promtail
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: promtail
subjects:
  - kind: ServiceAccount
    name: promtail
    namespace: {{ k8s_namespace }}
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: promtail
  namespace: {{ k8s_namespace }}
spec:
  selector:
    matchLabels:
      app: promtail
  template:
    metadata:
      labels:
        app: promtail
    spec:
      enableServiceLinks: false
      serviceAccountName: promtail
      containers:
        - name: promtail
          image: {{ loki_homelab_promtail_image }}
          args: ["-config.file=/etc/promtail/promtail.yaml"]
          securityContext:
            # Root because the tailed files are root-owned (pod logs 640, auth.log
            # root:adm) — owner-read suffices, so every capability still drops.
            runAsUser: 0
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - name: config
              mountPath: /etc/promtail
            - name: varlog
              mountPath: /var/log
              readOnly: true
            # The tailing cursor — losing it re-reads every log from the start, which is
            # what the Loki ingest limits guard against (the Docker promtail_positions
            # volume's whole reason to exist).
            - name: positions
              mountPath: /positions
          resources:
            limits:
              cpu: "250m"
              memory: 256Mi
            requests:
              cpu: "50m"
              memory: 64Mi
      volumes:
        - name: config
          configMap:
            name: loki-homelab-config
            items:
              - key: promtail.yaml
                path: promtail.yaml
        - name: varlog
          hostPath:
            path: /var/log
        - name: positions
          hostPath:
            path: /var/lib/promtail-positions
            type: DirectoryOrCreate
