---
# Rendered through the manifests role's SECRET list (0600 + no_log).
#
# A Secret, not a ConfigMap, because alertmanager.yml carries `email`, which is a SOPS key. The
# three credentials ride beside it as their own keys, and the config reads each through a
# `*_file` field. That keeps them out of the config text, and it lets the offline validator's
# `STUB` stand in for each one: a webhook URL rendered as `STUB` would fail Alertmanager's URL
# parsing, while a file path is only read when a notification is sent.
#
# EVERY GO TEMPLATE EXPRESSION SITS INSIDE A JINJA RAW BLOCK. Jinja refuses the two forms used
# below as syntax errors, and any Go expression it could parse it would consume.
# scripts/validate/alert_rules.py checks that each reference this file holds survives the
# render. The Go templates themselves live in files/alertmanager/homelab.tmpl, which
# lookup('file') carries in without templating it.
{#
  The weekly-reboot mute, derived from the reboot cron's own variables in group_vars/all.yml,
  the same ones uptime-kuma's maintenance window reads; never a second copy of the schedule.
  It opens the lead before the cron fires and closes after the shutdown delay and the recovery
  allowance, counted in minutes from Sunday 00:00. Alertmanager's `times` cannot cross
  midnight (`end_time` stops at 24:00), so a window that does is split into one entry per day.
  ansible/tests/services/test_alertmanager_reboot_mute.py holds it equal to Kuma's window.
#}
{% set reboot_mute = namespace(entries=[]) %}
{% set mute_opens = (weekly_reboot_weekday | int) * 1440 + (weekly_reboot_hour | int) * 60 + (weekly_reboot_minute | int) - (weekly_reboot_mute_lead_minutes | int) %}
{% set mute_closes = mute_opens + (weekly_reboot_mute_lead_minutes | int) + (weekly_reboot_shutdown_delay_minutes | int) + (weekly_reboot_mute_recovery_minutes | int) %}
{% for day in range(mute_opens // 1440, (mute_closes - 1) // 1440 + 1) %}
{%   set starts = [mute_opens, day * 1440] | max - day * 1440 %}
{%   set ends = [mute_closes, (day + 1) * 1440] | min - day * 1440 %}
{%   set reboot_mute.entries = reboot_mute.entries + [{
       "weekday": ["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"][day % 7],
       "start_time": "%02d:%02d" | format(starts // 60, starts % 60),
       "end_time": "%02d:%02d" | format(ends // 60, ends % 60),
     }] %}
{% endfor %}
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-config
  namespace: {{ k8s_observability_namespace }}
type: Opaque
stringData:
  alertmanager.yml: |
    # restart_secrets names this file (alertmanager-secret.yaml) for Alertmanager alone, so an
    # edit here restarts Alertmanager and neither Prometheus nor Grafana.
    global:
      resolve_timeout: 5m
      # Gmail on 465, Kuma's account (uptime-kuma's static-monitors.yaml.j2, email.json). Port
      # 465 is implicit TLS, which Alertmanager picks from the port alone.
      smtp_smarthost: smtp.gmail.com:465
      smtp_from: "{{ email }}"
      smtp_auth_username: "{{ email }}"
      smtp_auth_password_file: /etc/alertmanager/smtp-password
    # Relative to this file, so it resolves both in the pod and beside the rendered copy amtool
    # checks in CI.
    templates:
      - homelab.tmpl
    # The weekly reboot takes workloads down, so the routes that page carry this mute, as Kuma's
    # maintenance window does for its tiles. The Watchdog route never does.
    time_intervals:
      - name: weekly-reboot
        time_intervals:
{% for entry in reboot_mute.entries %}
          - weekdays: [{{ entry.weekday }}]
            times:
              - start_time: "{{ entry.start_time }}"
                end_time: "{{ entry.end_time }}"
            location: {{ weekly_reboot_timezone }}
{% endfor %}
    route:
      receiver: discord
      group_by: [alertname, service]
      group_wait: 30s
      group_interval: 5m
      # Kuma resends a DOWN tile every 90 beats, which is 6h for a bridge tile.
      repeat_interval: 6h
      routes:
        # First, and never under a mute interval, so no maintenance window can silence the
        # off-site watcher.
        - matchers: ['alertname="Watchdog"']
          receiver: healthchecks
          group_wait: 0s
          group_interval: 1m
          repeat_interval: {{ observability_alertmanager_watchdog_repeat_seconds }}s
        # A rule that runs in parallel with a Kuma tile carries shadow="true" and pages nobody,
        # so each check has one pager at every commit.
        - matchers: ['shadow="true"']
          receiver: blackhole
        # A drill alert fails a health gate on purpose and pages nobody, so it must sit ahead
        # of both critical routes. M6's HealthGateDrill is the first; the route stays after
        # B-1e removes that rule (docs/target-architecture/monitoring/m6-retire-kuma.md).
        - matchers: ['drill="true"']
          receiver: blackhole
        # A deploy hold stands until the operator clears it, so its page repeats daily
        # rather than every 6h. The rule is D2.6d's, in the deploy-pipeline group
        # (docs/target-architecture/deploy/d2-first-leaf.md).
        - matchers: ['alertname="DeployHoldActive"']
          receiver: discord
          repeat_interval: 24h
          mute_time_intervals: [weekly-reboot]
        - matchers: ['severity="critical"']
          receiver: discord
          continue: true
          mute_time_intervals: [weekly-reboot]
        - matchers: ['severity="critical"']
          receiver: email
          mute_time_intervals: [weekly-reboot]
        - receiver: discord
          mute_time_intervals: [weekly-reboot]
    # One internet outage pages once. A bridge row that sits behind a reachability gate exports 0
    # while the gate reads down, and its rule carries `requires` naming the gate. The gate's rule
    # sources the inhibit, and no `equal` list is needed: these labels sit on the bridge's rows
    # alone. Inhibition runs before routing, so a source and a target must both be shadow or both
    # live (docs/target-architecture/monitoring/m6-retire-kuma.md, "A3 and the handoffs it closes").
    inhibit_rules:
      - source_matchers: ['alertname="WANUnreachable"']
        target_matchers: ['requires="wan"']
      # The same shape for B2: one cap breach pages once, and `b2_storage` is the dependent.
      - source_matchers: ['alertname="B2Unreachable"']
        target_matchers: ['requires="b2"']
      # A host check's own NotReporting pair outranks the catch-all deadman (#6186). Both compare
      # the same timestamp with the same deadline, so they start firing on one evaluation, and
      # `equal` keeps another check or another host's copy paging. This source is shadow on
      # purpose, against the rule above: a shadow pair still has its Kuma tile paging, and
      # Alertmanager's inhibitor reads every alert whatever its route. A `shadow!="true"` source
      # would let HostCheckOverdue page beside that tile for every paired check.
      - source_matchers: ['alertname=~".+NotReporting"']
        target_matchers: ['alertname="HostCheckOverdue"']
        equal: [check, origin]
    receivers:
      - name: blackhole
      - name: healthchecks
        webhook_configs:
          - url_file: /etc/alertmanager/watchdog-url
            # When Prometheus stops sending the Watchdog, Alertmanager resolves it after
            # resolve_timeout. A resolved send would count as a ping and hide the outage.
            send_resolved: false
            # Healthchecks.io stores the request body, so the payload carries the status and
            # no labels or URLs.
            payload:
              status: '{% raw %}{{ .Status }}{% endraw %}'
      - name: discord
        discord_configs:
          - webhook_url_file: /etc/alertmanager/discord-webhook-url
            send_resolved: true
            title: '{% raw %}{{ template "homelab.title" . }}{% endraw %}'
            message: '{% raw %}{{ template "homelab.message" . }}{% endraw %}'
      - name: email
        email_configs:
          - to: "{{ email }}"
            send_resolved: true
            headers:
              Subject: '{% raw %}{{ template "homelab.title" . }}{% endraw %}'
            text: '{% raw %}{{ template "homelab.email" . }}{% endraw %}'
            # Empty drops the default HTML part, so the email is homelab.email's plain text:
            # the Discord body without its Markdown and with UTC times.
            html: ''
  homelab.tmpl: |
    {{ lookup('file', playbook_dir + '/roles/k8s/observability/files/alertmanager/homelab.tmpl') | indent(4) }}
  discord-webhook-url: "{{ monitor_discord_webhook_url }}"
  smtp-password: "{{ smtp_notify_app_password }}"
  watchdog-url: "https://hc-ping.com/{{ healthchecks_ping_key }}/alertmanager-watchdog"
