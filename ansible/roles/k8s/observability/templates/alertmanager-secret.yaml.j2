---
# Rendered through the manifests role's SECRET list (0600 + no_log).
#
# A Secret, not a ConfigMap, because alertmanager.yml carries `email`, which is a SOPS key. The
# three credentials ride beside it as their own keys, and the config reads each through a
# `*_file` field. That keeps them out of the config text, and it lets the offline validator's
# `STUB` stand in for each one: a webhook URL rendered as `STUB` would fail Alertmanager's URL
# parsing, while a file path is only read when a notification is sent.
#
# EVERY GO TEMPLATE EXPRESSION SITS INSIDE A JINJA RAW BLOCK. Jinja refuses the two forms used
# below as syntax errors, and any Go expression it could parse it would consume.
# scripts/validate/alert_rules.py checks that each reference this file holds survives the
# render. The Go templates themselves live in files/alertmanager/homelab.tmpl, which
# lookup('file') carries in without templating it.
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-config
  namespace: {{ k8s_observability_namespace }}
type: Opaque
stringData:
  alertmanager.yml: |
    global:
      resolve_timeout: 5m
      # Gmail on 465, Kuma's account (uptime-kuma's static-monitors.yaml.j2, email.json). Port
      # 465 is implicit TLS, which Alertmanager picks from the port alone.
      smtp_smarthost: smtp.gmail.com:465
      smtp_from: "{{ email }}"
      smtp_auth_username: "{{ email }}"
      smtp_auth_password_file: /etc/alertmanager/smtp-password
    # Relative to this file, so it resolves both in the pod and beside the rendered copy amtool
    # checks in CI.
    templates:
      - homelab.tmpl
    route:
      receiver: discord
      group_by: [alertname, service]
      group_wait: 30s
      group_interval: 5m
      # Kuma resends a DOWN tile every 90 beats, which is 6h for a bridge tile.
      repeat_interval: 6h
      routes:
        # First, and never under a mute interval, so no maintenance window can silence the
        # off-site watcher.
        - matchers: ['alertname="Watchdog"']
          receiver: healthchecks
          group_wait: 0s
          group_interval: 1m
          repeat_interval: {{ observability_alertmanager_watchdog_repeat_seconds }}s
        # A rule that runs in parallel with a Kuma tile carries shadow="true" and pages nobody,
        # so each check has one pager at every commit.
        - matchers: ['shadow="true"']
          receiver: blackhole
        - matchers: ['severity="critical"']
          receiver: discord
          continue: true
        - matchers: ['severity="critical"']
          receiver: email
        - receiver: discord
    receivers:
      - name: blackhole
      - name: healthchecks
        webhook_configs:
          - url_file: /etc/alertmanager/watchdog-url
            # When Prometheus stops sending the Watchdog, Alertmanager resolves it after
            # resolve_timeout. A resolved send would count as a ping and hide the outage.
            send_resolved: false
            # Healthchecks.io stores the request body, so the payload carries the status and
            # no labels or URLs.
            payload:
              status: '{% raw %}{{ .Status }}{% endraw %}'
      - name: discord
        discord_configs:
          - webhook_url_file: /etc/alertmanager/discord-webhook-url
            send_resolved: true
            title: '{% raw %}{{ template "homelab.title" . }}{% endraw %}'
            message: '{% raw %}{{ template "homelab.message" . }}{% endraw %}'
      - name: email
        email_configs:
          - to: "{{ email }}"
            send_resolved: true
            headers:
              Subject: '{% raw %}{{ template "homelab.title" . }}{% endraw %}'
            text: '{% raw %}{{ template "homelab.message" . }}{% endraw %}'
            # Empty drops the default HTML part, so the email carries the same text the
            # Discord message does.
            html: ''
  homelab.tmpl: |
    {{ lookup('file', playbook_dir + '/roles/k8s/observability/files/alertmanager/homelab.tmpl') | indent(4) }}
  discord-webhook-url: "{{ monitor_discord_webhook_url }}"
  smtp-password: "{{ smtp_notify_app_password }}"
  watchdog-url: "https://hc-ping.com/{{ healthchecks_ping_key }}/alertmanager-watchdog"
