---
# Rendered through the manifests role's SECRET list (0600 + no_log).
#
# Reuses `grafana_admin_password` rather than minting a second credential, on the same
# reasoning the k8s Authelia shares authelia_secret/authelia_storage with its Docker twin:
# this instance is not a peer of the Docker Grafana, it is its eventual replacement, so a
# separate password would be one more rotation entry that exists only until the cutover.
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin
  namespace: {{ k8s_observability_namespace }}
type: Opaque
stringData:
  password: "{{ grafana_admin_password }}"
  # The PLAINTEXT half of the Authelia OIDC client credential. Authelia's own config holds
  # only the pbkdf2 digest (`grafana_oidc_client_secret_hash`); a relying party has to send
  # the plaintext at the token endpoint, so the two SOPS keys are one credential in two
  # forms and must be rotated together.
  oidc_client_secret: "{{ grafana_oidc_client_secret }}"
