          "refId": "DeployAnno"
        },
        "textFormat": "{{services}}",
        "titleFormat": "deploy {{result}}"
      }
    ]
  },
  "description": "Which alerts fired, when, and for how long, grouped by the `service` label every rule carries. Every panel reads Prometheus's `ALERTS` series, so the history spans Prometheus's retention (`observability_prometheus_retention`). `Watchdog` is left out because it always fires. Alerts still in `shadow` are counted and marked in the tables. M6 B-5 rebuilt this board on `ALERTS` in place of the Loki reconstruction of Uptime Kuma DOWN pushes.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Minutes each service spent with an alert firing over the dashboard's time range, read from Prometheus's `ALERTS` series at one-minute resolution. Each firing alert counts its own minutes, so two alerts on one service for an hour read 120. `Watchdog` is left out because it always fires.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "unit": "m"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "displayMode": "gradient",
        "legend": {
          "showLegend": false
        },
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sort_desc(sum by (service) (count_over_time(ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\", service=~\"$service\"}[$__range:1m])))",
          "instant": true,
          "legendFormat": "{{service}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Firing minutes by service (range total)",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "How many alerts were firing at each moment, stacked by service. A shared spike across services usually means one root cause, such as a node reboot.",
      "fieldConfig": {
        "defaults": {
          "color": {
