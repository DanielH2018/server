{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nut
  namespace: {{ k8s_namespace }}
spec:
  # Recreate: the USB device and the loopback hostPort are both node-exclusive — a
  # rolling update would leave the new pod fighting the old one for both.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: nut
  template:
    metadata:
      labels:
        app: nut
        netpol-baseline: enforced
    spec:
      # The UPS is USB-attached to daniel-server. This pin is physical, not a scheduling
      # preference — it does NOT unwind with the drain's L2/VIP pins.
      nodeSelector:
        kubernetes.io/hostname: daniel-server
{{ pod_shell(containers_list | tier_priority_class('nut')) }}
      containers:
        - name: nut
          image: {{ nut_k8s_image }}
{# Ansible owns nut, so its ref is the in-cluster registry's, where a build that skips pushes
   nothing new and leaves a pod asking for a name the node already holds: `Always`, for the
   reason terraria's deployment records. A flux-owned tag's ref is a GHCR content tag instead,
   and the renderer sets `IfNotPresent` beside it
   (scripts/renderer/renderer_lib/images.py:ghcr_refs), so a node that holds the tag restarts
   the pod with no WAN. nut moves in its Wave C PR, after the in-cluster registry mirrors GHCR
   (D5 Open question 2). A Jinja comment, so an edit here never changes nut's render. #}
          imagePullPolicy: Always
          ports:
            - containerPort: 3493
              # Loopback publish for the HOST's own upsmon (secondary, nut_host role):
              # it monitors apc-ups@127.0.0.1 and is what actually runs
              # `systemctl poweroff` when FSD is raised — the pod cannot power off the
              # node. Byte-identical to the Docker-era `127.0.0.1:3493:3493` publish,
              # so the host config did not change at cutover.
              hostIP: 127.0.0.1
              hostPort: 3493
          securityContext:
            # privileged, and the Docker posture was cap-list + udev MODE=0666 with NO
            # privileged — k8s cannot express that: it has no `devices:` whitelist, so a
            # hostPath'd /dev/bus/usb node is refused by the
            # non-privileged pod's device cgroup regardless of file permissions. The
            # containment that remains: our own built image, pinned to one node, with
            # only a loopback hostPort exposed. A generic USB device plugin could
            # restore the unprivileged posture — noted as follow-up, not blocking the
            # Docker removal this port exists for.
            privileged: true
          env:
            - name: TZ
              value: "{{ tz }}"
          volumeMounts:
            - name: nut-config
              mountPath: /nut-config
              readOnly: true
            - name: nut-usb
              mountPath: /dev/bus/usb
          livenessProbe:
            exec:
              command:
                - /bin/sh
                - -c
                - upsc {{ nut_ups_name | default('apc-ups') }}@localhost battery.charge
            initialDelaySeconds: 30
            periodSeconds: 30
          # upsd binds 3493 only after it has enumerated the USB UPS, which takes a few
          # seconds. Without this the Service publishes the pod immediately and peanut and
          # Home Assistant's NUT integration get connection-refused on every deploy.
          readinessProbe:
            tcpSocket:
              port: 3493
            initialDelaySeconds: 5
            periodSeconds: 10
            failureThreshold: 3
{{ container_resources(cpu_limit=nut_k8s_cpu_limit, mem_limit=nut_k8s_mem_limit, cpu_request=nut_k8s_cpu_request, mem_request=nut_k8s_mem_request) }}
      volumes:
        - name: nut-config
          secret:
            secretName: nut-config
        - name: nut-usb
          hostPath:
            path: /dev/bus/usb
