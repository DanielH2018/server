---
# The full /etc/nut config set, staged into place by the image's entrypoint. A Secret
# rather than a ConfigMap because upsd.users and upsmon.conf carry the NUT passwords —
# and NOT baked into the image (the Docker-era build COPY'd config/ in) because the
# in-cluster registry is unauthenticated: anything pushed there is readable by any pod
# the registry NetworkPolicy admits and anyone on either node.
#
# Content mirrors the retired containers/peanut templates verbatim, one key per file.
apiVersion: v1
kind: Secret
metadata:
  name: nut-config
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  nut.conf: |
    MODE=standalone
  ups.conf: |
    [{{ nut_ups_name | default('apc-ups') }}]
      driver = usbhid-ups
      port = auto
      desc = "APC BR1500MS2"
      vendorid = 051d
      productid = 0002
  upsd.conf: |
    LISTEN 0.0.0.0 3493

    STATEPATH /var/run/nut
  upsd.users: |
    [upsmon]
      password = {{ nut_monitor_password }}
      upsmon primary

    # Read-only login for Home Assistant's NUT integration: it can read every UPS
    # variable but holds no upsmon role and no instcmds/actions, so it cannot raise
    # FSD or run instant commands. Reaches upsd over the `nut` ClusterIP Service.
    [homeassistant]
      password = {{ nut_ha_password }}
  upsmon.conf: |
    MONITOR {{ nut_ups_name | default('apc-ups') }}@localhost 1 upsmon {{ nut_monitor_password }} primary
    MINSUPPLIES 1
    # This upsmon (pod, primary) only RAISES FSD — it cannot power off the node. The
    # HOST runs its own upsmon in `secondary` mode (nut_host role, over the pod's
    # 127.0.0.1:3493 hostPort) and performs the real `systemctl poweroff` when FSD
    # propagates.
    SHUTDOWNCMD "logger -t upsmon 'FSD raised — host-side secondary upsmon performs the actual poweroff'"
    NOTIFYCMD /usr/sbin/upssched
    POLLFREQ 5
    POLLFREQALERT 5
    HOSTSYNC 15
    DEADTIME 15
    POWERDOWNFLAG /etc/killpower

    NOTIFYMSG ONLINE "UPS %s on line power"
    NOTIFYMSG ONBATT "UPS %s on battery"
    NOTIFYMSG LOWBATT "UPS %s battery is low"
    NOTIFYMSG COMMBAD "UPS %s communication lost"
    NOTIFYMSG COMMOK "UPS %s communication restored"
    NOTIFYMSG SHUTDOWN "Auto-shutdown initiated on UPS %s"

    NOTIFYFLAG ONLINE SYSLOG+EXEC
    NOTIFYFLAG ONBATT SYSLOG+WALL+EXEC
    NOTIFYFLAG LOWBATT SYSLOG+WALL+EXEC
    NOTIFYFLAG COMMBAD SYSLOG
    NOTIFYFLAG COMMOK SYSLOG
    NOTIFYFLAG SHUTDOWN SYSLOG+WALL

    RBWARNTIME 43200
    NOCOMMWARNTIME 300
    FINALDELAY 5
  upssched.conf: |
    CMDSCRIPT /usr/local/bin/upssched-cmd
    PIPEFN /var/run/nut/upssched.pipe
    LOCKFN /var/run/nut/upssched.lock

    # Wait this many seconds on battery before triggering shutdown (survives brief outages)
    AT ONBATT * START-TIMER onbatt {{ nut_onbatt_shutdown_delay | default(120) }}
    # Cancel the timer if power is restored
    AT ONLINE * CANCEL-TIMER onbatt online
    # Shut down immediately when UPS signals low battery
    AT LOWBATT * EXECUTE lowbatt
