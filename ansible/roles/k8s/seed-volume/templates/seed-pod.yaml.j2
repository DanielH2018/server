---
apiVersion: v1
kind: Pod
metadata:
  name: seed-{{ seed_volume_claim }}
  namespace: {{ k8s_namespace }}
  labels:
    app: seed-volume
spec:
{% if seed_volume_node | default('') %}
  # Pinned to the node this claim is already attached to ({{ seed_volume_node }}), resolved
  # from its VolumeAttachment. An RWO volume attaches to one node at a time, so a seed pod
  # anywhere else cannot start — it wedges in ContainerCreating on a Multi-Attach error and
  # fails the play. Absent on a first seed, when nothing holds the volume yet.
  nodeSelector:
    kubernetes.io/hostname: {{ seed_volume_node }}
{% endif %}
  # Never restart. If the sleep dies the copy is already broken, and a restart would silently
  # present an empty-looking pod to a play that is waiting to stream into it.
  restartPolicy: Never
  # This pod runs `sleep` and is written into by `kubectl exec` from the Ansible controller
  # (seed.yml:224); it makes no API calls of its own, so the default ServiceAccount token is a
  # credential mounted into a root container mounting arbitrary Longhorn PVCs, for nothing. The
  # token grants only discovery today — no RoleBinding or ClusterRoleBinding template in this
  # repo targets the `default` SA — which is why this is small, not why it should stay.
  automountServiceAccountToken: false
  # Root on purpose. `tar -p --numeric-owner` has to be able to restore the source's UIDs, so
  # the workload finds the ownership it had under Docker. Nothing else runs in this pod and it
  # is deleted at the end of the play.
  securityContext:
    runAsUser: 0
  containers:
    - name: seed
      image: {{ seed_volume_image }}
      command: ["sleep", "{{ seed_volume_pod_ttl }}"]
      volumeMounts:
        - name: seed-volume-data
          mountPath: {{ seed_volume_mount }}
  volumes:
    - name: seed-volume-data
      persistentVolumeClaim:
        claimName: {{ seed_volume_claim }}
