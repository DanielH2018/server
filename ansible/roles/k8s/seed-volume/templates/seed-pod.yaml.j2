---
apiVersion: v1
kind: Pod
metadata:
  name: seed-{{ seed_volume_claim }}
  namespace: {{ k8s_namespace }}
  labels:
    app: seed-volume
spec:
  # Never restart. If the sleep dies the copy is already broken, and a restart would silently
  # present an empty-looking pod to a play that is waiting to stream into it.
  restartPolicy: Never
  # Root on purpose. `tar -p --numeric-owner` has to be able to restore the source's UIDs, so
  # the workload finds the ownership it had under Docker. Nothing else runs in this pod and it
  # is deleted at the end of the play.
  securityContext:
    runAsUser: 0
  containers:
    - name: seed
      image: {{ seed_volume_image }}
      command: ["sleep", "{{ seed_volume_pod_ttl }}"]
      volumeMounts:
        - name: data
          mountPath: {{ seed_volume_mount }}
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: {{ seed_volume_claim }}
