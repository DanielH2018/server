---
# Local copies of the middlewares (and the TLSOption) the Longhorn UI route references.
# Longhorn installs into its own namespace from the upstream manifest, the route must live
# beside the Service it targets, and Traefik's `allowCrossNamespace` stays off — so the
# objects a route names have to exist here rather than in {{ k8s_namespace }}.
#
# Same trade-off the telemetry stack made (roles/k8s/claude-otel/templates/middlewares.yaml.j2):
# these can drift from the originals in roles/k8s/traefik/templates/dynamic.yaml.j2 and
# roles/k8s/authelia/templates/forwardauth-middleware.yaml.j2. Three namespaces carrying a copy
# is the point at which a shared template starts to earn itself; the next one should build it.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: rate-limit
  namespace: {{ k8s_longhorn_namespace }}
spec:
  rateLimit:
    average: 300
    burst: 150
    period: 1m
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: authelia
  namespace: {{ k8s_longhorn_namespace }}
spec:
  forwardAuth:
    # Only the Middleware object has to be local; what it forwards to does not — Authelia
    # keeps running in the workload namespace and is addressed by FQDN.
    address: http://authelia.{{ k8s_namespace }}.svc.cluster.local:9091/api/authz/forward-auth
    trustForwardHeader: true
    authResponseHeaders:
      - Remote-User
      - Remote-Groups
      - Remote-Name
      - Remote-Email
    maxResponseBodySize: 1048576
---
# A TLSOption resolves in the ROUTE's namespace, so the `modern` the ingressroute() macro
# names must exist here too. Without it the router never builds and the TLS handshake is
# reset — a failure that names neither the route nor the certificate. See claude-otel's copy.
apiVersion: traefik.io/v1alpha1
kind: TLSOption
metadata:
  name: modern
  namespace: {{ k8s_longhorn_namespace }}
spec:
  minVersion: VersionTLS12
  cipherSuites:
    - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
    - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
    - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
    - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
    - TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305
    - TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305
