---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  # Referenced by name from every protected IngressRoute the ingressroute() macro emits, so
  # this name is load-bearing across all ~33 services that follow in slice 2.
  name: authelia
  namespace: {{ k8s_namespace }}
spec:
  forwardAuth:
    address: http://authelia.{{ k8s_namespace }}.svc.cluster.local:{{ container_item.port }}/api/authz/forward-auth
    trustForwardHeader: true
    authResponseHeaders:
      - Remote-User
      - Remote-Groups
      - Remote-Name
      - Remote-Email
    maxResponseBodySize: 1048576
