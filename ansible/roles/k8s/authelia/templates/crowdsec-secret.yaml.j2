---
# Credentials + parser config for this pod's CrowdSec agent sidecar (slice-6 B2 follow-up).
# Same shape as the traefik pod's traefik-crowdsec Secret; no bouncer key here — Authelia
# enforces nothing, it only produces the failed-login lines the scenarios read.
apiVersion: v1
kind: Secret
metadata:
  name: authelia-crowdsec
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  AGENT_PASSWORD: "{{ crowdsec_k8s_agent_password }}"
  acquis.yaml: |
    filenames:
      - /var/log/authelia/authelia.log
    labels:
      type: authelia
  whitelist.yaml: |
    {{ lookup('file', playbook_dir + '/roles/containers/traefik/files/crowdsec-whitelist.yaml') | indent(4) }}
  trusted-remote-whitelist.yaml: |
    {{ lookup('file', playbook_dir + '/roles/containers/traefik/files/crowdsec-trusted-remote-whitelist.yaml') | indent(4) }}
