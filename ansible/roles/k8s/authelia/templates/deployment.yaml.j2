---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: authelia
  namespace: {{ k8s_namespace }}
spec:
  replicas: 1
  # The SQLite database is a ReadWriteOnce volume and two Authelias writing it is the exact
  # corruption this instance exists to avoid — the old pod must stop before the new one starts.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: authelia
  template:
    metadata:
      labels:
        app: authelia
    spec:
      # Kubernetes otherwise injects legacy Docker-link environment variables for every Service
      # in the namespace — AUTHELIA_SERVICE_HOST, AUTHELIA_PORT_9091_TCP, and friends. Authelia
      # reads AUTHELIA_* as configuration, so the injected `port` collides with server.address
      # from the config file and it exits before serving anything:
      #   the new key already exists with value 'tcp4://:9091' but the deprecated keys and the
      #   new key can't both be configured
      # The collision needs only that a Service name match the app's env-var prefix, which is
      # the normal case here, so this is off for every workload rather than just this one.
      enableServiceLinks: false
      securityContext:
        # Starting as UID 1000 rather than root is why this needs none of the SETUID/SETGID
        # capabilities the compose template grants: the image's entrypoint only su-execs down
        # to the authelia user when it starts as root, and skips that path entirely otherwise.
        # fsGroup makes the config PVC writable for the SQLite database and notification file.
        runAsUser: {{ puid }}
        runAsGroup: {{ pgid }}
        fsGroup: {{ pgid }}
      containers:
        - name: authelia
          image: {{ authelia_k8s_image }}
          args:
            - --config
            - /secrets/configuration.yml
          ports:
            - name: http
              containerPort: {{ container_item.port }}
          env:
            - name: TZ
              value: "{{ tz }}"
          securityContext:
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          volumeMounts:
            # Config and the users database come from the Secret, mounted OUTSIDE /config so
            # the PVC can own /config for the database Authelia writes.
            - name: secrets
              mountPath: /secrets
              readOnly: true
            - name: config
              mountPath: /config
            # readOnlyRootFilesystem is a tightening past the Docker copy, which sets no
            # read_only. Scratch space has to come from somewhere, and the failure mode
            # without it is the portal never starting.
            - name: tmp
              mountPath: /tmp
          readinessProbe:
            httpGet:
              path: /api/health
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /api/health
              port: http
            initialDelaySeconds: 20
            periodSeconds: 30
          resources:
            limits:
              cpu: "{{ authelia_k8s_cpu_limit }}"
              memory: {{ authelia_k8s_mem_limit }}
            requests:
              cpu: "{{ authelia_k8s_cpu_request }}"
              memory: {{ authelia_k8s_mem_request }}
      volumes:
        - name: secrets
          secret:
            secretName: authelia-config
            # 0440, not 0400: secret files are owned root:fsGroup, so a non-root container
            # reads them via the group bit. 0400 leaves the group nothing.
            defaultMode: 0440
        - name: config
          persistentVolumeClaim:
            claimName: authelia-config
        - name: tmp
          emptyDir: {}
