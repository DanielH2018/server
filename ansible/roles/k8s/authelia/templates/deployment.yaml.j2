{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: authelia
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  # The SQLite database is a ReadWriteOnce volume and two Authelias writing it is the exact
  # corruption this instance exists to avoid — the old pod must stop before the new one starts.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: authelia
  template:
    metadata:
      labels:
        app: authelia
        netpol-baseline: enforced
    spec:
      # Edge/auth/DNS eviction ordering — see setup/k3s templates/priorityclass.yaml.j2.
      priorityClassName: homelab-critical
      # Kubernetes otherwise injects legacy Docker-link environment variables for every Service
      # in the namespace — AUTHELIA_SERVICE_HOST, AUTHELIA_PORT_9091_TCP, and friends. Authelia
      # reads AUTHELIA_* as configuration, so the injected `port` collides with server.address
      # from the config file and it exits before serving anything:
      #   the new key already exists with value 'tcp4://:9091' but the deprecated keys and the
      #   new key can't both be configured
      # The collision needs only that a Service name match the app's env-var prefix, which is
      # the normal case here, so this is off for every workload rather than just this one.
      enableServiceLinks: false
      securityContext:
        # Starting as UID 1000 rather than root is why this needs none of the SETUID/SETGID
        # capabilities the compose template grants: the image's entrypoint only su-execs down
        # to the authelia user when it starts as root, and skips that path entirely otherwise.
        # fsGroup makes the config PVC writable for the SQLite database and notification file.
        runAsUser: {{ puid }}
        runAsGroup: {{ pgid }}
        fsGroup: {{ pgid }}
{# All three init containers below are CrowdSec's, so the key would be left with no list under
   it. Gate the key so it is absent rather than empty. #}
{% if authelia_k8s_manage_crowdsec %}
      initContainers:
        # FIRST, before crowdsec-config-install's rsync, and the order is the whole point.
        # The image's staged hub tree is root-only, so that rsync — which runs as the pod's
        # own uid — never copies it; that is part of the exit 23 it tolerates. It does copy
        # the parser CONFIGS, which are symlinks into that tree, so
        # /etc/crowdsec/parsers/s02-enrich/geoip-enrich.yaml resolved to a hub file that was
        # never staged and the agent dropped the parser: `Ignoring file … lstat
        # /etc/crowdsec/hub/parsers/s02-enrich/crowdsecurity/geoip-enrich.yaml: no such file
        # or directory`, once per parser-load pass. GeoIP enrichment stayed dead even after
        # the datafiles were installed, on BOTH pods carrying the sidecar (#1211).
        #
        # Running this AFTER the rsync was tried and is wrong: rsync recurses from the parent
        # listing, so it creates /etc/crowdsec/hub owned by uid 1000 before it fails to read
        # into it, and root with ALL dropped cannot write into another uid's directory —
        # DAC_READ_SEARCH is the READ half of the override, DAC_OVERRIDE is the write half.
        # The copy would fail, `exit 0` would swallow it, and the pod would come up 2/2 with
        # the warning intact. Going first, this creates the directory root-owned and
        # world-readable, and the rsync's own `--ignore-existing` then leaves the files alone.
        #
        # ROOT-OWNED is the half that keeps it readable, not just a consequence of needing
        # DAC_READ_SEARCH. rsync gives an existing destination directory the SOURCE's mode.
        # Measured both ways against a same-uid destination: a 000 source chmodded `hub/` to
        # 000 (exit 23, it never recursed), a 0755 source left 0755 (exit 0), and in both the
        # already-staged file kept its content and mode — `--ignore-existing` is what protects
        # the files. Here the directory is root-owned and the rsync runs as uid 1000, so that
        # chmod is refused whatever the source mode, and a refusal is one more error under the
        # exit 23 the marker below already tolerates. Create this directory as the pod uid and
        # its mode goes back under rsync's control, which a root-only source would then take
        # away again — silently, behind a green render and a healthy pod.
        - name: crowdsec-hub-install
          image: {{ crowdsec_k8s_image }}
          command:
            - /bin/sh
            - -c
            # `cp -a` keeps the tree's own symlinks as symlinks; the chmod is what makes it
            # readable to the non-root agent, and the hub holds public hub content only — the
            # LAPI and online credentials sit beside it in /etc/crowdsec, not in it. Ends in
            # `exit 0` for the same reason crowdsec-data-install does: authelia rolls under
            # Recreate, so the old pod is already gone and a non-zero init container takes SSO
            # down for the whole homelab rather than costing one parser.
            - >-
              mkdir -p /etc/crowdsec/hub &&
              cp -a /staging/etc/crowdsec/hub/. /etc/crowdsec/hub/ &&
              chmod -R a+rX /etc/crowdsec/hub ||
              echo "hub stage incomplete" >&2;
              exit 0
          # Root, written out rather than built through hardened_security_context() — the macro
          # refuses uid 0 so that ansible/tests/k8s/test_root_needs_dac_capability.py can still
          # see this block in raw template text. DAC_READ_SEARCH is the read-only half of root's
          # permission-bit override, which is what reaches the root-only staged hub tree. No
          # write capability is needed because this runs first: /etc/crowdsec is the emptyDir
          # root, root-owned and empty until this container writes to it.
          securityContext:
            allowPrivilegeEscalation: false
            runAsUser: 0
            capabilities:
              add:
                - DAC_READ_SEARCH
              drop:
                - ALL
          volumeMounts:
            - name: crowdsec-etc
              mountPath: /etc/crowdsec
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
        # Seeds the agent sidecar's /etc/crowdsec so its entrypoint never has to: the image's
        # own staged tree first (see the rsync note below), then acquisition pointing at this
        # pod's auth log, plus the same whitelist parsers both other agents use. The seeds are
        # installed AFTER the rsync so they win over the staged copies of the same names.
        # Runs as the pod's uid 1000 (NOT root): it creates the log file
        # Authelia must then write, and root-with-ALL-caps-dropped cannot chown — the same
        # trap slice 5 hit on Home Assistant's config seed. Owning the file by creating it
        # sidesteps the capability entirely. The agent reads these as root regardless.
        - name: crowdsec-config-install
          image: {{ crowdsec_k8s_image }}
          command:
            - /bin/sh
            - -c
            - >-
              (rsync -a --ignore-existing /staging/etc/crowdsec/* /etc/crowdsec
              || [ "$?" -eq 23 ]) &&
              install -m 644 /seed/acquis.yaml /etc/crowdsec/ &&
              install -d /etc/crowdsec/parsers/s02-enrich &&
              install -m 644 /seed/whitelist.yaml /seed/trusted-remote-whitelist.yaml
              /etc/crowdsec/parsers/s02-enrich/ &&
              install -m 640 /dev/null /var/log/authelia/authelia.log
          # The rsync is the image entrypoint's own "Populating configuration directory"
          # step, run here so the sidecar never runs it. It only runs while
          # /etc/crowdsec/config.yaml is absent, and it runs under `set -e`: about twenty
          # staged files are root-only (the LAPI/online credentials and the bundled hub
          # tree), so a non-root rsync exits 23 and killed the sidecar's FIRST start on
          # every pod start — `crowdsec-agent restarts=1 last=Error 23`, which
          # `probe.py health authelia` fails closed on inside its 180s window, so every
          # authelia deploy read `VERDICT: unhealthy` (#1173). The kubelet's restart then
          # found config.yaml and skipped the block; this seeds the same state up front.
          # Traefik's identical init container carries the long-form rationale (#976).
          #
          # DECIDED: tolerate exit 23 only, never `|| true`. This moves the failure from a
          # sidecar restart to a failed init container, and authelia rolls under Recreate —
          # the old pod is already gone, so a non-23 rsync failure takes SSO down rather
          # than costing one restart. Exit 23 alone is safe because the files it skips are the
          # LAPI and online credentials, which the agent regenerates (`cscli lapi register`) on
          # start regardless; any OTHER rsync status is a real seed failure and must fail the
          # pod rather than start an agent with a half-populated config.
          #
          # AMENDED 2026-09-05 (#1211): the marker also claimed the skipped HUB tree is
          # re-downloaded (`cscli hub update`) on start. It is not, or not before the parser
          # load — both pods logged `Ignoring file … geoip-enrich.yaml: lstat
          # /etc/crowdsec/hub/…: no such file or directory` once per parser-load pass. The
          # decision against `|| true` is unchanged and still stands; what changed is that the
          # hub tree is now staged explicitly by crowdsec-hub-install above rather than assumed
          # to arrive on its own.
{{ hardened_security_context(non_root=true) }}
          volumeMounts:
            - name: crowdsec-secret
              mountPath: /seed
              readOnly: true
            - name: crowdsec-etc
              mountPath: /etc/crowdsec
            # The log file must EXIST before the agent starts. Pod containers start in
            # parallel, and crowdsec's file acquisition does not retry a missing file — it
            # logs one error and drops that datasource for the life of the container, so a
            # lost race leaves a healthy-looking pod with no detection at all (measured
            # here on the first rollout). Created uid-1000-owned so Authelia can write it.
            - name: authelia-logs
              mountPath: /var/log/authelia
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
        # The image ships its datafiles at /staging/var/lib/crowdsec/data mode 0600 root:root
        # (measured on the v1.7.8 image), and the entrypoint SYMLINKS them into the data volume
        # rather than copying. The non-root agent then cannot read through the link, so GeoIP
        # never initialises — `unable to open GeoLite2-City.mmdb: permission denied`, and the
        # geoip-enrich parser is dead in a pod that otherwise reads healthy (#1177, the same
        # class traefik hit as #990). Copying them in world-readable defeats the symlink: the
        # entrypoint's `[ ! -e ]` guard skips a name that already exists, so the agent reads
        # these copies instead. Traefik's identical init container carries the same comment.
        - name: crowdsec-data-install
          image: {{ crowdsec_k8s_image }}
          command:
            - /bin/sh
            - -c
            # Per file, not `cp -r`: `trace/` is a 0700 directory and the db is the entrypoint's
            # own documented skip. A file that cannot be read is left to the symlink path — the
            # status quo for that name — rather than failing the pod, because authelia rolls
            # under Recreate: the old pod is already gone, so an init container that exits
            # non-zero takes SSO down for the whole homelab rather than costing one parser.
            # `ls` succeeds because the directory itself is 0755.
            - >-
              for f in /staging/var/lib/crowdsec/data/*; do
              [ -f "$f" ] || continue;
              case "${f##*/}" in crowdsec.db*) continue ;; esac;
              install -m 644 "$f" /var/lib/crowdsec/data/ ||
              echo "skipped ${f##*/}" >&2;
              done; exit 0
          # Root, written out rather than built through hardened_security_context() — the macro
          # refuses uid 0 so that ansible/tests/k8s/test_root_needs_dac_capability.py can still
          # see this block in raw template text. DAC_READ_SEARCH is the read-only half of root's
          # permission-bit override: it covers the 0600 sources however the image later owns
          # them. Writing needs no DAC_OVERRIDE, since the emptyDir is root-owned and empty
          # until this container runs.
          securityContext:
            allowPrivilegeEscalation: false
            runAsUser: 0
            capabilities:
              add:
                - DAC_READ_SEARCH
              drop:
                - ALL
          volumeMounts:
            - name: crowdsec-data
              mountPath: /var/lib/crowdsec/data
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
{% endif %}
      automountServiceAccountToken: false
      containers:
        - name: authelia
          image: {{ authelia_k8s_image }}
          args:
            - --config
            - /secrets/configuration.yml
          ports:
            - name: http
              containerPort: {{ container_item.port }}
          env:
            - name: TZ
              value: "{{ tz }}"
          # NO readOnlyRootFilesystem, unlike traefik and bento-pdf. With it on, Authelia
          # dies during provider construction — before a single startup check runs — and
          # logs only an aggregate with no detail, at every level including trace:
          #   level=fatal msg="Errors occurred performing startup checks"
          # Measured on daniel-box: flipping this one field is the entire difference
          # between that and "Startup complete ... Listening ... on '0.0.0.0:9091'".
          # Config, the users database, /config's permissions, storage migration, DNS and
          # NTP egress were each verified good independently, so none of them is the cause.
          # It cannot be a plain permission problem either: as uid 1000 the process cannot
          # write anywhere outside its mounts in the WORKING case either, which leaves
          # EROFS-vs-EACCES on some path Authelia probes and never names.
          # The Docker role this was ported from sets no read_only, so dropping it is not a
          # regression against the instance being migrated — keeping it was the divergence.
{{ hardened_security_context(non_root=true) }}
          volumeMounts:
            # Config and the users database come from the Secret, mounted OUTSIDE /config so
            # the PVC can own /config for the database Authelia writes.
            - name: authelia-secrets
              mountPath: /secrets
              readOnly: true
            - name: authelia-config
              mountPath: /config
            # Kept even though the root filesystem is writable again: as uid 1000 the process
            # can write nowhere else outside its mounts, so scratch space still has to come
            # from somewhere.
            - name: authelia-tmp
              mountPath: /tmp
            # Shared with the crowdsec-agent sidecar below.
            - name: authelia-logs
              mountPath: /var/log/authelia
          readinessProbe:
            httpGet:
              path: /api/health
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /api/health
              port: http
            initialDelaySeconds: 20
            periodSeconds: 30
{{ container_resources(cpu_limit=authelia_k8s_cpu_limit, mem_limit=authelia_k8s_mem_limit, cpu_request=authelia_k8s_cpu_request, mem_request=authelia_k8s_mem_request) }}
{% if authelia_k8s_manage_crowdsec %}
        # Parses THIS pod's auth log into the in-cluster LAPI, so failed-login scenarios
        # (LePresidente/authelia) cover the cluster portal the way daniel-server's agent
        # covers the Docker one. Same shape as the traefik pod's sidecar: no readinessProbe
        # (sidecar readiness would gate the portal's Service endpoints, and a hub hiccup must
        # not take SSO out of rotation), lenient liveness, emptyDir for the hub datafiles the
        # image demands.
        - name: crowdsec-agent
          image: {{ crowdsec_k8s_image }}
          env:
            - name: TZ
              value: "{{ tz }}"
            - name: DISABLE_LOCAL_API
              value: "true"
            - name: LOCAL_API_URL
              value: "http://crowdsec:{{ crowdsec_k8s_lapi_port }}"
            - name: AGENT_USERNAME
              value: "{{ crowdsec_k8s_authelia_agent_machine }}"
            - name: AGENT_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: authelia-crowdsec
                  key: AGENT_PASSWORD
            - name: COLLECTIONS
              value: "{{ authelia_k8s_agent_collections }}"
          # Pod default uid, NOT root. Root here is actively worse: with ALL caps dropped it
          # has no DAC_OVERRIDE, so it cannot write the /etc/crowdsec tree the init container
          # owns, and `cscli parsers install` dies on mkdir. As uid 1000 it owns that tree and
          # the log file outright. The agent needs no privilege — it reads a file and posts
          # to the LAPI.
{{ hardened_security_context(non_root=true) }}
          volumeMounts:
            - name: crowdsec-etc
              mountPath: /etc/crowdsec
            - name: crowdsec-data
              mountPath: /var/lib/crowdsec/data
            - name: authelia-logs
              mountPath: /var/log/authelia
              readOnly: true
            - name: crowdsec-tmp
              mountPath: /tmp
          livenessProbe:
            exec:
              command: ["cscli", "lapi", "status"]
            initialDelaySeconds: 120
            periodSeconds: 60
            timeoutSeconds: 10
{{ container_resources(cpu_limit=authelia_k8s_agent_cpu_limit, mem_limit=authelia_k8s_agent_mem_limit, cpu_request=authelia_k8s_agent_cpu_request, mem_request=authelia_k8s_agent_mem_request) }}
{% endif %}
      volumes:
        - name: authelia-secrets
          secret:
            secretName: authelia-config
            # 0440, not 0400: secret files are owned root:fsGroup, so a non-root container
            # reads them via the group bit. 0400 leaves the group nothing.
            defaultMode: 0440
        - name: authelia-config
          persistentVolumeClaim:
            claimName: authelia-config
        - name: authelia-tmp
          emptyDir: {}
        - name: authelia-logs
          emptyDir:
            sizeLimit: {{ authelia_k8s_log_size }}
{% if authelia_k8s_manage_crowdsec %}
        - name: crowdsec-secret
          secret:
            secretName: authelia-crowdsec
            defaultMode: 0440
        - name: crowdsec-etc
          emptyDir: {}
        - name: crowdsec-data
          emptyDir: {}
        - name: crowdsec-tmp
          emptyDir: {}
{% endif %}
