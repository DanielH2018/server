---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: authelia
  namespace: {{ k8s_namespace }}
spec:
  replicas: 1
  # The SQLite database is a ReadWriteOnce volume and two Authelias writing it is the exact
  # corruption this instance exists to avoid — the old pod must stop before the new one starts.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: authelia
  template:
    metadata:
      labels:
        app: authelia
        netpol-baseline: enforced
    spec:
      # Edge/auth/DNS eviction ordering — see setup/k3s templates/priorityclass.yaml.j2.
      priorityClassName: homelab-critical
      # Kubernetes otherwise injects legacy Docker-link environment variables for every Service
      # in the namespace — AUTHELIA_SERVICE_HOST, AUTHELIA_PORT_9091_TCP, and friends. Authelia
      # reads AUTHELIA_* as configuration, so the injected `port` collides with server.address
      # from the config file and it exits before serving anything:
      #   the new key already exists with value 'tcp4://:9091' but the deprecated keys and the
      #   new key can't both be configured
      # The collision needs only that a Service name match the app's env-var prefix, which is
      # the normal case here, so this is off for every workload rather than just this one.
      enableServiceLinks: false
      securityContext:
        # Starting as UID 1000 rather than root is why this needs none of the SETUID/SETGID
        # capabilities the compose template grants: the image's entrypoint only su-execs down
        # to the authelia user when it starts as root, and skips that path entirely otherwise.
        # fsGroup makes the config PVC writable for the SQLite database and notification file.
        runAsUser: {{ puid }}
        runAsGroup: {{ pgid }}
        fsGroup: {{ pgid }}
{# The sole init container below is CrowdSec's, so the key would be left with no list under
   it. Gate the key so it is absent rather than empty. #}
{% if authelia_k8s_manage_crowdsec %}
      initContainers:
        # Seeds the agent sidecar's /etc/crowdsec before its entrypoint fills in defaults:
        # acquisition pointing at this pod's auth log, plus the same whitelist parsers both
        # other agents use. Runs as the pod's uid 1000 (NOT root): it creates the log file
        # Authelia must then write, and root-with-ALL-caps-dropped cannot chown — the same
        # trap slice 5 hit on Home Assistant's config seed. Owning the file by creating it
        # sidesteps the capability entirely. The agent reads these as root regardless.
        - name: crowdsec-config-install
          image: {{ crowdsec_k8s_image }}
          command:
            - /bin/sh
            - -c
            - >-
              install -m 644 /seed/acquis.yaml /etc/crowdsec/ &&
              install -d /etc/crowdsec/parsers/s02-enrich &&
              install -m 644 /seed/whitelist.yaml /seed/trusted-remote-whitelist.yaml
              /etc/crowdsec/parsers/s02-enrich/ &&
              install -m 640 /dev/null /var/log/authelia/authelia.log
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - name: crowdsec-secret
              mountPath: /seed
              readOnly: true
            - name: crowdsec-etc
              mountPath: /etc/crowdsec
            # The log file must EXIST before the agent starts. Pod containers start in
            # parallel, and crowdsec's file acquisition does not retry a missing file — it
            # logs one error and drops that datasource for the life of the container, so a
            # lost race leaves a healthy-looking pod with no detection at all (measured
            # here on the first rollout). Created uid-1000-owned so Authelia can write it.
            - name: authelia-logs
              mountPath: /var/log/authelia
          resources:
            limits:
              cpu: 250m
              memory: 128Mi
            requests:
              cpu: 10m
              memory: 16Mi
{% endif %}
      automountServiceAccountToken: false
      containers:
        - name: authelia
          image: {{ authelia_k8s_image }}
          args:
            - --config
            - /secrets/configuration.yml
          ports:
            - name: http
              containerPort: {{ container_item.port }}
          env:
            - name: TZ
              value: "{{ tz }}"
          securityContext:
            # NO readOnlyRootFilesystem, unlike traefik and bento-pdf. With it on, Authelia
            # dies during provider construction — before a single startup check runs — and
            # logs only an aggregate with no detail, at every level including trace:
            #   level=fatal msg="Errors occurred performing startup checks"
            # Measured on daniel-box: flipping this one field is the entire difference
            # between that and "Startup complete ... Listening ... on '0.0.0.0:9091'".
            # Config, the users database, /config's permissions, storage migration, DNS and
            # NTP egress were each verified good independently, so none of them is the cause.
            # It cannot be a plain permission problem either: as uid 1000 the process cannot
            # write anywhere outside its mounts in the WORKING case either, which leaves
            # EROFS-vs-EACCES on some path Authelia probes and never names.
            # The Docker role this was ported from sets no read_only, so dropping it is not a
            # regression against the instance being migrated — keeping it was the divergence.
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          volumeMounts:
            # Config and the users database come from the Secret, mounted OUTSIDE /config so
            # the PVC can own /config for the database Authelia writes.
            - name: authelia-secrets
              mountPath: /secrets
              readOnly: true
            - name: authelia-config
              mountPath: /config
            # Kept even though the root filesystem is writable again: as uid 1000 the process
            # can write nowhere else outside its mounts, so scratch space still has to come
            # from somewhere.
            - name: authelia-tmp
              mountPath: /tmp
            # Shared with the crowdsec-agent sidecar below.
            - name: authelia-logs
              mountPath: /var/log/authelia
          readinessProbe:
            httpGet:
              path: /api/health
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /api/health
              port: http
            initialDelaySeconds: 20
            periodSeconds: 30
          resources:
            limits:
              cpu: "{{ authelia_k8s_cpu_limit }}"
              memory: {{ authelia_k8s_mem_limit }}
            requests:
              cpu: "{{ authelia_k8s_cpu_request }}"
              memory: {{ authelia_k8s_mem_request }}
{% if authelia_k8s_manage_crowdsec %}
        # Parses THIS pod's auth log into the in-cluster LAPI, so failed-login scenarios
        # (LePresidente/authelia) cover the cluster portal the way daniel-server's agent
        # covers the Docker one. Same shape as the traefik pod's sidecar: no readinessProbe
        # (sidecar readiness would gate the portal's Service endpoints, and a hub hiccup must
        # not take SSO out of rotation), lenient liveness, emptyDir for the hub datafiles the
        # image demands.
        - name: crowdsec-agent
          image: {{ crowdsec_k8s_image }}
          env:
            - name: TZ
              value: "{{ tz }}"
            - name: DISABLE_LOCAL_API
              value: "true"
            - name: LOCAL_API_URL
              value: "http://crowdsec:{{ crowdsec_k8s_lapi_port }}"
            - name: AGENT_USERNAME
              value: "{{ crowdsec_k8s_authelia_agent_machine }}"
            - name: AGENT_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: authelia-crowdsec
                  key: AGENT_PASSWORD
            - name: COLLECTIONS
              value: "{{ authelia_k8s_agent_collections }}"
          # Pod default uid, NOT root. Root here is actively worse: with ALL caps dropped it
          # has no DAC_OVERRIDE, so it cannot write the /etc/crowdsec tree the init container
          # owns, and `cscli parsers install` dies on mkdir. As uid 1000 it owns that tree and
          # the log file outright. The agent needs no privilege — it reads a file and posts
          # to the LAPI.
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - name: crowdsec-etc
              mountPath: /etc/crowdsec
            - name: crowdsec-data
              mountPath: /var/lib/crowdsec/data
            - name: authelia-logs
              mountPath: /var/log/authelia
              readOnly: true
            - name: crowdsec-tmp
              mountPath: /tmp
          livenessProbe:
            exec:
              command: ["cscli", "lapi", "status"]
            initialDelaySeconds: 120
            periodSeconds: 60
            timeoutSeconds: 10
          resources:
            limits:
              cpu: "{{ authelia_k8s_agent_cpu_limit }}"
              memory: {{ authelia_k8s_agent_mem_limit }}
            requests:
              cpu: "{{ authelia_k8s_agent_cpu_request }}"
              memory: {{ authelia_k8s_agent_mem_request }}
{% endif %}
      volumes:
        - name: authelia-secrets
          secret:
            secretName: authelia-config
            # 0440, not 0400: secret files are owned root:fsGroup, so a non-root container
            # reads them via the group bit. 0400 leaves the group nothing.
            defaultMode: 0440
        - name: authelia-config
          persistentVolumeClaim:
            claimName: authelia-config
        - name: authelia-tmp
          emptyDir: {}
        - name: authelia-logs
          emptyDir:
            sizeLimit: {{ authelia_k8s_log_size }}
{% if authelia_k8s_manage_crowdsec %}
        - name: crowdsec-secret
          secret:
            secretName: authelia-crowdsec
            defaultMode: 0440
        - name: crowdsec-etc
          emptyDir: {}
        - name: crowdsec-data
          emptyDir: {}
        - name: crowdsec-tmp
          emptyDir: {}
{% endif %}
