{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
{% from 'crowdsec-agent.yml.j2' import crowdsec_agent_init_containers, crowdsec_agent_sidecar, crowdsec_agent_volumes with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: authelia
  namespace: {{ k8s_namespace }}
spec:
  # The SQLite database is a ReadWriteOnce volume and two Authelias writing it is the exact
  # corruption this instance exists to avoid — the old pod must stop before the new one starts.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: authelia
  template:
    metadata:
      labels:
        app: authelia
        netpol-baseline: enforced
    spec:
      # Pinned with the rest of the home-critical chain to the node announcing its VIPs
      # (#3452); the DECIDED marker in roles/k8s/home-assistant/templates/deployment.yaml.j2
      # has why.
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_primary_node }}
      # Edge/auth/DNS eviction ordering — see setup/k3s templates/priorityclass.yaml.j2.
      # Starting as UID 1000 rather than root is why this needs none of the SETUID/SETGID
      # capabilities: the image's entrypoint only su-execs down to the authelia user when it
      # starts as root, and skips that path entirely otherwise.
      # fsGroup makes the config PVC writable for the SQLite database and notification file.
{{ pod_shell(containers_list | tier_priority_class('authelia'), run_as_user=puid, run_as_group=pgid, fs_group=pgid) }}
{# Two independent sources of init containers — CrowdSec's three seeding steps and the
   wait-for-redis gate — each with its own lever. Gate the KEY on either being on, so it is
   absent rather than left with no list under it. #}
{% if authelia_k8s_manage_crowdsec or authelia_k8s_redis_sessions | bool %}
      initContainers:
{% endif %}
{% if authelia_k8s_manage_crowdsec %}
{{ crowdsec_agent_init_containers('authelia', log_volume='authelia-logs', log_dir='/var/log/authelia', log_file='authelia.log', uid=puid, gid=pgid) }}
{% endif %}
{% if authelia_k8s_redis_sessions | bool %}
        # LAST, after CrowdSec's three seeding steps. Those write a local emptyDir and need no
        # network, so running them first overlaps their work with the policy lag this container
        # waits out, and it leaves the documented hub → config → data ordering untouched.
        #
        # Authelia writes a startup probe to the session backend, retries it 19 times at 500ms
        # and then EXITS (internal/session/provider.go, StartupCheck at v4.39.21) — about 9.5s
        # of tolerance. Deploying #1599 outran it: the portal restarted 7 times, blew the 300s
        # rollout wait twice and took SSO down for ~7 minutes (#1626).
        #
        # THE CAUSE IS NOT AN IMAGE PULL, which is what the comment beside the redis block in
        # config-secret.yaml.j2 claimed until this container shipped. The pod's log named an
        # `i/o timeout` rather than `connection refused`, and redis came up 1/1 on its first try
        # and has never restarted — so the packets were DROPPED. That is kube-router's
        # source-pod lookup lagging pod creation, already recorded in project memory, and it is
        # not a first-deploy-only event: it recurs whenever the redis pod is recreated on a node
        # (an eviction, a node reboot, a Renovate bump of authelia_k8s_redis_image). Each
        # occurrence takes SSO down under Recreate, including the tools to fix it.
        #
        # `redis-cli`, not `nc -z`. The sibling gates in crowdsec and n8n use busybox's `nc` and
        # justify it by their own image being busybox-based — that argument is about THEIR
        # image, not redis:7.4-alpine, and under Recreate the old pod is already gone, so an
        # init container that fails on a missing applet is an SSO outage rather than a retry.
        # `redis-cli` is unambiguously in the redis image, and this role already wires
        # REDISCLI_AUTH for the probes in deployment-redis.yaml.j2. Gate on PONG in the OUTPUT
        # rather than on the exit code: redis-cli exits 0 on a NOAUTH reply.
        #
        # Bounded, not unbounded — 60 x 2s, the same shape as crowdsec's wait-for-lapi. If redis
        # is still unreachable after two minutes this fails and the pod backs off exactly as it
        # does today, so it can only improve on the current behaviour, never mask a dead redis.
        - name: wait-for-redis
          image: {{ authelia_k8s_redis_image }}
          command:
            - /bin/sh
            - -c
            - >-
              i=0;
              until redis-cli -h authelia-redis -p 6379 ping 2>/dev/null | grep -q PONG; do
                i=$((i+1));
                [ "$i" -ge 60 ] && echo "authelia-redis still unreachable after 120s" >&2 && exit 1;
                sleep 2;
              done;
              echo "authelia-redis reachable after $((i*2))s"
          env:
            # The same Secret key the redis container's own probes read, for the same reason:
            # redis-cli takes the password from the environment, so it never reaches argv.
            - name: REDISCLI_AUTH
              valueFrom:
                secretKeyRef:
                  name: authelia-redis
                  key: REDISCLI_AUTH
          # read_only: the whole program is the shell loop above and it writes nothing. non_root
          # rather than leaning on the pod-level runAsUser, so the container carries its own
          # assertion — ansible/tests/k8s/test_container_security_context.py requires one here.
{{ hardened_security_context(read_only=true, non_root=true) }}
{{ container_resources(cpu_limit='100m', mem_limit='32Mi', cpu_request='10m', mem_request='16Mi') }}
{% endif %}
      containers:
        - name: authelia
          image: {{ authelia_k8s_image }}
          args:
            - --config
            - /secrets/configuration.yml
          ports:
            - name: http
              containerPort: {{ container_item.port }}
          env:
            - name: TZ
              value: "{{ tz }}"
          # NO readOnlyRootFilesystem, unlike traefik and bento-pdf. With it on, Authelia
          # dies during provider construction — before a single startup check runs — and
          # logs only an aggregate with no detail, at every level including trace:
          #   level=fatal msg="Errors occurred performing startup checks"
          # Measured on daniel-box: flipping this one field is the entire difference
          # between that and "Startup complete ... Listening ... on '0.0.0.0:9091'".
          # Config, the users database, /config's permissions, storage migration, DNS and
          # NTP egress were each verified good independently, so none of them is the cause.
          # It cannot be a plain permission problem either: as uid 1000 the process cannot
          # write anywhere outside its mounts in the WORKING case either, which leaves
          # EROFS-vs-EACCES on some path Authelia probes and never names.
          # The Docker role this was ported from sets no read_only, so dropping it is not a
          # regression against the instance being migrated — keeping it was the divergence.
{{ hardened_security_context(non_root=true) }}
          volumeMounts:
            # Config and the users database come from the Secret, mounted OUTSIDE /config so
            # the PVC can own /config for the database Authelia writes.
            - name: authelia-secrets
              mountPath: /secrets
              readOnly: true
            - name: authelia-config
              mountPath: /config
            # Kept even though the root filesystem is writable again: as uid 1000 the process
            # can write nowhere else outside its mounts, so scratch space still has to come
            # from somewhere.
            - name: authelia-tmp
              mountPath: /tmp
            # Shared with the crowdsec-agent sidecar below.
            - name: authelia-logs
              mountPath: /var/log/authelia
          readinessProbe:
            httpGet:
              path: /api/health
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /api/health
              port: http
            initialDelaySeconds: 20
            periodSeconds: 30
{{ container_resources(cpu_limit=authelia_k8s_cpu_limit, mem_limit=authelia_k8s_mem_limit, cpu_request=authelia_k8s_cpu_request, mem_request=authelia_k8s_mem_request) }}
{% if authelia_k8s_manage_crowdsec %}
        # Parses THIS pod's auth log into the in-cluster LAPI, so the failed-login scenarios
        # (LePresidente/authelia) cover the cluster portal.
{{ crowdsec_agent_sidecar('authelia', collections=authelia_k8s_agent_collections, log_volume='authelia-logs', log_dir='/var/log/authelia', cpu_limit=authelia_k8s_agent_cpu_limit, mem_limit=authelia_k8s_agent_mem_limit, cpu_request=authelia_k8s_agent_cpu_request, mem_request=authelia_k8s_agent_mem_request) }}
{% endif %}
      volumes:
        - name: authelia-secrets
          secret:
            secretName: authelia-config
            # 0440, not 0400: secret files are owned root:fsGroup, so a non-root container
            # reads them via the group bit. 0400 leaves the group nothing.
            defaultMode: 0440
        - name: authelia-config
          persistentVolumeClaim:
            claimName: authelia-config
        - name: authelia-tmp
          emptyDir: {}
        - name: authelia-logs
          emptyDir:
            sizeLimit: {{ authelia_k8s_log_size }}
{% if authelia_k8s_manage_crowdsec %}
{{ crowdsec_agent_volumes('authelia') }}
{% endif %}
