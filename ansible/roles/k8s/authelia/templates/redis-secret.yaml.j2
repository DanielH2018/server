---
# The redis session store's config and password. Rendered 0600 under `no_log` because it is in
# `manifests_secret_files`, the same way authelia-config is.
#
# A change to THIS file moves `checksum/restart` on the authelia-redis Deployment, which reads
# this Secret, so redis rolls onto the new config or password. It logs everyone out once.
apiVersion: v1
kind: Secret
metadata:
  name: authelia-redis
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  # Read by redis-cli in the readiness and liveness probes. Same value as `requirepass` below;
  # redis has one password, this is just the spelling redis-cli reads from the environment.
  REDISCLI_AUTH: "{{ authelia_redis_password }}"
  redis.conf: |
    requirepass {{ authelia_redis_password }}
    # No persistence, in either mechanism. `save ''` disables RDB snapshots and appendonly is
    # off by default; both are named so neither can be turned on by an image default changing.
    # The volume is an emptyDir, so a write here would be lost anyway — what this actually buys
    # is that session credentials never reach a disk.
    save ''
    appendonly no
    # Below the container memory limit so redis evicts rather than being OOM-killed, which
    # would drop every session at once instead of the oldest few. Every key here is a session,
    # so allkeys-lru is the right policy: Authelia re-authenticates a user whose key is gone.
    maxmemory {{ authelia_k8s_redis_maxmemory }}
    maxmemory-policy allkeys-lru
