---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: authelia-config
  namespace: {{ k8s_namespace }}
spec:
  # This is the volume slice 1's backup gate turns on — it holds the SQLite database with
  # TOTP secrets, WebAuthn devices and regulation records. Unlike Traefik's acme.json it is
  # not regenerable. It is covered by the `default`-group RecurringJob the k3s role installs;
  # a recurring-job-group label HERE would do nothing, because Longhorn reads those labels on
  # its own Volume CRs and PVC labels do not propagate to them.
  accessModes:
    - ReadWriteOnce
  storageClassName: longhorn
  resources:
    requests:
      storage: {{ authelia_k8s_storage }}
