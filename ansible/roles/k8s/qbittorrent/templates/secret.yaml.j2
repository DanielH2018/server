---
# The Mullvad credentials, as FILES rather than env vars — the same decision the Compose file
# made (2026-07-15 review L2) for the same reason: inlined as MULLVAD_PRIVATE_KEY they land in
# the container's environment, which anything able to read the pod spec can see. The LSIO base's
# init-envfile reads FILE__<VAR> from the file into <VAR> before the mullvad mod runs.
#
# `| trim` is load-bearing on both values: init-envfile does NOT strip a trailing newline (it
# only warns), and a newline corrupts the key or the account number.
#
# Rendered through manifests_secret_files, so the file on disk is 0600 and the task carries
# no_log.
apiVersion: v1
kind: Secret
metadata:
  name: qbittorrent-mullvad
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  key: "{{ wireguard_interface_private_key | trim }}"
  account: "{{ mullvad_account | trim }}"
