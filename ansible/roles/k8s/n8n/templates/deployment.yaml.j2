---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: n8n
  namespace: {{ k8s_namespace }}
spec:
  replicas: 1
  # Both PVCs are ReadWriteOnce and Longhorn runs one replica, so a rolling update would
  # deadlock: the new pod waits for a volume the old pod still holds.
  #
  # Recreate is also the only safe strategy for a SQLite writer. Two n8n processes against one
  # database.sqlite is corruption, and DB_SQLITE_VACUUM_ON_STARTUP rewrites the whole file.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: n8n
  template:
    metadata:
      labels:
        app: n8n
        # Opted OUT of the namespace baseline (slice 5). `networkpolicy.yaml.j2` (live name
        # `n8n-broker`) is tighter than the baseline, and the baseline is additive.
        #
        # This label belongs HERE and not in `deployment-runners.yaml.j2`: n8n-broker selects
        # `app: n8n` only, so n8n-runners has no bespoke policy and the baseline is the only
        # thing fencing it. Exempting the runners would unfence them with nothing to notice.
        netpol-baseline-exempt: "true"
    spec:
      enableServiceLinks: false
      automountServiceAccountToken: false
      priorityClassName: homelab-best-effort
      # Preference, never a pin: CPU-bound workflow execution — daniel-box has 16 threads to daniel-server's 8.
      # Weighted so the pod still schedules if daniel-box is cordoned or full.
      affinity:
        nodeAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              preference:
                matchExpressions:
                  - key: kubernetes.io/hostname
                    operator: In
                    values:
                      - daniel-box
      containers:
        - name: n8n
          image: {{ n8n_k8s_image }}
          # The registry tag is mutable by design (see defaults). Without Always, a rebuilt
          # image is never picked up: the node already has something called :latest.
          imagePullPolicy: Always
          ports:
            - containerPort: {{ container_item.port }}
            - containerPort: {{ n8n_k8s_broker_port }}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              # The compose template's cap_drop: ALL with no cap_add. The image runs as `node`
              # (uid 1000) and the seeded tree is uid 1000 too — tar restored it with
              # --numeric-owner — so nothing here needs CHOWN or DAC_OVERRIDE.
              drop:
                - ALL
          env:
            - name: TZ
              value: "{{ tz }}"
            - name: GENERIC_TIMEZONE
              value: "{{ tz }}"
            - name: NODE_ENV
              value: production
            # n8n builds absolute URLs from these, so both must be the hostname a browser and an
            # external webhook caller actually arrive on. N8N_WEBHOOK_URL is the load-bearing one:
            # third parties have already registered URLs against https://n8n.{{ domain }}/, and a
            # wrong value here does not fail at startup — the pod goes ready and every inbound
            # webhook is registered against a name nobody calls. Same treatment as karakeep's
            # NEXTAUTH_URL.
            #
            # N8N_WEBHOOK_URL, not WEBHOOK_URL: 2.33.5 logs `WEBHOOK_URL -> Use N8N_WEBHOOK_URL
            # instead, which sets the base URL for both test and production webhooks`. That wider
            # scope is safe here and does NOT re-expose /webhook-test/ — the dev endpoint is kept
            # off the public edge by a Traefik rule (bridge_bypass_prefixes lists /webhook/ only),
            # never by this variable. What it can change is the Test URL shown in the editor,
            # which n8n previously derived from N8N_HOST/N8N_PROTOCOL/N8N_PORT and now takes from
            # here; the production URL is unchanged because the value is the same.
            - name: N8N_HOST
              value: "{{ container_item.hostname | default(container_item.name) }}.{{ domain }}"
            - name: N8N_WEBHOOK_URL
              value: "https://{{ container_item.hostname | default(container_item.name) }}.{{ domain }}/"
            - name: N8N_PORT
              value: "{{ container_item.port }}"
            - name: N8N_PROTOCOL
              value: https
            # DECIDED: 2 hops, and it must not drop to 1. Getting this wrong does not break
            # routing; it makes n8n attribute every request to the wrong client IP, which is
            # what its login throttling and audit log key on. The two hops on a public request
            # are Cloudflare and the cluster Traefik — Cloudflare's ranges sit in
            # `forwardedHeaders.trustedIPs` on both entrypoints (see the traefik role's
            # cloudflare-ip-drift.sh.j2), so it is a trusted proxy that sets X-Forwarded-For
            # and counts. This is NOT a leftover from the Docker edge Traefik uninstalled
            # 2026-08-14; that host was never one of these two. An earlier version of this
            # comment said the opposite and invited exactly the change that breaks it.
            - name: N8N_PROXY_HOPS
              value: "2"
            - name: N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS
              value: "true"
            - name: N8N_RUNNERS_ENABLED
              value: "true"
            - name: NODE_RUNNERS_ENABLED
              value: "true"
            - name: N8N_RUNNERS_MODE
              value: external
            # Binds the broker on all interfaces (n8n has no per-interface bind option). Under
            # Compose that exposed it to `apps` siblings; here it would be every pod in
            # {{ k8s_namespace }}. networkpolicy.yaml.j2 is what actually narrows that to the
            # runners pod — the auth token below is the second layer, not the only one.
            - name: N8N_RUNNERS_BROKER_LISTEN_ADDRESS
              value: 0.0.0.0
            - name: N8N_NATIVE_PYTHON_RUNNER
              value: "true"
            - name: N8N_RUNNERS_TASK_REQUEST_TIMEOUT
              value: "300"
            # Keeps database.sqlite small (it once hit 840M of execution history, and its daily
            # page churn was the biggest single driver of B2 billable growth). Carried across
            # verbatim from the compose template, where the full reasoning lives.
            - name: EXECUTIONS_DATA_SAVE_ON_SUCCESS
              value: none
            - name: EXECUTIONS_DATA_PRUNE
              value: "true"
            - name: EXECUTIONS_DATA_MAX_AGE
              value: "72"
            - name: DB_SQLITE_VACUUM_ON_STARTUP
              value: "true"
            - name: N8N_RUNNERS_AUTH_TOKEN
              valueFrom:
                secretKeyRef:
                  name: n8n
                  key: N8N_RUNNERS_AUTH_TOKEN
          volumeMounts:
            - name: data
              mountPath: /home/node/.n8n
            - name: files
              mountPath: /files
            # n8n's .cache is re-derived (kopia's .cache/ rule).
            - name: cache
              mountPath: /home/node/.n8n/.cache
          # The compose healthcheck's endpoint, as an httpGet. /healthz answers 200 without
          # credentials — it is n8n's own liveness endpoint, not a routed one, so Authelia is
          # not in the path here.
          readinessProbe:
            httpGet:
              path: /healthz
              port: {{ container_item.port }}
            initialDelaySeconds: 30
            periodSeconds: 10
          # Generous initialDelay because DB_SQLITE_VACUUM_ON_STARTUP rewrites the whole
          # database before n8n listens. Killing it mid-vacuum is the one restart that can
          # leave the file in a state a restart does not fix.
          livenessProbe:
            httpGet:
              path: /healthz
              port: {{ container_item.port }}
            initialDelaySeconds: 120
            periodSeconds: 30
          resources:
            limits:
              cpu: "{{ n8n_k8s_cpu_limit }}"
              memory: {{ n8n_k8s_mem_limit }}
            requests:
              cpu: "{{ n8n_k8s_cpu_request }}"
              memory: {{ n8n_k8s_mem_request }}
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: {{ n8n_k8s_claim }}
        - name: files
          persistentVolumeClaim:
            claimName: {{ n8n_k8s_files_claim }}
        - name: cache
          emptyDir: {}
