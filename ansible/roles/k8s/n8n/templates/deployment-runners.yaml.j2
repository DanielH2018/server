{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: n8n-runners
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  selector:
    matchLabels:
      app: n8n-runners
  template:
    metadata:
      labels:
        app: n8n-runners
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      initContainers:
        # The compose template's `depends_on: n8n: condition: service_healthy`, which k8s has no
        # equivalent for. Connecting to the SERVICE rather than the pod is what makes this a gate
        # on readiness: a Service has no endpoints until its probe passes, so this cannot succeed
        # until n8n's /healthz does.
        #
        # Port 5679 rather than 5678 deliberately — that is the port the runner actually needs,
        # so this also proves the NetworkPolicy admits this pod. A gate on 5678 would pass while
        # the thing it is gating stayed unreachable.
        - name: wait-for-broker
          image: {{ n8n_k8s_wait_image }}
          command:
            - sh
            - -c
            - until nc -z n8n {{ n8n_k8s_broker_port }}; do sleep 5; done
{{ hardened_security_context() }}
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
      automountServiceAccountToken: false
      priorityClassName: homelab-best-effort
      # Preference, never a pin: CPU-bound workflow execution — daniel-box has 16 threads to daniel-server's 8.
      # Weighted so the pod still schedules if daniel-box is cordoned or full.
{{ node_affinity_preference(k8s_primary_node) }}
      containers:
        - name: n8n-runners
          image: {{ n8n_k8s_runners_image }}
          imagePullPolicy: Always
          # `USER runner` named in the comment below is an image property, so it is pinned here
          # rather than trusted. This is the workload where it matters most: it executes
          # arbitrary workflow code, so an image rebuild that moved the uid to 0 would hand
          # that code root. PID 1 (`tini`) measured at uid 1000 on 2026-08-31.
          # Executes arbitrary workflow code — the most code-exposed workload in the fleet,
          # so drop everything. The image ends `USER runner`, talks only to the broker, and
          # binds no port, so it needs none.
{{ hardened_security_context(non_root=true, run_as_user=1000) }}
          env:
            # Byte-identical to the compose template. `n8n` is a Service name here rather than a
            # Compose service key, and resolves the same way.
            - name: N8N_RUNNERS_TASK_BROKER_URI
              value: "http://n8n:{{ n8n_k8s_broker_port }}"
            - name: N8N_RUNNERS_AUTH_TOKEN
              valueFrom:
                secretKeyRef:
                  name: n8n
                  key: N8N_RUNNERS_AUTH_TOKEN
          # The compose healthcheck is `pgrep -f task-runner-launcher` — a liveness test with no
          # network component, which translates directly to exec. There is no HTTP endpoint to
          # probe: this workload listens on nothing.
          livenessProbe:
            exec:
              command:
                - pgrep
                - -f
                - task-runner-launcher
            initialDelaySeconds: 30
            periodSeconds: 30
{{ container_resources(cpu_limit=n8n_k8s_cpu_limit, mem_limit=n8n_k8s_mem_limit, cpu_request=n8n_k8s_cpu_request, mem_request=n8n_k8s_mem_request) }}
