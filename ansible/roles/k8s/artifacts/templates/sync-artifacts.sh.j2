#!/usr/bin/env bash
# Managed by ansible (roles/k8s/artifacts) — edits here are overwritten on the next deploy.
#
# Copy every other host's ~/.claude/artifacts onto daniel-box, one directory per host, so the
# artifacts Deployment can serve them all from a single hostPath tree. Pull rather than push:
# `daniel-box` does not resolve from daniel-server, and pushing would put an ssh key somewhere
# this one does not have to go.
set -euo pipefail

# Destination paths are written out per host below rather than through a shared variable:
# the peer list can be empty, and an unused variable is a shellcheck failure in the rendered
# script (validate/shell_templates.py renders with the loop unrolled to nothing).

# The lock and the per-peer failure counters. The override exists so the tests can run the
# rendered script against a temporary directory; cron passes nothing and gets /tmp, where a
# reboot clears every counter — which is the right reset, since a reboot ends any outage the
# counters were tracking.
state_dir="${SYNC_ARTIFACTS_STATE_DIR:-/tmp}"

# One sync at a time. The cron interval is far longer than a run, but a slow or hung ssh must
# not stack copies of rsync against the same destination.
exec 9>"${state_dir}/sync-artifacts.lock"
flock -n 9 || exit 0

status=0
# The Kuma verdict, pushed once after every peer has run (#2516). The tile goes DOWN only when a
# peer's streak has reached the same threshold that mails, so a peer that is briefly off stays UP
# with its streak named in the message.
verdict=up
report=""
{% for peer in artifacts_peer_sources %}
# --delete, so an artifact pruned on {{ peer.name }} stops being served here too; the index
# would otherwise keep offering links to documents that no longer exist anywhere.
# ConnectTimeout keeps a rebooting peer from holding the lock for the whole interval, and
# BatchMode makes a missing key fail rather than prompt.
# ClearAllForwardings drops any LocalForward this host's ~/.ssh/config attaches to
# {{ peer.ssh_target }}: rsync's transport needs no forwarding, and a forward whose local port is
# already held fails the whole ssh with "bind [127.0.0.1]:<port>: Address already in use"
# rather than just declining the tunnel (#2467).
if rsync -a --delete --timeout=60 \
    -e 'ssh -o BatchMode=yes -o ConnectTimeout=10 -o ClearAllForwardings=yes' \
    "{{ peer.ssh_target }}:{{ peer.path }}/" "{{ artifacts_peer_dir }}/{{ peer.name }}/"; then
  # A run that recovers says so in the journal and forgets the streak, so the next outage
  # starts counting from zero rather than inheriting the last one's total.
  if [ -f "${state_dir}/sync-artifacts-{{ peer.name }}.fails" ]; then
    logger -t sync-artifacts "{{ peer.name }} recovered after \
$(cat "${state_dir}/sync-artifacts-{{ peer.name }}.fails") failed run(s)"
    rm -f "${state_dir}/sync-artifacts-{{ peer.name }}.fails"
  fi
  report="${report:+$report; }{{ peer.name }} synced"
else
  # DECIDED: a failure goes to the journal, and only the run that REACHES the threshold writes
  # to stderr, which is what cron mails. The old script mailed every failure: 145 messages
  # reached /var/mail/ubuntu between 2026-08-20 and 2026-09-24, nobody reads that spool, and a
  # peer that is simply powered off is the common case. Alerting once per outage keeps the mail
  # as an alert without making it a log. The Kuma push after the loop is the monitor (#2516); the
  # mail stays as the one alert that does not depend on Kuma being up.
  fails=$(( $(cat "${state_dir}/sync-artifacts-{{ peer.name }}.fails" 2>/dev/null || echo 0) + 1 ))
  echo "$fails" > "${state_dir}/sync-artifacts-{{ peer.name }}.fails"
  logger -t sync-artifacts "{{ peer.name }} failed (consecutive run $fails)"
  # The threshold is artifacts_sync_alert_after_failures in the role's defaults, which carries
  # the reasoning for the number. Interpolated at its use site rather than held in a variable:
  # the peer list can be empty, and an unused variable fails shellcheck in the rendered script.
  if [ "$fails" -eq {{ artifacts_sync_alert_after_failures }} ]; then
    echo "sync-artifacts: {{ peer.name }} has failed $fails consecutive runs" >&2
  fi
  # -ge, not the -eq the mail uses: the mail fires once per outage, but the tile must stay DOWN
  # on every run past the threshold, or it would go green again in the middle of the outage.
  if [ "$fails" -ge {{ artifacts_sync_alert_after_failures }} ]; then
    verdict=down
    report="${report:+$report; }{{ peer.name }} failed $fails consecutive runs"
  else
    report="${report:+$report; }{{ peer.name }} failed $fails consecutive run(s), DOWN at \
{{ artifacts_sync_alert_after_failures }}"
  fi
  status=1
fi
{% endfor %}

# DECIDED: no file-age staleness check. rsync -a copies the peer's own mtimes and the peer prunes
# at 7 days, so the newest file's age measures how often sessions on the peer write artifacts,
# not whether this sync runs — a quiet week on daniel-server would page. A successful rsync
# --delete leaves the mirror equal to the peer by construction, so the failure streak covers a
# broken transport and the push deadline covers a cron that stopped running at all.
#
# A missing library skips the push rather than exiting: the sync is the job and the push only
# reports on it. Silence then turns the tile DOWN at its deadline. The override exists for the
# tests, which must not push to the live Kuma from a host that has the real library.
kuma_lib="${SYNC_ARTIFACTS_KUMA_LIB:-/usr/local/lib/kuma-push-lib.sh}"
if [ -r "$kuma_lib" ]; then
  # shellcheck source=/dev/null
  source "$kuma_lib"
  kuma_push "$verdict" "${report:-no peers configured}" \
    "https://uptime-kuma.local.{{ domain }}/api/push/{{ artifacts_sync_push_token }}" \
    "uptime-kuma.local.{{ domain }}" "{{ k3s_metallb_ingress_vip }}" sync-artifacts
else
  logger -t sync-artifacts "$kuma_lib missing, no Kuma verdict pushed; run initial_setup on this host"
fi

exit "$status"
