{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: autofix-bridge
  namespace: {{ k8s_namespace }}
spec:
  # One remediation actor at a time: the candidate-grace streaks are in-process, and two
  # pods could each independently act on the same queue item.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: autofix-bridge
  template:
    metadata:
      labels:
        app: autofix-bridge
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-best-effort', run_as_user=puid, run_as_group=pgid, non_root=true) }}
      # Off daniel-server for the same reason as the monitor-bridge twin: the drain and
      # its cold boot must not take the remediation loop down alongside the Docker estate.
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_primary_node }}
      containers:
        - name: autofix-bridge
          image: {{ autofix_bridge_k8s_image }}
          command: ["python", "/app/autofix.py"]
          ports:
            - name: checks
              containerPort: {{ containers_list | metrics_port('autofix-bridge') }}
{{ hardened_security_context(read_only=true) }}
          # The settings, as plain values; the credentials come from env-secret.yaml.j2. A
          # quoted number belongs here, never in the Secret: Flux's typed patch reads a
          # Secret's "300" back as a number and refuses it (#5574). Only what CHANGED in the
          # move from the Docker compose template is commented.
          env:
            - name: TZ
              value: "{{ tz }}"
            - name: PYTHONUNBUFFERED
              value: "1"
            - name: PYTHONDONTWRITEBYTECODE
              value: "1"
            - name: INTERVAL
              value: "300"
            # The port the check exporter serves /metrics on (jobs_metrics.py, through
            # autofix.py): the `autofix-bridge` item on this role's containers_list entry, which
            # also renders the scrape job and the Service port (M6 batch B7).
            - name: CHECK_EXPORTER_PORT
              value: "{{ containers_list | metrics_port('autofix-bridge') }}"
            # In-cluster Service names replace the -k8s LAN routes (same move as the
            # monitor-bridge twin): no VIP, no Traefik, no monitoring IngressRoute in the path.
            - name: KUMA_URL
              value: http://uptime-kuma.{{ k8s_namespace }}.svc.cluster.local:{{ containers_list | entry_port('uptime-kuma') }}
            # LIVE remediation, carried over unchanged — the operator flipped it 2026-07-06 and
            # the autonomous-role contract (this role's CLAUDE.md) governs any change here.
            - name: DRY_RUN
              value: "false"
            - name: GRACE_CYCLES
              value: "3"
            - name: MAX_ACTIONS_PER_CYCLE
              value: "5"
            - name: DANGEROUS_MSG_PATTERNS
              value: executable file with extension,potentially dangerous,sample
            - name: SONARR_URL
              value: http://sonarr.{{ k8s_namespace }}.svc.cluster.local:8989
            - name: RADARR_URL
              value: http://radarr.{{ k8s_namespace }}.svc.cluster.local:7878
          envFrom:
            - secretRef:
                name: autofix-bridge-env
          # autofix.py touches /tmp/heartbeat after every completed cycle; a stale mtime
          # means the loop HUNG. Same contract as the Docker healthcheck+autoheal pair.
          livenessProbe:
            exec:
              command:
                - python3
                - -c
                - "import os,sys,time; sys.exit(0 if time.time()-os.stat('/tmp/heartbeat').st_mtime<1000 else 1)"
            initialDelaySeconds: 120
            periodSeconds: 60
            failureThreshold: 3
          volumeMounts:
            - name: autofix-bridge-script
              mountPath: /app
              readOnly: true
            - name: autofix-bridge-tmp
              mountPath: /tmp
          # 1 core, not 100m: a periodic poller wakes, bursts, and sleeps, so a 100m quota —
          # 10ms of every 100ms period — is exhausted by a sub-second burst while the minute
          # average reads near zero. Throttled on 45.8% of CFS periods, measured 2026-08-29,
          # against p95 usage of 0.0015 cores. On a cluster burning ~1.5 of 24 cores the
          # request is what earns this pod CPU under contention; the limit only clipped
          # bursts. Requests and the memory limit are unchanged.
{{ container_resources(cpu_limit='1', mem_limit='64Mi', cpu_request='20m', mem_request='32Mi') }}
      volumes:
        - name: autofix-bridge-script
          configMap:
            # templates/script-configmap.yaml.j2. Flat keys mounted back at their paths -- see
            # monitor-bridge's deployment for why.
            name: autofix-bridge-script
            items:
{% for item in autofix_bridge_modules %}
              - key: {{ item.name }}
                path: {{ item.path }}
{% endfor %}
        - name: autofix-bridge-tmp
          emptyDir: {}
