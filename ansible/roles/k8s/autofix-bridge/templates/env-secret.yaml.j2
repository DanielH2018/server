---
# The sidecar's credentials, as a Secret (API keys + webhook + push token). Every other
# setting is a plain `env:` value in deployment.yaml.j2: a Secret's quoted numeric
# literals fail Flux's typed patch (#5574). Reasoning for each knob lives on the Docker
# compose template this ports, which #2385 deleted: `git show
# 2460d0675fd748e70fcbcde87185371ffd62402b:ansible/roles/containers/archive/autofix-bridge/templates/docker-compose.yml.j2`.
apiVersion: v1
kind: Secret
metadata:
  name: autofix-bridge-env
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  SONARR_API_KEY: "{{ sonarr_api_key }}"
  RADARR_API_KEY: "{{ radarr_api_key }}"
  ARR_DISCORD_WEBHOOK_URL: "{{ arr_discord_webhook_url }}"
  KUMA_PUSH_ARR_AUTOBLOCK: "{{ arr_autoblock_push_token }}"
