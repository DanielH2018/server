---
# The sidecar's env, as a Secret (API keys + webhook + push token). Reasoning for each
# knob lives on the Docker compose template this ports
# (roles/containers/autofix-bridge/templates/docker-compose.yml.j2); only what CHANGED
# in the move is commented here.
apiVersion: v1
kind: Secret
metadata:
  name: autofix-bridge-env
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  TZ: "{{ tz }}"
  PYTHONUNBUFFERED: "1"
  PYTHONDONTWRITEBYTECODE: "1"
  INTERVAL: "300"
  # In-cluster Service names replace the -k8s LAN routes (same move as the
  # monitor-bridge twin): no VIP, no Traefik, no monitoring IngressRoute in the path.
  KUMA_URL: http://uptime-kuma.{{ k8s_namespace }}.svc.cluster.local:3001
  # LIVE remediation, carried over unchanged — the operator flipped it 2026-07-06 and
  # the autonomous-role contract (containers role CLAUDE.md) governs any change here.
  DRY_RUN: "false"
  GRACE_CYCLES: "3"
  MAX_ACTIONS_PER_CYCLE: "5"
  DANGEROUS_MSG_PATTERNS: executable file with extension,potentially dangerous,sample
  CLIENT_ERROR_PATTERNS: unable to communicate,not responding,failed to connect,connection refused,download client is unavailable
  SONARR_URL: http://sonarr.{{ k8s_namespace }}.svc.cluster.local:8989
  SONARR_API_KEY: "{{ sonarr_api_key }}"
  RADARR_URL: http://radarr.{{ k8s_namespace }}.svc.cluster.local:7878
  RADARR_API_KEY: "{{ radarr_api_key }}"
  ARR_DISCORD_WEBHOOK_URL: "{{ arr_discord_webhook_url }}"
  KUMA_PUSH_ARR_AUTOBLOCK: "{{ arr_autoblock_push_token }}"
