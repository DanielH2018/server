{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: terraria
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  # RWO config PVC on single-replica Longhorn — a rolling update deadlocks on the volume,
  # and two servers writing one world would be worse than the deadlock.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: terraria
  template:
    metadata:
      labels:
        app: terraria
        netpol-baseline: enforced
    spec:
      # Pinned to the VIP-announcing node while the MetalLB L2Advertisement is pinned
      # to daniel-box: with externalTrafficPolicy Local, a VIP-backed pod on the other
      # node makes the announcer DROP all forwarded LAN traffic (2026-08-14 post-boot
      # DNS blackout). DECIDED: permanent posture (operator 2026-08-14) — with ETP Local
      # load-bearing for client IPs, announcement and placement stay on one node as a
      # unit; this pin only ever moves together with the L2Advertisement nodeSelector.
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_primary_node }}
      enableServiceLinks: false
      automountServiceAccountToken: false
      # Runs as 1000, which is what lets the capability set below be empty. The volume is
      # uid-1000-owned from the cutover seed and measured 1000:1000 on 2026-08-31, so the server
      # now writes its own data as its owner rather than overriding the permission check to reach
      # it. The image cannot do this unmodified — see templates/Dockerfile.j2.
      #
      # fsGroup is separately load-bearing and must not be dropped as redundant. Each world-save
      # rewrites .wld.bak, and the ones on the volume today were created by the OLD root process,
      # so they sit 0:0 644 and a uid-1000 truncate would EACCES on the backup step — the exact
      # failure the removed DAC_OVERRIDE comment warned about. fsGroup has the kubelet chown the
      # volume's group and OR in group-write at every mount, which fixes them declaratively where
      # a one-shot chown would drift back. Same mechanism valheim-stats documents on its own
      # Longhorn claim.
      securityContext:
        runAsUser: {{ puid }}
        runAsGroup: {{ pgid }}
        runAsNonRoot: true
        fsGroup: {{ pgid }}
      priorityClassName: homelab-standard
      containers:
        - name: terraria
          image: {{ terraria_k8s_image }}
          # Rolling tier: the registry tag is rebuilt in place by image-builder, so pod
          # creation must re-pull. Explicit rather than left to the `:latest` default, because
          # the API server defaults this field only when it is ABSENT at create time — this
          # Deployment was created with an upstream `@sha256:` pin, which defaulted it to
          # IfNotPresent, and a later apply that changed only `image` left that value in
          # place. The 2026-09-02 digest bump rebuilt the image, rolled the pod, and the node
          # reused its cached `:latest`; the drift gate in post_tasks/ caught it.
          imagePullPolicy: Always
          # The image's console wants a TTY + open stdin (compose parity: stdin_open/tty).
          stdin: true
          tty: true
          ports:
            - containerPort: 7777
          # Empty, and the pod-level uid above plus the chowned image is what earns that.
          # This carried DAC_OVERRIDE until 2026-08-31, because PID 1 ran as root in a
          # uid-1000-owned /config where root cannot create or unlink without it. Running as
          # the owner removed the need rather than the symptom.
          #
          # WHAT TO WATCH IF THIS REGRESSES: the failure lands on the world-save backup step,
          # not at startup, so a Running pod proves nothing — that is how the Docker-era
          # version of this bug survived 39 restarts over 11 days. The signal is a complete
          # `Saving world data … Validating world save … Backing up world file` cycle in the
          # log, which fires every 1-2 min, plus new .wld.bak files owned by 1000.
{{ hardened_security_context() }}
          volumeMounts:
            - name: terraria-config
              mountPath: /config
          # Liveness = a LISTEN socket on 7777 in the kernel table, NOT a connect probe:
          # the binary protocol logs every accepted socket as "<ip> is connecting...", so
          # a tcpSocket probe would spam the game console ~2900x/day. 1E61 = hex 7777.
          # The startup probe covers the ~74s world-load before the port binds; a
          # first-boot world GENERATION can exceed it but the seed ships existing worlds.
          startupProbe:
            exec:
              command: ["bash", "-c", "grep -q ':1E61 [0-9A-F]*:0000 0A ' /proc/net/tcp"]
            periodSeconds: 10
            failureThreshold: 30
          livenessProbe:
            exec:
              command: ["bash", "-c", "grep -q ':1E61 [0-9A-F]*:0000 0A ' /proc/net/tcp"]
            periodSeconds: 30
{{ container_resources(cpu_limit=terraria_k8s_cpu_limit, mem_limit=terraria_k8s_mem_limit, cpu_request=terraria_k8s_cpu_request, mem_request=terraria_k8s_mem_request) }}
      volumes:
        - name: terraria-config
          persistentVolumeClaim:
            claimName: {{ terraria_k8s_claim }}
