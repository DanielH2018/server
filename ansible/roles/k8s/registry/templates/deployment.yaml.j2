{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: registry
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  # Recreate, for two independent reasons that both bite here: the PVC is ReadWriteOnce, and
  # the hostPort below is node-exclusive. A rolling update would leave the new pod Pending on
  # a port the old pod still holds, and the rollout would sit there until it timed out.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: registry
  template:
    metadata:
      labels:
        app: registry
        # Opted OUT of the namespace baseline (slice 5). `networkpolicy.yaml.j2` is tighter than
        # the baseline, and the baseline is additive — selecting this pod would widen it.
        netpol-baseline-exempt: "true"
    spec:
      # Pinned to the registry node by design (2026-08-14 re-plumb): its loopback
      # hostPort and its RWO PVC both live here, and every node's registries.yaml mirror
      # (loopback on this node, pinned ClusterIP on agents) assumes it.
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_registry_node }}
      enableServiceLinks: false
      securityContext:
        # The registry image runs as root by default and writes to /var/lib/registry. fsGroup
        # gives the unprivileged user access to the Longhorn volume at mount time, so it does
        # not need to chown a volume it does not own.
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
      automountServiceAccountToken: false
      priorityClassName: homelab-critical
      containers:
        - name: registry
          image: {{ registry_k8s_image }}
          ports:
            - containerPort: {{ k8s_registry_port }}
              # Loopback only. Without hostIP this binds 0.0.0.0 and an unauthenticated,
              # plain-HTTP registry becomes writable by anything on the LAN.
              hostIP: {{ k8s_registry_host_ip }}
              hostPort: {{ k8s_registry_port }}
{{ hardened_security_context(read_only=true, non_root=true) }}
          env:
            # registry:3.1.1 ships `debug` as its baked-in default, so leaving this unset does not
            # mean "the image's sensible default" — it means a full OTEL span JSON blob and an
            # `authorizing request` line on every single request, for a registry that exists to
            # serve n8n's rebuilds. Confirmed live 2026-08-29: the pod was logging level=debug with
            # no OTLP endpoint configured anywhere, so the spans were being formatted and thrown away.
            #
            # `info` keeps what is actually read. The `response completed` lines carry the status
            # and are info-level, and the Combined-Log-Format access line comes from a separate
            # accesslog middleware gated by its own `disabled` flag rather than by log.level.
            - name: REGISTRY_LOG_LEVEL
              value: info
            - name: REGISTRY_STORAGE_FILESYSTEM_ROOTDIRECTORY
              value: /var/lib/registry
            # Without this a deleted tag leaves its blobs behind forever, and the volume only
            # ever grows. n8n rebuilds on every image bump, so that is a steady leak.
            - name: REGISTRY_STORAGE_DELETE_ENABLED
              value: "true"
          volumeMounts:
            - name: registry-data
              mountPath: /var/lib/registry
          readinessProbe:
            httpGet:
              path: /v2/
              port: {{ k8s_registry_port }}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /v2/
              port: {{ k8s_registry_port }}
            initialDelaySeconds: 15
            periodSeconds: 30
{{ container_resources(cpu_limit='500m', mem_limit='512Mi', cpu_request='50m', mem_request='64Mi') }}
      volumes:
        - name: registry-data
          persistentVolumeClaim:
            claimName: {{ registry_k8s_claim }}
