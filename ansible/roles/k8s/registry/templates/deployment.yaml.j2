{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: registry
  namespace: {{ k8s_namespace }}
spec:
  # Recreate, for two independent reasons that both bite here: the PVC is ReadWriteOnce, and
  # the hostPort below is node-exclusive. A rolling update would leave the new pod Pending on
  # a port the old pod still holds, and the rollout would sit there until it timed out.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: registry
  template:
    metadata:
      labels:
        app: registry
        # Opted OUT of the namespace baseline (slice 5). `networkpolicy.yaml.j2` is tighter than
        # the baseline, and the baseline is additive — selecting this pod would widen it.
        netpol-baseline-exempt: "true"
    spec:
      # Pinned to the registry node by design (2026-08-14 re-plumb): its loopback
      # hostPort and its RWO PVC both live here, and every node's registries.yaml mirror
      # (loopback on this node, pinned ClusterIP on agents) assumes it.
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_registry_node }}
      # The registry image runs as root by default and writes to /var/lib/registry. fsGroup
      # gives the unprivileged user access to the Longhorn volume at mount time, so it does
      # not need to chown a volume it does not own.
{{ pod_shell(containers_list | tier_priority_class('registry'), run_as_user=1000, run_as_group=1000, fs_group=1000) }}
      containers:
        - name: registry
          image: {{ registry_k8s_image }}
          ports:
            - containerPort: {{ k8s_registry_port }}
              # Loopback only. Without hostIP this binds 0.0.0.0 and an unauthenticated,
              # plain-HTTP registry becomes writable by anything on the LAN.
              hostIP: {{ k8s_registry_host_ip }}
              hostPort: {{ k8s_registry_port }}
{{ hardened_security_context(read_only=true, non_root=true) }}
          env:
            # registry:3.1.1 ships `debug` as its baked-in default, so leaving this unset does not
            # mean "the image's sensible default" — it means a full OTEL span JSON blob and an
            # `authorizing request` line on every single request, for a registry that exists to
            # serve n8n's rebuilds. Confirmed live 2026-08-29: the pod was logging level=debug with
            # no OTLP endpoint configured anywhere, so the spans were being formatted and thrown away.
            #
            # `info` keeps what is actually read. The `response completed` lines carry the status
            # and are info-level, and the Combined-Log-Format access line comes from a separate
            # accesslog middleware gated by its own `disabled` flag rather than by log.level.
            - name: REGISTRY_LOG_LEVEL
              value: info
            - name: REGISTRY_STORAGE_FILESYSTEM_ROOTDIRECTORY
              value: /var/lib/registry
            # Without this a deleted tag leaves its blobs behind forever, and the volume only
            # ever grows. n8n rebuilds on every image bump, so that is a steady leak.
            - name: REGISTRY_STORAGE_DELETE_ENABLED
              value: "true"
          volumeMounts:
            - name: registry-data
              mountPath: /var/lib/registry
          readinessProbe:
            httpGet:
              path: /v2/
              port: {{ k8s_registry_port }}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /v2/
              port: {{ k8s_registry_port }}
            initialDelaySeconds: 15
            periodSeconds: 30
{{ container_resources(cpu_limit='500m', mem_limit='512Mi', cpu_request='50m', mem_request='64Mi') }}
        # The pull-through mirror of ghcr.io (D5 Open question 2). k3s's registries.yaml names
        # it as the `ghcr.io` mirror, so containerd pulls a flux-owned GHCR image through it and
        # a node keeps a LAN copy for a cold start during a WAN outage. nut is the reason: its
        # pod is half of the UPS shutdown chain, and WAN outages arrive with power events.
        #
        # DECIDED: a second container, not REGISTRY_PROXY_* on the one above. A registry in
        # proxy mode refuses every manifest Put and Delete (`proxyManifestStore` returns
        # ErrUnsupported in distribution v3.1.2), which would break every image-builder push
        # and registry-gc.sh's untag DELETEs. A sidecar rather than its own Deployment keeps
        # the pinned ClusterIP, the node pin, the NetworkPolicy and the PVC this role already
        # has. Two costs. registry-gc.sh scales this pod to zero for up to
        # registry_k8s_gc_deadline_s every Sunday, and containerd falls back to ghcr.io then.
        # And a mirror container that cannot start leaves the whole pod unready, which takes
        # the push store's Service endpoint down with it.
        - name: ghcr-mirror
          image: {{ registry_k8s_image }}
          ports:
            - containerPort: {{ k8s_registry_ghcr_mirror_port }}
              # Loopback only, for the same reason as the push store's hostPort above.
              hostIP: {{ k8s_registry_host_ip }}
              hostPort: {{ k8s_registry_ghcr_mirror_port }}
{{ hardened_security_context(read_only=true, non_root=true) }}
          env:
            - name: REGISTRY_LOG_LEVEL
              value: info
            - name: REGISTRY_HTTP_ADDR
              value: ":{{ k8s_registry_ghcr_mirror_port }}"
            # The baked config binds the debug server to :5001, and both containers share the
            # pod's network namespace. Without this the second bind fails and the mirror
            # crash-loops.
            - name: REGISTRY_HTTP_DEBUG_ADDR
              value: "127.0.0.1:{{ registry_k8s_ghcr_mirror_debug_port }}"
            - name: REGISTRY_STORAGE_FILESYSTEM_ROOTDIRECTORY
              value: /var/lib/registry
            - name: REGISTRY_PROXY_REMOTEURL
              value: https://ghcr.io
            # Never expire. The default 168h would drop nut's image a week after its last
            # rebuild, which is the cold pull during a WAN outage this mirror exists for.
            # distribution's proxyregistry.go reads a zero TTL as "never expire". The weekly
            # GC's offline prune (files/ghcr-mirror-prune.sh) is what bounds the store instead.
            - name: REGISTRY_PROXY_TTL
              value: "0s"
          # Its own claim, not registry-data. Every ghcr.io image in the cluster pulls through
          # here, not only danielh2018's, and nothing expires them, so a shared volume would
          # fill and fail the push store's builds too. The push store's GC Job mounts only
          # registry-data; the mirror's own GC Job mounts only this.
          volumeMounts:
            - name: ghcr-mirror-data
              mountPath: /var/lib/registry
          # `/v2/` answers from the local handler, so neither probe depends on ghcr.io being
          # reachable. A probe that did would mark the whole pod unready in a WAN outage and
          # take the push store's Service endpoint down with it.
          readinessProbe:
            httpGet:
              path: /v2/
              port: {{ k8s_registry_ghcr_mirror_port }}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /v2/
              port: {{ k8s_registry_ghcr_mirror_port }}
            initialDelaySeconds: 15
            periodSeconds: 30
{{ container_resources(cpu_limit='500m', mem_limit='256Mi', cpu_request='20m', mem_request='32Mi') }}
      volumes:
        - name: registry-data
          persistentVolumeClaim:
            claimName: {{ registry_k8s_claim }}
        - name: ghcr-mirror-data
          persistentVolumeClaim:
            claimName: {{ registry_k8s_ghcr_mirror_claim }}
