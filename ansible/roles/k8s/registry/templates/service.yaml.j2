---
apiVersion: v1
kind: Service
metadata:
  name: registry
  namespace: {{ k8s_namespace }}
spec:
  # Pinned so agents' /etc/rancher/k3s/registries.yaml can name it as the mirror endpoint:
  # containerd is a host process that resolves no cluster DNS, and an auto-assigned
  # ClusterIP would silently change on Service recreate, stranding every agent-side pull.
  clusterIP: {{ k8s_registry_cluster_ip }}
  selector:
    app: registry
  # Named because a Service with two ports requires it. The second is the ghcr.io
  # pull-through mirror, which agents' registries.yaml reaches on this same ClusterIP.
  ports:
    - name: registry
      port: {{ k8s_registry_port }}
      targetPort: {{ k8s_registry_port }}
    - name: ghcr-mirror
      port: {{ k8s_registry_ghcr_mirror_port }}
      targetPort: {{ k8s_registry_ghcr_mirror_port }}
