#!/usr/bin/env bash
# Registry garbage collection — managed by Ansible (k8s/registry role); edits overwritten.
#
# WHY THIS EXISTS: deployment.yaml.j2 sets REGISTRY_STORAGE_DELETE_ENABLED=true, which only
# PERMITS deletes — the registry never collects on its own. Nothing ever ran garbage-collect, so
# every rebuild's superseded layers accumulated until registry-data hit 99.8% of 10 GiB on
# 2026-08-15 and every image build in the cluster failed with "no space left on device". At that
# point all eight repositories held exactly one tag each, so the live content was a handful of
# images and the rest was orphaned blobs.
#
# STOP-THE-WORLD, NOT OPTIONAL. Upstream: "You should ensure that the registry is in read-only
# mode or not running at all. If you were to upload an image while garbage collection is running,
# there is the risk that the image's layers are mistakenly deleted leading to a corrupted image."
# That failure is worse than it sounds here: a corrupt image still PULLS, and only crashloops the
# workload later, with nothing pointing back at GC. The volume is longhorn-nobackup because
# losing it costs a rebuild rather than data — that tolerance covers losing the volume, NOT
# silently serving a broken image. Hence scale-to-0 for the duration.
#
# ROOT KUBECONFIG, unlike every sibling script deployed by this repo. disk-health.sh,
# longhorn-backup-health.sh and manifest-prune-check.sh all use the read-only ServiceAccount
# precisely so a bug there cannot mutate the cluster. This one MUST scale a Deployment, so it
# holds a credential that can. Everything it does is scoped to the registry Deployment and its
# own Job; keep it that way.
#
# Usage: registry-gc.sh (no arguments)
# Runs from the registry-gc root cron on daniel-box, weekly at the time set by
# registry_k8s_gc_cron_weekday, _hour and _minute. It collects the two stores one after the
# other, and each phase scales only its own Deployment. The push store's phase scales
# deploy/registry to 0 and runs /etc/rancher/k3s/manifests/registry-jobs/gc-job.yaml. The
# ghcr-mirror store's phase scales deploy/ghcr-mirror to 0 and runs ghcr-mirror-gc-job.yaml from
# the same directory, the prune and garbage-collect. It pushes the combined result to Kuma when
# registry_gc_push_token is set. It reads /etc/rancher/k3s/k3s.yaml and
# /usr/local/lib/kuma-push-lib.sh, and keeps its state in /var/lib/registry-gc.

set -uo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

# shellcheck source=/dev/null
source /usr/local/lib/kuma-push-lib.sh || {
  logger -t registry-gc "kuma-push-lib.sh missing — run initial_setup on this host"
  exit 1
}

# Cron's default PATH (/usr/bin:/bin) omits /usr/local/bin, where the k3s installer puts the
# binary. Without this every kubectl call below silently resolves to nothing.
export PATH="/usr/local/bin:${PATH}"
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml

NS="{{ k8s_namespace }}"
KUBECTL="k3s kubectl -n ${NS}"
DEPLOY=registry
MIRROR_DEPLOY=ghcr-mirror
JOB=registry-gc
MIRROR_JOB=registry-gc-ghcr-mirror
MIRROR_KEEP_CM=registry-gc-ghcr-mirror-keep
MIRROR_STARTED=0
MIRROR_DONE=0
MIRROR_NOTE=""
JOB_MANIFEST=/etc/rancher/k3s/manifests/registry-jobs/gc-job.yaml
MIRROR_JOB_MANIFEST=/etc/rancher/k3s/manifests/registry-jobs/ghcr-mirror-gc-job.yaml
# Set while that phase's Deployment may be scaled down, so the EXIT trap knows what to restore.
PUSH_DOWN=0
MIRROR_DOWN=0
PUSH_MSG=""
MIRROR_MSG=""
FAILED=0
COMPLETED=0
STATE_DIR=/var/lib/registry-gc
STATE_FILE="${STATE_DIR}/state.json"

KUMA_HOST="uptime-kuma.local.{{ domain }}"
KUMA_RESOLVE_IP="{{ k3s_metallb_ingress_vip }}"
PUSH_TOKEN="{{ registry_gc_push_token | default('') }}"

# The registry's own HTTP API, reached the way the image-builder role's registry reads reach it:
# the hostPort on the loopback address. Untagging is an API call, not something the GC binary does.
REG="http://{{ k8s_registry_host_ip }}:{{ k8s_registry_port }}"
MANIFEST_ACCEPT='application/vnd.oci.image.manifest.v1+json,application/vnd.docker.distribution.manifest.v2+json'
KEEP_CONTENT_TAGS={{ registry_k8s_keep_content_tags }}
PRUNED=0

STATUS=down
MSG="did not complete"

finish() {
  mkdir -p "$STATE_DIR"
  # jq, not printf: MSG carries crane and kubectl error text, and a backslash, newline or
  # control character in it made the file unreadable by the jq an operator reads it with (#4606).
  jq -nc --arg ts "$(date -Is)" --arg status "$STATUS" --arg msg "$MSG" \
    '{ts: $ts, status: $status, msg: $msg}' > "$STATE_FILE"
  # Explicit, because root's umask here renders this 0640 and the operator reading it after a
  # run is not root. Nothing secret is in it — a status, a timestamp and a count.
  chmod 0644 "$STATE_FILE"

  if [[ -n "$PUSH_TOKEN" ]]; then
    kuma_push "$STATUS" "$MSG" "https://${KUMA_HOST}/api/push/${PUSH_TOKEN}" \
      "$KUMA_HOST" "$KUMA_RESOLVE_IP" registry-gc
  else
    logger -t registry-gc "registry_gc_push_token not set — skipping push (see /add-secret)"
  fi

  # Off-premises dead-man's switch — see longhorn-backup-health.sh.j2 for the full rationale.
  # Kuma runs on the cluster this mutates, so a cluster outage silences both the push above and
  # the monitor waiting for it. Skipped when no key is configured.
  # Names mirror longhorn-backup-health.sh.j2 exactly: test_healthchecks_pings.py selects the
  # files it audits by matching HC_PING_KEY / HC_URL, so a locally-renamed variable drops this
  # script out of the parametrization and the guards silently stop being checked.
  local HC_PING_KEY=""
  # shellcheck source=/dev/null
  [[ -r /etc/healthchecks/ping.env ]] && . /etc/healthchecks/ping.env
  if [[ -n "$HC_PING_KEY" ]]; then
    local HC_URL="https://hc-ping.com/${HC_PING_KEY}/registry-gc"
    [[ "$STATUS" == "up" ]] || HC_URL="${HC_URL}/fail"
    # No `-S`, stderr discarded — see longhorn-backup-health.sh.j2 (#2511).
    curl -fs --max-time 10 --retry 3 --data-raw "$MSG" "$HC_URL" >/dev/null 2>&1 \
      || logger -t registry-gc "healthchecks ping failed (status=${STATUS})"
  fi
}

# Scales Deployment $1 to zero and waits for its pod to exit. Scaling returns immediately, and
# GC must not start while the old process still holds the store. Each Deployment's pods carry
# `app: <its name>`.
stop_deploy() {
  $KUBECTL scale "deploy/${1}" --replicas=0 >/dev/null 2>&1
  $KUBECTL wait --for=delete pod -l app="${1}" --timeout=120s >/dev/null 2>&1
}

start_deploy() {
  $KUBECTL scale "deploy/${1}" --replicas=1 >/dev/null 2>&1
  $KUBECTL rollout status "deploy/${1}" --timeout=180s >/dev/null 2>&1
}

restore_push_store() {
  [[ "$PUSH_DOWN" == 1 ]] || return 0
  PUSH_DOWN=0
  start_deploy "$DEPLOY" && return 0
  PUSH_MSG="${PUSH_MSG:-push store not collected}; registry did NOT come back — check deploy/${DEPLOY}"
  return 1
}

# The mirror Job mounts the same RWO claim the ghcr-mirror pod does, and both land on one node,
# so nothing stops the pod starting while the prune is still unlinking revisions. A Job not
# known to have finished is deleted, and waited for, before the mirror serves the store again.
# One that succeeded or failed stays until its TTL, so the log a failure MSG names is still
# there. Either way its prune lines reach the journal first.
restore_mirror_store() {
  [[ "$MIRROR_DOWN" == 1 ]] || return 0
  MIRROR_DOWN=0
  if [[ "$MIRROR_STARTED" == 1 && "$MIRROR_DONE" != 1 ]]; then
    journal_mirror_prune >/dev/null
    local finished
    finished=$($KUBECTL get job "$MIRROR_JOB" \
                 -o jsonpath='{.status.succeeded}{.status.failed}' 2>/dev/null)
    if [[ -z "$finished" ]]; then
      $KUBECTL delete job "$MIRROR_JOB" --ignore-not-found --cascade=foreground --wait=true \
        --timeout=120s >/dev/null 2>&1
    fi
  fi
  start_deploy "$MIRROR_DEPLOY" && return 0
  MIRROR_MSG="${MIRROR_MSG:-ghcr-mirror store not collected}; ghcr-mirror did NOT come back — check deploy/${MIRROR_DEPLOY}"
  return 1
}

# Both stores MUST come back even if GC dies, the deadline trips, or cron kills us. Without this
# a failed run leaves the cluster unable to pull any locally-built image, or any ghcr.io image
# during a WAN outage, until a human notices — a worse outage than the full disk this fixes.
scale_up_and_report() {
  restore_mirror_store || FAILED=1
  restore_push_store || FAILED=1
  if [[ "$COMPLETED" == 1 && "$FAILED" == 0 ]]; then
    STATUS=up
  else
    STATUS=down
  fi
  if [[ -n "$PUSH_MSG" || -n "$MIRROR_MSG" ]]; then
    MSG="${PUSH_MSG:-push store: did not run}; ${MIRROR_MSG:-ghcr-mirror: did not run}"
  fi
  finish
}
trap scale_up_and_report EXIT

# Copies the mirror prune's per-revision lines to the journal and prints them. The prune names
# every revision it removed, and the Job log goes when the Job's TTL runs out.
journal_mirror_prune() {
  local lines
  lines=$($KUBECTL logs "job/${MIRROR_JOB}" -c prune 2>/dev/null \
            | grep -E '^(pruned|keeping|could not) ')
  [[ -n "$lines" ]] || return 0
  logger -t registry-gc <<<"$lines"
  printf '%s\n' "$lines"
}

# ── Content-tag prune ────────────────────────────────────────────────────────────────────────
# Every build pushes an immutable `sha-<12 hex>` tag beside `latest` (see k8s/image-builder's
# --output). A tag is a real manifest reference, so `garbage-collect --delete-untagged` below can
# never reclaim one: without this step the store gains one permanent manifest per rebuild, and the
# buildcache comment in build-job.yaml.j2 stops being able to claim that the store is bounded by
# the NUMBER of built images rather than by how often they are rebuilt.
#
# BEFORE the scale-down, not after, and the order is load-bearing. Untagging goes through the
# SERVING registry (`DELETE /v2/<repo>/manifests/<digest>`, permitted by the
# REGISTRY_STORAGE_DELETE_ENABLED this file's header describes), while the GC Job runs the binary
# directly against a store with nothing serving it. Reversed, every prune would fail on a refused
# connection and only the blob sweep would run — silently, since the prune is best-effort.
#
# WHAT IS NEVER UNTAGGED: any tag that is not `sha-<12 hex>`, which is what keeps `latest` and
# `buildcache` safe; the digest `latest` currently resolves to; and any digest a running pod
# resolved. The last one matters because every built image runs imagePullPolicy: Always
# (the `built-images-pull-always` row of ansible/tests/k8s/_workload_property_rows.py), so a
# pod re-fetches by tag on each start —
# untagging the manifest a live pod came from turns its next restart into an ImagePullBackOff.
#
# AN UNRANKABLE TAG IS KEPT. Ordering needs each manifest's config-blob `created`, because the tag
# names are content hashes and carry no chronology, so a tag whose config blob cannot be read has
# no place in that order. The asymmetry is the one k8s/image-builder's build gate rests on: keeping
# a superseded tag costs disk, untagging a live one costs an outage.

# The digest a tag resolves to, from the registry's own header rather than from hashing the body.
manifest_digest() {
  curl -fsS -I --max-time 10 -H "Accept: ${MANIFEST_ACCEPT}" \
    "${REG}/v2/${1}/manifests/${2}" 2>/dev/null \
    | tr -d '\r' | sed -n 's/^[Dd]ocker-[Cc]ontent-[Dd]igest: //p'
}

# Every image digest a running container resolved, one per line. Scoped to {{ k8s_namespace }},
# which is where every consumer of this registry runs — a workload in another namespace pulling
# from here would be invisible to the keep rule below.
live_digests() {
  $KUBECTL get pods -o \
    jsonpath='{range .items[*]}{range .status.containerStatuses[*]}{.imageID}{"\n"}{end}{end}' \
    2>/dev/null | grep -o 'sha256:[0-9a-f]\{64\}' | sort -u
}

# `created<TAB>tag<TAB>digest` for every content tag in one repository, newest first. A row whose
# created or digest could not be read is still emitted — the caller keeps it rather than ranking it.
content_tag_rows() {
  local repo=$1 tag body digest cfg created
  curl -fsS --max-time 10 "${REG}/v2/${repo}/tags/list" 2>/dev/null \
    | jq -r '.tags[]?' | grep -E '^sha-[0-9a-f]{12}$' \
    | while read -r tag; do
        digest=$(manifest_digest "$repo" "$tag")
        body=$(curl -fsS --max-time 15 -H "Accept: ${MANIFEST_ACCEPT}" \
                 "${REG}/v2/${repo}/manifests/${tag}" 2>/dev/null)
        cfg=$(jq -r '.config.digest // empty' <<<"$body" 2>/dev/null)
        created=""
        if [[ -n "$cfg" ]]; then
          created=$(curl -fsS --max-time 15 "${REG}/v2/${repo}/blobs/${cfg}" 2>/dev/null \
                      | jq -r '.created // empty' 2>/dev/null)
        fi
        printf '%s\t%s\t%s\n' "$created" "$tag" "$digest"
      done | sort -r
}

prune_content_tags() {
  local live repos repo keep_digest rank created tag digest
  live=$(live_digests)
  repos=$(curl -fsS --max-time 10 "${REG}/v2/_catalog?n=1000" 2>/dev/null | jq -r '.repositories[]?')
  if [[ -z "$repos" ]]; then
    logger -t registry-gc "prune: registry catalog unreadable — skipped"
    return 0
  fi

  while read -r repo; do
    [[ -n "$repo" ]] || continue
    keep_digest=$(manifest_digest "$repo" latest)
    rank=0
    while IFS=$'\t' read -r created tag digest; do
      [[ -n "$tag" ]] || continue
      rank=$((rank + 1))
      if [[ -z "$created" || -z "$digest" ]]; then
        logger -t registry-gc "prune: keeping ${repo}:${tag} — created or digest unreadable"
        continue
      fi
      [[ "$rank" -le "$KEEP_CONTENT_TAGS" ]] && continue
      [[ -n "$keep_digest" && "$digest" == "$keep_digest" ]] && continue
      grep -qxF "$digest" <<<"$live" && continue
      if curl -fsS -X DELETE --max-time 20 \
           "${REG}/v2/${repo}/manifests/${digest}" >/dev/null 2>&1; then
        PRUNED=$((PRUNED + 1))
      else
        logger -t registry-gc "prune: could not untag ${repo}:${tag} (${digest})"
      fi
    done < <(content_tag_rows "$repo")
  done <<<"$repos"
}

# ── ghcr-mirror keep set ─────────────────────────────────────────────────────────────────────
# The ghcr-mirror container's store is pruned offline by the second Job in gc-job.yaml
# (files/ghcr-mirror-prune.sh in the k8s/registry role, #5541), which has no API access. It
# reads the digests to keep from a ConfigMap this function writes before the scale-down.
#
# EVERY NAMESPACE, AND SPECS AS WELL AS STATUSES. A `registries.yaml` mirror covers the whole
# ghcr.io host, so Flux's controllers in flux-system pull through it as much as anything here.
# A CronJob's pod is not running at 04:20 on a Sunday, so its pinned digest comes from its spec.
# Every sha256 digest in the JSON is kept, which can only keep more than strictly needed.
#
# TAG REFS TOO. A flux-owned built image runs as `ghcr.io/danielh2018/<name>:<tag>` with no
# digest, so a workload of one scaled to zero leaves no digest anywhere. Its spec still names
# the tag, and the prune keeps whatever revision that tag points at in the store. Each ref goes
# in as `<repo>:<tag>`; a digest-pinned ref also yields one, which only keeps more.
#
# FAIL CLOSED. The previous run's ConfigMap is deleted first, and the Job mounts it as optional,
# so a run that could not build the set prunes nothing rather than pruning by last week's. A
# skip reports the run down: a cause that persists would otherwise skip every week behind a
# green tile while the claim fills. A cluster running pods always has an imageID digest, so an
# empty set is a fault as well.
write_mirror_keep_set() {
  local json keep tags
  if ! $KUBECTL delete configmap "$MIRROR_KEEP_CM" --ignore-not-found >/dev/null 2>&1; then
    MIRROR_MSG="could not delete the previous ghcr-mirror keep set (configmap/${MIRROR_KEEP_CM}) — aborted before scaling down"
    return 1
  fi
  if ! json=$($KUBECTL get pods,deployments,statefulsets,daemonsets,cronjobs,jobs -A -o json \
                2>/dev/null); then
    MIRROR_NOTE="ghcr-mirror prune skipped, workloads unreadable"
    return 0
  fi
  keep=$(grep -o 'sha256:[0-9a-f]\{64\}' <<<"$json" | sort -u)
  if [[ -z "$keep" ]]; then
    MIRROR_NOTE="ghcr-mirror prune skipped, no digest found in any workload"
    return 0
  fi
  tags=$(grep -oE 'ghcr\.io/[a-z0-9._/-]+:[A-Za-z0-9._-]+' <<<"$json" | sed 's|^ghcr\.io/||' \
           | sort -u)
  [[ -n "$tags" ]] && keep="${keep}"$'\n'"${tags}"
  if ! $KUBECTL create configmap "$MIRROR_KEEP_CM" --from-literal=digests="$keep" \
         >/dev/null 2>&1; then
    MIRROR_NOTE="ghcr-mirror prune skipped, could not write configmap/${MIRROR_KEEP_CM}"
  fi
}

# ── The push store's phase ───────────────────────────────────────────────────────────────────
# Scales only deploy/registry. Its replica comes back in the main sequence below, before the
# mirror's phase starts, so the push store is down only for its own collection.
collect_push_store() {
  local deleted links
  prune_content_tags
  PUSH_DOWN=1
  if ! stop_deploy "$DEPLOY"; then
    PUSH_MSG="registry pod did not terminate within 120s — aborted before touching the blob store"
    return 1
  fi
  $KUBECTL delete job "$JOB" --ignore-not-found >/dev/null 2>&1
  if ! $KUBECTL apply -f "$JOB_MANIFEST" >/dev/null 2>&1; then
    PUSH_MSG="could not apply ${JOB_MANIFEST}"
    return 1
  fi
  if ! $KUBECTL wait --for=condition=complete "job/${JOB}" \
         --timeout={{ registry_k8s_gc_deadline_s }}s >/dev/null 2>&1; then
    PUSH_MSG="gc job did not complete within {{ registry_k8s_gc_deadline_s }}s — see: kubectl -n ${NS} logs job/${JOB}"
    return 1
  fi
  # Count what GC actually removed, from its own log. Longhorn's actualSize was the obvious
  # metric here and it is the WRONG one: it reports blocks allocated to the volume, not
  # filesystem usage, so it stays flat after a deletion until something trims the volume. The
  # first real run deleted 209 blobs and read as "10719551488 -> 10722729984 bytes" — an
  # unchanged, slightly larger number, which reads as a failed run.
  deleted=$($KUBECTL logs "job/${JOB}" 2>/dev/null | grep -c 'Deleting blob')
  links=$($KUBECTL logs "job/${JOB}" 2>/dev/null | grep -c 'Deleting layer link')
  PUSH_MSG="gc completed; ${PRUNED} content tag(s) untagged, ${deleted} blob(s) and ${links} layer link(s) deleted"
}

# Waits for the mirror Job and records its result in MIRROR_MSG. Returns 1 when the Job did not
# complete, or when the keep set was skipped.
report_mirror_job() {
  local pruned blobs
  if ! $KUBECTL wait --for=condition=complete "job/${MIRROR_JOB}" \
         --timeout={{ registry_k8s_gc_deadline_s }}s >/dev/null 2>&1; then
    MIRROR_MSG="ghcr-mirror job did not complete — see: kubectl -n ${NS} logs job/${MIRROR_JOB} -c prune"
    return 1
  fi
  MIRROR_DONE=1
  pruned=$(journal_mirror_prune | grep -c '^pruned ')
  blobs=$($KUBECTL logs "job/${MIRROR_JOB}" -c gc 2>/dev/null | grep -c 'Deleting blob')
  MIRROR_MSG="ghcr-mirror: ${pruned} revision(s) pruned, ${blobs} blob(s) deleted"
  # The store collected, but a skipped prune is a fault write_mirror_keep_set explains.
  if [[ -n "$MIRROR_NOTE" ]]; then
    MIRROR_MSG="${MIRROR_MSG} (${MIRROR_NOTE})"
    return 1
  fi
}

# ── The ghcr-mirror store's phase ────────────────────────────────────────────────────────────
# Scales only deploy/ghcr-mirror, never the push store (operator ruling on #5680). containerd
# falls back to ghcr.io while it is down.
collect_mirror_store() {
  write_mirror_keep_set || return 1
  [[ -n "$MIRROR_NOTE" ]] && logger -t registry-gc "$MIRROR_NOTE"
  MIRROR_DOWN=1
  if ! stop_deploy "$MIRROR_DEPLOY"; then
    MIRROR_MSG="ghcr-mirror pod did not terminate within 120s — aborted before touching its store"
    return 1
  fi
  $KUBECTL delete job "$MIRROR_JOB" --ignore-not-found >/dev/null 2>&1
  MIRROR_STARTED=1
  if ! $KUBECTL apply -f "$MIRROR_JOB_MANIFEST" >/dev/null 2>&1; then
    MIRROR_MSG="could not apply ${MIRROR_JOB_MANIFEST}"
    return 1
  fi
  report_mirror_job
}

# A build in flight is the exact race the push store's scale-down exists to prevent: buildkit
# pushes blobs whose manifest is not written yet, and GC would see them as unreferenced. Jobs
# are named build-<image> by the image-builder role. No build touches the mirror's store, so its
# phase still runs.
ACTIVE_BUILDS=$($KUBECTL get jobs -o \
  jsonpath='{range .items[?(@.status.active)]}{.metadata.name}{"\n"}{end}' 2>/dev/null \
  | grep -c '^build-' )
if [[ "$ACTIVE_BUILDS" -gt 0 ]]; then
  PUSH_MSG="push store skipped — ${ACTIVE_BUILDS} image build(s) in flight"
else
  collect_push_store || FAILED=1
  restore_push_store || FAILED=1
fi

collect_mirror_store || FAILED=1
restore_mirror_store || FAILED=1
COMPLETED=1
