{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: peanut
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  selector:
    matchLabels:
      app: peanut
  template:
    metadata:
      labels:
        app: peanut
        netpol-baseline: enforced
    spec:
      # No legacy Docker-link env vars for every Service in the namespace. Harmless clutter
      # here, fatal for Authelia — see that role's deployment for the failure it causes.
      enableServiceLinks: false
      # No runAsUser pinned, mirroring littlelink: the compose template sets no `user:` either
      # (the image's own non-root `node` user is what has been serving this page), so pinning a
      # UID here would be a behaviour change smuggled in under a platform move. fsGroup is set
      # instead — it's added as a supplementary group to the container process regardless of
      # which UID the image actually runs as, which is what makes the /app/config emptyDir
      # group-writable without knowing that UID. Mirrors the compose template's
      # `tmpfs: /app/config:mode=1777`, which sidesteps the same unknown-UID problem the other way.
      securityContext:
        fsGroup: 1000
      # PeaNUT WRITES /config (it persists UI settings beside settings.yml — the compose
      # template's writable ./peanut-config bind). A read-only subPath mount there EROFS'd
      # the app at first deploy (2026-08-12), so the Secret seeds a writable emptyDir
      # instead, same copy-not-mount shape as the app-config scratch below.
      initContainers:
        - name: seed-config
          # alpine, not the app image: peanut's distroless-ish image has no cp
          # (StartError "executable file not found" at first deploy). Same init image
          # zigbee2mqtt and home-assistant use.
          image: {{ peanut_k8s_init_image }}
          command: ["cp", "/config-seed/settings.yml", "/config/settings.yml"]
          securityContext:
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - name: peanut-settings
              mountPath: /config-seed
              readOnly: true
            - name: peanut-config
              mountPath: /config
          resources:
            limits:
              cpu: 250m
              memory: 128Mi
            requests:
              cpu: 10m
              memory: 16Mi
      automountServiceAccountToken: false
      priorityClassName: homelab-best-effort
      # Preference, never a pin: daniel-box carries the storage- and VIP-pinned workloads and runs the hotter of the two nodes, so latency-insensitive services default here.
      # Weighted so the pod still schedules if daniel-server is cordoned or full.
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: peanut
          image: {{ peanut_k8s_image }}
          ports:
            - containerPort: {{ container_item.port }}
          securityContext:
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          env:
            - name: TZ
              value: "{{ tz }}"
            - name: WEB_USERNAME
              valueFrom:
                secretKeyRef:
                  name: peanut-secrets
                  key: WEB_USERNAME
            - name: WEB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: peanut-secrets
                  key: WEB_PASSWORD
          volumeMounts:
            # Writable /config seeded with settings.yml by the init container above.
            - name: peanut-config
              mountPath: /config
            # auth.yaml is regenerated from WEB_USERNAME/WEB_PASSWORD at every boot (absent from
            # the image, not part of the settings mount above) — the compose template's
            # `tmpfs: /app/config:mode=1777` equivalent.
            - name: peanut-app-config
              mountPath: /app/config
          readinessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
            initialDelaySeconds: 15
            periodSeconds: 30
          resources:
            limits:
              cpu: "{{ peanut_k8s_cpu_limit }}"
              memory: {{ peanut_k8s_mem_limit }}
            requests:
              cpu: "{{ peanut_k8s_cpu_request }}"
              memory: {{ peanut_k8s_mem_request }}
      volumes:
        - name: peanut-settings
          secret:
            secretName: peanut-secrets
            items:
              - key: settings.yml
                path: settings.yml
        - name: peanut-app-config
          emptyDir: {}
        - name: peanut-config
          emptyDir: {}
