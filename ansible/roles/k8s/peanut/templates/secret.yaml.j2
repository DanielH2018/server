---
apiVersion: v1
kind: Secret
metadata:
  name: peanut-secrets
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  WEB_USERNAME: "{{ peanut_username }}"
  WEB_PASSWORD: "{{ peanut_password }}"
  # Mirrors the Docker role's peanut-settings.yml.j2, except HOST points at daniel-server's
  # LAN IP instead of the Docker-internal `nut` service name — the nut sidecar stays on
  # daniel-server, out of the cluster.
  settings.yml: |
    NUT_SERVERS:
      - HOST: {{ hostvars['daniel-server'].server_ip }}
        PORT: {{ peanut_k8s_nut_port }}
        USERNAME: upsmon
        PASSWORD: {{ nut_monitor_password }}
