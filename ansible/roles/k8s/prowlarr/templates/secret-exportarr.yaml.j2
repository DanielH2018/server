---
# The exportarr sidecar's credential. Rendered through the manifests role's SECRET list
# (0600 + no_log).
#
# Reuses `prowlarr_api_key` rather than minting a second one: it IS prowlarr's API key, the same
# value monitor-bridge's indexer check already reads, and prowlarr offers no scoped read-only
# variant to mint instead.
apiVersion: v1
kind: Secret
metadata:
  name: prowlarr-exportarr
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  api_key: "{{ prowlarr_api_key }}"
