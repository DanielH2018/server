{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
{% from 'exportarr.yml.j2' import exportarr with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: prowlarr
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  # The config PVC is ReadWriteOnce on single-replica Longhorn, so a rolling update deadlocks:
  # the new pod waits for a volume the old pod has not released.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: prowlarr
  template:
    metadata:
      labels:
        app: prowlarr
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      # No fsGroup: seed-volume restores ownership with `tar -p --numeric-owner` and the LSIO
      # image chowns /config itself on startup.
      #
      # NO MEDIA MOUNT AT ALL. prowlarr is an indexer proxy — it moves search results between the
      # \*arrs and trackers and never touches a file on disk. Mounting the media volume "for
      # consistency" would hand the fleet's most externally-connected service write access to the
      # library for nothing.
      automountServiceAccountToken: false
      priorityClassName: homelab-standard
      # Preference, never a pin: daniel-box carries the storage- and VIP-pinned workloads and runs the hotter of the two nodes, so latency-insensitive services default here.
      # Weighted so the pod still schedules if daniel-server is cordoned or full.
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: prowlarr
          image: {{ prowlarr_k8s_image }}
          ports:
            - containerPort: {{ container_item.port }}
          # The compose template's cap_drop/cap_add pair — the s6 privilege-drop set. No
          # NET_BIND_SERVICE: prowlarr listens on {{ container_item.port }} (>1024), which needs no
          # privilege. Interpolated rather than written out: this comment said 8989 — sonarr's port, from
          # the role it was copied from — until 2026-08-23b L6, and the same paste rotted bazarr too.
{{ hardened_security_context(add=['CHOWN', 'SETUID', 'SETGID', 'FOWNER', 'DAC_OVERRIDE']) }}
          env:
            - name: PUID
              value: "{{ puid }}"
            - name: PGID
              value: "{{ pgid }}"
            - name: TZ
              value: "{{ tz }}"
            # Prowlarr:Log, reached through the unprefixed environment-variable provider.
            # Upstream defaults are debug / 50 files; see roles/k8s/sonarr/defaults/main.yml.
            - name: PROWLARR__LOG__LEVEL
              value: "{{ prowlarr_k8s_log_level }}"
            - name: PROWLARR__LOG__ROTATE
              value: "{{ prowlarr_k8s_log_rotate }}"
          volumeMounts:
            - name: prowlarr-config
              mountPath: /config
          readinessProbe:
            httpGet:
              path: /ping
              port: {{ container_item.port }}
            initialDelaySeconds: 15
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /ping
              port: {{ container_item.port }}
            initialDelaySeconds: 60
            periodSeconds: 30
{{ container_resources(cpu_limit=prowlarr_k8s_cpu_limit, mem_limit=prowlarr_k8s_mem_limit, cpu_request=prowlarr_k8s_cpu_request, mem_request=prowlarr_k8s_mem_request) }}
        {{ exportarr('prowlarr', prowlarr_exportarr_image, container_item.port) }}
      volumes:
        - name: prowlarr-config
          persistentVolumeClaim:
            claimName: {{ prowlarr_k8s_claim }}
