{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
---
# THE WORKLOAD IS BYPARR; THE OBJECT NAME IS `flaresolverr`. Byparr is an API-compatible
# replacement for FlareSolverr (same POST /v1 contract on the same port), so prowlarr drives it
# unchanged. The four reasons the Kubernetes names did not move with the image — the seeded
# proxy URL in prowlarr's snapshot-reverted database chief among them — are written out at
# `prowlarr_k8s_flaresolverr_image` in this role's defaults/main.yml.
#
# Its own Deployment rather than a container in prowlarr's pod, deliberately: a sidecar shares the
# pod's network namespace, and "reachable only on localhost by its own pod" would be tighter than
# Compose but would also mean prowlarr and a headless browser rendering hostile pages share a
# netns and a lifecycle. Kept separate, with the NetworkPolicy beside it doing the isolation.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: flaresolverr
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  # No authoritative state: the browser binaries ship inside the image and everything the app
  # writes is a per-request profile it recreates, so nothing survives a restart that matters and
  # the RWO constraint that forced Recreate is gone.
  # maxUnavailable 0 and maxSurge 1 are what SHOULD make this
  # zero-downtime — on a single replica maxUnavailable 0 forces the new pod Ready before the
  # old one is removed, where the 25% default would round down to 0 anyway but says nothing
  # about intent. This is unverified until the slice-1 measurement (measure_rollout_gap.py)
  # actually runs against a live deploy — no deploy has been authorised on this branch, so
  # "zero-downtime" here is intent, not a measured result.
  #
  # Conversion-gate note: only the write-model half of the gate is confirmed (the claim above —
  # Byparr's Dockerfile declares no VOLUME and persists nothing across a restart). The
  # multi-instance half is NOT confirmed: maxSurge: 1 means two pods can run behind one Service
  # for the duration of a rollout, and nothing here confirms from Byparr's own docs that this is
  # safe. Assessed risk is low, and LOWER than it was under FlareSolverr: Byparr's API surface
  # is three routes (`GET /`, `GET /health`, `POST /v1` — src/endpoints.py), with no session
  # create/destroy pair at all, so a request cannot depend on which pod served the last one.
  # Recorded as a waiver rather than papered over.
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  selector:
    matchLabels:
      app: flaresolverr
  template:
    metadata:
      labels:
        app: flaresolverr
        # Opted OUT of the namespace baseline (slice 5). `networkpolicy.yaml.j2` admits only
        # prowlarr on :8191; the baseline is additive, so selecting this pod would ADD traefik,
        # prometheus and both node CIDRs on top — the widening the guard exemption avoids today.
        netpol-baseline-exempt: "true"
    spec:
      enableServiceLinks: false
      automountServiceAccountToken: false
      priorityClassName: homelab-standard
      # Preference, never a pin: daniel-box carries the storage- and VIP-pinned workloads and runs the hotter of the two nodes, so latency-insensitive services default here.
      # Weighted so the pod still schedules if daniel-server is cordoned or full.
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: flaresolverr
          image: {{ prowlarr_k8s_flaresolverr_image }}
          ports:
            - containerPort: {{ prowlarr_k8s_flaresolverr_port }}
          # The comment below is what makes this assertable where its LSIO siblings are not:
          # no config chown means no root phase to preserve. Byparr's Dockerfile creates a
          # uid-1000 user and runs `tini -- python main.py` as it — the same shape FlareSolverr
          # had under `dumb-init`, which is why run_as_user survived the image swap unchanged.
          # It renders untrusted pages, so pinning the uid is worth more here than on a passive
          # workload.
          # cap_drop: ALL with nothing added back. Unlike the LSIO images this one does not chown
          # a config tree on startup, so it needs none of the s6 privilege-drop set, and the
          # browser runs without its own setuid sandbox (which is what would have needed
          # SYS_ADMIN back).
{{ hardened_security_context(non_root=true, run_as_user=1000) }}
          env:
            # `warning`, not the `INFO` default: under FlareSolverr at info this container wrote
            # 11,571 lines a day to serve 11 real requests, and measured 2026-08-29 the bulk of
            # that was the kubelet's own readiness probe hitting `/` every 10s and being logged
            # as a request. Byparr is FastAPI behind uvicorn, whose access log is also INFO, so
            # the same probe traffic would produce the same flood. Byparr reads this variable
            # through pydantic-settings (src/consts.py: `log_level: str = "INFO"`, upper-cased
            # into a logging level), so the lowercase value here is valid; an unparseable one
            # would crash-loop the container at import rather than fall back.
            #
            # The signal that a challenge is failing was never this log anyway: monitor-bridge
            # reads Prowlarr's /api/v1/indexerstatus (check.py:1578), which is independent of
            # anything this container writes to stdout.
            - name: LOG_LEVEL
              value: warning
            - name: TZ
              value: "{{ tz }}"
          volumeMounts:
            # /tmp, NOT the app's cache directory. Byparr sets XDG_CACHE_HOME=/cache and its
            # Dockerfile BAKES the Firefox build into that path at image-build time
            # (`invisible_playwright fetch`), so an emptyDir mounted there would hide the browser
            # the container exists to run. What actually grows at runtime is the per-request
            # browser profile the launcher creates under /tmp, and /tmp is empty in the image —
            # so that is where the cap from the retired FlareSolverr /config volume moves to.
            - name: browser-tmp
              mountPath: /tmp
            # A headless browser puts its renderer shared memory in /dev/shm. Kubernetes mounts
            # that as 64Mi and Byparr's README asks for 512 MB; too little shm fails at renderer
            # launch, so this is a start-up dependency, not a tuning knob. `medium: Memory` makes
            # it a tmpfs — which is charged to the pod's memory cgroup, and is why
            # prowlarr_k8s_fs_mem_limit was raised alongside it.
            - name: dshm
              mountPath: /dev/shm
          # `/` and not `/health`. `/` is a static 301 to /docs, which an httpGet probe counts as
          # success (2xx and 3xx both pass). `/health` takes Byparr's BrowserDep and launches a
          # browser to answer — upstream's own HEALTHCHECK runs it every 15 MINUTES, which is the
          # author saying it is expensive. On a 10s readiness period it would spend more of the
          # pod's CPU limit proving it is alive than solving challenges.
          #
          # What neither path proves is that the browser can start: uvicorn binds and serves the
          # redirect before any browser exists. A green pod here is not a working solver — see
          # the PR that introduced this image for the Prowlarr-side check that is.
          readinessProbe:
            httpGet:
              path: /
              port: {{ prowlarr_k8s_flaresolverr_port }}
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: {{ prowlarr_k8s_flaresolverr_port }}
            initialDelaySeconds: 60
            periodSeconds: 30
{{ container_resources(cpu_limit=prowlarr_k8s_fs_cpu_limit, mem_limit=prowlarr_k8s_fs_mem_limit, cpu_request=prowlarr_k8s_fs_cpu_request, mem_request=prowlarr_k8s_fs_mem_request) }}
      volumes:
        - name: browser-tmp
          # sizeLimit preserves the cap the retired 1Gi PVC used to provide. Most siblings here
          # use a bare `emptyDir: {}`, but this one holds a browser profile: uncapped, runaway
          # growth becomes node ephemeral-storage pressure and the kubelet evicts OTHER pods on
          # the node, turning one browser's disk leak into someone else's outage. Capped, the
          # blast radius is the pod that caused it.
          emptyDir:
            sizeLimit: 1Gi
        - name: dshm
          emptyDir:
            medium: Memory
            sizeLimit: {{ prowlarr_k8s_fs_shm_size }}
