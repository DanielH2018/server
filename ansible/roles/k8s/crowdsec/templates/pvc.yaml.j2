---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ crowdsec_k8s_claim }}
  namespace: {{ k8s_namespace }}
spec:
  # Not seeded from the Docker copy: this engine starts as a SHADOW beside the Docker LAPI
  # (B1), so it accumulates its own decisions from day one; bans expire on their own and the
  # hub reinstalls from COLLECTIONS. Nothing in the old DB is worth carrying.
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ crowdsec_k8s_storage_class }}
  resources:
    requests:
      storage: {{ crowdsec_k8s_size }}
