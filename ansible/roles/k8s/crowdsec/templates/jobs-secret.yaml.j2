{#
  The three Kuma push URLs, tokens included, for the crowdsec-jobs sidecar. The bouncer prune has
  no monitor, so it has no key.

  Its own Secret, not keys of crowdsec-env. The engine container takes crowdsec-env whole
  through `envFrom`, and the push tokens have no business in the LAPI's environment.

  Whole URLs rather than bare tokens, as configarr-health's and janitorr-health's push_url are.
  A value that is the token alone is a standalone placeholder under Flux, which would add a row
  for crowdsec to k8s/manifests' standalone_secret_keys.json, and any change to that
  k8s/manifests file makes the tick's narrowed apply refuse as most of the fleet.
#}
---
apiVersion: v1
kind: Secret
metadata:
  name: crowdsec-jobs
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  remote_allowlist_push_url: "http://uptime-kuma.{{ k8s_namespace }}.svc.cluster.local:{{ containers_list | entry_port('uptime-kuma') }}/api/push/{{ crowdsec_remote_allowlist_push_token }}"
  appsec_push_url: "http://uptime-kuma.{{ k8s_namespace }}.svc.cluster.local:{{ containers_list | entry_port('uptime-kuma') }}/api/push/{{ monitor_bridge_appsec_push_token }}"
  home_allowlist_push_url: "http://uptime-kuma.{{ k8s_namespace }}.svc.cluster.local:{{ containers_list | entry_port('uptime-kuma') }}/api/push/{{ monitor_bridge_home_allowlist_push_token }}"
