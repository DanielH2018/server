{#
  The crowdsec-jobs sidecar's code: the scheduler, its four jobs, kuma_push.py from
  setup/common, which the scheduler imports, and kubectl's kubeconfig. Python puts the scheduler's own directory on
  sys.path, so the files sit flat at the mount.

  The crowdsec-home-ips CronJob mounts two keys of it too (home-ips-cronjob.yaml.j2): its
  module, home_ips_discover.py, and flux_job_connect.py from k8s/manifests, which that module
  imports for every connection it opens.

  No secret goes in here. The push URLs reach the sidecar from the crowdsec-jobs Secret through
  `secretKeyRef` (the H2 plan's *No secret in a ConfigMap*), and
  ansible/tests/k8s/test_no_secret_in_a_moved_jobs_configmap.py renders this file with every
  secrets.yml key bound to a sentinel and fails on any sentinel it finds.

  A change here changes the role's render, so the shared rollout restart restarts the whole
  engine pod, LAPI included. That restart is the cost of every job edit.
#}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: crowdsec-jobs
  namespace: {{ k8s_namespace }}
data:
  # kubectl's credential for the remote allowlist: the projected token and CA the sidecar alone
  # mounts at /var/run/crowdsec-jobs (deployment.yaml.j2). Paths only; no secret value.
  kubeconfig: |
    apiVersion: v1
    kind: Config
    clusters:
      - name: in-cluster
        cluster:
          server: https://kubernetes.default.svc
          certificate-authority: /var/run/crowdsec-jobs/ca.crt
    users:
      - name: crowdsec-jobs
        user:
          tokenFile: /var/run/crowdsec-jobs/token
    contexts:
      - name: crowdsec-jobs
        context:
          cluster: in-cluster
          user: crowdsec-jobs
          namespace: {{ k8s_namespace }}
    current-context: crowdsec-jobs
  crowdsec_jobs.py: |
{{ lookup('file', playbook_dir + '/roles/k8s/crowdsec/files/crowdsec_jobs.py') | indent(4, true) }}
  remote_allowlist.py: |
{{ lookup('file', playbook_dir + '/roles/k8s/crowdsec/files/remote_allowlist.py') | indent(4, true) }}
  jobs_metrics.py: |
{{ lookup('file', playbook_dir + '/roles/k8s/crowdsec/files/jobs_metrics.py') | indent(4, true) }}
  appsec_verify.py: |
{{ lookup('file', playbook_dir + '/roles/k8s/crowdsec/files/appsec_verify.py') | indent(4, true) }}
  bouncer_prune.py: |
{{ lookup('file', playbook_dir + '/roles/k8s/crowdsec/files/bouncer_prune.py') | indent(4, true) }}
  home_allowlist.py: |
{{ lookup('file', playbook_dir + '/roles/k8s/crowdsec/files/home_allowlist.py') | indent(4, true) }}
  home_ips_discover.py: |
{{ lookup('file', playbook_dir + '/roles/k8s/crowdsec/files/home_ips_discover.py') | indent(4, true) }}
  flux_job_connect.py: |
{{ lookup('file', playbook_dir + '/roles/k8s/manifests/files/flux_job_connect.py') | indent(4, true) }}
  kuma_push.py: |
{{ lookup('file', playbook_dir + '/../hosts/lib/kuma_push.py') | indent(4, true) }}
