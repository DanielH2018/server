---
# Config the initContainer installs into /etc/crowdsec before the engine starts. A Secret
# (not ConfigMap) because discord.yaml embeds the webhook URL + MapQuest key. The whitelists
# and profiles are read from the Docker traefik role's files — ONE source for both stacks
# until the Docker engine retires at B2; edits there propagate here on the next deploy.
apiVersion: v1
kind: Secret
metadata:
  name: crowdsec-config
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  acquis.yaml: |
    # AppSec only. This pod parses no log files — the traefik access log is parsed by the
    # sidecar agent in the traefik pod, and daniel-server's logs arrive via its agent (B2).
    source: appsec
    listen_addr: 0.0.0.0:{{ crowdsec_k8s_appsec_port }}
    appsec_config: crowdsecurity/appsec-default
    name: k8s-traefik-appsec
    labels:
      type: appsec
  profiles.yaml: |
    {{ lookup('file', playbook_dir + '/roles/containers/traefik/files/crowdsec-profiles.yaml') | indent(4) }}
  whitelist.yaml: |
    {{ lookup('file', playbook_dir + '/roles/containers/traefik/files/crowdsec-whitelist.yaml') | indent(4) }}
  trusted-remote-whitelist.yaml: |
    {{ lookup('file', playbook_dir + '/roles/containers/traefik/files/crowdsec-trusted-remote-whitelist.yaml') | indent(4) }}
  discord.yaml: |
    {{ lookup('template', playbook_dir + '/roles/containers/traefik/templates/crowdsec-discord.yaml.j2') | indent(4) }}
---
# Runtime credentials, injected as env. BOUNCER_KEY_<name> pre-registers a bouncer on LAPI
# init; AGENT_USERNAME/PASSWORD is the identity the image entrypoint registers/logs-in the
# in-pod agent with. The traefik-sidecar machine is registered by a post-deploy task.
apiVersion: v1
kind: Secret
metadata:
  name: crowdsec-env
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  BOUNCER_KEY_k8straefik: "{{ crowdsec_k8s_bouncer_api_key }}"
  # The Docker traefik's bouncer, once B2 repoints it here. Entrypoint re-registration
  # tolerates an existing bouncer but never UPDATES its key — rotation is delete-then-add,
  # same trap as the Docker role documents on its rotation-guard task.
  BOUNCER_KEY_dockertraefik: "{{ crowdsec_bouncer_docker_traefik_key }}"
  AGENT_USERNAME: "{{ crowdsec_k8s_engine_machine }}"
  AGENT_PASSWORD: "{{ crowdsec_k8s_agent_password }}"
