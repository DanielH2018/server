---
# Config the initContainer installs into /etc/crowdsec before the engine starts. A Secret
# (not ConfigMap) because discord.yaml embeds the webhook URL + MapQuest key. The whitelists,
# profiles and discord notifier are this role's own files — re-homed here at E7 (2026-08-13)
# from the Docker traefik role, which retired. The k8s/traefik and k8s/authelia crowdsec
# Secrets read the same whitelist files from here, one source for all three stacks.
apiVersion: v1
kind: Secret
metadata:
  name: crowdsec-config
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  acquis.yaml: |
    # AppSec only. This pod parses no log files — the traefik access log is parsed by the
    # sidecar agent in the traefik pod, and daniel-server's logs arrive via its agent (B2).
    source: appsec
    listen_addr: 0.0.0.0:{{ crowdsec_k8s_appsec_port }}
    appsec_config: crowdsecurity/appsec-default
    name: k8s-traefik-appsec
    labels:
      type: appsec
  profiles.yaml: |
    {{ lookup('file', playbook_dir + '/roles/k8s/crowdsec/files/crowdsec-profiles.yaml') | indent(4) }}
  whitelist.yaml: |
    {{ lookup('file', playbook_dir + '/roles/k8s/crowdsec/files/crowdsec-whitelist.yaml') | indent(4) }}
  trusted-remote-whitelist.yaml: |
    {{ lookup('file', playbook_dir + '/roles/k8s/crowdsec/files/crowdsec-trusted-remote-whitelist.yaml') | indent(4) }}
  discord.yaml: |
    {{ lookup('template', playbook_dir + '/roles/k8s/crowdsec/templates/crowdsec-discord.yaml.j2') | indent(4) }}
---
# Runtime credentials, injected as env. BOUNCER_KEY_<name> pre-registers a bouncer on LAPI
# init; AGENT_USERNAME/PASSWORD is the identity the image entrypoint registers/logs-in the
# in-pod agent with. The traefik-sidecar machine is registered by a post-deploy task.
apiVersion: v1
kind: Secret
metadata:
  name: crowdsec-env
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  BOUNCER_KEY_k8straefik: "{{ crowdsec_k8s_bouncer_api_key }}"
  # BOUNCER_KEY_dockertraefik retired at E7 (2026-08-13): its bouncer died with the
  # Docker edge, and a pre-registered key for a dead bouncer is pure attack surface.
  # NB removing the env does NOT deregister a bouncer the entrypoint already created —
  # the E7 cleanup ran `cscli bouncers delete dockertraefik` in the pod.
  AGENT_USERNAME: "{{ crowdsec_k8s_engine_machine }}"
  AGENT_PASSWORD: "{{ crowdsec_k8s_agent_password }}"
