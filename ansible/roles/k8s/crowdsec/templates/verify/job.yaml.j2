{#
  crowdsec's verify Job and the ConfigMap that carries its script.

  This directory is `verify/`, which the renderer emits into `crowdsec-verify` once the
  `crowdsec` Kustomization reads Ready (D5, *`<tag>-verify`*). The renderer passes
  `flux_job_image` and `flux_job_connect`, the helper's text, to every `templates/verify/` file
  (`render_tag`).

  The Job runs `files/crowdsec_verify.py`, the successor of the ban-and-lift gate, with no
  `pods/exec` grant: it bans daniel-pi through LAPI's machine API, reads the edge's answers to
  the Pi's probe from Prometheus, and lifts the ban in every exit path. The script's docstring
  says how each hop moved, and why the bouncer-pull hop has no Job form. Both names end in a
  digest, as the Job census requires: the ConfigMap's of its data, the Job's of its spec.

  The spec embeds a digest of the inputs that roll the crowdsec pod, the ones `checksum/restart`
  hashes under Flux (`scripts/renderer/renderer_lib/restart.py`): the rendered Deployment and
  `crowdsec-jobs` ConfigMap, the `crowdsec-config`, `crowdsec-env` and `crowdsec-jobs` Secret
  templates with every file `crowdsec-config` embeds, and the `cluster-vars.source` digest of
  each key those Secrets read. So every change that rolls the pod renames the Job, and Flux runs
  it again, as Ansible ran the gate on every deploy. The node-agent DaemonSet is a restart
  target too, but the Job tests the LAPI and the edge, not the agents, so its inputs stay out.
  `tests/test_crowdsec_verify.py` fails if a ConfigMap or Secret the pod names drops out.

  The `lapi-register` initContainer on the crowdsec pod registers the `crowdsec-verify`
  machine this Job logs in as. The gate's `last_pull` wait (hop 2) has no Job form, so a
  missing 403 no longer says which of its two causes happened.

  The caller census (D5, *A fence admits every Job that dials through it*). The pod is
  `app: crowdsec-verify` in `k8s_namespace`. It execs into nothing and dials:
    - crowdsec:{{ crowdsec_k8s_lapi_port }}, the LAPI, through the LAPI fence in
      netpol-baseline's `networkpolicy-crowdsec.yaml.j2`, which lists `crowdsec-verify` on the
      LAPI port alone. netpol-baseline's crowdsec row (`expect: refused`) shows that fence
      refuses an unlisted pod;
    - prometheus.{{ k8s_observability_namespace }}:9090, through the `homelab` peers of
      netpol-baseline's `networkpolicy-prometheus.yaml.j2`, which list it too, with
      netpol-baseline's prometheus row as its refused leg.
  Without a peer, the helper's 60 seconds of refused connects run out and the Job fails
  closed, naming the channel or the LAPI login.
#}
{% set script_name = 'crowdsec_verify.py' %}
{% set script_dir = '/job' %}
{% set data = {
  script_name: lookup('file', playbook_dir + '/roles/k8s/crowdsec/files/' + script_name, rstrip=False),
  'flux_job_connect.py': flux_job_connect,
} %}
{% set configmap_name = 'crowdsec-verify-' + ({'data': data, 'binaryData': {}} | to_json(sort_keys=True, separators=(',', ':')) | hash('sha256'))[:8] %}
{#- The pod's roll inputs, as `checksum/restart` hashes them; see the note above. The Secret
    templates and the files they embed are read raw, never rendered, and `cluster-vars.source`
    holds a digest of each key's ciphertext, so no value enters the hash. The ConfigMap holds no
    secret (`ansible/tests/k8s/test_no_secret_in_a_moved_jobs_configmap.py`), so it renders. -#}
{% set role_dir = playbook_dir + '/roles/k8s/crowdsec/' %}
{% set roll = namespace(
  text=lookup('template', 'deployment.yaml.j2') + lookup('template', 'jobs-configmap.yaml.j2'),
  secrets=lookup('file', role_dir + 'templates/config-secret.yaml.j2')
    + lookup('file', role_dir + 'templates/jobs-secret.yaml.j2')
    + lookup('file', role_dir + 'templates/config/crowdsec-discord.yaml.j2')
    + lookup('file', role_dir + 'files/crowdsec-profiles.yaml')
    + lookup('file', role_dir + 'files/crowdsec-whitelist.yaml')
    + lookup('file', role_dir + 'files/crowdsec-trusted-remote-whitelist.yaml'),
) %}
{% for line in lookup('file', playbook_dir + '/vars/cluster-vars.source').splitlines() if line and not line.startswith('#') and ('{{ ' + line.split()[0] + ' ') in roll.secrets %}
{% set roll.text = roll.text + line %}
{% endfor %}
{% set roll_digest8 = ((roll.text + roll.secrets) | hash('sha256'))[:8] %}
{% set spec_text %}
# A retry would ban the Pi a second time, and a flaky check must fail rather than pass on it.
backoffLimit: 0
# Below the 600s `manifests_rollout_timeout_default` every `<tag>-verify` Kustomization takes:
# the login, the ban and its read-back at 10s each plus 60s of connect retries on the first,
# then the 300s window.
activeDeadlineSeconds: 480
template:
  metadata:
    labels:
      app: crowdsec-verify
  spec:
    serviceAccountName: crowdsec-verify
    # The Job reads no Kubernetes API, so its pod holds no token.
    automountServiceAccountToken: false
    restartPolicy: Never
    enableServiceLinks: false
    securityContext:
      runAsNonRoot: true
      runAsUser: 65534
      runAsGroup: 65534
      seccompProfile:
        type: RuntimeDefault
    containers:
      - name: verify
        image: {{ flux_job_image }}
        command:
          - python3
          - {{ script_dir }}/{{ script_name }}
        env:
          - name: LAPI_URL
            value: "http://crowdsec.{{ k8s_namespace }}.svc.cluster.local:{{ crowdsec_k8s_lapi_port }}"
          - name: LAPI_MACHINE
            value: crowdsec-verify
          - name: LAPI_PASSWORD
            valueFrom:
              secretKeyRef:
                name: crowdsec-verify
                key: lapi_password
          # daniel-pi's address, the client address Traefik sees for the Pi's probe.
          - name: BAN_IP
            value: "{{ hostvars['daniel-pi'].server_ip }}"
          # The decision outlives the window, and the script lifts it the moment it ends.
          - name: BAN_DURATION
            value: 15m
          - name: PROMETHEUS_URL
            value: "http://prometheus.{{ k8s_observability_namespace }}.svc.cluster.local:9090"
          # One 1-minute probe period, one 1-minute scrape and its 30s timeout, with slack.
          - name: WINDOW_SECONDS
            value: "300"
          # Renames the Job whenever the crowdsec pod rolls; see the note above.
          - name: CROWDSEC_ROLL_DIGEST8
            value: "{{ roll_digest8 }}"
          - name: PYTHONDONTWRITEBYTECODE
            value: "1"
        resources:
          requests:
            cpu: 10m
            memory: 32Mi
          limits:
            memory: 64Mi
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop:
              - ALL
        volumeMounts:
          - name: script
            mountPath: {{ script_dir }}
            readOnly: true
    volumes:
      - name: script
        configMap:
          name: {{ configmap_name }}
{% endset %}
{% set spec = spec_text | from_yaml %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ configmap_name }}
  namespace: {{ k8s_namespace }}
data:
{% for key, text in data | dictsort %}
  {{ key }}: {{ text | to_json }}
{% endfor %}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: crowdsec-verify-{{ (spec | to_json(sort_keys=True, separators=(',', ':')) | hash('sha256'))[:8] }}
  namespace: {{ k8s_namespace }}
  annotations:
    homelab/job-kind: verify
spec:
{{ spec_text | indent(2, true) }}
