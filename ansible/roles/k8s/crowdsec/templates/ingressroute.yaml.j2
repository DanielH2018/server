{% from 'ingressroute.yml.j2' import ingressroute with context %}
---
{# D3: machine-key API for LAN agents and bouncers (daniel-server's demoted engine + its
   traefik plugin from B2 on). TLS-terminated at the VIP with the LE wildcard, deliberately
   NOT Authelia-gated — clients authenticate with LAPI machine/bouncer keys, and forward-auth
   would break them. No bridge_hostname: nothing ever called an unsuffixed name. #}
{{ ingressroute(
    container_item.name,
    container_item.hostname | default(container_item.name),
    container_item.port,
    false
  )
}}
---
{# The Metabase dashboard (B2c) — human UI, so Authelia-gated like its Docker predecessor.
   Targets the crowdsec-dashboard Service (same pod; see service.yaml.j2 for why a second
   Service exists at all); the hostname rides the entry's extra_hostnames for its Pi-hole
   override. #}
{{ ingressroute(
    'crowdsec-dashboard',
    container_item.extra_hostnames[0],
    crowdsec_k8s_dashboard_port,
    true
  )
}}
