{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: crowdsec
  namespace: {{ k8s_namespace }}
spec:
  # RWO DB volume — the old engine must release it before a new one opens the SQLite file.
{{ spec_shell('Recreate') }}
  replicas: 1
  selector:
    matchLabels:
      app: crowdsec
  template:
    metadata:
      labels:
        app: crowdsec
        netpol-baseline: enforced
    spec:
      # Pinned with the rest of the home-critical chain to the node announcing its VIPs
      # (#3452); the DECIDED marker in roles/k8s/home-assistant/templates/deployment.yaml.j2
      # has why.
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_primary_node }}
      # The ServiceAccount is the crowdsec-jobs sidecar's (jobs-rbac.yaml.j2). Its token is not
      # automounted: the crowdsec-jobs-token volume projects it into the sidecar alone, so the
      # engine container holds no Kubernetes credential. That volume sits off the default path,
      # which the rendered-property row no-mount-shadows-the-serviceaccount-token keeps free, and
      # the sidecar's kubectl finds it through the kubeconfig in the crowdsec-jobs ConfigMap.
{{ pod_shell(containers_list | tier_priority_class('crowdsec'), service_account='crowdsec-jobs', automount=false) }}
      initContainers:
        # /etc/crowdsec is an emptyDir the image entrypoint populates with defaults on
        # start; this seeds our config first so the entrypoint treats it as existing
        # config rather than overwriting it. Mirrors the Docker flow, where the image
        # populated ./crowdsec-config once and Ansible dropped these same files in.
        - name: config-install
          image: {{ crowdsec_k8s_image }}
          command:
            - /bin/sh
            - -c
            - >-
              install -m 644 /seed/acquis.yaml /seed/profiles.yaml /etc/crowdsec/ &&
              install -d /etc/crowdsec/parsers/s02-enrich /etc/crowdsec/notifications &&
              install -m 644 /seed/whitelist.yaml /seed/trusted-remote-whitelist.yaml
              /etc/crowdsec/parsers/s02-enrich/ &&
              install -m 600 /seed/discord.yaml /etc/crowdsec/notifications/
{{ hardened_security_context() }}
          volumeMounts:
            - name: crowdsec-seed
              mountPath: /seed
              readOnly: true
            - name: crowdsec-etc
              mountPath: /etc/crowdsec
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
        # The crowdsec-jobs sidecar's two binaries, copied into the shared tools emptyDir. cscli
        # comes from the engine's own image, so the jobs run the same cscli as the LAPI. It is
        # statically linked, which is why it runs in the python image (defaults/main.yml).
        - name: jobs-cscli
          image: {{ crowdsec_k8s_image }}
          command: ["cp", "/usr/local/bin/cscli", "/tools/cscli"]
          # nobody: the emptyDir is world-writable and the copy keeps its 0755, so the root
          # sidecar runs it as `other`.
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=65534, run_as_group=65534) }}
          volumeMounts:
            - name: crowdsec-jobs-tools
              mountPath: /tools
{{ container_resources(cpu_limit='100m', mem_limit='64Mi', cpu_request='10m', mem_request='16Mi') }}
        - name: jobs-kubectl
          image: {{ crowdsec_k8s_jobs_kubectl_image }}
          command: ["cp", "/usr/bin/kubectl", "/tools/kubectl"]
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=65534, run_as_group=65534) }}
          volumeMounts:
            - name: crowdsec-jobs-tools
              mountPath: /tools
{{ container_resources(cpu_limit='100m', mem_limit='64Mi', cpu_request='10m', mem_request='16Mi') }}
      containers:
        - name: crowdsec
          image: {{ crowdsec_k8s_image }}
          ports:
            - name: lapi
              containerPort: {{ crowdsec_k8s_lapi_port }}
            - name: appsec
              containerPort: {{ crowdsec_k8s_appsec_port }}
            - name: metrics
              containerPort: {{ containers_list | metrics_port('crowdsec') }}
          env:
            - name: TZ
              value: "{{ tz }}"
            - name: COLLECTIONS
              value: "{{ crowdsec_k8s_collections }}"
          envFrom:
            - secretRef:
                name: crowdsec-env
          # Root, as in Docker: the LAPI plugin broker forks the notification plugin and
          # drops it to 'nobody' (SETUID/SETGID); CHOWN+DAC_OVERRIDE cover first-touch
          # ownership of the PVC-backed DB dir. No host log mounts here, so the Docker
          # copy's broad DAC_OVERRIDE rationale shrinks to that.
{{ hardened_security_context(add=['CHOWN', 'DAC_OVERRIDE', 'SETUID', 'SETGID']) }}
          volumeMounts:
            - name: crowdsec-etc
              mountPath: /etc/crowdsec
            - name: crowdsec-db
              mountPath: /var/lib/crowdsec/data
            - name: crowdsec-tmp
              mountPath: /tmp
          # Same rationale as the Docker healthcheck: `cscli lapi status` round-trips the
          # LAPI with real credentials, so ready means "the WAF/ban chain can answer", not
          # "the process exists". No secret appears in the probe spec — cscli reads creds
          # from files inside the pod.
          readinessProbe:
            exec:
              command: ["cscli", "lapi", "status"]
            initialDelaySeconds: 15
            periodSeconds: 15
            timeoutSeconds: 10
          livenessProbe:
            exec:
              command: ["cscli", "lapi", "status"]
            initialDelaySeconds: 60
            periodSeconds: 60
            timeoutSeconds: 10
{{ container_resources(cpu_limit=crowdsec_k8s_cpu_limit, mem_limit=crowdsec_k8s_mem_limit, cpu_request=crowdsec_k8s_cpu_request, mem_request=crowdsec_k8s_mem_request) }}
        # The remote allowlist, the AppSec verify, the bouncer prune and the home allowlist, each
        # on its old host cron's schedule (files/crowdsec_jobs.py). They need cscli against the LAPI's own
        # database, and a container in this pod reaches it with no `pods/exec` grant: the
        # operator's ruling of 2026-10-18 on #5655. It shares the engine's config and database
        # volumes, and cscli reads them here as it does in the engine container.
        #
        # Root, like the engine container: the SQLite file and its directory belong to root, and
        # cscli writes allowlist rows and prunes bouncer rows there. Every capability is dropped,
        # because the owner's write bit is all it needs. /etc/crowdsec is mounted read-only, so
        # a job cannot change the engine's config.
        #
        # No probe. A running container counts as ready, and a crash takes the pod out of Ready
        # and the LAPI out of its Service until the restart. So the scheduler never exits on a
        # job's failure, and its memory limit is twice the measured peak.
        - name: crowdsec-jobs
          image: {{ crowdsec_k8s_jobs_image }}
          command: ["python3", "/jobs/crowdsec_jobs.py"]
          env:
            # kubectl's discovery cache goes under $HOME.
            - name: HOME
              value: /tmp
            # The ConfigMap mount is read-only, so Python cannot write __pycache__ there.
            - name: PYTHONDONTWRITEBYTECODE
              value: "1"
            # A pipe is block-buffered, and an OOM kill discards the buffer, so every verdict
            # line reaches the container log as it is printed.
            - name: PYTHONUNBUFFERED
              value: "1"
            - name: KUBECONFIG
              value: /jobs/kubeconfig
            - name: REMOTE_ALLOWLIST_PUSH_URL
              valueFrom:
                secretKeyRef:
                  name: crowdsec-jobs
                  key: remote_allowlist_push_url
            - name: APPSEC_PUSH_URL
              valueFrom:
                secretKeyRef:
                  name: crowdsec-jobs
                  key: appsec_push_url
            - name: HOME_ALLOWLIST_PUSH_URL
              valueFrom:
                secretKeyRef:
                  name: crowdsec-jobs
                  key: home_allowlist_push_url
            # The home allowlist reads the addresses the crowdsec-home-ips CronJob writes, and
            # pushes down once their lookup time is older than three of its periods.
            - name: HOME_IPS_CONFIGMAP
              value: "{{ crowdsec_k8s_home_ips_configmap }}"
            - name: HOME_IPS_STALE_AFTER_S
              value: "{{ crowdsec_k8s_home_ips_stale_after_seconds }}"
{{ hardened_security_context(read_only=true) }}
          volumeMounts:
            - name: crowdsec-etc
              mountPath: /etc/crowdsec
              readOnly: true
            - name: crowdsec-db
              mountPath: /var/lib/crowdsec/data
            - name: crowdsec-jobs-code
              mountPath: /jobs
              readOnly: true
            - name: crowdsec-jobs-tools
              mountPath: /tools
              readOnly: true
            - name: crowdsec-jobs-token
              mountPath: /var/run/crowdsec-jobs
              readOnly: true
            - name: crowdsec-jobs-tmp
              mountPath: /tmp
            # The engine's entrypoint links every entry of the image's
            # /staging/var/lib/crowdsec/data into crowdsec-db, `trace` among them. This image has
            # no /staging, so without this mount the link dangles, and every cscli call fails
            # with `while setting up trace directory: mkdir /var/lib/crowdsec/data/trace: file
            # exists`. The other links name data files that no job's cscli command opens.
            - name: crowdsec-jobs-trace
              mountPath: /staging/var/lib/crowdsec/data/trace
{{ container_resources(cpu_limit=crowdsec_k8s_jobs_cpu_limit, mem_limit=crowdsec_k8s_jobs_mem_limit, cpu_request=crowdsec_k8s_jobs_cpu_request, mem_request=crowdsec_k8s_jobs_mem_request) }}
      volumes:
        - name: crowdsec-seed
          secret:
            secretName: crowdsec-config
        - name: crowdsec-etc
          emptyDir: {}
        - name: crowdsec-db
          persistentVolumeClaim:
            claimName: {{ crowdsec_k8s_claim }}
        - name: crowdsec-tmp
          emptyDir: {}
        - name: crowdsec-jobs-code
          configMap:
            name: crowdsec-jobs
        - name: crowdsec-jobs-tools
          emptyDir: {}
        - name: crowdsec-jobs-tmp
          emptyDir: {}
        - name: crowdsec-jobs-trace
          emptyDir: {}
        # What automounting would give every container, given to the sidecar alone: a bound
        # token and the cluster CA, which jobs-configmap.yaml.j2's kubeconfig names.
        - name: crowdsec-jobs-token
          projected:
            sources:
              - serviceAccountToken:
                  path: token
                  expirationSeconds: 3607
              - configMap:
                  name: kube-root-ca.crt
                  items:
                    - key: ca.crt
                      path: ca.crt
