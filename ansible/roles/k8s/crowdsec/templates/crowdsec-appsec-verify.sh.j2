#!/bin/bash
# Watchdog for the k8s edge's CrowdSec AppSec inline WAF (dynamic.yaml.j2
# crowdsecAppsecEnabled + the appsec acquisition in this role). The bouncer fails OPEN
# (crowdsecAppsecUnreachableBlock: false), so a broken appsec engine — a bad
# `cscli collections upgrade`, a hub rename dropping the appsec rulesets — silently
# degrades the edge to ban-list-only with no other signal: the crowdsec pod stays up and
# LAPI-healthy. Asserts the live engine has >=1 ENABLED appsec-config AND >=1 ENABLED
# appsec-rule — both traffic-independent (request counters read zero on a quiet homelab).
#
# MOVED HERE from the containers/traefik role at E7 (2026-08-13): the Docker edge and its
# verifier retired, and this was the estate's only WAF-actually-enforcing signal. Reporting
# follows the home-allowlist pattern for daniel-box crons — pushes the SAME "CrowdSec
# AppSec" Kuma monitor directly (no monitor-bridge hop, same token).
#
# set -uo (not -euo): a failed assert must be captured + reported, not swallowed.
set -uo pipefail

export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin  # cron ships a bare PATH

# shellcheck source=/dev/null
source /usr/local/lib/kuma-push-lib.sh || {
  logger -t crowdsec-appsec-verify "kuma-push-lib.sh missing — run initial_setup on this host"
  exit 1
}

KUMA_HOST="uptime-kuma.local.{{ domain }}"
# Pinned to the cluster ingress VIP, matching every other daniel-box health cron. Not a routing
# change: Pi-hole maps every k8s service name to this VIP (pihole-dnsmasq.conf.j2) and
# `getent hosts uptime-kuma.local.{{ domain }}` on this host returns it, so --resolve only removes
# the DNS hop the push used to depend on.
KUMA_RESOLVE_IP="{{ k3s_metallb_ingress_vip }}"
PUSH_URL="https://${KUMA_HOST}/api/push/{{ monitor_bridge_appsec_push_token }}"

# Via the shared library, which feeds the token-bearing URL to curl on stdin (`-K -`) instead of
# as an argv element: /proc is mounted without hidepid here, so any local user can read another
# user's /proc/<pid>/cmdline for the life of the call.
push() { # up|down msg
  kuma_push "$1" "$2" "$PUSH_URL" "$KUMA_HOST" "$KUMA_RESOLVE_IP" crowdsec-appsec-verify
}

# Every DOWN goes to syslog as well as to Kuma. Kuma keeps only CURRENT state, so a reason
# pushed and nowhere else is unrecoverable the moment the episode clears — this check
# flapped 461 times between 2026-08-16 and 2026-08-21 and left no retrievable message
# anywhere, because push() loggers only when curl ITSELF fails. `probe.py alerts`
# reconstructs host-cron episodes from `{job="syslog"} |= "status=down"`, so the literal
# prefix is load-bearing: it is what parse_syslog_down_line() matches (probe.py:1384).
# DECIDED: `status=down $1`, not a bare "$1". The sibling home-allowlist fail() logged the bare
# message and was invisible to that reconstruction until 2026-08-24; both now carry the prefix.
fail() { push down "$1"; logger -t crowdsec-appsec-verify "status=down $1"; exit 1; }

cscli_pod() {
  /usr/local/bin/k3s kubectl -n {{ k8s_namespace }} exec deploy/crowdsec -c crowdsec -- cscli "$@"
}

# DEFER a TOTAL crowdsec outage to the monitors that already own it (the cluster scrape
# job + k3s Workload Health) — this check owns ONLY the fail-open-while-up blind spot,
# and paging here too would triple-page one root cause. Push up so the monitor's
# heartbeat stays alive through engine restarts.
if ! cscli_pod lapi status >/dev/null 2>&1; then
  push up "crowdsec unreachable — deferring to the scrape job + workload health"
  exit 0
fi

CONFIGS=$(cscli_pod appsec-configs list -o json 2>/dev/null \
  | jq '[.["appsec-configs"][]? | select(.status == "enabled")] | length' 2>/dev/null)
if [ -z "$CONFIGS" ]; then
  fail "cscli appsec-configs list failed though LAPI is up (appsec query error)"
fi
if [ "$CONFIGS" -lt 1 ]; then
  fail "no enabled appsec-configs — inline WAF not loaded, edge is ban-list-only"
fi

# `status == "enabled"` — a loaded, non-disabled rule — is the closest traffic-independent
# proxy for "the WAF is actually armed" (inband-vs-outofband is a config assignment, not a
# rule property).
RULES=$(cscli_pod appsec-rules list -o json 2>/dev/null \
  | jq '[.["appsec-rules"][]? | select(.status == "enabled")] | length' 2>/dev/null)
if [ -z "$RULES" ]; then
  fail "cscli appsec-rules list failed though LAPI is up (appsec query error)"
fi
if [ "$RULES" -lt 1 ]; then
  fail "0 enabled appsec-rules loaded — WAF config present but not enforcing"
fi

push up "$CONFIGS appsec-configs enabled, $RULES enabled rules loaded"
