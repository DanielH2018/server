{% from 'security-context.yml.j2' import hardened_security_context with context %}
---
# Per-node log-processing agent (Phase F drain, 2026-08-13): tails the node's auth.log
# and delivers to the in-cluster LAPI. Succeeds the demoted Docker agent on
# daniel-server (containers/traefik, retired with this) and ADDS daniel-box's
# never-covered host SSH signal. Same shape as the traefik pod's sidecar agent — the
# repo's reference for an agent-only crowdsec container — with a per-node identity.
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: crowdsec-node-agent
  namespace: {{ k8s_namespace }}
spec:
  selector:
    matchLabels:
      app: crowdsec-node-agent
  template:
    metadata:
      labels:
        app: crowdsec-node-agent
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      initContainers:
        # Seeds /etc/crowdsec before the entrypoint fills in defaults: the auth.log
        # acquis plus the same whitelist parsers the other agents carry (from the
        # crowdsec-config Secret — one source for all stacks).
        - name: config-install
          image: {{ crowdsec_k8s_image }}
          command:
            - /bin/sh
            - -c
            - >-
              install -m 644 /seed-acquis/acquis.yaml /etc/crowdsec/ &&
              install -d /etc/crowdsec/parsers/s02-enrich &&
              install -m 644 /seed/whitelist.yaml /seed/trusted-remote-whitelist.yaml
              /etc/crowdsec/parsers/s02-enrich/
{{ hardened_security_context() }}
          volumeMounts:
            - name: crowdsec-acquis
              mountPath: /seed-acquis
              readOnly: true
            - name: crowdsec-secret
              mountPath: /seed
              readOnly: true
            - name: crowdsec-etc
              mountPath: /etc/crowdsec
          resources:
            limits:
              cpu: 250m
              memory: 128Mi
            requests:
              cpu: 10m
              memory: 16Mi
        # Wait for the LAPI to answer before the agent starts. The entrypoint calls
        # `cscli lapi register`/`authenticate watcher` immediately and exits FATAL if the LAPI
        # is unreachable — measured 2026-08-31: container up 07:43:23Z, dead 07:43:27Z with
        # "dial tcp ...:8080: connect: connection refused", so there is no internal retry to
        # rely on. An already-authenticated agent tolerates a LAPI bounce fine (the liveness
        # probe below is `cscli lapi status` at 60s with the default failureThreshold 3); the
        # gap is only at AGENT start, which in practice means the weekly node reboot racing
        # the LAPI pod. That produced five crash-backoff cycles in one hour, and during them
        # this node's auth.log is unparsed — the SSH brute-force scenarios are the ones that
        # go blind. Waiting turns "crash, backoff, crash" into "not started yet".
        - name: wait-for-lapi
          image: {{ crowdsec_k8s_image }}
          command:
            - /bin/sh
            - -c
            # Bounded, not unbounded: 60 x 2s. If the LAPI is still down after two minutes the
            # init container fails and the pod backs off exactly as it does today, so this can
            # only improve on the current behaviour, never mask a genuinely dead LAPI.
            #
            # `nc` is busybox's, and this image is busybox-based — the config-install container
            # above already relies on the busybox `install` applet in the same image. Same
            # pattern as n8n's wait-for-broker (deployment-runners.yaml.j2:35). The retry also
            # absorbs kube-router's source-pod lookup lagging pod creation, which a single
            # connect attempt at init time would trip over.
            - >-
              i=0;
              until nc -z crowdsec {{ crowdsec_k8s_lapi_port }}; do
                i=$((i+1));
                [ "$i" -ge 60 ] && echo "LAPI still unreachable after 120s" >&2 && exit 1;
                sleep 2;
              done;
              echo "LAPI reachable after $((i*2))s"
{{ hardened_security_context() }}
          resources:
            limits:
              cpu: 100m
              memory: 32Mi
            requests:
              cpu: 10m
              memory: 16Mi
      automountServiceAccountToken: false
      priorityClassName: homelab-critical
      containers:
        - name: crowdsec-agent
          image: {{ crowdsec_k8s_image }}
          env:
            - name: TZ
              value: "{{ tz }}"
            - name: DISABLE_LOCAL_API
              value: "true"
            - name: LOCAL_API_URL
              value: "http://crowdsec:{{ crowdsec_k8s_lapi_port }}"
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            # Per-node machine identity — two pods sharing one machine name would fight
            # over its heartbeat. Registered by the "Register the remote agent machines"
            # task (crowdsec_k8s_node_agent_machines must list every node).
            - name: AGENT_USERNAME
              value: "k8s-node-agent-$(NODE_NAME)"
            - name: AGENT_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: crowdsec-env
                  key: AGENT_PASSWORD
            - name: COLLECTIONS
              value: "{{ crowdsec_k8s_node_agent_collections }}"
          # Root (image default) — auth.log is 640 syslog:adm on the host.
          # Read the host's root-owned log files; nothing here writes them.
{{ hardened_security_context(add=['DAC_READ_SEARCH']) }}
          ports:
            - name: metrics
              containerPort: 6060
          volumeMounts:
            - name: crowdsec-etc
              mountPath: /etc/crowdsec
            # Hub datafiles re-download on start; the sqlite DB lives only in the LAPI pod.
            - name: crowdsec-data
              mountPath: /var/lib/crowdsec/data
            - name: crowdsec-host-logs
              mountPath: /var/log
              readOnly: true
            - name: crowdsec-tmp
              mountPath: /tmp
          livenessProbe:
            # Round-trips the LAPI with the agent's own credentials — alive means
            # "parsing and able to deliver".
            exec:
              command: ["cscli", "lapi", "status"]
            initialDelaySeconds: 30
            periodSeconds: 60
            timeoutSeconds: 15
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              cpu: "1"
              memory: 512Mi
      volumes:
        - name: crowdsec-acquis
          configMap:
            name: crowdsec-node-agent-acquis
        - name: crowdsec-secret
          secret:
            secretName: crowdsec-config
        - name: crowdsec-etc
          emptyDir: {}
        - name: crowdsec-data
          emptyDir: {}
        - name: crowdsec-host-logs
          hostPath:
            path: /var/log
            type: Directory
        - name: crowdsec-tmp
          emptyDir: {}
