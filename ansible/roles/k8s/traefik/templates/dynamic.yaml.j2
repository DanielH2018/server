{#
  The middlewares and TLS options carried over from the Docker instance's config.yml.j2.

  Deliberately NOT carried over for slice 1:
    csp-karakeep        lives in the karakeep role instead, beside the Service it applies to
    rate-limit-livesync superseded by rate-limit-public-livesync, below (the bridge-era twins retired 2026-08-12 with the return-leg)
  crowdsec arrived at slice-6 B1 (bottom of this file), pointed at the in-cluster LAPI.
  No TLSStore either: every IngressRoute states its own tls.domains via the ingressroute()
  macro, so a store's defaultGeneratedCert would be a second source of truth for the SAN set.
#}
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: default-headers
  namespace: {{ k8s_namespace }}
spec:
  headers:
    customResponseHeaders:
      Permissions-Policy: "geolocation=(self), microphone=(), camera=(), fullscreen=(self), usb=()"
      # No global Content-Security-Policy, same as the Docker side: customResponseHeaders
      # REPLACES the backend's header, so a blanket CSP clobbers the stricter per-app ones
      # (FreshRSS even detects the weakened header and warns). Clickjacking is covered by
      # X-Frame-Options SAMEORIGIN below; set CSP per-app where the origins are known-good.
    referrerPolicy: "strict-origin-when-cross-origin"
    browserXssFilter: true
    contentTypeNosniff: true
    forceSTSHeader: true
    stsIncludeSubdomains: true
    # No stsPreload: browsers only honour preload at max-age >= 1 year, so at 180 days it
    # advertises an intent we do not fulfil — and preloading is a hard-to-reverse commitment
    # across every subdomain.
    stsSeconds: 15552000
    customFrameOptionsValue: SAMEORIGIN
    customRequestHeaders:
      X-Forwarded-Proto: https
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: rate-limit
  namespace: {{ k8s_namespace }}
spec:
  rateLimit:
    average: 300
    burst: 150
    period: 1m
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  # livesync's replication ceiling (CouchDB sync is extremely chatty — _changes,
  # _revs_diff, _bulk_docs, per-chunk reads; the shared 300/min 429'd a phone mid-pull,
  # 2026-08-06). Default per-IP keying: requests arrive with real client addresses
  # (externalTrafficPolicy: Local). Referenced by the file-provider token gate
  # (livesync-gate-secret.yaml.j2).
  name: rate-limit-public-livesync
  namespace: {{ k8s_namespace }}
spec:
  rateLimit:
    average: 6000
    burst: 600
    period: 1m
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  # Response compression, attached ENTRYPOINT-WIDE in static-config.yaml.j2 rather than
  # per-router: there is no service here that wants its HTML/JSON shipped uncompressed, so
  # an opt-in list would only ever be a list of everything, drifting one service at a time.
  # Nothing compressed anything before this (2026-08-16) — invisible on the LAN, and the
  # reason a Grafana board or an *arr UI feels heavy over WireGuard or through Cloudflare.
  name: compress
  namespace: {{ k8s_namespace }}
spec:
  compress:
    # An ALLOW-list, not excludedContentTypes. Two reasons, and the first is a correctness
    # trap: Traefik compares excludedContentTypes by parsed media type EQUALITY, so the
    # obvious-looking `video/` prefix entry matches nothing and Jellyfin's streams would be
    # gzipped — CPU burned to make already-compressed bytes slightly larger. Enumerating
    # every video/image/archive type instead is a list that silently rots as new types
    # appear. Naming what compresses well is the closed set; everything else — video, audio,
    # images, torrents, fonts, downloads — is excluded by construction.
    includedContentTypes:
      - text/html
      - text/plain
      - text/css
      - text/javascript
      - text/xml
      - application/javascript
      - application/json
      - application/manifest+json
      - application/xml
      - application/rss+xml
      - image/svg+xml
    # Below this the Content-Encoding/Vary header overhead costs more than the saving.
    # Matches Traefik's own default; stated because it is a tuning knob, not a constant.
    minResponseBodyBytes: 1024
---
apiVersion: traefik.io/v1alpha1
kind: TLSOption
metadata:
  # NOT `default`. That name is reserved: Traefik registers a TLSOption called `default` as
  # the global default options rather than under <namespace>-default@kubernetescrd, so an
  # IngressRoute that names it explicitly can never resolve it and every affected router
  # fails to build:
  #   error "unknown TLS options: homelab-default@kubernetescrd"
  # The object exists and is valid the whole time, which is what makes it confusing — the
  # reference is looking up a key the provider never registered.
  name: modern
  namespace: {{ k8s_namespace }}
spec:
  # Referenced by name from the ingressroute() macro. Keep that reference and this name in
  # step — a mismatch is caught by test_k8s_manifests.py, not by the deploy.
  minVersion: VersionTLS12
  cipherSuites:
    - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
    - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
    - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
    - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
    - TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305
    - TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305
---
# Slice-6 B1 — the CrowdSec bouncer, carried from the Docker edge's config.yml.j2 with two
# deliberate differences: the LAPI is the in-cluster engine (Service `crowdsec`), and the
# key is a FILE path, not an inline value — a Middleware CRD is readable by the read-only
# kubeconfig, so an inline crowdsecLapiKey would hand the ban-management API to anything
# holding that kubeconfig. The file lives in the traefik-crowdsec Secret, mounted into the
# traefik container only.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: crowdsec
  namespace: {{ k8s_namespace }}
spec:
  plugin:
    bouncer:
      enabled: true
      crowdsecLapiKeyFile: /secrets/crowdsec/lapi_key
      crowdsecLapiHost: "crowdsec:{{ crowdsec_k8s_lapi_port }}"
      crowdsecMode: stream
      updateIntervalSeconds: 60
      # Consecutive failed stream polls tolerated before the plugin declares the stream
      # unhealthy. The plugin's default is 0 — ONE missed poll flips it, and an unhealthy
      # stream is a blanket 403 for every IP (bouncer.go ServeHTTP: "if we cannot join the
      # stream we forbid the request to go on"), which is a self-inflicted edge outage, not
      # a security control. This Deployment is replicas:1 + strategy:Recreate on an RWO PVC,
      # so a LAPI gap on every roll is EXPECTED, not exceptional: 2026-08-16 a routine
      # crowdsec roll took the whole fleet 403 for 2 minutes.
      #
      # 5 ≈ 6 min of tolerance, which covers a roll whose metabase image pull is cold.
      # Safe because the cache lookup happens BEFORE this health gate: an IP already in the
      # decision cache is still blocked, and AppSec below still inspects inline. Only a
      # NEWLY added ban is delayed by up to the tolerance window. Not -1 (never flip) — a
      # permanently dead LAPI must still eventually fail closed rather than serve a
      # silently frozen ban-list forever.
      updateMaxFailure: 5
      # AppSec Component — inline L7 WAF. stream mode above is the reactive ban-list (bans
      # an IP after a pattern of log lines); this inspects each request inline BEFORE the
      # backend, so a first-hit malicious payload (CVE string / SQLi / path traversal) is
      # blocked, not merely banned-after-the-fact. UnreachableBlock:false = FAIL OPEN: an
      # appsec hiccup keeps the edge serving (deferring to the ban-list) instead of 500ing
      # the fleet — the add-on must not become a new edge SPOF. FailureBlock keeps its
      # secure default (a rule-eval error on a request blocks that one request).
      crowdsecAppsecEnabled: true
      crowdsecAppsecHost: "crowdsec:{{ crowdsec_k8s_appsec_port }}"
      crowdsecAppsecUnreachableBlock: false
