{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: traefik
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  # acme.json is a ReadWriteOnce volume and two Traefiks racing to write it corrupt the
  # account registration, so the rollout must stop the old pod before starting the new one.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: traefik
  template:
    metadata:
      labels:
        app: traefik
        netpol-baseline: enforced
    spec:
      # Pinned to the VIP-announcing node while the MetalLB L2Advertisement is pinned
      # to daniel-box: with externalTrafficPolicy Local, a VIP-backed pod on the other
      # node makes the announcer DROP all forwarded LAN traffic (2026-08-14 post-boot
      # DNS blackout). DECIDED: permanent posture (operator 2026-08-14) — with ETP Local
      # load-bearing for client IPs, announcement and placement stay on one node as a
      # unit; this pin only ever moves together with the L2Advertisement nodeSelector.
      nodeSelector:
        kubernetes.io/hostname: {{ k8s_primary_node }}
      # Edge/auth/DNS eviction ordering — see setup/k3s templates/priorityclass.yaml.j2.
      priorityClassName: homelab-critical
      serviceAccountName: traefik-ingress-controller
      # No legacy Docker-link env vars for every Service in the namespace. Harmless clutter
      # here, fatal for Authelia — see that role's deployment for the failure it causes.
      enableServiceLinks: false
      securityContext:
        runAsUser: {{ traefik_k8s_uid }}
        runAsGroup: {{ traefik_k8s_uid }}
        fsGroup: {{ traefik_k8s_uid }}
{# Both init containers below are conditional, and a cluster with neither ACME nor CrowdSec
   leaves the key with no list under it. Gate the key so it is absent rather than empty. #}
{% if traefik_k8s_manage_acme or traefik_k8s_manage_crowdsec %}
      initContainers:
{% endif %}
{% if traefik_k8s_manage_acme %}
        # Traefik creates acme.json 0600 itself, but kubelet's fsGroup handling ORs group bits
        # into every file on the volume at mount time, so it comes back 0660 on every start.
        # Traefik then refuses to load the ACME account and drops the entire resolver:
        #   unable to get ACME account: permissions 660 for /data/acme.json are too open,
        #   please use 600
        #   -> The ACME resolve is skipped from the resolvers list
        # after which every router asking for that resolver fails with "Router uses a
        # nonexistent certificate resolver" and nothing serves TLS at all. The deploy stays
        # green throughout: the pod is healthy, it is just not serving HTTPS.
        #
        # This has to run on every start rather than being fixed once, because it is the mount
        # that widens the file. Reuses the Traefik image (it carries /bin/sh) so there is no
        # second image to pin and no version skew.
        - name: fix-acme-permissions
          image: {{ traefik_k8s_image }}
          command:
            - /bin/sh
            - -c
            - touch /data/acme.json && chmod 600 /data/acme.json
{{ hardened_security_context(read_only=true, non_root=true) }}
          volumeMounts:
            - name: traefik-acme
              mountPath: /data
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
{% endif %}
{% if traefik_k8s_manage_crowdsec %}
        # FIRST, before crowdsec-config-install's rsync, and the order is the whole point.
        # The image's staged hub tree is root-only, so that rsync — which runs as the pod's
        # own uid — never copies it; that is part of the exit 23 it tolerates. It does copy
        # the parser CONFIGS, which are symlinks into that tree, so
        # /etc/crowdsec/parsers/s02-enrich/geoip-enrich.yaml resolved to a hub file that was
        # never staged and the agent dropped the parser: `Ignoring file … lstat
        # /etc/crowdsec/hub/parsers/s02-enrich/crowdsecurity/geoip-enrich.yaml: no such file
        # or directory`, once per parser-load pass. GeoIP enrichment stayed dead even after
        # the datafiles were installed, on BOTH pods carrying the sidecar (#1211).
        #
        # Running this AFTER the rsync was tried and is wrong: rsync recurses from the parent
        # listing, so it creates /etc/crowdsec/hub owned by the pod uid before it fails to
        # read into it, and root with ALL dropped cannot write into another uid's directory —
        # DAC_READ_SEARCH is the READ half of the override, DAC_OVERRIDE is the write half.
        # The copy would fail, `exit 0` would swallow it, and the pod would come up 2/2 with
        # the warning intact. Going first, this creates the directory root-owned and
        # world-readable, and the rsync's own `--ignore-existing` then leaves the files alone.
        #
        # ROOT-OWNED is the half that keeps it readable, not just a consequence of needing
        # DAC_READ_SEARCH. rsync sets an existing destination directory's mode from the
        # source, and the staged hub is root-only — reproduced locally, rsync chmodded a
        # same-uid destination `hub/` to 000 and still exited 23. Here it runs as the pod uid
        # against a root-owned directory, so that chmod is refused, the 0755 survives, and the
        # refusal is one more error under the exit 23 the config install already tolerates.
        # Creating this directory as the pod uid instead would undo the fix silently.
        - name: crowdsec-hub-install
          image: {{ crowdsec_k8s_image }}
          command:
            - /bin/sh
            - -c
            # `cp -a` keeps the tree's own symlinks as symlinks; the chmod is what makes it
            # readable to the non-root agent, and the hub holds public hub content only — the
            # LAPI and online credentials sit beside it in /etc/crowdsec, not in it. Ends in
            # `exit 0` for the same reason crowdsec-data-install does: traefik rolls under
            # Recreate, so a non-zero init container takes the edge down (the #986 outage)
            # rather than costing one parser.
            - >-
              mkdir -p /etc/crowdsec/hub &&
              cp -a /staging/etc/crowdsec/hub/. /etc/crowdsec/hub/ &&
              chmod -R a+rX /etc/crowdsec/hub ||
              echo "hub stage incomplete" >&2;
              exit 0
          # Root, written out rather than built through hardened_security_context() — the macro
          # refuses uid 0 so that ansible/tests/k8s/test_root_needs_dac_capability.py can still
          # see this block in raw template text. DAC_READ_SEARCH is the read-only half of root's
          # permission-bit override, which is what reaches the root-only staged hub tree. No
          # write capability is needed because this runs first: /etc/crowdsec is the emptyDir
          # root, root-owned and empty until this container writes to it.
          securityContext:
            allowPrivilegeEscalation: false
            runAsUser: 0
            capabilities:
              add:
                - DAC_READ_SEARCH
              drop:
                - ALL
          volumeMounts:
            - name: crowdsec-etc
              mountPath: /etc/crowdsec
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
        # Seeds the agent sidecar's /etc/crowdsec before its entrypoint fills in defaults —
        # acquis pointing at the shared access log, and the same whitelist parsers as the
        # Docker edge (from the traefik-crowdsec Secret). Root like the sidecar itself.
        - name: crowdsec-config-install
          image: {{ crowdsec_k8s_image }}
          command:
            - /bin/sh
            - -c
            - >-
              (rsync -a --ignore-existing /staging/etc/crowdsec/* /etc/crowdsec
              || [ "$?" -eq 23 ]) &&
              install -m 644 /seed/acquis.yaml /etc/crowdsec/ &&
              install -d /etc/crowdsec/parsers/s02-enrich &&
              install -m 644 /seed/whitelist.yaml /seed/trusted-remote-whitelist.yaml
              /etc/crowdsec/parsers/s02-enrich/ &&
              install -m 640 /dev/null /var/log/traefik/access.log
          # The rsync is the image entrypoint's own "Populating configuration directory"
          # step (build/docker/docker_start.sh at v1.7.8), which runs under `set -e` and
          # only while /etc/crowdsec/config.yaml is absent. Run here so the sidecar never
          # runs it: about twenty staged files are root-only (the LAPI/online credentials
          # and the bundled hub tree), so a non-root rsync exits 23 (partial transfer) and
          # set -e killed the sidecar's first start on every cold boot (#976). The kubelet's
          # restart then found config.yaml, skipped the block, and worked — this seeds the
          # same state up front. Exit 23 is the only status tolerated: the files it skips are
          # the LAPI and online credentials, which the agent regenerates (`cscli lapi
          # register`) on start regardless. It also skips the bundled hub tree, which is NOT
          # re-downloaded in time for the parser load — crowdsec-hub-install above stages that
          # explicitly (#1211). Runs before the installs so the seeds win.
          # Pod default uid, not root: it creates the access log traefik must then write,
          # and root-with-ALL-caps-dropped cannot chown it back (measured on the authelia
          # pod). Creating the file as that user sidesteps the capability; the agent reads
          # it as root regardless.
{{ hardened_security_context(non_root=true) }}
          volumeMounts:
            - name: crowdsec-secret
              mountPath: /seed
              readOnly: true
            - name: crowdsec-etc
              mountPath: /etc/crowdsec
            # Pre-create the access log: pod containers start in parallel and crowdsec's
            # file acquisition does not retry a missing file — it logs one error and drops
            # the datasource for the container's lifetime, leaving a healthy-looking pod
            # with no detection. The agent only won this race here because it crash-looped
            # on its first rollout; the authelia pod lost it outright.
            - name: traefik-logs
              mountPath: /var/log/traefik
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
        # The image ships its datafiles at /staging/var/lib/crowdsec/data mode 0600 root:root
        # (measured on the v1.7.8 image), and the entrypoint SYMLINKS them into the data volume
        # rather than copying. The non-root agent then cannot read through the link, so GeoIP
        # never initialises — `unable to open GeoLite2-City.mmdb: permission denied`, and the
        # geoip-enrich parser is dead in a pod that otherwise reads healthy (#990). Copying them
        # in world-readable defeats the symlink: the entrypoint's `[ ! -e ]` guard skips a name
        # that already exists, so the agent reads these copies instead.
        - name: crowdsec-data-install
          image: {{ crowdsec_k8s_image }}
          command:
            - /bin/sh
            - -c
            # Per file, not `cp -r`: `trace/` is a 0700 directory and the db is the entrypoint's
            # own documented skip. A file that cannot be read is left to the symlink path — the
            # status quo for that name — rather than failing the pod, because traefik rolls
            # under Recreate and an init container that exits non-zero takes the edge down (the
            # #986 outage). `ls` succeeds because the directory itself is 0755.
            - >-
              for f in /staging/var/lib/crowdsec/data/*; do
              [ -f "$f" ] || continue;
              case "${f##*/}" in crowdsec.db*) continue ;; esac;
              install -m 644 "$f" /var/lib/crowdsec/data/ ||
              echo "skipped ${f##*/}" >&2;
              done; exit 0
          # Root, written out rather than built through hardened_security_context() — the macro
          # refuses uid 0 so that ansible/tests/k8s/test_root_needs_dac_capability.py can still
          # see this block in raw template text. DAC_READ_SEARCH is the read-only half of root's
          # permission-bit override: it covers the 0600 sources however the image later owns
          # them. Writing needs no DAC_OVERRIDE, since the emptyDir is root-owned and empty
          # until this container runs.
          securityContext:
            allowPrivilegeEscalation: false
            runAsUser: 0
            capabilities:
              add:
                - DAC_READ_SEARCH
              drop:
                - ALL
          volumeMounts:
            - name: crowdsec-data
              mountPath: /var/lib/crowdsec/data
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
{% endif %}
      containers:
        - name: traefik
          image: {{ traefik_k8s_image }}
          args:
            - --configFile=/config/traefik.yml
          ports:
            - name: http
              containerPort: {{ traefik_k8s_http_port }}
            - name: https
              containerPort: {{ traefik_k8s_https_port }}
            - name: ping
              containerPort: {{ traefik_k8s_ping_port }}
{% if traefik_k8s_manage_acme %}
{# The whole env: key is gated, not just its entries — an env: with no list under it parses as
   null, which the API server rejects on a container spec. This comment sits at column 0 on
   purpose: lstrip_blocks is off, so an indented tag leaves its leading spaces in the output. #}
          env:
            # Not sensitive — the token itself is file-mounted below.
            - name: CF_API_EMAIL
              value: "{{ email }}"
            - name: CF_DNS_API_TOKEN_FILE
              value: /secrets/cf_dns_token
{% endif %}
{{ hardened_security_context(read_only=true, non_root=true) }}
          volumeMounts:
            - name: traefik-config
              mountPath: /config
              readOnly: true
{% if traefik_k8s_manage_livesync_gate %}
            - name: traefik-livesync-gate
              mountPath: /etc/traefik-file
              readOnly: true
{% endif %}
            # NOT /run/secrets, which is the Docker convention this was ported from.
            # /var/run/secrets symlinks to /run/secrets, and that is where Kubernetes projects
            # the ServiceAccount token — mounting a read-only Secret over it leaves runc unable
            # to create /run/secrets/kubernetes.io and the container never starts:
            #   mkdirat .../rootfs/run/secrets/kubernetes.io: read-only file system
{% if traefik_k8s_manage_acme %}
            - name: traefik-cloudflare
              mountPath: /secrets
              readOnly: true
{% endif %}
{% if traefik_k8s_manage_crowdsec %}
            # The bouncer plugin reads its LAPI key from here (crowdsecLapiKeyFile in the
            # crowdsec Middleware) — a file, so the key never appears in the CRD.
            - name: crowdsec-key
              mountPath: /secrets/crowdsec
              readOnly: true
{% endif %}
{% if traefik_k8s_manage_acme %}
            - name: traefik-acme
              mountPath: /data
{% endif %}
            # Shared with the crowdsec-agent sidecar, which tails access.log (slice-6 D2).
            - name: traefik-logs
              mountPath: /var/log/traefik
            # Traefik downloads experimental plugins (the crowdsec bouncer) here at start.
            # With the read-only rootfs it cannot mkdir this itself — and when that fails
            # it does not fail the pod: it DISABLES plugins, the crowdsec Middleware never
            # materializes, and every router referencing it 404s. The whole edge went dark
            # this way on the first B1 rollout.
            - name: traefik-plugins-storage
              mountPath: /plugins-storage
            - name: traefik-tmp
              mountPath: /tmp
          readinessProbe:
            httpGet:
              path: /ping
              port: ping
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /ping
              port: ping
            initialDelaySeconds: 15
            periodSeconds: 30
{{ container_resources(cpu_limit=traefik_k8s_cpu_limit, mem_limit=traefik_k8s_mem_limit, cpu_request=traefik_k8s_cpu_request, mem_request=traefik_k8s_mem_request) }}
{% if traefik_k8s_manage_crowdsec %}
        # Slice-6 B1 (D1/D2): log-parsing agent, LAPI-less — it tails this pod's access log
        # and ships signals to the in-cluster engine. Runs as the pod's uid (65532), NOT
        # root: root with ALL caps dropped has no DAC_OVERRIDE, so it cannot write the
        # /etc/crowdsec tree the init container owns and `cscli parsers install` dies on
        # mkdir (measured on the authelia pod, which has the same shape). The agent needs
        # no privilege — it reads a file and posts to the LAPI.
        #
        # Deliberately NO readinessProbe: sidecar readiness gates the whole pod's Service
        # endpoints, and a hub download hiccup must not pull the EDGE out of rotation. The
        # bouncer middleware already fails open per its own config; a dead agent costs
        # detection, not serving. Lenient liveness restarts a truly wedged agent.
        - name: crowdsec-agent
          image: {{ crowdsec_k8s_image }}
          env:
            - name: TZ
              value: "{{ tz }}"
            - name: DISABLE_LOCAL_API
              value: "true"
            - name: LOCAL_API_URL
              value: "http://crowdsec:{{ crowdsec_k8s_lapi_port }}"
            - name: AGENT_USERNAME
              value: "{{ crowdsec_k8s_agent_username }}"
            - name: AGENT_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: traefik-crowdsec
                  key: AGENT_PASSWORD
            - name: COLLECTIONS
              value: "{{ traefik_k8s_agent_collections }}"
{{ hardened_security_context(non_root=true) }}
          volumeMounts:
            - name: crowdsec-etc
              mountPath: /etc/crowdsec
            # The entrypoint refuses to start without a volume here (it holds the hub's
            # downloaded datafiles; the sqlite DB lives only in the LAPI pod). emptyDir is
            # right: everything in it re-downloads from the hub on start.
            - name: crowdsec-data
              mountPath: /var/lib/crowdsec/data
            - name: traefik-logs
              mountPath: /var/log/traefik
              readOnly: true
            - name: crowdsec-agent-tmp
              mountPath: /tmp
          livenessProbe:
            # Round-trips the LAPI with the agent's own credentials — alive means "parsing
            # and able to deliver", the only two things this container is for.
            exec:
              command: ["cscli", "lapi", "status"]
            initialDelaySeconds: 120
            periodSeconds: 60
            timeoutSeconds: 10
{{ container_resources(cpu_limit=traefik_k8s_agent_cpu_limit, mem_limit=traefik_k8s_agent_mem_limit, cpu_request=traefik_k8s_agent_cpu_request, mem_request=traefik_k8s_agent_mem_request) }}
{% endif %}
        # Ships the access log to Loki (tails it to stdout, which promtail's k8s-pods job
        # auto-discovers by container name — no scrape-config change needed) and keeps the
        # traefik-logs emptyDir off the eviction path (copytruncate before traefik_k8s_access_log_size
        # is ever reached).
        #
        # copytruncate, NOT a SIGUSR1 reopen signal: signalling traefik's PID 1 from a sibling
        # container needs shareProcessNamespace: true on the pod (NOT set, deliberately — every
        # sidecar here would then see and be able to signal every other container's process,
        # a real security regression on this security-critical edge pod for a marginal gain).
        # copytruncate needs no cross-container signal at all: it copies the log aside then
        # truncates the SAME inode in place, so traefik's already-open fd keeps writing without
        # being reopened. That works because traefik opens the access log O_APPEND, and an
        # O_APPEND write always targets the current end-of-file rather than a cached offset — so
        # the first write after a truncate lands at the new offset 0. The rotate() function below
        # checks this held rather than trusting it silently (see "did rotation actually take"
        # below). CrowdSec's acquis.yaml (crowdsec-secret.yaml.j2) names the exact file
        # /var/log/traefik/access.log, not a glob, so the rotated .1/.2 generations are never
        # re-ingested and old requests never get re-banned. This isn't a new mechanism for this
        # file: the retired Docker-era edge (ansible/roles/containers/archive/traefik) ran
        # copytruncate against this exact access.log, with crowdsec tailing it the same way, for
        # months with no reported loss (see git history: b93d9a4c added
        # roles/containers/traefik/files/traefik-logrotate with `copytruncate`, `rotate 7`).
        #
        # Deliberately NO readinessProbe — same trap as crowdsec-agent above: a sidecar's
        # readiness gates the whole pod's Service endpoints, so a tail or rotation hiccup here
        # must never pull the EDGE out of rotation. No livenessProbe either: the loop below is
        # its own watchdog for the child `tail` (restarts it, logging when it does), and a
        # container restart here would gain nothing a shell loop can't already do.
        - name: access-log-rotate
          image: {{ traefik_k8s_logrotate_image }}
          command:
            - /bin/sh
            - -c
            - |
              set -eu
              LOG=/var/log/traefik/access.log
              MAX_BYTES=$(( {{ traefik_k8s_access_log_rotate_mb }} * 1024 * 1024 ))
              KEEP={{ traefik_k8s_access_log_keep }}
              ROTATE_DISABLED=0

              log() { echo "access-log-rotate: $*"; }

              # BusyBox's tail is not asserted to reseek to 0 on a detected truncation the way
              # GNU coreutils does — this image was never exec'd against to check. Rather than
              # rely on that, the child is killed and restarted across every rotation, which is
              # correct regardless of which tail implementation the image carries. `-n +1`
              # follows from byte 0: right after a truncate/restart the file is ~empty, so
              # nothing is lost by not seeking to the (now stale) end.
              start_tail() {
                tail -f -n +1 "$LOG" &
                TAIL_PID=$!
              }

              # stat is O(1); wc -c re-reads the whole file, which matters at 100MB+ on a
              # once-a-minute poll. Falls back if this image's stat lacks -c.
              file_size() {
                stat -c%s "$LOG" 2>/dev/null || wc -c < "$LOG"
              }

              rotate() {
                i=$KEEP
                while [ "$i" -gt 1 ]; do
                  prev=$((i - 1))
                  if [ -e "$LOG.$prev" ]; then
                    mv "$LOG.$prev" "$LOG.$i"
                  fi
                  i=$prev
                done
                cp "$LOG" "$LOG.1"
                : > "$LOG"
                kill "$TAIL_PID" 2>/dev/null || true
                wait "$TAIL_PID" 2>/dev/null || true
                start_tail

                # Did the truncate actually take? If traefik does not open the log O_APPEND
                # after all, its cached write offset stays at the pre-rotate size, the file
                # re-grows to it on the very next write, and copying that in full every cycle
                # would spend the disk I/O this sidecar exists to bound. Fail loud and stop
                # trying rather than fail silent and thrash.
                size_after=$(file_size)
                if [ "$size_after" -ge "$MAX_BYTES" ]; then
                  log "truncate did not shrink $LOG (still ${size_after}B) — disabling further rotation"
                  ROTATE_DISABLED=1
                fi
              }

              start_tail

              while true; do
                sleep 60
                if ! kill -0 "$TAIL_PID" 2>/dev/null; then
                  log "tail exited, restarting"
                  start_tail
                fi
                if [ "$ROTATE_DISABLED" -eq 1 ]; then
                  continue
                fi
                if [ -f "$LOG" ]; then
                  size=$(file_size)
                  if [ "$size" -ge "$MAX_BYTES" ]; then
                    rotate
                  fi
                fi
              done
{{ hardened_security_context(non_root=true) }}
          volumeMounts:
            - name: traefik-logs
              mountPath: /var/log/traefik
{{ container_resources(cpu_limit=traefik_k8s_logrotate_cpu_limit, mem_limit=traefik_k8s_logrotate_mem_limit, cpu_request=traefik_k8s_logrotate_cpu_request, mem_request=traefik_k8s_logrotate_mem_request) }}
      volumes:
        - name: traefik-config
          configMap:
            name: traefik-static
{% if traefik_k8s_manage_livesync_gate %}
        # LiveSync token gate — file-provider dynamic config (see livesync-gate-secret.yaml.j2)
        - name: traefik-livesync-gate
          secret:
            secretName: traefik-livesync-gate
{% endif %}
{% if traefik_k8s_manage_acme %}
        - name: traefik-cloudflare
          secret:
            secretName: traefik-cloudflare
            # 0440, not 0400: the kubelet owns secret files as root:fsGroup, so the container
            # user reaches them through the GROUP bit. 0400 grants the group nothing and the
            # token is unreadable to the process that needs it.
            defaultMode: 0440
        - name: traefik-acme
          persistentVolumeClaim:
            claimName: traefik-acme
{% endif %}
        - name: traefik-tmp
          emptyDir: {}
{% if traefik_k8s_manage_crowdsec %}
        - name: crowdsec-secret
          secret:
            secretName: traefik-crowdsec
            # Group-readable for the same kubelet root:fsGroup reason as the cloudflare
            # Secret above — 0400 would leave the traefik user unable to read lapi_key.
            defaultMode: 0440
        # The traefik container gets ONLY the key file; the full Secret (agent password,
        # acquis, whitelists) is projected separately for the sidecar's initContainer.
        - name: crowdsec-key
          secret:
            secretName: traefik-crowdsec
            defaultMode: 0440
            items:
              - key: lapi_key
                path: lapi_key
        - name: crowdsec-etc
          emptyDir: {}
        - name: crowdsec-data
          emptyDir: {}
{% endif %}
        - name: traefik-plugins-storage
          emptyDir: {}
{% if traefik_k8s_manage_crowdsec %}
        - name: crowdsec-agent-tmp
          emptyDir: {}
{% endif %}
        # sizeLimit is a BACKSTOP against pod eviction, not the rotation mechanism — the
        # access-log-rotate sidecar copytruncates the log well before this is reached (see
        # traefik_k8s_access_log_rotate_mb / _keep in defaults/main.yml). Hitting this cap would
        # mean rotation itself has stopped working, not that rotation was never implemented.
        - name: traefik-logs
          emptyDir:
            sizeLimit: {{ traefik_k8s_access_log_size }}
