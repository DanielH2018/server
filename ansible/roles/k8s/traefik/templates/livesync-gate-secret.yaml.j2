---
# The k8s edge's token gates — LiveSync's X-Sync-Token (rehomed 2026-08-12) and
# homelab-mcp's bearer (rehomed 2026-08-13). One Secret, one file: the static config's
# file provider takes a single `filename:` (directory-watch double-parses Secret ..data
# symlinks), so every token-gated router lives here. A Secret-mounted file-provider
# config, NOT an IngressRoute: the
# readonly kubeconfig can read CRDs but is RBAC-denied Secrets (verified 2026-08-12 —
# `kubectl get secret` → Forbidden), so this is the cluster-safe home the token waited
# for. Same trust model as the Docker edge's mode-0600 file.
#
# Router semantics carried over verbatim from the hand-written routers in
# roles/containers/traefik/templates/config.yml.j2:
#   - a request without the matching token matches NO router for the host and 404s
#     before CouchDB; CouchDB's require_valid_user is the second layer
#   - /_utils carve-out at priority 200 behind Authelia (k8s portal — same cookie domain)
#   - the probe router is LAN-only by construction (.local host, no public sibling) and
#     exists so ONE monitor exercises edge → CouchDB end-to-end (Kuma expects its 401)
#
# Middleware/TLS-option refs are provider-qualified (@kubernetescrd) — a file-provider
# router referencing CRD objects needs the namespace-prefixed form, same as the
# entrypoint middlewares in static-config.yaml.j2.
apiVersion: v1
kind: Secret
metadata:
  name: traefik-livesync-gate
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  livesync-gate.yml: |
    http:
      routers:
{#
  `suffix` picks the limiter's keying per host: the public name is Cloudflare-proxied, so its
  connections come from a Cloudflare edge and the limiter keys on the forwarded client; the
  `.local.` name is reached direct, where the remote address is the client. Until 2026-09-18
  both hosts used the remote-address limiter under a comment claiming "real client addresses
  arrive at this edge" — true of the connection, which ETP=Local preserves, but for the public
  name that connection is Cloudflare's, so every phone syncing through the same edge shared
  one 6000/min bucket. The rationale is with the middlewares in dynamic.yaml.j2 (#1955).
  `tls_option` follows the same line: the public name requires Cloudflare's origin-pull client
  certificate (`cloudflare-origin-pull`, ansible/templates/origin-pull.yml.j2, #1990) and the
  `.local.` name stays on `modern`. The probe and mcp routers below are `.local.`-only and
  stay on `modern` too.
#}
{% for key, host, suffix, tls_option in [('public', 'livesync.' ~ domain, '-proxied', 'cloudflare-origin-pull'), ('local', 'livesync.local.' ~ domain, '', 'modern')] %}
        livesync-sync-{{ key }}:
          entryPoints:
            - https
          rule: "Host(`{{ host }}`) && Header(`X-Sync-Token`, `{{ livesync_sync_token }}`)"
          service: livesync-couchdb
          middlewares:
            # The high ceiling is livesync's replication exemption (a phone 429'd mid-sync
            # on the default limiter, measured 2026-08-06).
            - {{ k8s_namespace }}-rate-limit-public-livesync{{ suffix }}@kubernetescrd
          tls:
{% if k8s_tls_cert_resolver %}
            certResolver: {{ k8s_tls_cert_resolver }}
{% endif %}
            options: {{ k8s_namespace }}-{{ tls_option }}@kubernetescrd
{% if k8s_tls_cert_resolver %}
            domains:
              - main: "{{ domain }}"
                sans:
                  - "*.{{ domain }}"
                  - "*.local.{{ domain }}"
{% endif %}
        livesync-utils-{{ key }}:
          entryPoints:
            - https
          rule: "Host(`{{ host }}`) && (PathPrefix(`/_utils/`) || Path(`/_utils`))"
          service: livesync-couchdb
          priority: 200
          middlewares:
            - {{ k8s_namespace }}-rate-limit{{ suffix }}@kubernetescrd
            - {{ k8s_namespace }}-authelia@kubernetescrd
          tls:
{% if k8s_tls_cert_resolver %}
            certResolver: {{ k8s_tls_cert_resolver }}
{% endif %}
            options: {{ k8s_namespace }}-{{ tls_option }}@kubernetescrd
{% if k8s_tls_cert_resolver %}
            domains:
              - main: "{{ domain }}"
                sans:
                  - "*.{{ domain }}"
                  - "*.local.{{ domain }}"
{% endif %}
{% endfor %}
        livesync-probe:
          entryPoints:
            - https
          # Path, not PathPrefix, and no public sibling — the same LAN-only shape the
          # Docker probe router had. CouchDB answers 401 (Kuma's accepted status).
          rule: "Host(`livesync.local.{{ domain }}`) && Path(`/`)"
          service: livesync-couchdb
          priority: 200
          middlewares:
            - {{ k8s_namespace }}-rate-limit@kubernetescrd
          tls:
{% if k8s_tls_cert_resolver %}
            certResolver: {{ k8s_tls_cert_resolver }}
{% endif %}
            options: {{ k8s_namespace }}-modern@kubernetescrd
{% if k8s_tls_cert_resolver %}
            domains:
              - main: "{{ domain }}"
                sans:
                  - "*.{{ domain }}"
                  - "*.local.{{ domain }}"
{% endif %}
        homelab-mcp-local:
          entryPoints:
            - https
          # Carried over verbatim from the Docker edge's file provider: LAN-ONLY (only
          # the .local host, no public sibling — and the entry's public_route: false
          # keeps the reverse bridge from ever having grown one) AND the exact bearer
          # token, or the request matches NO router for the host and 404s before the
          # app. The app re-checks the token (defence in depth).
          rule: "Host(`mcp.local.{{ domain }}`) && Header(`Authorization`, `Bearer {{ homelab_mcp_token }}`)"
          service: homelab-mcp
          middlewares:
            - {{ k8s_namespace }}-rate-limit@kubernetescrd
          tls:
{% if k8s_tls_cert_resolver %}
            certResolver: {{ k8s_tls_cert_resolver }}
{% endif %}
            options: {{ k8s_namespace }}-modern@kubernetescrd
{% if k8s_tls_cert_resolver %}
            domains:
              - main: "{{ domain }}"
                sans:
                  - "*.{{ domain }}"
                  - "*.local.{{ domain }}"
{% endif %}
        homelab-mcp-probe:
          entryPoints:
            - https
          # Same shape and same purpose as livesync-probe above: LAN-only, one exact Path, no
          # public sibling, so ONE monitor exercises edge -> app end-to-end. Added 2026-09-06
          # for #1341. The mcp tile used to probe /mcp with no bearer and accept the 404 that
          # matches no router — but that 404 is Traefik's own, byte-identical to the one a
          # router-less edge returns for everything, so the tile named "edge gate" read green
          # through the 3.5-hour total-404 outage of #1322. A 200 from the app's own /health
          # cannot be forged by the edge failing.
          #
          # No token on this router, and none needed: app.py's _BearerAuth exempts /health,
          # which returns the bare string "ok" and reads nothing. Every other path still
          # requires the exact bearer, on this edge and again in the app.
          rule: "Host(`mcp.local.{{ domain }}`) && Path(`/health`)"
          service: homelab-mcp
          priority: 200
          middlewares:
            - {{ k8s_namespace }}-rate-limit@kubernetescrd
          tls:
{% if k8s_tls_cert_resolver %}
            certResolver: {{ k8s_tls_cert_resolver }}
{% endif %}
            options: {{ k8s_namespace }}-modern@kubernetescrd
{% if k8s_tls_cert_resolver %}
            domains:
              - main: "{{ domain }}"
                sans:
                  - "*.{{ domain }}"
                  - "*.local.{{ domain }}"
{% endif %}
      services:
        livesync-couchdb:
          loadBalancer:
            servers:
              - url: "http://livesync.{{ k8s_namespace }}.svc.cluster.local:5984"
        homelab-mcp:
          loadBalancer:
            servers:
              - url: "http://homelab-mcp.{{ k8s_namespace }}.svc.cluster.local:8000"
