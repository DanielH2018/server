---
# The k8s edge's token gates — LiveSync's X-Sync-Token (rehomed 2026-08-12) and
# homelab-mcp's bearer (rehomed 2026-08-13). One Secret, one file: the static config's
# file provider takes a single `filename:` (directory-watch double-parses Secret ..data
# symlinks), so every token-gated router lives here. A Secret-mounted file-provider
# config, NOT an IngressRoute: the
# readonly kubeconfig can read CRDs but is RBAC-denied Secrets (verified 2026-08-12 —
# `kubectl get secret` → Forbidden), so this is the cluster-safe home the token waited
# for. Same trust model as the Docker edge's mode-0600 file.
#
# Router semantics carried over verbatim from the hand-written routers in
# roles/containers/traefik/templates/config.yml.j2:
#   - a request without the matching token matches NO router for the host and 404s
#     before CouchDB; CouchDB's require_valid_user is the second layer
#   - /_utils carve-out at priority 200 behind Authelia (k8s portal — same cookie domain)
#   - the probe router is LAN-only by construction (.local host, no public sibling) and
#     exists so ONE monitor exercises edge → CouchDB end-to-end (Kuma expects its 401)
#
# Middleware/TLS-option refs are provider-qualified (@kubernetescrd) — a file-provider
# router referencing CRD objects needs the namespace-prefixed form, same as the
# entrypoint middlewares in static-config.yaml.j2.
apiVersion: v1
kind: Secret
metadata:
  name: traefik-livesync-gate
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  livesync-gate.yml: |
    http:
      routers:
{% for key, host in [('public', 'livesync.' ~ domain), ('local', 'livesync.local.' ~ domain)] %}
        livesync-sync-{{ key }}:
          entryPoints:
            - https
          rule: "Host(`{{ host }}`) && Header(`X-Sync-Token`, `{{ livesync_sync_token }}`)"
          service: livesync-couchdb
          middlewares:
            # Per-IP keying is correct here (real client addresses arrive at this edge);
            # the high ceiling is livesync's replication exemption (a phone 429'd mid-sync
            # on the default limiter, measured 2026-08-06).
            - {{ k8s_namespace }}-rate-limit-public-livesync@kubernetescrd
          tls:
{% if k8s_tls_cert_resolver %}
            certResolver: {{ k8s_tls_cert_resolver }}
{% endif %}
            options: {{ k8s_namespace }}-modern@kubernetescrd
{% if k8s_tls_cert_resolver %}
            domains:
              - main: "{{ domain }}"
                sans:
                  - "*.{{ domain }}"
                  - "*.local.{{ domain }}"
{% endif %}
        livesync-utils-{{ key }}:
          entryPoints:
            - https
          rule: "Host(`{{ host }}`) && (PathPrefix(`/_utils/`) || Path(`/_utils`))"
          service: livesync-couchdb
          priority: 200
          middlewares:
            - {{ k8s_namespace }}-rate-limit@kubernetescrd
            - {{ k8s_namespace }}-authelia@kubernetescrd
          tls:
{% if k8s_tls_cert_resolver %}
            certResolver: {{ k8s_tls_cert_resolver }}
{% endif %}
            options: {{ k8s_namespace }}-modern@kubernetescrd
{% if k8s_tls_cert_resolver %}
            domains:
              - main: "{{ domain }}"
                sans:
                  - "*.{{ domain }}"
                  - "*.local.{{ domain }}"
{% endif %}
{% endfor %}
        livesync-probe:
          entryPoints:
            - https
          # Path, not PathPrefix, and no public sibling — the same LAN-only shape the
          # Docker probe router had. CouchDB answers 401 (Kuma's accepted status).
          rule: "Host(`livesync.local.{{ domain }}`) && Path(`/`)"
          service: livesync-couchdb
          priority: 200
          middlewares:
            - {{ k8s_namespace }}-rate-limit@kubernetescrd
          tls:
{% if k8s_tls_cert_resolver %}
            certResolver: {{ k8s_tls_cert_resolver }}
{% endif %}
            options: {{ k8s_namespace }}-modern@kubernetescrd
{% if k8s_tls_cert_resolver %}
            domains:
              - main: "{{ domain }}"
                sans:
                  - "*.{{ domain }}"
                  - "*.local.{{ domain }}"
{% endif %}
        homelab-mcp-local:
          entryPoints:
            - https
          # Carried over verbatim from the Docker edge's file provider: LAN-ONLY (only
          # the .local host, no public sibling — and the entry's public_route: false
          # keeps the reverse bridge from ever having grown one) AND the exact bearer
          # token, or the request matches NO router for the host and 404s before the
          # app. The app re-checks the token (defence in depth).
          rule: "Host(`mcp.local.{{ domain }}`) && Header(`Authorization`, `Bearer {{ homelab_mcp_token }}`)"
          service: homelab-mcp
          middlewares:
            - {{ k8s_namespace }}-rate-limit@kubernetescrd
          tls:
{% if k8s_tls_cert_resolver %}
            certResolver: {{ k8s_tls_cert_resolver }}
{% endif %}
            options: {{ k8s_namespace }}-modern@kubernetescrd
{% if k8s_tls_cert_resolver %}
            domains:
              - main: "{{ domain }}"
                sans:
                  - "*.{{ domain }}"
                  - "*.local.{{ domain }}"
{% endif %}
      services:
        livesync-couchdb:
          loadBalancer:
            servers:
              - url: "http://livesync.{{ k8s_namespace }}.svc.cluster.local:5984"
        homelab-mcp:
          loadBalancer:
            servers:
              - url: "http://homelab-mcp.{{ k8s_namespace }}.svc.cluster.local:8000"
