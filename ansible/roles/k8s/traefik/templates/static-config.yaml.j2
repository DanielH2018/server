---
apiVersion: v1
kind: ConfigMap
metadata:
  name: traefik-static
  namespace: {{ k8s_namespace }}
data:
  traefik.yml: |
    api:
      dashboard: true
      insecure: false
      debug: false
    # entryPoint is explicit, not inherited. It defaults to `traefik` — the internal
    # entrypoint — so merely declaring an entrypoint NAMED ping does not bind the handler to
    # it, and both probes below would poll a port serving nothing. The Docker instance sidesteps
    # this by shelling `traefik healthcheck`, which reads the config itself; a k8s httpGet
    # probe names the port, so the binding has to be real.
    ping:
      entryPoint: ping

    entryPoints:
      http:
        address: ":{{ traefik_k8s_http_port }}"
        forwardedHeaders:
          trustedIPs:
{% for ip in cloudflare_ips %}
            - "{{ ip }}"
{% endfor %}
            # Carried over verbatim from the Docker traefik.yml.j2, and the reasoning is
            # unchanged by the platform: this governs X-Forwarded-For TRUST, not admission.
            # Deliberately NOT 10.0.0.0/8 (that would trust wg-easy's 10.8.0.0/24 clients as
            # upstream proxies, letting a WG client spoof XFF) and deliberately not the pod
            # CIDR — the Service runs externalTrafficPolicy: Local specifically so requests
            # arrive with the real client address rather than cni0's, and trusting the pod
            # network would let any pod forge XFF.
            - "{{ lan_subnet }}"
            - "127.0.0.1/32"
        http:
          redirections:
            entryPoint:
              to: https
              scheme: https
          # No crowdsec middleware here. The bouncer plugin and the LAPI rebuild are slice 6
          # — safe only while k8s_public_route is false and this VIP is LAN-reachable only.
      https:
        address: ":{{ traefik_k8s_https_port }}"
        forwardedHeaders:
          trustedIPs:
{% for ip in cloudflare_ips %}
            - "{{ ip }}"
{% endfor %}
            - "{{ lan_subnet }}"
            - "127.0.0.1/32"
        http:
          middlewares:
            # Entrypoint-wide, matching the Docker side. rate-limit stays per-router (the
            # ingressroute() macro attaches it) so a future chatty service can opt into a
            # higher ceiling, which an entrypoint-level limiter cannot express.
            - {{ k8s_namespace }}-default-headers@kubernetescrd
      ping:
        address: ":{{ traefik_k8s_ping_port }}"

    metrics:
      prometheus:
        addEntryPointsLabels: true
        addRoutersLabels: true
        addServicesLabels: true

    serversTransport:
      insecureSkipVerify: false

    providers:
      kubernetesCRD:
        # Scoped to the workload namespace: Traefik should not pick up an IngressRoute
        # someone drops in kube-system or longhorn-system.
        namespaces:
          - {{ k8s_namespace }}
          # Telemetry stack (claude-otel). A namespace absent from this list is not merely
          # unrouted — Traefik never sees its IngressRoutes at all, so the route applies
          # cleanly, reports nothing wrong, and the host simply 404s. Adding it is additive:
          # existing routes are unaffected.
          #
          # `allowCrossNamespace` stays OFF. That namespace carries its own copies of the
          # rate-limit and authelia Middlewares rather than reaching into this one, which
          # keeps a route in any watched namespace from referencing another's middlewares.
          - {{ k8s_observability_namespace }}

    certificatesResolvers:
      cloudflare:
        acme:
          email: "{{ email }}"
          storage: /data/acme.json
{% if traefik_k8s_acme_ca_server %}
          caServer: "{{ traefik_k8s_acme_ca_server }}"
{% endif %}
          dnsChallenge:
            provider: cloudflare
            resolvers:
              - "9.9.9.9:53"
              - "149.112.112.112:53"

    # stdout, not a file. The Docker instance writes to /var/log/traefik with logrotate; in
    # k8s the kubelet owns log files under /var/log/pods, which is also where slice 6's
    # CrowdSec acquisition will read from once it stops using the Docker socket.
    log:
      format: json
      level: INFO
    accessLog:
      format: json
      fields:
        defaultMode: keep
        names:
          StartUTC: drop
