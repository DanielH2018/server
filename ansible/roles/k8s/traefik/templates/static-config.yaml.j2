---
apiVersion: v1
kind: ConfigMap
metadata:
  name: traefik-static
  namespace: {{ k8s_namespace }}
data:
  traefik.yml: |
    api:
      dashboard: true
      insecure: false
      debug: false
    # entryPoint is explicit, not inherited. It defaults to `traefik` — the internal
    # entrypoint — so merely declaring an entrypoint NAMED ping does not bind the handler to
    # it, and both probes below would poll a port serving nothing. The Docker instance sidesteps
    # this by shelling `traefik healthcheck`, which reads the config itself; a k8s httpGet
    # probe names the port, so the binding has to be real.
    ping:
      entryPoint: ping

    entryPoints:
      http:
        address: ":{{ traefik_k8s_http_port }}"
        forwardedHeaders:
          trustedIPs:
{% for ip in cloudflare_ips %}
            - "{{ ip }}"
{% endfor %}
            # This list governs X-Forwarded-For TRUST, not admission: from a source listed
            # here Traefik keeps the client-sent XFF, and from any other source it discards it
            # and uses the connection address. Only a proxy in front of Traefik belongs here.
            #
            # DECIDED: Cloudflare only, and not `lan_subnet` ({{ lan_subnet }}). The LAN /24
            # was trusted for the Docker-era edge (33bdbdb32, narrowed from 10.0.0.0/8 by
            # f0429fb4b), where the Docker bridges and co-hosted proxies sat on it. On k3s
            # nothing on the LAN proxies to Traefik: neither node runs Docker, and the Pi runs
            # only docker-proxy, wg-easy, alloy and autoheal. Trusting the /24 let any LAN
            # device forge XFF, and that included every WireGuard peer. wg-easy masquerades
            # its `wg_client_subnet` ({{ wg_client_subnet }}) peers to the Pi's LAN address,
            # which is inside the /24. With the /24 untrusted, Traefik strips a LAN client's
            # XFF and forwards the connection address, so Authelia `networks:` rules and
            # ClientIP() matchers still see the LAN address. Not the pod CIDR either: the
            # Service runs externalTrafficPolicy: Local so requests arrive with the real client
            # address rather than cni0's, and trusting the pod network would let any pod forge
            # XFF. If a LAN reverse proxy is ever added in front of Traefik, list its single
            # address here rather than the /24.
            - "127.0.0.1/32"
        http:
          redirections:
            entryPoint:
              # NOT `to: https` (the entrypoint name): that emits the entrypoint's LISTEN
              # port — the container-side 8443 — into the Location header, which the
              # Service never exposes, so every http→https redirect died on arrival.
              # ":443" pins the redirect to the port clients actually reach.
              to: ":443"
              scheme: https
{% if traefik_k8s_manage_crowdsec %}
          middlewares:
            # Entrypoint-wide, matching the Docker edge (slice-6 B1). Once Traefik has a
            # settled configuration, everything entering this entrypoint passes the CrowdSec
            # ban-list + AppSec check before it is redirected. The only router here is
            # `http-to-443@internal`, the redirection above, so what the chain buys is
            # rejecting a banned IP on its FIRST request rather than on the https one it is
            # redirected to.
            #
            # DECIDED: keep it, and expect one or two error lines per container start. Traefik
            # logs
            #
            #   {"level":"error","entryPointName":"http","routerName":"http-to-443@internal",
            #    "error":"middleware \"<ns>-crowdsec@kubernetescrd\" does not exist"}
            #
            # once or twice, within a second of startup, because the internal and file
            # providers publish their configuration before the kubernetesCRD watch delivers its
            # first one. The count is however many generations those two providers publish in
            # that window, so both shapes are normal — #1356 measured a start that logged the
            # line once and starts that logged it twice. It is the same window in which the
            # livesync `@file` routers log "unknown TLS
            # options: <ns>-modern@kubernetescrd" and then resolve fine. Traefik skips the
            # offending router and rebuilds the whole entrypoint on the next configuration
            # event, so http 404s instead of 301ing for that second and is correct
            # afterwards. #1343 read those lines as proof that an internal router cannot
            # resolve a `@kubernetescrd` middleware at all, and proposed dropping crowdsec
            # from this chain. The log says otherwise: over the 7 days to 2026-09-06 every
            # occurrence outside the #1322 outage landed 0-1s after a "Traefik version"
            # startup line, and during #1322 — when the middleware really was unresolvable —
            # the same line repeated on every configuration event for 11 minutes. A line that
            # recurs while the reference is broken and stops once it resolves is evidence the
            # reference resolves. The line is also proof Traefik attaches this chain to the
            # internal router: `applyModel` prepends an entrypoint's middlewares to every root
            # router and only then does the lookup fail, so an excluded router would log
            # nothing at all. Dropping crowdsec here would remove real enforcement to silence
            # a startup line or two. ENFORCED by
            # ansible/tests/services/test_traefik_http_entrypoint_crowdsec.py.
            - {{ k8s_namespace }}-crowdsec@kubernetescrd
{% endif %}
      https:
        address: ":{{ traefik_k8s_https_port }}"
        forwardedHeaders:
          trustedIPs:
{% for ip in cloudflare_ips %}
            - "{{ ip }}"
{% endfor %}
            # Same list as the http entrypoint above; its DECIDED comment covers why
            # `lan_subnet` is absent.
            - "127.0.0.1/32"
        http:
          middlewares:
            # Entrypoint-wide, matching the Docker side. rate-limit stays per-router (the
            # ingressroute() macro attaches it) so a future chatty service can opt into a
            # higher ceiling, which an entrypoint-level limiter cannot express.
{% if traefik_k8s_manage_crowdsec %}
            # cloudflare-realip FIRST, ahead of crowdsec and of every router's forwardAuth.
            # Cloudflare appends the client address to any XFF the client sent, so the
            # trustedIPs above keep a client-chosen LEFTMOST entry, and Authelia logs the
            # leftmost entry as remote_ip. This middleware replaces XFF with CF-Connecting-IP
            # for a Cloudflare source, so everything after it sees `client` and every backend
            # sees `client, edge`. It is the in-repo plugin under files/cloudflare-realip/,
            # loaded from a ConfigMap (experimental.localPlugins below), and gated with the
            # bouncer because the startupProbe that catches a failed plugin load is too.
            # ENFORCED by ansible/tests/k8s/test_traefik_cloudflare_realip.py.
            - {{ k8s_namespace }}-cloudflare-realip@kubernetescrd
            # crowdsec next: a banned IP is rejected before any headers work is done.
            - {{ k8s_namespace }}-crowdsec@kubernetescrd
{% endif %}
            - {{ k8s_namespace }}-default-headers@kubernetescrd
            # compress LAST, and the order is load-bearing. An entrypoint chain wraps in
            # list order on the way in, so the last entry is the INNERMOST — it sees the
            # backend's response first and compresses it, and the two above then add their
            # headers on top of an already-encoded body. Listed first it would instead try
            # to compress after default-headers had run, which is harmless but pointless,
            # and it would sit outside crowdsec — doing compression work for requests that
            # are about to be rejected with a 403.
            - {{ k8s_namespace }}-compress@kubernetescrd
      ping:
        address: ":{{ traefik_k8s_ping_port }}"

    metrics:
      prometheus:
        addEntryPointsLabels: true
        addRoutersLabels: true
        addServicesLabels: true

    # Slice-6 B1 (D2): a real file, not stdout — the crowdsec agent sidecar tails it from
    # the shared emptyDir. Same json format + dropped StartUTC as the Docker edge, so the
    # crowdsecurity/traefik parser behaves identically across the cutover. A second sidecar
    # (access-log-rotate, deployment.yaml.j2) tails the same file to stdout for Loki and
    # copytruncates it to keep the shared emptyDir bounded — see that sidecar's comment for why
    # copytruncate is safe for both readers.
    accessLog:
      filePath: /var/log/traefik/access.log
      format: json
      fields:
        defaultMode: keep
        names:
          StartUTC: drop

{% if traefik_k8s_manage_crowdsec %}
    experimental:
      plugins:
        bouncer:
          moduleName: github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin
          version: {{ traefik_k8s_bouncer_plugin_version }}
      # A LOCAL plugin: Traefik reads the source from ./plugins-local/src/<moduleName>/ (the
      # working directory is /) and downloads nothing, so it adds no startup network
      # dependency beside the bouncer's. The Deployment projects it there from the
      # traefik-cloudflare-realip ConfigMap. The key must match the one under `plugin:` in
      # the Middleware, and moduleName must match the manifest's `import` prefix; a mismatch
      # disables every plugin, the bouncer included.
      localPlugins:
        {{ traefik_k8s_realip_plugin_name }}:
          moduleName: {{ traefik_k8s_realip_plugin_module }}
{% endif %}

    serversTransport:
      insecureSkipVerify: false

    providers:
{% if traefik_k8s_manage_livesync_gate %}
      # LiveSync's token gate (livesync-gate-secret.yaml.j2) — a Secret-mounted dynamic
      # config, because the token must stay out of CRDs the readonly kubeconfig can read.
      # watch:true makes token rotation a Secret update + kubelet propagation, no restart.
      file:
        # filename, NOT directory: a Secret volume projects through `..data` symlink dirs
        # and a directory watch parses the same file twice ("HTTP router already
        # configured, skipping" — seen live at first deploy, 2026-08-12).
        filename: /etc/traefik-file/livesync-gate.yml
        watch: true
{% endif %}
      kubernetesCRD:
        # One list, `traefik_k8s_watched_namespaces` (role defaults), shared with the Roles
        # rbac.yaml.j2 renders. A namespace absent here is not merely unrouted — Traefik
        # never sees its IngressRoutes at all, so a route applies cleanly, reports nothing
        # wrong, and the host simply 404s. Adding one is additive: existing routes are
        # unaffected. `allowCrossNamespace` stays OFF; see the variable's comment.
        namespaces:
{% for ns in traefik_k8s_watched_namespaces %}
          - {{ ns }}
{% endfor %}

{% if traefik_k8s_manage_acme %}
    certificatesResolvers:
      cloudflare:
        acme:
          email: "{{ email }}"
          storage: /data/acme.json
{% if traefik_k8s_acme_ca_server %}
          caServer: "{{ traefik_k8s_acme_ca_server }}"
{% endif %}
          dnsChallenge:
            provider: cloudflare
            resolvers:
              - "9.9.9.9:53"
              - "149.112.112.112:53"
{% endif %}

    # Process log stays on stdout for kubectl logs. The ACCESS log moved to a file at
    # slice-6 B1 (see the accessLog block above) — the sidecar agent tails it from the
    # shared emptyDir, which superseded this comment's /var/log/pods idea (D2).
    log:
      format: json
      level: INFO
