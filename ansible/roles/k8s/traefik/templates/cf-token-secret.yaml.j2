---
apiVersion: v1
kind: Secret
metadata:
  name: traefik-cloudflare
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  # Consumed as CF_DNS_API_TOKEN_FILE, not CF_DNS_API_TOKEN. lego reads the *_FILE form and
  # strips a trailing newline, and mounting it as a file keeps the token out of the pod spec
  # environment — so `kubectl describe pod` and anything reading the PodSpec never see it.
  # Same reasoning as the Docker role's file-mounted cf_dns_token.
  cf_dns_token: "{{ cloudflare_dns_token }}"
