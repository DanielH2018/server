---
# Everything the traefik pod's CrowdSec pieces need (slice-6 B1). One Secret, two consumers:
# the traefik container mounts lapi_key for the bouncer plugin (crowdsecLapiKeyFile — the key
# must NOT sit inline in the Middleware CRD, which the read-only kubeconfig can read), and the
# agent sidecar reads its acquis + whitelist parsers from the same volume via an initContainer
# copy. AGENT_PASSWORD is injected as env into the sidecar only. The whitelists are the
# k8s/crowdsec role's files — moved there at E7 (2026-08-13) when the Docker traefik role that
# used to own them retired.
apiVersion: v1
kind: Secret
metadata:
  name: traefik-crowdsec
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  lapi_key: "{{ crowdsec_k8s_bouncer_api_key }}"
  AGENT_PASSWORD: "{{ crowdsec_k8s_agent_password }}"
  acquis.yaml: |
    filenames:
      - /var/log/traefik/access.log
    labels:
      type: traefik
  whitelist.yaml: |
    {{ lookup('file', playbook_dir + '/roles/k8s/crowdsec/files/crowdsec-whitelist.yaml') | indent(4) }}
  trusted-remote-whitelist.yaml: |
    {{ lookup('file', playbook_dir + '/roles/k8s/crowdsec/files/crowdsec-trusted-remote-whitelist.yaml') | indent(4) }}
