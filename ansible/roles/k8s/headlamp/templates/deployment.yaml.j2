{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: headlamp
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  selector:
    matchLabels:
      app: headlamp
  template:
    metadata:
      labels:
        app: headlamp
        # Opted OUT of the namespace baseline (slice 5). `networkpolicy.yaml.j2` is tighter than
        # the baseline, and the baseline is additive — selecting this pod would widen it.
        netpol-baseline-exempt: "true"
    spec:
      enableServiceLinks: false
      serviceAccountName: headlamp
      # The credential the -unsafe-use-service-account-token flag below reads. Nothing may
      # mount under /run/secrets or /var/run/secrets here — that shadows the projected token
      # and the container never starts (test_nothing_mounts_over_the_serviceaccount_token_path).
      #
      # STAYS TRUE under OIDC, where the token no longer authenticates anyone. `-in-cluster`
      # calls rest.InClusterConfig(), which reads the API server address and the cluster CA
      # from this same projected mount and ERRORS without it — the pod would not start at all.
      automountServiceAccountToken: true
      securityContext:
        runAsUser: {{ headlamp_k8s_uid }}
        runAsGroup: {{ headlamp_k8s_gid }}
        runAsNonRoot: true
      priorityClassName: homelab-best-effort
      # Preference, never a pin: daniel-box carries the storage- and VIP-pinned workloads and runs the hotter of the two nodes, so latency-insensitive services default here.
      # Weighted so the pod still schedules if daniel-server is cordoned or full.
{{ node_affinity_preference('daniel-server') }}
{% if headlamp_k8s_plugins %}
      initContainers:
        # Installs every entry of headlamp_k8s_plugins (defaults/main.yml) into the plugins
        # emptyDir the main container reads; rendered only when the list is non-empty. The
        # image's own bundled plugins live in /headlamp/static-plugins, untouched by this. `set -eu` plus `sha256sum -c` make a bad download
        # a failed pod start, never a silently plugin-less dashboard. Busybox wget speaks TLS
        # on this image (alpine ships ssl_client), and the probe job already pins it.
        - name: fetch-plugins
          image: {{ headlamp_k8s_netpol_probe_image }}
          command:
            - sh
            - -c
            - |
              set -eu
              cd /tmp
{% for plugin in headlamp_k8s_plugins %}
              wget -q -O {{ plugin.name }}.tgz "https://github.com/headlamp-k8s/plugins/releases/download/{{ plugin.name }}-{{ plugin.version }}/{{ plugin.name }}-{{ plugin.version }}.tar.gz"
              echo "{{ plugin.sha256 }}  {{ plugin.name }}.tgz" | sha256sum -c -
              tar xzf {{ plugin.name }}.tgz -C /headlamp/plugins
              echo "installed plugin {{ plugin.name }} {{ plugin.version }}"
{% endfor %}
{{ hardened_security_context(read_only=true) }}
          volumeMounts:
            - name: headlamp-plugins
              mountPath: /headlamp/plugins
            - name: headlamp-tmp
              mountPath: /tmp
{{ container_resources(cpu_limit='250m', mem_limit='64Mi', cpu_request='10m', mem_request='16Mi') }}
{% endif %}
      containers:
        - name: headlamp
          image: {{ headlamp_k8s_image }}
          args:
            - "-in-cluster"
            - "-in-cluster-context-name=main"
            - "-plugins-dir=/headlamp/plugins"
            - "-session-ttl={{ headlamp_k8s_session_ttl }}"
{% if headlamp_k8s_oidc_enabled %}
            # OIDC login: Headlamp sends the browser to Authelia and forwards the resulting
            # `id_token` to the API server on every request. The SA-token flag is GONE in this
            # branch, on purpose — the two are alternatives, not layers, and leaving both set
            # would keep the SA's identity in force for API calls while showing a sign-in
            # button, which is a worse state than either.
            #
            # Every value here is a default in this role, and every one of them has to agree
            # with something outside it: the client id with Authelia's client and the
            # `audiences` of each issuer in the API server's authentication config, and the
            # issuer with one of that config's `jwt` issuers. The callback is the exception —
            # it is derived per request rather than configured, and the Authelia client
            # registers both hostnames it can produce.
            - "-oidc-client-id={{ headlamp_k8s_oidc_client_id }}"
            - "-oidc-idp-issuer-url={{ headlamp_k8s_oidc_issuer_url }}"
            - "-oidc-scopes={{ headlamp_k8s_oidc_scopes }}"
{% if headlamp_k8s_oidc_callback_url %}
            # Rendered only when pinned. Omitting the flag is NOT the same as passing it
            # empty: Headlamp builds the callback from each incoming request when the config
            # value is blank (`getOidcCallbackURL`), and that per-request behaviour is what
            # lets one instance serve both hostnames. An empty `-oidc-callback-url=` would
            # set the value to the empty string, which is a different thing than unset.
            - "-oidc-callback-url={{ headlamp_k8s_oidc_callback_url }}"
{% endif %}
            - "-oidc-use-pkce"
{% else %}
            # Headlamp's default in-cluster flow makes the operator paste a ServiceAccount
            # token into the browser on every session. This flag makes it use its own mounted
            # token instead. Upstream names it "unsafe" because it removes Headlamp's only
            # authentication — which is correct here and only here: the Authelia forward-auth
            # Middleware on the IngressRoute is the perimeter, and the SA it falls back to is
            # read-only with no secrets and no exec (rbac.yaml.j2). Dropping the flag without
            # also narrowing that SA is what "unsafe" is warning about.
            - "-unsafe-use-service-account-token"
{% endif %}
{% if headlamp_k8s_oidc_enabled %}
          # The client secret is an ENV var rather than a seventh `-oidc-*` arg, because args
          # are part of the pod spec: the cluster's read-only ServiceAccount can read
          # Deployments, so a secret passed as an argument is readable by anything that can
          # `kubectl get deploy`. `HEADLAMP_CONFIG_` + the flag name upper-cased is Headlamp's
          # own env convention (`loadConfigFromEnv`, backend/pkg/config/config.go).
          env:
            - name: HEADLAMP_CONFIG_OIDC_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: headlamp-oidc
                  key: client_secret
{% endif %}
          ports:
            - containerPort: {{ container_item.port }}
{{ hardened_security_context(read_only=true) }}
          volumeMounts:
            # Headlamp writes the kubeconfig it generates from the SA token ("main") under
            # its XDG config dir, which readOnlyRootFilesystem otherwise makes EROFS.
            - name: headlamp-config
              mountPath: /home/headlamp/.config
            - name: headlamp-tmp
              mountPath: /tmp
            # Filled by the fetch-plugins init container when headlamp_k8s_plugins is non-empty;
            # -plugins-dir above names this path. Empty otherwise, which Headlamp accepts.
            - name: headlamp-plugins
              mountPath: /headlamp/plugins
              readOnly: true
          readinessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
            initialDelaySeconds: 15
            periodSeconds: 30
{{ container_resources(cpu_limit=headlamp_k8s_cpu_limit, mem_limit=headlamp_k8s_mem_limit, cpu_request=headlamp_k8s_cpu_request, mem_request=headlamp_k8s_mem_request) }}
      volumes:
        - name: headlamp-config
          emptyDir: {}
        - name: headlamp-tmp
          emptyDir: {}
        - name: headlamp-plugins
          emptyDir: {}
