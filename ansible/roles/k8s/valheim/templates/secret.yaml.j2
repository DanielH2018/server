---
# The join password. In its own Secret rather than inline in the Deployment because the
# Deployment manifest is rendered world-readable 0644 on the node; only files listed in
# manifests_secret_files get 0600 + no_log.
apiVersion: v1
kind: Secret
metadata:
  name: valheim-env
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  SERVER_PASS: "{{ valheim_server_pass }}"
