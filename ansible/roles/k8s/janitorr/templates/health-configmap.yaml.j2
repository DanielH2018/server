{#
  The janitorr-health CronJob's code: the reader, its verdict module, and the host_lib.py it
  imports. The reader puts its own directory on sys.path, so the three files sit flat at the
  mount, as they did in /opt/janitorr-health.

  No secret goes in here, and the pod takes none from a Secret.
  ansible/tests/k8s/test_no_secret_in_a_moved_jobs_configmap.py renders this file with every
  secrets.yml key bound to a sentinel and fails on any sentinel it finds.
#}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: janitorr-health
  namespace: {{ k8s_namespace }}
data:
  janitorr_health.py: |
{{ lookup('file', role_file('files/janitorr_health.py')) | indent(4, true) }}
  janitorr_health_logic.py: |
{{ lookup('file', role_file('files/janitorr_health_logic.py')) | indent(4, true) }}
  host_lib.py: |
{{ lookup('file', repo_file('hosts/lib/host_lib.py')) | indent(4, true) }}
