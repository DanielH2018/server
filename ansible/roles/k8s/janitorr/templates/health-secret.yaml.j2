{#
  The Janitorr Errors push URL, token included, for the janitorr-health CronJob's KUMA_PUSH_URL.

  Its own Secret, not a key of janitorr-config. The janitorr pod mounts that Secret, and the
  push token has no business in the one pod that deletes real media.

  The whole URL rather than the bare token, as configarr-health's push_url is. A value that is
  the token alone is a standalone placeholder under Flux, which would add a row for janitorr
  to k8s/manifests' standalone_secret_keys.json, and any change to that k8s/manifests file
  makes the tick's narrowed apply refuse as most of the fleet.
#}
---
apiVersion: v1
kind: Secret
metadata:
  name: janitorr-health
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  push_url: "http://uptime-kuma.{{ k8s_namespace }}.svc.cluster.local:{{ containers_list | entry_port('uptime-kuma') }}/api/push/{{ monitor_bridge_janitorr_push_token }}"
