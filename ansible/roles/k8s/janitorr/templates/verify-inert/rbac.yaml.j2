{#
  The identity of janitorr's Flux verify Job, INERT until janitorr's flip, as `job.yaml.j2`
  beside it is.

  It is a ServiceAccount with no Role. The Job dials the apps over HTTP and execs into no pod,
  so it needs no grant, and its pod mounts no token.
#}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: janitorr-verify
  namespace: {{ k8s_namespace }}
automountServiceAccountToken: false
