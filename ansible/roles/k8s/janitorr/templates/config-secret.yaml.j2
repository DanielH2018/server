---
apiVersion: v1
kind: Secret
metadata:
  name: janitorr-config
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  application.yml: |
{#
  Rendered from templates/config/application.yml.j2, not copied — that file is the deletion
  POLICY (expiration ladders, exclusion tags, which cleanups are enabled), and two copies of it
  that drifted would mean two different sets of media getting deleted.

  `janitorr_dry_run` is the one override, which that template reads with a `default(false)`.
  The *arr URLs are Service names in this namespace.

  A Secret rather than a ConfigMap because it embeds the Sonarr, Radarr and Jellyfin API keys.
#}
{{ lookup('template', playbook_dir + '/roles/k8s/janitorr/templates/config/application.yml.j2') | indent(4, true) }}
