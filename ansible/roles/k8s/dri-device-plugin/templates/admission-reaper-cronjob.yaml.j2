{% from 'container-resources.yml.j2' import job_container_resources with context %}
{% from 'security-context.yml.j2' import job_hardened_security_context with context %}
{#
  Two CronJobs run files/dri_admission_reaper.py, which holds both rules and what they leave
  alone; this file schedules them.

  `dri-admission-reaper`, in the workload namespace, deletes the Failed pods the kubelet
  rejected at admission because this role's plugin had not re-registered `devic.es/dri` yet,
  once their ReplicaSet has replaced them (#6367). It runs there rather than beside the
  DaemonSet in kube-system, because those pods are there and a Role grants only in its own
  namespace. The namespace baseline fences ingress only, and the job takes no connection, so
  it needs no `netpol_from` grant.

  `addon-job-reaper`, in kube-system, deletes the Failed Job pods in the add-on namespaces
  that `dri_device_plugin_reaper_job_namespaces` lists (#6460).
  # DECIDED: the add-on sweep runs as its own ServiceAccount in kube-system, not as the
  # workload namespace's reaper. Its grant reaches every pod in kube-system and
  # longhorn-system, and RBAC cannot narrow a delete by phase or owner. Only a principal that
  # can already create pods in kube-system can run a pod as this account, so the grant adds no
  # path from the workload namespace into those two. No baseline selects kube-system, so its
  # pod carries no netpol label.
#}
{% macro reaper(name, namespace, env, labels={}) %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ name }}
  namespace: {{ namespace }}
data:
  dri_admission_reaper.py: |
{{ lookup('file', playbook_dir + '/roles/k8s/dri-device-plugin/files/dri_admission_reaper.py') | indent(4, true) }}
  flux_job_connect.py: |
{{ lookup('file', playbook_dir + '/roles/k8s/manifests/files/flux_job_connect.py') | indent(4, true) }}
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: {{ name }}
  namespace: {{ namespace }}
spec:
  schedule: "{{ dri_device_plugin_reaper_schedule }}"
  timeZone: Etc/UTC
  concurrencyPolicy: Forbid
  # A missed run is not made up: the next one lists the Failed pods again.
  startingDeadlineSeconds: 300
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 2
  jobTemplate:
    metadata:
      labels:
        app: {{ name }}
    spec:
      activeDeadlineSeconds: {{ dri_device_plugin_reaper_deadline_seconds }}
      # No retry: the next run is one period away.
      backoffLimit: 0
      ttlSecondsAfterFinished: {{ dri_device_plugin_reaper_job_ttl_seconds }}
      template:
        metadata:
          labels:
            app: {{ name }}
{% for key, value in labels | dictsort %}
            {{ key }}: {{ value }}
{% endfor %}
        spec:
          restartPolicy: Never
          enableServiceLinks: false
          serviceAccountName: {{ name }}
          automountServiceAccountToken: true
          securityContext:
            runAsNonRoot: true
            runAsUser: 65534
            runAsGroup: 65534
            seccompProfile:
              type: RuntimeDefault
          priorityClassName: homelab-best-effort
          containers:
            - name: {{ name }}
              image: {{ dri_device_plugin_reaper_image }}
              imagePullPolicy: IfNotPresent
              command: ["python3", "/jobs/dri_admission_reaper.py"]
              env:
{% for key, value in env | dictsort %}
                - name: {{ key }}
                  value: "{{ value }}"
{% endfor %}
                # The API server's CA, which the automounted token volume carries.
                - name: SSL_CERT_FILE
                  value: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
                # The ConfigMap mount is read-only, so Python cannot write __pycache__ there.
                - name: PYTHONDONTWRITEBYTECODE
                  value: "1"
{{ job_hardened_security_context(read_only=true) }}
              volumeMounts:
                - name: {{ name }}-code
                  mountPath: /jobs
                  readOnly: true
{{ job_container_resources(cpu_limit='100m', mem_limit='64Mi', cpu_request='10m', mem_request='32Mi') }}
          volumes:
            - name: {{ name }}-code
              configMap:
                name: {{ name }}
{% endmacro %}
{{ reaper('dri-admission-reaper', k8s_namespace, {'REAPER_NAMESPACE': k8s_namespace}, {'netpol-baseline': 'enforced'}) }}
{{ reaper('addon-job-reaper', 'kube-system', {'REAPER_JOB_NAMESPACES': dri_device_plugin_reaper_job_namespaces | join(' ')}) }}
