---
# For configuration options and examples, please see:
# https://gethomepage.dev/latest/configs/service-widgets

# Cluster + per-node CPU/memory, read from metrics.k8s.io through the pod's ServiceAccount
# (roles/k8s/homepage: kubernetes.yaml.j2 `mode: cluster` + rbac.yaml.j2). This template is
# shared with the archived Docker role, where it is inert: that deployment has no cluster
# identity, and homepage renders an unreachable info widget as nothing rather than erroring.
- kubernetes:
    cluster:
      show: true
      cpu: true
      memory: true
      showLabel: true
      label: cluster
    nodes:
      show: true
      cpu: true
      memory: true
      showLabel: true

# Kagi. `custom` because homepage ships no built-in kagi provider - the set is
# google/duckduckgo/bing/baidu/brave/custom. The URL carries no session token on purpose:
# the search widget is a client-side navigation, so homepage serves this URL to every
# browser that loads the dashboard and the query string lands in that browser's history.
# A Kagi session token there is full-account access held in plaintext by every viewer.
# Tokenless, Kagi answers from the browser's own session cookie and prompts for a login
# when there is none. No suggestionUrl: Kagi publishes no unauthenticated autocomplete
# endpoint, so `showSearchSuggestions` has nothing to read.
- search:
    provider: custom
    url: https://kagi.com/search?q=
    target: _blank

- openmeteo:
    label: Current
    latitude: {{ lat }}
    longitude: {{ long }}
    timezone: {{ tz }}
    units: imperial
    cache: 5
