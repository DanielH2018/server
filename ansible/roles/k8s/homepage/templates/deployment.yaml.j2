{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: homepage
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  selector:
    matchLabels:
      app: homepage
  template:
    metadata:
      labels:
        app: homepage
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      # The identity behind kubernetes.yaml's `mode: cluster` (rbac.yaml.j2). Without the
      # name here the pod falls back to the namespace `default` SA and every kubernetes
      # widget renders empty instead of failing.
      serviceAccountName: homepage
      # 02e9cfac swept this to false across 56 pods that never call the API — homepage was
      # correctly in that set until the widget above gave it a reason to. Left explicit
      # rather than defaulted so the next estate-wide sweep sees a deliberate value here.
      automountServiceAccountToken: true
      # Copy-not-mount (the peanut pattern): homepage seeds every file of its skeleton
      # config set into /app/config at startup, and that set GROWS with the image —
      # custom.js and proxmox.yaml both joined it in 2026-08 updates, each crash-looping
      # the pod against a read-only Secret mount (EROFS on the seed copy). A writable
      # emptyDir seeded from the Secret ends the whack-a-mole: our files win, and the app
      # seeds whatever else it invents next to them.
      initContainers:
        - name: seed-config
          image: {{ homepage_k8s_init_image }}
          command: ["sh", "-c", "cp -L /config-secret/* /config/"]
{{ hardened_security_context(read_only=true) }}
          volumeMounts:
            - name: homepage-config
              mountPath: /config-secret
              readOnly: true
            - name: homepage-config-live
              mountPath: /config
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
      priorityClassName: homelab-best-effort
      # Preference, never a pin: daniel-box carries the storage- and VIP-pinned workloads and runs the hotter of the two nodes, so latency-insensitive services default here.
      # Weighted so the pod still schedules if daniel-server is cordoned or full.
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: homepage
          image: {{ homepage_k8s_image }}
          ports:
            - containerPort: {{ container_item.port }}
          # The compose template's cap_drop/cap_add pair: docker-entrypoint.sh chowns
          # /app/config and /app/config/logs to PUID/PGID (best-effort — it warns and
          # continues on failure, which is what happens against the read-only Secret mount
          # below) before su-exec'ing down to that uid.
{{ hardened_security_context(add=['CHOWN', 'SETUID', 'SETGID']) }}
          env:
            - name: PUID
              value: "{{ puid }}"
            - name: PGID
              value: "{{ pgid }}"
            - name: TZ
              value: "{{ tz }}"
            # The public (Cloudflare) host, the .local host used over the WireGuard private
            # path, and both -k8s forms — coexistence means both platforms answer for
            # homepage at once, and Homepage rejects any Host header not listed here.
            - name: HOMEPAGE_ALLOWED_HOSTS
              value: >-
                homepage.{{ domain }},homepage.local.{{ domain }},homepage.{{ domain }},homepage.local.{{ domain }}
          volumeMounts:
            - name: homepage-config-live
              mountPath: /app/config
            # Bookmark icons (see icons-configmap.yaml.j2).
            - name: homepage-icons
              mountPath: /app/public/icons
              readOnly: true
          # Regenerate `/` from the config this pod can actually read, once, at startup.
          #
          # WHY: the image ships a build-time render of `/` that carries NO settings.
          # gethomepage's `getStaticProps` (src/pages/index.jsx, v1.13.2) has no `revalidate`
          # key, so `next build` bakes the page into the image — against the skeleton config
          # the build has, whose settings.yaml is empty. Verified against the pinned digest:
          # `/app/.next/server/pages/en.json` in the image reads
          # `"initialSettings":{}` and `/app/.next/server/pages/en.html` reads
          # `<title data-next-head="">Homepage</title>`, and prerender-manifest.json records
          # `"initialRevalidateSeconds": false` — the cached page never expires on its own.
          #
          # Upstream's only re-render trigger is client-side: the browser compares
          # `/api/hash` (config hashes plus HOMEPAGE_BUILDTIME, reset by docker-entrypoint.sh
          # on every start) against its own localStorage, and calls `/api/revalidate` on a
          # MISMATCH. A browser with no stored hash stores it and triggers nothing. So a fresh
          # pod visited only by fresh browsers serves the config-less page for the container's
          # whole life, while the Deployment stays 1/1 and `probe.py health homepage` exits 0.
          # That is the 2026-09-06 `-m ui -k homepage` failure behind #1399/#1410.
          #
          # This hook removes the failure mode instead of detecting it: no CI-runnable detector
          # exists (the pod IP is fenced by the netpol baseline, `pods/exec` is forbidden to the
          # read-only ServiceAccount, and Traefik needs an Authelia session).
          #
          # `127.0.0.1:<port>` is allow-listed unconditionally by upstream's middleware, so no
          # Host header is needed here — unlike the probes below, which arrive as the pod IP.
          # It NEVER exits non-zero: a failing postStart kills the container, which would turn
          # a cosmetic defect into a crashloop. Breaks on first success, so the container is
          # held out of Running for seconds, not the full budget.
          lifecycle:
            postStart:
              exec:
                command:
                  - sh
                  - -c
                  - >-
                    i=0;
                    while [ "$i" -lt 60 ]; do
                    wget -q -O /dev/null "http://127.0.0.1:{{ container_item.port }}/api/revalidate" && break;
                    i=$((i+1));
                    sleep 1;
                    done;
                    exit 0
          readinessProbe:
            httpGet:
              path: /api/healthcheck
              port: {{ container_item.port }}
              # kubelet probes carry the pod IP as Host, which HOMEPAGE_ALLOWED_HOSTS
              # rejects (400) — pin an allowed Host (failed live at first deploy).
              httpHeaders:
                - name: Host
                  value: "{{ container_item.hostname }}.local.{{ domain }}"
            initialDelaySeconds: 15
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /api/healthcheck
              port: {{ container_item.port }}
              # kubelet probes carry the pod IP as Host, which HOMEPAGE_ALLOWED_HOSTS
              # rejects (400) — pin an allowed Host (failed live at first deploy).
              httpHeaders:
                - name: Host
                  value: "{{ container_item.hostname }}.local.{{ domain }}"
            initialDelaySeconds: 30
            periodSeconds: 30
{{ container_resources(cpu_limit=homepage_k8s_cpu_limit, mem_limit=homepage_k8s_mem_limit, cpu_request=homepage_k8s_cpu_request, mem_request=homepage_k8s_mem_request) }}
      volumes:
        - name: homepage-config
          secret:
            secretName: homepage-config
        # The writable /app/config the init container seeds; logs no longer need their own
        # emptyDir carve-out (the whole dir is writable now).
        - name: homepage-config-live
          emptyDir: {}
        - name: homepage-icons
          configMap:
            name: homepage-icons
