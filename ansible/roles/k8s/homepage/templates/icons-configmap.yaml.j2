---
# The bookmark icons the Docker role served via its ./icons bind mount — without them the
# bookmark tiles render broken images (E3 audit). binaryData reads the SAME files/ dir in
# the Docker role (single source, like the lookup('template') config keys); ~160KB total,
# well under the 1MiB object limit.
apiVersion: v1
kind: ConfigMap
metadata:
  name: homepage-icons
  namespace: {{ k8s_namespace }}
binaryData:
{# Only the icons a bookmark actually references. The other five PNGs in files/ — limitless,
   LoLalytics, opgg, tacticstools, tftacademy — belonged to gaming bookmarks that were
   commented out; they were still base64'd into this object until 2026-09-09, making it ~6x
   the size it needed. They stay in files/ so reviving one is adding its name back here.
   A name listed here and missing from files/ fails the render, not the deploy. #}
{% for icon in ['monarch.png'] %}
  {{ icon }}: {{ lookup('pipe', 'base64 -w0 ' ~ playbook_dir ~ '/roles/k8s/homepage/files/' ~ icon) }}
{% endfor %}
