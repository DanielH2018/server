---
apiVersion: v1
kind: Secret
metadata:
  name: homepage-config
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
{#
  settings.yaml/bookmarks.yaml/widgets.yaml/custom.css are byte-identical on both platforms —
  rendered from the Docker role's templates (the configarr/zigbee2mqtt precedent), not copied,
  so the two cannot drift.

  services.yaml and docker.yaml genuinely diverge between platforms (see this role's own
  docker.yaml.j2 for why), so those two are forked into this role's templates/ instead of
  being read from the Docker role — the k8s/homepage role may not edit anything under
  roles/containers/homepage/.

  kubernetes.yaml has no Docker-side counterpart at all — see this role's kubernetes.yaml.j2
  for why the app requires it to exist here regardless.
#}
  settings.yaml: |
{{ lookup('template', playbook_dir + '/roles/containers/homepage/templates/settings.yaml.j2') | indent(4, true) }}
  bookmarks.yaml: |
{{ lookup('template', playbook_dir + '/roles/containers/homepage/templates/bookmarks.yaml.j2') | indent(4, true) }}
  widgets.yaml: |
{{ lookup('template', playbook_dir + '/roles/containers/homepage/templates/widgets.yaml.j2') | indent(4, true) }}
  custom.css: |
{{ lookup('template', playbook_dir + '/roles/containers/homepage/templates/custom.css.j2') | indent(4, true) }}
  services.yaml: |
{{ lookup('template', playbook_dir + '/roles/k8s/homepage/templates/services.yaml.j2') | indent(4, true) }}
  docker.yaml: |
{{ lookup('template', playbook_dir + '/roles/k8s/homepage/templates/docker.yaml.j2') | indent(4, true) }}
  kubernetes.yaml: |
{{ lookup('template', playbook_dir + '/roles/k8s/homepage/templates/kubernetes.yaml.j2') | indent(4, true) }}
