---
apiVersion: v1
kind: Secret
metadata:
  name: homepage-config
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
{#
  Every file here is app config, embedded from templates/config/ — one level down because the
  manifest validator parses every templates/*.j2 as a Kubernetes manifest, and none of these
  is one (custom.css.j2 is not even YAML). validate/k8s_manifests.py fails a lookup('template')
  that names a templates/ path outside config/.

  services.yaml and docker.yaml diverged between platforms while the Docker role existed (see
  docker.yaml.j2 for why); kubernetes.yaml has no Docker-side counterpart at all — see
  kubernetes.yaml.j2 for why the app requires it to exist here regardless.
#}
  settings.yaml: |
{{ lookup('template', playbook_dir + '/roles/k8s/homepage/templates/config/settings.yaml.j2') | indent(4, true) }}
  bookmarks.yaml: |
{{ lookup('template', playbook_dir + '/roles/k8s/homepage/templates/config/bookmarks.yaml.j2') | indent(4, true) }}
  widgets.yaml: |
{{ lookup('template', playbook_dir + '/roles/k8s/homepage/templates/config/widgets.yaml.j2') | indent(4, true) }}
  custom.css: |
{{ lookup('template', playbook_dir + '/roles/k8s/homepage/templates/config/custom.css.j2') | indent(4, true) }}
  services.yaml: |
{{ lookup('template', playbook_dir + '/roles/k8s/homepage/templates/config/services.yaml.j2') | indent(4, true) }}
  docker.yaml: |
{{ lookup('template', playbook_dir + '/roles/k8s/homepage/templates/config/docker.yaml.j2') | indent(4, true) }}
  kubernetes.yaml: |
{{ lookup('template', playbook_dir + '/roles/k8s/homepage/templates/config/kubernetes.yaml.j2') | indent(4, true) }}
  # Same guard class as kubernetes.yaml above: homepage seeds any missing config file into
  # /app/config at startup, which EROFSes on this read-only mount and CRASH-LOOPS the pod.
  # custom.js joined that required set in a 2026-08 image (bit live: 31 restarts overnight
  # on :latest, "Failed to initialize required config: /app/config/custom.js"). Empty is a
  # valid value - it exists so the seed step is skipped.
  custom.js: ""
