

{#
  The sole services.yaml for Homepage. It began as a fork of the Docker role's copy,
  differing only in dropping the two `server:`/`container:` pairs (see docker.yaml.j2 in this
  role for why). That copy was deleted once Docker left both cluster nodes, so there is no
  longer a second template to keep in sync — edit tiles and widgets here and nowhere else.
#}
- Top Row:
    - Services:
        - Uptime-Kuma:
            icon: uptime-kuma.png
            href: https://uptime-kuma.{{ domain }}/
            description: Container Monitoring
            # No server/container pair since the Phase D cutover (2026-08-10): Kuma runs in
            # k3s now. Widget re-targets the -k8s name (bridged names hairpin from here);
            # /api/status-page bypasses Authelia LAN-only on the k8s side.
            widget:
                type: uptimekuma
                url: https://uptime-kuma.local.{{ domain }}
                slug: containers
        - Pihole:
            icon: pi-hole.png
            href: https://pihole.{{ domain }}/admin
            description: DNS Ad Blocker
            widget:
                type: pihole
                url: http://pihole:80
                version: 6
                key: {{ pihole_password }}
        - Speedtest:
            icon: speedtest-tracker.png
            href: https://speedtest.{{ domain }}/
            description: Internet tracking
            # No server/container: speedtest runs in k3s now, so there is no Docker container
            # for the status dot. The -k8s name is the ClientIP-gated monitoring route (no
            # Authelia) — the unsuffixed name's native route is Authelia'd and 401s this
            # session-less widget (broke when the slice-7 teardown removed the bridge route).
            widget:
                type: speedtest
                url: https://speedtest.local.{{ domain }}
        - FreshRSS:
            icon: freshrss.png
            href: https://freshrss.{{ domain }}/
            description: RSS Link Aggregator
            # No server/container: freshrss runs in k3s now. Same as speedtest above — the
            # -k8s monitoring route, because the native route's Authelia 401s the widget.
            widget:
                type: freshrss
                url: https://freshrss.local.{{ domain }}
                username: {{ freshrss_username }}
                password: {{ freshrss_password }}
        - Karakeep:
            icon: karakeep.png
            href: https://karakeep.{{ domain }}/
            description: Karakeep
            # No server/container: karakeep runs in k3s now. Same as speedtest and freshrss
            # above — the -k8s monitoring route, because the native route's Authelia 401s
            # the widget.
            widget:
                type: karakeep
                url: https://karakeep.local.{{ domain }}
                key: {{ karakeep_homepage_api_key }}
        - UPS:
            icon: apc.png
            href: https://peanut.{{ domain }}/
            description: APC BR1500MS2
            widget:
                type: peanut
                # The -k8s monitoring route (ClientIP-gated, no Authelia) — the old
                # Docker-internal name died with the shared bridge. peanut's own basic
                # auth (username/password below) is the gate on this path.
                url: https://peanut.local.{{ domain }}
                key: {{ nut_ups_name | default('apc-ups') }}
                username: {{ peanut_username }}
                password: {{ peanut_password }}
        - Headlamp:
            icon: kubernetes.png
            href: https://headlamp.{{ domain }}/
            description: Cluster UI
            # k8s-only tile, and the one place this fork diverges from the Docker template
            # beyond the documented server/container drop: Headlamp has no Docker twin, and
            # namespace/podSelector are meaningless to a Docker homepage. These two keys are
            # homepage's built-in pod stats (CPU/memory) for headlamp's OWN pod, and need
            # kubernetes.yaml's `mode: cluster`. They are separate from the `widget:` block
            # below, which shows whole-cluster counts — see its comment for why it is not a
            # native Headlamp widget.
            #
            # podSelector rather than `app:`: homepage's `app:` key expands to the label
            # selector app.kubernetes.io/name=<value>, and this homelab labels its pods with
            # the plain `app` key instead. `app: headlamp` would match nothing and render blank.
            namespace: {{ k8s_namespace }}
            podSelector: app=headlamp
            # The widget reads PROMETHEUS, NOT HEADLAMP, and that is the whole design decision.
            # Headlamp has no service API of its own — its backend only proxies the Kubernetes
            # API — so the only "Headlamp widget" would be homepage dialling headlamp's
            # ClusterIP. That is exactly the exposure roles/k8s/headlamp/networkpolicy.yaml.j2
            # closes: the pod runs `-unsafe-use-service-account-token`, so anything that reaches
            # it acts as a cluster-wide reader with no auth, and netpol-probe-job.yaml.j2
            # re-asserts on every deploy that no non-traefik pod can. Admitting homepage there
            # would widen that fence and invalidate the probe. Prometheus gives the same numbers
            # with none of that, so the tile shows CLUSTER STATE and links to Headlamp to act on
            # it. Query and its shape: homepage_k8s_headlamp_cluster_query in defaults/main.yml.
            #
            # ClusterIP, not the `prometheus.local.{{ domain }}` Traefik route: monitor-bridge
            # and homelab-mcp already read prometheus this way, and that route's ClientIP list
            # is written for callers that cannot reach the ClusterIP. Cross-namespace, so
            # `prometheus-callers` (roles/k8s/netpol-baseline/networkpolicy-prometheus.yaml.j2)
            # must name homepage — fenced out, this fails as a widget-proxy error that reads
            # nothing like a NetworkPolicy problem.
            widget:
                type: customapi
                url: "http://prometheus.{{ k8s_observability_namespace }}.svc.cluster.local:9090/api/v1/query?query={{ homepage_k8s_headlamp_cluster_query | urlencode }}"
                # 60s, against homepage's 10s default: this is a Prometheus query per dashboard
                # load per browser, and cluster counts do not move on a 10-second scale.
                refreshInterval: 60000
                # DECIDED: `display: block` (homepage's default), not `dynamic-list` — every
                # other widget on this dashboard renders as blocks, and a list tile reads as a
                # different kind of thing. The cost is that block mode pairs a value to a label
                # by ARRAY POSITION, so the indices below depend on the `or` operand order in
                # homepage_k8s_headlamp_cluster_query. Accepted because a reordering shows up as
                # "97 NODES" — wrong at a glance rather than plausibly wrong. Keep the
                # query's operand order and this list in the same order; changing one alone is
                # the only way to break this quietly. ENFORCED by
                # ansible/tests/services/test_headlamp_widget_mapping_order.py, which fails on a
                # reordered, renamed, missing or duplicated counter.
                #
                # Prometheus wraps its vector as {"data": {"result": [{"metric": {...},
                # "value": [<ts>, "<n>"]}, …]}} — hence `data.result.<n>.value.1` for each number.
                mappings:
                    - field: data.result.0.value.1
                      label: Nodes
                      format: number
                    - field: data.result.1.value.1
                      label: Running
                      format: number
                    - field: data.result.2.value.1
                      label: Stopped
                      format: number
                    - field: data.result.3.value.1
                      label: Degraded
                      format: number
        - Scrutiny:
            icon: scrutiny.png
            href: https://scrutiny.{{ domain }}/
            description: Disk SMART health
            # ClusterIP, not a Traefik route: scrutiny's native route is Authelia-gated and would
            # 401 this session-less widget, and its monitoring route exposes no API path. Pod to
            # pod bypasses both. Same shape as the sonarr/radarr/qbittorrent widgets below, and
            # the same requirement — `networkpolicy-scrutiny-web.yaml.j2` must admit
            # `app: homepage` on 8080 or this renders as a widget-proxy error.
            #
            # Scrutiny has no auth of its own (that is why longhorn-ui-style route middleware
            # fronts it), so there is no key to hold here. Verified 2026-09-06:
            # `GET /api/summary` on the ClusterIP answers 200 with the device summary.
            widget:
                type: scrutiny
                url: http://scrutiny.{{ k8s_namespace }}.svc.cluster.local:8080
        - Home Assistant:
            icon: home-assistant.png
            href: https://home-assistant.{{ domain }}/
            description: Bedroom air quality
            # No server/container pair and a bridge-URL widget since slice-5 B3: HA runs in
            # k3s, so the Docker-DNS name is gone. The .local name resolves from containers
            # (LAN DNS) and served the same HA before and after the cutover.
            widget:
                type: homeassistant
                url: https://home-assistant.local.{{ domain }}
                key: {{ homepage_ha_token }}
                custom:
                    - state: sensor.bedroom_airgradient_one_carbon_dioxide
                      label: CO₂
                    - template: "{% raw %}{{ states('sensor.bedroom_airgradient_one_temperature') | float | round(1) }}{% endraw %} °F"
                      label: Temp
                    - state: sensor.bedroom_airgradient_one_humidity
                      label: Humidity
                    - state: sensor.bedroom_airgradient_one_voc_index
                      label: VOC
    - Calendar:
        - Calendar:
            id: my-calendar
            href: https://calendar.google.com/calendar/u/0/r
            widget:
              type: calendar
              firstDayInWeek: sunday
              view: monthly
              maxEvents: 8
              showTime: true
              timezone: {{ tz }}
              integrations:
                - type: ical
                  url: http://ical-proxy.{{ k8s_namespace }}.svc.cluster.local:5000/calendar1.ics
                  name: Daniel
                  color: indigo
                  params:
                      showName: true
                - type: ical
                  url: http://ical-proxy.{{ k8s_namespace }}.svc.cluster.local:5000/calendar2.ics
                  name: Work
                  color: slate
                  params:
                      showName: true
                - type: ical
                  url: {{ calendar_3 }}
                  name: Holidays
                  color: purple
                  params:
                      showName: true
                - type: ical
                  url: http://ical-proxy.{{ k8s_namespace }}.svc.cluster.local:5000/calendar4.ics
                  name: Tasks
                  color: emerald
                  params:
                      showName: true
        # SECOND TILE IN THE CALENDAR COLUMN, and it is here to fill space rather than because
        # crypto prices belong beside a calendar. The Calendar renders 372px against a 516px
        # Services column beside it, so 144px sat dead underneath it; this tile is 164px and
        # closes that to a 20px overshoot. It also had nowhere better to be — it was a `Tracking`
        # group of exactly one tile, stranded alone at the very bottom of the page.
        #
        # The group heading above therefore reads `Calendar` while holding both. That is the
        # cost of the arrangement, accepted because the calendar is the column's subject and a
        # heading naming both would be worse. To undo: move this block back out to a top-level
        # `- Tracking:` group and re-add its `Tracking:` entry to the layout in settings.yaml.j2.
        - Crypto:
            icon: mdi-currency-btc
            description: Market prices
            widget:
                type: coinmarketcap
                currency: USD # Optional
                symbols: [BTC, ETH, DOGE]
                key: {{ coinmarket_api_key }}
                defaultinterval: 24h # Optional

- Media:
    # The four media services moved to the k8s cluster (slice 4), so the Docker-DNS widget URLs
    # (http://jellyfin:8096, …) stopped resolving — each dashboard load burned ~15 widget-proxy
    # 500s (the Traefik `homepage@docker` 5xx signal, 2026-08-08). The `server:`/`container:`
    # docker-status pairs referenced containers that no longer exist on this host and are gone.
    #
    # THE THREE URL SHAPES BELOW DIFFER ON PURPOSE — do not normalise them.
    # Jellyfin's -k8s route carries no Authelia, so its widget goes through Traefik at
    # `jellyfin.local.{{ domain }}`. The sonarr/radarr/qbittorrent routes ARE Authelia-gated, and
    # their monitoring IngressRoutes deliberately expose only /api/v3/queue, so no Traefik URL
    # reaches their widget APIs. Those three therefore address the ClusterIP directly, which
    # bypasses Traefik and Authelia entirely and leaves `monitoring_route`
    # (ansible/templates/ingressroute.yml.j2) as narrow as it was. Same URL shape monitor-bridge
    # already uses (roles/k8s/monitor-bridge/templates/env-secret.yaml.j2).
    #
    # Reaching a ClusterIP is pod → pod, so each target's NetworkPolicy must admit `app: homepage`
    # on that port — see roles/k8s/{sonarr,radarr,qbittorrent}/templates/networkpolicy.yaml.j2.
    # Fenced out, the widget fails as a widget-proxy error, not as an auth error.
    - Jellyfin:
        href: https://jellyfin.{{ domain }}
        icon: jellyfin.png
        description: Mediaserver
        widget:
            type: jellyfin
            url: https://jellyfin.local.{{ domain }}
            key: {{ jellyfin_api_key }}
    - Sonarr:
        icon: sonarr.png
        href: https://sonarr.{{ domain }}/
        description: Series management
        widget:
            type: sonarr
            url: http://sonarr.{{ k8s_namespace }}.svc.cluster.local:8989
            key: {{ sonarr_api_key }}
    - Radarr:
        icon: radarr.png
        href: https://radarr.{{ domain }}/
        description: Movie management
        widget:
            type: radarr
            url: http://radarr.{{ k8s_namespace }}.svc.cluster.local:7878
            key: {{ radarr_api_key }}
    - qBittorrent:
        icon: qbittorrent.png
        href: https://qBittorrent.{{ domain }}
        description: Download management
        widget:
            type: qbittorrent
            url: http://qbittorrent.{{ k8s_namespace }}.svc.cluster.local:8080  # literal: qbittorrent_k8s_webui_port is that role's default, not in scope here
            username: {{ qbittorrent_username }}
            password: {{ qbittorrent_password }}
    # LINK-ONLY, and deliberately so — see the Admin group below for why no `widget:` block.
    - Prowlarr:
        icon: prowlarr.png
        href: https://prowlarr.{{ domain }}/
        description: Indexer management
    - Bazarr:
        icon: bazarr.png
        href: https://bazarr.{{ domain }}/
        description: Subtitle management
    - Tdarr:
        icon: tdarr.png
        href: https://tdarr.{{ domain }}/
        description: Transcode automation

# ADMIN and TOOLS are LINK-ONLY GROUPS, and the absence of `widget:` blocks is the point.
# Before 2026-09-09 this dashboard carried 14 tiles against ~30 routed web UIs, so the way to
# reach the other sixteen was to remember the hostname. A link-only tile closes that gap at
# zero risk: a widget dialling a ClusterIP needs the target's NetworkPolicy to name
# `app: homepage` (ENFORCED by ansible/tests/services/test_homepage_widget_netpol_edges.py),
# while a tile with only an `href:` reaches nothing from the pod at all.
#
# Adding a widget to one of these later is a per-service change, not a bulk one, and four of
# them are already ruled on: traefik (#1383), grafana (#1384), crowdsec (#1385) and
# healthchecks (#1386) each record a credential reason the widget was not simply plumbed in.
# A link-only tile contradicts none of those — it adds a way in, not an API call.
#
# Two roles carry a `hostname:` in containers_list and are NOT here, both on purpose:
# navidrome is scaled to 0 replicas, and livesync has no IngressRoute at all.
- Admin:
    - Grafana:
        icon: grafana.png
        href: https://grafana.{{ domain }}/
        description: Metrics and dashboards
    - Longhorn:
        icon: longhorn.png
        # LAN-only: longhorn-frontend's IngressRoute matches longhorn.local.<domain> and no
        # public name, because Authelia is the entire access control on a UI that can delete
        # volumes and their B2 backup chain.
        href: https://longhorn.local.{{ domain }}/
        description: Cluster storage
    - Healthchecks:
        icon: healthchecks.png
        href: https://healthchecks.{{ domain }}/
        description: Cron dead-man switch
    - Traefik:
        icon: traefik.png
        # LAN-only, same as longhorn. The dashboard route exists; only the /api the homepage
        # widget would need is served nowhere (#1383), which is why this is a link.
        href: https://traefik.local.{{ domain }}/
        description: Reverse proxy
    - Authelia:
        icon: authelia.png
        href: https://auth.{{ domain }}/
        description: SSO portal
    - code-server:
        icon: code-server.png
        href: https://code-server.{{ domain }}/
        description: Browser IDE
    - Zigbee2MQTT:
        icon: zigbee2mqtt.png
        href: https://zigbee2mqtt.{{ domain }}/
        description: Zigbee gateway
    - WireGuard:
        # `wireguard.png`, not `wg-easy.png`: the role and the containers_list entry are both
        # named wg-easy, but dashboard-icons has no icon under that name and homepage renders a
        # missing one as a broken image rather than falling back. Verified 2026-09-09 —
        # .../dashboard-icons/png/wg-easy.png answers 404, wireguard.png answers 200.
        icon: wireguard.png
        href: https://wg-easy.{{ domain }}/
        description: VPN peers

- Tools:
    - n8n:
        icon: n8n.png
        href: https://n8n.{{ domain }}/
        description: Workflow automation
    - Bento PDF:
        icon: mdi-file-pdf-box
        href: https://bento-pdf.{{ domain }}/
        description: PDF toolkit
    - TeXBrain:
        icon: mdi-math-integral
        href: https://texbrain.{{ domain }}/
        description: LaTeX workspace
    - Artifacts:
        icon: mdi-file-document-multiple
        href: https://artifacts.{{ domain }}/
        description: Generated reports
    - Docs:
        icon: mdi-book-open-variant
        href: https://docs.{{ domain }}/
        description: Homelab reference
    - LittleLink:
        icon: mdi-link-variant
        href: https://www.{{ domain }}/
        description: Link-in-bio page
