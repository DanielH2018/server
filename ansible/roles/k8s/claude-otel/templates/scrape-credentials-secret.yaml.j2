---
# Scrape credentials for the PG1 ported jobs (Phase D dashboard triage). File-mounted and
# referenced via password_file/credentials_file so the values stay out of the world-
# readable prometheus-config ConfigMap. Reuses the same SOPS values the Docker prometheus
# used for the identical scrapes — not new credentials, a relocated consumer.
apiVersion: v1
kind: Secret
metadata:
  name: prometheus-scrape-credentials
  namespace: {{ k8s_observability_namespace }}
type: Opaque
stringData:
  kuma_api_key: "{{ prometheus_kuma_api_key }}"
  ha_token: "{{ prometheus_ha_token }}"
