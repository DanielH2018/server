---
apiVersion: v1
kind: ConfigMap
metadata:
  name: prometheus-config
  namespace: {{ k8s_observability_namespace }}
data:
  prometheus.yml: |
    global:
      scrape_interval: 15s
    scrape_configs:
      # Prometheus scraping itself. Added in slice 3 B3, and not cosmetic: until now this
      # instance had no self-scrape at all, so its own ingestion rate, TSDB footprint and
      # remote-write receive errors were unreadable — measured 2026-08-07, a query for
      # prometheus_tsdb_head_series returned an empty vector. B5 promotes this instance to
      # monitor-bridge's only Prometheus, so "how full is it and is it keeping up" has to be
      # answerable from inside it before anything depends on it.
      - job_name: prometheus
        static_configs:
          - targets: ['localhost:9090']
      # The collector re-exposes Claude Code's OTLP metrics here. This is the only source of
      # session/token/cost data — nothing else produces it.
      - job_name: otel-collector
        static_configs:
          - targets: ['otel-collector:8889']
      # The collector's OWN metrics, on a different port. These carry the send_failed_*
      # counters that are the only evidence a batch was dropped en route to Loki. Without
      # this scrape a silent export failure is indistinguishable from "Claude Code was idle".
      - job_name: otel-collector-internal
        static_configs:
          - targets: ['otel-collector:8888']
      # Workload readiness for every Pod/Deployment in the cluster (slice 3, D8). This is what
      # gives the seven previously-unmonitorable workloads a health signal at all — see the
      # header of kube-state-metrics.yaml.j2.
      - job_name: kube-state-metrics
        static_configs:
          - targets: ['kube-state-metrics:8080']
      # Slice-6 B2: the CrowdSec engine (LAPI+AppSec) moved in-cluster; its :6060 carries the
      # LAPI/decision metrics the Grafana CrowdSec boards read. The Docker-side scrape that
      # used to cover this now sees only that host's demoted agent.
      - job_name: crowdsec
        static_configs:
          - targets: ['crowdsec.{{ k8s_namespace }}.svc:6060']
      # ── Phase D dashboard triage (2026-08-10, PG1/PG2 — slice-7-phase-d-dashboards.md) ──
      # PG1: ported from the Docker prometheus, which scraped these cluster workloads from
      # the wrong side of the migration (through Traefik routes, over the LAN). Same job
      # names as the Docker jobs carried, so every dashboard query and consumer keeps
      # resolving; in-cluster ClusterIP targets, so no route/bypass/DNS in the path.
      # Credentials are file-mounted from the prometheus-scrape-credentials Secret — they
      # must NOT be inlined here (this is a world-readable ConfigMap, not a Secret).
      #
      # Kuma's API key rides HTTP Basic with a blank username; per-monitor up/down,
      # response times and cert-days-remaining. Sole source of monitor_status — the
      # uptime-kuma board and scripts/postflight.py's gates read it.
      - job_name: uptime-kuma
        scrape_interval: 1m
        basic_auth:
          username: ""
          password_file: /etc/prometheus-scrape-creds/kuma_api_key
        static_configs:
          - targets: ['uptime-kuma.{{ k8s_namespace }}.svc:3001']
      # HA's prometheus integration; the bearer token is the gate (its route carries no
      # Authelia by design). Feeds hass_* — the home-assistant + ups boards and
      # monitor-bridge's UPS battery checks (which query hass_* unpinned, so the native
      # series feeds them with no origin-label caveat).
      - job_name: home-assistant
        scrape_interval: 1m
        metrics_path: /api/prometheus
        authorization:
          credentials_file: /etc/prometheus-scrape-creds/ha_token
        static_configs:
          - targets: ['home-assistant.{{ k8s_namespace }}.svc:8123']
      # PG2: the cluster homelab Loki's own internals (loki_*) — nothing scraped it before
      # this job, despite slice-7-phase-d-loki.md assuming otherwise. Keeps the
      # Logs/loki-internals board alive past the Docker loki's retirement.
      - job_name: loki-homelab
        scrape_interval: 1m
        static_configs:
          - targets: ['loki-homelab.{{ k8s_namespace }}.svc:3100']
      # PG2: the k8s edge's traefik_* metrics (exposed since slice-6, scraped by nothing).
      # Via the dedicated traefik-metrics ClusterIP — the internal :8080 entrypoint must
      # not ride the LoadBalancer Service onto the LAN VIP.
      - job_name: traefik-k8s
        scrape_interval: 1m
        static_configs:
          - targets: ['traefik-metrics.{{ k8s_namespace }}.svc:8080']
      # Per-pod CPU/memory from each kubelet's cAdvisor, reached through the API server proxy
      # rather than the kubelet's own :10250. The proxy path needs only nodes/proxy RBAC and no
      # kubelet client certificate, which is why it is the usual choice for a single-node k3s.
      #
      # insecure_skip_verify is on the API server hop: k3s serves it with a cert whose SANs do
      # not include the in-cluster Service name this relabels to. The bearer token is still
      # verified by the API server, so this weakens transport identity inside the cluster, not
      # authn.
      - job_name: kubernetes-cadvisor
        scheme: https
        tls_config:
          ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
          insecure_skip_verify: true
        bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
        kubernetes_sd_configs:
          - role: node
        relabel_configs:
          - action: labelmap
            regex: __meta_kubernetes_node_label_(.+)
          - target_label: __address__
            replacement: kubernetes.default.svc:443
          - source_labels: [__meta_kubernetes_node_name]
            regex: (.+)
            target_label: __metrics_path__
            replacement: /api/v1/nodes/${1}/proxy/metrics/cadvisor
---
# Prometheus authenticates to the API server as itself for the kubernetes_sd_configs discovery
# above. Read-only and list/watch-only: it enumerates nodes to discover scrape targets and
# proxies to their cAdvisor endpoints. It cannot mutate anything, and it is deliberately NOT
# granted secrets or configmaps.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: prometheus
  namespace: {{ k8s_observability_namespace }}
automountServiceAccountToken: true
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: prometheus
rules:
  - apiGroups: [""]
    resources: [nodes, nodes/metrics, services, endpoints, pods]
    verbs: [get, list, watch]
  # The cAdvisor scrape above goes through /api/v1/nodes/<name>/proxy/, which is authorized as
  # a `get` on this subresource rather than on the node object.
  - apiGroups: [""]
    resources: [nodes/proxy]
    verbs: [get]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: prometheus
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: prometheus
subjects:
  - kind: ServiceAccount
    name: prometheus
    namespace: {{ k8s_observability_namespace }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: prometheus-data
  namespace: {{ k8s_observability_namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ claude_otel_storage_class }}
  resources:
    requests:
      storage: {{ claude_otel_prometheus_storage }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: prometheus
  namespace: {{ k8s_observability_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate  # ReadWriteOnce PVC — see the note on the loki Deployment
  selector:
    matchLabels:
      app: prometheus
  template:
    metadata:
      labels:
        app: prometheus
    spec:
      # Without this the pod runs as the namespace `default` SA, whose token cannot list nodes —
      # kubernetes_sd_configs then discovers zero targets and the cadvisor job silently reports
      # no series rather than erroring.
      serviceAccountName: prometheus
      enableServiceLinks: false
      securityContext:
        runAsUser: 65534
        runAsGroup: 65534
        fsGroup: 65534
      containers:
        - name: prometheus
          image: {{ claude_otel_prometheus_image }}
          args:
            - --config.file=/etc/prometheus/prometheus.yml
            - --storage.tsdb.path=/prometheus
            - --storage.tsdb.retention.time={{ claude_otel_prometheus_retention }}
            # A SECOND cap, on bytes. The time cap alone does not bound the PVC: retention.time
            # says how old a block may get, not how much a block holds, so an ingest-rate rise
            # (slice 3 B3 doubles it — daniel-server now remote-writes its whole TSDB here) grows
            # the footprint without aging anything out. A full Prometheus PVC does not degrade,
            # it wedges — and the instance that would alert on it is this one. Whichever cap binds
            # first wins, which is the intended behaviour.
            - --storage.tsdb.retention.size={{ claude_otel_prometheus_retention_size }}
            # Accepts the Prometheus remote-write protocol on /api/v1/write (slice 3, B3). Off by
            # default in Prometheus 3.x, which is why the endpoint 404s without it. The write door
            # is opened no wider than daniel-server — see prometheus-ingressroute.yaml.j2.
            - --web.enable-remote-write-receiver
          ports:
            - name: http
              containerPort: 9090
              # On the node's loopback so otelq can reach it; see
              # claude_otel_query_host_ip in defaults/main.yml.
              hostPort: 9090
              hostIP: {{ claude_otel_query_host_ip }}
          volumeMounts:
            - name: config
              mountPath: /etc/prometheus
            - name: data
              mountPath: /prometheus
            # /etc, not /run/secrets (the ServiceAccount-token-shadow guard); 0444 because
            # prometheus runs as nobody and secret-volume files are root-owned.
            - name: scrape-creds
              mountPath: /etc/prometheus-scrape-creds
              readOnly: true
          readinessProbe:
            httpGet:
              path: /-/ready
              port: 9090
            initialDelaySeconds: 15
            periodSeconds: 10
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              cpu: "1"
              memory: 1Gi
      volumes:
        - name: config
          configMap:
            name: prometheus-config
        - name: data
          persistentVolumeClaim:
            claimName: prometheus-data
        - name: scrape-creds
          secret:
            secretName: prometheus-scrape-credentials
            defaultMode: 0o444
---
apiVersion: v1
kind: Service
metadata:
  name: prometheus
  namespace: {{ k8s_observability_namespace }}
spec:
  selector:
    app: prometheus
  ports:
    - name: http
      port: 9090
      targetPort: 9090
