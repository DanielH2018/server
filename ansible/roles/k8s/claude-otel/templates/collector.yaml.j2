---
apiVersion: v1
kind: ConfigMap
metadata:
  name: otel-collector-config
  namespace: {{ k8s_observability_namespace }}
data:
  config.yaml: |
    receivers:
      otlp:
        protocols:
          grpc:
            # 0.0.0.0 INSIDE the container. Reachability is controlled by the hostPort's
            # hostIP below, which pins the node-side listener to loopback.
            endpoint: 0.0.0.0:4317
    processors:
      batch:
        timeout: 5s
    extensions:
      health_check:
        # Probe target only — in-cluster, never a hostPort, carries no telemetry.
        endpoint: 0.0.0.0:13133
    exporters:
      prometheus:
        endpoint: 0.0.0.0:8889
        # Keep each counter's last value long after activity stops. The 5m default drops
        # idle metrics, so cumulative-counter panels flicker to "No data" between sessions.
        metric_expiration: 168h
        # Promote OTLP resource attributes (model, terminal, ...) to metric labels so token
        # usage can be broken down by model.
        resource_to_telemetry_conversion:
          enabled: true
      otlp_http/loki:
        # Loki 3.x native OTLP ingest; the exporter appends /v1/logs.
        endpoint: http://loki:3100/otlp
      otlp/tempo:
        endpoint: tempo:4317
        tls:
          # Plaintext in-cluster. Both ends are pods in this namespace and the port is not
          # published anywhere, so this never leaves the node.
          insecure: true
    service:
      extensions: [health_check]
      telemetry:
        logs:
          level: info
        metrics:
          readers:
            - pull:
                exporter:
                  prometheus:
                    # 0.0.0.0 so Prometheus can scrape it in-cluster; the default localhost
                    # bind makes it unreachable from anywhere. No hostPort, so it stays
                    # inside the cluster.
                    host: 0.0.0.0
                    port: 8888
      pipelines:
        metrics:
          receivers: [otlp]
          processors: [batch]
          exporters: [prometheus]
        logs:
          receivers: [otlp]
          processors: [batch]
          exporters: [otlp_http/loki]
        traces:
          receivers: [otlp]
          processors: [batch]
          exporters: [otlp/tempo]
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: otel-collector
  namespace: {{ k8s_observability_namespace }}
spec:
  # A DaemonSet since the Phase F drain (2026-08-13): every node carries its own
  # loopback OTLP listener, so a host's Claude Code always exports to 127.0.0.1:4317
  # locally — the property the Docker forwarder + ingest route existed to fake for
  # daniel-server. DaemonSet updates are delete-then-create per node, so the hostPort
  # deadlock that forced the old Deployment's Recreate strategy cannot occur.
  selector:
    matchLabels:
      app: otel-collector
  template:
    metadata:
      labels:
        app: otel-collector
    spec:
      enableServiceLinks: false
      automountServiceAccountToken: false
      containers:
        - name: otel-collector
          image: {{ claude_otel_collector_image }}
          args: ["--config=/conf/config.yaml"]
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
            readOnlyRootFilesystem: true
          ports:
            # hostPort + hostIP is what puts this on the NODE's loopback, which is where
            # Claude Code (a host process, not a container) exports to. A ClusterIP Service
            # alone would be unreachable from the host.
            #
            # hostIP 127.0.0.1 is load-bearing: without it the port binds 0.0.0.0 and the
            # collector — which receives prompts, responses and tool output verbatim —
            # becomes reachable from the LAN.
            - name: otlp-grpc
              containerPort: {{ claude_otel_otlp_port }}
              hostPort: {{ claude_otel_otlp_port }}
              hostIP: {{ claude_otel_otlp_host_ip }}
            - name: prom-export
              containerPort: 8889
            - name: self-metrics
              containerPort: 8888
            - name: health
              containerPort: 13133
          # The only pod in the stack without probes until 2026-08-13: a wedged collector
          # kept its hostPort bound and telemetry silently blackholed until a human noticed.
          readinessProbe:
            httpGet:
              path: /
              port: health
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: health
            initialDelaySeconds: 15
            periodSeconds: 30
          volumeMounts:
            - name: config
              mountPath: /conf
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: "1"
              memory: 512Mi
      volumes:
        - name: config
          configMap:
            name: otel-collector-config
---
apiVersion: v1
kind: Service
metadata:
  name: otel-collector
  namespace: {{ k8s_observability_namespace }}
spec:
  selector:
    app: otel-collector
  ports:
    - name: prom-export
      port: 8889
      targetPort: 8889
    - name: self-metrics
      port: 8888
      targetPort: 8888
    # (The D7 forwarder seam — an otlp-grpc Service port for the ingest IngressRoute —
    # dissolved 2026-08-13 with the DaemonSet conversion: every node has its own
    # loopback hostPort now, so nothing enters over the LAN.)
