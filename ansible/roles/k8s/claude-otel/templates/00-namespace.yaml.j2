---
# Named to sort first: the shared manifests role runs `kubectl apply -f <dir>/`, which
# applies in filename order, and every other object here is namespaced. Relying on
# "collector" happening to sort before "loki" would break the first time a file is renamed.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ k8s_observability_namespace }}
{% if k8s_psa_labels %}
  # Pod Security Admission, warn+audit only — see k8s_psa_labels in group_vars/all.yml for
  # why nothing is enforced here. Four workloads in this namespace publish a loopback
  # hostPort, so `enforce: baseline` would refuse loki, tempo, prometheus and the collector.
  labels:
{% for key, value in k8s_psa_labels.items() %}
    {{ key }}: {{ value }}
{% endfor %}
{% endif %}
{% if k8s_default_limitrange %}
---
# Default requests and limits for any container in this namespace that omits them. It lives in
# the namespace file, not one of its own, because it is a property OF the namespace and must be
# applied after it — and this file is the one guaranteed to sort first. Every container this
# role renders already sets both, so nothing here changes; see k8s_default_limitrange in
# group_vars/all.yml for what it is actually for, and why it sets no min/max.
apiVersion: v1
kind: LimitRange
metadata:
  name: default-container-limits
  namespace: {{ k8s_observability_namespace }}
spec:
  limits:
    - type: Container
      defaultRequest:
{% for key, value in k8s_default_limitrange.defaultRequest.items() %}
        {{ key }}: {{ value }}
{% endfor %}
      default:
{% for key, value in k8s_default_limitrange.default.items() %}
        {{ key }}: {{ value }}
{% endfor %}
{% endif %}
