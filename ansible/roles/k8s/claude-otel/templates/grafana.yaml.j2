---
apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-provisioning
  namespace: {{ k8s_observability_namespace }}
data:
  datasources.yaml: |
    apiVersion: 1
    datasources:
      - name: Prometheus
        uid: prometheus
        type: prometheus
        access: proxy
        url: http://prometheus:9090
        isDefault: true
        jsonData:
          httpMethod: POST
      - name: Loki
        uid: loki
        type: loki
        access: proxy
        url: http://loki:3100
      - name: Tempo
        uid: tempo
        type: tempo
        access: proxy
        url: http://tempo:3200
        jsonData:
          # Claude Code stamps trace_id/span_id onto its log events, so a span can jump
          # straight to the events emitted inside it. This is the pairing that makes traces
          # worth having: the span says a tool took 40s, the linked logs say which tool and
          # what it returned.
          tracesToLogsV2:
            datasourceUid: loki
            spanStartTimeShift: '-5m'
            spanEndTimeShift: '5m'
            filterByTraceID: true
            customQuery: false
          nodeGraph:
            enabled: true
      # --- Aliases carrying daniel-server's Grafana uids (slice 3, B4) ------------------
      # Every dashboard in roles/containers/grafana/files/dashboards references its datasource
      # by UID — `EGdsQqhVk` and `bf4q19tuivta8e`, baked into each panel; none references one by
      # NAME, so these aliases are free to be named whatever reads clearly. D6's lever is that a
      # matching uid makes all of them work here with no edit at all.
      #
      # ADDITIVE rather than renaming the two above. The two cluster-native uids are still in
      # use — `prometheus` is the default datasource and `loki` is what the Tempo datasource's
      # tracesToLogsV2 points at — so retagging rather than adding would break both. Two
      # datasources over one backend costs nothing.
      #
      # Names must differ from the two above: Grafana keys update-vs-insert on orgId+name, so
      # reusing `Prometheus` would UPDATE that datasource's uid rather than insert a second.
      # (`loki` vs `Loki` already differ, but only by case — spelled out to keep it obvious.)
      - name: Prometheus (daniel-server uid)
        uid: EGdsQqhVk
        type: prometheus
        access: proxy
        url: http://prometheus:9090
        jsonData:
          httpMethod: POST
          # Load-bearing, and the reason to have a second datasource rather than one shared:
          # daniel-server's series are scraped at 1m, this cluster's at 15s. Grafana derives
          # $__rate_interval from this, and at the 15s default every rate() panel over
          # 1m-scraped data returns EMPTY — which in B4 would read as "missing series" and be
          # recorded as a migration gap that is really a datasource setting. The cluster-native
          # datasource above correctly leaves it unset.
          timeInterval: "1m"
      - name: loki
        uid: bf4q19tuivta8e
        type: loki
        access: proxy
        url: http://loki:3100
  dashboards.yaml: |
    apiVersion: 1
    providers:
      # Every board, from roles/containers/grafana/files/dashboards — one provider, because
      # foldersFromFilesStructure derives the Grafana folder from the directory name and so
      # reproduces the AI/Apps/Infrastructure/Logs/Networking/Security layout without naming any
      # of them here. The Claude Code board had its own provider until the two copies were
      # reconciled (2026-08-07); it now arrives through this one like everything else, which is
      # why it moved from the "Claude Code" folder to "AI".
      - name: homelab
        orgId: 1
        type: file
        disableDeletion: false
        updateIntervalSeconds: 30
        allowUiUpdates: true
        options:
          path: /var/lib/grafana/dashboards/homelab
          foldersFromFilesStructure: true
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: grafana-data
  namespace: {{ k8s_observability_namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ claude_otel_storage_class }}
  resources:
    requests:
      storage: {{ claude_otel_grafana_storage }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: grafana
  namespace: {{ k8s_observability_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate  # ReadWriteOnce PVC — see the note on the loki Deployment
  selector:
    matchLabels:
      app: grafana
  template:
    metadata:
      labels:
        app: grafana
    spec:
      enableServiceLinks: false
      securityContext:
        runAsUser: 472
        runAsGroup: 472
        fsGroup: 472
      containers:
        - name: grafana
          image: {{ claude_otel_grafana_image }}
          env:
            - name: GF_SECURITY_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: grafana-admin
                  key: password
            # Authelia already authenticates every request reaching this route, but the
            # login page stays on: the forward-auth middleware is the only thing in front,
            # and a Grafana with anonymous admin would be wide open to anything that ever
            # reaches it in-cluster.
            - name: GF_USERS_ALLOW_SIGN_UP
              value: "false"
            - name: GF_ANALYTICS_REPORTING_ENABLED
              value: "false"
            - name: GF_ANALYTICS_CHECK_FOR_UPDATES
              value: "false"
          ports:
            - name: http
              containerPort: 3000
          volumeMounts:
            - name: provisioning-datasources
              mountPath: /etc/grafana/provisioning/datasources
            - name: provisioning-dashboards
              mountPath: /etc/grafana/provisioning/dashboards
{% for folder in claude_otel_dashboard_folders %}
            - name: dashboards-{{ folder | lower }}
              mountPath: /var/lib/grafana/dashboards/homelab/{{ folder }}
{% endfor %}
            - name: data
              mountPath: /var/lib/grafana
          readinessProbe:
            httpGet:
              path: /api/health
              port: 3000
            initialDelaySeconds: 20
            periodSeconds: 10
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              cpu: "1"
              memory: 512Mi
      volumes:
        # The provisioning ConfigMap carries both files, but they mount at different paths,
        # so it is projected twice with a subPath-style item selector rather than mounted
        # whole — a whole-ConfigMap mount would put datasources.yaml into the dashboards
        # provisioning directory, where Grafana tries to parse it as a dashboard provider.
        - name: provisioning-datasources
          configMap:
            name: grafana-provisioning
            items:
              - key: datasources.yaml
                path: datasources.yaml
        - name: provisioning-dashboards
          configMap:
            name: grafana-provisioning
            items:
              - key: dashboards.yaml
                path: dashboards.yaml
        # One ConfigMap per dashboard folder, not one for all of them. A ConfigMap is capped at
        # 1 MiB and the ported set is ~730 KB, with Infrastructure alone at 538 KB — a single
        # object would fit today and silently stop fitting the first time a large board is
        # added. These are built from the JSON files by the role's tasks (see
        # dashboards.yml), not templated, because the JSON carries no Jinja and inlining
        # 730 KB into a template would be unreadable.
{% for folder in claude_otel_dashboard_folders %}
        - name: dashboards-{{ folder | lower }}
          configMap:
            name: grafana-dashboards-{{ folder | lower }}
{% endfor %}
        - name: data
          persistentVolumeClaim:
            claimName: grafana-data
---
apiVersion: v1
kind: Service
metadata:
  name: grafana
  namespace: {{ k8s_observability_namespace }}
spec:
  selector:
    app: grafana
  ports:
    - name: http
      port: 3000
      targetPort: 3000
