{% from 'security-context.yml.j2' import hardened_security_context with context %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: tempo-config
  namespace: {{ k8s_observability_namespace }}
data:
  config.yaml: |
    server:
      http_listen_port: 3200
    distributor:
      receivers:
        otlp:
          protocols:
            grpc:
              # In-cluster only. No hostPort here: Claude Code exports everything to the
              # collector, which fans out — nothing sends spans to Tempo directly.
              endpoint: 0.0.0.0:4317
    # No `ingester:` block. Tempo 3.0 removed the ingester module outright, and the override
    # that used to live here is obsolete rather than relocated: it set max_block_duration to 5m
    # against a 30m default, so a span was queryable minutes after the turn that produced it.
    # The 3.0 live-store cuts blocks every 30s by default, which serves that intent better than
    # the override did. Setting live_store.max_block_duration would only make it slower.
    #
    # `backend_scheduler:` replaces `compactor:`. The nesting is not a typo — `provider.compaction`
    # is the compaction JOB config, and the `compaction` inside it is the compaction SETTINGS
    # block. Getting the path wrong is silent: retention falls back to its 336h default, halving
    # this window to a fortnight with nothing logged. Verified after deploying by reading
    # block_retention back from Tempo's own /status/config.
    backend_scheduler:
      provider:
        compaction:
          compaction:
            block_retention: {{ claude_otel_tempo_retention }}
    # Set on the worker too. 3.0 splits compaction across a scheduler that decides which blocks
    # to act on and a worker that executes the jobs, and each carries its own copy of the
    # compaction settings — setting only the scheduler left the worker reading the 336h default,
    # confirmed by finding both values live in /status/config after the first deploy. Which of
    # the two governs deletion is not worth resolving from docs when the failure mode is a
    # silent halving of the window: pin both to the same value and the question cannot arise.
    backend_worker:
      compaction:
        block_retention: {{ claude_otel_tempo_retention }}
    storage:
      trace:
        backend: local
        local:
          path: /var/tempo/blocks
        wal:
          path: /var/tempo/wal
    # Tempo posts anonymous usage stats to grafana.com by default. Nothing in this stack
    # reaches the internet by design; opt out rather than leave it on.
    usage_report:
      reporting_enabled: false
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: tempo-data
  namespace: {{ k8s_observability_namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ claude_otel_storage_class }}
  resources:
    requests:
      storage: {{ claude_otel_tempo_storage }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: tempo
  namespace: {{ k8s_observability_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  strategy:
    type: Recreate  # ReadWriteOnce PVC — see the note on the loki Deployment
  selector:
    matchLabels:
      app: tempo
  template:
    metadata:
      labels:
        app: tempo
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      securityContext:
        # The compose bundle needs a `tempo-init` sidecar that runs `chown -R 10001:10001
        # /var/tempo` before Tempo starts. k8s does that natively: the kubelet applies fsGroup
        # ownership to the volume at mount time, so the init container has no equivalent here.
        #
        # fsGroup ORs group bits onto everything on the volume, which bit Traefik's acme.json
        # (it requires 0600 and refuses group-readable). Tempo wants group ownership, so this
        # is the case fsGroup is for.
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
      automountServiceAccountToken: false
      containers:
        - name: tempo
          image: {{ claude_otel_tempo_image }}
          args: ["-config.file=/etc/tempo/config.yaml"]
{{ hardened_security_context(non_root=true) }}
          ports:
            - name: http
              containerPort: 3200
              # On the node's loopback so otelq can reach it; see
              # claude_otel_query_host_ip in defaults/main.yml.
              hostPort: 3200
              hostIP: {{ claude_otel_query_host_ip }}
            - name: otlp-grpc
              containerPort: 4317
          volumeMounts:
            - name: tempo-config
              mountPath: /etc/tempo
            - name: tempo-data
              mountPath: /var/tempo
          readinessProbe:
            httpGet:
              path: /ready
              port: 3200
            initialDelaySeconds: 20
            periodSeconds: 10
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              cpu: "1"
              memory: 1Gi
      volumes:
        - name: tempo-config
          configMap:
            name: tempo-config
        - name: tempo-data
          persistentVolumeClaim:
            claimName: tempo-data
---
apiVersion: v1
kind: Service
metadata:
  name: tempo
  namespace: {{ k8s_observability_namespace }}
spec:
  # Pinned: host-side query tools carry this address as a constant. See
  # claude_otel_tempo_cluster_ip in defaults/main.yml for why.
  clusterIP: {{ claude_otel_tempo_cluster_ip }}
  selector:
    app: tempo
  ports:
    - name: http
      port: 3200
      targetPort: 3200
    - name: otlp-grpc
      port: 4317
      targetPort: 4317
