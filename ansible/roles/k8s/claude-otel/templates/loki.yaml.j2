---
apiVersion: v1
kind: ConfigMap
metadata:
  name: loki-config
  namespace: {{ k8s_observability_namespace }}
data:
  loki.yaml: |
    auth_enabled: false
    # Loki's usage reporter defaults to on and POSTs to stats.grafana.org, which Pi-hole
    # blocks. Every 4h cycle then burns its whole 5-retry budget (an A plus an AAAA lookup
    # per attempt) against a name that never resolves, so the only product is DNS noise.
    # The key is analytics.reporting_enabled -- Tempo's is usage_report.reporting_enabled,
    # and Loki rejects an unknown config field at startup rather than ignoring it.
    analytics:
      reporting_enabled: false
    server:
      http_listen_port: 3100
      grpc_listen_port: 9096
      log_level: warn
    common:
      instance_addr: 127.0.0.1
      path_prefix: /loki
      storage:
        filesystem:
          chunks_directory: /loki/chunks
          rules_directory: /loki/rules
      replication_factor: 1
      ring:
        kvstore:
          store: inmemory
    schema_config:
      configs:
        - from: 2024-01-01
          store: tsdb
          object_store: filesystem
          schema: v13
          index:
            prefix: index_
            period: 24h
    limits_config:
      retention_period: {{ claude_otel_loki_retention }}
      # Claude Code sends whole prompts and responses as single log lines. The default 256KB
      # cap silently drops anything larger, which would lose exactly the long turns most worth
      # keeping — and a dropped line is invisible unless you go looking for it.
      max_line_size: 2MB
      reject_old_samples: false
      allow_structured_metadata: true
    compactor:
      working_directory: /loki/compactor
      # Without retention_enabled the retention_period above is inert: Loki accepts the
      # setting and never deletes anything, so the volume grows without bound.
      retention_enabled: true
      delete_request_store: filesystem
    ruler:
      storage:
        type: local
        local:
          directory: /loki/rules
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: loki-data
  namespace: {{ k8s_observability_namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ claude_otel_storage_class }}
  resources:
    requests:
      storage: {{ claude_otel_loki_storage }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: loki
  namespace: {{ k8s_observability_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  strategy:
    # The PVC is ReadWriteOnce on a single node: a rolling update would leave the new pod
    # Pending on a volume the old one still holds, and the rollout would wait forever.
    type: Recreate
  selector:
    matchLabels:
      app: loki
  template:
    metadata:
      labels:
        app: loki
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      securityContext:
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
      automountServiceAccountToken: false
      containers:
        - name: loki
          image: {{ claude_otel_loki_image }}
          args: ["-config.file=/etc/loki/loki.yaml"]
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            capabilities:
              drop: [ALL]
          ports:
            - name: http
              containerPort: 3100
              # On the node's loopback so otelq can reach it; see
              # claude_otel_query_host_ip in defaults/main.yml.
              hostPort: 3100
              hostIP: {{ claude_otel_query_host_ip }}
          volumeMounts:
            - name: loki-config
              mountPath: /etc/loki
            - name: loki-data
              mountPath: /loki
          readinessProbe:
            httpGet:
              path: /ready
              port: 3100
            initialDelaySeconds: 20
            periodSeconds: 10
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              cpu: "1"
              memory: 1Gi
      volumes:
        - name: loki-config
          configMap:
            name: loki-config
        - name: loki-data
          persistentVolumeClaim:
            claimName: loki-data
---
apiVersion: v1
kind: Service
metadata:
  name: loki
  namespace: {{ k8s_observability_namespace }}
spec:
  # Pinned: host-side query tools carry this address as a constant. See
  # claude_otel_loki_cluster_ip in defaults/main.yml for why.
  clusterIP: {{ claude_otel_loki_cluster_ip }}
  selector:
    app: loki
  ports:
    - name: http
      port: 3100
      targetPort: 3100
