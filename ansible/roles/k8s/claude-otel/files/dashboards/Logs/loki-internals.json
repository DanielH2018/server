          "uid": "bf4q19tuivta8e"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "name": "Deploys",
        "target": {
          "expr": "{job=\"syslog\"} |= \"event=deploy\" | logfmt",
          "queryType": "range",
          "refId": "DeployAnno"
        },
        "textFormat": "{{services}}",
        "titleFormat": "deploy"
      }
