{
  "uid": "valheim-player-stats",
  "title": "Valheim — Player Stats",
  "tags": ["homelab", "valheim", "game"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-30d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Players Online",
      "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "valheim_players_online",
          "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Deaths",
      "description": "All-time, across every player. Valheim's console emits deaths; Terraria's does not, so this panel has no counterpart on the Terraria board.",
      "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "valheim_deaths_total",
          "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" }
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Leaderboard",
      "description": "Deaths are attributed by character name straight off the death line, so they stay correct even if a handshake was missed. Playtime depends on the SteamID→name binding and is the softer number of the two.",
      "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" },
      "gridPos": { "h": 10, "w": 16, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": { "custom": {} },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Playtime" },
            "properties": [{ "id": "unit", "value": "s" }]
          },
          {
            "matcher": { "id": "byName", "options": "Deaths" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "player", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "player": "Player",
              "Value #Playtime": "Playtime",
              "Value #Sessions": "Sessions",
              "Value #Deaths": "Deaths"
            },
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "Playtime",
          "format": "table",
          "instant": true,
          "expr": "valheim_player_playtime_seconds_total",
          "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" }
        },
        {
          "refId": "Sessions",
          "format": "table",
          "instant": true,
          "expr": "valheim_player_sessions_total",
          "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" }
        },
        {
          "refId": "Deaths",
          "format": "table",
          "instant": true,
          "expr": "valheim_player_deaths_total",
          "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Deaths (per player, cumulative)",
      "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "refId": "A",
          "expr": "valheim_player_deaths_total",
          "legendFormat": "{{player}}",
          "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Playtime Accrual (per player)",
      "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "refId": "A",
          "expr": "valheim_player_playtime_seconds_total",
          "legendFormat": "{{player}}",
          "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Players Online — derived vs. server-reported",
      "description": "Two independent numbers. 'derived' comes from the session state machine; 'server heartbeat' is what Valheim itself reports every ~10 min. A persistent gap means the session logic has drifted from reality — that is the point of showing both, and it is the cheapest check on parsing that could not be validated before the first real session.",
      "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "targets": [
        {
          "refId": "A",
          "expr": "valheim_players_online",
          "legendFormat": "derived (sessions)",
          "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" }
        },
        {
          "refId": "B",
          "expr": "valheim_connections",
          "legendFormat": "server heartbeat",
          "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Parser Health (unmatched lines/min)",
      "description": "Non-zero means the console emitted something player-shaped that did not parse — i.e. upstream changed its wording. Expect a flat zero; a step up here alongside frozen player metrics is the signature of a format change.",
      "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(valheim_stats_unmatched_player_lines_total[5m]) * 60",
          "legendFormat": "unmatched/min",
          "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" }
        }
      ]
    }
  ]
}
