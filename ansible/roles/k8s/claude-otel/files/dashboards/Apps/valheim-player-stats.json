        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "name": "Deploys",
        "target": {
          "expr": "{job=\"syslog\"} |= \"event=deploy\" | logfmt",
          "queryType": "range",
          "refId": "DeployAnno"
        },
        "textFormat": "{{services}}",
        "titleFormat": "deploy"
      }
    ]
  },
  "id": null,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "EGdsQqhVk"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "EGdsQqhVk"
          },
          "expr": "valheim_players_online",
          "refId": "A"
        }
      ],
      "title": "Players Online",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "EGdsQqhVk"
      },
      "description": "All-time, across every player. Valheim's console emits deaths; Terraria's does not, so this panel has no counterpart on the Terraria board.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "red",
            "mode": "fixed"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "EGdsQqhVk"
          },
          "expr": "valheim_deaths_total",
          "refId": "A"
        }
      ],
      "title": "Total Deaths",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "EGdsQqhVk"
      },
      "description": "Deaths are attributed by character name straight off the death line, so they stay correct even if a handshake was missed. Playtime depends on the SteamID\u2192name binding and is the softer number of the two.",
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Playtime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Deaths"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 8,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "EGdsQqhVk"
          },
          "expr": "valheim_player_playtime_seconds_total",
          "format": "table",
          "instant": true,
          "refId": "Playtime"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "EGdsQqhVk"
          },
          "expr": "valheim_player_sessions_total",
          "format": "table",
          "instant": true,
          "refId": "Sessions"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "EGdsQqhVk"
          },
          "expr": "valheim_player_deaths_total",
          "format": "table",
          "instant": true,
          "refId": "Deaths"
        }
      ],
      "title": "Leaderboard",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "player",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "job 3": true
            },
            "renameByName": {
              "Value #Deaths": "Deaths",
              "Value #Playtime": "Playtime",
              "Value #Sessions": "Sessions",
              "player": "Player"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "EGdsQqhVk"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "id": 4,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "EGdsQqhVk"
          },
          "expr": "valheim_player_deaths_total",
          "legendFormat": "{{player}}",
          "refId": "A"
        }
      ],
      "title": "Deaths (per player, cumulative)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "EGdsQqhVk"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "id": 5,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "EGdsQqhVk"
          },
          "expr": "valheim_player_playtime_seconds_total",
          "legendFormat": "{{player}}",
          "refId": "A"
        }
      ],
      "title": "Playtime Accrual (per player)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "EGdsQqhVk"
      },
      "description": "Two independent numbers. 'derived' comes from the session state machine; 'server heartbeat' is what Valheim itself reports every ~10 min. A persistent gap means the session logic has drifted from reality \u2014 that is the point of showing both, and it is the cheapest check on parsing that could not be validated before the first real session.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "id": 6,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "EGdsQqhVk"
          },
          "expr": "valheim_players_online",
          "legendFormat": "derived (sessions)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "EGdsQqhVk"
          },
          "expr": "valheim_connections",
          "legendFormat": "server heartbeat",
          "refId": "B"
        }
      ],
      "title": "Players Online \u2014 derived vs. server-reported",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "EGdsQqhVk"
      },
      "description": "Non-zero means the console emitted something player-shaped that did not parse \u2014 i.e. upstream changed its wording. Expect a flat zero; a step up here alongside frozen player metrics is the signature of a format change.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "id": 7,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "EGdsQqhVk"
          },
          "expr": "rate(valheim_stats_unmatched_player_lines_total[5m]) * 60",
          "legendFormat": "unmatched/min",
          "refId": "A"
        }
      ],
      "title": "Parser Health (unmatched lines/min)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
