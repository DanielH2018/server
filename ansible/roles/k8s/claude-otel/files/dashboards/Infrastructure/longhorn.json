{
  "uid": "longhorn-storage",
  "title": "Longhorn — Storage",
  "tags": ["homelab", "storage", "longhorn"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    { "id": 1, "type": "row", "title": "Capacity & Headroom", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    { "id": 2, "type": "gauge", "title": "Disk used %, per node",
      "description": "longhorn_disk_usage_bytes / longhorn_disk_capacity_bytes per node's Longhorn disk. Each node currently carries exactly one disk, so this is also the node's headroom.",
      "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 } ] } },
        "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "targets": [ { "refId": "A", "expr": "100 * longhorn_disk_usage_bytes / longhorn_disk_capacity_bytes", "legendFormat": "{{node}}",
        "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" } } ] },
    { "id": 3, "type": "timeseries", "title": "Disk used vs capacity, per node",
      "description": "longhorn_disk_usage_bytes (solid) against longhorn_disk_capacity_bytes (the ceiling) — the trend line for headroom running out.",
      "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [
        { "matcher": { "id": "byRegexp", "options": "/capacity/" },
          "properties": [ { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } } ] } ] },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "longhorn_disk_usage_bytes", "legendFormat": "{{node}} used",
          "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" } },
        { "refId": "B", "expr": "longhorn_disk_capacity_bytes", "legendFormat": "{{node}} capacity",
          "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" } } ] },
    { "id": 4, "type": "row", "title": "Volumes", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 } },
    { "id": 5, "type": "bargauge", "title": "Top volumes by actual size",
      "description": "longhorn_volume_actual_size_bytes, top 10 of 43 tracked volumes. Legend is the PVC name (the volume label is the PV's UUID and not legible on its own).",
      "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "gradient" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 10 },
      "targets": [ { "refId": "A", "expr": "topk(10, longhorn_volume_actual_size_bytes)", "legendFormat": "{{pvc}}", "instant": true,
        "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" } } ] },
    { "id": 6, "type": "stat", "title": "Healthy",
      "description": "longhorn_volume_robustness is one-hot over a state label (healthy/degraded/faulted/unknown), 4 series per volume — this sums only the healthy series, which equals a count. A steady 0 on the degraded/faulted panels is the all-clear reading, not a no-data gap.",
      "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" },
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 19 },
      "targets": [ { "refId": "A", "expr": "sum(longhorn_volume_robustness{state=\"healthy\"})", "legendFormat": "healthy",
        "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" } } ] },
    { "id": 7, "type": "stat", "title": "Degraded",
      "description": "0 here means no volume is running short a replica right now — read it as healthy, not as missing data.",
      "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" },
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 19 },
      "targets": [ { "refId": "A", "expr": "sum(longhorn_volume_robustness{state=\"degraded\"})", "legendFormat": "degraded",
        "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" } } ] },
    { "id": 8, "type": "stat", "title": "Faulted",
      "description": "0 here means no volume has lost all its replicas — read it as healthy, not as missing data.",
      "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" },
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 19 },
      "targets": [ { "refId": "A", "expr": "sum(longhorn_volume_robustness{state=\"faulted\"})", "legendFormat": "faulted",
        "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" } } ] },
    { "id": 9, "type": "stat", "title": "Unknown",
      "description": "Robustness reads unknown while a volume is detached (no engine running to report health) — this is normal for volumes attached only intermittently, not a fault.",
      "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" },
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 19 },
      "targets": [ { "refId": "A", "expr": "sum(longhorn_volume_robustness{state=\"unknown\"})", "legendFormat": "unknown",
        "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" } } ] },
    { "id": 10, "type": "row", "title": "Snapshots & Backups", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 } },
    { "id": 11, "type": "bargauge", "title": "Top volumes by retained snapshot size",
      "description": "sum by (volume) (longhorn_snapshot_actual_size_bytes) — retained snapshots are what makes the nightly trim reclaim nothing even though old data is logically gone. This metric carries no pvc label, so the legend is the volume's PV UUID.",
      "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "gradient" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "targets": [ { "refId": "A", "expr": "topk(8, sum by (volume) (longhorn_snapshot_actual_size_bytes))", "legendFormat": "{{volume}}", "instant": true,
        "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" } } ] },
    { "id": 12, "type": "timeseries", "title": "Backup uploaded bytes (retained set)",
      "description": "sum(longhorn_backup_uploaded_data_size_bytes) — the delta each retained backup object transferred to the target, summed across every backup Longhorn still has a record of. Steps as daily-backup runs and retention rotates old backups out; it is not a running cumulative total.",
      "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "targets": [ { "refId": "A", "expr": "sum(longhorn_backup_uploaded_data_size_bytes)", "legendFormat": "uploaded (retained backups)",
        "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" } } ] },
    { "id": 13, "type": "stat", "title": "Volumes with a backup on record",
      "description": "count(longhorn_volume_last_backup_at > 0) of 43 tracked volumes. The B2 backup target is currently disarmed, so the other volumes reading 0 is a deliberate condition, not a failure — this panel is scoped to volumes that have ever completed a backup rather than showing a raw 29-zero 'stale backup' alarm.",
      "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" },
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 34 },
      "targets": [ { "refId": "A", "expr": "count(longhorn_volume_last_backup_at > 0)", "legendFormat": "volumes ever backed up",
        "datasource": { "type": "prometheus", "uid": "EGdsQqhVk" } } ] }
  ]
}
