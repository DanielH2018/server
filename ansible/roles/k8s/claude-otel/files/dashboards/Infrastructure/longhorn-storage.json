      },
      "id": 16,
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "bf4q19tuivta8e"
          },
          "expr": "avg(avg_over_time({container=\"monitor-bridge\"} |= \"B2 storage\" | regexp `B2 storage (?P<used_gb>[0-9.]+) GB of (?P<cap_gb>[0-9.]+) GB \\((?P<pct>[0-9]+)%\\), (?P<versions>[0-9]+) versions` | unwrap pct [$__auto]))",
          "legendFormat": "used",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "B2 cap used %",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "bf4q19tuivta8e"
      },
      "description": "Object versions in the bucket. A prune's cost is per DELETED backup, and lifecycle clears hidden versions after 7 days — so a rising count with flat bytes is retention accumulating, which is the shape that precedes a cap breach.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 49
      },
      "id": 17,
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "bf4q19tuivta8e"
          },
          "expr": "avg(avg_over_time({container=\"monitor-bridge\"} |= \"B2 storage\" | regexp `B2 storage (?P<used_gb>[0-9.]+) GB of (?P<cap_gb>[0-9.]+) GB \\((?P<pct>[0-9]+)%\\), (?P<versions>[0-9]+) versions` | unwrap versions [$__auto]))",
          "legendFormat": "versions",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "B2 object versions",
      "type": "timeseries"
