        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "name": "Deploys",
        "target": {
          "expr": "{job=\"syslog\"} |= \"event=deploy\" | logfmt",
          "queryType": "range",
          "refId": "DeployAnno"
        },
        "textFormat": "{{services}}",
        "titleFormat": "deploy"
      }
    ]
  },
  "id": null,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Capacity & Headroom",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "EGdsQqhVk"
      },
      "description": "longhorn_disk_usage_bytes / longhorn_disk_capacity_bytes per node's Longhorn disk. Each node currently carries exactly one disk, so this is also the node's headroom.",
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "EGdsQqhVk"
          },
          "expr": "100 * longhorn_disk_usage_bytes / longhorn_disk_capacity_bytes",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "title": "Disk used %, per node",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "EGdsQqhVk"
      },
      "description": "longhorn_disk_usage_bytes (solid) against longhorn_disk_capacity_bytes (the ceiling) — the trend line for headroom running out.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/capacity/"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 1
      },
      "id": 3,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "EGdsQqhVk"
          },
          "expr": "longhorn_disk_usage_bytes",
          "legendFormat": "{{node}} used",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "EGdsQqhVk"
          },
          "expr": "longhorn_disk_capacity_bytes",
          "legendFormat": "{{node}} capacity",
          "refId": "B"
        }
      ],
      "title": "Disk used vs capacity, per node",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 4,
      "title": "Volumes",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "EGdsQqhVk"
      },
      "description": "longhorn_volume_actual_size_bytes, top 10 of 43 tracked volumes. Legend is the PVC name (the volume label is the PV's UUID and not legible on its own).",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "id": 5,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "EGdsQqhVk"
          },
          "expr": "topk(10, longhorn_volume_actual_size_bytes)",
          "instant": true,
          "legendFormat": "{{pvc}}",
          "refId": "A"
        }
      ],
      "title": "Top volumes by actual size",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "EGdsQqhVk"
      },
      "description": "longhorn_volume_robustness is one-hot over a state label (healthy/degraded/faulted/unknown), 4 series per volume — this sums only the healthy series, which equals a count. A steady 0 on the degraded/faulted panels is the all-clear reading, not a no-data gap.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "green",
            "mode": "fixed"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 19
      },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "EGdsQqhVk"
          },
          "expr": "sum(longhorn_volume_robustness{state=\"healthy\"})",
          "legendFormat": "healthy",
          "refId": "A"
        }
      ],
      "title": "Healthy",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "EGdsQqhVk"
      },
      "description": "0 here means no volume is running short a replica right now — read it as healthy, not as missing data.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 19
      },
      "id": 7,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "EGdsQqhVk"
          },
          "expr": "sum(longhorn_volume_robustness{state=\"degraded\"})",
          "legendFormat": "degraded",
          "refId": "A"
        }
      ],
      "title": "Degraded",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "EGdsQqhVk"
      },
      "description": "0 here means no volume has lost all its replicas — read it as healthy, not as missing data.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 19
      },
      "id": 8,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "EGdsQqhVk"
          },
          "expr": "sum(longhorn_volume_robustness{state=\"faulted\"})",
          "legendFormat": "faulted",
          "refId": "A"
        }
      ],
      "title": "Faulted",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "EGdsQqhVk"
      },
      "description": "Robustness reads unknown while a volume is detached (no engine running to report health) — this is normal for volumes attached only intermittently, not a fault.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 19
      },
      "id": 9,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "EGdsQqhVk"
          },
          "expr": "sum(longhorn_volume_robustness{state=\"unknown\"})",
          "legendFormat": "unknown",
          "refId": "A"
        }
