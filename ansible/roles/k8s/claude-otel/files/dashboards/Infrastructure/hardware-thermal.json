    {
      "id": 4,
      "type": "stat",
      "title": "Pi supply voltage",
      "description": "The Raspberry Pi firmware's own undervoltage alarm. 1 means the 5V supply fell below the critical threshold, which corrupts SD cards and stalls USB devices. Only daniel-pi reports this sensor.",
      "datasource": {
        "type": "prometheus",
        "uid": "EGdsQqhVk"
      },
      "gridPos": {
        "h": 6,
