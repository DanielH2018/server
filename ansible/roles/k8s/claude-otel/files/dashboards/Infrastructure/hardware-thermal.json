  "description": "Temperature, clock speed and thermal throttling for all three homelab hosts on one board. node-exporter's hwmon and thermal_zone collectors are the only source. daniel-pi scrapes under job=node-pi and the two cluster nodes under job=node, so no panel here filters on job.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CPU temperature",
      "description": "Hottest CPU-package sensor per host. The chip is coretemp on daniel-server (Intel), k10temp on daniel-box (AMD) and cpu_thermal on daniel-pi, so the query selects on chip_name rather than on a chip path that differs per host.",
      "datasource": {
        "type": "prometheus",
        "uid": "EGdsQqhVk"
      },
      "gridPos": {
        "h": 6,
        "w": 7,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 88
              }
            ]
          },
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "EGdsQqhVk"
          },
          "editorMode": "code",
          "expr": "max by (instance) (node_hwmon_temp_celsius{instance=~\"$instance\"} * on (instance, chip) group_left (chip_name) node_hwmon_chip_names{chip_name=~\"coretemp|k10temp|cpu_thermal\"})",
          "instant": false,
          "legendFormat": "{{instance}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
