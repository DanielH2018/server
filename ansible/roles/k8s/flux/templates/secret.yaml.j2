{#
  The two Secrets the notification Providers in sync.yaml.j2 read, then the break-glass public
  key (D6.11). The key's Secret holds the public half alone, so it is no secret, and normal
  operation reads it nowhere: the OCIRepository verifies keyless unless `flux_break_glass` is on. notification-controller
  reads a Provider's Secret through the API on each event, so a rotated value needs no
  controller restart, and every flux_controllers entry declares `restart_on: []`.
#}
---
apiVersion: v1
kind: Secret
metadata:
  name: flux-github-status
  namespace: {{ flux_namespace }}
type: Opaque
stringData:
  # A fine-grained token with Commit statuses read and write on this repository only.
  token: "{{ flux_github_status_token }}"
---
apiVersion: v1
kind: Secret
metadata:
  name: flux-discord
  namespace: {{ flux_namespace }}
type: Opaque
stringData:
  # The channel the GitOps deployer posts to. The `discord` Provider takes its address from
  # here and leaves `spec.address` empty, so the object the read-only identity reads holds no
  # webhook.
  address: "{{ gitops_deploy_discord_webhook }}"
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ flux_break_glass_secret }}
  namespace: {{ flux_namespace }}
type: Opaque
stringData:
  # source-controller reads every `*.pub` key of the Secret that `verify.secretRef` names.
  cosign.pub: |
{{ flux_break_glass_public_key | trim | indent(4, true) }}
