---
apiVersion: v1
kind: Secret
metadata:
  name: autokuma-credentials
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  username: "{{ uptime_kuma_username }}"
  # Consumed as a file mount, never an env — see the deployment's command comment.
  kuma_password: "{{ uptime_kuma_password }}"
  # Read by the status-page-sync CronJob's last container, which pushes the deadman heartbeat for
  # the "Status Page Sync" tile. Defaulted so a checkout without the secret renders an empty key
  # rather than failing the render: push_heartbeat.py skips the beat on an empty token, and the
  # tile is gated on the same variable in static-monitors.yaml.j2, so neither half sits red alone.
  status_page_sync_push_token: "{{ kuma_status_page_sync_push_token | default('') }}"
  # Read by the maintenance-sync CronJob's status stage, which reads Kuma's /metrics to leave a
  # monitor already DOWN out of the weekly window (#3506). Kuma's apiAuth accepts only an API key
  # once one exists, so this is the key Prometheus scrapes with. Defaulted like the token above:
  # an empty key keeps every monitor in the window, which is the window as it was before.
  metrics_api_key: "{{ prometheus_kuma_api_key | default('') }}"
