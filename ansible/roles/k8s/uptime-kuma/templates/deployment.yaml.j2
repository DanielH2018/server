{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: uptime-kuma
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  # Two RWO PVCs on single-replica Longhorn — a rolling update deadlocks on the volumes.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: uptime-kuma
  template:
    metadata:
      labels:
        app: uptime-kuma
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      # The pod is the first cluster workload probing `-k8s` LAN names. CoreDNS forwards to
      # the node's resolver, which deliberately uses public DNS (the A1 bootstrap posture),
      # and the PUBLIC wildcard *.local.<domain> answers the Docker edge .161 — so every
      # -k8s probe 404'd there. Pin exactly the cluster-served hostnames to the ingress
      # VIP, rendered from inventory so the list can't rot. Bridge monitors (unsuffixed
      # names) stay UNpinned on purpose: .161 is the path they exist to test.
      hostAliases:
        - ip: "{{ k3s_metallb_ingress_vip }}"
          hostnames:
{% for entry in hostvars[k8s_primary_node].containers_list | selectattr('hostname', 'defined') %}
            - "{{ entry.hostname }}.local.{{ domain }}"
{% for extra in entry.extra_hostnames | default([]) %}
            - "{{ extra }}.local.{{ domain }}"
{% endfor %}
{% endfor %}
      automountServiceAccountToken: false
      priorityClassName: homelab-best-effort
      # Preference, never a pin: daniel-box carries the storage- and VIP-pinned workloads and runs the hotter of the two nodes, so latency-insensitive services default here.
      # Weighted so the pod still schedules if daniel-server is cordoned or full.
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: uptime-kuma
          image: {{ uptime_kuma_k8s_image }}
          ports:
            - containerPort: 3001
          # The daniel-pi-host monitor is a real ICMP ping — compose parity.
{{ hardened_security_context(add=['NET_RAW']) }}
          volumeMounts:
            - name: uptime-kuma-data
              mountPath: /app/data
          # / answers 302 to /dashboard; kubelet counts 200-399 as success.
          startupProbe:
            httpGet:
              path: /
              port: 3001
            periodSeconds: 10
            failureThreshold: 18
          readinessProbe:
            httpGet:
              path: /
              port: 3001
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: 3001
            periodSeconds: 30
          # First true sidecar in the fleet, deliberately (KD4): recreating Kuma invalidates
          # AutoKuma's Socket.IO session, and a shared pod reproduces Docker's
          # `depends_on: {restart: true}` — a pod recreate cycles both.
{{ container_resources(cpu_limit=uptime_kuma_k8s_cpu_limit, mem_limit=uptime_kuma_k8s_mem_limit, cpu_request=uptime_kuma_k8s_cpu_request, mem_request=uptime_kuma_k8s_mem_request) }}
        - name: autokuma
          image: {{ autokuma_k8s_image }}
          env:
            - name: AUTOKUMA__KUMA__URL
              value: http://localhost:3001
            # The Kuma ADMIN password is read from a file mount rather than given inline (same
            # H1 discipline as the compose entrypoint wrapper): an env VALUE is visible to
            # anything that can read the pod spec or /proc, and this credential can silence the
            # whole fleet's alerting. `@/path` is AutoKuma's own file reference — it reads the
            # file and strips exactly one trailing newline (resolve_file_ref, kuma-client), so
            # the value never appears in the spec. Until 2026-08-21 the same effect needed a
            # `/usr/bin/sh -c 'export …; exec autokuma'` wrapper, which the rc-2 image cannot
            # run: its base is distroless, where the only shell is /busybox/sh.
            - name: AUTOKUMA__KUMA__PASSWORD
              value: "@/etc/autokuma/kuma_password"
            - name: AUTOKUMA__KUMA__USERNAME
              valueFrom:
                secretKeyRef:
                  name: autokuma-credentials
                  key: username
            # Docker source OFF (KD2): the socket this fleet's labels lived behind is
            # unreachable from the cluster by design (Security M1).
            - name: AUTOKUMA__DOCKER__ENABLED
              value: "false"
            - name: AUTOKUMA__STATIC_MONITORS
              value: /monitors
            # Secret volumes surface every file as a symlink into ..data/, and AutoKuma
            # skips symlinks by default — without this the static source silently reads an
            # empty directory (masked by on_delete=keep; caught when a file edit never
            # reached the live monitor, 2026-08-10).
            - name: AUTOKUMA__FILES__FOLLOW_SYMLINKS
              value: "true"
            - name: AUTOKUMA__DB_PATH
              value: /data/autokuma.db
            # Seconds between reconcile passes. AutoKuma's own default is 5, and the declaration
            # source is a Secret that only changes on a deploy — so 59 of every 60 passes existed
            # to notice nothing. Raised to 60 on 2026-08-21.
            #
            # The cadence was not the whole problem. AutoKuma updates an entity whenever
            # `current != merge(current, declared)` (sync.rs), and for BOTH notification objects
            # that comparison never settled: the sidecar rewrote discord and email every pass,
            # 716 times per 30 minutes, ~34k SQLite writes a day onto a Longhorn volume whose
            # changed blocks the nightly backup then ships. Cutting the interval to 60 reduced
            # that 12x without ending it. The cause was a missing `applyExisting` key in the
            # declared notification configs — see the comment above them in
            # static-monitors.yaml.j2 — and fixing that is what made the loop converge.
            - name: AUTOKUMA__SYNC_INTERVAL
              value: "{{ autokuma_k8s_sync_interval }}"
            # Flipped keep → delete 2026-08-10 after the transcription ledger closed:
            # every one of the 77 live monitors has a static-monitors declaration
            # (audited name-by-name against `kuma-cli monitor list`; the only file-only
            # entries are the two notification objects). From here, removing an entity's
            # .json file DELETES the live monitor and its history — that is the intended
            # semantic; the interim `keep` existed only while declarations still sat as
            # inert labels on Docker composes this instance can't read.
            #
            # A variable rather than a literal so that a risky sidecar upgrade can be deployed
            # once with `-e autokuma_k8s_on_delete=keep`, checked, and then redeployed at the
            # committed default. Only `keep` is safe to pass that way — it is the value that
            # cannot destroy history.
            - name: AUTOKUMA__ON_DELETE
              value: {{ autokuma_k8s_on_delete }}
          # Per-container, not pod-level: the uptime-kuma container in this same pod
          # runs as root and cannot carry this assertion.
{{ hardened_security_context(read_only=true, non_root=true, run_as_user=1000, run_as_group=1000) }}
          volumeMounts:
            - name: autokuma-data
              mountPath: /data
            - name: uptime-kuma-static-monitors
              mountPath: /monitors
              readOnly: true
            # NOT /run/secrets — that shadows the ServiceAccount token projection and the
            # container never starts (the guarded 2026-08-02 trap).
            - name: uptime-kuma-credentials
              mountPath: /etc/autokuma
              readOnly: true
          # /health answers 200 only while the last reconcile finished within sync_interval * 3
          # (autokuma/src/server.rs), so this is a liveness signal about the reconcile loop, not
          # about the process — the `grep autokuma /proc/1/comm` check it replaced on 2026-08-21
          # stayed green through a sidecar that had stopped syncing entirely.
          #
          # is_healthy() returns false while last_sync_timestamp is still unset, so /health serves
          # 503 from container start until the first reconcile pass reports. That allowance is now
          # `initialDelaySeconds: 300` on the liveness probe, where until 2026-09-06 it was a
          # startupProbe of 30 x 10s. Same 300s, and steady-state detection is unchanged at
          # 3 x 30s — but a startupProbe ALSO held the pod NotReady for as long as it ran, and
          # pod Ready is the AND of both containers. That gated the uptime-kuma Service on this
          # sidecar's first reconcile: a measured 76s of uptime-kuma serving with no Service
          # endpoint, on every pod replacement, six of them in the 48h to 2026-09-06 (#1348).
          #
          # Most of that 76s was not the reconcile. The first connect failed 0.13s in because
          # Kuma was not listening yet; kuma-client then spends a hardcoded 9.0s waiting for
          # readiness (`for i in 0..10 { sleep(200ms * i) }`, client.rs at the pinned
          # v2.1.0-rc.2 — 200 * 45 = 9000ms, matching a measured 9.012s) and the sync loop sleeps
          # a full AUTOKUMA__SYNC_INTERVAL before retrying. So ~60 of the 76s was that sleep.
          # AUTOKUMA__KUMA__CONNECT_TIMEOUT cannot shorten it: the loop reads no config value.
          #
          # DECIDED: no readinessProbe here, and none is possible. Pod Ready is the AND of all
          # containers, so any readinessProbe on /health re-creates exactly the 76s Service gap
          # this change removed — the same reason recorded for this container in
          # ansible/tests/k8s/test_readiness_coverage.py. The cost of the swap is that
          # initialDelaySeconds is a fixed grace where a startupProbe was adaptive: a container
          # that never becomes healthy is now killed at ~360s rather than ~300s. Liveness here
          # protects a reconcile loop whose death breaks no monitoring, so 60s is affordable.
          livenessProbe:
            httpGet:
              path: /health
              port: 8090
            initialDelaySeconds: 300
            periodSeconds: 30
            failureThreshold: 3
{{ container_resources(cpu_limit=autokuma_k8s_cpu_limit, mem_limit=autokuma_k8s_mem_limit, cpu_request=autokuma_k8s_cpu_request, mem_request=autokuma_k8s_mem_request) }}
      volumes:
        - name: uptime-kuma-data
          persistentVolumeClaim:
            claimName: {{ uptime_kuma_k8s_claim }}
        - name: autokuma-data
          persistentVolumeClaim:
            claimName: {{ uptime_kuma_k8s_autokuma_claim }}
        - name: uptime-kuma-static-monitors
          secret:
            secretName: kuma-static-monitors
        - name: uptime-kuma-credentials
          secret:
            secretName: autokuma-credentials
            # 444, not 400: secret-volume files are root-owned (no fsGroup — it would
            # recursively chown the data PVC on every mount) and autokuma is uid 1000, so
            # 400 reads as an empty password and Kuma rejects the login. Pod-scoped
            # exposure only, and the kuma container is root anyway.
            defaultMode: 0o444
