---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: uptime-kuma
  namespace: {{ k8s_namespace }}
spec:
  replicas: 1
  # Two RWO PVCs on single-replica Longhorn — a rolling update deadlocks on the volumes.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: uptime-kuma
  template:
    metadata:
      labels:
        app: uptime-kuma
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      # The pod is the first cluster workload probing `-k8s` LAN names. CoreDNS forwards to
      # the node's resolver, which deliberately uses public DNS (the A1 bootstrap posture),
      # and the PUBLIC wildcard *.local.<domain> answers the Docker edge .161 — so every
      # -k8s probe 404'd there. Pin exactly the cluster-served hostnames to the ingress
      # VIP, rendered from inventory so the list can't rot. Bridge monitors (unsuffixed
      # names) stay UNpinned on purpose: .161 is the path they exist to test.
      hostAliases:
        - ip: "{{ k3s_metallb_ingress_vip }}"
          hostnames:
{% for entry in hostvars['daniel-box'].containers_list | selectattr('hostname', 'defined') %}
            - "{{ entry.hostname }}.local.{{ domain }}"
{% for extra in entry.extra_hostnames | default([]) %}
            - "{{ extra }}.local.{{ domain }}"
{% endfor %}
{% endfor %}
      automountServiceAccountToken: false
      priorityClassName: homelab-best-effort
      # Preference, never a pin: daniel-box carries the storage- and VIP-pinned workloads and runs the hotter of the two nodes, so latency-insensitive services default here.
      # Weighted so the pod still schedules if daniel-server is cordoned or full.
      affinity:
        nodeAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              preference:
                matchExpressions:
                  - key: kubernetes.io/hostname
                    operator: In
                    values:
                      - daniel-server
      containers:
        - name: uptime-kuma
          image: {{ uptime_kuma_k8s_image }}
          ports:
            - containerPort: 3001
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
              add:
                # The daniel-pi-host monitor is a real ICMP ping — compose parity.
                - NET_RAW
          volumeMounts:
            - name: data
              mountPath: /app/data
          # / answers 302 to /dashboard; kubelet counts 200-399 as success.
          startupProbe:
            httpGet:
              path: /
              port: 3001
            periodSeconds: 10
            failureThreshold: 18
          readinessProbe:
            httpGet:
              path: /
              port: 3001
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: 3001
            periodSeconds: 30
          resources:
            limits:
              cpu: "{{ uptime_kuma_k8s_cpu_limit }}"
              memory: {{ uptime_kuma_k8s_mem_limit }}
            requests:
              cpu: "{{ uptime_kuma_k8s_cpu_request }}"
              memory: {{ uptime_kuma_k8s_mem_request }}
        # First true sidecar in the fleet, deliberately (KD4): recreating Kuma invalidates
        # AutoKuma's Socket.IO session, and a shared pod reproduces Docker's
        # `depends_on: {restart: true}` — a pod recreate cycles both.
        - name: autokuma
          image: {{ autokuma_k8s_image }}
          # The Kuma ADMIN password is exported from a file mount instead of an inline env
          # (same H1 discipline as the compose entrypoint wrapper): env vars are visible to
          # anything that can read the pod spec or /proc, and this credential can silence
          # the whole fleet's alerting. `exec` keeps autokuma PID 1 for the liveness grep.
          command:
            - /usr/bin/sh
            - -c
            - 'export AUTOKUMA__KUMA__PASSWORD="$(cat /etc/autokuma/kuma_password)"; exec autokuma'
          env:
            - name: AUTOKUMA__KUMA__URL
              value: http://localhost:3001
            - name: AUTOKUMA__KUMA__USERNAME
              valueFrom:
                secretKeyRef:
                  name: autokuma-credentials
                  key: username
            # Docker source OFF (KD2): the socket this fleet's labels lived behind is
            # unreachable from the cluster by design (Security M1).
            - name: AUTOKUMA__DOCKER__ENABLED
              value: "false"
            - name: AUTOKUMA__STATIC_MONITORS
              value: /monitors
            # Secret volumes surface every file as a symlink into ..data/, and AutoKuma
            # skips symlinks by default — without this the static source silently reads an
            # empty directory (masked by on_delete=keep; caught when a file edit never
            # reached the live monitor, 2026-08-10).
            - name: AUTOKUMA__FILES__FOLLOW_SYMLINKS
              value: "true"
            - name: AUTOKUMA__DB_PATH
              value: /data/autokuma.db
            # Flipped keep → delete 2026-08-10 after the transcription ledger closed:
            # every one of the 77 live monitors has a static-monitors declaration
            # (audited name-by-name against `kuma-cli monitor list`; the only file-only
            # entries are the two notification objects). From here, removing an entity's
            # .json file DELETES the live monitor and its history — that is the intended
            # semantic; the interim `keep` existed only while declarations still sat as
            # inert labels on Docker composes this instance can't read.
            - name: AUTOKUMA__ON_DELETE
              value: delete
          securityContext:
            runAsUser: 1000
            runAsGroup: 1000
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - name: autokuma-data
              mountPath: /data
            - name: static-monitors
              mountPath: /monitors
              readOnly: true
            # NOT /run/secrets — that shadows the ServiceAccount token projection and the
            # container never starts (the guarded 2026-08-02 trap).
            - name: credentials
              mountPath: /etc/autokuma
              readOnly: true
          livenessProbe:
            exec:
              command: ["sh", "-c", "grep -q autokuma /proc/1/comm"]
            initialDelaySeconds: 20
            periodSeconds: 30
          resources:
            limits:
              cpu: "{{ autokuma_k8s_cpu_limit }}"
              memory: {{ autokuma_k8s_mem_limit }}
            requests:
              cpu: "{{ autokuma_k8s_cpu_request }}"
              memory: {{ autokuma_k8s_mem_request }}
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: {{ uptime_kuma_k8s_claim }}
        - name: autokuma-data
          persistentVolumeClaim:
            claimName: {{ uptime_kuma_k8s_autokuma_claim }}
        - name: static-monitors
          secret:
            secretName: kuma-static-monitors
        - name: credentials
          secret:
            secretName: autokuma-credentials
            # 444, not 400: secret-volume files are root-owned (no fsGroup — it would
            # recursively chown the data PVC on every mount) and autokuma is uid 1000, so
            # 400 reads as an empty password and Kuma rejects the login. Pod-scoped
            # exposure only, and the kuma container is root anyway.
            defaultMode: 0o444
