---
# AutoKuma static entity files (KD1). Filename (minus .json) = the AutoKuma id, and each id
# here MUST equal the label-derived id it replaces — the seeded entity map is keyed by id,
# and a mismatch makes AutoKuma create a duplicate instead of adopting (KD5 gate finding).
#
# Scope at cutover: the two notifications plus every monitor whose label home was the
# RETIRING uptime-kuma compose. Declarations still living as inert labels on other Docker
# composes (monitor-bridge's push fleet, autofix-bridge, cloudflare-ddns, loki/tempo/
# otel-collector) are protected by AUTOKUMA__ON_DELETE=keep and transcribe in here as each
# of those roles retires. A Secret, not a ConfigMap: push tokens, the Discord webhook and
# the SMTP password are values, not references, once rendered.
#
# Field names are v2.0.0 serde: `maxretries` (http/port/dns/ping), `max_retries` and
# `push_token` accepted as aliases on push, `accepted_statuscodes`, `notification_name_list`.
# Omitted accepted_statuscodes defaults to ["200-299"] server-side, same as the labels did.
#
# REMOVING AN ENTRY HERE MAY NOT REACH THE CLUSTER: this Secret predates apply-managed
# creation, so it carried no last-applied baseline and `kubectl apply` never pruned
# removed keys — the "(via bridge)" retirement (2026-08-10) deployed green while the old
# files stayed mounted and autokuma faithfully re-created every monitor kuma-cli deleted.
# Fixed with a one-time `kubectl replace` (the baseline exists now, so apply prunes
# from here on). After a removal, verify the monitor is gone and kuma-cli-delete it if
# not (pattern: kuma-secret-replace.yml in the job archive).
apiVersion: v1
kind: Secret
metadata:
  name: kuma-static-monitors
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  # ── notifications (label-provisioned before; file-provisioned now — KD5 gate) ──────────
  discord.json: |
    {
      "type": "notification",
      "name": "Homelab Alerts",
      "active": true,
      "config": {"type": "discord", "discordWebhookUrl": "{{ monitor_discord_webhook_url }}", "discordUsername": "Uptime Kuma"}
    }
  # Fans out to BOTH channels: the Discord dead-man's-switch below, plus the critical tier
  # (backup/B2, disks, SMART, SD, cert expiry, UPS) — a *degraded* Discord loses individual
  # alerts while the watchdog stays green, and those are the ones that can't wait a day.
  email.json: |
    {
      "type": "notification",
      "name": "Homelab Alerts (Email)",
      "active": true,
      "config": {"type": "smtp", "smtpHost": "smtp.gmail.com", "smtpPort": 465, "smtpSecure": true, "smtpUsername": "{{ email }}", "smtpPassword": "{{ smtp_notify_app_password }}", "smtpFrom": "{{ email }}", "smtpTo": "{{ email }}", "customSubject": "[Homelab] Uptime Kuma alert"}
    }
  # ── daniel-pi LAN probes ───────────────────────────────────────────────────────────────
  daniel-pi-host.json: |
    {"type": "ping", "name": "Daniel Pi Host", "hostname": "{{ hostvars['daniel-pi'].server_ip }}", "interval": 60, "maxretries": 2, "notification_name_list": ["{{ kuma_notification_id }}"]}
  daniel-pi-glances.json: |
    {"type": "http", "name": "Daniel Pi Glances", "url": "http://{{ hostvars['daniel-pi'].server_ip }}:61208", "interval": 60, "maxretries": 2, "notification_name_list": ["{{ kuma_notification_id }}"]}
  daniel-pi-dozzle.json: |
    {"type": "http", "name": "Daniel Pi Dozzle", "url": "http://{{ hostvars['daniel-pi'].server_ip }}:8080", "interval": 60, "maxretries": 2, "notification_name_list": ["{{ kuma_notification_id }}"]}
  daniel-pi-wg-easy.json: |
    {"type": "http", "name": "Daniel Pi WG Easy", "url": "http://{{ hostvars['daniel-pi'].server_ip }}:51821", "interval": 60, "maxretries": 2, "notification_name_list": ["{{ kuma_notification_id }}"]}
  # ── k3s ingress monitors ───────────────────────────────────────────────────────────────
  auth-k8s.json: |
    {"type": "http", "name": "k3s Authelia Portal", "url": "https://auth{{ k8s_hostname_suffix }}.local.{{ domain }}", "interval": 60, "maxretries": 2, "notification_name_list": ["{{ kuma_notification_id }}"]}
  bento-pdf-k8s.json: |
    {"type": "http", "name": "k3s Ingress (bento-pdf)", "url": "https://bento-pdf{{ k8s_hostname_suffix }}.local.{{ domain }}", "interval": 60, "maxretries": 2, "accepted_statuscodes": ["302"], "max_redirects": 0, "notification_name_list": ["{{ kuma_notification_id }}"]}
  littlelink-k8s.json: |
    {"type": "http", "name": "k3s littlelink", "url": "https://www{{ k8s_hostname_suffix }}.local.{{ domain }}", "interval": 60, "maxretries": 2, "notification_name_list": ["{{ kuma_notification_id }}"]}
  speedtest-k8s.json: |
    {"type": "http", "name": "k3s speedtest", "url": "https://speedtest{{ k8s_hostname_suffix }}.local.{{ domain }}", "interval": 60, "maxretries": 2, "accepted_statuscodes": ["302"], "max_redirects": 0, "notification_name_list": ["{{ kuma_notification_id }}"]}
  freshrss-k8s.json: |
    {"type": "http", "name": "k3s FreshRSS", "url": "https://freshrss{{ k8s_hostname_suffix }}.local.{{ domain }}", "interval": 60, "maxretries": 2, "accepted_statuscodes": ["302"], "max_redirects": 0, "notification_name_list": ["{{ kuma_notification_id }}"]}
  headlamp-k8s.json: |
    {"type": "http", "name": "k3s Headlamp", "url": "https://headlamp{{ k8s_hostname_suffix }}.local.{{ domain }}", "interval": 60, "maxretries": 2, "accepted_statuscodes": ["302"], "max_redirects": 0, "notification_name_list": ["{{ kuma_notification_id }}"]}
  healthchecks-k8s.json: |
    {"type": "http", "name": "k3s healthchecks", "url": "https://healthchecks{{ k8s_hostname_suffix }}.local.{{ domain }}/ping/00000000-0000-0000-0000-000000000000", "interval": 60, "maxretries": 2, "accepted_statuscodes": ["404"], "max_redirects": 0, "notification_name_list": ["{{ kuma_notification_id }}"]}
  livesync-k8s.json: |
    {"type": "http", "name": "k3s LiveSync", "url": "https://livesync{{ k8s_hostname_suffix }}.local.{{ domain }}/", "interval": 60, "maxretries": 2, "accepted_statuscodes": ["401"], "max_redirects": 0, "notification_name_list": ["{{ kuma_notification_id }}"]}
  mosquitto-k8s.json: |
    {"type": "port", "name": "k3s Mosquitto (VIP)", "hostname": "{{ mqtt_k8s_vip }}", "port": 1883, "interval": 60, "maxretries": 2, "notification_name_list": ["{{ kuma_notification_id }}"]}
  # VIP port tiles (kube-proxy ETP-Local DROP mode): joining a Docker host to k3s can
  # black out a container's VIP while host-side probes stay green, so a real cross-host
  # TCP check like this is what actually catches it.
  jellyfin-lan-vip.json: |
    {"type": "port", "name": "k3s Jellyfin (VIP)", "hostname": "{{ jellyfin_k8s_lan_ip }}", "port": 8096, "interval": 60, "maxretries": 2, "notification_name_list": ["{{ kuma_notification_id }}"]}
  terraria-vip.json: |
    {"type": "port", "name": "k3s Terraria (game port)", "hostname": "{{ hostvars['daniel-box'].server_ip }}", "port": 7777, "interval": 60, "maxretries": 2, "notification_name_list": ["{{ kuma_notification_id }}"]}
  # wg-easy's VIP is WireGuard-over-UDP — Kuma port monitors are TCP-only, so it cannot get
  # a port-check tile here.
  zigbee2mqtt-k8s.json: |
    {"type": "http", "name": "k3s Zigbee2MQTT", "url": "https://zigbee2mqtt{{ k8s_hostname_suffix }}.local.{{ domain }}", "interval": 60, "maxretries": 2, "accepted_statuscodes": ["302"], "max_redirects": 0, "notification_name_list": ["{{ kuma_notification_id }}"]}
  slzb-coordinator.json: |
    {"type": "port", "name": "SLZB-06M Coordinator", "hostname": "{{ slzb_ip }}", "port": 6638, "interval": 60, "maxretries": 2, "notification_name_list": ["{{ kuma_notification_id }}"]}
  # max_redirects 0 was ABSENT from the label this transcribes — the monitor then follows
  # the 302 to the Authelia portal and fails on the resulting 200. Made explicit here.
  crowdsec-dashboard-k8s.json: |
    {"type": "http", "name": "k3s CrowdSec Dashboard", "url": "https://crowdsec-k8s.local.{{ domain }}/", "interval": 60, "maxretries": 2, "accepted_statuscodes": ["302"], "max_redirects": 0, "notification_name_list": ["{{ kuma_notification_id }}"]}
  homepage-k8s.json: |
    {"type": "http", "name": "k3s homepage", "url": "https://homepage{{ k8s_hostname_suffix }}.local.{{ domain }}", "interval": 60, "maxretries": 2, "accepted_statuscodes": ["302"], "max_redirects": 0, "notification_name_list": ["{{ kuma_notification_id }}"]}
  peanut-k8s.json: |
    {"type": "http", "name": "k3s peanut", "url": "https://peanut{{ k8s_hostname_suffix }}.local.{{ domain }}", "interval": 60, "maxretries": 2, "accepted_statuscodes": ["302"], "max_redirects": 0, "notification_name_list": ["{{ kuma_notification_id }}"]}
  # Successor to the autokuma-derived "NUT" monitor that retired with the Docker
  # container (D6 reversed, 2026-08-14). A TCP check of upsd over its ClusterIP Service
  # — the pod's own liveness probe (upsc) owns UPS-side depth; this owns "upsd
  # reachable", which is what the host's secondary upsmon depends on.
  nut-k8s.json: |
    {"type": "port", "name": "k3s nut (upsd)", "hostname": "nut.{{ k8s_namespace }}.svc.cluster.local", "port": 3493, "interval": 60, "maxretries": 2, "notification_name_list": ["{{ kuma_notification_id }}"]}
  grafana-k8s.json: |
    {"type": "http", "name": "k3s Grafana", "url": "https://grafana{{ k8s_hostname_suffix }}.local.{{ domain }}", "interval": 60, "maxretries": 2, "accepted_statuscodes": ["302"], "max_redirects": 0, "notification_name_list": ["{{ kuma_notification_id }}"]}
  # Tokenless probe of the mcp gate: a request without the bearer matches no router and
  # the edge itself answers 404 — that 404 IS the healthy signal (same shape as the
  # livesync probe's expected 401). Edge-down/DNS breakage still fails the tile; a dead
  # pod behind a live gate surfaces on k3s Workload Health instead.
  homelab-mcp-k8s.json: |
    {"type": "http", "name": "k3s homelab-mcp (edge gate)", "url": "https://mcp.local.{{ domain }}/mcp", "interval": 60, "maxretries": 2, "accepted_statuscodes": ["404"], "max_redirects": 0, "notification_name_list": ["{{ kuma_notification_id }}"]}
  home-assistant-k8s.json: |
    {"type": "http", "name": "k3s Home Assistant", "url": "https://home-assistant{{ k8s_hostname_suffix }}.local.{{ domain }}", "interval": 60, "maxretries": 2, "notification_name_list": ["{{ kuma_notification_id }}"]}
  # Transcribed 2026-08-10 (Phase D.2 step 3): id `loki` was the grafana compose's
  # kuma('loki') label; the tile now probes the CLUSTER loki-homelab through its
  # ClientIP-gated route (this pod's CIDR is admitted; hostAliases pin the -k8s name to
  # the VIP). /ready 503s ~15s after a restart while the ingester warms — brief PENDING
  # after a deploy is normal, carried over from the Docker tile's notes.
  loki.json: |
    {"type": "http", "name": "Loki", "url": "https://loki-homelab{{ k8s_hostname_suffix }}.local.{{ domain }}/ready", "interval": 60, "maxretries": 2, "notification_name_list": ["{{ kuma_notification_id }}"]}
  # Phase D scrutiny move (2026-08-10, SC5): /api/health rides the LAN Authelia bypass
  # (this pod's CIDR ⊂ 10.0.0.0/8), so a plain 200 — no 302 dance. Covers the cluster
  # web+influxdb pair; the per-node collectors are covered by SMART Data Freshness.
  scrutiny-k8s.json: |
    {"type": "http", "name": "k3s Scrutiny", "url": "https://scrutiny{{ k8s_hostname_suffix }}.local.{{ domain }}/api/health", "interval": 60, "maxretries": 2, "notification_name_list": ["{{ kuma_notification_id }}"]}
  karakeep-k8s.json: |
    {"type": "http", "name": "k3s karakeep", "url": "https://karakeep{{ k8s_hostname_suffix }}.local.{{ domain }}", "interval": 60, "maxretries": 2, "accepted_statuscodes": ["302"], "max_redirects": 0, "notification_name_list": ["{{ kuma_notification_id }}"]}
  ical-proxy-k8s.json: |
    {"type": "http", "name": "iCal Proxy k8s", "url": "https://ical-proxy{{ k8s_hostname_suffix }}.local.{{ domain }}/calendar1.ics", "interval": 60, "maxretries": 2, "notification_name_list": ["{{ kuma_notification_id }}"]}
  code-server-k8s.json: |
    {"type": "http", "name": "k3s code-server", "url": "https://code-server{{ k8s_hostname_suffix }}.local.{{ domain }}", "interval": 60, "maxretries": 2, "accepted_statuscodes": ["302"], "max_redirects": 0, "notification_name_list": ["{{ kuma_notification_id }}"]}
  pihole-k8s-dns.json: |
    {"type": "dns", "name": "Pi-hole k8s DNS", "hostname": "homepage.local.{{ domain }}", "dns_resolve_server": "{{ dns_k8s_vip }}", "dns_resolve_type": "A", "port": 53, "interval": 60, "maxretries": 2, "notification_name_list": ["{{ kuma_notification_id }}"]}
  # ── livesync edge-gate probe ───────────────────────────────────────────────────────────
  # The last "(via bridge)" tile, renamed when the gate moved to the k8s edge's file
  # provider (2026-08-12): the probe now exercises k8s edge → gate probe router → CouchDB.
  # A 401 is CouchDB's require_valid_user answering unauthenticated — the end-to-end
  # signal. Filename (= AutoKuma id) deliberately unchanged so the monitor keeps its
  # identity and history; only the display name updates in place.
  livesync-bridge.json: |
    {"type": "http", "name": "LiveSync (edge gate)", "url": "https://livesync.local.{{ domain }}/", "interval": 60, "maxretries": 2, "accepted_statuscodes": ["401"], "max_redirects": 0, "notification_name_list": ["{{ kuma_notification_id }}"]}
  # ── push monitors fed by host crons (tokens unchanged — monitors keep their history) ───
  crowdsec-home-allowlist.json: |
    {"type": "push", "name": "CrowdSec Home Allowlist", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_home_allowlist_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  docker-fleet.json: |
    {"type": "push", "name": "Docker Fleet Health", "interval": 600, "max_retries": 0, "push_token": "{{ docker_fleet_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  cloudflare-ddns-proxied-push.json: |
    {"type": "push", "name": "Cloudflare DDNS Proxied", "interval": 300, "max_retries": 0, "push_token": "{{ cloudflare_ddns_proxied_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  cloudflare-ddns-direct-push.json: |
    {"type": "push", "name": "Cloudflare DDNS Direct", "interval": 300, "max_retries": 0, "push_token": "{{ cloudflare_ddns_direct_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  longhorn-backup.json: |
    {"type": "push", "name": "k3s Longhorn Backup", "interval": 1200, "max_retries": 0, "push_token": "{{ longhorn_backup_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}", "email"]}
  daniel-box-disk.json: |
    {"type": "push", "name": "daniel-box Disk", "interval": 1200, "max_retries": 0, "push_token": "{{ daniel_box_disk_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}", "email"]}
  claude-otel-health.json: |
    {"type": "push", "name": "k3s Telemetry Stack", "interval": 1200, "max_retries": 0, "push_token": "{{ claude_otel_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  configarr.json: |
    {"type": "push", "name": "Configarr Sync", "interval": 1200, "max_retries": 0, "push_token": "{{ monitor_bridge_configarr_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  monitor-bridge-janitorr.json: |
    {"type": "push", "name": "Janitorr Errors", "interval": 1200, "max_retries": 0, "push_token": "{{ monitor_bridge_janitorr_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  autofix-fake-remux.json: |
    {"type": "push", "name": "Fake Remux Scan", "interval": 1200, "max_retries": 0, "push_token": "{{ monitor_bridge_fake_remux_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  autofix-fake-remux-replace.json: |
    {"type": "push", "name": "Fake Remux Replace", "interval": 1200, "max_retries": 0, "push_token": "{{ monitor_bridge_fake_remux_replace_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  daniel-pi-sd-health.json: |
    {"type": "push", "name": "Daniel Pi SD Health", "interval": 600, "max_retries": 0, "push_token": "{{ pi_sd_health_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}", "email"]}
  daniel-pi-recovery.json: |
    {"type": "push", "name": "Daniel Pi Recovery", "interval": 600, "max_retries": 0, "push_token": "{{ pi_recovery_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  secret-rotation.json: |
    {"type": "push", "name": "Secret Rotation", "interval": 90000, "max_retries": 0, "push_token": "{{ secret_rotation_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
{% if manifest_prune_push_token | default('') %}
  manifest-prune-check.json: |
    {"type": "push", "name": "Manifest Prune Drift", "interval": 90000, "max_retries": 0, "push_token": "{{ manifest_prune_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
{% endif %}
  # ── Transcribed 2026-08-10: the LIVE push fleet whose labels sit inert on the
  # monitor-bridge / autofix-bridge composes (the transcription ledger, pre-ON_DELETE flip).
  # Ids must keep matching the kuma() first arguments at those call sites.
  # monitor-bridge-restarts/oom/cpu removed 2026-08-14 with the Docker cadvisor — the
  # apply prunes the keys (baseline exists since the kubectl-replace reset) and the live
  # monitors were kuma-cli-deleted at the same cutover.
  monitor-bridge-disk.json: |
    {"type": "push", "name": "Root Disk", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_disk_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}", "email"]}
  monitor-bridge-cert.json: |
    {"type": "push", "name": "TLS Cert Expiry", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_cert_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}", "email"]}
  monitor-bridge-mem.json: |
    {"type": "push", "name": "Memory", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_mem_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  monitor-bridge-prometheus.json: |
    {"type": "push", "name": "Prometheus Reachable", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_prometheus_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  monitor-bridge-targets.json: |
    {"type": "push", "name": "Scrape Targets", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_targets_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  monitor-bridge-traefik.json: |
    {"type": "push", "name": "Traefik 5xx", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_traefik_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  monitor-bridge-traefik-latency.json: |
    {"type": "push", "name": "Traefik Latency", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_traefik_latency_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  monitor-bridge-n8n.json: |
    {"type": "push", "name": "n8n Prod Workflows", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_n8n_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  monitor-bridge-arr-queue.json: |
    {"type": "push", "name": "Arr Queue Warnings", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_arr_queue_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  monitor-bridge-prowlarr-indexers.json: |
    {"type": "push", "name": "Prowlarr Indexers", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_prowlarr_indexers_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  gitops-deploy-alive.json: |
    {"type": "push", "name": "GitOps Deploy — Alive", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_gitops_alive_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  gitops-deploy-status.json: |
    {"type": "push", "name": "GitOps Deploy — Status", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_gitops_status_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  wg-easy-pi-peers.json: |
    {"type": "push", "name": "WG Pi Peer Backup", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_pi_peers_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  # E7 (2026-08-13): DOCKER-USER Origin Lock + Cloudflare IP Drift retired with the public
  # 80/443 they guarded. CrowdSec AppSec stays — its feeder moved to daniel-box
  # (k8s/crowdsec's crowdsec-appsec-verify.sh cron, pushing directly; same token).
  crowdsec-appsec.json: |
    {"type": "push", "name": "CrowdSec AppSec", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_appsec_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  autofix-disk-prune.json: |
    {"type": "push", "name": "Disk Autoprune", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_disk_prune_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  monitor-bridge-b2-reachable.json: |
    {"type": "push", "name": "B2 Reachable", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_b2_reachable_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}", "email"]}
  monitor-bridge-k8s-workloads.json: |
    {"type": "push", "name": "k3s Workload Health", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_k8s_workloads_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  monitor-bridge-cluster-targets.json: |
    {"type": "push", "name": "Cluster Scrape Targets", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_cluster_targets_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  monitor-bridge-cluster-prometheus.json: |
    {"type": "push", "name": "Cluster Prometheus Reachable", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_cluster_prometheus_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  monitor-bridge-scrutiny.json: |
    {"type": "push", "name": "SMART Data / Health", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_scrutiny_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}", "email"]}
  monitor-bridge-ups.json: |
    {"type": "push", "name": "UPS Battery Health", "interval": 600, "max_retries": 0, "push_token": "{{ monitor_bridge_ups_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}", "email"]}
  monitor-bridge-pi.json: |
