{# The FULL restore drill, run monthly in a throwaway guest on daniel-server (roles/setup/hypervisor).
   Distinct from monitor-bridge's `etcd Restore Drill` tile, which reads daniel-box's
   weekly list-only stamp and by design never accepts a `full` one. DEADLINE IS DERIVED FROM THE
   CRONTAB: etcd_drill_full_kuma_interval_s in group_vars is the cron's longest period plus slack;
   the pin is in ansible/tests/staging/test_etcd_drill_vm.py. Email tier: a restore drill that has
   stopped passing is the class of silence the off-box snapshot tile above already escalates. #}
{% if etcd_drill_full_push_token | default('') %}
  etcd-restore-drill-full.json: |
    {"type": "push", "name": "etcd Restore Drill (full)", "description": "A monthly cron on daniel-server (1st, 11:20) boots a throwaway libvirt guest, restores the newest off-box etcd snapshot there with a real k3s and reads the object graph back. DOWN means a preflight failed or the restore did not pass; the message says which. Read the run evidence under the drill log root.", "interval": {{ etcd_drill_full_kuma_interval_s }}, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ etcd_drill_full_push_token }}", "tag_names": [{"name": "tag-severity", "value": "critical"}, {"name": "tag-runbook", "value": "https://docs.local.{{ domain }}/k3s-etcd-restore/"}], "notification_name_list": ["{{ kuma_notification_id }}", "email"]}
{% endif %}
{# The egress-fence leg of that same run, pushed from the same cron and so on the same deadline.
   It is a SECOND tile rather than a line in the message above because the drill
   tile cannot express the leg's non-fatal outcome: an unmeasured fenced range leaves the restore
   passing, so the drill tile is `up` and the only record is the message text of a green push,
   which alerts nobody. NEITHER `tag-severity: critical` NOR email, unlike the drill tile above,
   and those are one decision: critical IS the email tier here, per
   test_severity_critical_is_exactly_the_email_tier. The fatal half — a guest that reached
   production — aborts the drill and so already escalates through that tile, which leaves this
   one's unique contribution a probe whose target moved: a maintenance fault, not a page. #}
{% if etcd_drill_fence_push_token | default('') %}
  etcd-restore-drill-fence.json: |
    {"type": "push", "name": "etcd Restore Drill (egress fence)", "description": "The same monthly daniel-server cron dials every range the staging nwfilter drops, plus an internet control target, from inside the throwaway guest before that guest is handed the cluster token and the R2 write credentials. DOWN means the fence LEAKED, or that a range could not be measured at all and so is unproven — the message says which, and names the targets. Read egress-fence.log in the newest run directory under the drill log root.", "interval": {{ etcd_drill_full_kuma_interval_s }}, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ etcd_drill_fence_push_token }}", "tag_names": [{"name": "tag-runbook", "value": "https://docs.local.{{ domain }}/k3s-etcd-restore/"}], "notification_name_list": ["{{ kuma_notification_id }}"]}
{% endif %}
  # ── monitor-bridge's push tiles: one per row of monitor-bridge's files/check_table.py ───────
  # Derived since #3781, so a new bridge check needs no edit here. The row's `kuma_id` is the
  # AutoKuma id, and AutoKuma deletes a monitor whose id disappears (ON_DELETE=delete), so a
  # row's id, display name and description are what keep a monitor and its history. Every
  # tile shares the bridge's cadence: the deadline is the bridge's push interval, never
  # retried, and a `critical` row carries the severity tag and pages email too.
  # `probe.py kuma-drift` reads this loop from the same table, so its census still lists every
  # bridge tile. The tokens are bare lookups, so a row whose secret is missing fails the
  # render rather than dropping its tile (#1632). `ensure_ascii=False` keeps an em dash a literal
  # character, the bytes the hand-written tiles carried, so AutoKuma sees no change.
{% for check in lookup('file', playbook_dir ~ '/roles/k8s/monitor-bridge/files/check_table.py') | py_table('CHECKS') %}
{%   set tags = ([{'name': 'tag-severity', 'value': 'critical'}] if check.critical | default(false) else [])
              + ([{'name': 'tag-runbook', 'value': 'https://docs.local.' ~ domain ~ '/' ~ check.runbook ~ '/'}] if check.runbook | default(none) else []) %}
  {{ check.kuma_id }}.json: |
    {"type": "push", "name": {{ check.display | to_json(ensure_ascii=False) }}, "description": {{ check.description | to_json(ensure_ascii=False) }}, "interval": {{ uptime_kuma_k8s_bridge_push_interval }}, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ lookup('vars', check.token) }}"{% if tags %}, "tag_names": {{ tags | to_json }}{% endif %}, "notification_name_list": {{ ([kuma_notification_id] + (['email'] if check.critical | default(false) else [])) | to_json }}}
{% endfor %}
  # Host flip 1 (2026-08-14): pushed once nightly by the k8s/pi-peer-backup CronJob
  # (23:30), not every bridge cycle — the window is 2.5 days (two missed runs + slack,
  # the same tolerance the retired pi_peers check applied). Same token.
  wg-easy-pi-peers.json: |
    {"type": "push", "name": "WG Pi Peer Backup", "description": "The pi-peer-backup CronJob rsyncs daniel-pi wg-easy peer configs into a Longhorn PVC nightly at 23:30 and pushes its verdict. DOWN means rsync failed or fewer than 2 files came back; silence for 2.5 days means the Job did not run. Run kubectl -n homelab logs on the newest pi-peer-backup Job.", "interval": 216000, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ monitor_bridge_pi_peers_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  # E7 (2026-08-13): DOCKER-USER Origin Lock retired with the public 80/443 it guarded.
  # CrowdSec AppSec stays — its feeder moved to daniel-box (k8s/crowdsec's
  # crowdsec-appsec-verify.sh cron, pushing directly; same token).
  # 90000s (25h): fed by a DAILY cron (setup/gitops_deploy's github-ruleset-drift.sh), so the interval gives one missed run of
  # slack. Watches the merge gate the deployer's CI verdict rests on — a required context
  # removed in the GitHub UI otherwise changes what can reach master with no commit anywhere.
  github-ruleset-drift.json: |
    {"type": "push", "name": "GitHub Ruleset Drift", "description": "The daily 06:40 kuma-check-github-ruleset-drift timer on daniel-box compares the repo's live GitHub rulesets with the values declared in roles/setup/gitops_deploy/defaults/main.yml; it reruns every 30 min while red. DOWN names the ruleset id and the property that differs. UNVERIFIED means it could not read GitHub, or read it without the deploy user's gh token, which GitHub requires before it shows a bypass list. Revert the ruleset change unless it was deliberate, otherwise update the defaults; systemctl status kuma-check-github-ruleset-drift on daniel-box.", "interval": 90000, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ ruleset_drift_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  # 90000s (25h), daily feeder: setup/gitops_deploy's github-interaction-limit.sh. Watches the
  # setting that keeps the public repo closed to non-collaborators — GitHub grants it for six
  # months at most and lets it lapse silently, so the cron re-arms it and this tile says whether
  # the re-arm happened. A missed beat here means the lapse window is open again.
  github-interaction-limit.json: |
    {"type": "push", "name": "GitHub Interaction Limit", "description": "The daily 06:50 kuma-check-github-interaction-limit timer on daniel-box re-PUTs the repo collaborators_only interaction limit, which GitHub only offers as a six-month expiring setting; it reruns every 30 min while red. DOWN means gh is not logged in, the PUT failed, or the readback did not match the declared limit. Run gh auth status as the deploy user, then check the limit in repo settings; systemctl status kuma-check-github-interaction-limit on daniel-box.", "interval": 90000, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ interaction_limit_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
{# The hourly render-record producer (setup/render_records). A producer that stopped
   must read as red, never as a fleet with nothing to compare, so the timer pushes up only when
   every renderable service's record was refreshed at the chosen commit. The interval is
   render_records_push_interval_s in group_vars/all.yml, derived there from the same hourly
   cadence the timer runs on. Gated on the token like its siblings.

   This tile has no inner gate on render_records_enabled: such a gate would make kuma-drift
   excuse a missing tile, and an excuse would hide a tile that failed to appear. Setting
   render_records_enabled false leaves this tile red until the producer is re-armed. #}
{% if render_records_push_token | default('') %}
  render-records.json: |
    {"type": "push", "name": "k8s Render Records", "description": "The hourly kuma-check-render-records timer on daniel-box dry-runs every renderable k8s service at the newest green origin/master commit and writes /var/lib/homelab/k8s-renders.d, which probe.py releases --stale-only reads. DOWN names the services whose record was not refreshed; a missing beat means the producer stopped or keeps deferring on a pending CI walk. journalctl -u kuma-check-render-records on daniel-box.", "interval": {{ render_records_push_interval_s }}, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ render_records_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
{% endif %}
  # 1800s, NOT the bridge fleet's 600s: this monitor's feeder is k8s/crowdsec's `*/15`
  # cron, not the 300s monitor-bridge loop. A 600s interval expired mid-cycle, so the tile
  # alternated up/down every ~7.5 min (measured 2026-08-21: 24 transitions in 3h, up 2/3
  # of the time = 600/900) with `max_retries: 0` turning each expiry straight into DOWN.
  # 1800 = two cron periods, the same one-missed-run slack 600 gives the 300s bridge loop.
  crowdsec-appsec.json: |
    {"type": "push", "name": "CrowdSec AppSec", "description": "A daniel-box cron runs every 15 min and asserts the crowdsec engine has at least one enabled appsec-config and one enabled appsec-rule. DOWN means the inline WAF is not loaded and the edge is ban-list-only, since the bouncer fails open; an unreachable LAPI stays UP. Run cscli appsec-configs list in the crowdsec pod.", "interval": 1800, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ monitor_bridge_appsec_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  # Host flip 2 (2026-08-14): pushed once daily by renovate-notify's ExecStartPost on
  # daniel-box (13:00 timer), not every bridge cycle — 36h window = one missed run +
  # slack, the same tolerance the retired renovate_alive check applied. Same token.
  renovate-notify-alive.json: |
    {"type": "push", "name": "Renovate Notifier — Alive", "description": "renovate-notify.service on daniel-box beats this tile from ExecStartPost after each successful daily 13:00 run. DOWN means silence for 36 h: the timer did not fire or the run failed, and OnFailure will also have posted to Discord. It says nothing about Renovate itself. Run systemctl status renovate-notify.timer.", "interval": 129600, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ monitor_bridge_renovate_alive_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  # Pushed once daily by renovate-agent's ExecStartPost on daniel-box (15:00 timer), and only
  # when the session wrapper exited 0 — a failed run is the OnFailure alert's job, this tile
  # reports silence. DECIDED: 100800s (28h), not the 90000 the other daily tiles use — the
  # beat lands at the END of the run, and a fast run today followed by one that draws the
  # full 10-min jitter and runs to the 100-min unit timeout tomorrow spaces two beats 25h50m
  # apart; 25h fires DOWN on that. 28h leaves 2h of margin and stays under two periods, so a
  # missed run still reports. test_renovate_agent_unit.py pins both bounds. Gated on the
  # token so a checkout without the secret renders no tile rather than one that sits red, and
  # on renovate_agent_enabled so a disarmed agent's tile is withdrawn rather than paging every
  # six hours about a timer that is off on purpose.
{% if renovate_agent_kuma_push_token | default('') and renovate_agent_enabled | default(false) %}
  renovate-agent-alive.json: |
    {"type": "push", "name": "Renovate Agent — Alive", "description": "renovate-agent.service on daniel-box beats this tile from ExecStartPost after each daily 06:00 run exits 0; a crash pushes down with the exception text. DOWN means no clean run in 28 h, including a worktree-blocked skip, or a crash. Run systemctl status renovate-agent.timer and journalctl -u renovate-agent.", "interval": 100800, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ renovate_agent_kuma_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
{% endif %}
  arr-autoblock.json: |
    {"type": "push", "name": "Arr Auto-Block", "description": "autofix-bridge polls the Sonarr and Radarr queues every 5 min, blocklists hard-bad or malware-signature items after 3 cycles and pushes its verdict. DOWN means an arr was unreachable, a mutation failed, or over 5 items were eligible at once so it acted on none. Run kubectl -n homelab logs deploy/autofix-bridge.", "interval": 600, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ arr_autoblock_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
{# Deadman for the status-page-sync CronJob in this role — the job that owns the /status/
   containers group list. Nothing else watches a k8s Job: monitor-bridge's cluster checks
   cover Deployments and DaemonSets only, so without this tile a sync that started failing
   would leave the page frozen at its last good grouping with every other signal green.
   INTERVAL IS 2x THE CRON, not chosen: uptime_kuma_k8s_status_page_sync_schedule runs every 15 min, so
   1800s tolerates exactly one missed run before paging. Move both together.
   The push lands at the END of the job and on BOTH paths — a run that finds nothing to change
   is a healthy run, and the common case. #}
{% if kuma_status_page_sync_push_token | default('') %}
  status-page-sync.json: |
    {"type": "push", "name": "Status Page Sync", "description": "The kuma-status-page-sync CronJob runs every 15 min: dump the live monitors, render the group list, apply it to the status page, then beat from its last container. DOWN means silence for 30 min because a dump, render or apply stage failed. Read the newest kuma-status-page-sync Job logs with kubectl -n homelab.", "interval": 1800, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ kuma_status_page_sync_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
{% endif %}
  # ── fleet-level all-clear ──────────────────────────────────────────────────────────────
  # One tile whose recovery is ONE message, so a fleet-wide outage gets an all-clear at all.
  # #1342: when the edge came back at 11:10:02Z on 2026-09-06, ~17 monitors recovered in the
  # same second and Discord answered five of them with
  # `429 {"message":"You are being rate limited.","retry_after":0.3,"global":false}`. That is
  # the per-webhook bucket refilling, not a ban — but Kuma 2.5.3's discord.js posts once with
  # no retry and no `retry_after` handling (server/notification-providers/discord.js), so those
  # five were simply lost. The operator saw ~33 DOWN messages and then silence.
  #
  # The clustering is not a one-off: a Kuma pod recreate starts every monitor's schedule at the
  # same instant, and essentially every tile here is `interval: 60`, so they stay aligned until
  # the next restart. #1348 makes those restarts FASTER, not rarer, so this recurs.
  #
  # It carries `email` as well as discord for the delivery guarantee — SMTP cannot land in the
  # same per-webhook bucket, so this one all-clear survives a burst that drops Discord messages.
  # Both legs, not email alone: every other member of the email tier is declared that way, and
  # test_every_monitor_is_linked_to_the_discord_notification enforces the discord leg fleet-wide.
  #
  # The TARGET is what makes this fleet-level rather than one more app tile. `ping@internal`
  # behind `PathPrefix(/.well-known/traefik-edge-selfcheck)` on the https entrypoint
  # (roles/k8s/traefik/templates/edge-selfcheck-ingressroute.yaml.j2) depends on no workload:
  # it answers the literal `OK` only when Traefik built a routing table, and it is rejected by
  # exactly the middleware failure that 404'd every host for 3.5 hours in #1322. A keyword, not
  # a bare http tile, for the #1341 reason — a status code alone reads green through a
  # total-404 edge.
  #
  # The HOSTNAME is not free to choose, which cost one deploy to learn. Traefik ranks routers
  # by rule length, and an app's Host() rule can be longer than the 48-char
  # `PathPrefix(`/.well-known/traefik-edge-selfcheck`)`: on `www.local` this tile got
  # littlelink's own 404 body from its 68-char two-host rule, measured 2026-09-06 right after
  # the deploy that added it. `edge-selfcheck.local` fronts no workload and is pinned to the
  # ingress VIP in this pod's hostAliases for exactly this reason, so no Host() router exists
  # to outrank the path — see deployment.yaml.j2.
  #
  # Gated on the same flag as the route it probes, so a checkout with the bouncer plugin off
  # (daniel-stage) renders no tile rather than one that sits permanently red. Plain truthiness,
  # not `| bool`: that filter is Ansible-only and test_kuma_static_monitors renders with bare
  # Jinja. The inventory value is a YAML boolean, so the two agree.
{% if traefik_k8s_manage_crowdsec | default(true) %}
  homelab-edge-allclear.json: |
    {"type": "keyword", "name": "Homelab Edge (all-clear)", "url": "https://edge-selfcheck.local.{{ domain }}/.well-known/traefik-edge-selfcheck", "keyword": "OK", "interval": 60, "maxretries": 2, "max_redirects": 0, "tag_names": [{"name": "tag-severity", "value": "critical"}], "notification_name_list": ["{{ kuma_notification_id }}", "email"]}
{% endif %}
