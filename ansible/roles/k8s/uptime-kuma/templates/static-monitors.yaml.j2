  # 600s against a */5 cron (#2516): the deadline must exceed the period plus the work, and a run
  # is an rsync bounded by ConnectTimeout=10 and --timeout=60 plus up to 90s of push retries.
  artifacts-sync.json: |
    {"type": "push", "name": "Artifacts Peer Sync", "description": "sync-artifacts.sh on daniel-box rsyncs each peer host's ~/.claude/artifacts into the artifacts browser every 5 min. DOWN means a peer has failed every run for an hour; the message names it and its streak. 10 min of silence means the cron stopped. Run journalctl -t sync-artifacts on daniel-box, then ssh to the named peer.", "interval": 600, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ artifacts_sync_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  configarr.json: |
    {"type": "push", "name": "Configarr Sync", "description": "A daniel-box cron runs every 10 min and reads the newest finished configarr Job and its logs; the sync itself runs nightly. DOWN means the last sync is older than 26 h, exited non-zero, logged an error-level line, or its pod logs are gone. Run kubectl -n homelab get jobs and read the newest configarr Job logs.", "interval": 1200, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ monitor_bridge_configarr_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  monitor-bridge-janitorr.json: |
    {"type": "push", "name": "Janitorr Errors", "description": "A daniel-box cron runs every 10 min and counts Unexpected error occurred in scheduled task lines in the janitorr pod logs over the last 12 h, ignoring the first 10 min after startup. DOWN means at least one such error in that window. Run kubectl -n homelab logs deploy/janitorr.", "interval": 1200, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ monitor_bridge_janitorr_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  autofix-fake-remux.json: |
    {"type": "push", "name": "Fake Remux Scan", "description": "fake-remux-health.sh on daniel-box reads the state file of the daily 04:45 ffprobe scan every 10 min. DOWN means the last scan reported a failure or is older than 26 h. Check the fake-remux scan cron journal on daniel-box and state.json in the autofix-fake-remux state dir.", "interval": 1200, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ monitor_bridge_fake_remux_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  autofix-fake-remux-replace.json: |
    {"type": "push", "name": "Fake Remux Replace", "description": "fake-remux-health.sh on daniel-box reads the reconciler state file every 10 min; fake_remux_replace.py runs every 20 min to search, grab, verify and swap in genuine replacements. DOWN means the last reconcile run failed or is older than 1.2 h. Check the reconcile cron journal and replace_state.json on daniel-box.", "interval": 1200, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ monitor_bridge_fake_remux_replace_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  mkv-attachment-repair.json: |
    {"type": "push", "name": "MKV Attachment Repair", "description": "fake-remux-health.sh on daniel-box reads the mkv_attachment_repair.py state file every 10 min; the sweep itself runs every 15 min renaming attachments ffmpeg 7.1 rejects. DOWN means the last sweep failed or is older than 1.2 h. Check the mkv attachment repair cron journal and mkv_attachment_state.json on daniel-box.", "interval": 1200, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ mkv_attachment_repair_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  daniel-pi-sd-health.json: |
    {"type": "push", "name": "Daniel Pi SD Health", "description": "A daniel-pi cron reads the ext4 errors_count of the root filesystem on mmcblk0p2 from sysfs every 5 min. DOWN means the count is nonzero, the earliest sign the SD card is failing, or the counter could not be read; silence for 10 min means the cron or host is dead. Run dmesg and plan an fsck and a card replacement.", "interval": 600, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ pi_sd_health_push_token }}", "tag_names": [{"name": "tag-severity", "value": "critical"}], "notification_name_list": ["{{ kuma_notification_id }}", "email"]}
  daniel-pi-recovery.json: |
    {"type": "push", "name": "Daniel Pi Recovery", "description": "A daniel-pi cron checks every 5 min that every container the host deploys, including the docker-proxy sub-proxies, is running, and restarts any that are not. DOWN names the stopped containers, whether a restart worked, and any dockerd fault; 10 min of silence means the host is dead. Run docker ps and journalctl.", "interval": 600, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ pi_recovery_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
  secret-rotation.json: |
    {"type": "push", "name": "Secret Rotation", "description": "The daily 08:00 kuma-check-secret-rotation-audit timer on daniel-box runs secret_rotation.py audit against ansible/secret_rotation.yml; it reruns every 30 min while red. DOWN means a secret is past its rotation window, a secret in secrets.yml is missing from the registry, or a prior weekly secret-rotate left the tree dirty or unpushed. Run secret_rotation.py audit by hand; systemctl status kuma-check-secret-rotation-audit on daniel-box.", "interval": 90000, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ secret_rotation_push_token }}", "tag_names": [{"name": "tag-runbook", "value": "https://docs.local.{{ domain }}/secret-rotation/"}], "notification_name_list": ["{{ kuma_notification_id }}"]}
{# DECIDED: the one-period-plus-an-hour margin on the drift tiles below (Docs Refresh, Manifest
   Prune, Release Staleness, Setup Plane, Live Object, GitHub Ruleset) stays. #1781 ranked them
   by 30-day down-time and read the margin as the cause. Measured 2026-09-17 from each producer's
   own journal (`journalctl -t <tag>` on the host that runs it — no sudo needed): every DOWN
   episode in the 22 days Prometheus held lines up with a run that completed and pushed `status=down`,
   with a reason — `commit failed`, `deployed code differs from the repo`, `changed since applied`,
   the branch-ruleset arm #1761 added. No episode traces to a producer that failed to RUN.
   Where the push itself failed (`journalctl -t <tag> | grep 'push failed'` — setup-drift-check,
   2026-08-29 16:47, a verdict the library logged and then swallowed) the deadline is what
   reported it, which is the margin doing its job; since #1869 the Swallowed Push Verdicts tile
   (monitor-bridge's `swallowed_verdicts` row) pages that case within a cycle, and the deadline stays as the backstop. A sticky DOWN
   with a message is the tile doing its job too. Widening one to shorten those episodes would hide the finding, not
   the gap, and lengthen how long a dropped verdict stays invisible. Re-check the same way
   before touching any of them. What DID shorten the episodes (2026-09-19, #2141-#2143) is
   on the producer side and leaves every interval here alone: the host checks run from
   `kuma-check-<name>` systemd timers whose script exits 1 after a `down` push, so
   `Restart=on-failure` reruns it every 15-30 min until it exits 0, and Cloudflare IP Drift
   moved into monitor-bridge, which re-probes a failure every cycle. A red tile clears when
   the fault does; the deadline still bounds silence exactly as before. #}
{# Gated on the token like its siblings, so this lands before the secret does and neither half
   sits red waiting for the other.
   INTERVAL IS DERIVED FROM THE CRONTAB, not chosen: docs-refresh runs at minute 17 of hours 6
   and 18 (crons.yml), a 12h gap, so 43200 + 3600s of grace = 46800. Move this and those hours
   together or neither — at 90000 a whole missed run would go unreported, and at 43200 a run
   that merely takes a minute fires DOWN with nothing wrong. #}
{% if docs_refresh_push_token | default('') %}
  docs-refresh.json: |
    {"type": "push", "name": "Docs Refresh", "description": "A daniel-box cron at 06:17 and 18:17 regenerates docs/reference, records a weight for every unweighted test module, rebuilds the MkDocs site and opens a PR for any change under the tree lock. DOWN means a generator, the shard-weight measurement or the site build failed, a previous run is unlanded or left the tree dirty, or the PR could not be published. Run journalctl -t docs-refresh first.", "interval": 46800, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ docs_refresh_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
{% endif %}
{% if manifest_prune_push_token | default('') %}
  manifest-prune-check.json: |
    {"type": "push", "name": "Manifest Prune Drift", "description": "Deployed-artifact drift on the primary node: a live cluster object no staged manifest declares (`kubectl apply` removes nothing it stopped declaring), a copy:-deployed setup file that differs from its source, or a template:-rendered setup script whose source changed since it was rendered. The message names the arm and the object. Runs from the daily kuma-check-manifest-prune timer on daniel-box, which reruns every 30 min while red; systemctl status kuma-check-manifest-prune there.", "interval": 90000, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ manifest_prune_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
{% endif %}
{# The durable signal for a deferred k8s role change gitops_deploy.py's `cs.k8s`
   branch ff-merges with only a one-shot Discord page. `probe.py releases --stale-only` reads the
   release records against origin/master; see this role's cron in roles/setup/k3s (this role's
   CLAUDE.md).
   INTERVAL IS 2x THE CRON, not chosen: the cron runs every 30 min
   (k3s_release_staleness_cron_minute), so 3600s tolerates exactly one missed push before paging
   -- the same margin the */10 heartbeats keep against their 600s cron. Move both together. #}
{% if release_staleness_push_token | default('') %}
  release-staleness-check.json: |
    {"type": "push", "name": "Release Staleness Drift", "description": "A k8s service's role paths, shared roles or inventory keys changed on origin/master after its last applied commit, so what runs is not what master says. Redeploy the named services with `./scripts/deploy.sh --tags <svc>`; `probe.py releases --stale-only` prints every reason. When the stale set changes while this tile is DOWN, the cron pushes an UP marked 'Not a recovery' and then a DOWN carrying the current list, so each change notifies.", "interval": 3600, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ release_staleness_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
{% endif %}
