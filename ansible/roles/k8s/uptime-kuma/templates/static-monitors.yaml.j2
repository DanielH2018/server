---
# AutoKuma static entity files (KD1). Filename (minus .json) = the AutoKuma id, and each id
# here MUST equal the label-derived id it replaces — the seeded entity map is keyed by id,
# and a mismatch makes AutoKuma create a duplicate instead of adopting (KD5 gate finding).
#
# This Secret is the single declaration home for every monitor and both notifications; the
# transcription from the pre-migration label declarations finished with the migration. A
# Secret, not a ConfigMap: push tokens, the Discord webhook and the SMTP password are values,
# not references, once rendered.
#
# Field names are v2.0.0 serde: `maxretries` (http/port/dns/ping), `max_retries` and
# `push_token` accepted as aliases on push, `accepted_statuscodes`, `notification_name_list`.
# Omitted accepted_statuscodes defaults to ["200-299"] server-side, same as the labels did.
#
# REMOVING AN ENTRY HERE MAY NOT REACH THE CLUSTER: this Secret predates apply-managed
# creation, so it carried no last-applied baseline and `kubectl apply` never pruned
# removed keys — the "(via bridge)" retirement (2026-08-10) deployed green while the old
# files stayed mounted and autokuma faithfully re-created every monitor kuma-cli deleted.
# Fixed with a one-time `kubectl replace` (the baseline exists now, so apply prunes
# from here on). After a removal, verify the monitor is gone and kuma-cli-delete it if
# not (pattern: kuma-secret-replace.yml in the job archive).
apiVersion: v1
kind: Secret
metadata:
  name: kuma-static-monitors
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  # ── notifications (label-provisioned before; file-provisioned now — KD5 gate) ──────────
  #
  # `applyExisting: false` looks inert and is load-bearing. Kuma's save() forces the key into
  # the stored config on EVERY write (server/notification.js: `notification.applyExisting =
  # false` before `JSON.stringify`), and AutoKuma's config_eq compares the NUMBER of config keys
  # after dropping six ignored ones — a set that does not include applyExisting. So a config
  # declared without it is permanently one key short of what Kuma stores, never compares equal,
  # and gets rewritten on every sync pass: 2 writes per pass, ~34k SQLite writes a day onto a
  # Longhorn volume whose changed blocks the nightly backup then ships. The monitors converge
  # fine; only these two objects looped, from the k3s cutover until 2026-08-21.
  #
  # The value must be false. Kuma reads the flag before forcing it (`applyExisting ||
  # false`) and a true would attach the notification to every existing monitor.
  #
  # Kuma's `webhook` provider, not its `discord` one, since 2026-09-18. Both POST to the same
  # Discord webhook; the difference is who writes the body. The discord provider's own custom
  # template (`discordMessageFormat: custom`) sends plain `content` and drops the embed, while
  # the webhook provider with `webhookContentType: custom` renders `webhookCustomBody` through
  # the same liquidjs engine and posts the result verbatim — so the body is the embed we
  # author, in files/discord-message.liquid, one template every monitor shares. The header is
  # load-bearing: axios sends a string body as application/x-www-form-urlencoded and Discord
  # rejects that. The AutoKuma id stays `discord` so no monitor's notification_name_list moves,
  # and the name stays "Homelab Alerts", which Kuma prints in its
  # `Cannot send notification to <name>` line. The loki-homelab rule KumaNotificationDropped
  # filters on that text and names no notification, so the name is kept for readability.
  #
  # The webhookURL is the discord-relay sidecar on the pod's loopback, not Discord, since #5657.
  # Kuma posts once and drops a 429, so a mass flip lost alerts; the relay queues each body and
  # forwards it to monitor_discord_webhook_url inside Discord's rate limit
  # (files/discord_relay.py). A message it cannot deliver it logs with the same
  # `Cannot send notification to Homelab Alerts` text, so KumaNotificationDropped still sees it.
  #
  # The Liquid body is wrapped in Tera's raw block. AutoKuma runs EVERY entity through Tera
  # before it parses it (autokuma/src/entity.rs, get_entity_from_settings — unconditional,
  # `files.preprocess` gates only an earlier pass), and Tera reads Liquid's comment tag and
  # its double-brace interpolations as its own syntax (so does this Jinja file, which is why
  # neither is spelled out here): on 2026-09-18 the parse failed, AutoKuma treated the
  # notification as undeclared and re-synced all 108 monitors with an empty notification
  # list. Tera strips the raw markers and passes the content verbatim, so Kuma receives the
  # Liquid unchanged. The markers are assembled from pieces so Jinja does not read them, and
  # the two `set` lines sit at column 0 so trim_blocks leaves no indent behind.
{% set tera_raw = '{%' ~ ' raw ' ~ '%}' %}
{% set tera_endraw = '{%' ~ ' endraw ' ~ '%}' %}
  discord.json: |
    {
      "type": "notification",
      "name": "Homelab Alerts",
      "active": true,
      "config": {"type": "webhook", "applyExisting": false, "webhookURL": "http://127.0.0.1:{{ uptime_kuma_k8s_discord_relay_port }}/", "webhookContentType": "custom", "webhookAdditionalHeaders": "{\"Content-Type\": \"application/json\"}", "webhookCustomBody": {{ (tera_raw ~ lookup('file', playbook_dir + '/roles/k8s/uptime-kuma/files/discord-message.liquid') ~ tera_endraw) | to_json }}}
    }
  # Fans out to BOTH channels: the Discord dead-man's-switch below, plus the critical tier
  # (both backup targets, disks, SMART, SD, cert expiry, UPS) — a *degraded* Discord loses individual alerts while the watchdog stays green, and
  # those are the ones that can't wait a day. "Both backup targets" was "backup/B2" until 2026-08-21: B2's headroom tile was on this
  # tier and R2's was not, though R2 is a Longhorn backup target too and a full bucket stops its
  # backups the same way. The membership test is what a monitor guards, not which vendor it names.
  email.json: |
    {
      "type": "notification",
      "name": "Homelab Alerts (Email)",
      "active": true,
      "config": {"type": "smtp", "applyExisting": false, "smtpHost": "smtp.gmail.com", "smtpPort": 465, "smtpSecure": true, "smtpUsername": "{{ email }}", "smtpPassword": "{{ smtp_notify_app_password }}", "smtpFrom": "{{ email }}", "smtpTo": "{{ email }}", "customSubject": {{ (tera_raw ~ '[Homelab] {{ status }} {{ name }}' ~ tera_endraw) | to_json }}, "customBody": {{ (tera_raw ~ lookup('file', playbook_dir + '/roles/k8s/uptime-kuma/files/email-message.liquid') ~ tera_endraw) | to_json }}}
    }
  # The two tags the notification templates read. A monitor names one in `tag_names`
  # (`[{"name": "tag-severity", "value": "critical"}]` — the tag ENTITY's AutoKuma id, the filename
  # minus .json, not the name Kuma displays) and AutoKuma resolves that id to the tag it created
  # here; the templates print the value when present and nothing when
  # absent. Same NameNotFound hazard as the notification (#2076): a monitor naming a tag
  # this Secret no longer declares fails to parse and is deleted under ON_DELETE=delete.
  # Colours are Catppuccin Mocha red and blue, which is what the Kuma UI shows them in.
  tag-severity.json: |
    {"type": "tag", "name": "severity", "color": "#f38ba8"}
  tag-runbook.json: |
    {"type": "tag", "name": "runbook", "color": "#89b4fa"}
  # ── push monitors fed by host crons (tokens unchanged — monitors keep their history) ───
  # docker-fleet + autofix-disk-prune keys removed at the Docker uninstall (2026-08-14):
  # their producers (the fleet-health cron, the disk-prune cron) retired with the
  # daemon. AutoKuma ON_DELETE=delete removes the live monitors on apply.
{# The weekly registry garbage collection (k8s/registry role, registry-gc.sh). INTERVAL IS DERIVED FROM THE
   CRONTAB: `20 4 * * 0` (registry_k8s_gc_cron_* in the registry defaults), a 604800s period,
   plus two hours. The run pushes at its end, and its worst case is about 6000s: two mirror
   phases, each the pod-exit, Job-delete and rollout waits, registry_k8s_gc_deadline_s (1200s)
   and its warm budget (1800s, then 900s), plus 60s for the lock. A fast week followed by a
   worst-case one moves the push by that much. The healthchecks.io grace is the same two hours, and
   ansible/tests/services/test_registry_gc_watchers_cover_the_worst_run.py derives both from the
   budgets (#6569). Only the two mirror
   stores are collected since the push store's GC was retired. Gated on the
   token like the tiles below: an ungated tile sits red from creation until the secret exists. #}
{% if registry_gc_push_token is defined %}
  registry-gc.json: |
    {"type": "push", "name": "Registry GC", "description": "A weekly daniel-box cron (Sunday 04:20) scales the ghcr-mirror, then the dockerhub-mirror, to zero, runs a prune and garbage-collect Job on each store and scales each back. DOWN means a keep set was skipped, a pod did not stop, a Job timed out, a mirror did not come back, or another run held the lock; the message says which. Check journalctl -t registry-gc, the registry-gc-ghcr-mirror and registry-gc-dockerhub-mirror Job logs and the two mirror Deployments.", "interval": 612000, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ registry_gc_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
{% endif %}
{# The weekly AIDE check (#4594), ONE TILE PER HOST: each host checks its own baseline, and a
   shared token would let one host's `up` cover a host whose check stopped running.

   UP means AIDE completed a check, NOT that nothing changed. Differences push UP with their
   counts, because package upgrades change files every week; the `DECIDED:` marker at the
   classification in roles/setup/initial_setup/templates/aide-check.sh.j2 has the evidence.

   626400s: the producer is a weekly cron (Monday 03:00, integrity.yml), 604800s, and the push
   lands when the scan ends. The deadline counts from the previous push, so the slack has to
   cover one run taking longer than the last; 6 h is unmeasured, since no run had completed when
   these tiles were added (every earlier run exited on the missing --config, #4591). Move this
   and the cron together. No `email`: a broken integrity check costs coverage, not a service. #}
{% if aide_daniel_box_push_token is defined %}
  aide-daniel-box.json: |
    {"type": "push", "name": "AIDE Integrity (daniel-box)", "description": "The weekly Monday 03:00 aide-check.sh cron on daniel-box runs aide --check against the host baseline and pushes when the scan ends. DOWN means AIDE exited with an error and checked nothing (the message carries its first error line, usually a config or database fault), or no run has reported for a week and 6 h. UP means the check completed; its message counts the files that differ from the baseline, which is routine after package upgrades. Run journalctl -t aide-check and journalctl -t aide on daniel-box.", "interval": 626400, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ aide_daniel_box_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
{% endif %}
{% if aide_daniel_server_push_token is defined %}
  aide-daniel-server.json: |
    {"type": "push", "name": "AIDE Integrity (daniel-server)", "description": "The weekly Monday 03:00 aide-check.sh cron on daniel-server runs aide --check against the host baseline and pushes when the scan ends. DOWN means AIDE exited with an error and checked nothing (the message carries its first error line, usually a config or database fault), or no run has reported for a week and 6 h. UP means the check completed; its message counts the files that differ from the baseline, which is routine after package upgrades. Run journalctl -t aide-check and journalctl -t aide on daniel-server.", "interval": 626400, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ aide_daniel_server_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
{% endif %}
{% if aide_daniel_pi_push_token is defined %}
  aide-daniel-pi.json: |
    {"type": "push", "name": "AIDE Integrity (daniel-pi)", "description": "The weekly Monday 03:00 aide-check.sh cron on daniel-pi runs aide --check against the host baseline and pushes when the scan ends. DOWN means AIDE exited with an error and checked nothing (the message carries its first error line, usually a config or database fault), or no run has reported for a week and 6 h. UP means the check completed; its message counts the files that differ from the baseline, which is routine after package upgrades. Run journalctl -t aide-check and journalctl -t aide on daniel-pi.", "interval": 626400, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ aide_daniel_pi_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
{% endif %}
{# The weekly rkhunter scan (#4598), one tile per host for the same reason as the AIDE tiles
   above.

   UP means the scan completed with no warning, no suspect file and no possible rootkit (#4638).
   The warnings every host raised every week are allowlisted in rkhunter.conf.local, so any
   warning left pages. The `DECIDED:` marker at the classification in
   roles/setup/initial_setup/templates/rkhunter-check.sh.j2 has the evidence.

   612000s: the producer is a weekly cron (Wednesday 02:00, integrity.yml), 604800s, and a scan
   took 1m46s-2m26s on daniel-server and about 2.5 min on daniel-pi in the logs kept on
   2026-10-12. The 2 h of slack covers a run taking far longer than the last. Move this and the
   cron together. No `email`: a broken scan costs coverage, not a service. #}
{% if rkhunter_daniel_box_push_token is defined %}
  rkhunter-daniel-box.json: |
    {"type": "push", "name": "rkhunter Scan (daniel-box)", "description": "The weekly Wednesday 02:00 rkhunter-check.sh cron on daniel-box runs rkhunter --check and pushes when the scan ends, two to three minutes later. DOWN means rkhunter raised a warning, a suspect file or a possible rootkit (the message carries the counts and the first warning), or the scan did not complete (the message carries rkhunter's exit code and first error line), or no run has reported for a week and 2 h. An account change clears when rkhunter-check.sh is run again by hand. UP means the scan completed with nothing to report. Read /var/log/rkhunter.log and journalctl -t rkhunter-check on daniel-box.", "interval": 612000, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ rkhunter_daniel_box_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
{% endif %}
{% if rkhunter_daniel_server_push_token is defined %}
  rkhunter-daniel-server.json: |
    {"type": "push", "name": "rkhunter Scan (daniel-server)", "description": "The weekly Wednesday 02:00 rkhunter-check.sh cron on daniel-server runs rkhunter --check and pushes when the scan ends, two to three minutes later. DOWN means rkhunter raised a warning, a suspect file or a possible rootkit (the message carries the counts and the first warning), or the scan did not complete (the message carries rkhunter's exit code and first error line), or no run has reported for a week and 2 h. An account change clears when rkhunter-check.sh is run again by hand. UP means the scan completed with nothing to report. Read /var/log/rkhunter.log and journalctl -t rkhunter-check on daniel-server.", "interval": 612000, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ rkhunter_daniel_server_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
{% endif %}
{% if rkhunter_daniel_pi_push_token is defined %}
  rkhunter-daniel-pi.json: |
    {"type": "push", "name": "rkhunter Scan (daniel-pi)", "description": "The weekly Wednesday 02:00 rkhunter-check.sh cron on daniel-pi runs rkhunter --check and pushes when the scan ends, two to three minutes later. DOWN means rkhunter raised a warning, a suspect file or a possible rootkit (the message carries the counts and the first warning), or the scan did not complete (the message carries rkhunter's exit code and first error line), or no run has reported for a week and 2 h. An account change clears when rkhunter-check.sh is run again by hand. UP means the scan completed with nothing to report. Read /var/log/rkhunter.log and journalctl -t rkhunter-check on daniel-pi.", "interval": 612000, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ rkhunter_daniel_pi_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
{% endif %}
{# DECIDED: the one-period-plus-an-hour margin on the drift tiles below (Docs Refresh, Manifest
   Prune, Release Staleness, Setup Plane, Live Object, GitHub Ruleset) stays. #1781 ranked them
   by 30-day down-time and read the margin as the cause. Measured 2026-09-17 from each producer's
   own journal (`journalctl -t <tag>` on the host that runs it — no sudo needed): every DOWN
   episode in the 22 days Prometheus held lines up with a run that completed and pushed `status=down`,
   with a reason — `commit failed`, `deployed code differs from the repo`, `changed since applied`,
   the branch-ruleset arm #1761 added. No episode traces to a producer that failed to RUN.
   Where the push itself failed (`journalctl -t <tag> | grep 'push failed'` — setup-drift-check,
   2026-08-29 16:47, a verdict the library logged and then swallowed) the deadline is what
   reported it, which is the margin doing its job; since #1869 the Swallowed Push Verdicts tile
   (monitor-bridge's `swallowed_verdicts` row) pages that case within a cycle, and the deadline stays as the backstop. A sticky DOWN
   with a message is the tile doing its job too. Widening one to shorten those episodes would hide the finding, not
   the gap, and lengthen how long a dropped verdict stays invisible. Re-check the same way
   before touching any of them. What DID shorten the episodes (2026-09-19, #2141-#2143) is
   on the producer side and leaves every interval here alone: the host checks run from
   `kuma-check-<name>` systemd timers whose script exits 1 after a `down` push, so
   `Restart=on-failure` reruns it every 15-30 min until it exits 0, and Cloudflare IP Drift
   moved into monitor-bridge, which re-probes a failure every cycle. A red tile clears when
   the fault does; the deadline still bounds silence exactly as before. #}
  # ── monitor-bridge's push tiles: one per row of monitor-bridge's files/check_table.py ───────
  # Derived since #3781, so a new bridge check needs no edit here. The row's `kuma_id` is the
  # AutoKuma id, and AutoKuma deletes a monitor whose id disappears (ON_DELETE=delete), so a
  # row's id, display name and description are what keep a monitor and its history. Every
  # tile shares the bridge's cadence: the deadline is the bridge's push interval, never
  # retried, and a `critical` row carries the severity tag and pages email too.
  # The tokens are bare lookups, so a row whose secret is missing fails the
  # render rather than dropping its tile (#1632). `ensure_ascii=False` keeps an em dash a literal
  # character, the bytes the hand-written tiles carried, so AutoKuma sees no change.
{% for check in lookup('file', playbook_dir ~ '/roles/k8s/monitor-bridge/files/check_table.py') | py_table('CHECKS') %}
{%   set tags = ([{'name': 'tag-severity', 'value': 'critical'}] if check.critical | default(false) else [])
              + ([{'name': 'tag-runbook', 'value': 'https://docs.local.' ~ domain ~ '/' ~ check.runbook ~ '/'}] if check.runbook | default(none) else []) %}
  {{ check.kuma_id }}.json: |
    {"type": "push", "name": {{ check.display | to_json(ensure_ascii=False) }}, "description": {{ check.description | to_json(ensure_ascii=False) }}, "interval": {{ uptime_kuma_k8s_bridge_push_interval }}, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ lookup('vars', check.token) }}"{% if tags %}, "tag_names": {{ tags | to_json }}{% endif %}, "notification_name_list": {{ ([kuma_notification_id] + (['email'] if check.critical | default(false) else [])) | to_json }}}
{% endfor %}
{# Deadman for the status-page-sync CronJob in this role — the job that owns the /status/
   containers group list. Nothing else watches a k8s Job: monitor-bridge's cluster checks
   cover Deployments and DaemonSets only, so without this tile a sync that started failing
   would leave the page frozen at its last good grouping with every other signal green.
   INTERVAL IS 2x THE CRON, not chosen: uptime_kuma_k8s_status_page_sync_schedule runs every 15 min, so
   1800s tolerates exactly one missed run before paging. Move both together.
   The push lands at the END of the job and on BOTH paths — a run that finds nothing to change
   is a healthy run, and the common case. #}
{% if kuma_status_page_sync_push_token is defined %}
  status-page-sync.json: |
    {"type": "push", "name": "Status Page Sync", "description": "The kuma-status-page-sync CronJob runs every 15 min: dump the live monitors, render the group list, apply it to the status page, then beat from its last container. DOWN means silence for 30 min because a dump, render or apply stage failed. Read the newest kuma-status-page-sync Job logs with kubectl -n homelab.", "interval": 1800, "max_retries": 0, "resendInterval": {{ uptime_kuma_k8s_push_resend_down_beats }}, "push_token": "{{ kuma_status_page_sync_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
{% endif %}
