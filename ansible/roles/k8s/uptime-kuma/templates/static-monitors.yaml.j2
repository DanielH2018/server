{# Minted 2026-09-17 for #1869. kuma-push-lib.sh logs a lost push and returns 0 by design, so
   a host cron's DOWN verdict that never reached its tile was reported only by that tile's
   heartbeat deadline — the one-period-plus-an-hour margin the DECIDED marker above the drift
   tiles keeps. monitor-bridge reads the library's final `push failed` line out of Loki and
   pages here within a cycle, but ONLY when a sibling cron landed a push in the same window: a
   fleet-wide loss is the edge or host tiles' page, and a plain count of push failures was
   measured and rejected for paging on exactly those (uptime-kuma/CLAUDE.md). The exception is
   a push Kuma itself rejected (`by=kuma` on the line, #1803): a token no monitor here holds
   has no tile to go red, so it pages here whatever its status and company. #}
  monitor-bridge-swallowed-verdicts.json: |
    {"type": "push", "name": "Swallowed Push Verdicts", "description": "A host cron pushed status=down and the push failed while a sibling cron's push landed, so the verdict was lost rather than the network. The message names the cron; run it by hand and read its logger lines.", "interval": {{ kuma_bridge_push_interval }}, "max_retries": 0, "resendInterval": {{ kuma_push_resend_down_beats }}, "push_token": "{{ monitor_bridge_swallowed_verdicts_push_token }}", "notification_name_list": ["{{ kuma_notification_id }}"]}
