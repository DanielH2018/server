# DIGEST-PINNED. `:latest` here had no updater: the weekly redeploy cron that used to force a
# rebuild of every locally-built role (roles/containers/common/tasks/redeploy_cron.yml) lost its
# last caller in the 2026-08-14 k3s migration, and Renovate cannot bump a tag with no version in
# it. The explicit -lsNN tag is what the built-in dockerfile manager tracks (the linuxserver
# packageRule in renovate.json orders that form); the digest beside it is what makes the build
# reproducible from a commit — linuxserver rebuilds a tag in place, so the tag alone named a
# moving image (#2149). Renovate bumps both together. See Dockerfile.j2 in roles/k8s/n8n-images
# for the full reasoning behind pinning a built image's base.
FROM lscr.io/linuxserver/code-server:4.138.0-ls365@sha256:3ca0faa2891c694dab184a85c61441c8be512a038fea27bfdaa01246030b6c30

# 1. Install system dependencies
#    No TeX Live here. LaTeX moved to the texbrain workload on 2026-08-27, which compiles in
#    the browser via a WebAssembly pdfTeX — see roles/k8s/texbrain. The four packages that
#    used to be in this list (texlive-latex-extra, texlive-fonts-recommended, tex-gyre,
#    latexmk) pulled in 56 packages and ~309 MiB of the ~858 MiB installed here, and nothing
#    outside that set depended on them.
#
#    Consequence worth knowing before you debug a document here: this image can no longer
#    compile one at all, and there is no local fallback. texbrain needs the pod, a browser,
#    and a jsDelivr mirror for any package outside its bundled TeX Live subset.
#
#    These four apt packages are the one build input still resolved at build time. A
#    `pkg=version` pin breaks the build the day noble-updates supersedes the version — the
#    archive pool keeps only the current one — and a snapshot.ubuntu.com timestamp has no
#    Renovate datasource, so it would freeze the security updates for git/curl/python3 with
#    nothing raising a PR. Both are recorded against #2149; neither is an oversight.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    python3 \
    python3-venv \
    curl \
    xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/python3 /usr/bin/python

# 2. Node.js from the official tarball, checksum-verified, into /usr/local (node + npm + npx).
#    This replaced NodeSource's `setup_22.x` script piped to bash on 2026-09-21: that script
#    resolved whatever NodeSource served on build day and ran as root straight off the network.
#    Version and sha256 live in defaults/main.yml (code_server_k8s_node_*), where Renovate
#    tracks the version; `sha256sum -c` is what turns a stale hash into a failed build rather
#    than a silently different node.
RUN curl -fsSL -o /tmp/node.tar.xz \
        "{{ code_server_k8s_node_url }}" \
    && echo "{{ code_server_k8s_node_sha256 }}  /tmp/node.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --no-same-owner \
        --exclude='*/CHANGELOG.md' --exclude='*/LICENSE' --exclude='*/README.md' \
    && rm /tmp/node.tar.xz \
    && node --version && npm --version

# 3. Python virtual environment outside /config so it survives volume mounts, with its
#    packages and its ownership settled in the SAME layer. `chown -R` rewrites every file,
#    and a rewritten file is a new file to the layer format — so doing it in a later step
#    stored a second full copy of the venv (89 M compressed) on top of the one already
#    written here. The chown must stay last: pip writes into the venv after it exists.
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
#    python3-pip is deliberately NOT installed. `python3 -m venv` builds the venv's own pip
#    from python3-venv's bundled wheel, so the system one was never needed here — it only
#    supplied a second /usr/bin/pip that would install into the system interpreter and fail
#    silently. Removing the package removes the footgun; the absolute-path call below stays
#    anyway, because it is what makes the target unambiguous rather than PATH-dependent.
#
#    Every package is `==`-pinned (#2149): a bare name re-resolved to newest PyPI on every
#    rebuild. Renovate tracks each pin on PyPI (regex manager in renovate.json); transitive
#    dependencies still resolve at build time, which a hashed requirements file would close.
RUN python3 -m venv $VIRTUAL_ENV \
    && $VIRTUAL_ENV/bin/pip install --no-cache-dir \
        uv==0.12.17 \
        pandas==3.0.6 \
        requests==2.34.2 \
        ruff==0.16.8 \
        ty==0.0.82 \
        structlog==26.1.0 \
        python-dotenv==1.2.3 \
    && chown -R {{ puid }}:{{ pgid }} $VIRTUAL_ENV

# 4. Claude Code CLI, pinned to the same release as the Anthropic.claude-code extension in
#    defaults/main.yml — the extension drives this binary, so the two move together. Renovate
#    tracks the pin on npm (regex manager in renovate.json). npm's download cache is ~96 M that
#    the running container never reads, so it is dropped in the same layer that creates it — a
#    later `rm` would not shrink this one.
RUN npm install -g @anthropic-ai/claude-code@2.1.278 \
    && npm cache clean --force

# 5. VS Code extensions, downloaded at build time from the exact URL each entry in
#    code_server_k8s_extensions (defaults/main.yml) names, and kept only when the sha256
#    matches. Until 2026-09-21 this step asked Open VSX and the marketplace for the CURRENT
#    version of each and took the first build listed — which for a platform-specific
#    extension was alpine-arm64 (ruff, ty) or win32-x64 (Claude Code). The defaults comment
#    has the details and the bump recipe.
#    The `-A` and `--compressed` flags carry over from the marketplace half of the old step:
#    the marketplace serves a vspackage gzip-encoded, `--compressed` decodes it, and the
#    recorded hash is over the decoded VSIX. Open VSX serves the file as-is; both flags are
#    inert there.
RUN mkdir -p /opt/vsix
{% for ext in code_server_k8s_extensions %}
# {{ ext.name }} {{ ext.version }}
RUN curl -fsSL --compressed -A "VSCode/1.95.0" -o "/opt/vsix/{{ ext.name }}.vsix" "{{ ext.url }}" \
    && echo "{{ ext.sha256 }}  /opt/vsix/{{ ext.name }}.vsix" | sha256sum -c -
{% endfor %}

# 6. Startup script installs all /opt/vsix extensions into the config volume
COPY extensions.sh /custom-cont-init.d/10-extensions.sh
RUN chmod +x /custom-cont-init.d/10-extensions.sh
