{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: code-server
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  # RWO config PVC on single-replica Longhorn — a rolling update deadlocks on the volume.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: code-server
  template:
    metadata:
      labels:
        app: code-server
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      # No fsGroup: volume-claim restores ownership with `tar -p --numeric-owner` and the LSIO
      # image chowns /config itself on startup.
      automountServiceAccountToken: false
      priorityClassName: homelab-best-effort
      # Preference, never a pin: CPU-bound builds and language servers.
      # Weighted so the pod still schedules if daniel-box is cordoned or full.
{{ node_affinity_preference(k8s_primary_node) }}
      # ── first boot only: copy the four keepers onto the backed-up claim ──────────────────
      # It has to run here, before the workload's subPath mounts land, because those mounts
      # shadow the originals: once /config/workspace, /config/.ssh and /config/.config point at
      # the workspace claim, the copies on the config volume are unreachable from this pod.
      # Nothing is deleted — the config volume keeps everything, it just stops being backed up.
      # Idempotent through a marker file, so every later start is a no-op.
      initContainers:
        - name: seed-workspace-claim
          image: {{ code_server_k8s_image }}
          # Built in-cluster to a mutable :latest; explicit for the reason terraria's
          # deployment records.
          imagePullPolicy: Always
          command:
            - /bin/sh
            - -c
            - |
              set -eu
              if [ -e /keep/.migrated ]; then
                echo "workspace claim already migrated"
                exit 0
              fi
              mkdir -p /keep/workspace /keep/ssh /keep/config
              cp -a /config/workspace/. /keep/workspace/ || true
              cp -a /config/.ssh/. /keep/ssh/ || true
              cp -a /config/.config/. /keep/config/ || true
              # The git identity rides along inside .config at git's XDG path. Mounting
              # ~/.gitconfig itself by subPath would break `git config --global`: it writes a
              # .lock file and rename()s it over the target, and a rename onto a bind-mounted
              # file fails EBUSY.
              if [ -f /config/.gitconfig ] && [ ! -f /keep/config/git/config ]; then
                mkdir -p /keep/config/git
                cp -a /config/.gitconfig /keep/config/git/config
              fi
              # ~/.gitconfig outranks the XDG path, so it has to stop existing. Renamed rather
              # than removed, so the original is still there if this turns out to be wrong.
              if [ -f /config/.gitconfig ]; then
                mv /config/.gitconfig /config/.gitconfig.pre-split
              fi
              chown -R {{ puid }}:{{ pgid }} /keep
              touch /keep/.migrated
              chown {{ puid }}:{{ pgid }} /keep/.migrated
              echo "migrated workspace, .ssh, .config and the git identity"
          securityContext:
            runAsUser: 0
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
              # A fresh claim's root is root:root while the files being copied are the pod
              # uid's, so this container needs both halves: DAC_OVERRIDE to read them and
              # CHOWN to hand the result back. Root WITHOUT DAC_OVERRIDE is weaker than the
              # pod uid here, not stronger.
              add:
                - CHOWN
                - DAC_OVERRIDE
                - FOWNER
          volumeMounts:
            - name: code-server-config
              mountPath: /config
            - name: code-server-workspace
              mountPath: /keep
{{ container_resources(cpu_limit='1', mem_limit='128Mi', cpu_request='10m', mem_request='32Mi') }}
      containers:
        - name: code-server
          image: {{ code_server_k8s_image }}
          imagePullPolicy: Always  # as on the init container above
          ports:
            - containerPort: {{ container_item.port }}
          # The compose template's cap_drop/cap_add pair — the s6 privilege-drop set.
          # s6/DOCKER_MODS init chmods files it doesn't own (e.g. /config/.ssh to
          # 0700) — without FOWNER that EPERMs and .ssh is left world-readable 0755.
{{ hardened_security_context(add=['CHOWN', 'SETUID', 'SETGID', 'FOWNER', 'DAC_OVERRIDE']) }}
          env:
            - name: PUID
              value: "{{ puid }}"
            - name: PGID
              value: "{{ pgid }}"
            - name: TZ
              value: "{{ tz }}"
            - name: EXTENSIONS_GALLERY
              value: '{"serviceUrl": "https://open-vsx.org/vscode/gallery", "itemUrl": "https://open-vsx.org/vscode/item"}'
          envFrom:
            - secretRef:
                name: code-server-env
          volumeMounts:
            - name: code-server-config
              mountPath: /config
            # The backed-up paths, carved out of /config by subPath. Order does not matter —
            # kubelet mounts parents before children — but each of these must exist in the
            # claim, which is what the initContainer guarantees.
            - name: code-server-workspace
              mountPath: /config/workspace
              subPath: workspace
            - name: code-server-workspace
              mountPath: /config/.ssh
              subPath: ssh
            - name: code-server-workspace
              mountPath: /config/.config
              subPath: config
          # First boot runs 10-extensions.sh (installs the baked vsix set into /config)
          # before the listener comes up — allow up to 5 min before liveness takes over.
          startupProbe:
            httpGet:
              path: /healthz/
              port: {{ container_item.port }}
            periodSeconds: 10
            failureThreshold: 30
          readinessProbe:
            httpGet:
              path: /healthz/
              port: {{ container_item.port }}
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /healthz/
              port: {{ container_item.port }}
            periodSeconds: 30
{{ container_resources(cpu_limit=code_server_k8s_cpu_limit, mem_limit=code_server_k8s_mem_limit, cpu_request=code_server_k8s_cpu_request, mem_request=code_server_k8s_mem_request) }}
      volumes:
        - name: code-server-config
          persistentVolumeClaim:
            claimName: {{ code_server_k8s_claim }}
        - name: code-server-workspace
          persistentVolumeClaim:
            claimName: {{ code_server_k8s_workspace_claim }}
