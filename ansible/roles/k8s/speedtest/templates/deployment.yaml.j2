{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: speedtest
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  # The PVC is ReadWriteOnce and Longhorn runs one replica, so a rolling update would deadlock:
  # the new pod waits for a volume the old pod still holds.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: speedtest
  template:
    metadata:
      labels:
        app: speedtest
        netpol-baseline: enforced
    spec:
      # No legacy Docker-link env vars for every Service in the namespace. Harmless clutter
      # here, fatal for Authelia — see that role's deployment for the failure it causes.
      enableServiceLinks: false
      # No fsGroup on purpose. seed-volume restores the source's ownership with
      # `tar -p --numeric-owner`, and this LSIO image starts as root and chowns /config to
      # PUID/PGID itself. An fsGroup would recursively rewrite group ownership at mount time,
      # fighting both.
      automountServiceAccountToken: false
      priorityClassName: homelab-best-effort
      # Preference, never a pin: daniel-box carries the storage- and VIP-pinned workloads and runs the hotter of the two nodes, so latency-insensitive services default here.
      # Weighted so the pod still schedules if daniel-server is cordoned or full.
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: speedtest
          image: {{ speedtest_k8s_image }}
          ports:
            - containerPort: {{ container_item.port }}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              # The compose template's cap_drop/cap_add pair, carried over verbatim: the s6
              # privilege-drop set plus NET_BIND_SERVICE for :80.
              drop:
                - ALL
              add:
                - CHOWN
                - SETUID
                - SETGID
                - FOWNER
                - DAC_OVERRIDE
                - NET_BIND_SERVICE
          env:
            - name: TZ
              value: "{{ tz }}"
            - name: PUID
              value: "{{ puid }}"
            - name: PGID
              value: "{{ pgid }}"
            # Follows the inventory hostname rather than being hardcoded to the public name:
            # while both copies run this one answers on the -k8s host, and Laravel builds
            # redirects and asset URLs from APP_URL. At cutover the inventory changes and
            # this follows it — which is what unsuffixed_hostname does. Once the bridge is
            # carrying the real hostnames, the -k8s URL is the wrong canonical: Laravel would
            # hand a public visitor asset and redirect URLs on a LAN-only host that does not
            # resolve for them. Bridged, this matches the Docker copy's APP_URL exactly.
            - name: APP_URL
              value: "https://{{ container_item.hostname | default(container_item.name) }}.{{ domain }}"
            # Results are stored in UTC by design (APP_TIMEZONE stays default); this is
            # the UI-display timezone, which otherwise also defaults to Etc/UTC.
            - name: DISPLAY_TIMEZONE
              value: "{{ tz }}"
            - name: OOKLA_EULA_GDPR
              value: "true"
            - name: SPEEDTEST_SCHEDULE
              value: "0 */6 * * *"
            # Pinned to 41671 (x99.cloud, Chicago) on 2026-08-24, restoring the pin that came
            # off on 2026-08-13 — to a different server, and this time on measured evidence.
            #
            # Auto-select did not fix what removing the old pin was meant to fix; it randomised
            # it. Results under auto-select are BIMODAL, and the mode is decided by which server
            # the run draws. Over 2026-08-14..24, all 20 runs that landed on 41671 returned a
            # median 910 Mbps, and all 17 that landed on any of six other servers (SUMOFIBER,
            # TNAHosting, Highline, Tata, GigeNET, Sangoma) returned a median 12.8 Mbps. The two
            # groups do not overlap: worst run on 41671 was 119 Mbps, best run elsewhere 42.8.
            # Upload read 37-41 Mbps throughout, so the link is fine on the bad runs and only
            # the download leg collapses.
            #
            # The old pin's story stands and is the reason to distrust this one eventually:
            # 1775 (Comcast, Baltimore) returned ~900 Mbps on all 54 runs from 07-25 to 08-07,
            # then ~13 Mbps on all 21 runs from 08-08 to 08-13. A pin is only as good as its
            # last verification, so re-check 41671 against auto-select periodically — the
            # monitor-bridge `speedtest` check's 100 Mbps floor is what makes a repeat visible
            # rather than silent.
            #
            # NOT A DIAGNOSIS. Six independent providers all congesting to the same ~13 Mbps is
            # odd, and curl to two distant non-Ookla hosts showed the same shape. This pin fixes
            # the measurement, not whatever the measurement is pointing at.
            - name: SPEEDTEST_SERVERS
              value: "41671"
            - name: PRUNE_RESULTS_OLDER_THAN
              value: "30"
          envFrom:
            - secretRef:
                name: speedtest
          volumeMounts:
            - name: speedtest-config
              mountPath: /config
          readinessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
            initialDelaySeconds: 15
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
            initialDelaySeconds: 60
            periodSeconds: 30
          resources:
            limits:
              cpu: "{{ speedtest_k8s_cpu_limit }}"
              memory: {{ speedtest_k8s_mem_limit }}
            requests:
              cpu: "{{ speedtest_k8s_cpu_request }}"
              memory: {{ speedtest_k8s_mem_request }}
      volumes:
        - name: speedtest-config
          persistentVolumeClaim:
            claimName: {{ speedtest_k8s_claim }}
