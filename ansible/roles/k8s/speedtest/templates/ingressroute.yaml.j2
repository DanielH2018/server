{% from 'ingressroute.yml.j2' import ingressroute, monitoring_route with context %}
---
{{ ingressroute(
    container_item.name,
    container_item.hostname | default(container_item.name),
    container_item.port,
    container_item.use_authelia,
  )
}}
---
{#
  Homepage's speedtest widget (a session-less API-key caller, which is why the pod CIDR is
  allowed). The main route carries Authelia, which 401s the widget, so /api/ gets this separate route.
#}
{{ monitoring_route(
    container_item.name,
    container_item.hostname | default(container_item.name),
    container_item.port,
    '/api/',
    extra_client_cidrs=['10.42.0.0/16']
  )
}}
