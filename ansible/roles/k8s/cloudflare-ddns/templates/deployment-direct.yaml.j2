---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cloudflare-ddns-direct
  namespace: {{ k8s_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: cloudflare-ddns-direct
  template:
    metadata:
      labels:
        app: cloudflare-ddns-direct
    spec:
      enableServiceLinks: false
      automountServiceAccountToken: false
      containers:
        - name: cloudflare-ddns
          image: {{ cloudflare_ddns_k8s_image }}
          securityContext:
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          env:
            - name: CLOUDFLARE_API_TOKEN_FILE
              value: /etc/ddns-secrets/cf_dns_token
            # terraria and valheim (reactivated onto k3s 2026-08-13) are live; minecraft is
            # still archived, and its record stays out — publishing an A record for a game
            # server that does not exist points the unproxied home IP at nothing and
            # needlessly exposes the raw IP. Re-add a domain here when its server comes back.
            - name: DOMAINS
              value: "terraria.{{ domain }},valheim.{{ domain }}"
            - name: PROXIED
              value: "false"
            - name: IP6_PROVIDER
              value: none
            # No UPTIMEKUMA_FILE exists upstream (favonia/cloudflare-ddns only has
            # CLOUDFLARE_API_TOKEN_FILE and SHOUTRRR_FILE), so the token comes from a
            # secretKeyRef and is composed into the URL via $(...) expansion — the pod spec
            # then holds a reference, not the token itself.
            - name: KUMA_PUSH_TOKEN
              valueFrom:
                secretKeyRef:
                  name: cloudflare-ddns
                  key: kuma_push_token_direct
            - name: UPTIMEKUMA
              # In-cluster Service URL — Kuma is one namespace hop away, so the heartbeat
              # neither leaves the cluster nor depends on edge routing. The old hostAliases
              # pin to daniel-server died with the slice-7 bridge teardown (the Docker
              # edge's forward-bridge router was the path it relied on).
              value: "http://uptime-kuma:3001/api/push/$(KUMA_PUSH_TOKEN)"
          volumeMounts:
            # /etc, not /run/secrets: this image (scratch-based) lacks the /var/run
            # symlink so the old path happened to work, but the convention guard bans the
            # class — on any distro-based image it shadows the ServiceAccount token mount.
            - name: token
              mountPath: /etc/ddns-secrets
              readOnly: true
          resources:
            limits:
              cpu: "{{ cloudflare_ddns_k8s_cpu_limit }}"
              memory: {{ cloudflare_ddns_k8s_mem_limit }}
            requests:
              cpu: "{{ cloudflare_ddns_k8s_cpu_request }}"
              memory: {{ cloudflare_ddns_k8s_mem_request }}
      volumes:
        - name: token
          secret:
            secretName: cloudflare-ddns
            items:
              - key: cf_dns_token
                path: cf_dns_token
