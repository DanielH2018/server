---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cloudflare-ddns-direct
  namespace: {{ k8s_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: cloudflare-ddns-direct
  template:
    metadata:
      labels:
        app: cloudflare-ddns-direct
    spec:
      enableServiceLinks: false
      hostAliases:
        - ip: "{{ cloudflare_ddns_k8s_kuma_ip }}"
          hostnames:
            - "{{ cloudflare_ddns_k8s_kuma_host }}"
      containers:
        - name: cloudflare-ddns
          image: {{ cloudflare_ddns_k8s_image }}
          securityContext:
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          env:
            - name: CLOUDFLARE_API_TOKEN_FILE
              value: /etc/ddns-secrets/cf_dns_token
            # Only terraria is live. valheim/minecraft are archived — publishing their A
            # records pointed unproxied home IP at nothing, needlessly exposing the raw IP.
            # Re-add a domain here when its game server is reactivated.
            - name: DOMAINS
              value: "terraria.{{ domain }}"
            - name: PROXIED
              value: "false"
            - name: IP6_PROVIDER
              value: none
            - name: UPTIMEKUMA
              value: "https://{{ cloudflare_ddns_k8s_kuma_host }}/api/push/{{ cloudflare_ddns_direct_push_token }}"
          volumeMounts:
            # /etc, not /run/secrets: this image (scratch-based) lacks the /var/run
            # symlink so the old path happened to work, but the convention guard bans the
            # class — on any distro-based image it shadows the ServiceAccount token mount.
            - name: token
              mountPath: /etc/ddns-secrets
              readOnly: true
          resources:
            limits:
              cpu: "{{ cloudflare_ddns_k8s_cpu_limit }}"
              memory: {{ cloudflare_ddns_k8s_mem_limit }}
            requests:
              cpu: "{{ cloudflare_ddns_k8s_cpu_request }}"
              memory: {{ cloudflare_ddns_k8s_mem_request }}
      volumes:
        - name: token
          secret:
            secretName: cloudflare-ddns
            items:
              - key: cf_dns_token
                path: cf_dns_token
