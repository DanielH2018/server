{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cloudflare-ddns-proxied
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  selector:
    matchLabels:
      app: cloudflare-ddns-proxied
  template:
    metadata:
      labels:
        app: cloudflare-ddns-proxied
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      automountServiceAccountToken: false
      priorityClassName: homelab-best-effort
      # Preference, never a pin: daniel-box carries the storage- and VIP-pinned workloads and runs the hotter of the two nodes, so latency-insensitive services default here.
      # Weighted so the pod still schedules if daniel-server is cordoned or full.
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: cloudflare-ddns
          image: {{ cloudflare_ddns_k8s_image }}
          securityContext:
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          env:
            - name: CLOUDFLARE_API_TOKEN_FILE
              value: /etc/ddns-secrets/cf_dns_token
            - name: DOMAINS
              value: "{{ domain }}"
            - name: PROXIED
              value: "true"
            - name: IP6_PROVIDER
              value: none
            # No UPTIMEKUMA_FILE exists upstream (favonia/cloudflare-ddns only has
            # CLOUDFLARE_API_TOKEN_FILE and SHOUTRRR_FILE), so the token comes from a
            # secretKeyRef and is composed into the URL via $(...) expansion — the pod spec
            # then holds a reference, not the token itself.
            - name: KUMA_PUSH_TOKEN
              valueFrom:
                secretKeyRef:
                  name: cloudflare-ddns
                  key: kuma_push_token_proxied
            # Dead-man's-switch: ping a Kuma push monitor after each successful update.
            - name: UPTIMEKUMA
              # In-cluster Service URL — Kuma is one namespace hop away, so the heartbeat
              # neither leaves the cluster nor depends on edge routing. The old hostAliases
              # pin to daniel-server died with the slice-7 bridge teardown (the Docker
              # edge's forward-bridge router was the path it relied on).
              value: "http://uptime-kuma:3001/api/push/$(KUMA_PUSH_TOKEN)"
          volumeMounts:
            # /etc, not /run/secrets — see deployment-direct's note (convention guard).
            - name: cloudflare-ddns-token
              mountPath: /etc/ddns-secrets
              readOnly: true
          resources:
            limits:
              cpu: "{{ cloudflare_ddns_k8s_cpu_limit }}"
              memory: {{ cloudflare_ddns_k8s_mem_limit }}
            requests:
              cpu: "{{ cloudflare_ddns_k8s_cpu_request }}"
              memory: {{ cloudflare_ddns_k8s_mem_request }}
      volumes:
        - name: cloudflare-ddns-token
          secret:
            secretName: cloudflare-ddns
            items:
              - key: cf_dns_token
                path: cf_dns_token
