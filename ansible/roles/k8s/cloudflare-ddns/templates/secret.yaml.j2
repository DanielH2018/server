---
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-ddns
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  # Same zone-edit token as traefik's CF_DNS_API_TOKEN. Mounted as a file rather than passed
  # as an environment variable, which is what CLOUDFLARE_API_TOKEN_FILE is for: a file mount
  # keeps the value out of the container Env, so it does not show up in
  # `kubectl describe pod`.
  cf_dns_token: "{{ cloudflare_dns_token }}"
