---
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-ddns
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  # Same zone-edit token as traefik's CF_DNS_API_TOKEN. Mounted as a file rather than passed
  # as an environment variable, which is what CLOUDFLARE_API_TOKEN_FILE is for — the compose
  # template made that choice to keep the value out of the container Env, and it is still the
  # better default here: a file mount does not show up in `kubectl describe pod`.
  cf_dns_token: "{{ cloudflare_dns_token }}"
  # favonia/cloudflare-ddns has no UPTIMEKUMA_FILE (verified against its README — only
  # CLOUDFLARE_API_TOKEN_FILE and SHOUTRRR_FILE exist as _FILE variants), so the push URL
  # can't be file-mounted the same way. Kept as a secretKeyRef instead of inlining the token
  # in the Deployment's env value: the pod spec then carries a `$(KUMA_PUSH_TOKEN)` reference,
  # not the token itself, so `kubectl get pod -o yaml`/`describe pod` never show it.
  kuma_push_token_direct: "{{ cloudflare_ddns_direct_push_token }}"
  kuma_push_token_proxied: "{{ cloudflare_ddns_proxied_push_token }}"
