---
# Scrutiny's time-series store. scrutiny-web is the only client: it reads
# SCRUTINY_WEB_INFLUXDB_HOST / _PORT=8086 (roles/k8s/scrutiny/templates/web.yaml.j2). The
# collector DaemonSet does NOT write here — it posts to scrutiny-web's API, which does the
# InfluxDB writes.
#
# 8086 is the containerPort AND the Service port — verified 2026-08-20, they match.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: scrutiny-influxdb
  namespace: {{ k8s_namespace }}
spec:
  podSelector:
    matchLabels:
      app: scrutiny-influxdb
  policyTypes:
    - Ingress
  ingress:
{# Renders allow-all when the flag is false, so `netpol_baseline_enforced` is a real rollback
   lever. `| bool` for the string trap. Both explained in full in
   networkpolicy-traefik.yaml.j2. #}
{% if netpol_baseline_enforced | bool %}
    - from:
        - podSelector:
            matchLabels:
              app: scrutiny-web
      ports:
        - port: 8086
          protocol: TCP
{% else %}
    # OFF. One empty rule admits everything. `ingress: []` would be the exact opposite and deny
    # everything, which is the easiest thing in this file to get backwards.
    - {}
{% endif %}
