{# DECIDED: authelia's fence stays bespoke although its one rule fits the callers model.
   The callers model (`netpol_from` / `netpol_fences`, macro in
   ansible/templates/networkpolicy.yml.j2) renders one TCP port admitting same-namespace `app:`
   peers, and traefik -> :9091 is that shape. Until #4088 this file also held a cross-namespace
   :6060 prometheus grant, which networkpolicy-crowdsec-sidecars.yaml.j2 now renders. Moving
   the rest onto the authelia entry as `netpol_from` moves a live object between two templates
   under the armed prune, so it is its own change: #4264. Census: #3701.
#}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: authelia
  namespace: {{ k8s_namespace }}
spec:
  podSelector:
    matchLabels:
      app: authelia
  policyTypes:
    - Ingress
  ingress:
{# Renders allow-all when the flag is false, so `netpol_baseline_enforced` is a real rollback
   lever. `| bool` for the string trap. Both explained in full in
   networkpolicy-traefik.yaml.j2. #}
{% if netpol_baseline_enforced | bool %}
    # Traefik is the only in-cluster caller: forwardauth-middleware.yaml.j2 dials
    # authelia.<ns>.svc:9091 from the Traefik pod. Apps behind the middleware never dial
    # authelia themselves -- an Authelia 302 is issued by Traefik before it proxies.
    - from:
        - podSelector:
            matchLabels:
              app: traefik
      ports:
        - port: 9091
          protocol: TCP
    # The crowdsec-agent SIDECAR's :6060 grant is not here: networkpolicy-crowdsec-sidecars.yaml.j2
    # renders it for every pod in crowdsec_k8s_sidecar_agents (#4088).
{% else %}
    # OFF. One empty rule admits everything. `ingress: []` would be the exact opposite and deny
    # everything, which is the easiest thing in this file to get backwards.
    - {}
{% endif %}
