---
# The homelab log store — distinct from `loki` in the observability namespace, which slice 3
# fenced with its own policy (networkpolicy-loki.yaml.j2). Both listen on 3100; do not confuse
# them.
#
# Six callers beyond the baseline, each read from the caller's own template:
#   promtail        — the DaemonSet that ships every pod's logs here (loki-homelab/templates/
#                     promtail-daemonset.yaml.j2). Both nodes; a pod peer covers both.
#   homelab-mcp     — LOKI_URL (homelab-mcp/templates/deployment.yaml.j2)
#   monitor-bridge  — LOKI_URL (monitor-bridge/templates/env-secret.yaml.j2)
#   terraria-stats  — LOKI_URL (terraria-stats/templates/deployment.yaml.j2)
#   valheim-stats   — LOKI_URL (valheim-stats/templates/deployment.yaml.j2)
#   grafana         — a datasource in the OBSERVABILITY namespace (claude-otel/templates/
#                     grafana.yaml.j2). Prometheus scrapes it from there too, but the baseline
#                     already carries that one.
#
# 3100 is the containerPort AND the Service port — verified 2026-08-20, they match.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: loki-homelab
  namespace: {{ k8s_namespace }}
spec:
  podSelector:
    matchLabels:
      app: loki-homelab
  policyTypes:
    - Ingress
  ingress:
{# Renders allow-all when the flag is false, so `netpol_baseline_enforced` is a real rollback
   lever. `| bool` for the string trap. Both explained in full in
   networkpolicy-traefik.yaml.j2. #}
{% if netpol_baseline_enforced | bool %}
    - from:
        - podSelector:
            matchLabels:
              app: promtail
        - podSelector:
            matchLabels:
              app: homelab-mcp
        - podSelector:
            matchLabels:
              app: monitor-bridge
        - podSelector:
            matchLabels:
              app: terraria-stats
        - podSelector:
            matchLabels:
              app: valheim-stats
        # grafana lives in another namespace. namespaceSelector and podSelector are SIBLING KEYS
        # in ONE list item, so they AND together: the grafana pod in observability. Split into
        # two list items they would OR, admitting that entire namespace.
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ k8s_observability_namespace }}
          podSelector:
            matchLabels:
              app: grafana
      ports:
        - port: 3100
          protocol: TCP
{% else %}
    # OFF. One empty rule admits everything. `ingress: []` would be the exact opposite and deny
    # everything, which is the easiest thing in this file to get backwards.
    - {}
{% endif %}
