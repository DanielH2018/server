{#
  The verify Job's identity, INERT until netpol-baseline's flip, as `job.yaml.j2` beside it is.

  The gate initContainer lists EndpointSlices in every namespace the target table dials, so
  each gets a Role and a RoleBinding to the ServiceAccount in `k8s_namespace`. `list` alone:
  the gate reads by label selector and never by name, and it writes nothing.

  The Role in each namespace whose baseline is namespace-scoped also lists `pods`, for the
  exempt-set check. `pod_readers` uses the same scope conditions as `exempt_sets` in
  `job.yaml.j2`. A `pods` list can return whole pod specs, env values included, and RBAC
  cannot narrow it to metadata. The script asks the API server for metadata only
  (`METADATA_ONLY` in files/netpol_baseline_verify.py). The grant itself stays wider than
  that, which is a stated trade.
#}
{% set pod_readers = ([k8s_namespace] if netpol_baseline_scope == 'namespace' else [])
  + ([k8s_observability_namespace] if netpol_baseline_obs_scope == 'namespace' else []) %}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: netpol-baseline-verify
  namespace: {{ k8s_namespace }}
{% for namespace in (netpol_baseline_probe_namespaces.values() | list + pod_readers) | unique | sort %}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: netpol-baseline-verify
  namespace: {{ namespace }}
rules:
  - apiGroups: ["discovery.k8s.io"]
    resources: ["endpointslices"]
    verbs: ["list"]
{% if namespace in pod_readers %}
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["list"]
{% endif %}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: netpol-baseline-verify
  namespace: {{ namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: netpol-baseline-verify
subjects:
  - kind: ServiceAccount
    name: netpol-baseline-verify
    namespace: {{ k8s_namespace }}
{% endfor %}
