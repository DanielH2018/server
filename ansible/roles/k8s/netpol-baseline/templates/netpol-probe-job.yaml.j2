{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% set homelab = netpol_baseline_enforced | bool %}
---
# Proves the policies are ENFORCED, not merely applied. One Job, driven by the target table
# `netpol_baseline_probe_active` (defaults/main.yml). It stands in for a compromised workload
# trying to move laterally: this pod is on no caller list, so every `refused` row must refuse it.
#
# An inverted leg alone proves nothing. "Cannot reach X" is also true when this pod has no
# network, when the policy engine denies everything, and when X is down. Each of those has its own
# leg or gate:
#
#   1. CONTROL — traefik:80, open to every source by design. A failure means this pod has no
#      network or DNS, so nothing below is attributable to a policy.
#   2. SENTINEL — speedtest:80, a FENCED pod whose policy admits this pod's `netpol-probe: control`
#      label (networkpolicy-netpol-sentinel.yaml.j2). A failure means admitted traffic is being
#      denied, so every inverted leg would pass whether or not its policy works.
#   3. LIVENESS — littlelink through traefik, homelab plane only. It is the positive test of the
#      baseline's traefik rule.
#   4. THE TABLE — one `nc` leg per row with an `expect`. A row whose target is down is caught
#      before this Job starts: tasks/main.yml gates every active row on a ready endpoint.
#   5. DNS — pihole answers through its fence, homelab plane only.
#
# THIS JOB RUNS IN {{ k8s_namespace }}, NOT {{ k8s_observability_namespace }}, including for the
# observability rows. The observability baseline admits `podSelector: {}`, every pod in that
# namespace, as an intra-namespace peer. A probe pod placed there would be blocked by nothing, and
# would report the fence broken while the policy is working as designed.
#
# NO HTTP LIVENESS LEG FOR THE OBSERVABILITY ROWS, for a different reason per target. grafana is
# Authelia-gated, so a forwardauth 302 would read as success without reaching the app.
# prometheus's route admits only LAN and node-bridge ClientIPs, so a pod-sourced request fails the
# match before reaching the app. The readiness gate stands in for liveness there.
#
# THE POSITIVE DIRECTION OF THE CALLER LISTS IS NOT PROBED HERE. janitorr's verify.yml opens TCP to
# sonarr, radarr and jellyfin from inside its pod, and sonarr's verify.yml calls its API. Both run
# on every deploy and fail it if a fence is wrong. Extend one of those rather than adding a
# positive leg here.
apiVersion: batch/v1
kind: Job
metadata:
  name: netpol-baseline-probe
  namespace: {{ k8s_namespace }}
spec:
  # Below the `kubectl wait --timeout` in tasks/main.yml, so the Job is the clock that expires
  # first, the pod is terminal and its logs are final when the log fetch runs. Above the worst
  # case of the script under DROP rather than REJECT: the sentinel's 12 x (5s + 5s) retry, the
  # control and liveness timeouts, and 5s per table leg.
  # `ansible/tests/k8s/test_netpol_probe_targets.py` pins the order.
  activeDeadlineSeconds: 300
  backoffLimit: 0
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        # No caller list in the repo names this label. Checked against prometheus-callers and
        # loki-callers too, which admit monitor-bridge, homelab-mcp and homepage.
        app: netpol-baseline-probe
        # Admits this pod to the sentinel (speedtest:80) and nothing else.
        netpol-probe: control
    spec:
      restartPolicy: Never
      enableServiceLinks: false
      automountServiceAccountToken: false
      containers:
        - name: probe
          image: {{ netpol_baseline_k8s_probe_image }}
          command:
            - sh
            - -c
            - |
              set -u
              # 1. CONTROL.
              if ! nc -w 5 -z traefik 80; then
                echo "CONTROL FAILED: cannot reach traefik:80, so nothing below is attributable"
                echo "to the policy. Check DNS and the traefik Service."
                exit 1
              fi
              echo "control ok: traefik:80 reachable"

              # 2. SENTINEL. RETRIED: this is the only leg whose result depends on kube-router
              #    knowing THIS pod's own labels. A Job pod is seconds old when it dials, and
              #    kube-router must add its IP to the ipset behind `netpol-probe: control` first.
              #    Measured 2026-08-20: one immediate attempt fails with the policy, the labels and
              #    the target all correct.
              i=0
              until nc -w 5 -z speedtest 80; do
                i=$((i + 1))
                if [ "$i" -ge 12 ]; then
                  echo "SENTINEL CONTROL FAILED: cannot reach speedtest:80 after 12 attempts,"
                  echo "which the sentinel policy admits this pod to. Either this pod cannot open"
                  echo "connections at all, or admitted traffic is being denied, so every inverted"
                  echo "leg below would pass whether or not its policy works."
                  exit 1
                fi
                sleep 5
              done
              echo "sentinel control ok: speedtest:80 reachable, admitted by policy"
{% if homelab %}

              # 3. LIVENESS. Deliberately littlelink: it has use_authelia: false, so this request
              #    reaches the app. An Authelia-gated app would have forwardauth answer first, and
              #    the leg would pass without contacting the app. littlelink is not the sentinel,
              #    because a target cannot be both admitted and denied.
              if ! wget -q -T 10 --no-check-certificate -O /dev/null \
                   "https://www.local.{{ domain }}/"; then
                echo "LIVENESS FAILED: littlelink is not reachable through traefik. Three causes,"
                echo "and the third is the one that looks like the other two:"
                echo "  1. the app is down;"
                echo "  2. the baseline's traefik rule is wrong;"
                echo "  3. this wget never got as far as the policy: DNS or TLS. busybox wget and"
                echo "     ssl_client are exercised nowhere else in the repo, and Pi-hole answers"
                echo "     AAAA for .local names with ::, which getaddrinfo may try first."
                echo "     Check from inside this pod before touching the policy:"
                echo "       nslookup www.local.{{ domain }}"
                echo "       nc -w 5 -z traefik 443"
                echo "       wget -S -O /dev/null --no-check-certificate https://www.local.{{ domain }}/"
                exit 1
              fi
              echo "liveness ok: littlelink reachable through traefik"
{% endif %}

              # 4. THE TABLE. A `refused` leg is inverted: a connection is the failure.
{% for t in netpol_baseline_probe_active if t.expect is defined %}
{%   set host = t.service if t.plane == 'homelab' else t.service ~ '.' ~ k8s_observability_namespace %}
{%   set lever = 'netpol_baseline_enforced' if t.plane == 'homelab' else 'netpol_baseline_obs_enforced' %}
{%   set port = t.port if t.port is defined else containers_list | entry_port(t.service) %}
{%   if t.expect == 'refused' %}
              if nc -w 5 -z {{ host }} {{ port }}; then
                echo "POLICY NOT ENFORCED: reached {{ host }}:{{ port }} from a pod on no caller list."
                echo "Either {{ lever }} is false, the netpol-baseline label is missing from the"
                echo "target's POD TEMPLATE (spec.template.metadata.labels), or {{ t.policy }}"
                echo "admits too much."
                exit 1
              fi
              echo "isolated: {{ host }}:{{ port }} unreachable from an unlisted caller"
{%   elif t.expect == 'open' %}
              if ! nc -w 5 -z {{ host }} {{ port }}; then
                echo "OPEN PORT FAILED: {{ host }}:{{ port }} refused a connection {{ t.policy }}"
                echo "leaves open to every source."
                exit 1
              fi
              echo "open port ok: {{ host }}:{{ port }} reachable from an unlisted caller, as designed"
{%   endif %}
{% endfor %}
{% if homelab %}

              # 5. DNS. daniel-pi.lan is a pihole-only record: CoreDNS holds no authority for
              #    `.lan`, so the query traverses `forward .`, and Cloudflare (the fallback on that
              #    line) NXDOMAINs it. Resolving it therefore proves pihole itself answered.
              #    Two forms: `daniel-pi.lan` has one dot against the pod's `ndots:5`, and some
              #    BusyBox nslookup builds stop at the first search-list NXDOMAIN. The trailing-dot
              #    form skips the search list. Nothing but pihole answers either form.
              if ! nslookup daniel-pi.lan. >/dev/null 2>&1 &&
                 ! nslookup daniel-pi.lan >/dev/null 2>&1; then
                echo "DNS FAILED: pihole did not answer daniel-pi.lan -- check the pihole policy"
                exit 1
              fi
              echo "dns ok: pihole answered daniel-pi.lan, so :53 is reachable through the fence"
{% endif %}
{{ hardened_security_context() }}
{{ container_resources(cpu_limit='200m', mem_limit='64Mi', cpu_request='10m', mem_request='16Mi') }}
