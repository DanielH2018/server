{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
---
# Proves the baseline is ENFORCED, not merely applied. Four assertions, because the obvious
# single one is not sufficient for this slice: these six apps have no in-cluster caller, so
# "cannot reach littlelink" is true under enforcement, under a missing label, AND when
# littlelink is down. Each assertion below eliminates one of those.
#
# This pod carries NO netpol-baseline label, so the policy does not select it. That is the point
# — it stands in for a compromised workload trying to move laterally.
apiVersion: batch/v1
kind: Job
metadata:
  name: netpol-baseline-probe
  namespace: {{ k8s_namespace }}
spec:
  # Deliberately BELOW the `kubectl wait --timeout=180s` in tasks/main.yml, not equal to it. The
  # two clocks start at different moments, so equal values make it a coin flip which one fires on
  # a slow cold image pull — and the two failures read completely differently. Lower here means
  # the Job is always the clock that expires first, so the pod is terminal (and its logs final)
  # by the time the wait gives up and the log fetch runs. Costs no wall time either way: with
  # backoffLimit: 0 a failed Job never satisfies --for=condition=complete, so the wait burns its
  # full 180s regardless.
  activeDeadlineSeconds: 120
  backoffLimit: 0
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app: netpol-baseline-probe
        # Admits this pod to the sentinel (speedtest:80) and nothing else — see
        # networkpolicy-netpol-sentinel.yaml.j2. It does NOT affect the inverted assertions:
        # no policy in the repo names this label except the sentinel's.
        netpol-probe: control
    spec:
      restartPolicy: Never
      enableServiceLinks: false
      automountServiceAccountToken: false
      containers:
        - name: probe
          image: {{ netpol_baseline_probe_image }}
          command:
            - sh
            - -c
            - |
              # 1. CONTROL — the network and DNS work at all. traefik:80 is open to every source
              #    deliberately (see the spec: narrowing the front door buys nothing and would
              #    break every other probe job's control). A failure here means this probe proves
              #    nothing, rather than meaning the policy failed.
              if ! nc -w 5 -z traefik 80; then
                echo "CONTROL FAILED: cannot reach traefik:80, so nothing below is attributable"
                echo "to the policy. Check DNS and the traefik Service."
                exit 1
              fi
              echo "control ok: traefik:80 reachable"

              # 2. SENTINEL CONTROL — a FENCED pod that explicitly admits this probe is still
              #    reachable. This pod carries `netpol-probe: control`, and
              #    networkpolicy-netpol-sentinel.yaml.j2 admits exactly that label to
              #    speedtest:80. If this fails, either the probe pod cannot open connections at
              #    all or the policy engine is denying admitted traffic — and assertion 4 below
              #    would pass whether or not the policy works.
              #
              #    This leg used to dial homepage:3000, which was reachable only because homepage
              #    was unfenced. Slice 4.5 fences it and slice 5 leaves no unfenced pod at all, so
              #    the control is now a named peer rather than an accident of the rollout order.
              #    RETRIED. This is the only leg here whose result depends on kube-router knowing
              #    THIS pod's OWN labels — assertion 1 dials an open port and assertion 4 asserts
              #    a denial, and neither needs the source pod resolved. A Job pod is seconds old
              #    when it dials, and kube-router must observe it and add its IP to the ipset
              #    behind `netpol-probe: control` first. Measured 2026-08-20: one immediate
              #    attempt fails with the policy, the labels and the target all correct.
              i=0
              until nc -w 5 -z speedtest 80; do
                i=$((i + 1))
                if [ "$i" -ge 12 ]; then
                  echo "SENTINEL CONTROL FAILED: cannot reach speedtest:80 after 60s, which the"
                  echo "sentinel policy admits this pod to. Either this pod cannot open"
                  echo "connections at all, or admitted traffic is being denied. Assertion 4"
                  echo "below would pass whether or not the policy works."
                  exit 1
                fi
                sleep 5
              done
              echo "sentinel control ok: speedtest:80 reachable, admitted by policy"

              # 3. LIVENESS — littlelink is actually UP and Traefik can reach it. Goes through the
              #    Traefik VIP by hostname, which is the real allowed path, so this doubles as the
              #    positive test of the policy's traefik rule. If this fails but 4 passes, the app
              #    is down (or CrowdSec banned this source) and the fencing result is meaningless.
              #
              #    Deliberately littlelink, not bento-pdf: littlelink has use_authelia: false, so
              #    this request reaches the app directly. An Authelia-gated app would have the
              #    forwardauth middleware answer first (401, or a 302 to the login portal) before
              #    Traefik ever proxies to the pod — the probe would then either be permanently
              #    red for a reason unrelated to enforcement, or print "liveness ok" without ever
              #    contacting the app, silently reintroducing the exact false-pass this job exists
              #    to eliminate. If littlelink is ever swapped for an Authelia-gated app, pick
              #    another unauthed one instead of adding a bypass rule for this probe.
              if ! wget -q -T 10 --no-check-certificate -O /dev/null \
                   "https://www.local.{{ domain }}/"; then
                echo "LIVENESS FAILED: littlelink is not reachable through traefik. Three causes,"
                echo "and the third is the one that looks like the other two:"
                echo "  1. the app is down;"
                echo "  2. the baseline's traefik rule is wrong;"
                echo "  3. this wget never got as far as the policy — DNS or TLS. This is the"
                echo "     only busybox-TLS call in the repo, so ssl_client in this image and"
                echo "     busybox wget's option surface are both unexercised, and Pi-hole"
                echo "     answers AAAA for .local names with ::, which getaddrinfo may try"
                echo "     first. Check from inside this pod before touching the policy:"
                echo "       nslookup www.local.{{ domain }}   # does it resolve, and to what"
                echo "       nc -w 5 -z traefik 443            # is the TLS port even open"
                echo "       wget -S -O /dev/null --no-check-certificate https://www.local.{{ domain }}/"
                echo "Assertion 4 below cannot distinguish enforcement from an app that is"
                echo "simply not listening."
                exit 1
              fi
              echo "liveness ok: littlelink reachable through traefik"

              # 4. THE ASSERTION — direct pod-to-pod must FAIL. Inverted: success here is the
              #    failure case. littlelink is deliberately NOT the sentinel from assertion 2 —
              #    a target cannot be both admitted and denied.
              if nc -w 5 -z littlelink 3000; then
                echo "POLICY NOT ENFORCED: reached littlelink:3000 directly from a pod that"
                echo "carries no netpol-baseline label. Either netpol_baseline_enforced is false,"
                echo "or the label is missing from littlelink's POD TEMPLATE (check"
                echo "spec.template.metadata.labels, not spec.selector.matchLabels)."
                exit 1
              fi
              echo "isolated: littlelink:3000 unreachable except through traefik"
{{ hardened_security_context() }}
{{ container_resources(cpu_limit='200m', mem_limit='64Mi', cpu_request='10m', mem_request='16Mi') }}
