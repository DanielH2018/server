---
# Authelia's session store. authelia dials it at session.redis.host=authelia-redis
# (roles/k8s/authelia/templates/config-secret.yaml.j2), and nothing else does.
#
# 6379 is the containerPort AND the Service port — verified 2026-09-10, they match, and
# ansible/tests/services/test_authelia_redis_sessions.py keeps them matching.
#
# The crowdsec agent sidecar shares the authelia pod, so it arrives here carrying `app:
# authelia` too. That is a property of pod-level identity, not a second rule to write — see
# "A sidecar carries its host pod's network identity" in project memory.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: authelia-redis
  namespace: {{ k8s_namespace }}
spec:
  podSelector:
    matchLabels:
      app: authelia-redis
  policyTypes:
    - Ingress
  ingress:
{# Renders allow-all when the flag is false, so `netpol_baseline_enforced` is a real rollback
   lever. `| bool` for the string trap. Both explained in full in
   networkpolicy-traefik.yaml.j2. #}
{% if netpol_baseline_enforced | bool %}
    - from:
        - podSelector:
            matchLabels:
              app: authelia
      ports:
        - port: 6379
          protocol: TCP
{% else %}
    # OFF. One empty rule admits everything. `ingress: []` would be the exact opposite and deny
    # everything, which is the easiest thing in this file to get backwards.
    - {}
{% endif %}
