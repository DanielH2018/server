---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: traefik
  namespace: {{ k8s_namespace }}
spec:
  podSelector:
    matchLabels:
      app: traefik
  policyTypes:
    - Ingress
  ingress:
    # The front door. Open to every source on purpose: these ports already take LAN, WireGuard
    # and Cloudflare traffic, and ETP=Local preserves the client IP, so an ipBlock list here
    # would have to enumerate the internet. :80 in particular must stay open for the
    # http->https redirect entrypoint (static-config.yaml.j2, entryPoint.to: ":443") -- every
    # client that arrives on plain HTTP hits that redirect before reaching :443. It also keeps
    # all four netpol probe control legs working -- each dials traefik:80 to prove the probe
    # itself has a network. (uptime-kuma's monitors do NOT depend on :80: they're https:// and
    # so traverse :443, or for the Pi services dial daniel-pi directly, bypassing traefik.)
    - ports:
        - port: 80
          protocol: TCP
        - port: 443
          protocol: TCP
    # :8080 is the port worth fencing. prometheus moved to the observability namespace in
    # slice 3, so this is cross-namespace: namespaceSelector and podSelector are siblings in
    # ONE from item, which ANDs them. As separate items they would OR, admitting every pod in
    # observability and every prometheus anywhere.
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: observability
          podSelector:
            matchLabels:
              app: prometheus
      ports:
        - port: 8080
          protocol: TCP
