# DIGEST-PINNED — see roles/k8s/ical-proxy/templates/Dockerfile.j2 for why a version tag alone is
# not a pin. Same base, same digest: Renovate groups the two into one PR, so they stay in step.
FROM python:3.14-slim@sha256:656d12e70054d5fda18a045e2494c96701e9792dd1445f95b3d038df954f57e9
WORKDIR /app
# mcp pinned <2: 2.0.0 (picked up by the 2026-08-09 Sunday rebuild, Docker era) removed
# mcp.server.fastmcp and crash-looped the container. Lift the pin only with an
# app.py port to the 2.x API.
RUN pip install --no-cache-dir 'mcp<2' httpx uvicorn
# COPY . (not `COPY app.py safe_reads.py`): the context is a ConfigMap mount, whose
# files are symlinks into ..data/, and buildkit's followPaths optimization for a
# multi-file COPY drops all but the first symlinked file from the transfer ("not
# found", verified 2026-08-13 — a single-file COPY like n8n-runners' works). COPY .
# ships the whole snapshot, so the ..data dir arrives and every symlink resolves.
# The image gains the Dockerfile + ConfigMap dotdirs under /app — harmless.
COPY . ./
CMD ["python", "app.py"]
