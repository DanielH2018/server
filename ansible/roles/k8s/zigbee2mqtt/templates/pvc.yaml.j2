---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ zigbee2mqtt_k8s_claim }}
  namespace: {{ k8s_namespace }}
spec:
  # Migrated from the Docker data dir at cutover (until 2026-08-14).
  # database.db + devices.yaml + coordinator_backup.json are the device pairings — see the
  # storage-class note in defaults.
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ zigbee2mqtt_k8s_storage_class }}
  resources:
    requests:
      storage: {{ zigbee2mqtt_k8s_size }}
