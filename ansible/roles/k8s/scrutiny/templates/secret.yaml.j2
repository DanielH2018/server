---
{% set _webhook_parts = (monitor_discord_webhook_url | string | trim).rstrip('/').split('/') %}
# defaultMode 0444 at the mounts, not 0400: secret-volume files are root-owned and the
# influxdb/web processes drop to non-root — the recurring 0400-unreadable trap.
apiVersion: v1
kind: Secret
metadata:
  name: scrutiny-influxdb-credentials
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  influxdb_admin_password: "{{ scrutiny_influxdb_admin_password }}"
  influxdb_token: "{{ scrutiny_influxdb_token }}"
  # Shoutrrr form of the shared "Homelab Alerts" Discord webhook, the same channel Kuma
  # posts to (monitor_discord_webhook_url). Scrutiny speaks shoutrrr, not raw webhooks, so
  # `https://discord.com/api/webhooks/<id>/<token>` becomes `discord://<token>@<id>` — derived
  # here rather than stored as a second SOPS value, so a rotation of the webhook moves one key.
  # `| string` is load-bearing: the CI render guard stubs every SOPS value with an undefined
  # object, and calling `.split()` on that aborts the render. Malformed input is caught at
  # deploy time by the assert in tasks/main.yml, which sees the real value.
  notify_url: "discord://{{ _webhook_parts[-1] }}@{{ _webhook_parts[-2] | default('', true) if _webhook_parts | length > 1 else '' }}"
