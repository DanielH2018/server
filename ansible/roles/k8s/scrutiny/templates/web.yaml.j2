{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
---
# Web UI + API. The Service is named `scrutiny` (not scrutiny-web) because the shared
# ingressroute macro names the Service after the containers_list entry — and it keeps
# COLLECTOR_API_ENDPOINT=http://scrutiny:8080 identical to the Docker compose for the
# DaemonSet below.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: scrutiny-web
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: scrutiny-web
  template:
    metadata:
      labels:
        app: scrutiny-web
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      automountServiceAccountToken: false
      priorityClassName: homelab-best-effort
      # Preference, never a pin: daniel-box carries the storage- and VIP-pinned workloads and runs the hotter of the two nodes, so latency-insensitive services default here.
      # Weighted so the pod still schedules if daniel-server is cordoned or full.
{{ node_affinity_preference('daniel-server') }}
      initContainers:
        # scrutiny-web calls InfluxDB's `/api/v2/setup` during AppEngine.Setup and PANICS on a
        # connection error instead of retrying. The `panic(err)` is upstream in
        # webapp/backend/pkg/web/middleware/repository.go and the error string is built in
        # webapp/backend/pkg/database/scrutiny_repository.go. Both were read against upstream
        # master on 2026-09-06: neither has gained a retry (the middleware file's last commit
        # is from 2022), so the rolling `master-web` digest this role pins will not fix this on
        # its own, and this gate stays needed until upstream retries.
        #
        # A readiness/liveness tweak cannot cover it — the panic happens during startup, before
        # either probe is in play. Connecting to the SERVICE rather than a pod is what makes
        # this a readiness gate: scrutiny-influxdb has no endpoints until its `influx ping`
        # probe passes. The retry also absorbs kube-router's source-pod lookup lagging pod
        # creation, which a single connect attempt at init time would trip over.
        #
        # Bounded, not unbounded — 60 x 2s, the same shape as crowdsec's wait-for-lapi. If
        # influxdb is still unreachable after two minutes the init container fails and the pod
        # backs off exactly as it does today, so this can only improve on the current behaviour,
        # never mask a genuinely dead influxdb.
        #
        # The web image is debian-slim carrying `curl` (upstream docker/Dockerfile.web) and is
        # already this pod's own image, so nothing extra is pulled. `-sf`, not bare `-s`: curl
        # exits 0 on a 5xx without `-f`. `--max-time 5` so a half-open connection retries rather
        # than stalling the loop. `/api/v2/setup` is the exact unauthenticated request that
        # panics, so this gates on the request scrutiny actually makes rather than a neighbour.
        - name: wait-for-influxdb
          image: {{ scrutiny_k8s_web_image }}
          command:
            - /bin/sh
            - -c
            - >-
              i=0;
              until curl -sf --max-time 5 -o /dev/null http://scrutiny-influxdb:8086/api/v2/setup; do
                i=$((i+1));
                [ "$i" -ge 60 ] && echo "scrutiny-influxdb still unreachable after 120s" >&2 && exit 1;
                sleep 2;
              done;
              echo "scrutiny-influxdb reachable after $((i*2))s"
          # read_only: the whole program is the shell loop above, and curl writes to /dev/null.
          # It needs no writable path, so no emptyDir goes with this.
{{ hardened_security_context(read_only=true) }}
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
      containers:
        - name: web
          image: {{ scrutiny_k8s_web_image }}
          # No _FILE convention in scrutiny, so a wrapper exports the influxdb token from
          # the Secret mount before exec'ing the binary — same idiom as the Docker copy
          # (there: keeping it out of docker-proxy-readable Env; here: out of the pod spec).
          # SCRUTINY_NOTIFY_URLS rides the same wrapper for the same reason: it embeds the
          # Discord webhook token. The name is `SCRUTINY_` + the dotted config path, and the
          # path is top-level `notify.urls` — NOT `web.notify.urls`, so `SCRUTINY_WEB_NOTIFY_URLS`
          # would render, boot and notify nothing. Upstream's `c.SetDefault("notify.urls", ...)`
          # in webapp/backend/pkg/config/config.go is the source. Viper reads the single-URL
          # string into the []string it expects. `notify.level` is deliberately NOT set: upstream
          # rejects it at startup (ConfigValidationError, same file) — the level moved to the
          # dashboard Settings page, which is SQLite state in the config PVC.
          command:
            - /bin/sh
            - -c
            - 'export SCRUTINY_WEB_INFLUXDB_TOKEN="$(cat /etc/scrutiny-secrets/influxdb_token)"; export SCRUTINY_NOTIFY_URLS="$(cat /etc/scrutiny-secrets/notify_url)"; exec /opt/scrutiny/bin/scrutiny start'
          # Runs as root writing its SQLite config DB + WAL in the PVC mount; the
          # Docker copy leaned on the default cap set for the same reason.
{{ hardened_security_context(add=['DAC_OVERRIDE']) }}
          env:
            - name: SCRUTINY_WEB_INFLUXDB_HOST
              value: scrutiny-influxdb
            - name: SCRUTINY_WEB_INFLUXDB_PORT
              value: "8086"
            - name: SCRUTINY_WEB_INFLUXDB_ORG
              value: scrutiny
            - name: SCRUTINY_WEB_INFLUXDB_BUCKET
              value: metrics
            - name: TZ
              value: {{ tz }}
          ports:
            - name: http
              containerPort: 8080
          volumeMounts:
            - name: scrutiny-web-config
              mountPath: /opt/scrutiny/config
            # /etc, NOT /run/secrets — see the influxdb manifest's note.
            - name: scrutiny-web-credentials
              mountPath: /etc/scrutiny-secrets
              readOnly: true
          readinessProbe:
            httpGet:
              path: /api/health
              port: 8080
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /api/health
              port: 8080
            initialDelaySeconds: 60
            periodSeconds: 30
{{ container_resources(cpu_limit='500m', mem_limit='512Mi', cpu_request='50m', mem_request='64Mi') }}
      volumes:
        - name: scrutiny-web-config
          persistentVolumeClaim:
            claimName: {{ scrutiny_k8s_config_claim }}
        - name: scrutiny-web-credentials
          secret:
            secretName: scrutiny-influxdb-credentials
            defaultMode: 0o444
---
apiVersion: v1
kind: Service
metadata:
  name: scrutiny
  namespace: {{ k8s_namespace }}
spec:
  selector:
    app: scrutiny-web
  ports:
    - port: {{ container_item.port }}
      targetPort: 8080
