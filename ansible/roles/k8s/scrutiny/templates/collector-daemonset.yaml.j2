---
# SC3: the collector runs on every node — today daniel-box only, which ADDS its
# never-monitored NVMe; the Phase F join extends it to daniel-server automatically and
# retires the Docker spoke there.
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: scrutiny-collector
  namespace: {{ k8s_namespace }}
spec:
  selector:
    matchLabels:
      app: scrutiny-collector
  template:
    metadata:
      labels:
        app: scrutiny-collector
    spec:
      # Phase F drain (2026-08-13): unpinned — the DaemonSet covers both nodes and the
      # Docker spoke on daniel-server retired with it. Both hosts' SMART source is the
      # same /dev/nvme0 controller path (verified on daniel-server before the unpin).
      enableServiceLinks: false
      # No serviceAccountName is set (defaults SA) and the collector never talks to the API
      # server, so it has no use for the token — and a privileged pod is the last place to
      # leave one mounted anyway.
      automountServiceAccountToken: false
      priorityClassName: homelab-best-effort
      containers:
        - name: collector
          image: {{ scrutiny_k8s_collector_image }}
          securityContext:
            # The SC3 open question, resolved 2026-08-10: the Docker cap set
            # (SETUID/SETGID/SYS_RAWIO/SYS_ADMIN) + a CharDevice hostPath is NOT enough
            # under k8s — the device cgroup still refuses the open (`smartctl --info
            # --device nvme /dev/nvme0` → exit status 2, device detected but unreadable).
            # Unlike Docker's `devices:`, k8s has no per-device grant short of a device
            # plugin, so this DaemonSet is privileged — the node-exporter-style trade for
            # host-hardware readers.
            privileged: true
          env:
            - name: COLLECTOR_API_ENDPOINT
              # The in-cluster Service — no route, no Authelia in the path.
              value: http://scrutiny:{{ container_item.port }}
            - name: COLLECTOR_CRON_SCHEDULE
              value: "{{ scrutiny_k8s_collector_cron }}"
            - name: TZ
              value: {{ tz }}
          volumeMounts:
            - name: udev
              mountPath: /run/udev
              readOnly: true
            - name: nvme
              mountPath: /dev/nvme0
            - name: config
              mountPath: /opt/scrutiny/config
          resources:
            limits:
              cpu: "500m"
              memory: 256Mi
            requests:
              cpu: "50m"
              memory: 32Mi
      volumes:
        - name: udev
          hostPath:
            path: /run/udev
        - name: nvme
          hostPath:
            path: /dev/nvme0
            type: CharDevice
        - name: config
          configMap:
            name: scrutiny-collector-config
