{% from 'ingressroute.yml.j2' import ingressroute with context %}
{#
  Gated on the replica count, because a route to a workload with no pods is not free.
  Traefik's kubernetescrd provider re-reads every IngressRoute on each config refresh and
  logs `error ... no servers found for homelab/navidrome` whenever the EndpointSlice behind
  one is empty — every ~20s, forever, while navidrome sits at replicas 0. That drowns the
  traefik log, which is where a real edge failure shows up first (issue #1323; diagnosing
  the 2026-09-06 edge 404 in #1322 needed `grep -v navidrome` before anything was visible).

  Rendering nothing is only half the retirement: `tasks/main.yml` also deletes the live
  IngressRoute while the workload is parked. See the comment there.
#}
{% if navidrome_k8s_replicas | int > 0 %}
---
{{ ingressroute(
    container_item.name,
    container_item.hostname | default(container_item.name),
    container_item.port,
    container_item.use_authelia,
  )
}}
{% else %}
# navidrome is parked at navidrome_k8s_replicas: 0 — no route while parked (issue #1323).
{% endif %}
