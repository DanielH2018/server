---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mosquitto
  namespace: {{ k8s_namespace }}
spec:
  replicas: 1
  # ReadWriteOnce PVC on single-replica Longhorn — a rolling update would deadlock on the volume.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: mosquitto
  template:
    metadata:
      labels:
        app: mosquitto
        netpol-baseline: enforced
    spec:
      # Pinned to the VIP-announcing node while the MetalLB L2Advertisement is pinned
      # to daniel-box: with externalTrafficPolicy Local, a VIP-backed pod on the other
      # node makes the announcer DROP all forwarded LAN traffic (2026-08-14 post-boot
      # DNS blackout). Permanent posture (operator decision 2026-08-14): with ETP Local
      # load-bearing for client IPs, announcement and placement stay on daniel-box as one
      # unit — this pin only ever moves together with the L2Advertisement nodeSelector.
      nodeSelector:
        kubernetes.io/hostname: daniel-box
      enableServiceLinks: false
      securityContext:
        runAsUser: {{ puid }}
        runAsGroup: {{ pgid }}
        fsGroup: {{ pgid }}
      # mosquitto 2.1's password-file plugin refuses the pwfile straight off a Secret mount
      # ("Unable to open pwfile") even though a plain open() of the same path succeeds — the
      # root-owned ..data symlink farm fails whatever ownership/symlink check the plugin does.
      # Reproduced 2026-08-08 with a probe pod: secret-mounted copy fails, a cp'd uid-1000 copy
      # starts clean. So an init container copies both files into an emptyDir the pod owns.
      initContainers:
        - name: config-copy
          image: {{ mosquitto_k8s_image }}
          command:
            - sh
            - -c
            # install -m 400: mosquitto also refuses a world-readable password file, and cp
            # would create one via the default umask.
            - install -m 444 /secret/mosquitto.conf /config/ &&
              install -m 400 /secret/passwordfile /config/
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - name: mosquitto-config-secret
              mountPath: /secret
              readOnly: true
            - name: mosquitto-config
              mountPath: /config
          resources:
            limits:
              cpu: 250m
              memory: 128Mi
            requests:
              cpu: 10m
              memory: 16Mi
      automountServiceAccountToken: false
      priorityClassName: homelab-automation
      containers:
        - name: mosquitto
          image: {{ mosquitto_k8s_image }}
          ports:
            - containerPort: 1883
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          env:
            - name: TZ
              value: "{{ tz }}"
          volumeMounts:
            - name: mosquitto-config
              mountPath: /mosquitto/config
              readOnly: true
            - name: mosquitto-data
              mountPath: /mosquitto/data
            # Image declares VOLUME /mosquitto/log; mount scratch over it so the read-only
            # rootfs doesn't block the implicit volume. Stays empty (log_dest is stdout) —
            # same reason the compose template bind-mounts ./log.
            - name: mosquitto-log
              mountPath: /mosquitto/log
          # TCP probes, not the compose healthcheck's authenticated $SYS subscribe: an exec
          # probe would embed the SOPS MQTT password in the pod spec, which the read-only
          # kubeconfig can read. A listener that accepts TCP is what the clients need anyway.
          readinessProbe:
            tcpSocket:
              port: 1883
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            tcpSocket:
              port: 1883
            initialDelaySeconds: 15
            periodSeconds: 30
          resources:
            limits:
              cpu: "{{ mosquitto_k8s_cpu_limit }}"
              memory: {{ mosquitto_k8s_mem_limit }}
            requests:
              cpu: "{{ mosquitto_k8s_cpu_request }}"
              memory: {{ mosquitto_k8s_mem_request }}
      volumes:
        - name: mosquitto-config-secret
          secret:
            secretName: mosquitto-config
            # 288 = 0440 (decimal — the YAML-1.1 parser behind kubectl reads 0o440 as a
            # string). Only the init container reads this; the broker gets the owned copy.
            defaultMode: 288
        - name: mosquitto-config
          emptyDir: {}
        - name: mosquitto-data
          persistentVolumeClaim:
            claimName: {{ mosquitto_k8s_claim }}
        - name: mosquitto-log
          emptyDir: {}
