---
apiVersion: v1
kind: Secret
metadata:
  name: mosquitto-config
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  # Same config the Docker role templates, minus the bind-path comments. A Secret rather than a
  # ConfigMap because the password file rides along — one mounted volume, one object to rotate.
  mosquitto.conf: |
    listener 1883
    allow_anonymous false
    password_file /mosquitto/config/passwordfile
    persistence true
    persistence_location /mosquitto/data/
    log_dest stdout
{# Username comes solely from mqtt_username (single source of truth); strip any `user:` prefix
   baked into the stored hash so the two can never drift — same treatment as the Docker role,
   via split rather than regex_replace (the manifest-validator hook renders with plain Jinja2,
   which has no Ansible filters; the PBKDF2 hash itself never contains a colon). The `| string`
   coercion is for the same hook: its StubUndefined stands in for the SOPS value and survives
   rendering, but not a direct method call. #}
  passwordfile: |
    {{ mqtt_username }}:{{ (mqtt_password_hash | string).split(':', 1) | last }}
