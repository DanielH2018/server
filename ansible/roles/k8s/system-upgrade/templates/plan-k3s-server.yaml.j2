# The k3s server Plan (H6). It selects the control-plane node named in `system_upgrade_nodes`, and
# NO node while that list is empty: the list renders `no-node-selected`, a hostname no node
# carries. `concurrency: 1` with no cordon and no drain, because the runbook neither cordons nor
# drains and a failed Job would leave a cordoned node cordoned. `prepare` runs the gate script
# from the host package, so a node without the package fails `prepare`, the closed direction.
# The script and its `server` mode arrive with H6.3a, and no Plan selects a node before them.
apiVersion: upgrade.cattle.io/v1
kind: Plan
metadata:
  name: k3s-server
  namespace: system-upgrade
spec:
  concurrency: 1
  version: "{{ k3s_version }}"
  serviceAccountName: k3s-plan
  jobActiveDeadlineSecs: {{ system_upgrade_server_deadline_secs }}
  nodeSelector:
    matchExpressions:
      - key: node-role.kubernetes.io/control-plane
        operator: In
        values:
          - "true"
      - key: kubernetes.io/hostname
        operator: In
        values:
{% for node in (system_upgrade_nodes or ['no-node-selected']) %}
          - {{ node }}
{% endfor %}
      - key: homelab/k3s-upgrade-paused
        operator: DoesNotExist
  prepare:
    image: {{ system_upgrade_gate_image }}
    command:
      - python3
    args:
      - /host/usr/lib/homelab/k3s_gates.py
      - server
      - --host-root
      - /host
  upgrade:
    image: rancher/k3s-upgrade
