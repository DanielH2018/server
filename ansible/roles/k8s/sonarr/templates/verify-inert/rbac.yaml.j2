{#
  The verify Job's identity, INERT until sonarr's flip, as `job.yaml.j2` beside it is.

  It is a ServiceAccount with no Role. The Job reads sonarr's API over the pod network and
  execs into no pod, so it needs no Kubernetes grant, and its pod mounts no token.
#}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: sonarr-verify
  namespace: {{ k8s_namespace }}
automountServiceAccountToken: false
