{% from 'container-resources.yml.j2' import job_container_resources with context %}
{% from 'security-context.yml.j2' import job_hardened_security_context with context %}
{#
  Removes and blocklists a queued grab whose release was published before its episode aired.
  files/sonarr_air_date_guard.py holds the rule and why each exception is safe; this file only
  schedules it. sonarr_k8s_air_date_guard_apply false makes every run, the deploy gate's
  included, a dry-run report.

  DECIDED: the pod carries `app: sonarr-verify`, the label of the Jobs in templates/verify/,
  which sonarr's `netpol_from` already admits. Its own label would need a `netpol_from` entry in
  ansible/inventory/, a broad change for one caller of one port; the qbittorrent Jobs reuse
  labels the same way.
#}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: sonarr-air-date-guard
  namespace: {{ k8s_namespace }}
data:
  sonarr_air_date_guard.py: |
{{ lookup('file', playbook_dir + '/roles/k8s/sonarr/files/sonarr_air_date_guard.py') | indent(4, true) }}
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: sonarr-air-date-guard
  namespace: {{ k8s_namespace }}
spec:
  schedule: "{{ sonarr_k8s_air_date_guard_schedule }}"
  timeZone: "{{ tz }}"
  # The deploy gate creates a Job from this CronJob out of schedule. An overlapping run finds
  # the queue the first one left, so it removes nothing the first one did not.
  concurrencyPolicy: Forbid
  startingDeadlineSeconds: 120
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      activeDeadlineSeconds: {{ sonarr_k8s_air_date_guard_deadline_seconds }}
      ttlSecondsAfterFinished: {{ sonarr_k8s_air_date_guard_job_ttl_seconds }}
      # No retry. The next run is five minutes away and reads the queue afresh.
      backoffLimit: 0
      template:
        metadata:
          labels:
            # See the DECIDED note above.
            app: sonarr-verify
            netpol-baseline: enforced
        spec:
          restartPolicy: Never
          enableServiceLinks: false
          automountServiceAccountToken: false
          priorityClassName: homelab-best-effort
          containers:
            - name: air-date-guard
              image: {{ sonarr_k8s_air_date_guard_image }}
              imagePullPolicy: IfNotPresent
              command:
                - python3
                - /script/sonarr_air_date_guard.py
                - --grace-hours={{ sonarr_k8s_air_date_guard_grace_hours }}
                - --exempt-tag={{ sonarr_k8s_air_date_guard_exempt_tag }}
                - --max-removals={{ sonarr_k8s_air_date_guard_max_removals }}
{% for series_type in sonarr_k8s_air_date_guard_skip_series_types %}
                - --skip-series-type={{ series_type }}
{% endfor %}
{% if sonarr_k8s_air_date_guard_apply | bool %}
                - --apply
{% endif %}
              env:
                - name: SONARR_URL
                  value: http://{{ container_item.name }}.{{ k8s_namespace }}.svc.cluster.local:{{ container_item.port }}
                - name: SONARR_API_KEY
                  valueFrom:
                    secretKeyRef:
                      name: sonarr-exportarr
                      key: api_key
                - name: PYTHONDONTWRITEBYTECODE
                  value: "1"
{{ job_hardened_security_context(read_only=true, non_root=true, run_as_user=1000, run_as_group=1000) }}
              volumeMounts:
                - name: air-date-guard-script
                  mountPath: /script
                  readOnly: true
{{ job_container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='32Mi') }}
          volumes:
            - name: air-date-guard-script
              configMap:
                name: sonarr-air-date-guard
