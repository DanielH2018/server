apiVersion: v1
kind: Secret
metadata:
  # Named by `etcd-s3-config-secret` in hosts/components/k3s-server/component.yml's
  # `k3s_server_config`. k3s reads it from kube-system at each scheduled snapshot, not at start,
  # so a missing Secret costs an upload and never a control-plane boot (H2.8a).
  name: k3s-etcd-snapshot-s3-config
  namespace: kube-system
type: etcd.k3s.cattle.io/s3-config-secret
# `stringData:` with bare placeholders, for the reason longhorn-b2-secret.yaml.j2 gives. The
# bucket, endpoint and folder are the ones the off-box cron in setup/k3s uploads to, so both
# writers share one `etcd-snapshots/offbox-*` prefix until H2.8b retires the cron.
stringData:
  etcd-s3-endpoint: "{{ r2_account_id }}.r2.cloudflarestorage.com"
  etcd-s3-bucket: "{{ r2_bucket }}"
  etcd-s3-access-key: "{{ r2_access_key_id }}"
  etcd-s3-secret-key: "{{ r2_secret_access_key }}"
  etcd-s3-folder: etcd-snapshots
  # The R2 BackupTarget's region; the render test holds the two equal.
  etcd-s3-region: "{{ k3s_longhorn_r2_region }}"
