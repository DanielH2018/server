apiVersion: v1
kind: Secret
metadata:
  name: longhorn-b2
  namespace: longhorn-system
type: Opaque
# `stringData:` with bare placeholders, because Flux substitutes `${key}` from
# `homelab-cluster-vars` and R2's rule 5 refuses a secret key under a filter such as `b64encode`.
# The Ansible-era template used `data:` with `b64encode` so that client-side `kubectl apply` did
# not report `configured` on every run (#4341). Flux applies server-side, so that reason is gone.
stringData:
  AWS_ACCESS_KEY_ID: "{{ longhorn_b2_key_id }}"
  AWS_SECRET_ACCESS_KEY: "{{ longhorn_b2_application_key }}"
  # The region is a plain variable (defaults/main.yml), so this value holds no placeholder.
  AWS_ENDPOINTS: "https://s3.{{ k3s_longhorn_b2_region }}.backblazeb2.com"
