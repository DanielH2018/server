---
# The three credentials check.py reads from FILES, kept in their own Secret so they can be
# mounted without also being injected.
#
# They sat in monitor-bridge-env until 2026-08-16. That Secret is consumed by `envFrom`, and
# `envFrom.secretRef` has no per-key filter — it injects every key as an environment variable.
# So the 0440 file mount was real but not exclusive: the same values were also in the pod's
# environment, which is what the *_FILE indirection exists to prevent (2026-07-15 review, H2).
#
# ha_token is an unscoped Home Assistant long-lived access token (full control of the house),
# and b2_probe_application_key is the same B2 credential Longhorn's backup target uses.
#
# Nothing here may be added to monitor-bridge-env, and nothing envFrom needs may be added here.
# That split is the entire point of the file.
apiVersion: v1
kind: Secret
metadata:
  name: monitor-bridge-credentials
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  ha_token: "{{ monitor_bridge_ha_token }}"
  b2_probe_application_key: "{{ kopia_b2_application_key }}"
  cf_analytics_token: "{{ cloudflare_analytics_token }}"
