---
# The twin's whole env, as a Secret (it is mostly push tokens + API keys; splitting the
# handful of plain thresholds into a ConfigMap would double the surface for no gain).
# Sources and reasoning are documented on the Docker compose template this ports
# (roles/containers/archive/monitor-bridge/templates/docker-compose.yml.j2); only what CHANGED
# in the move is commented here.
apiVersion: v1
kind: Secret
metadata:
  name: monitor-bridge-env
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  TZ: "{{ tz }}"
  PYTHONUNBUFFERED: "1"
  PYTHONDONTWRITEBYTECODE: "1"
  INTERVAL: "300"
  GRACE_CYCLES: "2"
  # No CHECKS_SKIP since the Docker uninstall (2026-08-14): the remnant is gone and
  # this deployment runs every check. The gitops pair re-pointed at daniel-box's own
  # deployer — state via the hostPath mount in deployment.yaml.j2 (the pod is pinned
  # to that node); thresholds unchanged from the remnant era.
  GITOPS_STATE_DIR: /gitops-state
  GITOPS_MAX_AGE_MIN: "90"
  GITOPS_BEHIND_MAX_MIN: "360"
  KUMA_PUSH_GITOPS_ALIVE: "{{ monitor_bridge_gitops_alive_push_token }}"
  KUMA_PUSH_GITOPS_STATUS: "{{ monitor_bridge_gitops_status_push_token }}"
  KUMA_PUSH_ETCD_DRILL: "{{ monitor_bridge_etcd_drill_push_token }}"
  # In-cluster Service names replace the -k8s LAN routes: no VIP, no Traefik, no
  # Authelia/ClientIP gate in a probe's path. The Kuma HTTP monitors keep watching the
  # routed paths, so edge coverage is not lost by probing natively here.
  # PROM_ORIGIN derives from these two being EQUAL — keep them identical strings.
  # They name ONE instance post-migration: the Docker Prometheus retired with the Docker plane
  # on 2026-08-14, so the prometheus and cluster_prometheus gates observe the same endpoint and
  # fail together. The vars stay split to preserve the split-brain option — a second Prometheus
  # can be reintroduced by pointing one of them elsewhere, without re-deciding which gate watches
  # which check. Do not read the pair as independent coverage.
  PROMETHEUS_URL: http://prometheus.{{ k8s_observability_namespace }}.svc.cluster.local:9090
  CLUSTER_PROMETHEUS_URL: http://prometheus.{{ k8s_observability_namespace }}.svc.cluster.local:9090
  KUMA_URL: http://uptime-kuma.{{ k8s_namespace }}.svc.cluster.local:3001
  DISK_MOUNTPOINTS: /,/boot,/boot/efi
  DISK_MAX_PCT: "90"
  CERT_MIN_DAYS: "14"
  MEM_MAX_PCT: "90"
  TRAEFIK_5XX_PCT: "5"
  TRAEFIK_MIN_RPS: "0.05"
  TARGETS_MIN: "1"
  CLUSTER_TARGETS_MIN: "3"
  # Distinct hosts check_disk and check_mem must see before they trust their own numbers. Two,
  # because node-exporter is a DaemonSet on both nodes and a vector covering one has lost a host
  # rather than measured a healthy estate. Rendered here rather than left to check.py's default
  # so there is a way OUT: a planned single-node maintenance window otherwise turns both checks
  # permanently red with no knob to reach for (2026-08-23b review L3). Set to "1" for the
  # duration, then put it back — at 1 the arm is inert and the survivor is monitored silently,
  # which is the exact failure it was added for on 2026-08-23.
  HOST_ORIGINS_MIN: "2"
  # Coverage floor for the three cAdvisor checks. Rendered here for the same reason as
  # HOST_ORIGINS_MIN — a way out without a code change. Derived from the 7d pre-filter troughs
  # (98 restarts / 98 oom / 70 cpu, live 99/99/71 on 2026-08-27); see cadvisor_coverage_shortfall.
  # Lowering it below ~70 blinds the cpu arm first, since it sees only pods with a cpu limit.
  CADVISOR_PODS_MIN: "20"
  K8S_MIN_WORKLOADS: "5"
  K8S_MIN_DAEMONSETS: "9"
  KUMA_PUSH_DISK: "{{ monitor_bridge_disk_push_token }}"
  KUMA_PUSH_CERT: "{{ monitor_bridge_cert_push_token }}"
  KUMA_PUSH_MEM: "{{ monitor_bridge_mem_push_token }}"
  # Retargeted 2026-08-14 (Phase G): the restart/OOM/throttle depth checks re-armed
  # against the kubernetes-cadvisor job, same tokens as their Docker-era monitors.
  KUMA_PUSH_RESTARTS: "{{ monitor_bridge_restarts_push_token }}"
  KUMA_PUSH_OOM: "{{ monitor_bridge_oom_push_token }}"
  KUMA_PUSH_CPU: "{{ monitor_bridge_cpu_push_token }}"
  KUMA_PUSH_TARGETS: "{{ monitor_bridge_targets_push_token }}"
  KUMA_PUSH_TRAEFIK: "{{ monitor_bridge_traefik_push_token }}"
  KUMA_PUSH_TRAEFIK_LATENCY: "{{ monitor_bridge_traefik_latency_push_token }}"
  KUMA_PUSH_PROMETHEUS: "{{ monitor_bridge_prometheus_push_token }}"
  N8N_URL: http://n8n.{{ k8s_namespace }}.svc.cluster.local:5678
  N8N_API_KEY: "{{ n8n_api_key }}"
  N8N_FAIL_WINDOW: 2h
  N8N_CONSECUTIVE_MAX: "3"
  N8N_SYSTEMIC_STREAK: "2"
  N8N_SYSTEMIC_MAX: "2"
  KUMA_PUSH_N8N: "{{ monitor_bridge_n8n_push_token }}"
  SONARR_URL: http://sonarr.{{ k8s_namespace }}.svc.cluster.local:8989
  SONARR_API_KEY: "{{ sonarr_api_key }}"
  RADARR_URL: http://radarr.{{ k8s_namespace }}.svc.cluster.local:7878
  RADARR_API_KEY: "{{ radarr_api_key }}"
  KUMA_PUSH_ARR_QUEUE: "{{ monitor_bridge_arr_queue_push_token }}"
  BAZARR_URL: http://bazarr.{{ k8s_namespace }}.svc.cluster.local:6767
  # Bazarr's own key, unlike the two above which are the keys OTHER apps authenticate with.
  BAZARR_API_KEY: "{{ bazarr_api_key }}"
  KUMA_PUSH_BAZARR: "{{ monitor_bridge_bazarr_push_token }}"
  PROWLARR_URL: http://prowlarr.{{ k8s_namespace }}.svc.cluster.local:9696
  PROWLARR_API_KEY: "{{ prowlarr_api_key }}"
  PROWLARR_INDEXER_MIN_DOWN_MIN: "10080"
  PROWLARR_INDEXER_IGNORE: The Pirate Bay,1337x
  KUMA_PUSH_PROWLARR_INDEXERS: "{{ monitor_bridge_prowlarr_indexers_push_token }}"
  B2_PROBE_KEY_ID: "{{ kopia_b2_key_id }}"
  B2_PROBE_APPLICATION_KEY_FILE: /etc/bridge-credentials/b2_probe_application_key
  B2_PROBE_INTERVAL_S: "1800"
  # TTL for a B2 failure that never reached B2 (DNS, connect, timeout). Declared here rather than
  # left on the code default, like its B2_ siblings. It must stay well under B2_PROBE_INTERVAL_S:
  # at parity the split is inert and one transient failure pins the gate DOWN for 30 minutes
  # again, which is the 2026-08-30 restart. Costs nothing to re-probe — a connection that never
  # landed was never billed.
  B2_TRANSPORT_RETRY_S: "300"
  KUMA_PUSH_B2_REACHABLE: "{{ monitor_bridge_b2_reachable_push_token }}"
  KUMA_PUSH_K8S_WORKLOADS: "{{ monitor_bridge_k8s_workloads_push_token }}"
  KUMA_PUSH_CLUSTER_TARGETS: "{{ monitor_bridge_cluster_targets_push_token }}"
  KUMA_PUSH_CLUSTER_PROMETHEUS: "{{ monitor_bridge_cluster_prometheus_push_token }}"
  # Replica redundancy on the storage layer. k3s_longhorn_replica_count is 2, so one lost
  # replica leaves a volume single-copy — one more failure from data loss, and until this arm
  # landed (2026-08-17) nothing reported it. LONGHORN_CONSECUTIVE rides out the planned
  # degradation a node drain or the Sunday reboot causes; see check_longhorn_volumes.
  LONGHORN_CONSECUTIVE: "3"
  KUMA_PUSH_LONGHORN_VOLUMES: "{{ monitor_bridge_longhorn_volumes_push_token }}"
  # Filesystem fullness of the cluster's PVCs — the space axis check_longhorn_volumes (replica
  # redundancy) and check_disk (host mountpoints) both leave uncovered. Rendered here for the
  # same reason as HOST_ORIGINS_MIN and CADVISOR_PODS_MIN: a threshold that has to be tunable
  # without a code change.
  #
  # PVC_EXCLUDE drops media-data, the one claim backed by a `local` PV at /srv/media on
  # daniel-box (k8s/media-volume/templates/pv.yaml.j2) rather than by Longhorn — it IS the `/`
  # filesystem check_disk already watches, so scanning it here pages twice for one full disk.
  # Every addition needs a note saying why; a growing list means the arm is decaying.
  PVC_MAX_PCT: "85"
  PVC_EXCLUDE: media-data
  # Claim-count floor. Live was 43 on 2026-09-01; 20 is deliberately well under it so retiring
  # services cannot pin the monitor red. Raise it only if the claim count grows a lot.
  PVC_MIN_CLAIMS: "20"
  PVC_CLAIMS_CONSECUTIVE: "3"
  KUMA_PUSH_PVC: "{{ monitor_bridge_pvc_push_token }}"
  SCRUTINY_URL: http://scrutiny.{{ k8s_namespace }}.svc.cluster.local:8080
  SCRUTINY_MAX_AGE_H: "26"
  SCRUTINY_TEMP_MAX: "0"
  # NVMe endurance ceiling, percent. Declared here rather than left on the code default so the
  # knob is tunable without a code change, like its SCRUTINY_ siblings. Scrutiny reports
  # `percentage_used` with `thresh: 100`, so it cannot fold a wear breach into device_status
  # until endurance is fully spent — which is why this arm exists separately from the
  # device_status one. 0 disables it. (2026-08-22 review.)
  SCRUTINY_WEAR_MAX: "80"
  KUMA_PUSH_SCRUTINY: "{{ monitor_bridge_scrutiny_push_token }}"
  # Board and CPU temperature. The thresholds are declared here rather than left on the code
  # defaults so they are tunable without a code change, like their SCRUTINY_ siblings.
  # HWMON_TEMP_FALLBACK_C carries most of the estate: measured 2026-08-28, only 7 of 21 scraped
  # sensors declare a plausible max, and both daniel-pi sensors declare none. EXCLUDE_CHIP keeps
  # the drives with check_scrutiny, whose device_status already folds SMART temperature.
  HWMON_TEMP_RATIO: "0.90"
  HWMON_TEMP_FALLBACK_C: "85"
  # The sanity bound on a declared max, and the load-bearing half of the design — a sensor
  # whose declared max falls outside this range is read as UNDECLARED and takes the fallback.
  # Declared here for the same reason as its siblings: widening it to trust the 65261.85
  # sentinel is the one edit that would silently un-watch three sensors, so it should be a
  # config change somebody reviews rather than a code change buried in a default.
  HWMON_TEMP_MIN_PLAUSIBLE_C: "20"
  HWMON_TEMP_MAX_PLAUSIBLE_C: "150"
  HWMON_TEMP_EXCLUDE_CHIP: nvme_
  HWMON_TEMP_CONSECUTIVE: "3"
  # Host-coverage floor for the thermal check — 3, not the shared HOST_ORIGINS_MIN of 2, because
  # all three hosts declare non-excluded hwmon sensors. Lower it here if a host legitimately
  # stops reporting them; do not lower HOST_ORIGINS_MIN, which disk and memory share.
  HWMON_TEMP_ORIGINS_MIN: "3"
  # Longer than HOST_ORIGINS_CONSECUTIVE because the third host is the Pi: over the 7d to
  # 2026-08-29 its hwmon series went absent for about 20 minutes, which the shared 3-cycle
  # (15 min) grace would have paged on. 5 cycles is 25 minutes at INTERVAL=300.
  HWMON_TEMP_ORIGINS_CONSECUTIVE: "5"
  KUMA_PUSH_HOST_TEMP: "{{ monitor_bridge_host_temp_push_token }}"
  UPS_CHARGE_QUERY: hass_sensor_battery_percent{entity="sensor.apc_ups_battery_charge"}
  UPS_RUNTIME_QUERY: hass_sensor_duration_s{entity="sensor.apc_ups_battery_runtime"}
  UPS_REPLACE_QUERY: hass_binary_sensor_state{entity="binary_sensor.apc_ups_replace_battery"}
  UPS_HA_UP_QUERY: up{job="home-assistant"}
  UPS_CHARGE_MIN_PCT: "50"
  UPS_RUNTIME_MIN_S: "300"
  UPS_CONSECUTIVE: "2"
  KUMA_PUSH_UPS: "{{ monitor_bridge_ups_push_token }}"
  PI_GLANCES_URL: http://{{ hostvars['daniel-pi'].server_ip }}:61208
  PI_LOAD_MAX: "1.5"
  PI_MEM_MIN_MB: "50"
  PI_DISK_MAX_PCT: "90"
  # Derived, never hand-listed: every daniel-pi container with a `port` publishes one, and the
  # three that don't (docker-proxy, autoheal, docker-proxy-lifecycle) fall out by having no
  # `port` key rather than by an exclusion list. A container added to or removed from the Pi
  # moves this set with it. ansible/tests/test_pi_publishing_containers.py pins the derivation
  # against the names it was written for, so a narrowing cannot land unnoticed.
  # `udp_port` is deliberately not included: the arm probes with a TCP connect, and there is
  # no equivalent "is anything listening" answer for UDP.
{% set pi_publishers = hostvars['daniel-pi'].containers_list | selectattr('port', 'defined') | list %}
  PI_PUBLISHED_PORTS: "{% for c in pi_publishers %}{{ c.name }}:{{ c.port }}{% if not loop.last %},{% endif %}{% endfor %}"
  KUMA_PUSH_PI: "{{ monitor_bridge_pi_push_token }}"
  HA_URL: http://home-assistant.{{ k8s_namespace }}.svc.cluster.local:8123
  HA_TOKEN_FILE: /etc/bridge-credentials/ha_token
  HA_HEARTBEAT_MAX_AGE: "300"
  HA_CONSECUTIVE: "2"
  KUMA_PUSH_HA: "{{ monitor_bridge_ha_push_token }}"
  SPEEDTEST_URL: http://speedtest.{{ k8s_namespace }}.svc.cluster.local:80
  SPEEDTEST_TOKEN_FILE: /etc/bridge-credentials/speedtest_api_token
  # 100 Mbps sits in the empty band between the two result populations (worst good run 119,
  # best bad run 42.8, measured 2026-08-14..24) — see the SPEEDTEST_ block in check.py.
  SPEEDTEST_DOWNLOAD_MIN_MBPS: "100"
  SPEEDTEST_MAX_AGE_H: "8"
  SPEEDTEST_CONSECUTIVE: "2"
  KUMA_PUSH_SPEEDTEST: "{{ monitor_bridge_speedtest_push_token }}"
  LOKI_URL: http://loki-homelab.{{ k8s_namespace }}.svc.cluster.local:3100
  LOKI_STREAM: '{job=~"authlog|syslog"}'
  LOKI_WINDOW: 30m
  LOKI_FILETAIL_WINDOW: 3h
  KUMA_PUSH_LOKI: "{{ monitor_bridge_loki_push_token }}"
  KUMA_PUSH_LOKI_REACHABLE: "{{ monitor_bridge_loki_reachable_push_token }}"
  PROMTAIL_DROPPED_WINDOW: 1h
  PROMTAIL_DROPPED_MAX: "1000"
  # The log-pattern arm of k3s Workload Health. Rendered here, like HOST_ORIGINS_MIN, so a noisy
  # deploy window can be ridden out from the inventory rather than by editing check.py.
  #
  # Both estates: `k8s` is the cluster promtail's job label, `pi` is daniel-pi's.
  LOG_ERROR_SELECTOR: '{job=~"k8s|pi"}'
  # `error` is deliberately absent — it appears in ordinary output constantly, and an arm that
  # pages on it is an arm that gets ignored. These four mean the process gave up.
  LOG_ERROR_PATTERN: '(?i)(panic:|fatal|traceback|out of memory)'
  LOG_ERROR_WINDOW: 1h
  LOG_ERROR_MAX: "20"
  # Empty on purpose. Add a container here only with a note saying why its normal output trips
  # the pattern — a growing ignore list means the arm is decaying, not that the estate is noisy.
  LOG_ERROR_IGNORE: ""
  # Hosts that check_disk/check_mem must not scan, because another check owns them. daniel-pi
  # runs node-exporter since 2026-08-24, and check_pi_pressure owns its disk and memory against
  # thresholds sized for a 456 MB box.
  HOST_METRIC_ORIGIN_EXCLUDE: daniel-pi
  KUMA_PUSH_PROMTAIL_DROPPED: "{{ monitor_bridge_promtail_dropped_push_token }}"
  DISCORD_WEBHOOK_URL: "{{ monitor_discord_webhook_url }}"
  DISCORD_CROWDSEC_WEBHOOK_URL: "{{ crowdsec_discord_webhook_url }}"
  DISCORD_GITOPS_WEBHOOK_URL: "{{ gitops_deploy_discord_webhook }}"
  DISCORD_ARR_WEBHOOK_URL: "{{ arr_discord_webhook_url }}"
  DISCORD_HEALTHCHECKS_WEBHOOK_URL: "{{ healthchecks_discord_webhook_url }}"
  DISCORD_CONSECUTIVE: "2"
  KUMA_PUSH_DISCORD: "{{ monitor_bridge_discord_push_token }}"
  SMTP_USER: "{{ email }}"
  SMTP_PASSWORD: "{{ smtp_notify_app_password }}"
  CF_ACCOUNT_ID: "{{ r2_account_id }}"
  CF_ANALYTICS_TOKEN_FILE: /etc/bridge-credentials/cf_analytics_token
  R2_BUCKET: "{{ r2_bucket }}"
  R2_STORAGE_MAX_GB: "10"
  R2_CLASS_A_MAX: "1000000"
  R2_CLASS_B_MAX: "10000000"
  R2_USAGE_MAX_PCT: "80"
  R2_UPLOADS_MAX: "25"
  KUMA_PUSH_R2_USAGE: "{{ monitor_bridge_r2_usage_push_token }}"
  # B2's storage half. Daily, not the 1800s the reachability probe uses: sizing the bucket costs
  # one Class C call per 1000 versions, and a budget guard must not be a real part of the spend.
  B2_STORAGE_INTERVAL_S: "86400"
  B2_STORAGE_MAX_PCT: "80"
  KUMA_PUSH_B2_STORAGE: "{{ monitor_bridge_b2_storage_push_token }}"
  # ha_token, b2_probe_application_key # gitleaks:allow — key NAMES in prose, not values
  # and cf_analytics_token used to live here as well as in
  # the volume mount. They moved to credentials-secret.yaml on 2026-08-16: the deployment
  # consumes THIS Secret with `envFrom`, which has no per-key filter, so every key in it
  # becomes a container env var. Keeping the three here put an unscoped full-access Home
  # Assistant token and the B2 application key in the pod environment — readable from
  # /proc/<pid>/environ and any crash dump — which is exactly what the *_FILE indirection and
  # the 0440 volume mount were added to avoid (2026-07-15 review, H2). A separate Secret is
  # the only way to mount a credential as a file without also injecting it.
