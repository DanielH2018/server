---
# The twin's credentials, as a Secret: the push tokens, API keys, webhooks and SMTP login,
# every value a SOPS key. Every other setting is a plain `env:` value, rendered from
# config/env.yaml.j2 into deployment.yaml.j2: a Secret's quoted numeric literals fail Flux's
# typed patch (#5574). Sources and reasoning are documented on the Docker compose template this
# ports, which #2385 deleted: `git show 2460d0675fd748e70fcbcde87185371ffd62402b:ansible/roles/containers/archive/monitor-bridge/templates/docker-compose.yml.j2`.
apiVersion: v1
kind: Secret
metadata:
  name: monitor-bridge-env
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  # The deploy-pipeline exporter's GitHub token: Actions read and Variables read on this
  # repository only, so it can neither clear a hold nor move a tag. D2.6d in
  # docs/target-architecture/deploy/d2-first-leaf.md adds the exporter that reads it.
  DEPLOY_PIPELINE_GITHUB_TOKEN: "{{ monitor_bridge_deploy_pipeline_github_token }}"
  # One push token per row of `files/check_table.py`, under the env name `bridge.types.push_env`
  # derives from the row's name (#3659). `lookup('vars')` fails the render on an undefined
  # token, the way a bare reference did, so a row whose SOPS secret is missing stops the deploy
  # instead of rendering a check that pushes nowhere.
{% for check in lookup('file', playbook_dir ~ '/roles/k8s/monitor-bridge/files/check_table.py') | py_table('CHECKS') %}
  KUMA_PUSH_{{ check.name | upper }}: "{{ lookup('vars', check.token) }}"
{% endfor %}
  N8N_API_KEY: "{{ n8n_api_key }}"
  SONARR_API_KEY: "{{ sonarr_api_key }}"
  RADARR_API_KEY: "{{ radarr_api_key }}"
  # Bazarr's own key, unlike the two above which are the keys OTHER apps authenticate with.
  BAZARR_API_KEY: "{{ bazarr_api_key }}"
  PROWLARR_API_KEY: "{{ prowlarr_api_key }}"
  B2_PROBE_KEY_ID: "{{ longhorn_b2_key_id }}"
  DISCORD_WEBHOOK_URL: "{{ monitor_discord_webhook_url }}"
  DISCORD_CROWDSEC_WEBHOOK_URL: "{{ crowdsec_discord_webhook_url }}"
  DISCORD_GITOPS_WEBHOOK_URL: "{{ gitops_deploy_discord_webhook }}"
  DISCORD_ARR_WEBHOOK_URL: "{{ arr_discord_webhook_url }}"
  DISCORD_HEALTHCHECKS_WEBHOOK_URL: "{{ healthchecks_discord_webhook_url }}"
  SMTP_USER: "{{ email }}"
  SMTP_PASSWORD: "{{ smtp_notify_app_password }}"
  CF_ACCOUNT_ID: "{{ r2_account_id }}"
  R2_BUCKET: "{{ r2_bucket }}"
  # ha_token, b2_probe_application_key # gitleaks:allow — key NAMES in prose, not values
  # and cf_analytics_token used to live here as well as in
  # the volume mount. They moved to credentials-secret.yaml on 2026-08-16: the deployment
  # consumes THIS Secret with `envFrom`, which has no per-key filter, so every key in it
  # becomes a container env var. Keeping the three here put an unscoped full-access Home
  # Assistant token and the B2 application key in the pod environment — readable from
  # /proc/<pid>/environ and any crash dump — which is exactly what the *_FILE indirection and
  # the 0440 volume mount were added to avoid (2026-07-15 review, H2). A separate Secret is
  # the only way to mount a credential as a file without also injecting it.
