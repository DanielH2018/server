---
# The twin's whole env, as a Secret (it is mostly push tokens + API keys; splitting the
# handful of plain thresholds into a ConfigMap would double the surface for no gain).
# Sources and reasoning are documented on the Docker compose template this ports
# (roles/containers/monitor-bridge/templates/docker-compose.yml.j2); only what CHANGED
# in the move is commented here.
apiVersion: v1
kind: Secret
metadata:
  name: monitor-bridge-env
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  TZ: "{{ tz }}"
  PYTHONUNBUFFERED: "1"
  PYTHONDONTWRITEBYTECODE: "1"
  INTERVAL: "300"
  GRACE_CYCLES: "2"
  # The five daniel-server host-state-file checks stay with the Docker remnant (its
  # CHECKS_ONLY mirrors this list). check.py refuses to start on a filter that enables
  # a gated check without its gate, so an edit here fails loud, not quiet.
  CHECKS_SKIP: "{{ monitor_bridge_host_state_checks }}"
  # In-cluster Service names replace the -k8s LAN routes: no VIP, no Traefik, no
  # Authelia/ClientIP gate in a probe's path. The Kuma HTTP monitors keep watching the
  # routed paths, so edge coverage is not lost by probing natively here.
  # PROM_ORIGIN derives from these two being EQUAL — keep them identical strings.
  PROMETHEUS_URL: http://prometheus.{{ k8s_observability_namespace }}.svc.cluster.local:9090
  CLUSTER_PROMETHEUS_URL: http://prometheus.{{ k8s_observability_namespace }}.svc.cluster.local:9090
  KUMA_URL: http://uptime-kuma.{{ k8s_namespace }}.svc.cluster.local:3001
  DISK_MOUNTPOINTS: /,/boot,/boot/efi
  DISK_MAX_PCT: "90"
  CERT_MIN_DAYS: "14"
  MEM_MAX_PCT: "90"
  OOM_WINDOW: 1h
  CPU_WINDOW: 15m
  CPU_THROTTLE_PCT: "25"
  CPU_MIN_THROTTLED_CORES: "0.05"
  CPU_CONSECUTIVE: "3"
  RESTART_WINDOW: 15m
  RESTART_MAX: "3"
  TRAEFIK_5XX_PCT: "5"
  TRAEFIK_MIN_RPS: "0.05"
  TARGETS_MIN: "2"
  CLUSTER_TARGETS_MIN: "3"
  K8S_MIN_WORKLOADS: "5"
  K8S_MIN_DAEMONSETS: "9"
  KUMA_PUSH_DISK: "{{ monitor_bridge_disk_push_token }}"
  KUMA_PUSH_CERT: "{{ monitor_bridge_cert_push_token }}"
  KUMA_PUSH_MEM: "{{ monitor_bridge_mem_push_token }}"
  KUMA_PUSH_RESTARTS: "{{ monitor_bridge_restarts_push_token }}"
  KUMA_PUSH_OOM: "{{ monitor_bridge_oom_push_token }}"
  KUMA_PUSH_CPU: "{{ monitor_bridge_cpu_push_token }}"
  KUMA_PUSH_TARGETS: "{{ monitor_bridge_targets_push_token }}"
  KUMA_PUSH_TRAEFIK: "{{ monitor_bridge_traefik_push_token }}"
  KUMA_PUSH_TRAEFIK_LATENCY: "{{ monitor_bridge_traefik_latency_push_token }}"
  KUMA_PUSH_PROMETHEUS: "{{ monitor_bridge_prometheus_push_token }}"
  N8N_URL: http://n8n.{{ k8s_namespace }}.svc.cluster.local:5678
  N8N_API_KEY: "{{ n8n_api_key }}"
  N8N_FAIL_WINDOW: 2h
  N8N_CONSECUTIVE_MAX: "3"
  N8N_SYSTEMIC_STREAK: "2"
  N8N_SYSTEMIC_MAX: "2"
  KUMA_PUSH_N8N: "{{ monitor_bridge_n8n_push_token }}"
  SONARR_URL: http://sonarr.{{ k8s_namespace }}.svc.cluster.local:8989
  SONARR_API_KEY: "{{ sonarr_api_key }}"
  RADARR_URL: http://radarr.{{ k8s_namespace }}.svc.cluster.local:7878
  RADARR_API_KEY: "{{ radarr_api_key }}"
  KUMA_PUSH_ARR_QUEUE: "{{ monitor_bridge_arr_queue_push_token }}"
  PROWLARR_URL: http://prowlarr.{{ k8s_namespace }}.svc.cluster.local:9696
  PROWLARR_API_KEY: "{{ prowlarr_api_key }}"
  PROWLARR_INDEXER_MIN_DOWN_MIN: "10080"
  PROWLARR_INDEXER_IGNORE: The Pirate Bay,1337x
  KUMA_PUSH_PROWLARR_INDEXERS: "{{ monitor_bridge_prowlarr_indexers_push_token }}"
  B2_PROBE_KEY_ID: "{{ kopia_b2_key_id }}"
  B2_PROBE_APPLICATION_KEY_FILE: /etc/bridge-credentials/b2_probe_application_key
  B2_PROBE_INTERVAL_S: "1800"
  KUMA_PUSH_B2_REACHABLE: "{{ monitor_bridge_b2_reachable_push_token }}"
  KUMA_PUSH_K8S_WORKLOADS: "{{ monitor_bridge_k8s_workloads_push_token }}"
  KUMA_PUSH_CLUSTER_TARGETS: "{{ monitor_bridge_cluster_targets_push_token }}"
  KUMA_PUSH_CLUSTER_PROMETHEUS: "{{ monitor_bridge_cluster_prometheus_push_token }}"
  SCRUTINY_URL: http://scrutiny.{{ k8s_namespace }}.svc.cluster.local:8080
  SCRUTINY_MAX_AGE_H: "26"
  SCRUTINY_TEMP_MAX: "0"
  KUMA_PUSH_SCRUTINY: "{{ monitor_bridge_scrutiny_push_token }}"
  UPS_CHARGE_QUERY: hass_sensor_battery_percent{entity="sensor.apc_ups_battery_charge"}
  UPS_RUNTIME_QUERY: hass_sensor_duration_s{entity="sensor.apc_ups_battery_runtime"}
  UPS_REPLACE_QUERY: hass_binary_sensor_state{entity="binary_sensor.apc_ups_replace_battery"}
  UPS_HA_UP_QUERY: up{job="home-assistant"}
  UPS_CHARGE_MIN_PCT: "50"
  UPS_RUNTIME_MIN_S: "300"
  UPS_CONSECUTIVE: "2"
  KUMA_PUSH_UPS: "{{ monitor_bridge_ups_push_token }}"
  PI_GLANCES_URL: http://{{ hostvars['daniel-pi'].server_ip }}:61208
  PI_LOAD_MAX: "1.5"
  PI_MEM_MIN_MB: "50"
  PI_DISK_MAX_PCT: "90"
  KUMA_PUSH_PI: "{{ monitor_bridge_pi_push_token }}"
  HA_URL: http://home-assistant.{{ k8s_namespace }}.svc.cluster.local:8123
  HA_TOKEN_FILE: /etc/bridge-credentials/ha_token
  HA_HEARTBEAT_MAX_AGE: "300"
  HA_CONSECUTIVE: "2"
  KUMA_PUSH_HA: "{{ monitor_bridge_ha_push_token }}"
  LOKI_URL: http://loki-homelab.{{ k8s_namespace }}.svc.cluster.local:3100
  LOKI_STREAM: '{job=~"authlog|syslog"}'
  LOKI_WINDOW: 30m
  LOKI_FILETAIL_WINDOW: 3h
  KUMA_PUSH_LOKI: "{{ monitor_bridge_loki_push_token }}"
  KUMA_PUSH_LOKI_REACHABLE: "{{ monitor_bridge_loki_reachable_push_token }}"
  PROMTAIL_DROPPED_WINDOW: 1h
  PROMTAIL_DROPPED_MAX: "1000"
  KUMA_PUSH_PROMTAIL_DROPPED: "{{ monitor_bridge_promtail_dropped_push_token }}"
  DISCORD_WEBHOOK_URL: "{{ monitor_discord_webhook_url }}"
  DISCORD_CROWDSEC_WEBHOOK_URL: "{{ crowdsec_discord_webhook_url }}"
  DISCORD_GITOPS_WEBHOOK_URL: "{{ gitops_deploy_discord_webhook }}"
  DISCORD_ARR_WEBHOOK_URL: "{{ arr_discord_webhook_url }}"
  DISCORD_HEALTHCHECKS_WEBHOOK_URL: "{{ healthchecks_discord_webhook_url }}"
  DISCORD_CONSECUTIVE: "2"
  KUMA_PUSH_DISCORD: "{{ monitor_bridge_discord_push_token }}"
  SMTP_USER: "{{ email }}"
  SMTP_PASSWORD: "{{ smtp_notify_app_password }}"
  # The two file-mounted credentials (same keys mounted as a volume in the deployment).
  ha_token: "{{ monitor_bridge_ha_token }}"
  b2_probe_application_key: "{{ kopia_b2_application_key }}"
