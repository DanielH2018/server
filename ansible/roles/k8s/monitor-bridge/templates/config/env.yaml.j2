---
# monitor-bridge's settings: every env var that is not a credential, as one mapping of name to
# value. deployment.yaml.j2 renders each entry as a container `env:` value, and the credentials
# stay in env-secret.yaml.j2. A setting lives here rather than in that Secret because Flux's
# typed patch reads a Secret's quoted "300" back as a number and refuses it (#5574); a
# Deployment's `env` value keeps its quotes. Quote a value YAML would read as a number, a
# boolean or a null, so `from_yaml` reads it as the string the pod receives. Only what CHANGED in the move from the Docker compose template
# is commented here; its reasoning is on that template, which #2385 deleted:
# `git show 2460d0675fd748e70fcbcde87185371ffd62402b:ansible/roles/containers/archive/monitor-bridge/templates/docker-compose.yml.j2`.
TZ: "{{ tz }}"
PYTHONUNBUFFERED: "1"
PYTHONDONTWRITEBYTECODE: "1"
INTERVAL: "300"
GRACE_CYCLES: "2"
# No CHECKS_SKIP since the Docker uninstall (2026-08-14): the remnant is gone and
# this deployment runs every check. The gitops pair re-pointed at daniel-box's own
# deployer — state via the hostPath mount in deployment.yaml.j2 (the pod is pinned
# to that node); thresholds unchanged from the remnant era.
GITOPS_STATE_DIR: /gitops-state
GITOPS_MAX_AGE_MIN: "90"
GITOPS_BEHIND_MAX_MIN: "360"
# Consecutive ticks deferred on one busy service lock: the deployer's longest apply
# budget (gitops_deploy_broad_timeout_s = 1800 s), so a lock held past it is a wedged
# holder, not a slow deploy (issue #1847).
GITOPS_CONTENTION_MAX_MIN: "30"
# The host-package builder's page bounds, in seconds (Host Packages — Status). The lag bound
# is how long master may sit unbuilt before the tile pages; the fetch bound is how old the
# builder's last good `git fetch` may be. Defaults in this role, so a bound moves in one place.
# The lag bound is derived: the larger of that default and the rollout canary's longest gap
# between updater fires (daniel-pi's drop-in over the shared timer), plus its run timeout and
# a slack, because a Pi canary holds the other hosts' packages until the Pi's next fire, once a
# day since H3.13 (#6530, #6911, `filter_plugins/updater_lag_grace.py`).
BUILDER_MAX_LAG_S: "{{ lookup('file', playbook_dir + '/../hosts/packages/homelab-updater/units/homelab-updater.timer') | updater_lag_grace_s(lookup('file', playbook_dir + '/../hosts/packages/homelab-updater/units/homelab-updater.service'), lookup('file', playbook_dir + '/../hosts/daniel-pi/units/homelab-updater.timer.conf'), monitor_bridge_builder_max_lag_s) }}"
BUILDER_MAX_FETCH_AGE_S: "{{ monitor_bridge_builder_max_fetch_age_s }}"
# The port the deploy-pipeline exporter serves its five gauges on, and the one the Service
# and observability's deploy-pipeline scrape job name.
DEPLOY_PIPELINE_PORT: "{{ monitor_bridge_deploy_pipeline_port }}"
# The port the check exporter serves its per-row verdict gauges on. It is the `metrics` item on
# monitor-bridge's containers_list entry, which also renders observability's monitor-bridge
# scrape job, so the listener, the Service and the job cannot drift apart.
CHECK_EXPORTER_PORT: "{{ containers_list | metrics_port('monitor-bridge') }}"
# The weekly reboot's schedule, from group_vars/all.yml, which
# scripts/deploy_tools/promote_lib/reboot_window.py reads too. The exporter derives the
# no-promotion window from it, so moving the reboot moves the window gauge with it (#5458).
WEEKLY_REBOOT_MINUTE: "{{ weekly_reboot_minute }}"
WEEKLY_REBOOT_HOUR: "{{ weekly_reboot_hour }}"
WEEKLY_REBOOT_WEEKDAY: "{{ weekly_reboot_weekday }}"
WEEKLY_REBOOT_SHUTDOWN_DELAY_MIN: "{{ weekly_reboot_shutdown_delay_minutes }}"
WEEKLY_REBOOT_MUTE_RECOVERY_MIN: "{{ weekly_reboot_mute_recovery_minutes }}"
# In-cluster Service names replace the -k8s LAN routes: no VIP, no Traefik, no
# Authelia/ClientIP gate in a probe's path. The Kuma HTTP monitors keep watching the
# routed paths, so edge coverage is not lost by probing natively here.
# ONE Prometheus, watched by ONE gate. CLUSTER_PROMETHEUS_URL sat beside this naming the same
# Service from the Docker plane's retirement (2026-08-14) until 2026-09-28, and its gate's
# tile could not go red on its own — coverage that did not exist. Deleted in #2825; `git
# revert` restores the split if a second Prometheus is reintroduced, and a second instance
# needs its own gate before any check reads it.
PROMETHEUS_URL: http://prometheus.{{ k8s_observability_namespace }}.svc.cluster.local:9090
KUMA_URL: http://uptime-kuma.{{ k8s_namespace }}.svc.cluster.local:{{ containers_list | entry_port('uptime-kuma') }}
N8N_URL: http://n8n.{{ k8s_namespace }}.svc.cluster.local:5678
N8N_FAIL_WINDOW: 2h
N8N_CONSECUTIVE_MAX: "3"
N8N_SYSTEMIC_STREAK: "2"
N8N_SYSTEMIC_MAX: "2"
SONARR_URL: http://sonarr.{{ k8s_namespace }}.svc.cluster.local:8989
RADARR_URL: http://radarr.{{ k8s_namespace }}.svc.cluster.local:7878
# Cycles an *arr API may stay unreachable before this check pages — the FETCH only, so a
# rolling sonarr/radarr no longer reports a rollout as a queue fault. Evidence at
# bridge/config_service.py.
ARR_FETCH_CONSECUTIVE: "3"
# Hours an item on Sonarr's self-clearing TBA/missing-title hold waits before it pages. 48 is
# upstream's own air-date window, so a hold outliving it is stuck rather than waiting.
# Evidence at bridge/config_service.py.
ARR_TITLE_HOLD_GRACE_H: "48"
BAZARR_URL: http://bazarr.{{ k8s_namespace }}.svc.cluster.local:6767
PROWLARR_URL: http://prowlarr.{{ k8s_namespace }}.svc.cluster.local:9696
PROWLARR_INDEXER_MIN_DOWN_MIN: "10080"
PROWLARR_INDEXER_IGNORE: The Pirate Bay,1337x
B2_PROBE_APPLICATION_KEY_FILE: /etc/bridge-credentials/b2_probe_application_key
B2_PROBE_INTERVAL_S: "1800"
# TTL for a B2 failure that never reached B2 (DNS, connect, timeout). Declared here like its
# B2_ siblings. It must stay well under B2_PROBE_INTERVAL_S:
# at parity the split is inert and one transient failure pins the gate DOWN for 30 minutes
# again, which is the 2026-08-30 restart. Costs nothing to re-probe — a connection that never
# landed was never billed.
B2_TRANSPORT_RETRY_S: "300"
SCRUTINY_URL: http://scrutiny.{{ k8s_namespace }}.svc.cluster.local:8080
SCRUTINY_MAX_AGE_H: "26"
SCRUTINY_TEMP_MAX: "0"
# NVMe endurance ceiling, percent. Declared here so the knob is tunable without a code
# change, like its SCRUTINY_ siblings. Scrutiny reports
# `percentage_used` with `thresh: 100`, so it cannot fold a wear breach into device_status
# until endurance is fully spent — which is why this arm exists separately from the
# device_status one. 0 disables it. (2026-08-22 review.)
SCRUTINY_WEAR_MAX: "80"
HA_URL: http://home-assistant.{{ k8s_namespace }}.svc.cluster.local:8123
HA_TOKEN_FILE: /etc/bridge-credentials/ha_token
HA_HEARTBEAT_MAX_AGE: "300"
HA_CONSECUTIVE: "2"
SPEEDTEST_URL: http://speedtest.{{ k8s_namespace }}.svc.cluster.local:80
SPEEDTEST_TOKEN_FILE: /etc/bridge-credentials/speedtest_api_token
# 100 Mbps sits in the empty band between the two result populations (worst good run 119,
# best bad run 42.8, measured 2026-08-14..24) — see the SPEEDTEST_ block in check.py.
SPEEDTEST_DOWNLOAD_MIN_MBPS: "100"
SPEEDTEST_MAX_AGE_H: "8"
SPEEDTEST_CONSECUTIVE: "2"
# Consecutive sub-floor RESULTS (not cycles) the floor arm needs before it pages, and the
# number of rows the fetch asks for. Evidence at bridge/config_host.py.
SPEEDTEST_FLOOR_CONSECUTIVE: "2"
LOKI_URL: http://loki-homelab.{{ k8s_namespace }}.svc.cluster.local:3100
# How far back check_swallowed_verdicts reads the host crons' push-outcome lines (#1869).
# Derivation at bridge/config_io.py.
SWALLOWED_VERDICTS_WINDOW_S: "10800"
# The post-reboot window (#2783), rendered here beside the window it bounds. BOOT_SETTLE_S is
# how long the weekly restart keeps losing host-cron pushes (uptime-kuma has no endpoint for
# ~16 min of it), and swallowed_verdicts does not read back past its end (#3490). Derivation at
# bridge/config_io.py.
BOOT_SETTLE_S: "1200"
DISCORD_CONSECUTIVE: "2"
CF_ANALYTICS_TOKEN_FILE: /etc/bridge-credentials/cf_analytics_token
R2_STORAGE_MAX_GB: "10"
R2_CLASS_A_MAX: "1000000"
R2_CLASS_B_MAX: "10000000"
R2_USAGE_MAX_PCT: "80"
R2_UPLOADS_MAX: "25"
# B2's storage half. Daily, not the 1800s the reachability probe uses: sizing the bucket costs
# one Class C call per 1000 versions, and a budget guard must not be a real part of the spend.
B2_STORAGE_INTERVAL_S: "86400"
B2_STORAGE_MAX_PCT: "80"
# The cloudflare_ips allowlist as the check expects it (comma-separated), so the tile reads
# the same list traefik and netpol-baseline render. Success cached a day; a failure re-probes
# every cycle (checks/cloudflare_ips.py). Was k8s/traefik's daily host cron until 2026-09-19.
CLOUDFLARE_IPS_EXPECTED: "{{ cloudflare_ips | join(',') }}"
CLOUDFLARE_IPS_PROBE_INTERVAL_S: "86400"
# The Healthchecks.io console against docs/healthchecks-io-deadman.md (#2566): each
# documented slug's schedule type, period or cron, tz and grace, from defaults/main.yml.
# Success cached a day; a failure re-probes every cycle (checks/healthchecks.py).
HEALTHCHECKS_API_KEY_FILE: /etc/bridge-credentials/healthchecks_api_read_only_key
HEALTHCHECKS_EXPECTED: '{{ monitor_bridge_healthchecks_expected | to_json }}'
HEALTHCHECKS_PROBE_INTERVAL_S: "86400"
# The WAN gate (#2784): two independent providers probed by hostname, tried in order, down
# only when NEITHER answers. Left at the code default here — a URL list in the env would have
# to be kept in step with the reasoning in checks/wan.py for no operational gain. Set
# WAN_PROBE_URLS to override, empty to disable the gate.
