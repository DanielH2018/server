---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: monitor-bridge
  namespace: {{ k8s_namespace }}
spec:
  replicas: 1
  # One evaluator at a time: the streak/hysteresis state (grace cycles, n8n failure
  # streaks) is in-process, and two pods pushing the same tokens would interleave
  # contradictory verdicts.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: monitor-bridge
  template:
    metadata:
      labels:
        app: monitor-bridge
        netpol-baseline: enforced
      annotations:
        # Recreate the pod when any bridge module's source changes — the scripts are not
        # manifests, so the manifests role's own change detection never sees them. The fact
        # is a hash over every module in monitor_bridge_modules, so a change confined to a
        # split-out module rolls the pod too.
        checksum/check-script: "{{ monitor_bridge_script_checksum | default('unstaged') }}"
    spec:
      enableServiceLinks: false
      # Stays off daniel-server so the drain (and its eventual cold boot) never takes the
      # alerting brain down with the thing it is alerting on.
      nodeSelector:
        kubernetes.io/hostname: daniel-box
      securityContext:
        runAsUser: {{ puid }}
        runAsGroup: {{ pgid }}
        # Secret-volume files are root-owned; without fsGroup the 0440 credential files
        # below are unreadable to this non-root uid and both file-mounted checks silently
        # self-disable ("no URL/token" — found on the twin's first cycle, 2026-08-14).
        fsGroup: {{ pgid }}
        runAsNonRoot: true
      automountServiceAccountToken: false
      containers:
        - name: monitor-bridge
          image: {{ monitor_bridge_k8s_image }}
          command: ["python", "/app/check.py"]
          securityContext:
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          envFrom:
            - secretRef:
                name: monitor-bridge-env
          # check.py touches /tmp/heartbeat after every completed cycle; a stale mtime
          # means the loop HUNG (death alone exits the pod). Same contract as the Docker
          # healthcheck+autoheal pair — here a failing liveness recreates the pod.
          livenessProbe:
            exec:
              command:
                - python3
                - -c
                - "import os,sys,time; sys.exit(0 if time.time()-os.stat('/tmp/heartbeat').st_mtime<1000 else 1)"
            initialDelaySeconds: 120
            periodSeconds: 60
            failureThreshold: 3
          volumeMounts:
            - name: monitor-bridge-script
              mountPath: /app
              readOnly: true
            - name: monitor-bridge-credentials
              mountPath: /etc/bridge-credentials
              readOnly: true
            - name: monitor-bridge-tmp
              mountPath: /tmp
            - name: monitor-bridge-gitops-state
              mountPath: /gitops-state
              readOnly: true
          resources:
            requests:
              cpu: 20m
              memory: 32Mi
            limits:
              cpu: 200m
              memory: 96Mi
      volumes:
        - name: monitor-bridge-script
          configMap:
            name: monitor-bridge-script
        - name: monitor-bridge-credentials
          # Deliberately NOT monitor-bridge-env: that Secret is consumed by envFrom, which
          # injects every key it holds as an env var. See credentials-secret.yaml.j2.
          secret:
            secretName: monitor-bridge-credentials
            defaultMode: 0440
            items:
              - key: ha_token
                path: ha_token
              - key: b2_probe_application_key # gitleaks:allow — a Secret item NAME, not a value
                path: b2_probe_application_key
              - key: cf_analytics_token # gitleaks:allow — a Secret item NAME, not a value
                path: cf_analytics_token
        - name: monitor-bridge-tmp
          emptyDir: {}
        # daniel-box's own gitops-deploy state — this pod is pinned to that node (the
        # alerting-brain placement above), which is exactly what makes a hostPath read
        # of the deployer it watches legitimate. Took over from the retired Docker
        # remnant at the uninstall (2026-08-14).
        - name: monitor-bridge-gitops-state
          hostPath:
            path: /var/lib/gitops-deploy
            type: Directory
      priorityClassName: homelab-critical
