{% from 'ingressroute.yml.j2' import ingressroute, monitoring_route with context %}
---
{{ ingressroute(
    container_item.name,
    container_item.hostname | default(container_item.name),
    container_item.port,
    container_item.use_authelia,
  )
}}
---
{#
  Homepage's FreshRSS widget (session-less greader login) reaches this route from the pod
  CIDR. The path is the greader API endpoint itself.
#}
{{ monitoring_route(
    container_item.name,
    container_item.hostname | default(container_item.name),
    container_item.port,
    '/api/greader.php',
    extra_client_cidrs=['10.42.0.0/16']
  )
}}
