{% from 'ingressroute.yml.j2' import ingressroute, monitoring_route with context %}
---
{{ ingressroute(
    container_item.name,
    container_item.hostname | default(container_item.name),
    container_item.port,
    container_item.use_authelia,
    unsuffixed_hostname=container_item.unsuffixed_hostname | default(none)
  )
}}
---
{#
  Homepage's FreshRSS widget (daniel-server, session-less greader login; pod CIDR added when homepage itself moved in-cluster, E3) — same story as
  speedtest: the no-auth bridge route it used died in the slice-7 teardown. The path is
  the greader API endpoint itself, the same one the old bridge probe exercised.
#}
{{ monitoring_route(
    container_item.name,
    container_item.hostname | default(container_item.name),
    container_item.port,
    '/api/greader.php',
    extra_client_cidrs=['10.42.0.0/16']
  )
}}
