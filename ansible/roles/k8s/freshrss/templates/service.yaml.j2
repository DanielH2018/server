{% from 'service.yml.j2' import service with context %}
---
{{ service('freshrss', container_item.port) -}}
{# The feed-cache Service below is deliberately NOT the service() macro: that macro sets
   `selector.app` to the Service NAME, and this pair differs on purpose — the Service is
   `feed-cache` while the sidecar's pod label is `freshrss-feed-cache`. Same disqualifier as
   traefik's metrics-service. #}
---
# THE NAME IS LOAD-BEARING. FreshRSS stores the subscription URL in its database, and the
# seeded database holds `http://feed-cache/w/atom.xml` — Docker Compose's service key, not the
# container_name. A k8s Service called anything else leaves that feed resolving to nothing,
# and FreshRSS reports it as an ordinary fetch failure, so it looks like the upstream is down.
# Same class of trap as the *arr absolute-path footgun waiting in slice 4.
apiVersion: v1
kind: Service
metadata:
  name: feed-cache
  namespace: {{ k8s_namespace }}
spec:
  selector:
    app: freshrss-feed-cache
  ports:
    - port: 80
      targetPort: 80
