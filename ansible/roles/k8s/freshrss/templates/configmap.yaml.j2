apiVersion: v1
kind: ConfigMap
metadata:
  name: freshrss-feed-cache
  namespace: {{ k8s_namespace }}
data:
  default.conf: |
{#
  Read from this role's files/nginx-feed-cache.conf, the one source of truth for the nginx
  config.
#}
{{ lookup('file', playbook_dir + '/roles/k8s/freshrss/files/nginx-feed-cache.conf') | indent(4, true) }}
