{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: freshrss
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  # The PVC is ReadWriteOnce and Longhorn runs one replica, so a rolling update would deadlock:
  # the new pod waits for a volume the old pod still holds.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: freshrss
  template:
    metadata:
      labels:
        app: freshrss
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      # No fsGroup: seed-volume restores the source's ownership with `tar -p --numeric-owner`,
      # and this LSIO image chowns /config to PUID/PGID itself on startup.
      automountServiceAccountToken: false
      priorityClassName: homelab-standard
      # Preference, never a pin: daniel-box carries the storage- and VIP-pinned workloads and runs the hotter of the two nodes, so latency-insensitive services default here.
      # Weighted so the pod still schedules if daniel-server is cordoned or full.
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: freshrss
          image: {{ freshrss_k8s_image }}
          ports:
            - containerPort: {{ container_item.port }}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              # The compose template's cap_drop/cap_add pair: the s6 privilege-drop set plus
              # NET_BIND_SERVICE for :80.
              drop:
                - ALL
              add:
                - CHOWN
                - SETUID
                - SETGID
                - FOWNER
                - DAC_OVERRIDE
                - NET_BIND_SERVICE
          env:
            - name: PUID
              value: "{{ puid }}"
            - name: PGID
              value: "{{ pgid }}"
            - name: TZ
              value: "{{ tz }}"
          volumeMounts:
            - name: freshrss-config
              mountPath: /config
            # FreshRSS favicon/content cache — kopia excluded it; re-fetched on demand.
            - name: freshrss-app-cache
              mountPath: /config/www/freshrss/data/cache
          readinessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
            initialDelaySeconds: 15
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
            initialDelaySeconds: 60
            periodSeconds: 30
          resources:
            limits:
              cpu: "{{ freshrss_k8s_cpu_limit }}"
              memory: {{ freshrss_k8s_mem_limit }}
            requests:
              cpu: "{{ freshrss_k8s_cpu_request }}"
              memory: {{ freshrss_k8s_mem_request }}
      volumes:
        - name: freshrss-config
          persistentVolumeClaim:
            claimName: {{ freshrss_k8s_claim }}
        - name: freshrss-app-cache
          emptyDir: {}
