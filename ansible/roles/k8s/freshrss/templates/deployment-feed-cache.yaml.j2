{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: freshrss-feed-cache
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  selector:
    matchLabels:
      app: freshrss-feed-cache
  template:
    metadata:
      labels:
        app: freshrss-feed-cache
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      automountServiceAccountToken: false
      priorityClassName: homelab-standard
      # Preference, never a pin: daniel-box carries the storage- and VIP-pinned workloads and runs the hotter of the two nodes, so latency-insensitive services default here.
      # Weighted so the pod still schedules if daniel-server is cordoned or full.
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: nginx
          image: {{ freshrss_k8s_cache_image }}
          ports:
            - containerPort: 80
          # Read-only rootfs: root nginx writes only its pidfile (/var/run) — the cache is
          # its own volume (use_temp_path=off) and logs go to the image's stdout symlinks.
          # nginx binds :80 and forks workers — needs NET_BIND_SERVICE + SETUID/SETGID/CHOWN.
{{ hardened_security_context(read_only=true, add=['CHOWN', 'SETUID', 'SETGID', 'NET_BIND_SERVICE']) }}
          volumeMounts:
            - name: feed-cache-nginx-conf
              mountPath: /etc/nginx/conf.d
              readOnly: true
            - name: feed-cache-nginx-cache
              mountPath: /var/cache/nginx
            - name: feed-cache-nginx-run
              mountPath: /var/run
            - name: feed-cache-nginx-tmp
              mountPath: /tmp
          readinessProbe:
            httpGet:
              path: /health
              port: 80
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: 80
            initialDelaySeconds: 15
            periodSeconds: 30
{{ container_resources(cpu_limit=freshrss_k8s_cache_cpu_limit, mem_limit=freshrss_k8s_cache_mem_limit, cpu_request=freshrss_k8s_cache_cpu_request, mem_request=freshrss_k8s_cache_mem_request) }}
      volumes:
        - name: feed-cache-nginx-conf
          configMap:
            name: freshrss-feed-cache
        # The compose side uses a named volume so the cache survives a recreate. Here it is an
        # emptyDir on purpose: this is an HTTP cache in front of one upstream, it refills
        # itself, and a PVC for it would spend Longhorn capacity on regenerable bytes.
        - name: feed-cache-nginx-cache
          emptyDir: {}
        - name: feed-cache-nginx-run
          emptyDir: {}
        - name: feed-cache-nginx-tmp
          emptyDir: {}
