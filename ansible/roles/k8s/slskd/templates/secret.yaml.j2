# slskd's own Mullvad device key, a second device on the account qbittorrent uses. Read as a file
# through FILE__MULLVAD_PRIVATE_KEY, never an env var; store it without surrounding whitespace,
# since init-envfile keeps a trailing newline and a newline corrupts the key.
---
apiVersion: v1
kind: Secret
metadata:
  name: slskd-mullvad
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  key: "{{ slskd_wireguard_private_key }}"
