# PINNED in lockstep with Dockerfile.j2 — see the reasoning there for why this is the channel tag
# plus a digest rather than a version. The two must name the SAME channel: the runners are
# version-coupled to the n8n they serve, and a split would surface as task failures rather than a
# build error. The digests differ because these are different images; `runners:stable` and
# `runners:2.35.4` were the same digest when this was written, so both sides sit on 2.35.4.
FROM n8nio/runners:stable@sha256:11b7406a38f220e23f8c0c1e5d5368b6e837bf65a7a8c8e69782e597835c0896

USER root

# Install JS packages.
#
# Match pnpm to the store the base image was built with, rather than reinstalling into a new one.
# The base ships node_modules linked from a pnpm store at .../store/v10, while the pnpm corepack
# resolves by default is 11.20.0 and wants .../store/v11 — so a bare `pnpm add` aborts with
# ERR_PNPM_UNEXPECTED_STORE.
#
# The 2026-08-06 answer to that was `CI=true pnpm install` first, following pnpm's own error text.
# It was wrong in a way the build itself could not show: that reinstall PURGES node_modules and
# restores only what the lockfile declares, and the base's `@n8n/{di,config,errors,utils}` are
# workspace packages absent from it. The build stayed green (rc=0) and produced an image whose
# runner process died on every task offer with `Cannot find module '@n8n/di'` — so every Code-node
# workflow failed with `Task request timed out`, 100+ failed executions in 9 h, while the pod
# stayed Ready the whole time because the launcher survives its crashing child.
#
# Pinned exact. If the base image's store moves to v11 this fails at BUILD time with
# ERR_PNPM_UNEXPECTED_STORE, and that is the failure worth having: the bug above was a loud build
# error traded for a silent runtime one. The fix then is to bump this pin, not to reinstall.
RUN cd /opt/runners/task-runner-javascript \
    && corepack prepare pnpm@10.15.0 --activate \
    && pnpm add fuzzball

# Fails the build if the base's workspace packages or the added one cannot be resolved. One line,
# and it is the check that would have caught 2026-08-06 at build time instead of in production.
RUN cd /opt/runners/task-runner-javascript && node -e "require('@n8n/di'); require('fuzzball')"

# Install Python packages
#RUN cd /opt/runners/task-runner-python && uv pip install numpy pandas

# Copy the config file
COPY n8n-task-runners.json /etc/n8n-task-runners.json

USER runner
