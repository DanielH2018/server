{% from 'container-resources.yml.j2' import job_container_resources with context %}
{% from 'security-context.yml.j2' import job_hardened_security_context with context %}
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: pi-peer-backup
  namespace: {{ k8s_namespace }}
spec:
  schedule: "{{ pi_peer_backup_k8s_schedule }}"
  # Same local wall-clock slot the daniel-server host cron held.
  timeZone: {{ tz }}
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 2
  jobTemplate:
    spec:
      backoffLimit: 1
      activeDeadlineSeconds: 600
      ttlSecondsAfterFinished: {{ pi_peer_backup_k8s_job_ttl_seconds }}
      template:
        metadata:
          labels:
            app: pi-peer-backup
        spec:
          restartPolicy: Never
          enableServiceLinks: false
          # The token is for one call: the script's verdict export PATCHes the verdict ConfigMap
          # (rbac.yaml.j2 grants `patch` on that one name). The backup itself never calls the API.
          serviceAccountName: pi-peer-backup
          automountServiceAccountToken: true
          securityContext:
            runAsUser: {{ puid }}
            runAsGroup: {{ pgid }}
            fsGroup: {{ pgid }}
          priorityClassName: homelab-best-effort
          containers:
            - name: pi-peer-backup
              image: {{ pi_peer_backup_k8s_image }}
              # Built in-cluster to a mutable :latest; explicit for the reason terraria's
              # deployment records.
              imagePullPolicy: Always
              env:
                - name: PI_SRC
                  value: "{{ hostvars['daniel-pi'].ansible_user | default('ubuntu') }}@{{ hostvars['daniel-pi'].ansible_host }}:{{ pi_peer_backup_src_dir }}"
                - name: KUMA_PUSH_URL
                  valueFrom:
                    secretKeyRef:
                      name: pi-peer-backup-ssh
                      key: push_url
                # Optional off-premises ping; empty when unconfigured. No checksum/config
                # annotation is needed to pick up a Secret change here the way a Deployment
                # would: each scheduled run creates a fresh pod that reads the Secret at start.
                - name: HC_PING_URL
                  valueFrom:
                    secretKeyRef:
                      name: pi-peer-backup-ssh
                      key: hc_ping_url
                # The ConfigMap the verdict is also written to (verdict-configmap.yaml.j2). The
                # script skips the export on the gate run.
                - name: VERDICT_CONFIGMAP
                  value: "{{ pi_peer_backup_k8s_verdict_configmap }}"
                # ssh insists on resolving HOME even with every path given explicitly.
                - name: HOME
                  value: /tmp
{{ job_hardened_security_context(read_only=true, non_root=true) }}
              volumeMounts:
                - name: pi-peer-backup-data
                  mountPath: /data
                - name: pi-peer-backup-ssh
                  mountPath: /ssh
                  readOnly: true
                - name: pi-peer-backup-tmp
                  mountPath: /tmp
{{ job_container_resources(cpu_limit="500m", mem_limit="128Mi", cpu_request="10m", mem_request="16Mi") }}
          volumes:
            - name: pi-peer-backup-data
              persistentVolumeClaim:
                claimName: {{ pi_peer_backup_k8s_claim }}
            # Both Secrets at /ssh: known_hosts from pi-peer-backup-ssh, and the private key
            # `id`, which has a Secret of its own because its multi-line value cannot pass
            # through a Flux placeholder (templates/ssh-key-secret.yaml.j2).
            - name: pi-peer-backup-ssh
              projected:
                # Group-readable for the fsGroup (root-owned files, same trap the bridge
                # twin hit) — but ssh refuses a group-readable identity, so the script
                # stages a 0400 copy under $HOME before connecting.
                defaultMode: 0440
                sources:
                  - secret:
                      name: pi-peer-backup-ssh
                  - secret:
                      name: pi-peer-backup-ssh-key
            - name: pi-peer-backup-tmp
              emptyDir: {}
