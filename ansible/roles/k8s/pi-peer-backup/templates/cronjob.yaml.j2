---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: pi-peer-backup
  namespace: {{ k8s_namespace }}
spec:
  schedule: "{{ pi_peer_backup_k8s_schedule }}"
  # Same local wall-clock slot the daniel-server host cron held.
  timeZone: {{ tz }}
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 2
  jobTemplate:
    spec:
      backoffLimit: 1
      activeDeadlineSeconds: 600
      template:
        metadata:
          labels:
            app: pi-peer-backup
        spec:
          restartPolicy: Never
          enableServiceLinks: false
          automountServiceAccountToken: false
          securityContext:
            runAsUser: {{ puid }}
            runAsGroup: {{ pgid }}
            fsGroup: {{ pgid }}
          priorityClassName: homelab-best-effort
          containers:
            - name: pull
              image: {{ pi_peer_backup_k8s_image }}
              # Built in-cluster to a mutable :latest; explicit for the reason terraria's
              # deployment records.
              imagePullPolicy: Always
              env:
                - name: PI_SRC
                  value: "{{ hostvars['daniel-pi'].ansible_user | default('ubuntu') }}@{{ hostvars['daniel-pi'].ansible_host }}:/home/{{ sys_user }}/server/containers/wg-easy/config/"
                - name: KUMA_PUSH_URL
                  valueFrom:
                    secretKeyRef:
                      name: pi-peer-backup-ssh
                      key: push_url
                # Optional off-premises ping; empty when unconfigured. No checksum/config
                # annotation is needed to pick up a Secret change here the way a Deployment
                # would: each scheduled run creates a fresh pod that reads the Secret at start.
                - name: HC_PING_URL
                  valueFrom:
                    secretKeyRef:
                      name: pi-peer-backup-ssh
                      key: hc_ping_url
                # ssh insists on resolving HOME even with every path given explicitly.
                - name: HOME
                  value: /tmp
              securityContext:
                runAsNonRoot: true
                readOnlyRootFilesystem: true
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
              volumeMounts:
                - name: pi-peer-backup-data
                  mountPath: /data
                - name: pi-peer-backup-ssh
                  mountPath: /ssh
                  readOnly: true
                - name: pi-peer-backup-tmp
                  mountPath: /tmp
              resources:
                limits:
                  cpu: "500m"
                  memory: 128Mi
                requests:
                  cpu: "10m"
                  memory: 16Mi
          volumes:
            - name: pi-peer-backup-data
              persistentVolumeClaim:
                claimName: {{ pi_peer_backup_k8s_claim }}
            - name: pi-peer-backup-ssh
              secret:
                secretName: pi-peer-backup-ssh
                # Group-readable for the fsGroup (root-owned files, same trap the bridge
                # twin hit) — but ssh refuses a group-readable identity, so the script
                # stages a 0400 copy under $HOME before connecting.
                defaultMode: 0440
            - name: pi-peer-backup-tmp
              emptyDir: {}
