# DIGEST-PINNED — see roles/k8s/ical-proxy/templates/Dockerfile.j2 for why a version tag alone is
# not a pin. `alpine:3.22` re-points at every 3.22.x patch, so the tag reads pinned while the base
# moves. Keep the tag alongside the digest — it is what holds the 3.22 line.
FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

RUN apk add --no-cache bash rsync openssh-client curl
# ssh refuses to run as a uid with no passwd entry ("No user exists for uid 1000") —
# the pod runs as {{ puid }} via securityContext, so give that uid a name.
RUN adduser -D -u {{ puid }} puller

# COPY . (not a per-file COPY): the build context is a ConfigMap mount — see the nut
# Dockerfile for the symlink trap this avoids.
COPY . /build-context/
RUN install -m 0755 /build-context/pull-pi-peers.sh /usr/local/bin/pull-pi-peers.sh \
    && rm -rf /build-context

ENTRYPOINT ["/usr/local/bin/pull-pi-peers.sh"]
