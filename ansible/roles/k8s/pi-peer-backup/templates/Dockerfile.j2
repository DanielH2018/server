# DIGEST-PINNED — see roles/k8s/ical-proxy/templates/Dockerfile.j2 for why a version tag alone is
# not a pin. An alpine minor tag re-points at every patch within it, so the tag reads pinned while
# the base moves. Keep the tag alongside the digest — it BOUNDS the digest bumps Renovate raises,
# so one cannot silently cross a minor. Crossing a minor is therefore a deliberate operator
# decision (a tag-change PR), and taking one means rebuilding: this image is built and pushed to
# the in-cluster registry, so merging the bump ships nothing until
# `./scripts/deploy.sh --tags pi-peer-backup` rebuilds it.
#
# The version is deliberately NOT named here — a comment that quotes the line it guards is
# falsified by the next bump, which is what happened to the 3.22 text this replaces.
FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

RUN apk add --no-cache bash rsync openssh-client curl
# ssh refuses to run as a uid with no passwd entry ("No user exists for uid 1000") —
# the pod runs as {{ puid }} via securityContext, so give that uid a name.
RUN adduser -D -u {{ puid }} puller

# COPY . (not a per-file COPY): the build context is a ConfigMap mount — see the nut
# Dockerfile for the symlink trap this avoids.
COPY . /build-context/
RUN install -m 0755 /build-context/pull-pi-peers.sh /usr/local/bin/pull-pi-peers.sh \
    && rm -rf /build-context

ENTRYPOINT ["/usr/local/bin/pull-pi-peers.sh"]
