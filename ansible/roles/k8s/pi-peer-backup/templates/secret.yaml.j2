---
# The pull job's single-line settings: the Pi host key pinned from the committed
# files/daniel-pi-ssh-host-ed25519.pub (the job verifies with StrictHostKeyChecking=yes —
# never TOFU), and the Healthchecks.io ping URL. The Kuma push URL went at M6 batch B7's
# Cutover-2. The private key has a Secret of its own,
# pi-peer-backup-ssh-key (ssh-key-secret.yaml.j2), because its multi-line value cannot pass
# through a Flux placeholder. The CronJob projects both Secrets into /ssh.
#
# The pin is committed rather than read from the Pi at deploy, so the manifest renders from
# git alone (target slice R3). When the Pi's host key changes, the nightly run reports
# "daniel-pi host key differs from the committed pin": re-read the key with
# `ssh daniel-pi cat /etc/ssh/ssh_host_ed25519_key.pub` and commit it. server_ip, not
# ansible_host: the Pi's ansible_host is a Jinja expression over server_ip, so both render the
# same address.
{% set pi_host_key = lookup('file', playbook_dir + '/roles/k8s/pi-peer-backup/files/daniel-pi-ssh-host-ed25519.pub').split() %}
apiVersion: v1
kind: Secret
metadata:
  name: pi-peer-backup-ssh
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  known_hosts: "{{ hostvars['daniel-pi'].server_ip }} {{ pi_host_key[:2] | join(' ') }}"
  # Off-premises dead-man's switch. A cluster outage silences this CronJob and every Prometheus
  # rule that reads its verdict. hc-ping.com is off-site and alerts on the silence. Rendered
  # empty when the secrets define no healthchecks_ping_key —
  # the script skips an empty URL, so an unconfigured cluster behaves exactly as before. A defined
  # key renders the URL whatever its value, an empty one included. Bare slug, never ?create=1:
  # auto-provisioning would turn a typo into an unwatched check that reads green forever.
{% if healthchecks_ping_key is defined %}
  hc_ping_url: "https://hc-ping.com/{{ healthchecks_ping_key }}/pi-peer-backup"
{% else %}
  hc_ping_url: ""
{% endif %}
