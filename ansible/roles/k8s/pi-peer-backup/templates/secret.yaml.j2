---
# The pull job's credentials: a dedicated ed25519 keypair (private half SOPS-stored as
# pi_peer_backup_ssh_key; public half authorized on the Pi by this role), the Pi host
# key pinned from the committed files/daniel-pi-ssh-host-ed25519.pub (the job verifies
# with StrictHostKeyChecking=yes — never TOFU), and the Kuma push URL whose token is
# the same "WG Pi Peer Backup" monitor the retired bridge check pushed.
#
# The pin is committed rather than read from the Pi at deploy, so the manifest renders from
# git alone (target slice R3). When the Pi's host key changes, the nightly run pushes
# "daniel-pi host key differs from the committed pin": re-read the key with
# `ssh daniel-pi cat /etc/ssh/ssh_host_ed25519_key.pub` and commit it. server_ip, not
# ansible_host: the Pi's ansible_host is a Jinja expression over server_ip, so both render the
# same address.
{% set pi_host_key = lookup('file', playbook_dir + '/roles/k8s/pi-peer-backup/files/daniel-pi-ssh-host-ed25519.pub').split() %}
apiVersion: v1
kind: Secret
metadata:
  name: pi-peer-backup-ssh
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  id: |
{{ pi_peer_backup_ssh_key | indent(4, true) }}
  known_hosts: "{{ hostvars['daniel-pi'].server_ip }} {{ pi_host_key[:2] | join(' ') }}"
  push_url: "http://uptime-kuma.{{ k8s_namespace }}.svc.cluster.local:{{ containers_list | entry_port('uptime-kuma') }}/api/push/{{ monitor_bridge_pi_peers_push_token }}"
  # Off-premises dead-man's switch. push_url above resolves to a Service in this cluster, so a
  # cluster outage silences the push AND the Kuma monitor waiting for it. hc-ping.com is off-site
  # and alerts on the silence. Rendered empty when no key is configured — the script skips it, so
  # an unconfigured cluster behaves exactly as before. Bare slug, never ?create=1: auto-provisioning
  # would turn a typo into an unwatched check that reads green forever.
{% if healthchecks_ping_key | default('') %}
  hc_ping_url: "https://hc-ping.com/{{ healthchecks_ping_key }}/pi-peer-backup"
{% else %}
  hc_ping_url: ""
{% endif %}
