---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ pi_peer_backup_k8s_claim }}
  namespace: {{ k8s_namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  # Plain `longhorn` ON PURPOSE (not -nobackup): riding the 03:30 daily-backup group to
  # B2 is this volume's entire reason to exist — it replaces the retired Kopia scope for
  # the Pi's un-rebuildable WireGuard peer keys.
  storageClassName: longhorn
  resources:
    requests:
      # 128Mi, not 100Mi: Longhorn's admission webhook rejects any volume whose size is not
      # an integer multiple of default-backup-block-size, which is 16Mi since 2026-08-19.
      # At 100Mi this PVC provisions today and would fail to be recreated — which is exactly
      # the disaster-recovery path it exists to serve.
      storage: 128Mi
