{% from 'container-resources.yml.j2' import job_container_resources with context %}
{% from 'security-context.yml.j2' import job_hardened_security_context with context %}
{#
  Prunes archived bookmarks by age: detaches the screenshot after
  karakeep_k8s_pruner_screenshot_days, deletes the bookmark after karakeep_k8s_pruner_delete_days
  unless a person marked it. files/karakeep_archive_pruner.py holds the rules and why each one
  is safe; this file only schedules it.

  karakeep_k8s_pruner_apply gates every change. False, a run logs what it would do and changes
  nothing, so each deploy's gate run (tasks/main.yml) is a dry-run report.
#}
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: karakeep-archive-pruner
  namespace: {{ k8s_namespace }}
spec:
  schedule: "{{ karakeep_k8s_pruner_schedule }}"
  timeZone: "{{ tz }}"
  # The deploy gate creates a Job from this CronJob out of schedule. Forbid stops a scheduled
  # run starting under it; the rules key on age, so the run that overlaps the other way does
  # nothing the first one would not.
  concurrencyPolicy: Forbid
  startingDeadlineSeconds: 600
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      activeDeadlineSeconds: {{ karakeep_k8s_pruner_deadline_seconds }}
      ttlSecondsAfterFinished: {{ karakeep_k8s_pruner_job_ttl_seconds }}
      # No retry. A failed run leaves the library as it was, and tomorrow's run picks up the
      # same work.
      backoffLimit: 0
      template:
        metadata:
          labels:
            app: karakeep-archive-pruner
            netpol-baseline: enforced
        spec:
          restartPolicy: Never
          enableServiceLinks: false
          automountServiceAccountToken: false
          priorityClassName: homelab-best-effort
          containers:
            - name: archive-pruner
              # The tagger's image, for its python3 and uid 1000. The script is stdlib only,
              # so nothing installs at start and the root filesystem can stay read-only.
              image: {{ karakeep_k8s_tagger_image }}
              # Built in-cluster: see the `built-images-pull-always` row of
              # ansible/tests/k8s/_workload_property_rows.py.
              imagePullPolicy: Always
              command:
                - python3
                - /script/karakeep_archive_pruner.py
                - --screenshot-days={{ karakeep_k8s_pruner_screenshot_days }}
                - --delete-days={{ karakeep_k8s_pruner_delete_days }}
                - --max-deletes={{ karakeep_k8s_pruner_max_deletes }}
                - --connect-budget-seconds={{ karakeep_k8s_pruner_connect_budget_seconds }}
{% for tag in karakeep_k8s_pruner_auto_tags %}
                - --auto-tag={{ tag }}
{% endfor %}
{% if karakeep_k8s_pruner_apply | bool %}
                - --apply
{% endif %}
              env:
                - name: KARAKEEP_API_URL
                  value: http://karakeep:{{ container_item.port }}/api/v1
                - name: KARAKEEP_API_KEY
                  valueFrom:
                    secretKeyRef:
                      name: karakeep
                      key: KARAKEEP_PYTHON_API_KEY
                - name: PYTHONDONTWRITEBYTECODE
                  value: "1"
{{ job_hardened_security_context(read_only=true, non_root=true, run_as_user=1000, run_as_group=1000) }}
              volumeMounts:
                - name: archive-pruner-script
                  mountPath: /script
                  readOnly: true
{{ job_container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='32Mi') }}
          volumes:
            - name: archive-pruner-script
              configMap:
                name: karakeep-archive-pruner
