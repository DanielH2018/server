{% from 'ingressroute.yml.j2' import ingressroute, monitoring_route with context %}
---
{#
  csp-karakeep rides on the main route only. The bypass documents the macro renders from
  bridge_bypass_prefixes carry rate-limit alone, and that is fine: they serve JSON, and a CSP on
  JSON does nothing — the Docker-era compose template said as much where it excluded the bypass
  router (`git show
  2460d0675fd748e70fcbcde87185371ffd62402b:ansible/roles/containers/archive/karakeep/templates/docker-compose.yml.j2`,
  deleted by #2385).
#}
{{ ingressroute(
    container_item.name,
    container_item.hostname | default(container_item.name),
    container_item.port,
    container_item.use_authelia,
    extra_middlewares=['csp-karakeep'],
    bypass_prefixes=container_item.bridge_bypass_prefixes | default([])
  )
}}
---
{#
  Homepage's karakeep widget (daniel-server, session-less API-key caller; pod CIDR added when homepage itself moved in-cluster, E3) — same story as
  speedtest: the no-auth bridge route it used died in the slice-7 teardown.

  The prefix is the ONE path the widget reads: homepage's karakeep widget renders
  `{url}/api/v1/{endpoint}` with a single `users/me/stats` endpoint
  (src/widgets/karakeep/widget.js in gethomepage/homepage). It was `/api/` until #2018, which
  also matched next-auth's `/api/auth/*` — the password login #1929 put back behind Authelia
  on the public name stayed open to every pod on the `.local` one. Widen it only with the
  widget source in hand, and never past `/api/v1/`:
  ansible/tests/services/test_karakeep_public_bypass.py refuses a prefix that reaches next-auth.
#}
{{ monitoring_route(
    container_item.name,
    container_item.hostname | default(container_item.name),
    container_item.port,
    '/api/v1/users/me/stats',
    extra_client_cidrs=['10.42.0.0/16']
  )
}}
