---
apiVersion: v1
kind: Secret
metadata:
  name: karakeep
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  # All four MUST match the Docker twin's. NEXTAUTH_SECRET signs the session cookies already
  # held by logged-in browsers, and MEILI_MASTER_KEY is shared by karakeep and Meilisearch —
  # a fresh value on either side reads as "everyone logged out" or "search is broken" rather
  # than as a configuration error.
  MEILI_MASTER_KEY: "{{ karakeep_meili_master_key }}"
  NEXTAUTH_SECRET: "{{ karakeep_nextauth_secret }}"
  OPENAI_API_KEY: "{{ karakeep_gemini_api_key }}"
  KARAKEEP_PYTHON_API_KEY: "{{ karakeep_python_api_key }}"
