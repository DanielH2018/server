{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: karakeep-chrome
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  selector:
    matchLabels:
      app: karakeep-chrome
  template:
    metadata:
      labels:
        app: karakeep-chrome
        # EXEMPT, not enforced. The baseline's ingress rule carries no `ports:` key, so labelling
        # this pod admits traefik, prometheus and both node bridges on EVERY port — including
        # 9222, where Chrome serves unauthenticated DevTools (remote browser control) and must
        # bind 0.0.0.0 because karakeep dials it cross-pod. That is strictly wider than the
        # bespoke policy in netpol-baseline/templates/networkpolicy-karakeep-chrome.yaml.j2,
        # which admits app=karakeep alone. Same reasoning as flaresolverr and n8n: a headless
        # browser rendering attacker-supplied pages is exactly the workload not to widen.
        netpol-baseline-exempt: "true"
    spec:
      enableServiceLinks: false
      automountServiceAccountToken: false
      priorityClassName: homelab-standard
      # Preference, never a pin: daniel-box carries the storage- and VIP-pinned workloads and runs the hotter of the two nodes, so latency-insensitive services default here.
      # Weighted so the pod still schedules if daniel-server is cordoned or full.
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: chrome
          image: {{ karakeep_k8s_chrome_image }}
          args:
            - --no-sandbox
            - --disable-gpu
            - --disable-dev-shm-usage
            - --remote-debugging-address=0.0.0.0
            - --remote-debugging-port=9222
            - --hide-scrollbars
          ports:
            - containerPort: 9222
          securityContext:
            allowPrivilegeEscalation: false
            # The image already starts chromium as uid 1000 (verified on the live pod, 2026-08-31);
            # asserting it here is what makes that an API-server guarantee rather than an image
            # default a future tag bump could drop silently. runAsNonRoot alone would not do it —
            # the kubelet only rejects a numeric root uid, so the uid is the load-bearing half.
            # Safe for THIS container specifically because it mounts no volumes and binds 9222,
            # an unprivileged port. Do not copy it to the sibling karakeep deployments without
            # checking each one: karakeep's own /data seed tree and time-tagger's /root/.cache/uv
            # are root-owned, so the same three lines would break them (2026-08-31 review).
            runAsNonRoot: true
            runAsUser: 1000
            capabilities:
              # Chrome already runs with --no-sandbox, so it needs no SYS_ADMIN or sandbox caps.
              drop:
                - ALL
          readinessProbe:
            httpGet:
              path: /json/version
              port: 9222
            initialDelaySeconds: 15
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /json/version
              port: 9222
            initialDelaySeconds: 60
            periodSeconds: 30
          resources:
            limits:
              cpu: "{{ karakeep_k8s_chrome_cpu_limit }}"
              memory: {{ karakeep_k8s_chrome_mem_limit }}
            requests:
              cpu: "{{ karakeep_k8s_chrome_cpu_request }}"
              memory: {{ karakeep_k8s_chrome_mem_request }}
