{% from 'networkpolicy.yml.j2' import networkpolicy with context %}
---
# karakeep's headless Chrome. karakeep dials it at BROWSER_WEB_URL=http://karakeep-chrome:9222
# (deployment.yaml.j2) to render pages it is archiving.
#
# It renders attacker-supplied pages, so it is worth fencing tightly: karakeep is the only
# caller that has any business here. The pod is in netpol_baseline_exempt_workloads, so the
# baseline selects nothing here and this policy is the pod's whole fence: karakeep on 9222,
# and no traefik, prometheus or node bridge on any port. No route or scrape targets the pod.
#
# THIS POLICY SHIPS WITH THE ROLE THAT NEEDS IT, for the same reason as
# networkpolicy-meilisearch.yaml.j2 beside it (#1620) — read that file for the full rationale.
# `wait-for-deps` waits on karakeep-chrome:9222 as well as meilisearch, so moving only one of
# the two would still leave `--tags karakeep` able to stage a pod that never leaves Init.
#
# 9222 is the containerPort AND the Service port — verified 2026-08-20, they match, and
# ansible/tests/services/test_karakeep_backend_policies.py keeps them matching.
#
# NO `netpol_baseline_enforced` BRANCH — same reason as the meilisearch policy: the lever is a
# netpol-baseline role default and does not resolve in this role.
#
# The port and caller list are the `netpol_fences` item for `karakeep-chrome` on this role's
# containers_list entry (inventory/host_vars/daniel-box.yml). Its `role_owned: true` keeps
# netpol-baseline's callers loop from rendering a second copy. A missing item fails the render
# rather than shipping no policy.
{% set fence = container_item.netpol_fences | selectattr('app', 'equalto', 'karakeep-chrome') | first %}
{{ networkpolicy(fence.app, fence.port, fence['from']) }}
