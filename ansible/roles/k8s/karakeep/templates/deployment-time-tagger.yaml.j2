{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: karakeep-time-tagger
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  selector:
    matchLabels:
      app: karakeep-time-tagger
  template:
    metadata:
      labels:
        app: karakeep-time-tagger
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      initContainers:
        # The compose template gates this container on `depends_on: karakeep: condition:
        # service_healthy`, which has NO k8s equivalent — pods start in parallel. Without this
        # the tagger raced the app, failed its initial connection check against
        # /api/v1/users/me with ECONNREFUSED, and crashed; observed on the first deploy.
        #
        # It does not merely fail once. The script's loop only touches /tmp/healthy after a
        # SUCCESSFUL run, so the liveness probe finds no file, restarts the pod, and the whole
        # `uv pip install` runs again — a restart loop that resolves only when a run happens to
        # land after the app is up.
        #
        # A TCP connect to the SERVICE is the faithful translation, not an approximation: a k8s
        # Service routes only to READY endpoints, so this connects exactly when karakeep's
        # readiness probe passes, which is what service_healthy meant.
        - name: wait-for-karakeep
          image: {{ karakeep_k8s_tagger_image }}
          command:
            - python3
            - -c
            - |
              import socket, time
              while True:
                  try:
                      socket.create_connection(("karakeep", {{ container_item.port }}), 5).close()
                      break
                  except OSError:
                      time.sleep(5)
{{ hardened_security_context() }}
{{ container_resources(cpu_limit='250m', mem_limit='128Mi', cpu_request='10m', mem_request='16Mi') }}
      automountServiceAccountToken: false
      priorityClassName: homelab-standard
      # Preference, never a pin: daniel-box carries the storage- and VIP-pinned workloads and runs the hotter of the two nodes, so latency-insensitive services default here.
      # Weighted so the pod still schedules if daniel-server is cordoned or full.
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: time-tagger
          image: {{ karakeep_k8s_tagger_image }}
          # Runtime deps are version-pinned rather than floating so a container start does not
          # silently re-resolve them to whatever is newest on PyPI — the same silent drift the
          # base-image digest pin closes, one layer down. Renovate tracks each pin via a custom
          # manager, so they age visibly. Kept identical to the compose command, minus the
          # rotated-log prune: the script's loguru sink rotates into the working directory, which
          # on Docker was the container's writable layer that nothing cleaned. Here the working
          # directory is an emptyDir that dies with the pod, so the prune has nothing to do.
          command:
            - bash
            - -c
            - >-
              uv pip install karakeep-python-api==1.8.0 fire==0.7.1 tqdm==4.70.0
              beautifulsoup4==4.15.0 loguru==0.7.3 -q --system &&
              while true; do
              python /script/karakeep-time-tagger.py --cache_file /tmp/bookmarks.temp --reset_all=True
              && touch /tmp/healthy;
              sleep 900;
              done
          workingDir: /work
          # No DAC_OVERRIDE, unlike the compose template. That cap existed only because the
          # uv cache was a bind mount owned by uid 1000 while the container ran as root; an
          # emptyDir is created root-owned, so the reason is gone with the bind mount.
{{ hardened_security_context() }}
          env:
            # This container was the homelab's single largest Loki emitter — 22,786 lines per 30
            # minutes measured 2026-08-29 — and every INFO line was written THREE times, byte- and
            # timestamp-identical. Three loguru stderr handlers were active at once:
            #
            #   1. loguru's own pre-configured default handler,
            #   2. the vendored script's, added by setup_logging(),
            #   3. karakeep_python_api's, added on every KarakeepAPI() construction
            #      (karakeep_api.py:146, reached from the script's line 288).
            #
            # Handlers 2 and 3 each sit directly below a COMMENTED-OUT `logger.remove()` — the
            # same upstream bug, in two different packages.
            #
            # LOGURU_AUTOINIT=false removes handler 1 at import, which is loguru's supported way
            # to suppress the pre-configured sink (_defaults.py:30). It takes the line rate to 2x.
            #
            # THE OBVIOUS FIX IS THE WRONG ONE HERE. Uncommenting `logger.remove()` in the
            # vendored script would also reach handler 1 — but that file is upstream's bytes,
            # pinned by sha256 to an immutable commit in the archived Docker role, and
            # ansible/tests/services/test_karakeep_time_tagger_script.py exists to fail when the vendored
            # copy stops matching what upstream serves. Editing it and re-pinning to our own hash
            # would keep the test green while destroying what it checks.
            #
            # Handler 3 has no env-var escape: karakeep_api.py adds its sink unconditionally,
            # and KARAKEEP_PYTHON_API_VERBOSE only picks its LEVEL. Removing it needs an upstream
            # fix, so 2x is the floor without one.
            - name: LOGURU_AUTOINIT
              value: "false"
            - name: TZ
              value: "{{ tz }}"
            - name: KARAKEEP_PYTHON_API_ENDPOINT
              value: http://karakeep:{{ container_item.port }}/api/v1/
            - name: KARAKEEP_PYTHON_API_KEY
              valueFrom:
                secretKeyRef:
                  name: karakeep
                  key: KARAKEEP_PYTHON_API_KEY
          volumeMounts:
            - name: time-tagger-script
              mountPath: /script
              readOnly: true
            - name: time-tagger-uv-cache
              mountPath: /root/.cache/uv
            - name: time-tagger-work
              mountPath: /work
          # The compose healthcheck, unchanged: /tmp/healthy is touched only after a SUCCESSFUL
          # run, so a hung or persistently failing tagger goes stale even though the process is
          # alive. The loop sleeps 900s, so <2100 allows one missed cycle. No readiness probe —
          # nothing routes to this and nothing waits on it, so readiness would only add a state
          # that means nothing.
          livenessProbe:
            exec:
              command:
                - python3
                - -c
                - "import os,sys,time; sys.exit(0 if time.time()-os.stat('/tmp/healthy').st_mtime<2100 else 1)"
            initialDelaySeconds: 600
            periodSeconds: 60
{{ container_resources(cpu_limit=karakeep_k8s_tagger_cpu_limit, mem_limit=karakeep_k8s_tagger_mem_limit, cpu_request=karakeep_k8s_tagger_cpu_request, mem_request=karakeep_k8s_tagger_mem_request) }}
      volumes:
        - name: time-tagger-script
          configMap:
            name: karakeep-time-tagger
        - name: time-tagger-uv-cache
          emptyDir: {}
        - name: time-tagger-work
          emptyDir: {}
