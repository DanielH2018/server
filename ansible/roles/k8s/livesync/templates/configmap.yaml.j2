---
apiVersion: v1
kind: ConfigMap
metadata:
  name: livesync-config
  namespace: {{ k8s_namespace }}
data:
  local.ini: |
{#
  Rendered from the Docker role's template rather than copied here, so the two deployments read
  byte-identical CouchDB config through coexistence. The smoosh ratios in particular are tuned
  to bound .couch bloat, and a copy that drifted would change how fast the volume grows on one
  side only — which then reads as a k8s problem.
#}
{{ lookup('template', playbook_dir + '/roles/containers/livesync/templates/local.ini.j2') | indent(4, true) }}
