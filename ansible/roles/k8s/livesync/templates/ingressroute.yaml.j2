{% from 'ingressroute.yml.j2' import ingressroute with context %}
---
{#
  use_authelia is false, matching the retired Docker entry and for the same reason: the
  Obsidian LiveSync client uses non-interactive basic auth and cannot pass 2FA. CouchDB's
  own require_valid_user (local.ini) is the gate on this route.

  Only the -k8s names route here. The UNSUFFIXED names (livesync.<domain> and its .local
  twin) are served by the X-Sync-Token gate in the k8s Traefik's Secret-mounted file
  provider (roles/k8s/traefik/templates/livesync-gate-secret.yaml.j2) — a token router, an
  Authelia'd /_utils carve-out, and the Kuma probe router. The token stays out of CRDs on
  purpose: the readonly kubeconfig can read IngressRoutes but is RBAC-denied Secrets.
#}
{{ ingressroute(
    container_item.name,
    container_item.hostname | default(container_item.name),
    container_item.port,
    container_item.use_authelia
  )
}}
