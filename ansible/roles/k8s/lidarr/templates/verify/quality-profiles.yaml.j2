{#
  lidarr's quality profile seed as a post-apply mutation Job, in `lidarr-verify` beside the
  Discord notification seed. The shape follows `notification.yaml.j2`: the renderer emits it
  from `templates/verify/`, the pod carries the `lidarr-verify` label that lidarr's
  `netpol_from` admits, and the spec embeds a digest of the rendered Deployment so the seed
  runs again on every revision that rolls lidarr.

  DECIDED: the profiles come from `lidarr_quality_profiles` in this role's defaults, rendered
  as one JSON env value. The script holds no profile, so changing what lidarr allows is an
  edit to that one list and renames the Job.

  DECIDED: the API key comes from `lidarr-exportarr`, which lidarr's own render applies, as the
  Discord seed does (see its note on why not a Secret here).
#}
{% set script_name = 'seed_lidarr_quality_profiles.py' %}
{% set script_dir = '/seed' %}
{% set data = {
  script_name: lookup('file', role_file('files/' + script_name), rstrip=False),
  'flux_job_connect.py': flux_job_connect,
} %}
{% set configmap_name = 'lidarr-quality-seed-' + ({'data': data, 'binaryData': {}} | to_json(sort_keys=True, separators=(',', ':')) | hash('sha256'))[:8] %}
{% set deployment_digest8 = (lookup('template', 'deployment.yaml.j2') | hash('sha256'))[:8] %}
{% set spec_text %}
# One retry. The seed adopts by name and never deletes, so a second run reads the profiles again
# and writes only what is still missing.
backoffLimit: 1
# Below the 600s `manifests_rollout_timeout_default` every `<tag>-verify` Kustomization takes.
# One list, then at most one schema read and one write per profile, 30s each, plus the
# helper's 60s of retries on the first connect.
activeDeadlineSeconds: 300
template:
  metadata:
    labels:
      # The verify Jobs' label, so the one `lidarr-verify` peer in lidarr's `netpol_from`
      # admits this Job too.
      app: lidarr-verify
  spec:
    serviceAccountName: lidarr-verify
    # The Job reads lidarr's API, not the Kubernetes API, so its pod holds no token.
    automountServiceAccountToken: false
    restartPolicy: Never
    enableServiceLinks: false
    securityContext:
      runAsNonRoot: true
      runAsUser: 65534
      runAsGroup: 65534
      seccompProfile:
        type: RuntimeDefault
    containers:
      - name: seed
        image: {{ flux_job_image }}
        imagePullPolicy: IfNotPresent
        command:
          - python3
          - {{ script_dir }}/{{ script_name }}
        env:
          # The Service by its cluster name; the script appends /api/v1.
          - name: LIDARR_URL
            value: http://{{ container_item.name }}.{{ k8s_namespace }}.svc.cluster.local:{{ container_item.port }}
          - name: LIDARR_API_KEY
            valueFrom:
              secretKeyRef:
                name: lidarr-exportarr
                key: api_key
          - name: LIDARR_QUALITY_PROFILES
            value: {{ lidarr_quality_profiles | to_json | to_json }}
          # Renames the Job whenever lidarr's Deployment changes; see the note above.
          - name: LIDARR_DEPLOYMENT_DIGEST8
            value: "{{ deployment_digest8 }}"
          - name: PYTHONDONTWRITEBYTECODE
            value: "1"
        resources:
          requests:
            cpu: 10m
            memory: 32Mi
          limits:
            memory: 64Mi
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop:
              - ALL
        volumeMounts:
          - name: script
            mountPath: {{ script_dir }}
            readOnly: true
    volumes:
      - name: script
        configMap:
          name: {{ configmap_name }}
{% endset %}
{% set spec = spec_text | from_yaml %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ configmap_name }}
  namespace: {{ k8s_namespace }}
data:
{% for key, text in data | dictsort %}
  {{ key }}: {{ text | to_json }}
{% endfor %}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: lidarr-quality-profiles-seed-{{ (spec | to_json(sort_keys=True, separators=(',', ':')) | hash('sha256'))[:8] }}
  namespace: {{ k8s_namespace }}
  annotations:
    homelab/job-kind: mutation
    homelab/rerun-safe: ansible/roles/k8s/lidarr/tests/test_seed_lidarr_quality_profiles.py::test_a_second_run_changes_nothing
spec:
{{ spec_text | indent(2, true) }}
