{# Bridge-teardown BT3 (2026-08-10, superseding slice-6 D7): the LAN wildcard answers the
   cluster ingress VIP — k8s services route natively (incl. the new unsuffixed .local
   routes), Docker-hosted names ride the reverse bridge's .local twins. The shared template
   defaults its wildcard to the rendering host's server_ip, which HERE would be daniel-box;
   pin it to the VIP. #}
{% set pihole_wildcard_ip = k3s_metallb_ingress_vip %}
{% set pihole_unbound_port = pihole_k8s_unbound_port %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: pihole-dns-config
  namespace: {{ k8s_namespace }}
data:
  # Rendered from the same templates as the Docker copy's bind mounts
  # (this role's templates/config/pihole-*.j2 — moved out of the old shared
  # ansible/templates/ during the macro-bridge inlining) — one source, two deployment shapes.
  # A Jinja include (not lookup('template', ...)) is deliberate: it shares this template's
  # local set-variable scope (pihole_wildcard_ip, pihole_unbound_port below) with the
  # included file, which a separate lookup() render would not.
  02-wildcard.conf: |
{% filter indent(4, true) %}
{% include 'config/pihole-dnsmasq.conf.j2' %}
{% endfilter %}

  # The blank line above is LOAD-BEARING: {% raw %}{% include %}{% endraw %} drops the
  # included file's trailing newline, so without it this key concatenates onto the literal
  # block's last line — still-valid YAML with ONE key, which the validator cannot catch
  # (bit live 2026-08-09: unbound crash-looped with "input in flex scanner failed" on the
  # subPath mount of the then-missing key).
  my_settings.conf: |
{% filter indent(4, true) %}
{% include 'config/pihole-unbound.conf.j2' %}
{% endfilter %}
