{#
  media-volume's verify Job and the ConfigMap that carries its script, INERT until
  media-volume's flip.

  This directory is `verify-inert/`, which neither reader globs: the manifests role takes only
  top-level `templates/*.yaml.j2`, and `verify_files` takes only `templates/verify/*.yaml.j2`.
  media-volume's flip PR moves the directory to `templates/verify/`, and the renderer then
  emits it into `media-volume-verify` (D5, *A verify conversion lands as inert code*). The same
  PR deletes the hardlink probe tasks and `hardlink-probe-job.yaml.j2`, which this Job
  replaces.

  Both names end in a digest, as the Job census requires (D5, *Rules for every Job Flux
  applies*): the ConfigMap's in `configmap_digest8` of its data, the Job's in
  `job_spec_digest8` of its spec. Each is computed here from the same JSON those functions
  hash, so the spec is written once as YAML text, parsed for the hash and emitted verbatim.
  The renderer passes `flux_job_image` to every `templates/verify/` file (`render_tag`).

  DECIDED: the spec embeds a digest of the rendered PersistentVolume and StorageClass, because
  the role renders no Deployment whose roll could rename the Job. Those two documents are what
  the probe tests: the path, the node pin and the binding. The Ansible probe re-runs on every
  deploy, and this Job re-runs only when that render changes. A regression with no render
  change, such as a claim rebound by hand, waits for the next one. tdarr's verify Job mounts
  the same claim, so a claim that no longer binds still fails a Job on tdarr's next roll.

  The caller census (D5, *A fence admits every Job that dials through it*): the pod dials
  nothing and execs into nothing, so it needs no fence peer.
#}
{% set script_name = 'media_volume_verify.py' %}
{% set script_dir = '/verify' %}
{% set data = {script_name: lookup('file', playbook_dir + '/roles/k8s/media-volume/files/' + script_name, rstrip=False)} %}
{% set configmap_name = 'media-volume-verify-' + ({'data': data, 'binaryData': {}} | to_json(sort_keys=True, separators=(',', ':')) | hash('sha256'))[:8] %}
{% set render_digest8 = ((lookup('template', 'pv.yaml.j2') + lookup('template', 'storageclass.yaml.j2')) | hash('sha256'))[:8] %}
{% set spec_text %}
# A second attempt of a deterministic filesystem test tells nothing the first did not.
backoffLimit: 0
# Below the 600s `manifests_rollout_timeout_default` every `<tag>-verify` Kustomization takes.
# The claim binds only once this pod schedules (WaitForFirstConsumer), so a Pending pod that
# runs into the deadline means the PV's node pin is wrong, not the hardlink.
activeDeadlineSeconds: 300
template:
  metadata:
    labels:
      app: media-volume-verify
  spec:
    serviceAccountName: media-volume-verify
    # The Job reads no API, so its pod holds no token.
    automountServiceAccountToken: false
    restartPolicy: Never
    enableServiceLinks: false
    # The uid the media stack runs as, so the Job also proves that user can write the volume.
    # Deliberately NO fsGroup: it would make the kubelet chown the whole library on every
    # mount, and the files are already {{ puid }}:{{ pgid }}.
    securityContext:
      runAsNonRoot: true
      runAsUser: {{ puid }}
      runAsGroup: {{ pgid }}
      seccompProfile:
        type: RuntimeDefault
    containers:
      - name: verify
        image: {{ flux_job_image }}
        command:
          - python3
          - {{ script_dir }}/{{ script_name }}
        env:
          - name: VERIFY_DATA
            value: /data
          # Renames the Job whenever the PV or StorageClass changes; see the DECIDED note above.
          - name: MEDIA_VOLUME_RENDER_DIGEST8
            value: "{{ render_digest8 }}"
          - name: PYTHONDONTWRITEBYTECODE
            value: "1"
        resources:
          requests:
            cpu: 10m
            memory: 32Mi
          limits:
            memory: 64Mi
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop:
              - ALL
        volumeMounts:
          - name: script
            mountPath: {{ script_dir }}
            readOnly: true
          # The whole claim at /data, as every mounter sees it: torrents/ and media/ inside.
          - name: media
            mountPath: /data
    volumes:
      - name: script
        configMap:
          name: {{ configmap_name }}
      - name: media
        persistentVolumeClaim:
          claimName: {{ media_volume_claim }}
{% endset %}
{% set spec = spec_text | from_yaml %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ configmap_name }}
  namespace: {{ k8s_namespace }}
data:
  {{ script_name }}: {{ data[script_name] | to_json }}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: media-volume-verify-{{ (spec | to_json(sort_keys=True, separators=(',', ':')) | hash('sha256'))[:8] }}
  namespace: {{ k8s_namespace }}
  annotations:
    homelab/job-kind: verify
spec:
{{ spec_text | indent(2, true) }}
