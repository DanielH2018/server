{#
  The verify Job's identity, rendered into `media-volume-verify` beside `job.yaml.j2`.

  It is a ServiceAccount with no Role. The Job reads no API and execs into no pod, so it needs
  no grant, and its pod mounts no token.
#}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: media-volume-verify
  namespace: {{ k8s_namespace }}
automountServiceAccountToken: false
