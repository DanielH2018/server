{% from 'ingressroute.yml.j2' import ingressroute with context %}
---
{{ ingressroute(
    container_item.name,
    container_item.hostname | default(container_item.name),
    container_item.port,
    container_item.use_authelia,
    bypass_prefixes=container_item.bridge_bypass_prefixes | default([])
  )
}}
---
# Ping bypass, carried over from the Docker role's hand-rolled `healthchecks-ping` router.
# (This object covers the service's hostname; the PUBLIC name's /ping/ bypass rides
# the macro's bypass_prefixes route above, B5 prep.)
# Monitored jobs POST to /ping/<uuid> with no credentials — an Authelia gate here would not
# fail loudly, it would silently turn every check red while the jobs themselves keep working.
#
# A second IngressRoute rather than an extra route inside the macro's object: the macro's
# routes carry a fixed middleware set, and this one needs a DIFFERENT set (rate-limit, no
# authelia) plus a priority. Traefik merges routers across IngressRoute objects, so the two
# coexist exactly as the two Docker routers do.
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: {{ container_item.name }}-ping
  namespace: {{ k8s_namespace }}
spec:
  entryPoints:
    - https
  routes:
{# One Rule per hostname, same split and same reason as the ingressroute() macro: the public
   name arrives through Cloudflare and keys on the forwarded client, the `.local.` name
   arrives direct and keys on the remote address (traefik's dynamic.yaml.j2, #1955). #}
{% set ping_host = container_item.hostname | default(container_item.name) %}
{% for host, rate_limit in ([(ping_host ~ '.' ~ domain, 'rate-limit-proxied')] if k8s_public_route else []) + [(ping_host ~ '.local.' ~ domain, 'rate-limit')] %}
    - kind: Rule
      # Trailing slash anchors to the /ping/ path SEGMENT (pings are /ping/<uuid>): a bare
      # PathPrefix(`/ping`) also matches sibling paths like /pingXYZ, extending this public
      # no-Authelia bypass to them.
      match: "Host(`{{ host }}`) && PathPrefix(`/ping/`)"
      # Priority must be higher than the UI router so Traefik matches this first.
      priority: 100
      middlewares:
        - name: {{ rate_limit }}
      services:
        - name: {{ container_item.name }}
          port: {{ container_item.port }}
{% endfor %}
  tls:
{% if k8s_tls_cert_resolver %}
    certResolver: {{ k8s_tls_cert_resolver }}
{% endif %}
    options:
      name: modern
{% if k8s_tls_cert_resolver %}
    domains:
      - main: "{{ domain }}"
        sans:
          - "*.{{ domain }}"
          - "*.local.{{ domain }}"
{% endif %}
