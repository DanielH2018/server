---
apiVersion: v1
kind: Secret
metadata:
  name: healthchecks
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  EMAIL_HOST_USER: "{{ healthchecks_smtp_user }}"
  # EMAIL_HOST_PASSWORD is gone with healthchecks_smtp_password, retired 2026-08-30 after the
  # credential turned up in transcript plaintext and outbound mail was already not working.
  # Django still reads EMAIL_HOST/PORT/USE_TLS from the Deployment and EMAIL_HOST_USER above,
  # so it will attempt SMTP and fail auth rather than skip sending — the same broken state as
  # before, not a new one. Removing the rest of the email stanza is the follow-up if outbound
  # mail is not coming back.
  # Only read when the superuser does not already exist. The seeded database already has one,
  # so this is here to keep the two copies configured identically rather than because the k8s
  # copy needs to create an account.
  SUPERUSER_PASSWORD: "{{ healthchecks_password }}"
  # Not a Django setting — healthchecks ignores this name. `files/seed_discord_channel.py`
  # reads it from the pod's environment and writes the Discord Channel row, so the webhook
  # URL never travels on a command line or through an exec's stdin. The key is rendered
  # unconditionally: the seed treats an ABSENT variable as "this exec hit a stale pod" and
  # fails, which it can only do if a live Secret always carries it.
  HOMELAB_DISCORD_WEBHOOK_URL: "{{ healthchecks_discord_webhook_url | default('') }}"
