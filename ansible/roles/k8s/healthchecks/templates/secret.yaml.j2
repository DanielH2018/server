---
apiVersion: v1
kind: Secret
metadata:
  name: healthchecks
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  # Outbound mail was dark from 2026-08-30, when `healthchecks_smtp_password` was retired
  # after the credential turned up in transcript plaintext. The Deployment kept sending
  # EMAIL_HOST/PORT/USE_TLS, so Django attempted SMTP and failed auth on every send. This
  # restores it against the app password the rest of the homelab already uses — Uptime
  # Kuma's second alert channel and monitor-bridge's `email_backstop` authenticate the same
  # value — so there is one Gmail app password to rotate rather than one per service.
  #
  # Gmail authenticates the account its app password was minted for, so EMAIL_HOST_USER has
  # to be the address the Deployment's DEFAULT_FROM_EMAIL sends as. Both are `email`; the
  # pairing is what `test_smtp_wiring.py` asserts. The `healthchecks_smtp_user` key this
  # slot used to read has no reader left and stays in SOPS pending triage (#1453) — an
  # unreferenced SOPS key here has turned out to be a UI login more often than dead weight.
  EMAIL_HOST_USER: "{{ email }}"
  EMAIL_HOST_PASSWORD: "{{ smtp_notify_app_password }}"
  # Only read when the superuser does not already exist. The seeded database already has one,
  # so this is here to keep the two copies configured identically rather than because the k8s
  # copy needs to create an account.
  SUPERUSER_PASSWORD: "{{ healthchecks_password }}"
  # Not a Django setting — healthchecks ignores this name. `files/seed_discord_channel.py`
  # reads it from the pod's environment and writes the Discord Channel row, so the webhook
  # URL never travels on a command line or through an exec's stdin. The key is rendered
  # unconditionally: the seed treats an ABSENT variable as "this exec hit a stale pod" and
  # fails, which it can only do if a live Secret always carries it.
  HOMELAB_DISCORD_WEBHOOK_URL: "{{ healthchecks_discord_webhook_url | default('') }}"
