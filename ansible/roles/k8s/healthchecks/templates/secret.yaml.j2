---
apiVersion: v1
kind: Secret
metadata:
  name: healthchecks
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  # Outbound mail was dark from 2026-08-30, when `healthchecks_smtp_password` was retired
  # after the credential turned up in transcript plaintext. The Deployment kept sending
  # EMAIL_HOST/PORT/USE_TLS, so Django attempted SMTP and failed auth on every send. This
  # restores it against the app password the rest of the homelab already uses — Uptime
  # Kuma's second alert channel and monitor-bridge's `email_backstop` authenticate the same
  # value — so there is one Gmail app password to rotate rather than one per service.
  #
  # Gmail authenticates the account its app password was minted for, so EMAIL_HOST_USER has
  # to be the address the Deployment's DEFAULT_FROM_EMAIL sends as. Both are `email`; the
  # pairing is what `test_smtp_wiring.py` asserts. The `healthchecks_smtp_user` key this slot
  # used to read was triaged out of SOPS on 2026-09-10 (#1453): its value compared EQUAL to
  # `email`, so it was a duplicate of the address above rather than a separate login.
  EMAIL_HOST_USER: "{{ email }}"
  EMAIL_HOST_PASSWORD: "{{ smtp_notify_app_password }}"
  # Django signs sessions and password-reset tokens with this. Until 2026-09-10 the only copy
  # was an assignment the image generated into `/config/local_settings.py` on first boot in
  # January 2023 (#1491) — outside SOPS, outside the rotation registry, and rotatable only by
  # editing a file inside a running pod. This is a FRESH key rather than that value lifted
  # into SOPS: minting a new one logs every session out once and breaks outstanding reset
  # links, which for a single-operator service costs less than reading a three-year-old
  # credential out of a pod and through a transcript to preserve it.
  #
  # `hc/settings.py` reads `SECRET_KEY = envsecret("SECRET_KEY", "---")`, and this Secret
  # reaches the pod through the Deployment's `envFrom`. The role sets no `SECRET_KEY_FILE`,
  # which `envsecret` would prefer over the env var.
  #
  # Rendering it here is also what keeps `files/strip_local_settings_owned.py` a one-shot. The
  # image's `init-healthchecks-config/run` appends a random `SECRET_KEY` to local_settings.py
  # only when `${SECRET_KEY}` is EMPTY, so with this key set the file stays stripped. Drop
  # this line while `SECRET_KEY` stays in that script's OWNED tuple and the image rewrites the
  # assignment on every boot, the strip deletes it again, and the pod rolls every deploy.
  SECRET_KEY: "{{ healthchecks_secret_key }}"
  # Only read when the superuser does not already exist. The seeded database already has one,
  # so this is here to keep the two copies configured identically rather than because the k8s
  # copy needs to create an account.
  SUPERUSER_PASSWORD: "{{ healthchecks_password }}"
  # Not a Django setting — healthchecks ignores this name. `files/seed_discord_channel.py`
  # reads it from the pod's environment and writes the Discord Channel row, so the webhook
  # URL never travels on a command line or through an exec's stdin. The key is rendered
  # unconditionally: the seed treats an ABSENT variable as "this exec hit a stale pod" and
  # fails, which it can only do if a live Secret always carries it.
  HOMELAB_DISCORD_WEBHOOK_URL: "{{ healthchecks_discord_webhook_url | default('') }}"
