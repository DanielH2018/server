---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: healthchecks
  namespace: {{ k8s_namespace }}
spec:
  replicas: 1
  # The PVC is ReadWriteOnce and Longhorn runs one replica, so a rolling update would deadlock:
  # the new pod waits for a volume the old pod still holds.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: healthchecks
  template:
    metadata:
      labels:
        app: healthchecks
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      automountServiceAccountToken: false
      priorityClassName: homelab-best-effort
      # Preference, never a pin: daniel-box carries the storage- and VIP-pinned workloads and runs the hotter of the two nodes, so latency-insensitive services default here.
      # Weighted so the pod still schedules if daniel-server is cordoned or full.
      affinity:
        nodeAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              preference:
                matchExpressions:
                  - key: kubernetes.io/hostname
                    operator: In
                    values:
                      - daniel-server
      containers:
        - name: healthchecks
          image: {{ healthchecks_k8s_image }}
          ports:
            - containerPort: {{ container_item.port }}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
              add:
                - CHOWN
                - SETUID
                - SETGID
                - FOWNER
                - DAC_OVERRIDE
                - NET_BIND_SERVICE
          env:
            - name: PUID
              value: "{{ puid }}"
            - name: PGID
              value: "{{ pgid }}"
            - name: TZ
              value: "{{ tz }}"
            - name: SITE_NAME
              value: Home Server healthchecks
            # Django builds the ping URLs it displays from SITE_ROOT, so this has to be the
            # address the crons actually call. Bridged, that is the public hostname — the same
            # value the Docker copy used, and the one two initial_setup crons hardcode. Before
            # cutover it follows the inventory hostname so the -k8s copy shows URLs that work.
            - name: SITE_ROOT
              value: "https://{{ container_item.hostname | default(container_item.name) }}.{{ domain }}"
            # Django rejects any request whose Host header is not listed here with a bare 400,
            # which reads as a Traefik or ingress fault rather than an application setting.
            # The -k8s host is what the k8s copy is reached on today; the public and LAN names
            # are kept so the list does not have to change again at cutover.
            - name: ALLOWED_HOSTS
              value: "localhost,{{ container_item.hostname | default(container_item.name) }}.local.{{ domain }},{{ container_item.name }}.{{ domain }},{{ container_item.name }}.local.{{ domain }}"
            - name: DEFAULT_FROM_EMAIL
              value: "{{ email }}"
            - name: EMAIL_HOST
              value: smtp.gmail.com
            - name: EMAIL_PORT
              value: "587"
            - name: EMAIL_USE_TLS
              value: "True"
            - name: SUPERUSER_EMAIL
              value: "{{ email }}"
            - name: REGISTRATION_OPEN
              value: "False"
          envFrom:
            - secretRef:
                name: healthchecks
          volumeMounts:
            - name: config
              mountPath: /config
            # LSIO app logs — kopia's logs/ rule.
            - name: log
              mountPath: /config/log
          readinessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
              httpHeaders:
                # The probe's default Host header is the pod IP, which ALLOWED_HOSTS rejects
                # with a 400 — the probe would fail against a perfectly healthy app.
                - name: Host
                  value: localhost
            initialDelaySeconds: 20
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: {{ container_item.port }}
              httpHeaders:
                - name: Host
                  value: localhost
            initialDelaySeconds: 90
            periodSeconds: 30
          resources:
            limits:
              cpu: "{{ healthchecks_k8s_cpu_limit }}"
              memory: {{ healthchecks_k8s_mem_limit }}
            requests:
              cpu: "{{ healthchecks_k8s_cpu_request }}"
              memory: {{ healthchecks_k8s_mem_request }}
      volumes:
        - name: config
          persistentVolumeClaim:
            claimName: {{ healthchecks_k8s_claim }}
        - name: log
          emptyDir: {}
