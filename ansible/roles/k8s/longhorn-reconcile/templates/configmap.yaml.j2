{#
  The reconcile job's inputs: the desired tier of every claim, the script, and the one module
  that opens its connections.

  tiers.json is the three tier lists, `k3s_longhorn_r2_volumes`, `k3s_longhorn_weekly_volumes`
  and `k3s_longhorn_nobackup_volumes`, which this role's defaults derive from
  `containers_list`. The script reads `r2` for the Volume's `spec.backupTargetName`, and
  `weekly` and `nobackup` for the recurring-job group labels.

  A change to `containers_list` that moves a claim between tiers changes this file, and so this
  tag's digest. The tag is not forward-only, so a failed revision resets rather than holds.

  No secret goes in here. Keep comments at column 0 and above the document.
#}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: longhorn-reconcile
  namespace: {{ k8s_longhorn_namespace }}
data:
  tiers.json: {{ {'r2': k3s_longhorn_r2_volumes, 'weekly': k3s_longhorn_weekly_volumes, 'nobackup': k3s_longhorn_nobackup_volumes} | to_json(sort_keys=True) | to_json }}
  longhorn_reconcile.py: |
{{ lookup('file', playbook_dir + '/roles/k8s/longhorn-reconcile/files/longhorn_reconcile.py') | indent(4, true) }}
  flux_job_connect.py: |
{{ lookup('file', playbook_dir + '/roles/k8s/manifests/files/flux_job_connect.py') | indent(4, true) }}
