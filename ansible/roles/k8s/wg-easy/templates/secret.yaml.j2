---
apiVersion: v1
kind: Secret
metadata:
  name: wg-easy-env
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  # bcrypt hash of the admin password (v14 auth model). No `$$` doubling here — that was
  # Compose interpolation; a k8s Secret carries the value verbatim.
  PASSWORD_HASH: "{{ wg_easy_password_hash }}"
