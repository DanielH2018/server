---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: wg-easy
  namespace: {{ k8s_namespace }}
spec:
  replicas: 1
  # ReadWriteOnce PVC on single-replica Longhorn — a rolling update would deadlock on the volume.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: wg-easy
  template:
    metadata:
      labels:
        app: wg-easy
        netpol-baseline: enforced
    spec:
      # Pinned to the VIP-announcing node while the MetalLB L2Advertisement is pinned to
      # daniel-box: with externalTrafficPolicy Local, a VIP-backed pod on the other node
      # makes the announcer DROP all forwarded LAN traffic (2026-08-14 post-boot DNS
      # blackout). This pin only ever moves together with the L2Advertisement nodeSelector.
      #
      # Added 2026-08-14 alongside valheim's, for the same reason and with more at stake:
      # wg-easy-udp has carried ETP Local and VIP 10.0.0.244 since it went live with no
      # placement guarantee, so it sat here only by scheduler accident. A reschedule onto
      # daniel-server would black-hole UDP 51820 while the pod reported healthy — and
      # because this IS the remote-access path, it would also remove the way back in to
      # diagnose it.
      nodeSelector:
        kubernetes.io/hostname: daniel-box
      enableServiceLinks: false
      securityContext:
        # Both namespaced; kubelet only admits them because setup/k3s allow-lists them.
        # ip_forward: the SERVER routes between wg0 and eth0 inside the pod netns, and
        # /proc/sys is ro in a pod even with NET_ADMIN, so the spec is the only way in.
        # src_valid_mark: same wg-quick requirement the qbittorrent sidecar documented
        # (slice 4, D11) — pre-setting it makes wg-quick skip its own doomed write.
        sysctls:
          - name: net.ipv4.ip_forward
            value: "1"
          - name: net.ipv4.conf.all.src_valid_mark
            value: "1"
      # The image runs as root (wg-quick + iptables leave no choice), but the seeded files
      # arrive uid-1000 from the unprivileged ssh|tar pipeline — and root with ALL caps
      # dropped has no DAC_OVERRIDE, so it cannot even READ them (fourth live occurrence of
      # that lesson; the near-miss here was wg-easy silently GENERATING a fresh keypair when
      # the seeded one was unreadable — the save failing on the same wall is what stopped
      # every client config from being invalidated). CAP_CHOWN alone lets the init hand the
      # tree to uid 0; no DAC_OVERRIDE anywhere.
      initContainers:
        - name: config-chown
          image: {{ wg_easy_k8s_image }}
          command:
            - chown
            - -R
            - "0:0"
            - /etc/wireguard
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
              add:
                - CHOWN
          volumeMounts:
            - name: wg-easy-config
              mountPath: /etc/wireguard
          resources:
            limits:
              cpu: 250m
              memory: 128Mi
            requests:
              cpu: 10m
              memory: 16Mi
      automountServiceAccountToken: false
      # Tier 1, not tier 4 as a VPN utility first looks: this is the remote-access path.
      # Evicting it under memory pressure removes the way back in to deal with whatever
      # caused the pressure, so it ranks with the edge rather than with the dashboards.
      priorityClassName: homelab-critical
      containers:
        - name: wg-easy
          image: {{ wg_easy_k8s_image }}
          ports:
            - containerPort: {{ container_item.udp_port }}
              protocol: UDP
            - containerPort: {{ container_item.port }}
              protocol: TCP
          # v15 reads almost no environment. LANG, WG_HOST, WG_PORT,
          # WG_PERSISTENT_KEEPALIVE, WG_DEFAULT_DNS and PASSWORD_HASH were all v14 keys and
          # were removed at the v15 upgrade — the endpoint hostname, the UDP port, the
          # keepalive and the client DNS now live in the app's own SQLite DB, set through the
          # Admin Panel. `container_item.default_dns` in host_vars is what seeded that value
          # and stays as the record of what it should be; nothing renders it any more.
          env:
            # Traefik terminates TLS at the edge and proxies PLAIN HTTP to this port, so
            # without INSECURE v15 refuses the request — including the first-boot setup
            # wizard, which is the only v14 -> v15 import path. Not a downgrade of the
            # external route: that is https, Authelia-fronted, and unchanged.
            - name: INSECURE
              value: "true"
            # kubelet's allowed-unsafe-sysctls is exactly
            # net.ipv4.conf.all.src_valid_mark,net.ipv4.ip_forward (roles/setup/k3s
            # defaults), and the net.ipv6.* sysctls upstream's compose sets are excluded
            # there ON PURPOSE. Rather than widen that allow-list — a k3s server-arg change
            # and a restart of BOTH nodes, on the sole remote-access path — turn v15's IPv6
            # support off. NOTE the UI still displays IPv6 addresses it will not route, and
            # the CLI overrides this with its own --no-ipv6 flag, so check a freshly
            # generated peer config before handing it to a device.
            - name: DISABLE_IPV6
              value: "true"
          # NET_ADMIN for the wg interface and its routing/fwmark rules. NET_RAW is carried
          # over from v14, where wg-quick ran iptables and its CLI opened a raw socket to
          # init the nat table; v15 marks NET_RAW as Podman-only, so it is a candidate to
          # drop once v15 is proven running — verified removal, not a same-commit guess.
          # No SYS_MODULE — the wireguard module is loaded on the host, and /lib/modules is
          # mounted read-only below.
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
              add:
                - NET_ADMIN
                - NET_RAW
          volumeMounts:
            - name: wg-easy-config
              mountPath: /etc/wireguard
            # Added at the v15 upgrade to match upstream's own compose file. v15 checks for
            # the wireguard module here; the module is loaded on the host, so this read-only
            # view is enough and SYS_MODULE stays dropped. If a v15 startup ever fails on
            # modprobe, that capability is the next thing to add — not before.
            - name: host-lib-modules
              mountPath: /lib/modules
              readOnly: true
          # TCP on the admin UI: proves the node app is up. The wg interface itself has no
          # cheap in-pod probe; the real gate is a client handshake after deploy.
          readinessProbe:
            tcpSocket:
              port: {{ container_item.port }}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            tcpSocket:
              port: {{ container_item.port }}
            initialDelaySeconds: 15
            periodSeconds: 30
          resources:
            limits:
              cpu: "{{ wg_easy_k8s_cpu_limit }}"
              memory: {{ wg_easy_k8s_mem_limit }}
            requests:
              cpu: "{{ wg_easy_k8s_cpu_request }}"
              memory: {{ wg_easy_k8s_mem_request }}
      volumes:
        - name: wg-easy-config
          persistentVolumeClaim:
            claimName: {{ wg_easy_k8s_claim }}
        - name: host-lib-modules
          hostPath:
            path: /lib/modules
            type: Directory
