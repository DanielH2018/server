{% from 'pod-affinity.yml.j2' import node_affinity_preference with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ical-proxy
  namespace: {{ k8s_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: ical-proxy
  template:
    metadata:
      labels:
        app: ical-proxy
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      automountServiceAccountToken: false
      priorityClassName: homelab-best-effort
      # Preference, never a pin: daniel-box carries the storage- and VIP-pinned workloads and runs the hotter of the two nodes, so latency-insensitive services default here.
      # Weighted so the pod still schedules if daniel-server is cordoned or full.
{{ node_affinity_preference('daniel-server') }}
      containers:
        - name: ical-proxy
          image: {{ ical_proxy_k8s_image }}
          ports:
            - containerPort: 5000
          env:
            - name: REFRESH_INTERVAL
              value: "900"
            - name: PYTHONDONTWRITEBYTECODE
              value: "1"
          envFrom:
            - secretRef:
                name: ical-proxy-env
          # The image drops to uid-1000 appuser itself; rootfs read-only as under Docker
          # (app.py caches calendars in memory, never on disk — /tmp scratch only).
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - name: ical-proxy-tmp
              mountPath: /tmp
          readinessProbe:
            tcpSocket:
              port: 5000
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            tcpSocket:
              port: 5000
            initialDelaySeconds: 15
            periodSeconds: 30
          resources:
            limits:
              cpu: "{{ ical_proxy_k8s_cpu_limit }}"
              memory: {{ ical_proxy_k8s_mem_limit }}
            requests:
              cpu: "{{ ical_proxy_k8s_cpu_request }}"
              memory: {{ ical_proxy_k8s_mem_request }}
      volumes:
        - name: ical-proxy-tmp
          emptyDir: {}
