---
apiVersion: v1
kind: Secret
metadata:
  name: ical-proxy-env
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  # Private calendar URLs — secret because possession IS access to the feeds.
  GOOGLE_ICS_URL: "{{ calendar_1 }}"
  GOOGLE_ICS_URL_2: "{{ calendar_2 }}"
  OBSIDIAN_GIST_URL: "{{ calendar_4 }}"
