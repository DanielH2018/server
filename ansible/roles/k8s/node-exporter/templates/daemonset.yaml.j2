---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: node-exporter
  namespace: {{ k8s_namespace }}
spec:
  selector:
    matchLabels:
      app: node-exporter
  template:
    metadata:
      labels:
        app: node-exporter
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      automountServiceAccountToken: false
      # Host networking + PID so node_* describes the NODE (network interfaces, /proc)
      # rather than a pod netns — the standard node-exporter posture. The 9100 listener
      # this opens on each node is host-firewalled by ufw's default-deny INPUT except
      # for the server node's LAN IP (k3s_join_agent_ports): under hostNetwork the
      # "pod IP" prometheus scrapes IS the node's LAN IP, and cross-node that traffic
      # arrives masqueraded from the scraping node — NOT over the vxlan the join allows
      # already covered. (This comment originally claimed the join allows admitted it;
      # wrong — the daniel-server target was down from day one until the 9100 allow
      # landed 2026-08-14.)
      hostNetwork: true
      hostPID: true
      priorityClassName: homelab-best-effort
      containers:
        - name: node-exporter
          image: {{ node_exporter_k8s_image }}
          args:
            - --path.procfs=/host/proc
            - --path.rootfs=/rootfs
            - --path.sysfs=/host/sys
            - --collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc|var/lib/kubelet)($|/)
            - --collector.textfile.directory=/textfile
          ports:
            - containerPort: 9100
          securityContext:
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          # /metrics measured at 0.30s (daniel-box) / 0.34s (daniel-server); timeoutSeconds: 3
          # keeps headroom over the 1s default, since scrape cost grows with mount/disk count.
          livenessProbe:
            httpGet:
              path: /metrics
              port: 9100
            initialDelaySeconds: 15
            periodSeconds: 30
            timeoutSeconds: 3
          # `rollout status daemonset/node-exporter` gates on numberAvailable (== numberReady,
          # since minReadySeconds is unset), which without a readiness probe means "Running" —
          # it would return green on a container that never served a scrape. Shorter delay than
          # the liveness probe: this one decides when the rollout is allowed to proceed, not
          # when to kill the container.
          readinessProbe:
            httpGet:
              path: /metrics
              port: 9100
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
          volumeMounts:
            - name: node-exporter-proc
              mountPath: /host/proc
              readOnly: true
            - name: node-exporter-sys
              mountPath: /host/sys
              readOnly: true
            - name: node-exporter-rootfs
              mountPath: /rootfs
              readOnly: true
            - name: node-exporter-textfile
              mountPath: /textfile
              readOnly: true
          resources:
            requests:
              cpu: 20m
              memory: 32Mi
            limits:
              # 1 core, not 200m. This exporter renders ~320 metric families per request and was
              # throttled on 42.4% of CFS periods (daniel-box) / 31.7% (daniel-server), measured
              # 2026-08-29. On its own that ratio is close to an artifact — absolute throttled
              # time is ~1.6% of wall-clock — but here it has a second, real consequence: the
              # kubelet's own liveness and readiness probes GET /metrics and close after reading a
              # bounded prefix, and a slower render leaves more of the response unwritten when
              # they do. node_exporter then logs one "connection reset by peer" line per unwritten
              # family. Hit rate tracks throttle: 94% of probe ticks produce a burst on daniel-box
              # against 41% on daniel-server. That flood was 97% of all k8s-namespace Loki ingest.
              # Raising the ceiling shrinks it; the probe path is the actual cause and is
              # unchanged here.
              cpu: "1"
              memory: 128Mi
      volumes:
        - name: node-exporter-proc
          hostPath:
            path: /proc
        - name: node-exporter-sys
          hostPath:
            path: /sys
        - name: node-exporter-rootfs
          hostPath:
            path: /
        # Host cron scripts may drop *.prom gauges here (the kopia-era B2-usage pattern);
        # empty today, kept as the hook so a future host gauge needs no exporter change.
        - name: node-exporter-textfile
          hostPath:
            path: /var/lib/node-exporter-textfile
            type: DirectoryOrCreate
