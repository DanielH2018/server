---
apiVersion: v1
kind: Secret
metadata:
  name: home-assistant-secrets
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
{# The ONE HA config file that is genuinely Ansible-templated (SOPS values), which is why it
   ships as a Secret via lookup('template') while everything else rides the ConfigMap verbatim. #}
  secrets.yaml: |
{{ lookup('template', playbook_dir + '/roles/k8s/home-assistant/templates/config/secrets.yaml.j2') | indent(4, true) }}
