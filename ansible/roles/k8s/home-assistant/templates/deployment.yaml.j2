---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: home-assistant
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  # Recreate is load-bearing (slice-5 D5): the PVC is RWO, and two HAs against one MQTT
  # broker and one recorder lineage must never coexist.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: home-assistant
  template:
    metadata:
      labels:
        app: home-assistant
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      # No pod-level runAsUser/fsGroup: the LSIO image starts as root and s6 drops to
      # PUID/PGID itself, chowning /config on the way — same contract as under Docker.
      initContainers:
        # Lay the git-owned config plane into the PVC on every start (see the ConfigMap's
        # comment). Only these named files are written; .storage/, the recorder DB, secrets
        # consumers, custom_components/ are PVC state this never touches.
        #
        # custom_templates/ is CLEARED before the install because `install` only overwrites what
        # it is given: a .jinja dropped from the ConfigMap would otherwise survive on the PVC and
        # keep being loaded, green deploy and all, with the repo showing it gone. The whole
        # directory is git-owned, so deleting it wholesale is safe. The named files above are
        # each overwritten every start, so they can't go stale the same way — but REMOVING one
        # from the ConfigMap still leaves the PVC copy behind, and that needs a manual delete.
        - name: config-install
          image: {{ home_assistant_k8s_init_image }}
          command:
            - sh
            - -c
            - install -m 644 /cm/configuration.yaml /cm/customize.yaml /cm/ui-lovelace.yaml
              /cm/automations.yaml /cm/scenes.yaml /cm/scripts.yaml /cm/templates.yaml
              /cm/rest.yaml /config/ &&
              install -m 600 /sec/secrets.yaml /config/secrets.yaml &&
              mkdir -p /config/custom_templates &&
              find /config/custom_templates -maxdepth 1 -name '*.jinja' -delete &&
              install -m 644 /ct/diagnostics.jinja /ct/fan.jinja /ct/lighting.jinja
              /ct/ventilation.jinja /config/custom_templates/
          securityContext:
            # As PUID, not root: the seeded /config is uid-1000-owned and this container drops
            # ALL caps (no DAC_OVERRIDE), so only the owner can overwrite the previous copies.
            # Root-with-no-caps failed exactly there on first boot ("can't create: File
            # exists"). The MAIN container can't take a pod-level runAsUser — LSIO s6 must
            # start as root — which is why this lives here per-container.
            runAsUser: {{ puid }}
            runAsGroup: {{ pgid }}
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - name: home-assistant-config-files
              mountPath: /cm
              readOnly: true
            - name: home-assistant-custom-templates
              mountPath: /ct
              readOnly: true
            - name: home-assistant-config-secrets
              mountPath: /sec
              readOnly: true
            - name: home-assistant-config
              mountPath: /config
          resources:
            limits:
              cpu: 250m
              memory: 128Mi
            requests:
              cpu: 10m
              memory: 16Mi
      automountServiceAccountToken: false
      priorityClassName: homelab-automation
      containers:
        - name: home-assistant
          image: {{ home_assistant_k8s_image }}
          ports:
            - containerPort: {{ container_item.port }}
          # The compose template's cap posture: drop ALL, add the s6 privilege-drop set. No
          # NET_BIND_SERVICE — HA binds 8123. allowPrivilegeEscalation false mirrors
          # no-new-privileges:true (s6 goes root -> PUID, never up).
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
              add:
                - CHOWN
                - SETUID
                - SETGID
                - FOWNER
                - DAC_OVERRIDE
          env:
            - name: PUID
              value: "{{ puid }}"
            - name: PGID
              value: "{{ pgid }}"
            - name: TZ
              value: "{{ tz }}"
            - name: DOCKER_MODS
              value: linuxserver/mods:homeassistant-hacs
          volumeMounts:
            - name: home-assistant-config
              mountPath: /config
            # HA's .cache is re-derived; kopia excluded it (.cache/), and on block-level backups its churn is what costs.
            - name: home-assistant-cache
              mountPath: /config/.cache
          # HA is a slow first-booter (the LSIO permissions pass, then core start before :8123
          # binds) — the compose healthcheck carries start_period 120s for the same reason.
          # DECIDED: exec-curl to 127.0.0.1, not httpGet — HA's ip_ban middleware runs on EVERY
          # request, and it keys on the peer address. A kubelet httpGet arrives from the node's
          # pod-network gateway (10.42.0.1), so once anything gets that IP banned HA answers 403
          # and kubelet kills the container it just banned — a self-inflicted crash loop (2026-08-23:
          # 3 restarts, paging k3s Workload Health). From inside the container the peer is
          # 127.0.0.1, which no ban can reach. Readiness moves too: fixing liveness alone just
          # relocates the outage to a yanked Service endpoint.
          # curl over tcpSocket: tcpSocket also escapes the ban but stops proving HTTP works, so a
          # wedged HA still holding the listener would pass. curl is proven present in this image —
          # it was the Compose healthcheck (`curl --fail -s http://localhost:8123/`) pre-migration.
          # timeoutSeconds: exec probes default to 1s; curl -m 4 keeps curl's deadline inside it.
          readinessProbe:
            exec:
              command: ["sh", "-c", "curl -fsm 4 http://127.0.0.1:{{ container_item.port }}/ >/dev/null"]
            initialDelaySeconds: 30
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 12
          livenessProbe:
            exec:
              command: ["sh", "-c", "curl -fsm 4 http://127.0.0.1:{{ container_item.port }}/ >/dev/null"]
            initialDelaySeconds: 180
            periodSeconds: 30
            timeoutSeconds: 5
          resources:
            limits:
              cpu: "{{ home_assistant_k8s_cpu_limit }}"
              memory: {{ home_assistant_k8s_mem_limit }}
            requests:
              cpu: "{{ home_assistant_k8s_cpu_request }}"
              memory: {{ home_assistant_k8s_mem_request }}
      volumes:
        - name: home-assistant-config-files
          configMap:
            name: home-assistant-config
        - name: home-assistant-custom-templates
          configMap:
            name: home-assistant-custom-templates
        - name: home-assistant-config-secrets
          secret:
            secretName: home-assistant-secrets
        - name: home-assistant-config
          persistentVolumeClaim:
            claimName: {{ home_assistant_k8s_claim }}
        - name: home-assistant-cache
          emptyDir: {}
