{#
  The configarr-health CronJob's code: the reader, its two configarr_lib modules, and the
  host_lib.py it imports.

  Flat keys, because a ConfigMap key cannot hold a `/`. The CronJob's volume maps each
  configarr_lib key back under configarr_lib/ with `items:`, so `from configarr_lib import ...`
  resolves beside the reader as it did on the host.

  No secret goes in here, and the pod takes none from a Secret.
  ansible/tests/k8s/test_no_secret_in_a_moved_jobs_configmap.py renders this file with every
  secrets.yml key bound to a sentinel and fails on any sentinel it finds.
#}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: configarr-health
  namespace: {{ k8s_namespace }}
data:
  configarr_health.py: |
{{ lookup('file', role_file('files/configarr_health.py')) | indent(4, true) }}
  configarr_health_logic.py: |
{{ lookup('file', role_file('files/configarr_lib/configarr_health_logic.py')) | indent(4, true) }}
  configarr_status.py: |
{{ lookup('file', role_file('files/configarr_lib/configarr_status.py')) | indent(4, true) }}
  host_lib.py: |
{{ lookup('file', repo_file('hosts/lib/host_lib.py')) | indent(4, true) }}
