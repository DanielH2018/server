{#
  The Configarr Sync push token, for the configarr-health CronJob's KUMA_PUSH_TOKEN.

  Its own Secret, not a key of configarr-config: that Secret is mounted whole at /app/config in
  the configarr pod, so a key added there would land as a file in the syncer's config directory.
#}
---
apiVersion: v1
kind: Secret
metadata:
  name: configarr-health
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  kuma_push_token: "{{ monitor_bridge_configarr_push_token }}"
