{#
  The Configarr Sync push URL, token included, for the configarr-health CronJob's KUMA_PUSH_URL.

  Its own Secret, not a key of configarr-config: that Secret is mounted whole at /app/config in
  the configarr pod, so a key added there would land as a file in the syncer's config directory.

  The whole URL rather than the bare token, as pi-peer-backup's push_url is. A value that is
  the token alone is a standalone placeholder under Flux, which would add a row for configarr
  to k8s/manifests' standalone_secret_keys.json, and any change to that k8s/manifests file
  makes the tick's narrowed apply refuse as most of the fleet.
#}
---
apiVersion: v1
kind: Secret
metadata:
  name: configarr-health
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  push_url: "http://uptime-kuma.{{ k8s_namespace }}.svc.cluster.local:{{ containers_list | entry_port('uptime-kuma') }}/api/push/{{ monitor_bridge_configarr_push_token }}"
