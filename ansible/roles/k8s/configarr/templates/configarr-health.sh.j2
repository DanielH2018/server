#!/usr/bin/env bash
# configarr guide-sync heartbeat — managed by Ansible (k8s/configarr role); edits overwritten.
#
# Thin on purpose. Everything that decides up-or-down is in configarr_health.py + its pure core,
# which are plain files with unit tests; this exists only because the Kuma
# push token has to be templated in, and a secret-carrying file should hold as little logic as
# possible. Same shape as longhorn-backup-health.sh and telemetry-health.sh.
#
# Push, not poll: this is a host cron that reports its own verdict. It was written when
# monitor-bridge ran on daniel-server against that host's Docker socket and genuinely could not
# see the cluster; monitor-bridge moved in-cluster at the 2026-08-14 Docker uninstall, so the
# split is now cron ownership rather than visibility.
# It used to poll a /var/lib/configarr/state.json bind mount, which stopped being possible the
# moment the sync moved hosts.
#
# Reads the cluster through the read-only ServiceAccount kubeconfig, so the cron needs no sudo and
# cannot mutate anything.
set -uo pipefail

export KUBECONFIG=/home/{{ sys_user }}/.kube/config
export CONFIGARR_NAMESPACE={{ k8s_namespace }}
export CONFIGARR_MAX_AGE_H={{ configarr_k8s_max_age_hours }}

KUMA_HOST="uptime-kuma.local.{{ domain }}"
# Pinned to the cluster ingress VIP: Kuma serves from the k8s edge, and the Docker
# edge's bridge route for this name was removed in the slice-7 bridge teardown.
KUMA_RESOLVE_IP="{{ k3s_metallb_ingress_vip }}"
PUSH_URL="https://${KUMA_HOST}/api/push/{{ monitor_bridge_configarr_push_token }}"

# The reader prints `up<TAB>msg` or `down<TAB>msg` and always exits 0. A nonzero exit or empty
# output therefore means the reader ITSELF broke — report that rather than pushing nothing, which
# would leave the monitor to time out with no explanation.
if ! OUT=$(/usr/local/bin/uv run --no-project --python {{ host_python_version }} /opt/configarr-health/configarr_health.py 2>&1) || [[ -z "$OUT" ]]; then
  STATUS=down
  MSG="configarr health reader failed: ${OUT:-(no output)}"
else
  STATUS="${OUT%%$'\t'*}"
  MSG="${OUT#*$'\t'}"
fi

curl -fsS --max-time 10 -G \
  --resolve "${KUMA_HOST}:443:${KUMA_RESOLVE_IP}" \
  --data-urlencode "status=${STATUS}" \
  --data-urlencode "msg=${MSG}" \
  "$PUSH_URL" >/dev/null \
  || logger -t configarr-health "push failed (status=${STATUS}: ${MSG})"
