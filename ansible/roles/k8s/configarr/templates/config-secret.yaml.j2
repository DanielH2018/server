---
apiVersion: v1
kind: Secret
metadata:
  name: configarr-config
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  config.yml: |
{#
  Rendered from templates/config/config.yml.j2, not copied — the file is ~150 lines of custom-format
  definitions and release-group scoring, and a second copy would drift silently into two different
  grab policies.

  `base_url: http://sonarr:8989` and `http://radarr:7878` are the Service names in this
  namespace, so the same string resolves in-cluster.

  A Secret rather than a ConfigMap because it embeds both *arr API keys.
#}
{{ lookup('template', playbook_dir + '/roles/k8s/configarr/templates/config/config.yml.j2') | indent(4, true) }}
