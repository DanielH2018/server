---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: jellyfin
  namespace: {{ k8s_namespace }}
spec:
  replicas: 1
  # The config PVC is ReadWriteOnce on single-replica Longhorn, so a rolling update deadlocks:
  # the new pod waits for a volume the old pod has not released.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: jellyfin
  template:
    metadata:
      labels:
        app: jellyfin
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      # THE OTHER HALF OF THE GPU WIRING (D2). The device plugin gets the container past the
      # cgroup v2 device filter; this gets it past the file mode — /dev/dri/renderD128 is
      # crw-rw---- root:render, and the container runs as uid {{ puid }}. Host-specific by
      # nature, which is why it lives in host_vars rather than here: nothing guarantees 993
      # elsewhere, and daniel-server joining the cluster is exactly when a hardcoded one breaks.
      securityContext:
        supplementalGroups:
          - {{ render_gid }}
      # ── the one-time Intel → AMD conversion (D12) ─────────────────────────────────────────
      # D8 assumed these settings were opaque database state needing a manual UI pass. They are
      # not: they are elements in /config/encoding.xml, so the conversion is deterministic.
      #
      # It runs HERE, as an initContainer, for two reasons. Jellyfin reads this file at startup
      # and rewrites the whole file on any admin save, so an edit made against a running pod is
      # clobbered — this is the last moment nothing is attached. And it shares the pod, so it
      # never contends for the ReadWriteOnce volume the way a separate Job would once the
      # Deployment is up.
      #
      # Guarded on the value being `qsv` so it converges exactly once and then leaves the file
      # alone. That is what keeps it from fighting the UI: templating the whole file would
      # revert every setting the user changes on the next deploy.
      initContainers:
        - name: convert-encoding-settings
          image: {{ jellyfin_k8s_image }}
          command:
            - /bin/sh
            - -c
            - |
              # set -e is not decoration here. Without it the first version of this script
              # printed "converted" after a sed that had failed with EACCES, so the deploy
              # reported a conversion that had not happened — the exact false-green this file
              # exists to avoid. The explicit re-read at the end is the second half of that fix.
              set -eu
              f=/config/encoding.xml
              if [ ! -f "$f" ]; then
                echo "no encoding.xml yet — Jellyfin will write defaults, nothing to convert"
                exit 0
              fi
              if ! grep -q '<HardwareAccelerationType>qsv</HardwareAccelerationType>' "$f"; then
                echo "already converted (or never Intel) — leaving encoding.xml alone"
                exit 0
              fi
              # VppTonemapping is the Intel QSV VPP filter specifically and has no AMD
              # equivalent; leaving it on asks ffmpeg for a filter this hardware cannot build.
              sed -i \
                -e 's|<HardwareAccelerationType>qsv</HardwareAccelerationType>|<HardwareAccelerationType>vaapi</HardwareAccelerationType>|' \
                -e 's|<EnableVppTonemapping>true</EnableVppTonemapping>|<EnableVppTonemapping>false</EnableVppTonemapping>|' \
                "$f"
              grep -q '<HardwareAccelerationType>vaapi</HardwareAccelerationType>' "$f"
              echo "converted encoding.xml: qsv -> vaapi, VppTonemapping off"
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
            # As the OWNER of /config, not as root. The LSIO image's default user is root, and
            # `sed -i` writes a temp file in the target directory — with every capability
            # dropped, a root process has no DAC_OVERRIDE and cannot write into a directory
            # owned by uid {{ puid }}. It failed with
            #     sed: couldn't open temporary file /config/sedUo9qXt: Permission denied
            # which reads like a read-only mount and is not one. Running as the owner needs no
            # capability at all.
            runAsUser: {{ puid }}
            runAsGroup: {{ pgid }}
          volumeMounts:
            - name: config
              mountPath: /config
          resources:
            limits:
              cpu: "500m"
              memory: 128Mi
            requests:
              cpu: "10m"
              memory: 32Mi
      automountServiceAccountToken: false
      priorityClassName: homelab-standard
      containers:
        - name: jellyfin
          image: {{ jellyfin_k8s_image }}
          ports:
            - containerPort: {{ container_item.port }}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              # The compose template's cap_drop/cap_add pair MINUS FOWNER and DAC_OVERRIDE.
              # Those two existed only so the opencl-intel DOCKER_MODS installer's root dpkg
              # unpack could chmod files it did not own. That mod is gone (D8), so the caps go
              # with it rather than being carried over out of habit.
              drop:
                - ALL
              add:
                - CHOWN
                - SETUID
                - SETGID
          env:
            - name: PUID
              value: "{{ puid }}"
            - name: PGID
              value: "{{ pgid }}"
            - name: TZ
              value: "{{ tz }}"
            - name: JELLYFIN_PublishedServerUrl
              value: "{{ jellyfin_k8s_published_url }}"
          volumeMounts:
            - name: config
              mountPath: /config
            # BOTH media mounts are read-only, carried over from the Compose template (2026-07-03):
            # jellyfin only READS the library. SaveLocalMetadata is off in every library, artwork
            # and trickplay live in /config, and every writer has its own mount. This caps the
            # blast radius of the one internet-facing, Authelia-less media parser.
            #
            # subPath `media`, NOT the volume root — and this is where B5 first got it wrong.
            # The *arrs mount the WHOLE tree at /data because their databases store
            # /data/media/tv/... and they hardlink from /data/torrents. jellyfin's Compose mount
            # was `containers/data/media:/data`, one level DEEPER, so its library paths are
            # /data/tv and /data/movies with no `media` component. Mounting the root here put
            # /data/media and /data/torrents in front of it, the libraries pointed at paths that
            # no longer existed, and every playback failed with an IO error on
            # /data/tv/... while the pod stayed Ready and the UI listed the whole library from
            # its database. D4 is about the *arrs; this is the same trap with a different depth.
            - name: media
              mountPath: /data
              subPath: media
              readOnly: true
            # THE SAME TREE AGAIN, DELIBERATELY (D4 / compose review M4). janitorr mounts the
            # data root at /data and hands Jellyfin a leaving-soon dir of /data/media/leaving-soon,
            # whose symlink TARGETS are /data/media/tv/... — those resolve only if /data/media/*
            # exists in THIS namespace too. Reproduce it; do not tidy it. Moving the libraries
            # instead would mean editing paths in Jellyfin's own database.
            # Same subPath again, at the deeper path — reproducing Compose's second
            # `containers/data/media:/data/media` mount exactly, which lands the media directory
            # on top of the real `media` subdirectory that already exists inside it.
            - name: media
              mountPath: /data/media
              subPath: media
              readOnly: true
            # THE WHOLE CACHE, off Longhorn — not just the transcode scratch (2026-08-16).
            #
            # This mount used to be /config/cache/transcodes only (D6): TranscodingTempPath is
            # unset in encoding.xml, so Jellyfin uses its default of <cache>/transcodes, and
            # mounting there kept the write-heavy scratch on node storage without editing the XML.
            # That reasoning still holds — transcodes is inside this emptyDir, so the default path
            # is still served off the node.
            #
            # What changed is that "the rest of /config/cache stays on the PVC" was a mistake.
            # Every byte under /config/cache is derived and Jellyfin rebuilds it, but it churns
            # constantly, and Longhorn backs up allocated device BLOCKS rather than live files —
            # so a cache that deletes and rewrites itself leaves freed-but-never-discarded blocks
            # behind, which the weekly backup then ships forever. Measured 2026-08-16:
            # jellyfin-config held 222 MiB of live files (32 MiB of it this cache) against 680 MiB
            # backed up. The durable library — /config/data, /config/*.xml — stays on the PVC.
            #
            # Losing this on a pod move is intended and costs a rebuild, nothing more.
            - name: cache
              mountPath: /config/cache
          readinessProbe:
            httpGet:
              path: /health
              port: {{ container_item.port }}
            initialDelaySeconds: 15
            periodSeconds: 10
          # start-up on a slow or post-update boot runs a library scan and hardware-init before
          # /health answers; the compose healthcheck allows 60s for the same reason.
          livenessProbe:
            httpGet:
              path: /health
              port: {{ container_item.port }}
            initialDelaySeconds: 90
            periodSeconds: 30
          resources:
            limits:
              cpu: "{{ jellyfin_k8s_cpu_limit }}"
              memory: {{ jellyfin_k8s_mem_limit }}
              {{ jellyfin_k8s_dri_resource }}: 1
            requests:
              cpu: "{{ jellyfin_k8s_cpu_request }}"
              memory: {{ jellyfin_k8s_mem_request }}
              # Extended resources must request exactly what they limit — Kubernetes rejects a
              # mismatch, and omitting the request entirely defaults it to the limit anyway.
              {{ jellyfin_k8s_dri_resource }}: 1
      volumes:
        - name: config
          persistentVolumeClaim:
            claimName: {{ jellyfin_k8s_claim }}
        - name: media
          persistentVolumeClaim:
            claimName: {{ jellyfin_k8s_media_claim }}
        - name: cache
          emptyDir: {}
