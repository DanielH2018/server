{#
  jellyfin's snapshot-space cap as a post-apply mutation Job, INERT until jellyfin's flip, as
  `job.yaml.j2` beside it is.

  It replaces the three cap tasks in `tasks/main.yml`: resolve the volume from the claim's
  `spec.volumeName`, read `spec.snapshotMaxSize`, and patch it to the rendered value only when
  it differs. So a re-run changes nothing, which `homelab/rerun-safe` names the test for.

  D5's *jellyfin's cap* puts this Job in jellyfin's Kustomization. The Job census admits no Job
  there ("move the Job to <tag>-verify"), and D5's *Post-apply mutation Jobs share
  `<tag>-verify`* puts a mutation that needs the tag applied in `<tag>-verify`. This one needs
  the claim Bound, so it sits with the verify Job.

  DECIDED: under Flux the cap runs in `jellyfin-verify`, after the claim applies, as the
  Ansible tasks run after k8s/manifests (#3387). The gap #3387 accepted closes here: the
  `jellyfin-snapshot` Job skips a claim that does not exist yet, so a new claim's first
  snapshot is the next revision's, and the cap has landed by then. The spec embeds a digest of
  jellyfin's rendered Deployment, so the cap is re-checked on every revision that rolls
  jellyfin. A volume rebuilt under the same claim stays uncapped until the next such revision,
  where Ansible re-checked on every deploy.

  The value is `jellyfin_k8s_snapshot_max_size` as a string: the templar turns that whole-string
  template into an int, and Longhorn stores the cap as a decimal string.
#}
{% set script_name = 'jellyfin_snapshot_cap.py' %}
{% set script_dir = '/cap' %}
{% set data = {
  script_name: lookup('file', playbook_dir + '/roles/k8s/jellyfin/files/' + script_name, rstrip=False),
  'flux_job_connect.py': flux_job_connect,
} %}
{% set configmap_name = 'jellyfin-snapshot-cap-' + ({'data': data, 'binaryData': {}} | to_json(sort_keys=True, separators=(',', ':')) | hash('sha256'))[:8] %}
{% set deployment_digest8 = (lookup('template', 'deployment.yaml.j2') | hash('sha256'))[:8] %}
{% set spec_text %}
# One retry. The Job reads before it patches, so a second run after a transient API error
# writes only if the cap still differs.
backoffLimit: 1
# Below the 600s `manifests_rollout_timeout_default` every `<tag>-verify` Kustomization takes.
# Three API calls of 10s each, plus the helper's 60s of retries on each connect.
activeDeadlineSeconds: 300
template:
  metadata:
    labels:
      app: jellyfin-snapshot-cap
  spec:
    # Its own ServiceAccount, so the verify Job's tokenless one never holds the patch grant.
    serviceAccountName: jellyfin-snapshot-cap
    restartPolicy: Never
    enableServiceLinks: false
    securityContext:
      runAsNonRoot: true
      runAsUser: 65534
      runAsGroup: 65534
      seccompProfile:
        type: RuntimeDefault
    containers:
      - name: cap
        image: {{ flux_job_image }}
        command:
          - python3
          - {{ script_dir }}/{{ script_name }}
        env:
          - name: CAP_NAMESPACE
            value: {{ k8s_namespace | to_json }}
          - name: CAP_CLAIM
            value: {{ jellyfin_k8s_claim | to_json }}
          - name: CAP_MAX_SIZE
            value: {{ jellyfin_k8s_snapshot_max_size | string | to_json }}
          # Renames the Job whenever jellyfin's Deployment changes; see the DECIDED note above.
          - name: JELLYFIN_DEPLOYMENT_DIGEST8
            value: "{{ deployment_digest8 }}"
          - name: SSL_CERT_FILE
            value: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
          - name: PYTHONDONTWRITEBYTECODE
            value: "1"
        resources:
          requests:
            cpu: 10m
            memory: 32Mi
          limits:
            memory: 64Mi
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop:
              - ALL
        volumeMounts:
          - name: script
            mountPath: {{ script_dir }}
            readOnly: true
    volumes:
      - name: script
        configMap:
          name: {{ configmap_name }}
{% endset %}
{% set spec = spec_text | from_yaml %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ configmap_name }}
  namespace: {{ k8s_namespace }}
data:
{% for key, text in data | dictsort %}
  {{ key }}: {{ text | to_json }}
{% endfor %}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: jellyfin-snapshot-cap-{{ (spec | to_json(sort_keys=True, separators=(',', ':')) | hash('sha256'))[:8] }}
  namespace: {{ k8s_namespace }}
  annotations:
    homelab/job-kind: mutation
    homelab/rerun-safe: ansible/roles/k8s/jellyfin/tests/test_jellyfin_snapshot_cap.py::test_a_second_run_changes_nothing
spec:
{{ spec_text | indent(2, true) }}
