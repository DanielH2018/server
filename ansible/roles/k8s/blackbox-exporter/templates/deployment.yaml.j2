{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
{% from 'workload-shell.yml.j2' import spec_shell, pod_shell with context %}
{% from 'ingress-host-aliases.yml.j2' import ingress_host_aliases with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: blackbox-exporter
  namespace: {{ k8s_namespace }}
spec:
{{ spec_shell('RollingUpdate') }}
  replicas: 1
  selector:
    matchLabels:
      app: blackbox-exporter
  template:
    metadata:
      labels:
        app: blackbox-exporter
        netpol-baseline: enforced
    spec:
{{ pod_shell('homelab-standard', run_as_user=blackbox_exporter_k8s_uid, run_as_group=blackbox_exporter_k8s_uid, fs_group=blackbox_exporter_k8s_uid) }}
      # The probes dial every ingress name, so they resolve each one exactly as uptime-kuma's
      # tiles do: pinned to the ingress VIP, never through CoreDNS and its upstreams.
{{ ingress_host_aliases() }}
      containers:
        - name: blackbox-exporter
          image: {{ blackbox_exporter_k8s_image }}
          imagePullPolicy: IfNotPresent
          # Named explicitly: the mount below shadows the image's own /etc/blackbox_exporter.
          args:
            - --config.file=/etc/blackbox_exporter/blackbox.yml
          ports:
            - containerPort: {{ container_item.port }}
{{ hardened_security_context(read_only=true, non_root=true) }}
          volumeMounts:
            - name: blackbox-exporter-config
              mountPath: /etc/blackbox_exporter
              readOnly: true
          # /-/healthy proves the process answers, not that a module still probes correctly.
          readinessProbe:
            httpGet:
              path: /-/healthy
              port: {{ container_item.port }}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /-/healthy
              port: {{ container_item.port }}
            initialDelaySeconds: 15
            periodSeconds: 30
{{ container_resources(cpu_limit=blackbox_exporter_k8s_cpu_limit, mem_limit=blackbox_exporter_k8s_mem_limit, cpu_request=blackbox_exporter_k8s_cpu_request, mem_request=blackbox_exporter_k8s_mem_request) }}
      volumes:
        - name: blackbox-exporter-config
          configMap:
            name: blackbox-exporter
