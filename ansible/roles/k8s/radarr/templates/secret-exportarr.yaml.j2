---
# The exportarr sidecar's credential. Rendered through the manifests role's SECRET list
# (0600 + no_log).
#
# Reuses `radarr_api_key` rather than minting a second one: it IS radarr's API key, the same
# value monitor-bridge, configarr and homepage already read, and radarr offers no scoped
# read-only variant to mint instead.
apiVersion: v1
kind: Secret
metadata:
  name: radarr-exportarr
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  api_key: "{{ radarr_api_key }}"
