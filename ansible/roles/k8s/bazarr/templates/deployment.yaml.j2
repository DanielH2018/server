{% from 'container-resources.yml.j2' import container_resources with context %}
{% from 'security-context.yml.j2' import hardened_security_context with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bazarr
  namespace: {{ k8s_namespace }}
spec:
  revisionHistoryLimit: 3
  replicas: 1
  # The config PVC is ReadWriteOnce on single-replica Longhorn, so a rolling update deadlocks:
  # the new pod waits for a volume the old pod has not released. (The media PVC is RWX and does
  # not have this problem — this is about /config.)
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: bazarr
  template:
    metadata:
      labels:
        app: bazarr
        netpol-baseline: enforced
    spec:
      enableServiceLinks: false
      # No fsGroup: volume-claim restores ownership with `tar -p --numeric-owner`, the LSIO image
      # chowns /config itself on startup, and an fsGroup here would make the kubelet recursively
      # chown the 19 G media volume on every mount.
      automountServiceAccountToken: false
      priorityClassName: homelab-standard
      containers:
        - name: bazarr
          image: {{ bazarr_k8s_image }}
          ports:
            - containerPort: {{ container_item.port }}
          # The compose template's cap_drop/cap_add pair — the s6 privilege-drop set. No
          # NET_BIND_SERVICE: bazarr listens on {{ container_item.port }} (>1024), which needs no
          # privilege. Interpolated rather than written out: this comment said 8989 — sonarr's port, from
          # the role it was copied from — until 2026-08-23b L6.
{{ hardened_security_context(add=['CHOWN', 'SETUID', 'SETGID', 'FOWNER', 'DAC_OVERRIDE']) }}
          env:
            - name: PUID
              value: "{{ puid }}"
            - name: PGID
              value: "{{ pgid }}"
            - name: TZ
              value: "{{ tz }}"
          volumeMounts:
            - name: bazarr-config
              mountPath: /config
            # /data/media ONLY, via subPath — narrower than the \*arrs on purpose, and it is
            # what the compose template mounts. bazarr writes subtitle files beside the media it
            # subtitles; it never imports, so it has no reason to see /data/torrents and no
            # hardlink seam to preserve.
            - name: media
              mountPath: /data/media
              subPath: media
          readinessProbe:
            httpGet:
              path: /ping
              port: {{ container_item.port }}
            initialDelaySeconds: 15
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /ping
              port: {{ container_item.port }}
            initialDelaySeconds: 60
            periodSeconds: 30
{{ container_resources(cpu_limit=bazarr_k8s_cpu_limit, mem_limit=bazarr_k8s_mem_limit, cpu_request=bazarr_k8s_cpu_request, mem_request=bazarr_k8s_mem_request) }}
      volumes:
        - name: bazarr-config
          persistentVolumeClaim:
            claimName: {{ bazarr_k8s_claim }}
        - name: media
          persistentVolumeClaim:
            claimName: {{ bazarr_k8s_media_claim }}
