# Shipped by homelab-updater. Reconcile marks this unit `manual`, so an upgrade never restarts
# the run that installed it.
[Unit]
Description=Install the newest homelab packages and reconcile this host
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# This host's journald stores notice and above (MaxLevelStore=notice), so stdout logs at notice.
SyslogLevel=notice
ExecStart=/usr/lib/homelab/homelab-updater
Nice=10
# Lowest best-effort priority, so the integrity scans' idle-class reads yield to the install on the
# Pi's mq-deadline SD card.
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Reconcile's 30 minutes, the install's 10-minute DPkg::Lock::Timeout, and 10 minutes for fetch and
# unpack.
TimeoutStartSec=50min
