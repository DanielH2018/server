#!/usr/bin/python3
"""homelab-secrets: decrypt this host's SOPS file and write the credentials and outputs it feeds.

The design is H4's *`homelab-secrets.service`* (docs/target-architecture/host/h4-secrets-unit.md),
and the step numbers below are that section's. `homelab-secrets.service` runs this as root under
the host's /usr/bin/python3, which is 3.12 on Ubuntu 24.04. It uses the standard library and
reconcile_lib's `log`, which writes each line at err priority on the journal.
This file holds steps 1 to 6. Step 5 records which dependents owe a restart and restarts none.

Usage: homelab-secrets        (no arguments; exit 0 when everything was written, 1 otherwise)

The manifest, /usr/lib/homelab/secrets.json, which the host package ships:

    {"sops_file": "/usr/lib/homelab/secrets/<host>.sops.yaml",
     "credentials": ["<key>", ...],
     "outputs": [{"template": "/usr/lib/homelab/secret-templates/<path>",
                  "destination": "<path relative to the output root>",
                  "owner": "<user>", "group": "<group>", "mode": "0640",
                  "persist": false, "dependents": ["<unit>", ...], "keys": ["<key>", ...]}]}

An output may also carry "format": "dotenv". Such an output is a Compose env file whose template
single-quotes each value, and a single-quoted dotenv value cannot hold a `'` or a line break. The
script refuses to render an output of that format when a substituted value holds `'`, a newline
or a carriage return, and fails that output like a missing key: the old file stays and the run
exits 1. The message names the key and never the value. Any other "format" makes the manifest
invalid; an output without one is not checked.

A credential goes to /run/credstore/<key>. An output goes to /run/homelab-secrets/<destination>,
or to /var/lib/homelab-secrets/<destination> when `persist` is true. The decrypted file is read
once and held in memory. A failed decrypt writes nothing and deletes nothing.

The state step 5 keeps, all root:root:

    /var/lib/homelab-secrets/.hmac-key   mode 0600, 32 random bytes; survives a reboot
    /var/lib/homelab-secrets/.digests    mode 0600, JSON {"<output path>": "<hex HMAC-SHA256>"};
                                         the path is the output's real path, such as
                                         /run/homelab-secrets/app/env; survives a reboot
    /run/homelab-secrets/pending.json    mode 0644, a sorted JSON array of unit names that owe a
                                         restart; reconcile removes an entry after acting on it
    /run/homelab-secrets/pending.lock    mode 0600; the exclusive flock that both this script and
                                         reconcile hold while they read and rewrite pending.json

The HMAC covers an output's rendered bytes, so a changed value, template or key list changes it.
The script adds an output's dependents to pending.json when the HMAC differs from the recorded
one or none is recorded, and never removes an entry. An output that failed keeps its old HMAC,
so a later run that writes it queues its dependents. The script then replaces .digests, which
drops the HMAC of every output the manifest no longer lists. It writes pending.json before
.digests, so a run that dies between the two queues the same dependents again.

HOMELAB_ROOT prefixes every path this reads or writes. Only the tests in hosts/lib/tests/ set it.
The environment names the age key (SOPS_AGE_KEY_FILE), and sops inherits it.
"""

import contextlib
import fcntl
import hashlib
import hmac
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

# The reconcile component installs reconcile_lib beside this script, and every host package
# ships that component (hosts/components/reconcile/component.yml).
from reconcile_lib.common import ERR, log

# Every line this script prints is a failure, so each passes ERR and reaches the journal at err.
TAG = "homelab-secrets"

ROOT = os.environ.get("HOMELAB_ROOT", "")
MANIFEST = ROOT + "/usr/lib/homelab/secrets.json"
SOPS = ROOT + "/usr/lib/homelab/bin/sops"
CREDSTORE = ROOT + "/run/credstore"
TMPFS_ROOT = ROOT + "/run/homelab-secrets"
PERSIST_ROOT = ROOT + "/var/lib/homelab-secrets"
# The queue and digest state the later steps keep at the top of each output root.
STATE_NAMES = frozenset({".digests", ".hmac-key", "pending.json", "pending.lock"})
HMAC_KEY = PERSIST_ROOT + "/.hmac-key"
DIGESTS = PERSIST_ROOT + "/.digests"
PENDING = TMPFS_ROOT + "/pending.json"
PENDING_LOCK = TMPFS_ROOT + "/pending.lock"
HMAC_KEY_BYTES = 32
SOPS_TIMEOUT_SECONDS = 50  # the unit's TimeoutStartSec is 60
LOCK_TIMEOUT_SECONDS = 5  # a holder rewrites a small file; with SOPS_TIMEOUT_SECONDS it fits 60

KEY = re.compile(r"[A-Za-z0-9_][A-Za-z0-9_.-]*")
NAME = re.compile(r"[A-Za-z0-9_]+")
MODE = re.compile(r"0?[0-7]{3}")
# One left-to-right pass. `$$` is consumed first, so `$${key}` leaves `{key}` as literal text.
SUBSTITUTION = re.compile(r"\$\$|\$\{([A-Za-z0-9_]+)\}|\$\{")

# What a single-quoted dotenv value cannot hold: the quote ends it, a line break ends the line.
DOTENV_FORBIDDEN = re.compile(r"['\r\n]")
FORMATS = frozenset({"dotenv"})


class Failure(Exception):
    """One credential or output could not be written. The message never holds a value."""


def _chown(path, owner, group):
    shutil.chown(path, owner, group)


def load_manifest():
    """Step 1. Returns the validated manifest, or raises Failure for a malformed one."""
    try:
        with open(MANIFEST, encoding="utf-8") as handle:
            manifest = json.load(handle)
        sops_file = manifest["sops_file"]
        credentials = manifest["credentials"]
        outputs = manifest["outputs"]
        assert isinstance(sops_file, str) and sops_file.startswith("/")
        assert isinstance(credentials, list) and isinstance(outputs, list)
        for key in credentials:
            assert isinstance(key, str) and KEY.fullmatch(key)
        for out in outputs:
            check_output(out)
    except (OSError, ValueError, KeyError, TypeError, AssertionError) as error:
        raise Failure(f"{MANIFEST} is not a valid manifest ({type(error).__name__})") from error
    return manifest


def check_output(out):
    parts = out["destination"].split("/")
    assert all(p not in ("", ".", "..") for p in parts)
    assert not (len(parts) == 1 and parts[0] in STATE_NAMES)
    assert isinstance(out["template"], str) and out["template"].startswith("/")
    assert isinstance(out["owner"], str) and isinstance(out["group"], str)
    assert MODE.fullmatch(out["mode"])
    assert isinstance(out["persist"], bool)
    assert out.get("format") is None or out["format"] in FORMATS
    for field in ("keys", "dependents"):
        assert isinstance(out[field], list) and all(isinstance(k, str) for k in out[field])


def decrypt(sops_file):
    """Step 2. One sops call; the plaintext stays in memory."""
    try:
        result = subprocess.run(
            [SOPS, "--decrypt", "--output-type", "json", ROOT + sops_file],
            capture_output=True,
            text=True,
            timeout=SOPS_TIMEOUT_SECONDS,
        )
        values = json.loads(result.stdout) if result.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, ValueError) as error:
        raise Failure(f"decrypting {sops_file} failed ({type(error).__name__})") from error
    if result.returncode != 0:
        raise Failure(f"sops exited {result.returncode} on {sops_file}: {result.stderr.strip()}")
    if not isinstance(values, dict):
        raise Failure(f"sops printed no mapping for {sops_file}")
    return values


def value_of(values, key):
    if key not in values:
        raise Failure(f"the decrypted file holds no key {key}")
    if not isinstance(values[key], str):
        raise Failure(f"the value of {key} is not a string")
    return values[key]


def substitute(template, allowed, values, fmt=None):
    """Step 4's inverse of the renderer's escape: `$$` to `$`, `${name}` to its value.

    With `fmt` "dotenv", a value that holds `'`, a newline or a carriage return raises Failure.
    """

    def replace(match):
        if match.group(0) == "$$":
            return "$"
        name = match.group(1)
        if name is None:
            raise Failure("an unescaped ${ does not close as ${<name>}")
        if name not in allowed:
            raise Failure(f"the placeholder {name} is not in the output's key list")
        value = value_of(values, name)
        if fmt == "dotenv" and DOTENV_FORBIDDEN.search(value):
            raise Failure(f"the value of {name} holds a quote or a line break")
        return value

    return SUBSTITUTION.sub(replace, template)


def ensure_dir(path, mode):
    if os.path.islink(path) or (os.path.exists(path) and not os.path.isdir(path)):
        raise Failure(f"{path} is not a plain directory")
    os.makedirs(path, mode=mode, exist_ok=True)
    _chown(path, "root", "root")
    os.chmod(path, mode)


def write_atomic(path, content, owner, group, mode):
    """Write through a temporary file in the same directory, then rename over `path`."""
    directory, name = os.path.split(path)
    fd, temporary = tempfile.mkstemp(dir=directory, prefix=f".{name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        _chown(temporary, owner, group)
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    except BaseException:
        if os.path.lexists(temporary):
            os.unlink(temporary)
        raise


def write_credentials(credentials, values):
    """Step 3. Returns the number of credentials that failed."""
    ensure_dir(CREDSTORE, 0o700)
    failed = 0
    for key in credentials:
        try:
            write_atomic(
                f"{CREDSTORE}/{key}", value_of(values, key).encode(), "root", "root", 0o600
            )
        except (Failure, OSError, LookupError) as error:
            log(f"credential {key} failed: {error}", ERR, tag=TAG)
            failed += 1
    try:
        for entry in os.listdir(CREDSTORE):
            path = f"{CREDSTORE}/{entry}"
            if entry not in credentials and (os.path.islink(path) or not os.path.isdir(path)):
                os.unlink(path)
    except OSError as error:
        log(f"deleting unlisted credentials failed: {error}", ERR, tag=TAG)
        failed += 1
    return failed


def render_output(out, values):
    root = PERSIST_ROOT if out["persist"] else TMPFS_ROOT
    with open(ROOT + out["template"], encoding="utf-8", newline="") as handle:
        content = substitute(handle.read(), set(out["keys"]), values, out.get("format")).encode()
    path = f"{root}/{out['destination']}"
    ensure_dir(root, 0o755)
    for parent in reversed(list(parents_below(root, path))):
        ensure_dir(parent, 0o755)
    write_atomic(path, content, out["owner"], out["group"], int(out["mode"], 8))
    return content


def parents_below(root, path):
    parent = os.path.dirname(path)
    while parent != root:
        yield parent
        parent = os.path.dirname(parent)


def prune_outputs(outputs):
    """Step 4's last part: delete what the manifest no longer lists, under both roots."""
    for root, persist in ((TMPFS_ROOT, False), (PERSIST_ROOT, True)):
        listed = {o["destination"] for o in outputs if o["persist"] is persist}
        kept_dirs = {os.path.dirname(d) for d in listed} | {""}
        for here, dirs, files in os.walk(root, topdown=False):
            relative_here = os.path.relpath(here, root)
            for name in files + [d for d in dirs if os.path.islink(f"{here}/{d}")]:
                relative = name if relative_here == "." else f"{relative_here}/{name}"
                if relative not in listed and not (relative_here == "." and name in STATE_NAMES):
                    os.unlink(f"{here}/{name}")
            if relative_here != "." and relative_here not in kept_dirs and not os.path.islink(here):
                try:
                    os.rmdir(here)
                except OSError:
                    pass


def output_path(out):
    """The output's real path, without HOMELAB_ROOT: the key its HMAC is recorded under."""
    root = PERSIST_ROOT if out["persist"] else TMPFS_ROOT
    return f"{root[len(ROOT) :]}/{out['destination']}"


def read_json(path, default):
    """`default` when the file is absent; a Failure when it is there but unreadable."""
    try:
        with open(path, encoding="utf-8") as handle:
            return json.load(handle)
    except FileNotFoundError:
        return default
    except (OSError, ValueError) as error:
        raise Failure(f"{path} is unreadable ({type(error).__name__})") from error


@contextlib.contextmanager
def queue_lock():
    """Hold the exclusive flock on pending.lock, or raise Failure after LOCK_TIMEOUT_SECONDS."""
    fd = os.open(PENDING_LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        _chown(PENDING_LOCK, "root", "root")
        os.fchmod(fd, 0o600)
        deadline = time.monotonic() + LOCK_TIMEOUT_SECONDS
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError as error:
                if time.monotonic() >= deadline:
                    raise Failure(
                        f"{PENDING_LOCK} stayed locked for {LOCK_TIMEOUT_SECONDS}s"
                    ) from error
                time.sleep(0.05)
        yield
    finally:
        os.close(fd)


def hmac_key():
    """The random key the HMACs use. A missing or malformed key is replaced, which queues all."""
    try:
        with open(HMAC_KEY, "rb") as handle:
            key = handle.read()
    except OSError:
        key = b""
    if len(key) != HMAC_KEY_BYTES:
        key = os.urandom(HMAC_KEY_BYTES)
        write_atomic(HMAC_KEY, key, "root", "root", 0o600)
    return key


def record_restarts(outputs, rendered):
    """Step 5. `rendered` maps an output's path to the bytes the script wrote there."""
    ensure_dir(PERSIST_ROOT, 0o755)
    ensure_dir(TMPFS_ROOT, 0o755)
    with queue_lock():
        key = hmac_key()
        try:
            raw = read_json(DIGESTS, {})
        except Failure:
            raw = {}  # a damaged baseline queues every dependent, the safe direction
        recorded = (
            {k: v for k, v in raw.items() if isinstance(v, str)} if isinstance(raw, dict) else {}
        )
        queue = read_json(PENDING, [])
        if not isinstance(queue, list) or not all(isinstance(unit, str) for unit in queue):
            raise Failure(f"{PENDING} is not a list of unit names")
        digests, owed = {}, set()
        for out in outputs:
            path = output_path(out)
            if path in rendered:
                digests[path] = hmac.new(key, rendered[path], hashlib.sha256).hexdigest()
                if not hmac.compare_digest(digests[path], recorded.get(path, "")):
                    owed.update(out["dependents"])
            elif path in recorded:
                digests[path] = recorded[path]
        if owed - set(queue):
            content = json.dumps(sorted(set(queue) | owed)).encode()
            write_atomic(PENDING, content, "root", "root", 0o644)
        write_atomic(DIGESTS, json.dumps(digests, sort_keys=True).encode(), "root", "root", 0o600)


def main(argv):
    if argv:
        log("takes no arguments", ERR, tag=TAG)
        return 64
    try:
        manifest = load_manifest()
        values = decrypt(manifest["sops_file"])
    except Failure as error:
        log(f"{error}; nothing was written or deleted", ERR, tag=TAG)
        return 1
    failed = 0
    rendered = {}
    try:
        failed += write_credentials(manifest["credentials"], values)
    except (Failure, OSError) as error:
        log(f"the credential store failed: {error}", ERR, tag=TAG)
        failed += 1
    for out in manifest["outputs"]:
        try:
            rendered[output_path(out)] = render_output(out, values)
        except (Failure, OSError, LookupError, UnicodeError) as error:
            log(f"output {out['destination']} failed: {error}", ERR, tag=TAG)
            failed += 1
    try:
        prune_outputs(manifest["outputs"])
    except OSError as error:
        log(f"deleting unlisted outputs failed: {error}", ERR, tag=TAG)
        failed += 1
    try:
        record_restarts(manifest["outputs"], rendered)
    except (Failure, OSError) as error:
        log(f"recording the restart queue failed: {error}", ERR, tag=TAG)
        failed += 1
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
