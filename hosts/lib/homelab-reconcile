#!/usr/bin/python3
"""homelab-reconcile: bring this host's units and legacy entries in line with its packages.

The design is H3's *The reconcile unit* (docs/target-architecture/host/h3-pi-pilot.md), and the
step numbers below are that section's. `homelab-reconcile.service` runs this as root, under the
host's /usr/bin/python3, which is 3.12 on Ubuntu 24.04. It uses the standard library only, and
hosts/lib/tests/test_reconcile_component.py parses it with the 3.12 grammar. The activation step,
the four arms and the metrics file live in the reconcile_lib package beside it, which the same
component ships; the reconcile-size census counts both against one line ceiling.

Usage: homelab-reconcile        (no arguments; exit 0 when every step succeeded, 1 otherwise)

It takes dpkg's frontend lock with a blocking lockf, so a start from a postinst waits until the
whole apt transaction has finished. Under the lock it reads the manifest, its own state and both
packages' status, then releases the lock before its first systemctl call.

The manifest, /usr/lib/homelab/manifest.json, which the host package ships:

    {"units": {"<unit>": {"policy": "manual" | "windowed"}, "<unit>": {}, ...},
     "enable_links": ["<unit>", ...],
     "legacy": [{"path": "/abs/path"}, {"cron": "<name>", "user": "<user>"},
                {"cron_file": "<name under /etc/cron.d>"}, {"unit": "<Ansible-era unit>"}],
     "reconcilers": [] | ["libvirt", "lines", "ufw", "users"],
     "activations": {"<packaged path>": "<action>"},
     "ufw": {"rules": [...], "legacy": [...]}, "libvirt": {...}, "users": {...},
     "lines": {...},
     "secrets_inputs_sha256": "<hex>"}

`units` names every unit reconcile manages, another homelab package's and another package's
drop-in target included. `enable_links` names each unit whose enable link the manifest's
packages ship. `reconcilers` lists the arms the manifest carries state for. The four arms are in
ARMS, and each section's schema is the docstring of its reconcile_lib module, so a manifest
listing another kind fails the run here. The udev arm (H4.3b1) is not one of them: it hashes the
package's /usr/lib/udev/rules.d/NN-homelab-*.rules files, as reconcile_lib/udev.py says.
`activations` maps a
packaged file to the action step 3b runs when its hash changes (reconcile_lib/activate.py).
`secrets_inputs_sha256` is present only when the package ships the `secrets-unit` component, and
every secrets rule below keys on it.

The restart contract (docs/target-architecture/host/h4-secrets-unit.md, *The restart contract*):
reconcile is the only process that starts or restarts a unit outside the boot path. It never starts
or restarts a `windowed` unit, and never restarts a `manual` one. Step 1b runs `homelab-secrets`
when the secrets inputs changed. The restart set, built before step 2, holds the units whose file
or drop-in changed and the units in /run/homelab-secrets/pending.json, each only when it is
enabled or active. Step 2 starts the enabled units outside the set, and step 3 restarts the set.
A unit gets at most one call per run. `reset-failed` precedes it, and no call uses `--no-block`.
A unit whose outputs do not exist, or whose call fails, joins pending.json and keeps its old hash,
and the run exits 1. An entry leaves pending.json after reconcile acts on it, or when its unit is
`windowed`, `manual`, masked, or neither enabled nor active.

Its state and record, /var/lib/homelab-reconcile/applied.json:

    {"result":  {"versions": {"<package>": "<version>"}, "ok": <bool>, "finished": <epoch>},
     "last_ok": {the same fields, from the newest run that succeeded},
     "units": {"<unit>": {"file": "<sha256>", "dropin": "<sha256>"} | null},
     "enable_links": ["<unit>", ...],
     "retired": ["<legacy entry as canonical JSON>", ...],
     "files": {"<packaged path>": "<sha256>"},     (activated files, by the hash that ran)
     "pending": {"<unit>": "<InvocationID>"},      (units owed a restart: the manual: actions)
     "drift": {"<arm>": <items the arm left alone>},
     "ufw": {"ids": ["<rule id>", ...]},           (once any manifest has declared ufw)
     "users": {"names": [...]}, "libvirt": {"networks": {...}, "nwfilters": {...}},  (likewise)
     "udev": {"<rule path>": "<sha256>", ...},     (only while a rule is shipped)
     "secrets_inputs_sha256": "<hex>"}   (only after a run in which homelab-secrets succeeded)

homelab-updater reads only `result` and `last_ok`. Each per-entry item advances only when its
step succeeded on it, or when the step's rule left it alone, so the next run retries exactly
the actions that failed. A `null` hash reads as changed.

Drift is an item an arm or a rule left alone on purpose: a ufw rule the floor kept, a libvirt
object a running guest still references, a user the floor kept, or a legacy service that is still
running. It is counted in `drift`, never fails the run, and is retried by
the next run. A fault fails the run, which holds the host. The run also writes
homelab_host_reconcile.prom (reconcile_lib/textfile.py).

HOMELAB_ROOT prefixes every path this reads or writes. Only the tests in hosts/lib/tests/ set it.
"""

import fcntl
import hashlib
import json
import os
import re
import shutil
import sys
import time
from pathlib import Path

from reconcile_lib import activate, libvirt, lines, textfile, udev, ufw, users
from reconcile_lib.common import ROOT, run, say, systemctl, under_root

LOCK = ROOT / "var/lib/dpkg/lock-frontend"
MANIFEST = ROOT / "usr/lib/homelab/manifest.json"
APPLIED = ROOT / "var/lib/homelab-reconcile/applied.json"
UNIT_DIR = Path("/usr/lib/systemd/system")
ETC_UNIT_DIR = Path("/etc/systemd/system")
CRON_D = Path("/etc/cron.d")
DROPIN = "50-homelab.conf"
SECRETS_UNIT = "homelab-secrets.service"
SECRETS_JSON = ROOT / "usr/lib/homelab/secrets.json"
CREDSTORE = ROOT / "run/credstore"
RUN_DIR = ROOT / "run/homelab-secrets"
PERSIST_DIR = ROOT / "var/lib/homelab-secrets"
PENDING = RUN_DIR / "pending.json"
PENDING_LOCK = RUN_DIR / "pending.lock"
LOCK_SECONDS = 5  # a holder rewrites a small file; homelab-secrets waits as long

# An upgrade never restarts the run that installed it, whatever the manifest says.
ALWAYS_MANUAL = frozenset({"homelab-updater.service", "homelab-reconcile.service"})
UNIT_NAME = re.compile(r"[A-Za-z0-9@_.:-]+\.(service|timer|socket|path)")
PLAIN_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]*")
POLICIES = frozenset({"manual", "windowed"})
# Each arm module has valid(section) and reconcile(section, prev) -> (ok, record | None, drift).
# Users and lines run before the units start, lines before the activations read the files it
# edits, and libvirt then ufw last, so that ufw's enable applies the sysctl edit already made.
ARMS = {"users": users, "lines": lines, "libvirt": libvirt, "ufw": ufw}
EARLY = ("users", "lines")
SHA256 = re.compile(r"[0-9a-f]{64}")
# systemctl's exit for a unit that is not loaded: there is nothing to stop.
NOT_LOADED = 5


class ManifestError(Exception):
    """The manifest is missing or malformed, so reconcile acts on nothing."""


def is_homelab(unit: str) -> bool:
    return unit.startswith("homelab-")


# Reading, under the lock.


def read_installed(packages: list[str]) -> dict[str, tuple[str, str]]:
    """Each package's three-letter dpkg status and version; ("", "") for one dpkg lacks."""
    out = run(
        "dpkg-query",
        "-W",
        "-f",
        "${Package} ${db:Status-Abbrev}${Version}\\n",
        *packages,
    ).stdout
    installed = dict.fromkeys(packages, ("", ""))
    for line in out.splitlines():
        name, _, rest = line.partition(" ")
        if name in installed:
            installed[name] = (rest[:3], rest[3:])
    return installed


def load_json(path: Path) -> dict:
    try:
        value = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}
    return value if isinstance(value, dict) else {}


def parse_manifest(text: str) -> dict:
    try:
        manifest = json.loads(text)
    except ValueError as exc:
        raise ManifestError(f"{MANIFEST} is not JSON: {exc}") from exc
    if not isinstance(manifest, dict):
        raise ManifestError(f"{MANIFEST} is not an object")
    units = manifest.get("units", {})
    links = manifest.get("enable_links", [])
    legacy = manifest.get("legacy", [])
    reconcilers = manifest.get("reconcilers", [])
    if not isinstance(units, dict) or not all(
        UNIT_NAME.fullmatch(name)
        and isinstance(spec, dict)
        and spec.get("policy") in POLICIES | {None}
        for name, spec in units.items()
    ):
        raise ManifestError(f"{MANIFEST}: units {units!r} is not a map of unit names")
    if not isinstance(links, list) or not all(link in units for link in links):
        raise ManifestError(f"{MANIFEST}: every enable link must name a listed unit")
    if not isinstance(legacy, list) or not all(map(valid_legacy, legacy)):
        raise ManifestError(
            f"{MANIFEST}: legacy {legacy!r} holds an entry of no known kind"
        )
    if not isinstance(reconcilers, list):
        raise ManifestError(f"{MANIFEST}: reconcilers is not a list")
    activations = manifest.get("activations", {})
    if not activate.valid_activations(activations):
        raise ManifestError(f"{MANIFEST}: activations {activations!r} is malformed")
    for name, arm in ARMS.items():
        section = manifest.get(name)
        if (name in reconcilers or section is not None) and not (
            arm.valid(section) and name in reconcilers
        ):
            raise ManifestError(
                f"{MANIFEST}: the {name} section is malformed or unlisted"
            )
    parsed = {
        "units": units,
        "enable_links": links,
        "legacy": legacy,
        "reconcilers": [name for name in reconcilers if name not in ARMS],
        "activations": activations,
        "arms": {name: manifest.get(name) for name in ARMS},
    }
    digest = manifest.get("secrets_inputs_sha256")
    if digest is not None:
        if not isinstance(digest, str) or not SHA256.fullmatch(digest):
            raise ManifestError(f"{MANIFEST}: secrets_inputs_sha256 is not a sha256")
        parsed["secrets_inputs_sha256"] = digest
    return parsed


def valid_legacy(entry: object) -> bool:
    if not isinstance(entry, dict):
        return False
    if set(entry) == {"path"}:
        path = entry["path"]
        return (
            isinstance(path, str)
            and path.startswith("/")
            and ".." not in path.split("/")
        )
    if set(entry) == {"cron", "user"}:
        return all(isinstance(v, str) and v and "\n" not in v for v in entry.values())
    if set(entry) == {"cron_file"}:
        return isinstance(entry["cron_file"], str) and bool(
            PLAIN_NAME.fullmatch(entry["cron_file"])
        )
    if set(entry) == {"unit"}:
        return isinstance(entry["unit"], str) and bool(
            UNIT_NAME.fullmatch(entry["unit"])
        )
    return False


def read_under_lock(packages: list[str]) -> tuple[str | None, dict, dict]:
    """The manifest text (None when absent), the previous state, and both packages' status.

    Blocks until no apt or dpkg frontend holds the lock, and releases it before returning.
    """
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(LOCK, os.O_RDWR | os.O_CREAT, 0o640)
    try:
        fcntl.lockf(fd, fcntl.LOCK_EX)
        try:
            text = MANIFEST.read_text()
        except FileNotFoundError:
            text = None
        return text, load_json(APPLIED), read_installed(packages)
    finally:
        os.close(fd)  # closing the descriptor releases the lock


# Unit state.


def unit_hash(unit: str) -> dict:
    """The sha256 of the unit's file and of its homelab drop-in; None for one that is absent."""

    def digest(path: Path) -> str | None:
        try:
            return hashlib.sha256(under_root(path).read_bytes()).hexdigest()
        except FileNotFoundError:
            return None

    return {
        "file": digest(UNIT_DIR / unit),
        "dropin": digest(UNIT_DIR / f"{unit}.d" / DROPIN),
    }


def load_state(unit: str) -> str:
    return systemctl("show", "-p", "LoadState", "--value", unit).stdout.strip()


def is_active(unit: str) -> bool:
    return systemctl("is-active", unit).stdout.strip() == "active"


def not_found_homelab_units() -> set[str]:
    """Every loaded `homelab-*` unit whose LoadState is not-found: its file has gone."""
    out = systemctl("show", "-p", "Id", "-p", "LoadState", "homelab-*").stdout
    found = set()
    for block in out.split("\n\n"):
        props = dict(
            line.partition("=")[::2] for line in block.splitlines() if "=" in line
        )
        if props.get("LoadState") == "not-found" and is_homelab(props.get("Id", "")):
            found.add(props["Id"])
    return found


def stop(unit: str) -> bool:
    result = systemctl("stop", unit)
    if result.returncode not in (0, NOT_LOADED):
        say(f"stop {unit} failed: {result.stderr.strip()}")
        return False
    systemctl(
        "reset-failed", unit
    )  # a unit that is not failed makes this fail harmlessly
    say(f"stopped {unit}")
    return True


# Legacy entries (H3, *The host handoff rule*).


def owned(path: Path) -> bool | None:
    """True when a package owns `path`, False when none does, None when dpkg cannot say."""
    code = run("dpkg", "-S", str(path)).returncode
    return {0: True, 1: False}.get(code)


def retire_path(path: Path) -> bool:
    """Remove an unowned legacy path, and say whether the entry is retired.

    A directory goes only when it is empty, through `rmdir`. A non-empty one stays and fails
    the entry, so a package lists a directory after the files in it, and reconcile never
    deletes contents nothing named.
    """
    owner = owned(path)
    if owner is None:
        say(f"dpkg -S {path} failed; not removing it")
        return False
    if owner:
        say(f"{path} is owned by a package; leaving it")
        return True
    target = under_root(path)
    if not os.path.lexists(target):
        return True
    try:
        if target.is_dir() and not target.is_symlink():
            target.rmdir()
        else:
            target.unlink()
    except OSError as exc:
        say(f"cannot remove {path}: {exc}")
        return False
    say(f"removed {path}")
    return True


def shadow_path(entry: dict, units: dict) -> Path | None:
    """The /etc/systemd/system path a legacy entry names, when it can shadow a packaged unit.

    A `{path:}` entry under that directory always can. A `{unit:}` entry can when the package
    ships that unit, because an Ansible-era copy of it shadows the packaged one.
    """
    if entry.get("unit") in units:
        return ETC_UNIT_DIR / entry["unit"]
    path = Path(entry.get("path", ""))
    return path if ETC_UNIT_DIR in path.parents and ".." not in path.parts else None


def hand_off(path: Path) -> tuple[bool, bool] | None:
    """Remove the /etc copy of a unit the package ships.

    Returns:
        None when the removal failed, else whether a file was removed and whether its bytes
        differ from the packaged unit's (a wants link has none, so it never differs).
    """
    target = under_root(path)
    present = os.path.lexists(target)
    try:
        differs = (
            present
            and path.parent == ETC_UNIT_DIR
            and target.read_bytes() != under_root(UNIT_DIR / path.name).read_bytes()
        )
    except OSError:
        differs = True
    return (present, differs) if retire_path(path) else None


def retire_cron(name: str, user: str) -> bool:
    if shutil.which("crontab") is None:
        # No cron package means no crontab holding the entry. Only an absent binary counts:
        # one that is present but will not run fails below, and the entry is retried.
        say(f"crontab is not installed; no {name} to retire")
        return True
    listing = run("crontab", "-l", "-u", user)
    if listing.returncode != 0:
        return "no crontab for" in listing.stderr
    lines = listing.stdout.splitlines(keepends=True)
    marker = f"#Ansible: {name}"
    if not any(line.rstrip("\n") == marker for line in lines):
        return True
    kept, skip = [], False
    for line in lines:
        if skip:
            skip = False
        elif line.rstrip("\n") == marker:
            skip = True
        else:
            kept.append(line)
    if run("crontab", "-u", user, "-", stdin="".join(kept)).returncode != 0:
        say(f"cannot rewrite {user}'s crontab without {name}")
        return False
    say(f"removed cron {name} from {user}'s crontab")
    return True


def retire_unit(unit: str) -> bool:
    path = ETC_UNIT_DIR / unit
    if os.path.lexists(under_root(path)):
        owner = owned(path)
        if owner is not False:
            say(f"{path} is owned by a package, or dpkg cannot say; leaving it")
            return owner is True
        if systemctl("disable", unit).returncode != 0:
            say(f"disable {unit} failed")
            return False
        if not stop(unit) or not retire_path(path):
            return False
        return systemctl("daemon-reload").returncode == 0
    return stop(unit)


def retire(entry: dict) -> bool:
    if "path" in entry:
        return retire_path(Path(entry["path"]))
    if "cron" in entry:
        return retire_cron(entry["cron"], entry["user"])
    if "cron_file" in entry:
        return retire_path(CRON_D / entry["cron_file"])
    return retire_unit(entry["unit"])


def legacy_key(entry: dict) -> str:
    return json.dumps(entry, sort_keys=True)


# The restart queue and the secrets outputs (H4, *The restart contract*).


def read_pending() -> set[str]:
    """The units in pending.json. An absent file is an empty queue, and so is an unreadable one."""
    try:
        queue = json.loads(PENDING.read_text())
    except FileNotFoundError:
        return set()
    except (OSError, ValueError):
        queue = None
    if not isinstance(queue, list):
        say(f"{PENDING} is unreadable; reading it as empty")
        return set()
    return {unit for unit in queue if isinstance(unit, str)}


def update_pending(add: set[str], remove: set[str]) -> bool:
    """Add and remove units under pending.lock. False when the lock or the write failed."""
    try:
        fd = os.open(
            PENDING_LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600
        )
    except OSError as exc:
        say(f"cannot open {PENDING_LOCK}: {exc}")
        return False
    try:
        deadline = time.monotonic() + LOCK_SECONDS
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    say(f"{PENDING_LOCK} stayed locked for {LOCK_SECONDS}s")
                    return False
                time.sleep(0.05)
        queue = read_pending()
        wanted = (queue | add) - remove
        if wanted != queue:
            tmp = PENDING.with_name(f".{PENDING.name}.{os.getpid()}")
            tmp.write_text(json.dumps(sorted(wanted)))
            tmp.chmod(0o644)
            os.replace(tmp, PENDING)
        return True
    except OSError as exc:
        say(f"cannot rewrite {PENDING}: {exc}")
        return False
    finally:
        os.close(fd)


def read_secrets_manifest() -> tuple[list[str], list[dict]] | None:
    """The credential keys and output rows of secrets.json; None when it is unusable."""
    try:
        manifest = json.loads(SECRETS_JSON.read_text())
        credentials, outputs = manifest["credentials"], manifest["outputs"]
        valid = (
            isinstance(credentials, list)
            and all(isinstance(key, str) for key in credentials)
            and isinstance(outputs, list)
            and all(
                isinstance(out, dict)
                and isinstance(out.get("destination"), str)
                and isinstance(out.get("persist"), bool)
                and isinstance(out.get("dependents"), list)
                for out in outputs
            )
        )
    except (OSError, ValueError, KeyError, TypeError):
        valid = False
    if not valid:
        say(f"{SECRETS_JSON} is unusable")
        return None
    return credentials, outputs


def output_exists(out: dict) -> bool:
    return ((PERSIST_DIR if out["persist"] else RUN_DIR) / out["destination"]).is_file()


def missing_outputs(unit: str, outputs: list[dict]) -> list[str]:
    """The destinations of the outputs that list `unit` as a dependent and do not exist."""
    return [
        out["destination"]
        for out in outputs
        if unit in out["dependents"] and not output_exists(out)
    ]


def secrets_ready(credentials: list[str], outputs: list[dict]) -> bool:
    """True when homelab-secrets is active and every credential and output exists."""
    return (
        is_active(SECRETS_UNIT)
        and all((CREDSTORE / key).is_file() for key in credentials)
        and all(map(output_exists, outputs))
    )


def bring_up(unit: str, verb: str, outputs: list[dict], queued: set[str]) -> bool:
    """One `reset-failed` and one blocking `start` or `restart` of `unit`, behind the existence gate.

    A unit the gate skips, or whose call fails, joins pending.json, and the result is False.
    A call that succeeds removes the unit from pending.json.
    """
    missing = missing_outputs(unit, outputs)
    if missing:
        say(f"{verb} {unit} skipped: {', '.join(missing)} does not exist yet")
        update_pending({unit}, set())
        return False
    systemctl(
        "reset-failed", unit
    )  # clears the start limit; harmless on a unit that is not failed
    if systemctl(verb, unit).returncode != 0:
        say(f"{verb} {unit} failed")
        update_pending({unit}, set())
        return False
    say(f"{verb} {unit}")
    return update_pending(set(), {unit}) if unit in queued else True


# The run.


def act(manifest: dict, prev: dict) -> tuple[bool, dict]:
    """Steps 1 to 5. Return whether every step succeeded, and the advanced per-entry state."""
    ok = True
    raw_units = prev.get("units")
    prev_units: dict = raw_units if isinstance(raw_units, dict) else {}
    prev_links = set(prev.get("enable_links") or [])
    units: dict = manifest["units"]
    links = set(manifest["enable_links"])
    units_state: dict = {}
    links_state = set(links)
    digest = manifest.get("secrets_inputs_sha256")
    manual = ALWAYS_MANUAL | ({SECRETS_UNIT} if digest else set())
    secrets = read_secrets_manifest() if digest else None
    credentials, outputs = secrets or ([], [])
    if digest and secrets is None:
        ok = False
    try:
        if not RUN_DIR.is_dir():
            RUN_DIR.mkdir(parents=True, exist_ok=True)
            RUN_DIR.chmod(0o755)  # whatever the umask; homelab-secrets corrects an older one
    except OSError as exc:
        say(f"cannot create {RUN_DIR}: {exc}")

    # Step 1: stop what the manifest dropped, and every homelab unit whose file has gone.
    dropped = {u for u in set(prev_units) - set(units) if is_homelab(u)}
    unlinked = {u for u in prev_links - links if is_homelab(u) and u.endswith(".timer")}
    stopping = dropped | unlinked | not_found_homelab_units()
    for unit in sorted(stopping):
        if stop(unit):
            continue
        ok = False
        if unit in prev_units and unit not in units:
            units_state[unit] = prev_units[unit]
        if unit in unlinked:
            links_state.add(unit)

    # Step 1b: in a package that ships `secrets-unit`, run homelab-secrets when its inputs, its
    # unit file or its activity says the outputs may be stale. A failed run does not stop the rest.
    secrets_state, secrets_ran = None, True
    if digest:
        stale = (
            digest != prev.get("secrets_inputs_sha256")
            or (
                SECRETS_UNIT in units
                and unit_hash(SECRETS_UNIT) != prev_units.get(SECRETS_UNIT)
            )
            or not is_active(SECRETS_UNIT)
        )
        if stale and systemctl("restart", SECRETS_UNIT).returncode != 0:
            say(
                f"restart {SECRETS_UNIT} failed; carrying on with the outputs that exist"
            )
            secrets_ran = ok = False
        elif stale:
            say(f"restart {SECRETS_UNIT}")
        secrets_state = digest if secrets_ran else prev.get("secrets_inputs_sha256")

    # Step 1c: the users and lines arms, so a unit that runs as a new user starts, and step 3b
    # activates the files the lines arm edited.
    drift, arms = {"legacy": 0}, {}
    ok = run_arms(EARLY, manifest, prev, arms, drift) and ok

    # The restart set, built before step 2: the units whose file or drop-in changed, and the
    # units in pending.json, each only when it is enabled or active. A foreign unit the manifest
    # dropped is walked once more, because its drop-in has gone.
    foreign_dropped = {u for u in prev_units if u not in units and not is_homelab(u)}
    hashes = {}
    changed = set()
    for unit in sorted((set(units) | foreign_dropped) - dropped):
        hashes[unit] = unit_hash(unit), prev_units.get(unit)
        if hashes[unit][0] != hashes[unit][1] and not left_alone(
            unit, units, links, manual
        ):
            changed.add(unit)
    queued = read_pending()
    idle = {unit for unit in queued - changed if left_alone(unit, units, links, manual)}
    if idle:
        say(f"dropping {', '.join(sorted(idle))} from the queue: nothing to restart")
        ok = update_pending(set(), idle) and ok
    restart_set = sorted(changed | (queued - idle))

    # Step 2: start every enabled unit outside the set that is not active, never a masked or a
    # windowed one.
    for unit in sorted(links - set(restart_set)):
        if units.get(unit, {}).get("policy") == "windowed":
            continue
        if is_active(unit) or load_state(unit) == "masked":
            continue
        ok = bring_up(unit, "start", outputs, queued) and ok

    # Step 3: restart the set. A failed or skipped unit keeps its old hash, so it stays changed.
    failed = {u for u in restart_set if not bring_up(u, "restart", outputs, queued)}
    ok = ok and not failed

    # Step 3b: the `activate:` action of each packaged file whose hash changed. A unit step 3
    # called already gets no second call.
    raw_files, raw_pending = prev.get("files"), prev.get("pending")
    pending = activate.refresh_pending(
        raw_pending if isinstance(raw_pending, dict) else {}, manifest["activations"]
    )
    activated, files_state = activate.activate(
        manifest["activations"],
        raw_files if isinstance(raw_files, dict) else {},
        units,
        {unit: unit not in failed for unit in restart_set},
        pending,
    )
    ok = ok and activated
    if not secrets_ran:
        failed.add(SECRETS_UNIT)
    for unit, (new, old) in hashes.items():
        keep = unit in units
        if unit in failed:
            new, keep = old, True
        if keep:
            units_state[unit] = new

    # Step 4: retire the legacy entries not yet retired. A package that ships `secrets-unit`
    # retires none until every credential and output exists and homelab-secrets is active.
    prev_retired = set(prev.get("retired") or [])
    retired = []
    waiting = None
    removed, handed = False, set()
    for entry in manifest["legacy"]:
        key = legacy_key(entry)
        if key not in prev_retired and digest and waiting is None:
            waiting = not (secrets and secrets_ready(credentials, outputs))
        shadow = shadow_path(entry, units)
        # An Ansible-era copy under /etc shadows the packaged unit of the same name: remove it
        # (one daemon-reload and the restarts follow the loop). With no packaged unit of that
        # name, the file is the only copy, so it stays and counts as drift.
        if shadow and key not in prev_retired and not waiting:
            if shadow.name not in units:
                drift["legacy"] += 1
                say(f"keeping {shadow}: the package ships no unit of that name")
            elif (result := hand_off(shadow)) is None:
                ok = False
            else:
                retired.append(key)
                removed |= result[0]
                if result[1]:
                    handed.add(shadow.name)
            continue
        # A running service is never stopped to retire it: the entry stays and counts as drift.
        if key not in prev_retired and not waiting and running_service(entry):
            drift["legacy"] += 1
            say(f"keeping {key}: the service is running, so it retires once it is not")
        elif key in prev_retired or (not waiting and retire(entry)):
            retired.append(key)
        else:
            if waiting:
                say(f"keeping {key}: the secrets do not all exist yet")
            ok = False

    # Step 4b: one daemon-reload after every shadow removal, then each packaged unit whose
    # fragment changed, in the order step 3 uses.
    if removed and systemctl("daemon-reload").returncode != 0:
        say("daemon-reload failed after removing a shadowing copy")
        ok = False
    for unit in sorted(handed):
        if not left_alone(unit, units, links, manual):
            ok = bring_up(unit, "restart", outputs, queued) and ok

    # Step 5: the per-kind reconcilers. The manifest's other kinds are ones this version lacks.
    for name in manifest["reconcilers"]:
        say(f"the manifest lists reconciler {name!r}, which this version does not have")
        ok = False
    ok = run_arms([name for name in ARMS if name not in EARLY], manifest, prev, arms, drift) and ok
    udev_ok, udev_state = udev.reconcile(prev.get("udev"))
    ok = ok and udev_ok
    if udev_state:
        arms["udev"] = udev_state

    state = {
        "units": units_state,
        "enable_links": sorted(links_state),
        "retired": sorted(retired),
        "files": files_state,
        "pending": pending,
        "drift": drift,
        **arms,
    }
    if secrets_state:
        state["secrets_inputs_sha256"] = secrets_state
    return ok, state


def run_arms(names: list, manifest: dict, prev: dict, arms: dict, drift: dict) -> bool:
    """Run the named arms. Each record goes in `arms`, and each drift count in `drift`."""
    ok = True
    for name in names:
        before = prev.get(name)
        arm_ok, record, count = ARMS[name].reconcile(
            manifest["arms"][name], before if isinstance(before, dict) else None
        )
        ok = ok and arm_ok
        if record is not None:
            arms[name], drift[name] = record, count
    return ok


def running_service(entry: dict) -> bool:
    """True for a legacy entry that names a service systemd is running or starting."""
    unit = entry.get("unit", "")
    return (
        unit.endswith(".service")
        and systemctl("is-active", unit).stdout.strip() in activate.RUNNING
    )


def left_alone(unit: str, units: dict, links: set[str], manual: set[str]) -> bool:
    """True when reconcile takes the unit's new file, or its queue entry, without acting."""
    policy = units.get(unit, {}).get("policy")
    if unit in manual or policy in POLICIES:
        return True
    # A masked unit may still have an enable link, so this comes before the next test.
    if load_state(unit) == "masked":
        return True
    if is_homelab(unit):
        enabled = unit in links
    else:
        enabled = systemctl("is-enabled", unit).stdout.strip() == "enabled"
    return not (enabled or is_active(unit))


def write_applied(state: dict) -> None:
    """Step 6: write applied.json atomically."""
    APPLIED.parent.mkdir(parents=True, exist_ok=True)
    tmp = APPLIED.with_name(f".{APPLIED.name}.{os.getpid()}")
    tmp.write_text(json.dumps(state, indent=1, sort_keys=True) + "\n")
    os.replace(tmp, APPLIED)


def main() -> int:
    host = run("hostname").stdout.strip()
    packages = ["homelab-updater", f"homelab-{host}"]
    text, prev, installed = read_under_lock(packages)
    versions = {name: version for name, (_, version) in installed.items()}

    kept = (
        "units",
        "enable_links",
        "retired",
        "secrets_inputs_sha256",
        "files",
        "pending",
        "drift",
        "libvirt",
        "udev",
        "ufw",
        "users",
    )
    state = {k: prev[k] for k in kept if k in prev}
    broken = [name for name, (status, _) in installed.items() if status != "ii "]
    if broken:
        say(f"{', '.join(broken)} is not installed as 'ii '; acting on nothing")
        ok = False
    else:
        try:
            if text is None:
                raise ManifestError(f"{MANIFEST} does not exist")
            manifest = parse_manifest(text)
        except ManifestError as exc:
            say(f"{exc}; acting on nothing")
            ok = False
        else:
            ok, state = act(manifest, prev)

    result = {"versions": versions, "ok": ok, "finished": int(time.time())}
    state["result"] = result
    last_ok = result if ok else prev.get("last_ok")
    if isinstance(last_ok, dict):
        state["last_ok"] = last_ok
    write_applied(state)
    textfile.write(host, state)
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
