26.04-amd64 sha256:fb2d94685a88e79097ffd1efff42ccb886e637399c9f333c7bb2bfbc4cd1ba5e
26.04-arm64 sha256:b19a3b9867118bd1c228f0a52795e17e58a0e35eb04f8591b60e729fd367fcbb
