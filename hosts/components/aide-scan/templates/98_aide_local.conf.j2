# Local AIDE exclusions for Docker homelab.
# Named 98_* so it loads before 99_aide_root's "/ Full" catch-all, and deployed WITHOUT a dot:
# aide.conf only includes conf.d names matching ^[a-zA-Z0-9_-]+$
# (hosts/components/aide-scan/component.yml).
# AIDE uses first-match-wins, so these exclusions take precedence.

# Docker image layers and overlay2 filesystem — change on every pull/deploy
!/var/lib/docker/

# Container application data — media, downloads, app databases (high-churn)
!/home/{{ sys_user }}/server/containers/data/

# k3s workload data churns constantly; k3s binaries, certificates and /etc/rancher stay checked.
!/var/lib/longhorn/
# containerd image layers and container snapshots
!/var/lib/rancher/k3s/agent/containerd/
# Mounted container root filesystems sit under runtime state, so the snapshot exclusion misses them.
!/run/k3s/
!/run/containerd/
# Network namespace handles, one per pod: nsfs mounts, not files
!/run/netns/
# The embedded etcd's data and its local snapshots
!/var/lib/rancher/k3s/server/db/
# Pod volumes: emptyDirs and projected Secrets and ConfigMaps
!/var/lib/kubelet/pods/
# CSI mounts hold live application data; kubelet state files rewrite on every pod change.
!/var/lib/kubelet/plugins/
!/var/lib/kubelet/[a-z_]+_state$
# Container logs
!/var/log/pods/
!/var/log/containers/

# Claude Code worktrees: each is a full checkout of this repo with its own .venv, created and
# removed by agent sessions every day. Dozens of them hold millions of inodes, enough to keep the
# weekly check from finishing. The primary checkout beside them stays checked. The service users
# (claude, renovate-agent, homelab-builder) have their homes under /var/lib, so every home rule
# below matches both roots.
!/(home|var/lib)/[^/]+/server/\.claude/worktrees/

# ~/.local/share stays checked: the uv-managed Pythons, uv tools and node versions there are
# executables.
!/(home|var/lib)/[^/]+/\.cache/
!/(home|var/lib)/[^/]+/\.kube/cache/
!/(home|var/lib)/[^/]+/\.npm/
!/(home|var/lib)/[^/]+/\.local/state/
!/var/lib/homelab-builder/uv-cache/

# The Full rule on a media library makes baselines far slower; video files carry nothing to protect.
!/srv/media/
# Swap files: rewritten by the kernel continuously, 8 GB each on the cluster nodes.
!/swap\.img$
!/swapfile$

# vfat inode numbers are invented at each inode load, so every vfat path gets Full-i, the rule
# 31_aide_grub-efi gives Debian's EFI/debian.
/boot/efi/EFI/(ubuntu|BOOT)$ d Full-i
/boot/efi/EFI/(ubuntu|BOOT)/[^/]+$ f Full-i
# Its files page on an inode change alone.
/boot/firmware(/|$) Full-i

# Virtual/pseudo filesystems — not real files, cause inflated read counts
!/proc/
!/sys/
