#!/usr/bin/env bash
# Weekly AIDE file-integrity check — rendered by the initial_setup role, or by the aide-scan
# host component on a host whose package owns it; edits overwritten.
#
# Usage: aide-check.sh [-h|--help] [--accept]
# With no arguments: cron job "Weekly AIDE file integrity check", or homelab-aide-check.timer on
# a packaged host, runs it as root, Monday 03:00. It runs `aide --update` against
# /var/lib/aide/aide.db at idle CPU and IO priority, writes the report to the journal under the
# `aide` tag, classifies every difference (below), writes the verdict to the node_exporter
# textfile as check `aide-check`, where AideCheckFailed and AideCheckNotReporting read it. Running
# it by hand is safe, but it takes as long as the scheduled run and it rewrites the textfile.
#
# --accept: after a human has reviewed a DOWN run's unexplained changes, moves that run's
# aide.db.new over aide.db, so the next run reports against the accepted state. It scans nothing
# and writes no verdict; the alert clears on the next run.
#
# WHY A SCRIPT (#4594). The cron used to pipe `aide --check` straight into `logger -t aide`. The
# pipeline's exit status was logger's, and nothing read the tag, so every host exited
# `ERROR: missing configuration` for weeks and nobody saw it (#4591). This script keeps AIDE's
# own exit code and reports it: an exit that is not a result pushes DOWN, and a run that never
# happens trips the monitor's deadline.
#
# AIDE's exit code is a bitmask when the check completes: 0 means no differences, and 1, 2 and 4
# mean entries were added, removed or changed, so 1-7 is a completed check that found something.
# `--update` uses the same codes as `--check`. 14 and up are AIDE's error codes (a write error,
# an invalid argument, a bad config line, an IO error), and 127 means the binary is gone.
# Anything outside 0-7 is treated as an error rather than enumerated, so a code AIDE adds later
# still reads DOWN.
#
# WHAT PAGES (#4599). A completed run pushes DOWN when a difference falls in a paged tree and no
# package explains it:
# - The system trees (/usr except /usr/local, /bin, /sbin, /lib*, /boot): any added or changed
#   file a package does not own with this content, and any removed path a package still owns.
#   The files package triggers regenerate, such as the initrd and the module index, are listed in
#   DERIVED. Each is explained only by a dpkg.log entry since the baseline for a package that
#   writes that kind of file (a kernel package for the initrd, a GRUB or kernel package for
#   grub.cfg, the package that owns the source for a .pyc). The top-level usr-merge links
#   (/bin and the rest) are judged on their target alone. A package-owned symlink must still
#   resolve to a package file, with two exceptions: a `homelab-*` package's link (outside
#   PERSIST) at a tmpfs output its secrets manifest declares, pointing at that output in
#   /run/homelab-secrets/, and a link into a system tree whose target is missing, such as the
#   kernel headers' rust link to a package that is not installed, in a window its owner ran.
# - /etc: a package-owned path whose content differs from the package's copy, or that is gone.
#   Ansible writes unpackaged /etc files on every merge, so those are logged, not paged.
# - The login, privilege, startup and code-loading files in PERSIST, owned or not: sudoers, sshd,
#   PAM, cron, the user and group databases, the loader and module config, shell startup files,
#   apt hooks, sources and keys, udev rules, systemd units and drop-ins, rc.local, init scripts,
#   MOTD scripts, /usr/local/sbin and every authorized_keys. The units the k3s installer and
#   snapd write are listed in ROLE_WRITTEN and are judged only when a package owns them.
#   snapd's udev rules are explained only beside a new revision of their snap, and only while
#   every key in them only matches, sets ENV or jumps (SNAPD_UDEV).
# - An added or changed /usr/local/bin entry named like a command a package installs, because
#   root's PATH reaches /usr/local/bin first. The roles' own scripts there have no such twin.
# - Any of the above, or any package-owned /etc path, whose owner, group or permissions changed,
#   since a package digest cannot see that. Outside PERSIST, an install or upgrade of a package
#   that owns it in the window explains it, but a homelab package's only under /etc, because
#   those upgrade several times a day. Its content is then judged as for any other change.
# A symlink is explained when it resolves to a package-owned path (alternatives, systemd enable
# links, /boot/vmlinuz), to a unit in ROLE_WRITTEN, or to /dev/null (a mask), or is one of the
# two exceptions above. Homes, /var, /opt
# and the rest of /usr/local are logged and never page: the 2026-10-20 daniel-box report held 184
# differences in six hours, and every one was in them.
set -uo pipefail

MODE=check
for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
    --accept) MODE=accept ;;
  esac
done

# shellcheck source=/dev/null
source {{ aide_scan_host_lib_dir }}/homelab-check-lib.sh || {
  logger -t aide-check "homelab-check-lib.sh missing — install the host package"
  exit 1
}

# The longest legitimate gap between two textfile writes: the timer runs weekly (Monday 03:00,
# hosts/components/aide-scan/units/homelab-aide-check.timer), 604800s, and the extra 6h
# is the slack for a run that takes longer than the last. The deleted Uptime Kuma tile kept the
# same 626400. Move it with the timer (#6168).
# ansible/tests/setup/test_integrity_scan_rule_literals.py pins the rules' literals to it.
DEADLINE_S=626400

# The report goes to the journal one line per entry. A baseline that predates months of package
# upgrades reports every file they touched, which can run to thousands of lines. Past this many
# the rest is dropped with a line saying so, rather than left for journald's rate limit to drop
# without a trace.
REPORT_MAX_LINES=2000

# database_in and database_out in Debian's /etc/aide/aide.conf.
AIDE_DIR=/var/lib/aide
# Read for the package file lists (info/*.list), their digests (info/*.md5sums), the conffile
# digests (status), which *.md5sums leaves out, and the diversions.
DPKG_DIR=/var/lib/dpkg
# Prefixed to a report path before the file is read; empty everywhere but the tests.
FS_ROOT=""
# homelab-secrets' manifest, read under FS_ROOT for the outputs the host package links.
SECRETS_MANIFEST=/usr/lib/homelab/secrets.json

# Regexes over the absolute path, in awk's dialect. Kept to what mawk accepts: no intervals. They reach
# awk through ENVIRON, because -v would read each backslash as an escape.
# Login, privilege, startup and code-loading files that nothing here writes in an ordinary week:
# between 2026-10-19 and 2026-11-02, daniel-box and daniel-server changed none of the first group
# outside a package except through the claude-user migration. The second group is where an
# unpackaged unit, apt source or key, MOTD script or PATH-first binary would take effect; the
# files the roles write there are ROLE_WRITTEN's, and /usr/local/bin is judged by name below.
PERSIST='^/(etc/(sudoers$|sudoers\.d/|ssh/|pam\.d/|pam\.conf$|security/|ld\.so\.preload$|ld\.so\.conf$|ld\.so\.conf\.d/|crontab$|cron\.[a-z]+/|passwd$|shadow$|group$|gshadow$|environment$|profile$|profile\.d/|bash\.bashrc$|apt/apt\.conf\.d/|udev/rules\.d/|modprobe\.d/|modules-load\.d/|modules$|systemd/system/|apt/(sources\.list\.d/|trusted\.gpg\.d/|keyrings/)|update-motd\.d/|rc\.local$|init\.d/)|usr/local/sbin/|var/spool/cron/|root/\.(bashrc|profile|bash_profile)$|root/\.ssh/authorized_keys|home/[^/]+/\.ssh/authorized_keys|var/lib/[^/]+/\.ssh/authorized_keys)'
SYSTEM='^/(usr|bin|sbin|lib|lib32|lib64|libx32|boot)(/|$)'
# Unpackaged files under PERSIST that this repo's own tooling writes, so a deploy does not page.
# Each is judged only while no package owns it. A symlink to one (a `systemctl enable` link) is
# explained too. The names are the k3s installer's units and snapd's mounts; the host packages
# install their own units under /usr/lib/systemd/system, which a package owns.
# ansible/tests/setup/test_aide_check_role_written.py holds the installer names to this list.
ROLE_WRITTEN='^/etc/systemd/system/(k3s(-agent)?\.service(\.env)?|snap-[a-z0-9-]+-[0-9]+\.mount)$'
# DECIDED: snapd's generated udev rules are not ROLE_WRITTEN (#7929). A udev rule runs as root
# on device events, so the name alone explains nothing. One is explained only while no package
# owns it, it is a regular file, the same report adds a mount unit for a new revision of that
# snap, and snapd_rule_verdict reads every key in it as inert. On daniel-server on 2026-11-11,
# 70-snap.snapd.rules held snapd's 836-line copy of the ModemManager and oFono rules: match keys,
# ENV, GOTO and LABEL only. It changed on 2026-11-06 07:02 beside snap-snapd-28332.mount.
# A rule an edit or a connected interface changes outside a refresh still pages.
SNAPD_UDEV='^/etc/udev/rules\.d/70-snap\.[a-z0-9_-]+\.rules$'
SNAPD_MOUNT='^/etc/systemd/system/snap-[a-z0-9-]+-[0-9]+\.mount$'
# snapd's own helper and its snap_* tags, which put a device in a snap's cgroup. They are removed
# before the keys are judged.
SNAPD_UDEV_OWN='RUN\+="/usr/lib/snapd/snap-device-helper [^"]*"|TAG\+="snap_[a-z0-9_-]+"'
# DECIDED: /usr/local/bin pages on a name a package also installs, not on every unpackaged entry
# the way /usr/local/sbin does. Root's PATH reaches /usr/local/bin before /usr/bin, so a twin of a
# packaged command replaces it for root. A list of the legitimate names would have to cover
# pip installs, k3s's links, hand-installed tools and the roles' scripts: daniel-server held 30
# unpackaged entries on 2026-11-02, of which one (jsonschema, from pip) had a packaged twin. That
# one pages whenever it changes. A new entry with a unique name does not page; a unit, cron entry
# or profile script that would run it does.
LOCAL_BIN='^/usr/local/bin/'
# Written by package triggers and maintainer scripts, so no package lists them. Taken from every
# unpackaged file in the system trees on all three hosts on 2026-11-02, so a trigger that ran
# outside the measured fortnight is listed too. Each class below is explained by dpkg.log entries
# for the packages named beside it, not by dpkg having run at all.
# The top-level usr-merge links are maintainer-script output; only their target is judged.
USRMERGE='^/(bin|sbin|lib|lib32|lib64|libx32)$'
# The initrd, the kernel links and the module index: kernel, initramfs-tools or kmod runs.
BOOT_LINKS='^/boot/(initrd\.img|vmlinuz)(\.old)?$'
BOOT_LINK_TARGET='^/boot/(initrd\.img|vmlinuz)-[^/]+$'
DERIVED_KERNEL='^/boot/(initrd\.img|vmlinuz)(\.old)?$|^/boot/initrd\.img-|^/(usr/)?lib/modules/[^/]+/modules\.'
PKGS_KERNEL='^(linux-(image|modules|generic|raspi|firmware|base)|initramfs-tools|kmod$|flash-kernel|u-boot)'
# grub.cfg and GRUB's modules: update-grub runs from GRUB's and the kernel packages' scripts.
DERIVED_GRUB='^/boot/grub/'
PKGS_GRUB='^(grub|os-prober|shim|linux-(image|modules|generic|raspi)|initramfs-tools)'
# The EFI loaders: grub-install, from the grub-efi and shim packages' scripts. 98_aide_local
# skips their inode, which vfat renumbers at every mount.
DERIVED_EFI='^/boot/efi/EFI/'
PKGS_EFI='^(grub-efi|shim)'
# DECIDED: /boot/grub/grubenv is exempt from the dpkg.log requirement. GRUB rewrites it at every
# boot, and the weekly reboot made it differ every week with no package run: on daniel-box its
# mtime was 2026-11-01 07:38, the weekly reboot, and the dpkg log held no GRUB or kernel entry then.
# Only the exact path is exempt, and only as a regular file; the rest of /boot/grub/ is not.
BOOT_ENV='^/boot/grub/grubenv$'
# The Pi's firmware partition and device trees: flash-kernel and the Pi kernel packages.
DERIVED_FIRMWARE='^/boot/(firmware/|dtbs?(/|-|$))'
PKGS_FIRMWARE='^(flash-kernel|linux-(image|modules|raspi|firmware|base)|u-boot|raspi|rpi)'
# Compiled Python: the package that owns the source, or an interpreter upgrade, recompiles it.
DERIVED_PYCACHE='/__pycache__/'
# The interpreter packages only: a library such as python3-jwt compiles its own files.
PKGS_PYTHON='^(python[3](\.[0-9]+)?(-minimal)?|libpython[3](\.[0-9]+)?(-minimal|-stdlib)?)$'
# Caches that any package's trigger rewrites: explained by any package run since the baseline.
DERIVED_CACHES='/dropin\.cache$|^/(usr/)?lib/udev/hwdb\.bin$|^/(usr/)?lib/locale/locale-archive$|^/(usr/)?lib/[^/]+/gio/modules/giomodule\.cache$|^/(usr/)?lib/[^/]+/gdk-pixbuf-2\.0/[^/]+/loaders\.cache$|^/(usr/)?lib/[^/]+/gtk-[23]\.0/[^/]+/immodules\.cache$|^/usr/share/glib-2\.0/schemas/gschemas\.compiled$|^/usr/share/mime/|^/usr/share/icons/[^/]+/icon-theme\.cache$|^/usr/share/info/dir(\.old)?$|^/usr/share/plymouth/themes/(text\.plymouth|ubuntu-text/ubuntu-text\.plymouth)$'
DERIVED="(${USRMERGE}|${DERIVED_KERNEL}|${DERIVED_GRUB}|${DERIVED_EFI}|${DERIVED_FIRMWARE}|${DERIVED_PYCACHE}|${DERIVED_CACHES})"
# dpkg.log timestamps are local time. The window opens this long before aide.db was written,
# because the previous scan wrote it at its end and a package run during that scan is in neither
# its baseline nor the window otherwise. The deadline's own slack is the same 6h.
WINDOW_SLACK_S=21600
DPKG_LOG=/var/log/dpkg.log
# How many unexplained paths the verdict's message names; the journal lists them all.
MSG_PATHS=3
UNEXPLAINED_MAX_LINES=500

# Logs the verdict, then writes the textfile the host-checks rules read. The log line is
# unconditional, so a DOWN leaves a durable record in syslog and Loki beside the textfile. NOTICE
# rather than INFO — journald here caps MaxLevelStore=notice, so an info line is dropped from the
# journal and from forwarding.
report() {
  logger -p daemon.notice -t aide-check "status=${STATUS} ${MSG}"
  write_check_textfile aide-check "$([[ "$STATUS" == up ]] && echo 1 || echo 0)" "$(date +%s)" "$DEADLINE_S" \
    || logger -t aide-check "textfile write failed (status=${STATUS})"
}

# Moves aide.db.new over aide.db. Refuses when aide.db is missing, so a deleted baseline stays an
# error exit instead of becoming a fresh, trusted one (#6674); bootstrap-host.sh owns the first.
advance_baseline() {
  [[ -e "$AIDE_DIR/aide.db" && -s "$AIDE_DIR/aide.db.new" ]] || return 1
  mv -f "$AIDE_DIR/aide.db.new" "$AIDE_DIR/aide.db"
}

# One scan at a time. A scan that outlives its week would otherwise have the next Monday's start a
# second full scan beside it. The run that finds the lock held pushes DOWN, which also turns a scan
# that never ends into a page a week after it started (#5785). --accept takes it too, so it cannot
# move a database a running scan is writing.
LOCK_FILE=/run/lock/aide-check.lock
exec 8>"$LOCK_FILE"
if ! flock -n 8; then
  if [[ "$MODE" == accept ]]; then
    echo "an aide-check run holds ${LOCK_FILE}; accept after it finishes" >&2
    exit 1
  fi
  STATUS=down
  MSG="the previous aide-check run still holds ${LOCK_FILE}, so this week's check did not start; ps -C aide shows how long it has run"
  report
  exit 1
fi

if [[ "$MODE" == accept ]]; then
  if ! advance_baseline; then
    echo "nothing to accept: needs both ${AIDE_DIR}/aide.db and a non-empty ${AIDE_DIR}/aide.db.new from the last run" >&2
    exit 1
  fi
  logger -p daemon.notice -t aide-check "baseline accepted by hand; the next run reports against it"
  echo "accepted ${AIDE_DIR}/aide.db.new as the baseline; the alert clears on the next run"
  exit 0
fi

# Prints "path<TAB>-<TAB>package" for every path a package lists, "path<TAB>digest" for every
# digest dpkg records, "from<TAB>DIVERT<TAB>to" for each diversion, and
# "EVENT<TAB>EVENT<TAB>package<TAB>action" for each package dpkg.log shows installed, upgraded,
# configured, triggered, removed or purged since the window opened. A third-party md5sums file such as gh's writes each path as ./usr/...
# dpkg.log rotates monthly and the previous month's file stays uncompressed, so both are read.
# An unreadable log yields no event, which leaves every regenerated file unexplained.
dpkg_index() {
  awk 'FNR == 1 { n = FILENAME; sub(/.*\//, "", n); sub(/\.list$/, "", n); sub(/:.*/, "", n) }
       { print $0 "\t-\t" n }' "$DPKG_DIR"/info/*.list 2>/dev/null
  cat "$DPKG_DIR"/info/*.md5sums 2>/dev/null \
    | awk '{ d = $1; p = $0; sub(/^[0-9a-f]+ +(\.\/)?/, "/", p); print p "\t" d }'
  awk '/^Conffiles:/ { c = 1; next } /^[^ ]/ { c = 0 } c && NF >= 2 { print $1 "\t" $2 }' \
    "$DPKG_DIR/status" 2>/dev/null
  # Three lines per diversion: the diverted path, where it went, the package that diverted it.
  awk 'NR % 3 == 1 { from = $0 } NR % 3 == 2 { print from "\tDIVERT\t" $0 }' \
    "$DPKG_DIR/diversions" 2>/dev/null
  [[ -n "$WINDOW_FROM" ]] || return 0
  cat "$DPKG_LOG.1" "$DPKG_LOG" 2>/dev/null \
    | awk -v from="$WINDOW_FROM" '
      ($1 " " $2) >= from && $3 ~ /^(install|upgrade|configure|trigproc|remove|purge)$/ {
        p = $4; sub(/:.*/, "", p); print "EVENT\tEVENT\t" p "\t" $3 }'
}

# Prints "kind<TAB>type<TAB>pug<TAB>scope<TAB>path" for each report entry in a paged tree.
# AIDE's summary column is 18 characters, YlZbpugamcinHAXSEC, so p, u and g are columns 5-7;
# an added entry's is the file type then all `+`, a removed one's all `-`.
paged_entries() {
  printf '%s\n' "$REPORT" \
    | PERSIST="$PERSIST" SYSTEM="$SYSTEM" DERIVED="$DERIVED" LOCAL_BIN="$LOCAL_BIN" awk '
    substr($0, 19, 3) == ": /" && $0 !~ /^[ \t]/ {
      s = substr($0, 1, 18); path = substr($0, 21); rest = substr(s, 2)
      kind = (rest ~ /^\++$/) ? "added" : (rest ~ /^-+$/) ? "removed" : "changed"
      if (path ~ ENVIRON["PERSIST"]) scope = "persist"
      else if (path ~ ENVIRON["LOCAL_BIN"]) scope = "shadow"
      else if (path ~ /^\/usr\/local(\/|$)/) next
      else if (path ~ ENVIRON["SYSTEM"]) scope = (path ~ ENVIRON["DERIVED"]) ? "derived" : "system"
      else if (path ~ /^\/etc\//) scope = "etc"
      else next
      pug = (kind == "changed" && substr(s, 5, 3) ~ /[pug]/) ? "pug" : "-"
      print kind "\t" substr(s, 1, 1) "\t" pug "\t" scope "\t" path
    }'
}

# Prints " name " for each snap whose new revision's mount unit the report adds: snapd refreshed
# or installed it since the baseline.
snaps_revised() {
  paged_entries | SNAPD_MOUNT="$SNAPD_MOUNT" awk -F '\t' '
    $1 == "added" && $5 ~ ENVIRON["SNAPD_MOUNT"] {
      n = $5; sub(/^\/etc\/systemd\/system\/snap-/, "", n); sub(/-[0-9]+\.mount$/, "", n)
      printf " %s ", n
    }'
}

# Prints "inert" when every key in the udev rules file $1 only matches, sets ENV or jumps, and
# "active" otherwise. An allowlist, because udev runs a program for PROGRAM== and IMPORT== as
# well as for RUN+=, and writes sysfs and sysctls for ATTR= and SYSCTL=. A file awk cannot read
# prints nothing, which the caller judges as active.
snapd_rule_verdict() {
  SNAPD_UDEV_OWN="$SNAPD_UDEV_OWN" awk '
    function allowed(key, arg, op) {
      if (op == "==" || op == "!=") return key ~ /^(ACTION|DEVPATH|KERNELS?|SUBSYSTEMS?|DRIVERS?|ATTRS?|ENV|TAGS?|CONST)$/
      if (key == "GOTO" || key == "LABEL") return op == "="
      return key == "ENV" && arg !~ /^SYSTEMD_/
    }
    function judge(s,    q, t, key, arg, op) {
      if (s ~ /\\/) return 0
      gsub(ENVIRON["SNAPD_UDEV_OWN"], "", s)
      q = s
      if (gsub(/"/, "", q) % 2) return 0
      gsub(/"[^"]*"/, "\"\"", s)
      while (match(s, /[A-Za-z_.]+(\{[^}]*\})?[ \t]*[=!+:-]?=/)) {
        t = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
        key = t; sub(/[^A-Za-z_.].*$/, "", key)
        arg = ""; if (match(t, /\{[^}]*\}/)) arg = substr(t, RSTART + 1, RLENGTH - 2)
        op = t; sub(/^.*[^=!+:-]/, "", op)
        if (!allowed(key, arg, op)) return 0
      }
      return 1
    }
    # udev skips a comment line before it handles a continuation, so a comment never continues.
    /^[ \t]*#/ { next }
    # udev joins a line that ends in a backslash to the next.
    /\\$/ { line = line substr($0, 1, length($0) - 1); next }
    { line = line $0 }
    line !~ /^[ \t]*$/ && !judge(line) { bad = 1 }
    { line = "" }
    END { print (bad ? "active" : "inert") }' "$1"
}

# Prints the absolute path of each tmpfs output the host package's secrets manifest declares, one
# per line, or nothing when the manifest is missing or unreadable, so every such link pages.
secret_links() {
  jq -r '.outputs[] | select(.persist != true) | "/" + .destination' \
    "$FS_ROOT$SECRETS_MANIFEST" 2>/dev/null | tr '\n' ' '
}

# Prints "path (reason)" for each paged entry no package explains. Reads the files as they are
# now: AIDE has just hashed them, and a change in between is next week's report.
unexplained_entries() {
  local kind type pug scope path digest target dangling rule
  paged_entries | while IFS=$'\t' read -r kind type pug scope path; do
    digest=- target=- dangling=- rule=-
    if [[ "$kind" != removed ]]; then
      if [[ -L "$FS_ROOT$path" ]]; then
        # -m, not -f: a link into a directory that is missing still has a target to judge, and
        # "-" would read as "not a link". A link that cannot be resolved at all is "?".
        target=$(readlink -m -- "$FS_ROOT$path") && target=${target#"$FS_ROOT"} || target="?"
        [[ "$target" == "?" || -e "$FS_ROOT$target" ]] || dangling=dangling
      elif [[ -f "$FS_ROOT$path" ]]; then
        digest=$(md5sum <"$FS_ROOT$path" | awk '{ print $1 }') || digest=-
        if [[ "$path" =~ $SNAPD_UDEV ]]; then
          rule=$(snapd_rule_verdict "$FS_ROOT$path") || rule=active
        fi
      fi
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$kind" "$type" "$pug" "$scope" "$path" "$digest" "$target" "$dangling" "$rule"
  done | SNAPS_REVISED="$(snaps_revised)" SNAPD_UDEV="$SNAPD_UDEV" \
    ROLE_WRITTEN="$ROLE_WRITTEN" USRMERGE="$USRMERGE" BOOT_LINKS="$BOOT_LINKS" \
    BOOT_LINK_TARGET="$BOOT_LINK_TARGET" BOOT_ENV="$BOOT_ENV" DERIVED_KERNEL="$DERIVED_KERNEL" \
    DERIVED_GRUB="$DERIVED_GRUB" DERIVED_EFI="$DERIVED_EFI" DERIVED_FIRMWARE="$DERIVED_FIRMWARE" \
    DERIVED_PYCACHE="$DERIVED_PYCACHE" PKGS_KERNEL="$PKGS_KERNEL" PKGS_GRUB="$PKGS_GRUB" \
    PKGS_EFI="$PKGS_EFI" PKGS_FIRMWARE="$PKGS_FIRMWARE" PKGS_PYTHON="$PKGS_PYTHON" \
    SECRET_LINKS=" $(secret_links) " SYSTEM="$SYSTEM" awk -F '\t' '
    # dpkg records merged-/usr paths under either name, so compare both without the /usr.
    function norm(p) { return p ~ /^\/usr\/(bin|sbin|lib|lib32|lib64|libx32)\// ? substr(p, 5) : p }
    function touched_any(re,    k) { for (k in touched) if (k ~ re) return 1; return 0 }
    # Whether a package that lists p is in the set ran.
    function owner_ran(p, ran,    owners, n, k) {
      n = split(owner[p], owners, " ")
      for (k = 1; k <= n; k++) if (owners[k] in ran) return 1
      return 0
    }
    function owner_matches(p, re,    owners, n, k) {
      n = split(owner[p], owners, " ")
      for (k = 1; k <= n; k++) if (owners[k] ~ re) return 1
      return 0
    }
    # A .pyc is explained by a run of the package that owns its source, or of Python itself.
    function pyc_explained(path,    dir, base, owners, n, k) {
      dir = path; sub(/\/__pycache__\/[^\/]*$/, "", dir)
      base = path; sub(/^.*\/__pycache__\//, "", base); sub(/\..*$/, "", base)
      if (touched_any(ENVIRON["PKGS_PYTHON"])) return 1
      n = split(pyowner[norm(dir "/" base ".py")], owners, " ")
      for (k = 1; k <= n; k++) if (owners[k] in touched) return 1
      return 0
    }
    # The reason a regenerated file, which no package lists, is not explained; "" when it is.
    # A path is explained by dpkg.log entries since the baseline for a package that writes that
    # kind of file, so a retargeted link or an unrelated package run explains nothing.
    function derived_why(kind, type, path, target,    ok) {
      if (path ~ ENVIRON["BOOT_ENV"]) return (target == "-") ? "" : "expected a regular file, found a link"
      if (path ~ ENVIRON["BOOT_LINKS"]) {
        if (kind != "removed" && target !~ ENVIRON["BOOT_LINK_TARGET"]) return "a boot link that does not point at a kernel file in /boot"
      } else if (target != "-") return "a link where package triggers write a file"
      else if (type == "d") return ""
      if (path ~ ENVIRON["DERIVED_PYCACHE"]) ok = pyc_explained(path)
      else if (path ~ ENVIRON["DERIVED_KERNEL"]) ok = touched_any(ENVIRON["PKGS_KERNEL"])
      else if (path ~ ENVIRON["DERIVED_GRUB"]) ok = touched_any(ENVIRON["PKGS_GRUB"])
      else if (path ~ ENVIRON["DERIVED_EFI"]) ok = touched_any(ENVIRON["PKGS_EFI"])
      else if (path ~ ENVIRON["DERIVED_FIRMWARE"]) ok = touched_any(ENVIRON["PKGS_FIRMWARE"])
      else ok = (ntouched > 0)
      return ok ? "" : "regenerated by package triggers, but dpkg.log holds no package change since the baseline that explains it"
    }
    FILENAME == ARGV[1] {
      if ($1 == "EVENT") {
        if (!($3 in touched)) ntouched++
        touched[$3] = 1
        if ($4 ~ /^(install|upgrade)$/) upgraded[$3] = 1
        next
      }
      p = norm($1); owned[p] = 1
      if ($2 == "DIVERT") { q = norm($3); owned[q] = 1; divto[q] = p }
      else if ($2 == "-") { owner[p] = owner[p] " " $3; if (p ~ /\.py$/) pyowner[p] = pyowner[p] " " $3 }
      else digs[p] = digs[p] " " $2
      next
    }
    {
      kind = $1; type = $2; scope = $4; path = $5; p = norm(path); why = ""
      # Every digest a package records for this path. Two packages record a diverted path, and a
      # diversion target holds what its package installed under the diverted name.
      d = (p in digs) ? digs[p] : ""
      if ((p in divto) && (divto[p] in digs)) d = d digs[divto[p]]
      # $7 is set only while the path is a symlink, and $6 only while it is a regular file.
      # A unit the roles write is a fair target only for a link under /etc/systemd/system, where
      # `systemctl enable` makes it.
      link_ok = $7 != "-" && ($7 == "/dev/null" || (norm($7) in owned) || (path ~ /^\/etc\/systemd\/system\// && $7 ~ ENVIRON["ROLE_WRITTEN"]))
      # The host package links each output its secrets manifest declares into the tmpfs its
      # secrets unit fills, at the same relative path.
      if (scope != "persist" && index(ENVIRON["SECRET_LINKS"], " " path " ") && $7 == "/run/homelab-secrets" path && owner_matches(p, "^homelab-")) link_ok = 1
      # A distro link into a package that is not installed. Only a system-tree target, because a
      # file created there later pages on its own as unowned.
      if ($8 == "dangling" && $7 ~ ENVIRON["SYSTEM"] && $7 !~ /^\/usr\/local(\/|$)/ && owner_ran(p, touched)) link_ok = 1
      base = path; sub(/^.*\//, "", base)
      # /usr/local/bin pages only for a name a package also installs; its other entries are logged.
      if (scope == "shadow") {
        if (kind != "removed" && type != "d" && (("/bin/" base) in owned || ("/sbin/" base) in owned)) why = "named like a packaged command, so root runs it first"
      }
      # The usr-merge links are unpackaged and have no digest, so only where they point is judged.
      else if (scope == "derived" && path ~ ENVIRON["USRMERGE"]) {
        if (kind == "removed") why = "a top-level link is gone"
        else if ($7 != "/usr" path) why = "a top-level link that does not point at its usr counterpart"
      }
      # A file the roles write, while no package owns it, is not judged.
      else if (!(p in owned) && path ~ ENVIRON["ROLE_WRITTEN"]) { }
      else if (scope == "derived" && !(p in owned)) why = derived_why(kind, type, path, $7)
      # An unpackaged /etc file pages on nothing, its mode included.
      # An owner installed or upgraded in the window explains the mode; the content is still judged.
      # Never in PERSIST, and a homelab package only under /etc: it upgrades several times a day.
      else if ($3 == "pug" && !(scope != "persist" && owner_ran(p, upgraded) && (scope == "etc" || !owner_matches(p, "^homelab-"))) && (scope != "etc" || (p in owned))) why = "owner, group or permissions changed"
      else if (type == "d") next
      else if (kind == "removed") { if (p in owned) why = "removed, but a package still owns it" }
      else if (d != "") { if (index(d " ", " " $6 " ") == 0) why = "differs from its package copy" }
      # dpkg records no digest for a symlink, so an owned one must still resolve inside a package.
      # Every installed package on daniel-server records md5sums (2026-11-02), so an owned regular
      # file with no digest was a link or a directory in its package.
      else if (p in owned) { if (!link_ok) why = "a package owns it, but it is not the link the package installed" }
      else if (link_ok) next
      # $9 is set only for a regular file SNAPD_UDEV names.
      else if ($9 == "active") why = "a snapd udev rule with a key that does more than match, set ENV or jump"
      else if ($9 == "inert") {
        snap = base; sub(/^70-snap\./, "", snap); sub(/\.rules$/, "", snap)
        if (index(ENVIRON["SNAPS_REVISED"], " " snap " ") == 0) why = "a snapd udev rule changed, but the report adds no new revision of that snap"
      }
      else if (scope == "persist") why = "no package owns this login, privilege or startup file"
      else if (scope == "system") why = "no package owns it"
      if (why != "") print path " (" why ")"
    }' <(dpkg_index) -
}

# Captured whole rather than piped, because a pipeline's exit status is its last command's, which
# is how the old cron lost it. nice and ionice exit with the status of the command they run.
# --config is required: AIDE 0.18 has no default config path, and a bare `aide --check` exits
# with "missing configuration" and checks nothing (#4591). --update reports exactly as --check
# does and also writes aide.db.new, which advance_baseline moves into place. A stale aide.db.new
# from a run nobody accepted goes first, so the database moved is always this run's.
rm -f "$AIDE_DIR/aide.db.new"
START=$SECONDS
REPORT=$(/usr/bin/nice -n19 /usr/bin/ionice -c3 /usr/bin/aide --config=/etc/aide/aide.conf --update 2>&1)
RC=$?
RUN_TIME="$(((SECONDS - START) / 60))m"

# awk reads all of its input, where head would close the pipe early and printf would log a
# broken-pipe error.
REPORT_LINES=$(printf '%s\n' "$REPORT" | wc -l)
printf '%s\n' "$REPORT" | awk -v max="$REPORT_MAX_LINES" 'NR <= max' | logger -t aide
if ((REPORT_LINES > REPORT_MAX_LINES)); then
  logger -t aide "report truncated: logged ${REPORT_MAX_LINES} of ${REPORT_LINES} lines; run aide --config=/etc/aide/aide.conf --check by hand for the rest"
fi

# One count from the report's Summary block. The match requires a number after the colon,
# because the same labels head the per-entry lists further down the report.
summary_count() {
  printf '%s\n' "$REPORT" | awk -v label="$1" '
    !found && $0 ~ "^[[:space:]]*" label " entries:[[:space:]]*[0-9]+" { print $NF; found = 1 }'
}

# DECIDED: page on a difference no package explains, and advance the baseline after every run
# that has none (#4599, replacing #4594's "differences push UP"). Package upgrades land every
# week, so the classifier rather than the exit code decides: measured on daniel-server's
# 2026-11-02 report, all 18,556 changed package-owned files under /usr, /lib and /boot matched
# their dpkg digests, and its complete /boot and /etc entries were packages, triggers, Longhorn's
# /etc/iscsi and libvirt profiles. Advancing makes each report cover one week instead of
# growing from the first baseline. A DOWN does not advance: the change stays in every report
# until a human reads it and runs `aide-check --accept`, so one missed page does not bury it.
# aide.db dates from the last advance, and dpkg.log entries after it (less the slack) are the
# package runs that could explain DERIVED output. Without a baseline nothing is explained.
WINDOW_FROM=""
if BASELINE_EPOCH=$(stat -c %Y "$AIDE_DIR/aide.db" 2>/dev/null); then
  WINDOW_FROM=$(date -d "@$((BASELINE_EPOCH - WINDOW_SLACK_S))" '+%F %T') || WINDOW_FROM=""
fi
if ((RC == 0)); then
  STATUS=up
  MSG="no differences from the baseline (run ${RUN_TIME})"
elif ((RC >= 1 && RC <= 7)); then
  ADDED=$(summary_count Added)
  REMOVED=$(summary_count Removed)
  CHANGED=$(summary_count Changed)
  COUNTS="${ADDED:-?} added, ${REMOVED:-?} removed, ${CHANGED:-?} changed"
  # A classifier that fails has judged nothing, so it must not read as "all explained".
  if ! UNEXPLAINED=$(unexplained_entries); then
    STATUS=down
    MSG="aide completed, but classifying its differences failed, so none was judged: ${COUNTS} (exit ${RC}, run ${RUN_TIME}); run aide-check by hand to see the error"
  elif [[ -n "$UNEXPLAINED" ]]; then
    STATUS=down
    UNEXPLAINED_COUNT=$(printf '%s\n' "$UNEXPLAINED" | wc -l)
    printf '%s\n' "$UNEXPLAINED" \
      | awk -v max="$UNEXPLAINED_MAX_LINES" 'NR <= max { print "unexplained: " $0 }' \
      | logger -p daemon.notice -t aide-check
    NAMED=$(printf '%s\n' "$UNEXPLAINED" | awk -v max="$MSG_PATHS" 'NR <= max' | paste -sd ';' -)
    MSG="${UNEXPLAINED_COUNT} changes no package explains: ${NAMED} (${COUNTS}, exit ${RC}, run ${RUN_TIME}); journalctl -t aide-check lists them; once reviewed, run aide-check --accept"
  else
    STATUS=up
    MSG="differences from the baseline, every one explained or outside the paged trees: ${COUNTS} (exit ${RC}, run ${RUN_TIME}); journalctl -t aide lists them"
  fi
else
  STATUS=down
  # The first line that names an error, else the first line of output at all.
  DETAIL=$(printf '%s\n' "$REPORT" | awk '!found && tolower($0) ~ /error/ { sub(/^[[:space:]]+/, ""); print; found = 1 }')
  [[ -n "$DETAIL" ]] || DETAIL=$(printf '%s\n' "$REPORT" | awk '!found && NF { sub(/^[[:space:]]+/, ""); print; found = 1 }')
  MSG="aide exited ${RC}, so the check did not complete: ${DETAIL:-no output} (run ${RUN_TIME}); journalctl -t aide"
fi

if [[ "$STATUS" == up ]] && ! advance_baseline; then
  MSG="${MSG}; baseline not advanced, ${AIDE_DIR}/aide.db.new missing"
fi

report

# Cron ignores the exit code; it is non-zero after a DOWN so a run by hand reads the same way.
[[ "$STATUS" == up ]] || exit 1
