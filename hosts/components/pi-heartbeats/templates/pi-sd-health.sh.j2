#!/usr/bin/env bash
# Pi SD-card health heartbeat — shipped by homelab-daniel-pi (hosts/components/pi-heartbeats);
# edits overwritten.
#
# Usage: pi-sd-health [-h|--help]
# Takes no arguments. homelab-pi-sd-health.timer runs it every 5 minutes on daniel-pi, through
# homelab-pi-sd-health.service. It reads the root filesystem's ext4 errors_count from sysfs and
# the verdict file that pi-gz-integrity writes, then writes pi-sd-health.prom to node_exporter's
# textfile directory and one line to /var/log/pi-health/health.log. To run it by hand, start the
# service.
#
# SD cards have no SMART (no ATA/NVMe command set behind mmcblk0), so a dying card
# only announces itself through filesystem errors. The kernel counts them per ext4
# filesystem in sysfs; any nonzero errors_count on the root fs is the earliest
# reliable "replace this card" signal (it persists across reboots until fsck clears
# the superblock error state).
#
# Prometheus reads the textfile (pi-checks.yaml, M6 batch B5). PiSdHealthFailed names a `down`
# verdict fast, and PiSdHealthNotReporting fires when the verdict goes stale, which is how a
# dead timer or host shows.
set -uo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

# shellcheck source=/dev/null
source /usr/lib/homelab/homelab-check-lib.sh || {
  logger -t pi-sd-health "homelab-check-lib.sh missing — reinstall homelab-daniel-pi"
  exit 1
}

COUNTER=/sys/fs/ext4/mmcblk0p2/errors_count

if COUNT=$(cat "$COUNTER" 2>/dev/null); then
  if [ "$COUNT" = "0" ]; then
    STATUS=up;   MSG="ext4 errors_count=0 on mmcblk0p2"
  else
    STATUS=down; MSG="ext4 errors_count=${COUNT} on mmcblk0p2 — SD card may be failing; check dmesg + fsck"
  fi
else
  # Surface a missing counter (device renamed? sysfs layout change) instead of
  # silently passing — same principle as monitor-bridge's unreachable-source rule.
  STATUS=down; MSG="cannot read ${COUNTER}"
fi

# The rotated-log integrity verdict, produced daily by pi-gz-integrity and folded in here.
# Same check on purpose (#2715): a rotated log that stops decompressing and a climbing ext4
# errors_count are the same operator action on the same device, and a second check would need
# its own textfile, rules and deadline literals. A verdict older than the
# sweep's own period is itself a down — the unreachable-source rule above, applied to a source
# that happens to be a file: a sweep that stopped running must not keep reporting yesterday.
GZ_STATE="{{ optimize_pi_gz_integrity_state_file }}"
GZ_MAX_AGE_H={{ optimize_pi_gz_integrity_max_age_h }}
if [ -r "$GZ_STATE" ] &&
  [ -n "$(find "$GZ_STATE" -newermt "-${GZ_MAX_AGE_H} hours" -print 2>/dev/null)" ]; then
  GZ_STATUS=$(sed -n 1p "$GZ_STATE")
  GZ_MSG=$(sed -n 2p "$GZ_STATE")
else
  GZ_STATUS=down
  GZ_MSG="rotated-log integrity verdict missing or older than ${GZ_MAX_AGE_H}h (${GZ_STATE}) — the daily sweep is not running"
fi
if [ "$GZ_STATUS" != "up" ]; then
  STATUS=down
fi
MSG="${MSG}; ${GZ_MSG}"

# Whether log2ram is mounted at all. When its boot guard refuses to start, /var/log stays a
# plain directory on the SD card, and every log write lands on the card. The integrity sweep
# above notices that only indirectly and only once a day, as an empty /var/hdd.log (#4583).
# This check names the cause directly. It reads the mount table rather than the unit's
# state, because the mount is what protects the card.
LOG_FSTYPE=$(findmnt -n -o FSTYPE --mountpoint /var/log 2>/dev/null)
if [ "$LOG_FSTYPE" != "tmpfs" ]; then
  STATUS=down
  MSG="${MSG}; /var/log is not log2ram's tmpfs (fstype '${LOG_FSTYPE:-none}'), so logs write to the SD card — check systemctl status log2ram"
fi

# The textfile verdict for Prometheus (M6 B5, docs/target-architecture/monitoring/
# m6-retire-kuma.md). DEADLINE_S is 2 x the timer's 300s period + 300s, as M3 derives it; a
# test pins the rule's literals to it. The directory is root:sys_user 2775, so this unit's user
# can write it.
DEADLINE_S=900
write_check_textfile pi-sd-health "$([ "$STATUS" = up ] && echo 1 || echo 0)" "$(date +%s)" "$DEADLINE_S" \
  || logger -t pi-sd-health "textfile write failed (status=${STATUS})"

# Durable record of this cycle, which Loki keeps beside the other hosts' verdict lines. The full
# reasoning — why a file and not `logger`, and why the timestamp format is load-bearing —
# is in pi-recovery-health.sh.j2, which emits the same shape under its own tag.
#
# A failing SD card is the one signal on this host where the history matters more than the
# current state: `errors_count` only ever climbs, so knowing WHEN it first moved is the whole
# diagnosis, and the textfile keeps only the latest verdict.
HEALTH_LOG="/var/log/pi-health/health.log"
mkdir -p "${HEALTH_LOG%/*}" 2>/dev/null || true
DETAIL="status=${STATUS} ${MSG}"
printf '%s %s %s: %s\n' "$(date -Is)" "$(hostname)" pi-sd-health "$DETAIL" >>"$HEALTH_LOG"
