#!/usr/bin/env bash
# Pi container-recovery heartbeat — shipped by homelab-daniel-pi
# (hosts/components/pi-heartbeats); edits overwritten.
#
# Usage: pi-recovery-health [-h|--help]
# Takes no arguments. homelab-pi-recovery.timer runs it every 5 minutes on daniel-pi, through
# homelab-pi-recovery.service. It checks every container the host deploys, runs docker start on
# any that is not running, then writes pi-recovery-health.prom to node_exporter's textfile
# directory and one line to /var/log/pi-health/health.log. Starting the service by hand does the
# same.
#
# Nothing else watches the Pi's containers for liveness. autoheal (restarts unhealthy
# containers) and docker-proxy (read-only socket serving Alloy's container-log discovery) die
# silently: if autoheal dies, unhealthy Pi containers stop self-recovering; if docker-proxy
# dies, Alloy's docker_sd finds no targets and this host's container logs stop reaching Loki,
# while Alloy keeps running with zero targets. docker-proxy-lifecycle has no probe from outside
# the host.
# This heartbeat watches EVERY container the host deploys (every compose_services entry,
# plus docker-proxy's sub-proxies, which are services inside its compose file rather than list entries)
# and writes a passing verdict only while all of them run, every 5 min.
# Prometheus reads the textfile (pi-checks.yaml, M6 batch B5). PiRecoveryFailed names the dead
# container fast, and PiRecoveryNotReporting fires when the verdict goes stale, which is how a
# dead timer or host shows.
set -uo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

# shellcheck source=/dev/null
source /usr/lib/homelab/homelab-check-lib.sh || {
  logger -t pi-recovery-health "homelab-check-lib.sh missing — reinstall homelab-daniel-pi"
  exit 1
}

{# The watch set is derived from compose_services plus docker-proxy-lifecycle, not a blanket exited
   filter, which would restart containers an operator stopped on purpose. #}
{% set _names = compose_services | map(attribute='name') | sort | list %}
{% if 'docker-proxy' in _names %}
{%   set _names = _names + ['docker-proxy-lifecycle'] %}
{% endif %}
CONTAINERS=({{ _names | join(' ') }})

DOWN=""
RECOVERED=""
FAILED=""
for c in "${CONTAINERS[@]}"; do
  # docker ps reads the real socket, not docker-proxy, so it still reports docker-proxy when down.
  if [ -n "$(docker ps -q --filter "name=^${c}$" --filter status=running)" ]; then
    continue
  fi

  # Record why before docker start erases it; this line is the only record that reaches Loki. Error
  # is free text: flattened and capped so the health.log record stays one line.
  WHY="$(docker inspect --format '{% raw %}status={{.State.Status}} exit={{.State.ExitCode}} finished={{.State.FinishedAt}} error={{.State.Error}}{% endraw %}' "$c" 2>/dev/null |
    tr '\n' ' ' | cut -c1-300)"
  [ -z "$WHY" ] && WHY="inspect failed"
  DOWN="${DOWN:+$DOWN, }${c} [${WHY% }]"

  # restart: unless-stopped does not cover a container whose create fails at the OCI runtime.
  if docker start "$c" >/dev/null 2>&1 &&
    [ -n "$(docker ps -q --filter "name=^${c}$" --filter status=running)" ]; then
    RECOVERED="${RECOVERED:+$RECOVERED, }$c"
  else
    FAILED="${FAILED:+$FAILED, }$c"
  fi
done

# Daemon down: read journalctl -u docker; -p warning returns nothing, dockerd logs at priority 6.
# Blame dockerd only if docker version fails or every container read inspect failed.
DAEMON=""
if ! docker version --format '{% raw %}{{.Server.Version}}{% endraw %}' >/dev/null 2>&1 ||
  [ "$(grep -o 'inspect failed' <<<"$DOWN" | wc -l)" -eq {{ _names | length }} ]; then
  DAEMON="$(journalctl -u docker --since -10min -n 40 -o cat --no-pager 2>/dev/null |
    grep -vE 'level=(info|debug)|Security options with' | tail -n 5 | sed -E 's/^time="[^"]*" //' |
    tr '\n' ' ' | cut -c1-400)"
fi

# An absent file adds nothing; an unreadable or result-less file is reported, not read as all-clear.
COMPOSE_PROM="${TEXTFILE_DIR:-/var/lib/node-exporter-textfile}/homelab_compose.prom"
COMPOSE_MSG=""
if [ -e "$COMPOSE_PROM" ] || [ -L "$COMPOSE_PROM" ]; then
  if ! COMPOSE_BODY="$(cat "$COMPOSE_PROM" 2>/dev/null)"; then
    COMPOSE_MSG="homelab-compose: ${COMPOSE_PROM} exists and cannot be read"
  else
    COMPOSE_LINE="$(grep -m1 '^homelab_compose_up_result[{ ]' <<<"$COMPOSE_BODY")"
    COMPOSE_SHA="$(sed -n 's/.*sha="\([^"]*\)".*/\1/p' <<<"$COMPOSE_LINE")"
    if [ -z "$COMPOSE_LINE" ]; then
      COMPOSE_MSG="homelab-compose: ${COMPOSE_PROM} holds no homelab_compose_up_result"
    elif [ "${COMPOSE_LINE##* }" != "1" ]; then
      COMPOSE_MSG="homelab-compose: the last run failed (homelab_compose_up_result ${COMPOSE_LINE##* } at ${COMPOSE_SHA:-unknown})"
    fi
  fi
fi

if [ -z "$DOWN" ] && [ -z "$COMPOSE_MSG" ]; then
  STATUS=up;   MSG="all {{ _names | length }} containers running"
else
  # DECIDED: STATUS stays `down` even when the restart worked. Reporting `up` after a
  # successful recovery would make an auto-restart loop invisible: a container crashing every
  # 5 minutes would read green forever, which is the failure mode that makes self-healing
  # worse than no healing. One failing verdict per cycle that needed intervention keeps the
  # episode in Prometheus and in the alert history, and the next clean cycle clears it.
  # A proposal to report `up` with a warning was declined: single-cycle `not running: autoheal;
  # restarted: autoheal` episodes ARE the loop this rule exists to keep visible. The recurring
  # fault worth fixing is that autoheal stops at all.
  STATUS=down; MSG=""
  if [ -n "$DOWN" ]; then
    MSG="not running: ${DOWN}"
    [ -n "$RECOVERED" ] && MSG="${MSG}; restarted: ${RECOVERED}"
    [ -n "$FAILED" ] && MSG="${MSG}; restart FAILED: ${FAILED}"
  fi
  [ -n "$COMPOSE_MSG" ] && MSG="${MSG:+${MSG}; }${COMPOSE_MSG}"
  [ -n "$DAEMON" ] && MSG="${MSG}; dockerd: ${DAEMON% }"
fi

# DEADLINE_S is 2 x the timer's 300s period + 300s; a test pins the rule's literals to it.
DEADLINE_S=900
write_check_textfile pi-recovery-health "$([ "$STATUS" = up ] && echo 1 || echo 0)" "$(date +%s)" "$DEADLINE_S" \
  || logger -t pi-recovery-health "textfile write failed (status=${STATUS})"

# A file, not logger: only warning-and-above journal lines ship; Alloy tails this path. Shape is
# load-bearing: _SYSLOG_LINE_RE wants two whitespace-free tokens before the tag.
HEALTH_LOG="/var/log/pi-health/health.log"
mkdir -p "${HEALTH_LOG%/*}" 2>/dev/null || true
DETAIL="status=${STATUS} ${MSG}"
printf '%s %s %s: %s\n' "$(date -Is)" "$(hostname)" pi-recovery-health "$DETAIL" >>"$HEALTH_LOG"
