# Shipped by homelab-daniel-pi (hosts/components/pi-heartbeats); edits here are overwritten.
#
# `create`, NOT `copytruncate`. The log shipper holds the file open and tracks a byte offset;
# truncating in place leaves that offset past the new end, so it silently ships nothing until
# the offset happens to be passed again. Renaming and creating a fresh inode is the rotation a
# glob-based tailer handles correctly. /var/log is log2ram's tmpfs, and four 5-minute heartbeats
# x 288 runs a day x ~90 B is ~104 KB a day, so the cap is precautionary, not load-bearing.
# Root-owned reconcile.log gets two ~100 B lines per command a reconcile run calls, and the Pi runs
# reconcile once per published package, so it stays well under the cap too. Root-owned
# updater.log gets a line only when the updater reports a failure or a hold.
/var/log/pi-health/*.log {
  daily
  rotate 1
  size 256k
  missingok
  notifempty
  create 0644 {{ sys_user }} {{ sys_user }}
  su {{ sys_user }} {{ sys_user }}
}
