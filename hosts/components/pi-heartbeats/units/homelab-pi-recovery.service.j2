# Shipped by homelab-daniel-pi. Started by homelab-pi-recovery.timer, whose enable link ships
# only while optimize_pi_recovery_restart_enabled is true. component.yml carries the contract.
[Unit]
Description=Start any stopped Pi container and write the recovery verdict for Prometheus

[Service]
Type=oneshot
# This host's journald stores notice and above (MaxLevelStore=notice), so stdout logs at notice.
SyslogLevel=notice
User={{ sys_user }}
# The script's docker calls need the socket's group, and nothing else adds sys_user to it.
# docker-ce's postinst creates the group when pi-docker installs the engine.
SupplementaryGroups=docker
ExecStart=/usr/lib/homelab/pi-recovery-health
LogsDirectory=pi-health
