# Shipped by homelab-daniel-pi with its enable link. Every 5 minutes, a third of the 900s deadline
# that PiAuditNotReporting allows, so one missed run is tolerated and a dead timer or host alerts.
[Unit]
Description=Check that the Pi's auditd is writing its log every 5 minutes

[Timer]
OnCalendar=*:0/5
AccuracySec=10s

[Install]
WantedBy=timers.target
