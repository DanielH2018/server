{#- docker-proxy and its sub-proxies. The networks, resources and label settings are written out
    here, because a service tree has no k8s/templates on its search path.

    A dockerd restart replaces /var/run/docker.sock with a new inode. A container that bind-mounts
    the socket keeps the old inode, which has no listener, so the proxy answers 503 until it is
    recreated, and autoheal (which restarts only an unhealthy container) cannot see the fault.
    Fix: `docker compose -p homelab up -d --force-recreate docker-proxy docker-proxy-lifecycle`.
    The tell is `stat -c %i /var/run/docker.sock` differing from the same command inside the
    container. Alloy's docker_sd stops finding targets. The engine
    upgrade play recreates every project for this reason. -#}
---

services:
  docker-proxy:
    image: lscr.io/linuxserver/socket-proxy:latest@sha256:6beb1743581ec3b2ed1a2bafd617e8c7a1d7ae2fe835293e333327618fc2b925
    container_name: docker-proxy
    environment:
      - CONTAINERS=1  # Allow access to viewing containers
      - ALLOW_LOGS=1  # Alloy's loki.source.docker tails /containers/<id>/logs; the proxy gates /logs on this flag apart from CONTAINERS=1
      - SERVICES=1    # Allow access to viewing services (necessary when using Docker Swarm)
      - TASKS=1       # Allow access to viewing tasks (necessary when using Docker Swarm)
      - POST=0        # Read-only: no write/lifecycle ops on this broadly-reachable proxy
      - EXEC=0        # Read-only: no container exec (Portainer + lifecycle automation use dedicated proxies)
      - INFO=1        # Portainer checks this to validate connection
      - VERSION=1     # Portainer checks this to validate connection
      - PING=1        # Portainer checks this to validate connection
      - IMAGES=1
      - VOLUMES=1
      - NETWORKS=1
      - EVENTS=1
    networks:
{% for net in container_item.networks %}
      - {{ net }}
{% endfor %}
    volumes:
      - type: bind
        source: /var/run/docker.sock
        target: /var/run/docker.sock
        read_only: true
        bind: {create_host_path: false}
    read_only: true
    tmpfs:
      - /run
    # LSIO socket-proxy is haproxy on a high port — already read_only + tmpfs.
    # Empty add; if haproxy can't drop to its user, add [SETUID, SETGID]. Verify on deploy.
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null http://localhost:2375/version || exit 1"]
      # Host-tunable cadence: 10s is fine on the server, but each probe forks runc twice —
      # real CPU/PID churn on the Pi (see container_healthcheck_interval in its host_vars).
      interval: {{ container_healthcheck_interval | default('10s') }}
      timeout: {{ container_healthcheck_timeout | default('5s') }}
      retries: {{ container_healthcheck_retries | default(3) }}
      start_period: 10s
    labels:
      # Disable watchtower update
      - "com.centurylinklabs.watchtower.enable=false"
    # Resource caps for blast-radius containment (M1); tune from cAdvisor/Grafana.
    deploy:
      resources:
        limits:
          cpus: '0.50'
          memory: 128M
        reservations:
          cpus: '0.05'
          memory: 16M

  # Write-capable proxy for lifecycle automation only — Autoheal, and nothing else. It lives
  # solely on the private `lifecycle` network autoheal joins, so write access to the Docker API
  # is NOT exposed to the proxy/monitoring/apps networks.
  #
  # IMAGES, NETWORKS, ALLOW_START, ALLOW_STOP and EVENTS stay off: Autoheal issues
  # POST /containers/{id}/restart and nothing else, which ALLOW_RESTARTS gates on its own, and it
  # POLLS on AUTOHEAL_INTERVAL=30 and never opens /events. Autoheal is the only container on the
  # `lifecycle` network, so there is no second consumer to break.
  #
  # POST=1 STAYS: a restart is a POST, so this proxy remains write-capable by design.
  docker-proxy-lifecycle:
    image: lscr.io/linuxserver/socket-proxy:latest@sha256:6beb1743581ec3b2ed1a2bafd617e8c7a1d7ae2fe835293e333327618fc2b925
    container_name: docker-proxy-lifecycle
    environment:
      - CONTAINERS=1
      - INFO=1
      - VERSION=1
      - PING=1
      - POST=1           # Allow write methods (POST/PUT/DELETE) — Autoheal's restart is a POST
      - ALLOW_RESTARTS=1 # Autoheal: restart unhealthy containers
      # EXEC=0 blocks the exec *run* path (/exec/{id}/start -> 403, verified). Note: create-exec
      # (/containers/{id}/exec) still slips through via CONTAINERS+POST, but with /exec/start
      # blocked it can't execute. Accepted: this proxy is already create-capable (POST=1, needed
      # by Autoheal's restart) and isolated to the lifecycle net, where Autoheal is the only
      # member.
      - EXEC=0
    networks:
      - lifecycle
    volumes:
      - type: bind
        source: /var/run/docker.sock
        target: /var/run/docker.sock
        read_only: true
        bind: {create_host_path: false}
    read_only: true
    tmpfs:
      - /run
    # LSIO socket-proxy is haproxy on a high port — already read_only + tmpfs.
    # Empty add; if haproxy can't drop to its user, add [SETUID, SETGID]. Verify on deploy.
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null http://localhost:2375/version || exit 1"]
      interval: {{ container_healthcheck_interval | default('10s') }}
      timeout: {{ container_healthcheck_timeout | default('5s') }}
      retries: {{ container_healthcheck_retries | default(3) }}
      start_period: 10s
    labels:
      - "com.centurylinklabs.watchtower.enable=false"
    # Resource caps for blast-radius containment (M1); tune from cAdvisor/Grafana.
    deploy:
      resources:
        limits:
          cpus: '0.50'
          memory: 128M
        reservations:
          cpus: '0.05'
          memory: 16M

networks:
{% for net in container_item.networks %}
  {{ net }}:
    external: true
{% endfor %}
  lifecycle:
    external: true
