# Shipped by daniel-box's package (the t2-egress component), enabled at boot. Applies
# t2-egress.nft, which loads `table inet t2_egress`, the T2 session users' egress table, or
# deletes it while t2_egress_enabled is false. The table fences the session uids to squid.
[Unit]
Description=Load the T2 session users' egress table (table inet t2_egress)
After=network-pre.target
Before=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
# This host's journald stores notice and above, so an nft error logged at info would be lost.
SyslogLevel=notice
# Checked before it is applied, so a ruleset nft rejects changes nothing.
ExecStartPre=/usr/sbin/nft -c -f /usr/lib/homelab/t2-egress/t2-egress.nft
ExecStart=/usr/sbin/nft -f /usr/lib/homelab/t2-egress/t2-egress.nft
# Reloaded, not restarted: the file is idempotent, so the sets keep what they recorded and no
# session runs unfenced.
ExecReload=/usr/sbin/nft -c -f /usr/lib/homelab/t2-egress/t2-egress.nft
ExecReload=/usr/sbin/nft -f /usr/lib/homelab/t2-egress/t2-egress.nft
# No ExecStop: a stop that deleted the table would empty the sets and unfence the sessions until the
# start.

[Install]
WantedBy=multi-user.target
