# Shipped by daniel-box's package (the t2-egress component): the T2 sessions' egress proxy
# (dotfiles#967 I5). Each session unit points HTTPS_PROXY and HTTP_PROXY at t2_egress_proxy.
#
# The fence in t2-egress.nft lets the session uids reach this port and nothing else, so this
# allowlist is everything a session can reach. It admits a CONNECT from loopback to a listed
# host and port, and refuses the rest with a 403, which the access log records. The hosts are
# literals here, not inventory values, so no host_vars entry widens the list. They are what the
# B3-1 shadow run measured on 2026-11-19, and the operator ruled the last two in.
#
# Its logs go to files under /var/log/squid only. Alloy ships none of them, and the unit's drop-in
# starts squid without -s, so no request text a session shaped reaches syslog or loki-homelab (I6).

http_port {{ t2_egress_proxy }}

# The proxy never connects back into the host, whatever a name resolves to.
http_access deny to_localhost
http_access deny to_linklocal

acl loopback src 127.0.0.0/8 ::1
acl CONNECT method CONNECT
acl https_port port 443
acl k3s_port port 6443
acl t2_https dstdomain api.anthropic.com
acl t2_https dstdomain api.github.com
acl t2_https dstdomain prometheus.local.daniel-hunter.com
acl t2_https dstdomain alertmanager.local.daniel-hunter.com
acl t2_https dstdomain results-receiver.actions.githubusercontent.com
# TODO: https://github.com/DanielH2018/server/issues/9181 - name the caller of cafe.github.com.
acl t2_https dstdomain cafe.github.com
# The triage session's kubeconfig names the k3s API by daniel-box's LAN address.
acl t2_k3s dst {{ server_ip }}

http_access allow loopback CONNECT https_port t2_https
http_access allow loopback CONNECT k3s_port t2_k3s
http_access deny all

# A proxy, not a cache: nothing a session fetched is kept for a later run (I2).
cache deny all

# %ru is the URL, or host:port for a CONNECT.
logformat t2 %ts.%03tu %>a %rm %ru %>Hs %<st
access_log daemon:/var/log/squid/t2-access.log t2
cache_log /var/log/squid/cache.log
# Ubuntu's /etc/logrotate.d/squid renames the files and signals squid, which then only reopens.
logfile_rotate 0

via off
forwarded_for delete
httpd_suppress_version_string on
coredump_dir /var/spool/squid
# The stock path, so the package's `squid -k rotate` signals this process.
pid_filename /run/squid.pid
