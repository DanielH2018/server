# Shipped by the renovate-agent component. Read by systemd as root through
# homelab-renovate-agent.service's EnvironmentFile=, so no value appears in a unit line.
# GH_TOKEN: the controller's fine-grained token for {{ renovate_agent_repo }} alone, with no
# contents write. It reads the census and makes every GitHub write the session requests. The
# session never holds it (dotfiles#967's I1).
GH_TOKEN={{ renovate_agent_gh_token }}
