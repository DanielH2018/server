{#- The Renovate agent's caps, permission mode, users and controller paths: every template that
names one imports these as `pins`. A template's own assignment outranks every inventory value, so
a PR that edits only host_vars cannot raise a run's PR count, spend or wall clock, widen its
permission mode, or move what the controller trusts. The host package renderer puts the inventory above a component's
defaults, so a component default would pin nothing. This file is on the lander's approval list.
Each value is a literal. hosts/tests/repo_crons/test_renovate_agent_unit.py holds the caps equal to the
component's defaults/main.yml, which the docs fragments read.
-#}
{#- Both polkit rules key on these, so a host_vars edit cannot hand the session a start right. -#}
{%- set user = "renovate-agent" -%}
{%- set ctl_user = "renovate-agent-ctl" -%}
{#- A path the session could write here would hand it code the controller runs with the write token. -#}
{%- set ctl_home = "/var/lib/renovate-agent-ctl" -%}
{#- The session may write only the requests/ and out/ children. -#}
{%- set exchange_dir = "/var/lib/renovate-agent-exchange" -%}
{#- Outside the session's home, so the session cannot replace either between runs. -#}
{%- set tools_dir = "/var/lib/renovate-agent-tools" -%}
{%- set clone_dir = "/var/lib/renovate-agent-clone" -%}
{%- set settings_file = "/var/lib/homelab-claude-config/current/renovate.json" -%}
{%- set max_prs = 3 -%}
{%- set model = "opus" -%}
{%- set permission_mode = "auto" -%}
{%- set budget_usd = 25 -%}
{#- The whole run: the session, then the landings it nominated, one after another. -#}
{%- set run_timeout_s = 67260 -%}
{#- An assumption, not a measurement: it and one whole landing fit inside run_timeout_s. -#}
{%- set session_timeout_s = 2700 -%}
{#- The session's bounds. Its home, /tmp, /var/tmp and /dev/shm are
tmpfs mounts that end with the unit. Their pages count against memory_max, so the sizes sum well
below it and a full mount fails with ENOSPC rather than an OOM kill. The home's mount takes the
session's numeric uid, which component.yml declares. -#}
{%- set session_uid = 901 -%}
{%- set home_size = "512M" -%}
{%- set tmp_size = "512M" -%}
{%- set scratch_size = "64M" -%}
{%- set memory_max = "4G" -%}
{%- set tasks_max = 512 -%}
{%- set unit_timeout = "1131min" -%}
