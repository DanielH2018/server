{% import 'templates/renovate-agent-pins.j2' as pins with context -%}
// Shipped by the renovate-agent component.
//
// Lets the controller START one landing unit, and nothing else. The session only nominates a PR;
// the controller lands it by starting renovate-agent-land@<n>.service, which runs as the
// operator's user and re-checks the PR before running land.sh (dotfiles#967's I9). The session's
// own user holds no start right. The instance must be a plain PR number, matching what
// land_renovate_pr.py accepts, so no other unit name or verb reaches this rule's YES.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return undefined;
    }
    if (subject.user !== "{{ pins.ctl_user }}") {
        return undefined;
    }
    if (!/^renovate-agent-land@[1-9][0-9]{0,6}\.service$/.test(action.lookup("unit"))) {
        return undefined;
    }
    if (action.lookup("verb") !== "start") {
        return undefined;
    }
    return polkit.Result.YES;
});
