{% import 'templates/renovate-agent-pins.j2' as pins with context -%}
# Shipped by the renovate-agent component. Started by homelab-renovate-agent.timer.
[Unit]
Description=Unattended Renovate agent (one headless Claude session over the open Renovate PRs)
After=network-online.target homelab-secrets.service
Wants=network-online.target homelab-secrets.service
OnFailure=homelab-alert@%n.service

[Service]
Type=oneshot
# The controller, not {{ sys_user }} and not the session's user (dotfiles#967's I1). It holds the
# write token and the run's state, and polkit lets it alone start the session unit and each
# renovate-agent-land@<n>.service; the session it starts runs as {{ pins.user }} and holds a
# read-only token. The session's group lets it read the requests and output the session writes
# into the exchange directory.
User={{ pins.ctl_user }}
SupplementaryGroups={{ pins.user }}
# The runner's own RUN_TIMEOUT_S ({{ pins.run_timeout_s }}s), its deadline for the session and the
# landings after it, should always trip first: the runner stops waiting and still posts a
# digest naming why, where this ceiling kills the whole cgroup and posts only the OnFailure
# alert. Keep this strictly above RUN_TIMEOUT_S plus the two `gh pr list` censuses either side of
# it. A landing in flight runs in the lander's own unit, so this kill does not reach it.
TimeoutStartSec={{ pins.unit_timeout }}
# `gh` and `git` are in /usr/bin; the controller has no ~/.local/bin.
Environment=PATH=/usr/bin:/bin
Environment=HOME={{ pins.ctl_home }}
Environment=PYTHONDONTWRITEBYTECODE=1
# The controller's own interpreter under its home, as the dotfiles mirror keeps one.
Environment=UV_CACHE_DIR={{ pins.ctl_home }}/uv-cache
Environment=UV_PYTHON_INSTALL_DIR={{ pins.ctl_home }}/python
# The controller's write token. Read by systemd as root, so the file is root 0600 and the value
# appears in no unit line `systemctl show` publishes.
EnvironmentFile=/etc/renovate-agent/ctl.env
# journald stores only notice+ on these hosts, and a unit's stdout logs at info by default —
# so without this every runner line is discarded at the source and a post-mortem has nothing
# to read. Same reasoning as gitops-deploy.service.
SyslogLevel=notice
NoNewPrivileges=yes
ProtectHome=yes
ProtectProc=invisible
PrivateTmp=yes
#
# The agent's home and tooling, the controller's home and the exchange directory, before each
# run, so a pin bump or a rebuilt host converges on the next tick. `+` runs it as root outside the
# sandbox, because it reads the operator's copies under ProtectHome's /home. `env -i` drops the
# unit's Environment= and the token.
ExecStartPre=+/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin /usr/lib/homelab/renovate-agent-setup
ExecStartPre=/usr/lib/homelab/bin/uv python install --no-bin {{ host_python_version }}
#
# `-n`: never queue. Two of these overlapping would fight over the same worktree, and the timer
# is daily, so a run still going when the next one fires means something is wrong and the second
# should say so rather than wait. The lock sits in the controller's own home:
# fs.protected_regular=2 refuses an O_CREAT open of another user's file in sticky /run/lock.
ExecStart=/usr/bin/flock -n {{ pins.ctl_home }}/run.lock \
  /usr/lib/homelab/bin/uv run --no-project --no-python-downloads --python {{ host_python_version }} \
  /usr/lib/homelab/renovate-agent/renovate_agent.py
# The same run's verdict for node_exporter's textfile collector (M6 batch B4). It runs only when
# ExecStart exited 0. A crash or a blocked tree writes nothing: the rule reads that as silence,
# OnFailure pages it, and the rules in other-setup-checks.yaml carry only a NotReporting arm for it.
#
# `+` runs this one line as root. This unit runs as the controller, which has no write on the
# textfile directory (root:{{ sys_user }}, 2775) and does not need it. The line writes one file
# and nothing else. `env -i PATH=/usr/bin:/bin` pins the command's environment, because `+` does
# not drop `Environment=`. It
# is /bin/bash, not /bin/sh, since homelab-check-lib.sh is bash-shaped. Both write failures end in a logged line
# and exit 0, so the unit never fails over its own telemetry. 100800 is the DEADLINE_S (28 h), and
# hosts/tests/test_b4_rule_literals.py pins the rule's literal to it. `%%s` is systemd's escape
# for the date format's `%s`.
ExecStartPost=+/usr/bin/env -i PATH=/usr/bin:/bin /bin/bash -c 'source /usr/lib/homelab/homelab-check-lib.sh && write_check_textfile renovate-agent 1 "$(date +%%s)" 100800 || logger -t renovate-agent "textfile write failed (homelab-check-lib.sh missing or the textfile directory unwritable)"'
