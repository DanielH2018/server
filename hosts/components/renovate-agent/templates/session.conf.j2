{% import 'templates/renovate-agent-pins.j2' as pins with context -%}
# Shipped by the renovate-agent component: the session unit's config. It holds no secret, so the
# session reads it; the runner's config.env, with the Discord webhook, stays the controller's.
REPO={{ renovate_agent_repo }}
REPO_DIR={{ pins.clone_dir }}
# Where the session's transcript is, for the session script to copy it out.
SESSION_HOME={{ renovate_agent_home }}
EXCHANGE_DIR={{ pins.exchange_dir }}
PROMPT_FILE=/usr/lib/homelab/renovate-agent/prompt.txt
CLAUDE_BIN={{ pins.tools_dir }}/.local/bin/claude
SETTINGS_FILE={{ pins.settings_file }}
MODEL={{ pins.model }}
PERMISSION_MODE={{ pins.permission_mode }}
BUDGET_USD={{ pins.budget_usd }}
