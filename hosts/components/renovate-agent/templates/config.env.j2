{% import 'templates/renovate-agent-pins.j2' as pins with context -%}
REPO={{ renovate_agent_repo }}
REPO_DIR={{ renovate_agent_clone_dir }}
DISCORD_WEBHOOK={{ discord_alert_webhook }}
STATE_DIR=/var/lib/renovate-agent
WORKTREE={{ renovate_agent_worktree }}
BRANCH={{ renovate_agent_branch }}
PROMPT_FILE=/usr/lib/homelab/renovate-agent/prompt.txt
# Absolute: the native installer puts claude under the user's home and systemd's PATH omits it.
CLAUDE_BIN={{ renovate_agent_home }}/.local/bin/claude
MODEL={{ pins.model }}
PERMISSION_MODE={{ pins.permission_mode }}
BUDGET_USD={{ pins.budget_usd }}
RUN_TIMEOUT_S={{ pins.run_timeout_s }}
