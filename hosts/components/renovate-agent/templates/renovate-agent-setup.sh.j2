#!/bin/bash
{% import 'templates/renovate-agent-pins.j2' as pins with context -%}
# Shipped by the renovate-agent component. homelab-renovate-agent.service runs it as root through
# `ExecStartPre=+` before each session, so a pin bump or a rebuilt host converges on the next tick.
# homelab-renovate-agent-setup.service runs it at boot and when it or the packaged Claude Code
# settings change, so the agent has its settings while it is disarmed.
#
# Usage: renovate-agent-setup [-h|--help]
# Takes no arguments. Running it by hand as root applies every step below.
#
# Gives {{ pins.user }} its home, the operator's pinned uv, uvx and prek, the operator's
# claude_guard package, claude_worktree module and Claude Code hook scripts, the packaged Claude
# Code settings, the pinned Python, Claude Code and its own clone. Each run copies the settings
# over the agent's, so an edit a session makes to them lasts until the next run.
# Every step is idempotent. The agent runs every command that writes into its home, because the
# session could have replaced any path there with a link. Root only reads the operator's copies,
# which the agent cannot read, into a staging directory the agent then copies from.
set -euo pipefail

case "${1-}" in
  -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
esac

agent={{ pins.user }}
home={{ renovate_agent_home }}
clone={{ renovate_agent_clone_dir }}
operator=/home/{{ sys_user }}
settings=/usr/lib/homelab/renovate-agent/claude-settings.json

as_agent() {
  runuser -u "$agent" -- env HOME="$home" TMPDIR=/tmp PATH=/usr/bin:/bin "$@"
}

# Group sys_user and setgid, so the operator reads what the agent writes. /var/lib is root's, so the
# agent cannot have replaced the home itself.
install -d -o "$agent" -g {{ sys_user }} -m 2750 "$home"

# The controller's home holds the run's state. Group sys_user and setgid, so the docs-refresh
# reader, which runs as sys_user, reads runs.jsonl as it read it in the agent's home.
ctl={{ pins.ctl_user }}
ctl_home={{ pins.ctl_home }}
install -d -o "$ctl" -g {{ sys_user }} -m 2750 "$ctl_home"
# The exchange: the controller owns it, and the session's group may only traverse it. The runner
# recreates its requests/ and out/ children each run, setgid and group-writable, so the session
# writes there and the controller reads what it wrote; the session cannot replace either child.
install -d -o "$ctl" -g "$agent" -m 2750 {{ pins.exchange_dir }}
# The records a run wrote in the agent's home before the controller owned them, copied once.
for name in runs.jsonl requests.jsonl last_run; do
  if [ -f "$home/$name" ] && [ ! -L "$home/$name" ] && [ ! -e "$ctl_home/$name" ]; then
    install -o "$ctl" -g {{ sys_user }} -m 0640 "$home/$name" "$ctl_home/$name"
  fi
done
as_agent mkdir -p "$home/.local/bin" "$home/.local/share/claude-guard" "$home/.local/share/claude-worktree" "$home/.claude"

stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
chmod 0755 "$stage"

# Copies one operator file or tree to its destination in the agent's home, when it exists.
copy_from_operator() {
  local source="$1" destination="$2" name
  [[ -e "$source" ]] || return 0
  name=$(basename "$source")
  cp -RL --no-preserve=ownership "$source" "$stage/$name"
  chmod -R a+rX "$stage/$name"
  as_agent cp -RT --remove-destination "$stage/$name" "$destination"
  rm -rf "${stage:?}/$name"
}

copy_from_operator "$operator/.local/bin/uv" "$home/.local/bin/uv"
copy_from_operator "$operator/.local/bin/uvx" "$home/.local/bin/uvx"
copy_from_operator "$operator/.local/share/uv/tools/prek/bin/prek" "$home/.local/bin/prek"
copy_from_operator "$operator/.local/share/claude-guard/claude_guard" "$home/.local/share/claude-guard/claude_guard"
copy_from_operator "$operator/.local/share/claude-worktree/claude_worktree.py" "$home/.local/share/claude-worktree/claude_worktree.py"
copy_from_operator "$operator/.claude/hooks" "$home/.claude/hooks"
as_agent cp --remove-destination "$settings" "$home/.claude/settings.json"

(cd "$home" && as_agent "$home/.local/bin/uv" python install {{ host_python_version }})

# DECIDED: the install script is fetched unpinned, as the operator's install is. Claude Code updates
# itself afterwards, so a pinned checksum would only hold back the first install.
if [[ ! -x "$home/.local/bin/claude" ]]; then
  curl -fsSL --retry 3 -o "$stage/claude-install.sh" https://claude.ai/install.sh
  chmod 0644 "$stage/claude-install.sh"
  (cd "$home" && as_agent env CLAUDE_INSTALL_ALLOW_SUDO=1 bash "$stage/claude-install.sh")
fi

if [[ ! -d "$clone/.git" ]]; then
  as_agent git clone --quiet "https://github.com/{{ renovate_agent_repo }}.git" "$clone"
fi
