{% import 'templates/renovate-agent-pins.j2' as pins with context -%}
// Shipped by the renovate-agent component.
//
// Lets the controller START the session unit, and nothing else. The session's own user holds no
// start right (dotfiles#967's I1).
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return undefined;
    }
    if (subject.user !== "{{ pins.ctl_user }}") {
        return undefined;
    }
    if (action.lookup("unit") !== "homelab-renovate-agent-session.service") {
        return undefined;
    }
    if (action.lookup("verb") !== "start") {
        return undefined;
    }
    return polkit.Result.YES;
});
