# Shipped by the renovate-agent component. Read by systemd as root through
# homelab-renovate-agent.service's EnvironmentFile=, so no value appears in a unit line.
# GH_TOKEN: the runner's fine-grained token for {{ renovate_agent_repo }} alone, with no
# contents write; the runner makes every GitHub write the session requests with it.
# RENOVATE_SESSION_GH_TOKEN: a read-only token for the same repo, which the runner hands the
# session as its GH_TOKEN (guardrails plan B1). CLAUDE_CODE_OAUTH_TOKEN: from `claude setup-token`.
GH_TOKEN={{ renovate_agent_gh_token }}
RENOVATE_SESSION_GH_TOKEN={{ renovate_agent_gh_read_token }}
CLAUDE_CODE_OAUTH_TOKEN={{ renovate_agent_claude_oauth_token }}
