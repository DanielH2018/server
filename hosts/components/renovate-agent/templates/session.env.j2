# Shipped by the renovate-agent component. Read by systemd as root through
# homelab-renovate-agent-session.service's EnvironmentFile=, so no value appears in a unit line.
# GH_TOKEN: a read-only token for {{ renovate_agent_repo }} alone (guardrails plan B1); the
# controller makes every GitHub write the session requests, with its own token in ctl.env.
# CLAUDE_CODE_OAUTH_TOKEN: from `claude setup-token`.
GH_TOKEN={{ renovate_agent_gh_read_token }}
CLAUDE_CODE_OAUTH_TOKEN={{ renovate_agent_claude_oauth_token }}
