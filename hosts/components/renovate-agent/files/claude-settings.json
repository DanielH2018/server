      "Bash(* | sh *)",
      "Bash(* | sh;*)",
      "Bash(* | sh&*)",
      "Bash(* | sh|*)",
      "Bash(* | sh)*)",
      "Bash(* | sh\n*)",
      "Bash(* | bash)",
      "Bash(* | bash *)",
      "Bash(* | bash;*)",
      "Bash(* | bash&*)",
      "Bash(* | bash|*)",
      "Bash(* | bash)*)",
      "Bash(* | bash\n*)",
      "Bash(* | zsh)",
      "Bash(* | zsh *)",
      "Bash(* | zsh;*)",
      "Bash(* | zsh&*)",
      "Bash(* | zsh|*)",
      "Bash(* | zsh)*)",
      "Bash(* | zsh\n*)",
