# Shipped by the host package's k3s-host-dns component.
[Unit]
Description=CoreDNS host forwarder (Pi-hole first, public fallback)
Documentation=https://coredns.io/plugins/forward/
# Before the k3s server, not required by it: k3s reaches its components by IP, so this only brings
# DNS up first.
Before=k3s.service
After=network-online.target
Wants=network-online.target

[Service]
# This host's journald stores notice and above (MaxLevelStore=notice), so stdout logs at notice.
SyslogLevel=notice
# Unprivileged, holding only the right to bind 53. DynamicUser gives a per-boot uid with no home or
# shell.
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# AF_UNIX is for the Go runtime and journald; omitting it risks a startup failure whose only symptom
# is no DNS.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX

ExecStart={{ k3s_host_coredns_bin }} -conf {{ k3s_host_coredns_conf }}
# SIGUSR1 re-reads the Corefile in place: resolv.conf names only this process, so a restart is
# seconds with no DNS.
ExecReload=/bin/kill -USR1 $MAINPID

# Restart=always, not on-failure. A clean exit is still an outage — see above.
Restart=always
RestartSec=1s

[Install]
WantedBy=multi-user.target
