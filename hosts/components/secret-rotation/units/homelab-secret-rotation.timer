# Shipped by homelab-daniel-box with its enable link. Sunday 09:00, after the 07:30 reboot, the
# 06:xx redeploys and the 08:30 daily audit have all settled, which keeps a rotation clear of a
# concurrent operator session. Not Persistent: the cron it replaces skipped a slot inside an
# outage, and the next slot is +7 days either way (the script's own comment has the lead-time
# arithmetic).
[Unit]
Description=Weekly secret rotation (auto tier) (timer)

[Timer]
OnCalendar=Sun *-*-* 09:00:00

[Install]
WantedBy=timers.target
