# Shipped by homelab-daniel-box. Started by homelab-secret-rotation.timer.
#
# Rotates the coming-due auto-tier push tokens, commits, and publishes through a PR. It takes the
# shared git-tree lock inside the script, so it never overlaps the deployer. Its failures reach
# the "Secret Rotation" Kuma tile through the script's own push, and the daily audit keeps that
# tile red while a rotation commit sits unpushed.
[Unit]
Description=Weekly secret rotation (auto tier)
After=network-online.target homelab-secrets.service
Wants=network-online.target homelab-secrets.service

[Service]
SyslogLevel=notice
Type=oneshot
User={{ sys_user }}
ExecStart=/usr/lib/homelab/secret-rotate
LoadCredential=secret_rotation_push_token:/run/credstore/secret_rotation_push_token
# Journal tag the cron's `logger -t secret-rotate` used, so `journalctl -t secret-rotate` and the
# Loki streams keyed on it keep working.
SyslogIdentifier=secret-rotate
