# Shipped by homelab-daniel-box. Started by homelab-secret-rotation.timer.
#
# Rotates the coming-due auto-tier push tokens, commits, and publishes through a PR. It takes the
# shared git-tree lock inside the script, so it never overlaps the deployer. Its failures are
# `status=down` lines in the journal, and the daily audit reports a rotation that left a dirty
# tree, an unpushed commit or an unlanded branch.
[Unit]
Description=Weekly secret rotation (auto tier)
After=network-online.target
Wants=network-online.target

[Service]
SyslogLevel=notice
Type=oneshot
User={{ sys_user }}
ExecStart=/usr/lib/homelab/secret-rotate
# Journal tag the cron's `logger -t secret-rotate` used, so `journalctl -t secret-rotate` and the
# Loki streams keyed on it keep working.
SyslogIdentifier=secret-rotate
