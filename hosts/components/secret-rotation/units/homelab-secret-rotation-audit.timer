# Shipped by homelab-daniel-box with its enable link. Daily at 08:30, after the Sunday reboot's
# Alertmanager mute (07:25-08:15) closes, so the run sees the hosts back up and a failed
# verdict pages at once.
[Unit]
Description=Daily secret rotation audit (timer)

[Timer]
OnCalendar=*-*-* 08:30:00
# Persistent=true: a slot inside an outage runs once at boot; a check red before a reboot is rerun
# by the -boot unit.
Persistent=true

[Install]
WantedBy=timers.target
