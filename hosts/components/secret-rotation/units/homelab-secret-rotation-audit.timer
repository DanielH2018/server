# Shipped by homelab-daniel-box with its enable link. Daily at 08:30, after the Sunday reboot's
# Alertmanager mute (07:25-08:15, #2802) closes, so the run sees the hosts back up and a failed
# verdict pages at once (#4540).
[Unit]
Description=Daily secret rotation audit (timer)

[Timer]
OnCalendar=*-*-* 08:30:00
# Persistent=true, decided 2026-09-19: a slot that fell inside an outage runs once at boot
# instead of leaving the tile red until the next slot. A check that went red before a reboot
# already fired its slot, so homelab-secret-rotation-audit-boot.service reruns it (#4495).
Persistent=true

[Install]
WantedBy=timers.target
