# Shipped by homelab-daniel-box. Started by homelab-secret-rotation-audit.timer.
#
# THE CONTRACT IS THE EXIT CODE (the kuma-check form M6 left, roles/setup/common/tasks/
# kuma_check_timer.yml). The audit pushes its verdict to the "Secret Rotation" Kuma monitor and
# exits 1 after `down`, 0 after `up`. Restart=on-failure reruns it every RestartSec until it
# exits 0, so a tile that went red clears within 30 minutes of the fix rather than at the next
# 08:30.
[Unit]
Description=Daily secret rotation audit (Kuma push)
After=network-online.target homelab-secrets.service
Wants=network-online.target homelab-secrets.service
# No OnFailure= alert unit, deliberately. A down verdict is a unit failure by this contract, and
# the *-alert.service units page Discord on a unit that BROKE. The tile carries the verdict.

[Service]
SyslogLevel=notice
Type=oneshot
User={{ sys_user }}
ExecStart=/usr/lib/homelab/secret-rotation-audit
LoadCredential=secret_rotation_push_token:/run/credstore/secret_rotation_push_token
# The audit logs under its own tag for `probe.py alerts`; the journal tag follows.
SyslogIdentifier=secret-rotation-audit
# Only Restart=always and Restart=on-success are refused for Type=oneshot (systemd 255).
Restart=on-failure
RestartSec=30min
# The restart loop lives in memory, so a reboot ends it. This marker survives the reboot and
# gates homelab-secret-rotation-audit-boot.service, which reruns the audit once at boot while
# the last verdict was not up (#4495). `+` runs it as root whatever User= is, and `$$` hands the
# variable to the shell rather than to systemd's own substitution.
ExecStopPost=+/bin/sh -c 'if [ "$$SERVICE_RESULT" = success ]; then rm -f /var/lib/kuma-check/secret-rotation-audit.down; else mkdir -p /var/lib/kuma-check && touch /var/lib/kuma-check/secret-rotation-audit.down; fi'
