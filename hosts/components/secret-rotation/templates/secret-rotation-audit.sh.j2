#!/usr/bin/env bash
# Daily secret-rotation audit — shipped by the homelab-daniel-box package (secret-rotation).
#
# Usage: secret-rotation-audit [-h|--help]
# Takes no arguments. systemd timer homelab-secret-rotation-audit.timer runs it as the deploy
# user daily at 08:30 on daniel-box, and again every 30 minutes while the last run failed. It is
# read-only, so running it by hand is safe.
#
# Runs scripts/secrets_mgmt/secret_rotation.py audit --verdict, which reads the rotation registry
# (ansible/secret_rotation.yml) and exits 1 on a DOWN audit: any secret past its per-tier
# rotation window, or a secret in secrets.yml but not the registry (reminding the operator to
# `secret_rotation.py sync` + commit). Read-only by design — the cron never edits the git-tracked
# registry, so git stays the source of truth; rotation is an explicit operator action. The exit
# code becomes secret-rotation-audit.prom, which SecretRotationAuditFailed and
# SecretRotationAuditNotReporting read.
set -uo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

# What scripts/lib/gh.py sets for every Python caller, and this cron calls `gh auth status`
# directly and reads its result. A `gh` that prompts hangs an unattended run forever, and the
# update notifier writes to stderr on the first call of the day — which this script, which
# treats a failed auth check as "the token is not authenticated", must not mistake for one.
export GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1

# shellcheck source=/dev/null
source /usr/lib/homelab/homelab-check-lib.sh || {
  logger -t secret-rotation-audit "homelab-check-lib.sh missing — the homelab-daniel-box package ships it"
  exit 1
}

# The longest legitimate gap between two textfile writes: the timer fires daily at 08:30 (86400s),
# and the extra hour is margin for a slow run. Each run writes
# $TEXTFILE_DIR/secret-rotation-audit.prom for node_exporter's textfile collector (default
# /var/lib/node-exporter-textfile; a test points it elsewhere).
# ansible/tests/services/test_not_reporting_rule_deadlines.py pins the rules' literals to it.
DEADLINE_S=90000
# write_audit_textfile EXIT_CODE -- the audit's verdict: up when the run exited 0, down otherwise.
write_audit_textfile() {
  write_check_textfile secret-rotation-audit "$([ "$1" -eq 0 ] && echo 1 || echo 0)" "$(date +%s)" "$DEADLINE_S" \
    || logger -t secret-rotation-audit "textfile write failed (exit code $1)"
}

cd /home/{{ sys_user }}/server || exit 1

EXTRA_DOWN=""

# Each fault ADDS its reason, so a second one does not overwrite the first.
add_down() {
  if [ -n "$EXTRA_DOWN" ]; then EXTRA_DOWN="$EXTRA_DOWN; $1"; else EXTRA_DOWN="$1"; fi
  logger -t secret-rotation-audit "status=down $1"
}

# The `gh` OAuth token docs-refresh and eval-run publish with. It is not in secrets.yml or the
# rotation registry: a registry entry for a non-SOPS credential permanently fails CI
# (registry_drift -> cmd_audit exit 1 -> prek). Revoked, both crons push a branch, fail at
# `gh pr create`, and stop publishing silently.
#
# Gate on the EXIT STATUS only. A network timeout prints a failure line and still exits 0
# (observed 2026-08-25), so exit status moves only on a real auth failure, which needs a human.
if ! gh auth status >/dev/null 2>&1; then
  add_down "the gh CLI token is not authenticated — docs-refresh and eval-run can still commit but cannot open a PR, so both stop publishing silently; re-run \`gh auth login\`"
fi

# uv (absolute path — cron's PATH lacks it) syncs the pinned env, then runs the auditor.
# --frozen: never rewrite uv.lock on the host — a rewrite would dirty the tree and wedge the
# GitOps deployer's dirty-skip.
UV=/home/{{ sys_user }}/.local/bin/uv
# Not `exec`: the audit's exit code is its verdict (0 up, 1 down, 64 on a bad argument), and
# the textfile write below has to run after it. The script then exits with that code, which is
# the timer's contract.
if [ -n "$EXTRA_DOWN" ]; then
  $UV run --frozen python scripts/secrets_mgmt/secret_rotation.py audit --verdict --extra-down "$EXTRA_DOWN"
else
  $UV run --frozen python scripts/secrets_mgmt/secret_rotation.py audit --verdict
fi
AUDIT_RC=$?
write_audit_textfile "$AUDIT_RC"
exit "$AUDIT_RC"
