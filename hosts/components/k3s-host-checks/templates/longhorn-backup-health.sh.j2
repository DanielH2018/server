#!/usr/bin/env bash
# Longhorn backup-plane heartbeat — shipped by the k3s-host-checks component.
#
# Usage: longhorn-backup-health.sh [-h|--help]
# Takes no arguments. homelab-longhorn-backup-health.timer runs it as the deploy user every
# k3s_longhorn_backup_health_cron_minute minutes. It is
# read-only against the cluster. Each run writes its verdict to $TEXTFILE_DIR/longhorn-backup-health.prom
# for node_exporter's textfile collector, then pings Healthchecks.io with the optional ping key
# from the unit's credential. Prometheus rules in host-checks.yaml page the verdict through
# Alertmanager. Running it by hand is safe, but it pings Healthchecks.io.
#
# Thin on purpose. Everything that decides up-or-down is in longhorn_backup_health.py + its pure
# core (longhorn_backup_health_logic.py), which are plain files with unit tests; this exists only
# because the cron's tunables have to be templated in, and a templated file should hold as
# little logic as possible. Same shape as fake-remux-health.sh.
#
# The checks, and every incident that shaped one of their thresholds, are documented in
# longhorn_backup_health_logic.py rather than here.
#
# DECIDED: a host cron, not a monitor-bridge check (#3287). The bridge is an in-cluster pod on
# daniel-box, and checks 9-10 have an in-cluster path: Alloy ships daniel-box's /var/log/syslog
# to loki-homelab, where the `logger` lines check 9 matches are queryable,
# and /etc/cron.d is reachable over a hostPath. What a fold would cost:
#   - Checks 1-8 read Longhorn CRs through kubectl. The bridge has no ServiceAccount or RBAC and
#     never calls the Kubernetes API, so a fold adds a cluster-read grant to the alerting pod and
#     a stdlib API client.
#   - Check 9 on LogQL adds Alloy and Loki to the evidence path, and the bridge's Loki gate would
#     suppress it during a Loki outage.
#   - This script's hc-ping is the backup plane's off-site channel, independent of the bridge. A
#     bridge outage would blind backup monitoring too.
# The reader and logic module would move and be rewritten rather than shrink. Revisit if the bridge gains Kubernetes API access for another check.
#
# The textfile write and the boot-grace test come from /usr/lib/homelab/homelab-check-lib.sh, which
# the check-lib component ships.
#
# Reads the cluster through the read-only ServiceAccount kubeconfig (k3s role), so the cron needs
# no sudo and cannot mutate anything.
#
# Every LONGHORN_* tunable this shim exports is REQUIRED by the reader (no hardcoded fallback — see
# `_require_env()` in longhorn_backup_health.py). A shim that drops one exits nonzero and reports
# "reader failed" naming the variable, rather than silently substituting a stale constant.
#
# The reader issues up to 18 kubectl calls (+1 BackupTarget list that carries each target's arm
# state, URL, availability and reason, +1 RecurringJob list that carries the run times, +1 backup
# list that checks 2 to 5 share, +9 per-tier, +1 r2-set, +1 Job list that check 6 and the trim
# arm share, +1 restore-drill stamp ConfigMap for checks 7 and 8, +1 RecurringJob pod-log read
# that checks 9 and 11 share, +1 trim CronJob for checks 9 and 10, +1 ETCDSnapshotFile list for
# check 12), each with a 30s timeout, plus
# the B2 arms' two journalctl reads at 10s each — a 560s worst case against this script's 600s
# cron period. `k3s kubectl` calls against the local API server return in well under a
# second in practice, and 30s is a timeout for a wedged cluster, not an expected duration. The margin is 40s, so one more kubectl call fits
# before one needs a shorter deadline or a longer cron period.
set -uo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

# shellcheck source=/dev/null
source /usr/lib/homelab/homelab-check-lib.sh || {
  logger -t longhorn-backup-health "homelab-check-lib.sh missing — the check-lib component ships it"
  exit 1
}

# The longest legitimate gap between two textfile writes: two cron periods plus 300s. One period is
# the normal gap, the second is a slot that a boot grace or a failed run skips, and the 300s covers
# cron start jitter, the 1m `node` scrape and the 1m rule evaluation. Rendered from the cron's own
# minute, read as `*/N`. Any other shape has no single period, so the render fails rather than
# publish a deadline shorter than the real gap. tests/services/alert_rules/test_b1_rule_literals.py
# pins the rule's literal to this value.
{% set _every_n = k3s_longhorn_backup_health_cron_minute | string | regex_replace('^[*]/([0-9]+)$', '\\1') %}
{% if _every_n.isdigit() and '*/' ~ _every_n == k3s_longhorn_backup_health_cron_minute | string %}
DEADLINE_S={{ 2 * 60 * (_every_n | int) + 300 }}
{% else %}
{{ longhorn_backup_health_cron_minute_not_every_n | mandatory('k3s_longhorn_backup_health_cron_minute must be */N for this script to derive DEADLINE_S, got ' ~ k3s_longhorn_backup_health_cron_minute) }}
{% endif %}
TEXTFILE_DIR=${TEXTFILE_DIR:-/var/lib/node-exporter-textfile}

export KUBECONFIG=/home/{{ sys_user }}/.kube/config

# Skip the first run after boot: `/fail` pages at once whatever the dead-man's grace. Exit 0, so the
# skip is no failure.
# A skipped run writes and pings nothing; DEADLINE_S and the dead-man's grace cover exactly one
# skipped slot.
if boot_grace_active {{ k3s_health_cron_boot_grace_s }} longhorn-backup-health; then
  exit 0
fi

# Arm state and run times are read live, not exported: a baked value goes stale after a Flux apply.
# The reader requires every LONGHORN_* var; kubectl is absolute because cron's PATH omits
# /usr/local/bin.
export LONGHORN_BACKUP_NAMESPACE="{{ k8s_longhorn_namespace }}"
export LONGHORN_BACKUP_KUBECTL="/usr/local/bin/k3s kubectl"
export LONGHORN_BACKUP_KUBECTL_TIMEOUT_S="30"
export LONGHORN_BACKUP_MAX_AGE_HOURS="{{ k3s_longhorn_backup_max_age_hours }}"
export LONGHORN_WEEKLY_BACKUP_MAX_AGE_HOURS="{{ k3s_longhorn_weekly_backup_max_age_hours }}"
export LONGHORN_BACKUP_ERROR_MAX_AGE_HOURS="{{ k3s_longhorn_backup_error_max_age_hours }}"
export LONGHORN_DAILY_BACKUP_BUDGET="{{ k3s_longhorn_daily_backup_budget }}"
export LONGHORN_RESTORE_DRILL_NAMESPACE="{{ k3s_longhorn_restore_drill_namespace }}"
export LONGHORN_RESTORE_DRILL_MAX_AGE_DAYS="{{ k3s_longhorn_restore_drill_max_age_days }}"
export LONGHORN_RESTORE_DRILL_COVERAGE_SLACK_DAYS="{{ k3s_longhorn_restore_drill_coverage_slack_days }}"
# Absolute, as cron's PATH is /usr/bin:/bin. Its own 10s timeout: 30s would push the worst-case run
# past the 600s cron period.
export LONGHORN_JOURNALCTL="${LONGHORN_JOURNALCTL:-/usr/bin/journalctl}"
export LONGHORN_JOURNAL_TIMEOUT_S="10"
export LONGHORN_CRON_EVIDENCE_WINDOW_HOURS="{{ k3s_longhorn_cron_evidence_window_hours }}"
# `_EXPECTED` mirrors the timer's own `when:`: it is installed only with a repo checkout, so other
# hosts must not be paged.
export LONGHORN_B2_DELETIONS_CRON_FILE="/usr/lib/systemd/system/homelab-b2-deletion-accounting.timer"
export LONGHORN_B2_DELETIONS_CRON_EXPECTED="{{ has_repo_checkout | bool }}"
# The stamp says whether the timer fired; the stat says only whether it is installed.
export LONGHORN_B2_DELETIONS_CRON_FIRED_STAMP="{{ k3s_cron_fired_stamp_dir }}/b2-deletion-accounting"
# Its `OVER BUDGET:` line is the one forward-looking reading of a B2 Class C cap breach.
export LONGHORN_B2_BUDGET_CRON_FILE="/usr/lib/systemd/system/homelab-b2-budget-listing.timer"
export LONGHORN_B2_BUDGET_CRON_EXPECTED="{{ has_repo_checkout | bool }}"
export LONGHORN_B2_BUDGET_CRON_FIRED_STAMP="{{ k3s_cron_fired_stamp_dir }}/b2-budget-listing"
# The Object Lock sweep's timer and stamp. Without a daily run, the old blocks' locks lapse.
export LONGHORN_B2_RETENTION_CRON_FILE="/usr/lib/systemd/system/homelab-b2-retention.timer"
export LONGHORN_B2_RETENTION_CRON_EXPECTED="{{ has_repo_checkout | bool }}"
export LONGHORN_B2_RETENTION_CRON_FIRED_STAMP="{{ k3s_cron_fired_stamp_dir }}/b2-retention"
# Check 12's bound and arm state, which the `homelab-daniel-box` package writes here.
export LONGHORN_ETCD_DROP_IN="/etc/rancher/k3s/config.yaml.d/50-homelab.yaml"

# Last stdout line is `up|down<TAB>msg`; the reader exits 0, so nonzero or empty output means it
# broke.
# Stdout and stderr are captured separately: a merged stderr warning could become STATUS and ping
# `/fail`.
DETAILS=()
if ! ERR_FILE=$(mktemp /tmp/longhorn-backup-health.XXXXXX); then
  STATUS=down
  MSG="longhorn backup health reader failed: mktemp could not create a stderr capture file"
  logger -t longhorn-backup-health "status=${STATUS} ${MSG}"
else
  OUT=$(/usr/bin/uv run --no-project --no-python-downloads --python {{ host_python_version }} /usr/lib/homelab/longhorn-backup-health/longhorn_backup_health.py 2>"$ERR_FILE")
  RC=$?
  ERR=$(cat "$ERR_FILE" 2>/dev/null || true)
  rm -f "$ERR_FILE"
  # Verdict = last line opening with `up<TAB>`/`down<TAB>`: a multi-line message leaves its tail
  # last.
  # The class is a slug the reader fixes, so no label value needs escaping.
  LAST_LINE="${OUT##*$'\n'}"
  while IFS= read -r line; do
    if [[ "$line" == up$'\t'* || "$line" == down$'\t'* ]]; then
      LAST_LINE="$line"
    elif [[ "$line" =~ ^detail$'\t'([a-z0-9-]+)$ ]]; then
      DETAILS+=("${BASH_REMATCH[1]}")
    fi
  done <<< "$OUT"
  # STATUS must be `up` or `down` before anything trusts it: a tab-less last line would ping `/fail`
  # on an undefined status, so treat it as a reader crash.
  if [[ $RC -ne 0 || -z "$LAST_LINE" ]]; then
    STATUS=down
    DETAILS=()
    MSG="longhorn backup health reader failed: ${ERR:-${OUT:-(no output)}}"
    # The reader never logged its verdict on this path, so log here: it is the failure with no other
    # journalctl record.
    logger -t longhorn-backup-health "status=${STATUS} ${MSG}"
  else
    STATUS="${LAST_LINE%%$'\t'*}"
    MSG="${LAST_LINE#*$'\t'}"
    if [[ "$STATUS" != "up" && "$STATUS" != "down" ]]; then
      # The whole output, flattened: what the reader printed ahead of the last line is the only
      # explanation.
      FLAT_OUT="${OUT//$'\n'/ | }"
      logger -t longhorn-backup-health "status=down reader printed an unrecognized status: ${FLAT_OUT}"
      MSG="longhorn backup health reader printed an unrecognized status: ${FLAT_OUT}"
      STATUS=down
      DETAILS=()
    elif [[ -n "$ERR" ]]; then
      # A green run's stderr may hold a kubectl RBAC or uv warning; log it too.
      logger -t longhorn-backup-health "status=${STATUS} stderr: ${ERR}"
    fi
  fi
fi

# Textfile before the ping: the verdict must not wait on the network. A failed write logs and the
# ping still runs.
SUCCESS=0
[[ "$STATUS" == "up" ]] && SUCCESS=1
# One series per problem class on a down verdict, so a second problem opens its own alert.
DETAIL_LINES=()
if [[ "$STATUS" == "down" && -n "${DETAILS[*]}" ]]; then
  DETAIL_LINES+=(
    "# HELP homelab_check_detail 1 for each problem class the check's last down verdict named."
    "# TYPE homelab_check_detail gauge"
  )
  for detail in "${DETAILS[@]}"; do
    DETAIL_LINES+=("homelab_check_detail{check=\"longhorn-backup-health\",detail=\"${detail}\"} 1")
  done
fi
write_check_textfile longhorn-backup-health "$SUCCESS" "$(date +%s)" "$DEADLINE_S" "${DETAIL_LINES[@]}" \
  || logger -t longhorn-backup-health "textfile write to ${TEXTFILE_DIR} failed (status=${STATUS})"

# Off-site dead-man's switch: Prometheus runs on this cluster, so hc-ping.com alerts on the silence.
# Skipped with no key. A credential, not inlined: this script is 0755.
HC_PING_KEY=""
if [[ -r "${CREDENTIALS_DIRECTORY:-/nonexistent}/healthchecks_ping_key" ]]; then
  HC_PING_KEY="$(<"$CREDENTIALS_DIRECTORY/healthchecks_ping_key")"
fi
if [[ -n "$HC_PING_KEY" ]]; then
  # Bare slug, not ?create=1: auto-provisioning turns a typo into an unwatched check that reads
  # green forever.
  HC_URL="https://hc-ping.com/${HC_PING_KEY}/longhorn-backup-health"
  [[ "$STATUS" == "up" ]] || HC_URL="${HC_URL}/fail"
  # `-fs` without `-S`, stderr discarded: `--retry` warnings would be cron-mailed from a successful
  # run.
  # The `|| logger` below reports a real failure.
  curl -fs --max-time 10 --retry 3 --data-raw "$MSG" "$HC_URL" >/dev/null 2>&1 \
    || logger -t longhorn-backup-health "healthchecks ping failed (status=${STATUS})"
fi
