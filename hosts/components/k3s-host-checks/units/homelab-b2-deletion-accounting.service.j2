# Shipped by the host package's k3s-host-checks component. Started by homelab-b2-deletion-accounting.timer.
[Unit]
Description=Charge each completed backup deletion to the B2 ledger
After=network-online.target k3s.service
Wants=network-online.target homelab-secrets.service

[Service]
SyslogLevel=notice
Type=oneshot
User={{ sys_user }}
WorkingDirectory=/home/{{ sys_user }}/server
# Without KUBECONFIG the read-only kubectl falls back to a root-owned k3s.yaml, so the BackupTarget
# lookup that decides B2-versus-R2 would fail only when unattended.
Environment=PATH=/usr/local/bin:/usr/bin:/bin KUBECONFIG=/home/{{ sys_user }}/.kube/config
# Check 10's fire stamp. `-`: a stamp that cannot be written must not stop the accounting.
ExecStartPre=-/usr/bin/touch {{ k3s_cron_fired_stamp_dir }}/b2-deletion-accounting
ExecStart=/home/{{ sys_user }}/.local/bin/uv run --quiet python scripts/diagnostics/probe.py b2-deletions
# Checks 9 and 10 read this tag from the journal, matching each line as written.
SyslogIdentifier=b2-deletions
