# Shipped by the host package's k3s-host-checks component. Started by homelab-longhorn-backup-health.timer.
[Unit]
Description=Read the Longhorn backup plane and report the verdict
After=network-online.target homelab-secrets.service k3s.service
Wants=network-online.target homelab-secrets.service

[Service]
SyslogLevel=notice
Type=oneshot
User={{ sys_user }}
ExecStart=/usr/lib/homelab/longhorn-backup-health.sh
SyslogIdentifier=longhorn-backup-health
# Import, not Load: Load fails the unit on a missing file, and the check must still write its verdict.
ImportCredential=healthchecks_ping_key
