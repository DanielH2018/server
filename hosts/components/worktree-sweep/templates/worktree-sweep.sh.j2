#!/usr/bin/env bash
# Weekly worktree sweep, git object-store repair and uv cache prune, then a Healthchecks.io
# ping carrying the sweep's exit code.
#
# Usage: worktree-sweep [-h|--help]
# Takes no arguments. It sweeps `$HOME/server`, the clone of the user it runs as.
# homelab-worktree-sweep.timer runs it as sys_user on each host whose package lists the
# worktree-sweep component, on Sunday at 04:20 UTC. homelab-claude-worktree-sweep.timer, from
# the claude-code component, runs it as the agent user in the agent's clone. Running it by hand
# removes merged worktrees and drops unreachable objects for real.
#
# The pruner is the dotfiles repo's, deployed by `chezmoi apply` for each user at
# ~/.claude/hooks/prune-worktrees.py, and it reads this repo's policy from
# .claude/prune-worktrees.json. `--prune --brief` removes the merged worktrees, deletes the
# unregistered directories under .claude/worktrees/ whose every file a ref already reaches,
# deletes the orphan session branches (`worktree-*` and `claude/*`) whose content is on
# origin/master, then drops the unreachable objects older than a day and clears git's stale gc log.
#
# A HOST WITH NO PRUNER, OR AN OLD ONE, FAILS THE RUN. `--require` names the pruner interface
# this repo was written for (scripts/lib/_claude_worktree.py:REQUIRED_INTERFACE). A copy older
# than that exits 78, a copy with no package beside it exits 69, and no copy at all exits 127.
# None of the three reads as "nothing to remove": `chezmoi apply` on the host is the repair.
#
# A CHECKOUT WITH NO POLICY FILE FAILS THE RUN TOO. Without .claude/prune-worktrees.json the
# pruner falls back to strict defaults, keeps every fan-out tree and exits 0, which reads as
# "nothing to remove". The script skips the pruner and exits 66 instead. The cause is a
# primary checkout that homelab-checkout-sync has stopped fast-forwarding: `git pull --ff-only`
# in it is the repair.
#
# THE SWEEP ALSO PRUNES THE USER'S UV CACHE. uv keeps every wheel a lock has ever named, and
# nothing else removes one, so daniel-server's cache had grown to 2.8 GB. `uv cache prune` keeps
# what master's lock needs, and an offline `uv sync --frozen` succeeds against the pruned cache.
# A venv hardlinks what it uses, so a pruned file a live venv still holds is freed when that
# worktree goes. uv locks its cache, so the prune is safe beside a running sync. A failed prune
# fails the run, unless the pruner already failed it with its own code.
#
# THE EXIT CODE REACHES HEALTHCHECKS.IO. The pruner exits 1 when a removal or a
# branch deletion failed. `$rc` on the ping URL is Healthchecks.io's exit-status
# endpoint: 0 is a success ping and anything else is a failure, so a failed sweep pages at once
# and a sweep that never ran pages on silence. The key arrives as the systemd credential
# `healthchecks_ping_key`, which the unit imports from /run/credstore. daniel-server's package
# retires the old key file, so the credential is the one source both hosts carry.
# Without a key the script sends no ping. The agent's unit imports no key, so the agent never
# holds it, and that unit pages through OnFailure= instead. The check is named for the host:
# `<host>-worktree-sweep`.
set -u

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

cd "$HOME/server" || exit 1
# DECIDED: the banner REPORTS, the weekly timer PRUNES. No SessionStart hook removes anything
# here: `.claude/prune-worktrees.json` sets `"session_start": "off"`. A prune removes worktrees
# and deletes branches in the primary checkout, which every session shares, and ends in a
# `git gc` with no bound on its duration. Run at every session start, N sessions would race
# for a saving one weekly run already gets. A worktree-isolated session's git commands are
# refused against the primary checkout, so the sessions that see the mess cannot clear it.
# PATH explicitly: the unit's environment inherits neither /usr/local/bin nor the user's
# ~/.local/bin, and the pruner's `branch_holds` command and the reap below both run `uv`.
export PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin
if [[ -f .claude/prune-worktrees.json ]]; then
  out="$("$HOME/.claude/hooks/prune-worktrees.py" --require 2 --prune --brief)"
  rc=$?
else
  out=""
  rc=66
  echo "no .claude/prune-worktrees.json in $PWD: the checkout is stale; run git pull --ff-only there"
fi
[ -n "$out" ] && printf '%s\n' "$out"
{% if inventory_hostname == ops_cron_host %}
# Only ops_cron_host reaps, and only in sys_user's checkout: `findings.py reap` judges claims
# against the worktrees and fan-out manifests of the checkout it runs in, so a reap on another
# host or in the agent's clone reads live claims as stale.
if [[ $HOME == /home/{{ sys_user }} ]]; then
  case "$out" in
    *"PRUNE-RESULT: removed="[1-9]*)
      uv run --quiet python scripts/dev/findings.py reap || echo "claims not reaped: reap exited $?"
      ;;
  esac
fi
{% endif %}
pruned="$(uv cache prune 2>&1)"
prune_rc=$?
if [[ $prune_rc -ne 0 ]]; then
  echo "uv cache not pruned: uv cache prune exited $prune_rc: ${pruned##*$'\n'}"
  [[ $rc -eq 0 ]] && rc=$prune_rc
else
  echo "uv cache: ${pruned##*$'\n'}"
fi
key=""
if [[ -r "${CREDENTIALS_DIRECTORY:-/nonexistent}/healthchecks_ping_key" ]]; then
  key="$(<"$CREDENTIALS_DIRECTORY/healthchecks_ping_key")"
fi
[ -n "$key" ] && curl -fs -m 10 --retry 3 "https://hc-ping.com/$key/$(hostname -s)-worktree-sweep/$rc" >/dev/null 2>&1
exit "$rc"
