# Shipped by homelab-daniel-box with its enable link. Sunday 04:20, the cron's slot. The values
# equal initial_setup_worktree_sweep_cron_* in the initial_setup defaults, which the deadman
# cadences fragment and monitor-bridge's Healthchecks.io expectation still read
# (hosts/lib/tests/test_worktree_sweep_component.py holds the two equal).
[Unit]
Description=Run the weekly worktree sweep on Sunday at 04:20

[Timer]
OnCalendar=Sun *-*-* 04:20:00
AccuracySec=1s

[Install]
WantedBy=timers.target
