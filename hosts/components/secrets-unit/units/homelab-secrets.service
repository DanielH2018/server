[Unit]
Description=Decrypt this host's secrets into /run/credstore and /run/homelab-secrets
Documentation=https://github.com/DanielH2018/server/blob/master/docs/target-architecture/host/h4-secrets-unit.md
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=60
Environment=SOPS_AGE_KEY_FILE=/etc/homelab/age.key
ExecStart=/usr/lib/homelab/homelab-secrets
