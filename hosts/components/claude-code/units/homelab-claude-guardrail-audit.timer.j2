# Shipped by both hosts' packages with its enable link, armed or not, so that setting
# claude_code_guardrail_audit_enabled false reaches a run that removes the watches. Every N
# minutes, where claude_code_guardrail_audit_minute is `*/N`; claude-guardrail-audit.sh.j2
# derives its textfile deadline from the same value and refuses any other shape.
{% set _every_n = claude_code_guardrail_audit_minute | string | regex_replace('^[*]/([0-9]+)$', '\\1') %}
[Unit]
Description=Load the guardrail audit watches every {{ _every_n }} minutes

[Timer]
OnCalendar=*-*-* *:00/{{ _every_n }}:00
AccuracySec=1s

[Install]
WantedBy=timers.target
