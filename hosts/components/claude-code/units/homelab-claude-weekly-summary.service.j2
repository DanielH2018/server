# Shipped by daniel-box's package while claude_code_weekly_summary_enabled. Started by
# homelab-claude-weekly-summary.timer.
[Unit]
Description=Post the weekly summary of the unattended Claude runs
After=homelab-secrets.service network-online.target
Wants=homelab-secrets.service network-online.target

[Service]
Type=oneshot
# Root, because only root reads both the triage controller's and the Renovate controller's records.
LoadCredential=discord_webhook:/run/credstore/discord_alert_webhook
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=10min
# Root has no pinned interpreter, so the unit keeps one in its state directory, as the builder does.
# ExecStartPre= installs it; only ExecStart= sets UV_PYTHON_DOWNLOADS=never.
StateDirectory=homelab-claude-weekly-summary
StateDirectoryMode=0700
Environment=UV_CACHE_DIR=/var/lib/homelab-claude-weekly-summary/uv-cache
Environment=UV_PYTHON_INSTALL_DIR=/var/lib/homelab-claude-weekly-summary/python
ExecStartPre=/usr/lib/homelab/bin/uv python install --no-bin {{ host_python_version }}
ExecStart=/usr/bin/env UV_PYTHON_DOWNLOADS=never /usr/lib/homelab/bin/uv run --no-project \
  --no-python-downloads --python {{ host_python_version }} \
  /usr/lib/homelab/claude-weekly-summary/claude_weekly_summary.py /etc/homelab/claude-weekly-summary.json
SyslogLevel=notice
# DECIDED: the tag stays `claude-weekly-summary`. It is a join key: Loki selects the run's
# `status=` line by it.
SyslogIdentifier=claude-weekly-summary
