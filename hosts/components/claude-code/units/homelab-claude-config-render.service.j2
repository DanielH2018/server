# Shipped by daniel-box's package while claude_code_config_render_enabled. Started by
# homelab-claude-config-render.timer. Renders the unattended sessions'
# Claude Code config from the verified dotfiles tag, as a user no session runs as.
[Unit]
Description=Render the unattended sessions' Claude Code config from the verified dotfiles tag
After=homelab-claude-dotfiles-mirror.service
ConditionPathExists=/var/lib/homelab-claude-dotfiles-mirror/verified.json
OnFailure=homelab-alert@%n.service

[Service]
Type=oneshot
# The render runs the dotfiles repo's templates, which can run commands, so it has its own user, no
# network and nothing writable but its runtime directory. Root never runs chezmoi.
User=claude-triage-render
Group=claude-triage-render
RuntimeDirectory=homelab-claude-config-render
RuntimeDirectoryMode=0700
UMask=0077
Environment=HOME=/run/homelab-claude-config-render/home
Environment=PATH=/usr/lib/homelab/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
TimeoutStartSec=10min
SyslogLevel=notice
SyslogIdentifier=claude-config-render
# The interpreter the dotfiles mirror installs (0755): this unit has no network to install one.
# Each step keeps its own uv cache, so root never writes where the render user can.
Environment=UV_PYTHON_INSTALL_DIR=/var/lib/homelab-claude-dotfiles-mirror/python
Environment=UV_PYTHON_DOWNLOADS=never
ExecStart=/usr/bin/env UV_CACHE_DIR=/run/homelab-claude-config-render/uv-cache \
  /usr/lib/homelab/bin/uv run --no-project --no-python-downloads --python {{ host_python_version }} \
  /usr/lib/homelab/claude-config-render/claude_config_render.py render
# `+` publishes as root outside the sandbox; reads the stage without following a link.
ExecStartPost=+/usr/bin/env UV_CACHE_DIR=/var/cache/homelab-claude-config-publish \
  /usr/lib/homelab/bin/uv run --no-project --no-python-downloads --python {{ host_python_version }} \
  /usr/lib/homelab/claude-config-render/claude_config_render.py publish
