# Shipped by homelab-daniel-box. Started by homelab-claude-otel-health.timer.
[Unit]
Description=Check that the OTLP receiver's loopback door is open and record the verdict

[Service]
Type=oneshot
# It only opens a loopback connection and writes a textfile, so it needs no privilege.
User={{ sys_user }}
SyslogLevel=notice
ExecStart=/usr/lib/homelab/claude-otel-health
# DECIDED: the tag stays `claude-otel-health`. It is a join key: a Loki query for the run's
# `status=` line selects it (claude-otel-health.sh.j2).
SyslogIdentifier=claude-otel-health
