{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/var/lib/claude-triage-tools/.claude/hooks/guard-permission-request.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/var/lib/claude-triage-tools/.claude/hooks/guard-pre-tool-use.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/var/lib/claude-triage-tools/.claude/hooks/protect-secrets.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.local/share/claude-guard/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
