#!/usr/bin/env bash
# The auditd watches on Claude Code's guardrail paths, and a verdict saying they are in place.
#
# Usage: claude-guardrail-audit [-h|--help]
# Takes no arguments. homelab-claude-guardrail-audit.timer runs it as root every N minutes of
# claude_code_guardrail_audit_minute. Each run loads a watch on every declared path that exists,
# removes a watch under its keys on a path the list no longer declares, then reads the loaded
# rules back. It logs a `status=<up|down>` line under the claude-guardrail-audit tag and writes
# claude-guardrail-audit.prom for node_exporter's textfile collector (TEXTFILE_DIR, default
# /var/lib/node-exporter-textfile). Prometheus's ClaudeGuardrailAuditFailed and
# ClaudeGuardrailAuditNotReporting rules page from that file.
#
# Down means one of: auditd is not running, so the kernel writes no audit record anywhere Alloy
# ships; kernel auditing is off; auditctl failed; or a declared path that exists has no watch
# after the run. A path that does not exist yet is counted, not a failure: the agent's memory
# store appears with its first session, and the next run watches it.
#
# Exit 0 = up, 1 = down.
set -uo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

export PATH="${PATH}:/usr/sbin:/sbin"

# shellcheck source=/dev/null
source /usr/lib/homelab/homelab-check-lib.sh || {
  logger -t claude-guardrail-audit "homelab-check-lib.sh missing — the check-lib component ships it"
  exit 1
}

# Two timer periods plus 300s, as the other claude-code timers derive theirs.
# ansible/tests/services/test_b6a_rule_literals.py pins the NotReporting rules to it.
{% set _every_n = claude_code_guardrail_audit_minute | string | regex_replace('^[*]/([0-9]+)$', '\\1') %}
{% if _every_n.isdigit() and '*/' ~ _every_n == claude_code_guardrail_audit_minute | string %}
DEADLINE_S={{ 2 * 60 * (_every_n | int) + 300 }}
{% else %}
{{ guardrail_audit_cron_minute_not_every_n | mandatory('claude_code_guardrail_audit_minute must be */N for claude-guardrail-audit to derive DEADLINE_S, got ' ~ claude_code_guardrail_audit_minute) }}
{% endif %}

push() { # up|down msg
  logger -t claude-guardrail-audit "status=$1 $2"
  write_check_textfile claude-guardrail-audit "$([[ "$1" == up ]] && echo 1 || echo 0)" "$(date +%s)" "$DEADLINE_S" \
    || logger -t claude-guardrail-audit "textfile write failed (status=$1)"
}

KEYS="claude-guardrail claude-memory"
ARMED={{ 'true' if claude_code_guardrail_audit_enabled else 'false' }}
# One `<key> <path>` per line.
DECLARED=$(
  sed '/^[[:space:]]*$/d' <<'WATCHES'
{% for path in claude_code_guardrail_audit_paths %}
claude-guardrail {{ path }}
{% endfor %}
{% for path in claude_code_guardrail_audit_memory_dirs %}
claude-memory {{ path }}
{% endfor %}
WATCHES
)

# loaded_paths KEY RULES — each path RULES (auditctl -l output) watches under KEY. auditctl
# prints a file watch as `-w PATH ... -k KEY` and a directory watch as `-F dir=PATH ... -F
# key=KEY`; both forms are read, and a trailing slash is dropped.
loaded_paths() {
  printf '%s\n' "$2" | awk -v key="$1" '
    {
      path = ""; k = ""
      for (i = 1; i <= NF; i++) {
        if ($i == "-w") path = $(i + 1)
        else if ($i ~ /^(dir|path)=/) { path = $i; sub(/^[a-z]+=/, "", path) }
        if ($i == "-k") k = $(i + 1)
        else if ($i ~ /^key=/) { k = $i; sub(/^key=/, "", k) }
      }
      if (k == key && path != "") { sub(/\/$/, "", path); print path }
    }'
}

if ! STATE=$(auditctl -s 2>&1); then
  push down "auditctl -s failed (${STATE//$'\n'/ }) — audit state UNVERIFIED"
  exit 1
fi
if ! RULES=$(auditctl -l 2>&1); then
  push down "auditctl -l failed (${RULES//$'\n'/ }) — watches UNVERIFIED"
  exit 1
fi

if [ "$ARMED" != true ]; then
  REMOVED=0
  for key in $KEYS; do
    while read -r path; do
      [ -n "$path" ] || continue
      auditctl -W "$path" -p wa -k "$key" >/dev/null 2>&1 && REMOVED=$((REMOVED + 1))
    done <<< "$(loaded_paths "$key" "$RULES")"
  done
  push up "disarmed (claude_code_guardrail_audit_enabled false): removed ${REMOVED} watches"
  exit 0
fi

ENABLED=$(awk '$1 == "enabled" { print $2 }' <<< "$STATE")
PID=$(awk '$1 == "pid" { print $2 }' <<< "$STATE")
if [ "$ENABLED" != 1 ] && [ "$ENABLED" != 2 ]; then
  push down "kernel auditing is off (enabled=${ENABLED:-unknown}) — no audit record is written"
  exit 1
fi
if [ -z "$PID" ] || [ "$PID" = 0 ]; then
  push down "auditd is not running (pid ${PID:-unknown}) — no audit record reaches audit.log"
  exit 1
fi

ADDED=() REMOVED=() ABSENT=0
while read -r key path; do
  if [ ! -e "$path" ]; then
    ABSENT=$((ABSENT + 1))
    continue
  fi
  loaded_paths "$key" "$RULES" | grep -qxF "$path" && continue
  auditctl -w "$path" -p wa -k "$key" >/dev/null 2>&1 && ADDED+=("$path")
done <<< "$DECLARED"
for key in $KEYS; do
  while read -r path; do
    [ -n "$path" ] || continue
    grep -qxF "$key $path" <<< "$DECLARED" && continue
    auditctl -W "$path" -p wa -k "$key" >/dev/null 2>&1 && REMOVED+=("$path")
  done <<< "$(loaded_paths "$key" "$RULES")"
done

if ! RULES=$(auditctl -l 2>&1); then
  push down "auditctl -l failed after the run (${RULES//$'\n'/ }) — watches UNVERIFIED"
  exit 1
fi
WATCHED=0 MISSING=() MISSING_N=0
while read -r key path; do
  [ -e "$path" ] || continue
  if loaded_paths "$key" "$RULES" | grep -qxF "$path"; then
    WATCHED=$((WATCHED + 1))
  else
    MISSING+=("$path")
    MISSING_N=$((MISSING_N + 1))
  fi
done <<< "$DECLARED"

DETAIL="added [${ADDED[*]}] removed [${REMOVED[*]}], ${ABSENT} declared paths not present"
if [ "$MISSING_N" -gt 0 ]; then
  push down "auditd pid ${PID}: ${MISSING_N} present paths have no watch [${MISSING[*]}]; ${DETAIL}"
  exit 1
fi
push up "auditd pid ${PID}: ${WATCHED} present paths watched; ${DETAIL}"
exit 0
