[Unit]
Description=Snapshot the per-PR pipeline timeline before its journal inputs rotate
After=network-online.target
Wants=network-online.target
OnFailure={{ claude_code_sync_alert_unit }}

[Service]
Type=oneshot
# The operator's user: in the adm group that reads the landing ledger and lander journal, holds the
# `gh` token, and its ssh key reaches daniel-server. It writes only under ~/.local/state/pipeline-timeline/.
User={{ sys_user }}
# DECIDED: the operator's checkout, for the reason claude-fanout-server-lander.service.j2
# gives: the agent's clone is not `ubuntu`'s to read.
WorkingDirectory={{ claude_code_operator_checkout }}
Environment=HOME=/home/{{ sys_user }}
Environment=PATH=/home/{{ sys_user }}/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
# journald here stores notice and above; without SyslogLevel=notice the run's summary is dropped.
SyslogLevel=notice
# One rsync of daniel-server's review records per run stays inside the `ufw limit ssh` budget.
TimeoutStartSec=30min
ExecStart=/usr/bin/uv run --no-python-downloads python scripts/dev/pipeline_timeline.py --days {{ claude_code_pipeline_timeline_days }} --pull-reviews {{ claude_code_pipeline_timeline_server_host }}
{% from 'templates/timer-textfile.j2' import timer_textfile with context %}
{{ timer_textfile('claude-pipeline-timeline', claude_code_pipeline_timeline_interval, 1800) }}
