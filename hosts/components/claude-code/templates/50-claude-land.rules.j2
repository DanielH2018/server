{% import 'templates/claude-land-pins.j2' as pins with context -%}
// Shipped by the claude-code host component (roles/setup/claude_code's template).
//
// Lets the agent user START one landing unit, and nothing else. The agent user has no sudo,
// so it cannot deploy what it merges.
// It asks for a landing by starting {{ pins.unit }}@<n>.service, which runs land.sh as the
// operator under the landing policy. The instance must be a plain PR number, so no other unit
// name or verb reaches this rule's YES.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return undefined;
    }
    if (subject.user !== "{{ pins.agent_user }}") {
        return undefined;
    }
    if (!/^{{ pins.unit }}@[1-9][0-9]{0,6}\.service$/.test(action.lookup("unit"))) {
        return undefined;
    }
    if (action.lookup("verb") !== "start") {
        return undefined;
    }
    return polkit.Result.YES;
});
