{% import 'templates/claude-triage-pins.j2' as pins with context -%}
# Nothing enables it, and reconcile never restarts it (`policy: manual`).
[Unit]
Description=Unattended triage session for the episode claude-triage@ prepared, as the session user
{% if t2_egress_proxy is defined %}
Wants=squid.service
After=squid.service
{% endif %}

[Service]
Type=oneshot
# The episode text is untrusted: this user holds no GitHub token, start right, sudo or read on
# /home.
# It reads the controller's clone and toolchain through its group and writes only its tmpfs mounts
# and out/.
User={{ pins.session_user }}
WorkingDirectory={{ pins.clone_dir }}
Environment=HOME={{ pins.session_home }}
# systemd sets SHELL from the passwd entry, which is nologin for this user; the Bash tool needs a
# real shell.
Environment=SHELL=/bin/bash
# systemd's PATH is as minimal as cron's: without /usr/local/bin the session loses kubectl and
# reports an empty cluster.
Environment=PATH={{ pins.tools_dir }}/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=KUBECONFIG={{ pins.kubeconfig }}
# The clone belongs to the controller, so git would refuse it as dubious ownership; the session has
# no file to edit.
Environment=GIT_CONFIG_COUNT=1
Environment=GIT_CONFIG_KEY_0=safe.directory
Environment=GIT_CONFIG_VALUE_0={{ pins.clone_dir }}
# A guard that cannot start turns every Bash call into an ask, and nobody answers one here.
# The controller syncs the clone's venv before each run, so a hook never tries to write it.
Environment=RUN_HOOK_PROJECT_DIR={{ pins.clone_dir }}
Environment=RUN_HOOK_UV={{ pins.tools_dir }}/.local/bin/uv
Environment=UV_NO_SYNC=1
Environment=UV_PYTHON_INSTALL_DIR={{ pins.tools_dir }}/python
Environment=UV_CACHE_DIR={{ pins.session_home }}/.cache/uv
# The guard hooks, the dotfiles' and the repo's, find their packages here, not under this user's
# home.
Environment=CLAUDE_GUARD_HOME={{ pins.tools_dir }}/.local/share/claude-guard
Environment=CLAUDE_WORKTREE_HOME={{ pins.tools_dir }}/.local/share/claude-worktree
# The controller owns the binary; the session cannot update it.
Environment=DISABLE_AUTOUPDATER=1
# No error reports or telemetry to Claude Code's third-party intakes, which the egress allowlist
# leaves out.
Environment=CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# gh's telemetry goes to cafe.github.com, which the egress allowlist leaves out too.
Environment=GH_TELEMETRY=false
# A memory written here would die with the tmpfs home, and none may reach a later run (I2).
Environment=CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
Environment=PYTHONDONTWRITEBYTECODE=1
{% if t2_egress_proxy is defined %}
# curl reads only the lowercase names, and Go tools both. Loopback stays direct: the kubeconfig
# names the host's LAN address.
Environment=HTTPS_PROXY=http://{{ t2_egress_proxy }} https_proxy=http://{{ t2_egress_proxy }}
Environment=HTTP_PROXY=http://{{ t2_egress_proxy }} http_proxy=http://{{ t2_egress_proxy }}
Environment=NO_PROXY=localhost,127.0.0.1,::1 no_proxy=localhost,127.0.0.1,::1
# probe.py's in-cluster reads go to squid as plain HTTP, the only form squid admits for them.
Environment=HOMELAB_PROBE_VIA_PROXY=1
{% endif %}
# The Claude credential from `claude setup-token`, read by systemd as root (0600) into
# $CREDENTIALS_DIRECTORY, so it is in no unit line `systemctl show` publishes. A credential rather
# than an EnvironmentFile=, because a token pasted across a line wrap would end at the newline
# there; the session script joins the whole file.
LoadCredential=claude_oauth_token:/etc/claude-triage/oauth-token
SyslogLevel=notice
# SIGINT ends the turn cleanly; SIGTERM exits 143 with the turn unrecorded. The runner reads
# Result=timeout as a timed-out session.
KillSignal=SIGINT
TimeoutStartSec={{ pins.run_timeout_s }}
NoNewPrivileges=yes
# DECIDED: UMask=0027, so the result the session writes is readable by the controller through
# the session's group and by nobody else.
UMask=0027
ProtectHome=yes
ProtectProc=invisible
# Nothing a session writes reaches a later run: each writable path but out/ is a tmpfs.
# The runner keeps the transcript out of out/ and then deletes it.
ProtectSystem=strict
TemporaryFileSystem={{ pins.session_home }}:mode=0700,uid={{ pins.session_uid }},gid={{ pins.session_uid }},size={{ pins.home_size }}
TemporaryFileSystem=/tmp:mode=1777,size={{ pins.tmp_size }}
TemporaryFileSystem=/var/tmp:mode=1777,size={{ pins.scratch_size }}
TemporaryFileSystem=/dev/shm:mode=1777,size={{ pins.scratch_size }}
ReadWritePaths={{ pins.exchange_dir }}/out
# The run's bounds (I8), beside TimeoutStartSec above. A cap on this unit binds only the session.
MemoryMax={{ pins.memory_max }}
MemorySwapMax=0
TasksMax={{ pins.tasks_max }}
{% if t2_egress_enabled | default(false) %}
# No session starts unfenced: the check refuses unless the egress table holds this uid's rules.
ExecStartPre=+/usr/lib/homelab/t2-egress/t2-egress-check {{ pins.session_uid }}
{% endif %}
ExecStart={{ pins.tools_dir }}/.local/bin/uv run --no-project --no-python-downloads \
  --python {{ host_python_version }} /opt/claude-triage/claude_triage_session.py
