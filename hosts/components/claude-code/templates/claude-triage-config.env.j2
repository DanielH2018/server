{% import 'templates/claude-triage-pins.j2' as pins with context -%}
# Shipped by the claude-code host component.
# claude_triage_run.py's and claude_triage_session.py's settings. Root-owned and world-readable: it holds no secret, and a
# session steered by text it read must not be able to raise its own budget or point the next
# run at a prompt of its own. claude-triage-pins.j2 pins every cap as a literal, and that file is
# on the lander's approval list.
STATE_DIR={{ pins.state_dir }}
EXCHANGE_DIR={{ pins.exchange_dir }}
REPORT_DIR={{ pins.report_dir }}
REPORT_BASE_URL=https://artifacts.{{ domain }}/a/{{ inventory_hostname }}-claude-triage/
PROMPT_FILE=/opt/claude-triage/prompt.txt
WORKDIR={{ pins.clone_dir }}
# Where the session's transcript is, for the session script to copy it out.
SESSION_HOME={{ pins.session_home }}
CLAUDE_BIN={{ pins.tools_dir }}/.local/bin/claude
SETTINGS_FILE=/var/lib/homelab-claude-config/current/triage.json
MODEL={{ pins.model }}
BUDGET_USD={{ pins.budget_usd }}
MAX_TURNS={{ pins.max_turns }}
RUN_TIMEOUT_S={{ pins.run_timeout_s }}
DAILY_CAP={{ pins.daily_cap }}
# The restart broker a run's result may ask for: the allowlist keys, the broker unit's wall clock
# and the file its verdict lands in.
RESTART_NAMES={{ pins.restart_allowlist.keys() | sort | list | tojson }}
RESTART_TIMEOUT_S={{ pins.restart_timeout_s }}
RESTART_VERDICT={{ pins.restart_state_dir }}/verdict
# claude_triage_poll.py's settings.
POLL_MODE={{ pins.poll_mode }}
POLL_ROUTES={{ pins.poll_routes | tojson }}
RESTART_SERVICES={{ pins.restart_allowlist.values() | map(attribute='service') | sort | list | tojson }}
PROM_URLS={{ claude_code_triage_prom_urls | join(' ') }}
POLL_STREAK={{ claude_code_triage_poll_streak }}
POLL_STORM_SIZE={{ claude_code_triage_poll_storm_size }}
# The weekly reboot, from the same group_vars the Alertmanager mute reads. The grace
# runs from the cron firing: the shutdown delay, then the recovery.
REBOOT_WEEKDAY={{ weekly_reboot_weekday }}
REBOOT_HOUR={{ weekly_reboot_hour }}
REBOOT_MINUTE={{ weekly_reboot_minute }}
REBOOT_BEFORE_MIN={{ weekly_reboot_mute_lead_minutes }}
REBOOT_GRACE_MIN={{ weekly_reboot_shutdown_delay_minutes + weekly_reboot_mute_recovery_minutes }}
