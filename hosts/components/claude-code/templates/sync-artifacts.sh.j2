#!/usr/bin/env bash
# Shipped by homelab-daniel-box (hosts/components/claude-code) as /usr/lib/homelab/sync-artifacts.
#
# Copy every other host's ~/.claude/artifacts onto daniel-box, one directory per host, so the
# artifacts Deployment can serve them all from a single hostPath tree, and copy the GUI's star
# list back to each of them, so their own prune-artifacts.sh keeps what was starred here. Both
# run from daniel-box: `daniel-box` does not resolve from daniel-server, and a peer-side job
# would put an ssh key somewhere this one does not have to go.
#
# Usage: sync-artifacts (no arguments)
# Runs from homelab-sync-artifacts.service on daniel-box as the sys user, every 5 minutes by
# default (claude_code_artifacts_sync_minute). Each run logs a `status=<up|down>` line under the
# `sync-artifacts` tag and writes `sync-artifacts.prom` for node_exporter's textfile collector;
# Prometheus's ArtifactsSyncFailed and ArtifactsSyncNotReporting rules page from that file.
# Environment, optional: SYNC_ARTIFACTS_STATE_DIR (default /tmp), which holds
# the lock and the per-peer failure counters. The peers it pulls from are the
# claude_code_artifacts_peer_sources entries rendered into this file.
set -euo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

# Destination paths are written out per host below rather than through a shared variable:
# the peer list can be empty, and an unused variable is a shellcheck failure in the rendered
# script (validate/render_lib/shell.py renders with the loop unrolled to nothing).

# The override lets tests run the rendered script against a temporary directory.
# The unit uses /tmp, where a reboot clears every counter: the right reset, as a reboot ends any
# outage.
state_dir="${SYNC_ARTIFACTS_STATE_DIR:-/tmp}"

# One sync at a time: a slow or hung ssh must not stack rsync copies against the same destination.
exec 9>"${state_dir}/sync-artifacts.lock"
flock -n 9 || exit 0

status=0
# Goes down only when a peer's streak reaches the stderr-line threshold, so a briefly-off peer stays
# up.
verdict=up
report=""
{% set _ssh = 'ssh -o BatchMode=yes -o ConnectTimeout=10 -o ClearAllForwardings=yes${RUNTIME_DIRECTORY:+ -o ControlMaster=auto -o ControlPath=$RUNTIME_DIRECTORY/%C -o ControlPersist=60}' %}
{% for peer in claude_code_artifacts_peer_sources %}
# ClearAllForwardings: a LocalForward from ~/.ssh/config whose local port is held fails the whole
# ssh.
# --chmod=D0750 must equal the mode of homelab-artifacts.conf's `d` line, or -a flips it each run.
{% if peer.stars_path | default('') %}
# Until the star list lands, {{ peer.name }}'s prune can delete an artifact starred here.
# A failed push counts toward the same streak.
{% endif %}
# The pull and push share one ssh connection through a control socket: one sshd login per run.
# With no RUNTIME_DIRECTORY, as in the tests, each rsync opens its own connection.
if rsync -a --delete --chmod=D0750 --timeout=60 \
    -e "{{ _ssh }}" \
    "{{ peer.ssh_target }}:{{ peer.path }}/" "{{ claude_code_artifacts_peer_dir }}/{{ peer.name }}/"{% if peer.stars_path | default('') %} \
  && { [ ! -f "{{ claude_code_artifacts_stars_file }}" ] || rsync -a --timeout=60 \
    -e "{{ _ssh }}" \
    "{{ claude_code_artifacts_stars_file }}" "{{ peer.ssh_target }}:{{ peer.stars_path }}"; }{% endif %}; then
  # A recovered run forgets the streak, so the next outage counts from zero.
  if [ -f "${state_dir}/sync-artifacts-{{ peer.name }}.fails" ]; then
    logger -t sync-artifacts "{{ peer.name }} recovered after \
$(cat "${state_dir}/sync-artifacts-{{ peer.name }}.fails") failed run(s)"
    rm -f "${state_dir}/sync-artifacts-{{ peer.name }}.fails"
  fi
  report="${report:+$report; }{{ peer.name }} synced"
else
  # DECIDED: a failure goes to the journal, and only the run that REACHES the threshold writes
  # to stderr. A mailed failure goes unread, and a peer that is simply powered off is the common
  # case. The unit sends stderr to the journal as `sync-artifacts`, so the threshold line is one
  # journal line per outage that Loki keeps. The verdict recorded after the loop is the monitor.
  fails=$(( $(cat "${state_dir}/sync-artifacts-{{ peer.name }}.fails" 2>/dev/null || echo 0) + 1 ))
  echo "$fails" > "${state_dir}/sync-artifacts-{{ peer.name }}.fails"
  logger -t sync-artifacts "{{ peer.name }} failed (consecutive run $fails)"
  # The threshold is claude_code_artifacts_sync_alert_after_failures in the role's defaults,
  # which carries the reasoning for the number. Interpolated at its use site rather than held
  # in a variable: the peer list can be empty, and an unused variable fails shellcheck in the
  # rendered script.
  if [ "$fails" -eq {{ claude_code_artifacts_sync_alert_after_failures }} ]; then
    echo "sync-artifacts: {{ peer.name }} has failed $fails consecutive runs" >&2
  fi
  # -ge, not the stderr line's -eq: the verdict must stay down on every run past the threshold.
  if [ "$fails" -ge {{ claude_code_artifacts_sync_alert_after_failures }} ]; then
    verdict=down
    report="${report:+$report; }{{ peer.name }} failed $fails consecutive runs"
  else
    report="${report:+$report; }{{ peer.name }} failed $fails consecutive run(s), DOWN at \
{{ claude_code_artifacts_sync_alert_after_failures }}"
  fi
  status=1
fi
{% endfor %}

# DECIDED: no file-age staleness check. rsync -a copies the peer's own mtimes and the peer prunes
# at 30 days, so the newest file's age measures how often sessions on the peer write artifacts,
# not whether this sync runs — a quiet week on daniel-server would page. A successful rsync
# --delete leaves the mirror equal to the peer by construction, so the failure streak covers a
# broken transport and the NotReporting deadline covers a timer that stopped running at all.
#
# A missing library skips the textfile rather than exiting: the sync is the job and the verdict only
# reports on it. Silence then pages ArtifactsSyncNotReporting at its deadline. The override exists
# for the tests, which must not write the live textfile directory.
#
# set +e first: the sync's own outcome is already in $status, so nothing in the verdict may end
# the script before `exit "$status"`.
set +e
verdict_ts=$(date +%s)

# The journal line first, on every run, so `journalctl -t sync-artifacts` reads the outcome.
logger -t sync-artifacts "status=$verdict ${report:-no peers configured}"

# The textfile, which node_exporter's collector reads and host-checks.yaml pages.
# deadline_s is the longest legitimate gap between two writes: two timer periods plus 300s. One
# period is the normal gap, the second is a slot lost to the flock skip or a long run, and the
# 300s covers timer start jitter, the 1m `node` scrape and the 1m rule evaluation. It renders
# from the timer's minute, read as `*/N`. Any other shape has no single period, so the render
# fails rather than publish a deadline shorter than the real gap.
# tests/services/alert_rules/test_b6a_rule_literals.py pins the NotReporting rule to it.
{% set _every_n = claude_code_artifacts_sync_minute | string | regex_replace('^[*]/([0-9]+)$', '\\1') %}
{% if _every_n.isdigit() and '*/' ~ _every_n == claude_code_artifacts_sync_minute | string %}
deadline_s={{ 2 * 60 * (_every_n | int) + 300 }}
{% else %}
{{ sync_artifacts_cron_minute_not_every_n | mandatory('claude_code_artifacts_sync_minute must be */N for sync-artifacts.sh to derive deadline_s, got ' ~ claude_code_artifacts_sync_minute) }}
{% endif %}
check_lib="${SYNC_ARTIFACTS_CHECK_LIB:-/usr/lib/homelab/homelab-check-lib.sh}"
if [ -r "$check_lib" ]; then
  # shellcheck source=/dev/null
  source "$check_lib"
  success=0
  [ "$verdict" = up ] && success=1
  write_check_textfile sync-artifacts "$success" "$verdict_ts" "$deadline_s" \
    || logger -t sync-artifacts "textfile write failed (verdict=$verdict)"
else
  logger -t sync-artifacts "$check_lib missing, no textfile written; install homelab-daniel-box on this host"
fi

exit "$status"
