{% import 'templates/claude-triage-pins.j2' as pins with context -%}
[Unit]
Description=Unattended triage of monitor episode %i, as the triage controller
After=network-online.target
Wants=network-online.target
# A run that finishes pages through claude-triage-report-alert@<episode>:<state>.service, which the
# script starts itself.
OnFailure=homelab-alert@%n.service

[Service]
Type=oneshot
# The controller runs no session text; the session's group lets this unit read the result left in
# the exchange.
User={{ pins.ctl_user }}
SupplementaryGroups={{ pins.session_user }}
Environment=HOME={{ pins.ctl_home }}
Environment=PATH=/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=UV_CACHE_DIR={{ pins.ctl_home }}/uv-cache
Environment=UV_PYTHON_INSTALL_DIR={{ pins.ctl_home }}/python
SyslogLevel=notice
# The session's TimeoutStartSec, run_timeout_s ({{ pins.run_timeout_s }}s), trips first.
# A requested restart then runs inside this clock, bounded by the broker's
# {{ pins.restart_timeout_s }}s.
TimeoutStartSec={{ pins.run_timeout_s + pins.restart_timeout_s + 900 }}
NoNewPrivileges=yes
# DECIDED: UMask=0027, as claude-rc.service.j2 sets it. homelab-claude-triage.conf gives the
# operator's group traverse on the state directory, so under systemd's default 0022 a record, a log or a
# directory this unit creates there would be world-readable by its fixed name. A report lands
# in the setgid report tree, where 0640 keeps the operator's group read.
UMask=0027
ProtectHome=yes
ProtectProc=invisible
PrivateTmp=yes
# A busy lock exits 75, not a failure: the episode stays in the inbox and nothing pages.
SuccessExitStatus=75
# The directories, the session's toolchain and its clone, before the lock inside them is taken.
ExecStartPre=+/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin /usr/lib/homelab/claude-triage-setup
ExecStartPre=/usr/lib/homelab/bin/uv python install --no-bin {{ host_python_version }}
ExecStart=/usr/bin/flock -n -E 75 {{ pins.state_dir }}/run.lock \
  /usr/lib/homelab/bin/uv run --no-project --no-python-downloads \
  --python {{ host_python_version }} /opt/claude-triage/claude_triage_run.py %i
