# Shipped by the claude-code host component — edits here are overwritten.
#
# A login shell as {{ claude_code_agent_user }}. Its own claude and uv come first on PATH,
# ahead of the operator's tooling under /usr/local/bin.
PATH="$HOME/.local/bin:$PATH"
# The repo's hook shim (.claude/hooks/run-hook.sh) defaults to the operator's checkout and uv,
# so without these every guarded hook fails its cd and asks instead of running. renovate-agent's
# unit sets the same two.
export RUN_HOOK_PROJECT_DIR={{ claude_code_agent_user_clone_dir }}
export RUN_HOOK_UV={{ claude_code_agent_user_home }}/.local/bin/uv
# target.py:branch_name builds fan-out branch names from this, the one shape the fence allows.
# A script that names branches itself never reads the agent's CLAUDE.md.
export CLAUDE_WORKTREE_PREFIX={{ claude_code_agent_worktree_prefix }}
# An ssh login inherits sshd's oom_score_adj of 0, below every pod's; raising it needs no privilege.
echo {{ claude_code_fleet_oom_score_adjust }} > /proc/self/oom_score_adj 2>/dev/null
{% if claude_code_lander_enabled and claude_code_agent_is_primary %}
{% import 'templates/claude-land-pins.j2' as pins with context %}
# This user has no sudo, so a landing of its own would fail at the deploy; land.sh hands off.
export LAND_HANDOFF_UNIT={{ pins.unit }}
{% endif %}
