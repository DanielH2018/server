#!/bin/bash
# Shipped by the claude-code component. Run as root by homelab-claude-agent.service.
#
# Usage: claude-agent-setup [-h|--help]
# Takes no arguments. Running it by hand applies every step below for real.
#
# Gives the {{ claude_code_agent_user }} agent user what its home and groups need on every run:
# the groups it reads the host through, its login profile, git identity and instructions, its
# commit-signing key, the operator's read-only kubeconfig, its dotfiles source and its clone. On
# the peers' key host it also names each peer in the agent's ssh config. claude-agent-home writes
# the keys and the memory seed as the agent.
# The users arm creates the user itself (/usr/lib/sysusers.d/homelab.conf). The dotfiles sync
# installs its tooling (uv, Python, prek, Claude Code) once the dotfiles source exists, and the
# clone sync keeps its clone, venv and collections current.
#
# The agent owns everything below its home, so it can swap a directory there for a link at any
# moment. Root therefore never acts on a path by name: pin opens a directory and refuses unless
# the opened directory is the one its path names, and root creates, owns, modes and writes
# through that open handle. A link on any path fails the run.
#
# Every step is idempotent: a step whose result exists already changes nothing.
set -euo pipefail

case "${1-}" in
  -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
esac

agent={{ claude_code_agent_user }}
home={{ claude_code_agent_user_home }}
operator={{ sys_user }}
templates=/usr/lib/homelab/claude-agent

as_agent() {
  runuser -u "$agent" -- env HOME="$home" USER="$agent" TMPDIR=/tmp \
    PATH="$home/.local/bin:/usr/local/bin:/usr/bin:/bin" "$@"
}

# The groups: the worktree holder scan's socket, the root inspector's socket, the journal and
# the ssh login. `usermod -G` sets the whole list, so a group dropped here is left.
groups=({{ claude_code_worktree_holders_group }}{{ ' ' ~ claude_code_rootq_socket_group if claude_code_rootq_socket_armed else '' }}{{ ' systemd-journal' if claude_code_agent_journal_access else '' }}{{ ' ssh-users' if claude_agent_ssh_login_enabled else '' }})
for group in "${groups[@]}"; do
  getent group "$group" > /dev/null || groupadd --system "$group"
done
usermod --groups "$(IFS=,; echo "${groups[*]}")" "$agent"
# A user the users arm expired and then declared again gets its account back.
usermod --expiredate '' "$agent"
# Its user manager outlives a logout, so its fan-out batches survive; so does the operator's.
loginctl enable-linger "$agent" "$operator"

fail() { echo "claude-agent-setup: $*" >&2; exit 1; }

# pin DIR leaves a handle on DIR in $pinned. Opening "DIR/." fails on a file or a fifo, where a
# plain open of a fifo would block. The handle's resolved path equals DIR only when no link lies on it.
pinned_fd=
pinned=
unpin() {
  [ -z "$pinned_fd" ] || exec {pinned_fd}<&-
  pinned_fd=
  pinned=
}
pin() {
  unpin
  exec {pinned_fd}< "$1/." || fail "cannot open $1 as a directory"
  pinned=/proc/$$/fd/$pinned_fd
  [ "$(readlink "$pinned")" = "$1" ] || fail "$1 is not a plain directory: a link lies on its path"
}

# dir MODE PATH: PATH is the agent's directory, in the operator's group. A missing one is created
# only inside its pinned parent.
dir() {
  pin "${2%/*}"
  [ -d "$pinned/${2##*/}" ] || mkdir "$pinned/${2##*/}"
  pin "$2"
  chown "$agent:$operator" "$pinned"
  chmod "$1" "$pinned"
  unpin
}

# place OWNER GROUP MODE SRC DEST writes DEST inside its pinned parent. install -T replaces a link
# at DEST and refuses a directory there, so it never writes through either.
place() {
  pin "${5%/*}"
  install -T -o "$1" -g "$2" -m "$3" "$4" "$pinned/${5##*/}"
  unpin
}

# drop PATH removes the file at PATH, a link included, when its directory exists.
drop() {
  [ -d "${1%/*}" ] || return 0
  pin "${1%/*}"
  rm -f "$pinned/${1##*/}"
  unpin
}

# point TARGET LINK makes LINK a link to TARGET inside its pinned parent. A link or a file at LINK
# is replaced, and a directory there fails the run.
point() {
  pin "${2%/*}"
  ln -sfnT "$1" "$pinned/${2##*/}"
  unpin
}

dir 2750 "$home"
dir 0755 "$home/.local"
dir 0755 "$home/.local/bin"
dir 0750 "$home/.ssh"
{% if claude_agent_ssh_login_enabled %}
# The key host's agent logs in with exactly the packaged key. authorized_keys is root-owned in a
# .ssh the agent owns (agent_ssh_login.yml's DECIDED). A blank key ships no file, and the old one stays.
if [ -e "$templates/authorized_keys" ]; then
  if [ "$(wc -l < "$templates/authorized_keys")" -ne 1 ] || ! grep -Eq '^restrict ssh-ed25519 ' "$templates/authorized_keys"; then
    echo "claude-agent-setup: $templates/authorized_keys is not one restricted ssh-ed25519 line" >&2
    exit 1
  fi
  place root root 0644 "$templates/authorized_keys" "$home/.ssh/authorized_keys"
fi
{% else %}
drop "$home/.ssh/authorized_keys"
{% endif %}
dir 0755 "$home/.config"
dir 0755 "$home/.config/git"
dir {{ '0710' if claude_code_agent_operator_read else '0700' }} "$home/.config/gh"
# homelab-secrets renders the agent's gh login under /run, outside the agent's home.
point /run/homelab-secrets/var/lib/claude/.config/gh/hosts.yml "$home/.config/gh/hosts.yml"
dir {{ '0710' if claude_code_agent_operator_read else '0700' }} "$home/.config/chezmoi"
dir {{ '0710' if claude_code_agent_operator_read else '0700' }} "$home/.claude"
dir {{ '0710' if claude_code_agent_operator_read else '0700' }} "$home/.claude/projects"
dir {{ '0710' if claude_code_agent_operator_read else '0700' }} "$(dirname "{{ claude_code_agent_memory_dir }}")"
dir 0700 "$home/.kube"
# The operator reads what the agent writes to its artifacts and memory directories: setgid on
# the operator's group, and a default ACL that gives each new file the group's read.
for shared in "$home/.claude/artifacts" "{{ claude_code_agent_memory_dir }}"; do
  dir {{ '2750' if claude_code_agent_operator_read else '0700' }} "$shared"
  pin "$shared"
{% if claude_code_agent_operator_read %}
  setfacl --default --modify "group:$operator:rX" "$pinned"
{% else %}
  setfacl --default --remove "group:$operator" "$pinned" 2> /dev/null || true
{% endif %}
  unpin
done

{% if has_gitops | default(false) %}
# The deployer's state directory is 0750 {{ sys_user }}, so without this the agent cannot check
# hold_sha or owed.jsonl before a landing (#4198). Not recursive: the default entry makes each
# marker readable as the deployer rewrites it. The agent cannot write there, so no pin is needed.
if [ -d /var/lib/gitops-deploy ]; then
{% if claude_code_agent_gitops_read %}
  setfacl --modify "user:$agent:rX" --modify "default:user:$agent:r" /var/lib/gitops-deploy
{% else %}
  setfacl --remove "user:$agent" --remove "default:user:$agent" /var/lib/gitops-deploy 2> /dev/null || true
{% endif %}
fi
{% endif %}

{% if claude_code_agent_homelab_ui_enabled %}
# homelab-secrets renders the agent's homelab-ui login under /run, outside the agent's home
# (daniel-box's package.yml names the same destination). The agent reads it through this link.
ui_login=/run/homelab-secrets/claude-agent/homelab-ui-credentials.json
dir {{ '0710' if claude_code_agent_operator_read else '0700' }} "$home/.config/homelab-ui"
point "$ui_login" "$home/.config/homelab-ui/credentials.json"
{% else %}
drop "$home/.config/homelab-ui/credentials.json"
{% endif %}

put() { place "$agent" "$operator" "$1" "$templates/$2" "$home/$3"; }
put 0644 profile .profile
put 0644 gitconfig .gitconfig
put 0644 CLAUDE.md .claude/CLAUDE.md
put {{ '0640' if claude_code_agent_operator_read else '0600' }} chezmoi-seed.toml .config/chezmoi/seed.toml
# chezmoi's first init needs the answers in its config; later runs render the config themselves.
[ -e "$home/.config/chezmoi/chezmoi.toml" ] || put 0600 chezmoi-seed.toml .config/chezmoi/chezmoi.toml

# The signing key, the peer key and the memory seed, each written as the agent.
/usr/lib/homelab/claude-agent-home
{% if inventory_hostname == claude_agent_ssh_key_host %}
# The ssh config naming each peer's agent user, beside the peer key claude-agent-home generates.
put 0644 ssh-config .ssh/config
{% endif %}

# The operator's read-only kubeconfig, copied on every run so a re-issued token reaches it.
if [ -f "/home/$operator/.kube/config" ]; then
  place "$agent" "$operator" 0600 "/home/$operator/.kube/config" "$home/.kube/config"
fi

{% if claude_code_agent_dotfiles %}
# The dotfiles source. The dotfiles sync applies it on its timer.
if [ ! -x "$home/.local/bin/chezmoi" ] && [ -x "/home/$operator/.local/bin/chezmoi" ]; then
  place "$agent" "$operator" 0755 "/home/$operator/.local/bin/chezmoi" "$home/.local/bin/chezmoi"
fi
if [ ! -e "$home/.local/share/chezmoi/.git" ]; then
  as_agent "$home/.local/bin/chezmoi" init --no-tty {{ claude_code_agent_dotfiles_repo }}
fi
{% endif %}

# Its own clone: git refuses a repository whose gitdir another uid owns.
clone={{ claude_code_agent_user_clone_dir }}
if [ ! -e "$clone/.git" ]; then
  as_agent git clone --quiet "https://github.com/{{ claude_code_agent_user_repo }}.git" "$clone"
fi
if [ ! -e "$clone/.git/hooks/pre-commit" ] && [ -x "$home/.local/bin/prek" ]; then
  (cd "$clone" && as_agent "$home/.local/bin/prek" install)
fi
