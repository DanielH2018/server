# Shipped by the claude-code host component — do not edit by hand.
#
# The ONE bound for the whole Claude fleet on this host. The fleet occupies two cgroups:
# claude-rc.service's own, and the user-<uid>.slice of each login uid (claude_code_login_uids,
# plus the agent user's) for a session started from an interactive shell. A cap on each reads as
# one bound and is two — siblings under different parents, neither seeing the other's usage, so
# the real throttle point is their SUM: 16G of anon plus 4G of swap on a 28 GiB box that also
# runs k3s, Longhorn and the rest of the homelab plane. This file is the parent that makes the
# sum the number; the two per-plane caps stay as sub-bounds under it.
#
# {{ claude_code_fleet_slice }} is the tightest slice that can be that parent, and it is the
# only one. user-<uid>.slice cannot be reparented: systemd.slice(5) says "The name of the slice
# encodes the location in the tree", so its name fixes it under user.slice, where systemd-logind
# creates it. Nesting the RC unit in a user-<uid>.slice instead is unsafe here: that slice is
# StopWhenUnneeded=yes with Linger=no on this host, so logind stops it at the last logout and
# would take the RC host down with it (a unit with Slice= gains an implicit Requires= on its
# slice). user.slice is StopWhenUnneeded=no.
#
# The derivation of the numbers is in this role's defaults/main.yml beside
# claude_code_fleet_memory_high. Re-derive it there, not here.
#
# No MemoryMax, for the same reason neither plane has one: systemd applies it to the whole
# slice, so it would OOM-kill every login session and the RC host at once, including the SSH
# connection running the deploy. MemoryHigh throttles allocation instead of killing.
[Slice]
MemoryHigh={{ claude_code_fleet_memory_high }}
MemorySwapMax={{ claude_code_fleet_swap_max }}
