{% import 'templates/claude-triage-pins.j2' as pins with context -%}
[Unit]
Description=Poll Prometheus's ALERTS and start triage for alerts that just started firing
After=network-online.target
Wants=network-online.target
# A broken poller fails on every tick, so its page is quiet for an hour after each delivery.
OnFailure=homelab-claude-triage-poll-alert.service

[Service]
Type=oneshot
# Starts claude-triage@<episode>.service, which polkit lets this user start.
User={{ pins.ctl_user }}
Environment=HOME={{ pins.ctl_home }}
Environment=PATH=/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=UV_CACHE_DIR={{ pins.ctl_home }}/uv-cache
Environment=UV_PYTHON_INSTALL_DIR={{ pins.ctl_home }}/python
# This host's journald stores notice and above (MaxLevelStore=notice), so stdout logs at notice.
SyslogLevel=notice
TimeoutStartSec=2min
NoNewPrivileges=yes
# DECIDED: UMask=0027, as claude-rc.service.j2 sets it. homelab-claude-triage.conf gives the
# operator's group traverse on the state directory, so under systemd's default 0022 a record, a log or a
# directory this unit creates there would be world-readable by its fixed name. A report lands
# in the setgid artifacts directory, where 0640 keeps the operator's group read.
UMask=0027
ProtectHome=yes
ProtectProc=invisible
PrivateTmp=yes
# Root-owned, never a clone a session reads, so a steered session cannot change what the poller
# sees.
ExecStartPre=+/usr/bin/systemd-tmpfiles --create /usr/lib/tmpfiles.d/homelab-claude-triage.conf
ExecStartPre=/usr/lib/homelab/bin/uv python install --no-bin {{ host_python_version }}
ExecStart=/usr/lib/homelab/bin/uv run --no-project --no-python-downloads \
  --python {{ host_python_version }} /opt/claude-triage/claude_triage_poll.py
{% from 'templates/timer-textfile.j2' import timer_textfile with context %}
{{ timer_textfile('claude-triage-poll', claude_code_triage_poll_interval, 120) }}
