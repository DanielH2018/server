{% import 'templates/claude-triage-pins.j2' as pins with context -%}
# Shipped by the claude-code host component. claude_triage_run.py starts an instance named
# <episode>:<state> when a run finishes, through polkit (50-claude-triage.rules). The name keeps
# its Ansible-era form because the runner and the rule name it.
[Unit]
Description=Report that triage episode %i finished
After=homelab-secrets.service
Wants=homelab-secrets.service

[Service]
Type=oneshot
LoadCredential=discord_webhook:/run/credstore/gitops_deploy_discord_webhook
Restart=on-failure
RestartSec=5min
RestartPreventExitStatus=3
RuntimeDirectory=claude-triage-report-alert/%i
RuntimeDirectoryPreserve=restart
ExecStartPre=/bin/sh -c 'test -s %t/claude-triage-report-alert/%i/failed-at || date --utc "+%%Y-%%m-%%d %%H:%%M UTC" > %t/claude-triage-report-alert/%i/failed-at'
ExecStart=/usr/bin/curl -fsS -m 10 --retry 5 --retry-delay 10 --retry-all-errors \
  -H "Content-Type: application/json" \
  --variable 'failed_at@%t/claude-triage-report-alert/%i/failed-at' \
  --variable 'instance=%i' \
  --variable 'webhook@%d/discord_webhook' \
  --expand-data '{"content":"{% raw %}{{instance:json}}{% endraw %}: an unattended triage run on {{ inventory_hostname }} finished; the page opens with the episode and its state. The report is triage-<episode>.html at https://artifacts.{{ domain }}/a/{{ inventory_hostname }}-{{ pins.agent_user }}/ and the record is {{ pins.state_dir }}/runs/<episode>.json. Finished at {% raw %}{{failed_at:trim:json}}{% endraw %}."}' \
  --expand-url '{% raw %}{{webhook:trim}}{% endraw %}'
SyslogLevel=notice
ExecStartPost=/bin/echo claude-triage-report page delivered for %i
