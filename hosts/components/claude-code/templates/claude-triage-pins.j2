{#- Triage's caps, users and paths: every triage template imports these as `pins`. A template's own
assignment outranks every inventory value, so an agent PR that edits only host_vars cannot raise a
run's budget, turns or wall clock, run the unit as another user, or arm the poller. The host
package renderer puts the inventory above a component's defaults, so a component default would pin
nothing. The `claude-triage` template prefix is on the lander's approval list. Each value is a
literal. hosts/tests/test_claude_triage.py holds them equal to
the component's defaults/main.yml.
-#}
{#- Neither user is `claude`, so no interactive session can start a run or change what one reads.
   report_dir equals artifacts_triage_dir in k8s/roles/artifacts/defaults/main.yml, which mounts it. -#}
{%- set ctl_user = "claude-triage-ctl" -%}
{%- set ctl_home = "/var/lib/claude-triage-ctl" -%}
{%- set report_dir = "/var/lib/claude-triage-ctl/reports" -%}
{%- set state_dir = "/var/lib/claude-triage-ctl/state" -%}
{%- set session_user = "claude-triage" -%}
{%- set session_home = "/var/lib/claude-triage" -%}
{#- The session's bounds. Its home, /tmp, /var/tmp and /dev/shm are
tmpfs mounts that end with the unit. Their pages count against memory_max, so the sizes sum well
below it and a full mount fails with ENOSPC rather than an OOM kill. The home's mount takes the
session's numeric uid, which hosts/daniel-box/package.yml declares. -#}
{%- set session_uid = 907 -%}
{%- set home_size = "512M" -%}
{%- set tmp_size = "512M" -%}
{%- set scratch_size = "64M" -%}
{%- set memory_max = "4G" -%}
{%- set tasks_max = 512 -%}
{#- What the controller shares with the session through the session user's group. -#}
{%- set exchange_dir = "/var/lib/claude-triage-exchange" -%}
{%- set tools_dir = "/var/lib/claude-triage-tools" -%}
{%- set clone_dir = "/var/lib/claude-triage-clone" -%}
{%- set kubeconfig = "/etc/claude-triage/kubeconfig" -%}
{%- set model = "opus" -%}
{%- set budget_usd = 10 -%}
{%- set max_turns = 60 -%}
{%- set run_timeout_s = 1800 -%}
{%- set daily_cap = 6 -%}
{#- Arming the poller is an operator decision too. -#}
{%- set poll_mode = "shadow" -%}
{#- Key: an alert name, or `<alert>:<service>`, which wins; `none` or an unnamed alert opens nothing.
   A routed alert's rule must not select on log text a session controls (a test enforces it). -#}
{%- set poll_routes = {
  "ExtraProbeFailed": "triage",
  "ExtraProbeFailedCritical": "triage",
  "IngressProbeFailed": "triage",
  "IngressProbeFailedCritical": "triage",
  "K8sDeploymentZeroAvailable": "triage",
  "K8sContainerCrashLooping": "triage",
  "ScrapeTargetDown": "triage",
} -%}
{#- Keyed by unit instance; `service` is the deploy tag its alerts carry, which the poller routes
   nowhere.
   One restart per workload per cooldown, and no more than the cap per UTC day across all workloads. -#}
{%- set restart_allowlist = {
  "docs": {"namespace": "homelab", "deployment": "docs", "service": "docs"},
} -%}
{%- set restart_workload_cooldown_s = 86400 -%}
{%- set restart_daily_cap = 3 -%}
{#- A triage run waits for the broker inside its own wall clock, so claude-triage@'s timeout adds
   this. -#}
{%- set restart_timeout_s = 900 -%}
{%- set restart_state_dir = "/var/lib/claude-restart" -%}
