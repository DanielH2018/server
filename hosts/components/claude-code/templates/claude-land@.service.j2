{% import 'templates/claude-land-pins.j2' as pins with context -%}
[Unit]
Description=Land the agent user's PR #%i
After=network-online.target
Wants=network-online.target
# A refused or failed landing pages Discord, exit 75 too, since nothing re-runs this unit.
# /var/lib/{{ pins.unit }}/<n>.verdict says why.
OnFailure=homelab-alert@%n.service

[Service]
Type=oneshot
# The operator's user: land.sh uses its gh token, decrypts secrets and runs Ansible with become.
# Agent sessions can only START this unit (polkit 50-claude-land.rules); the instance name is their
# only input.
User={{ sys_user }}
WorkingDirectory={{ pins.checkout }}
Environment=PATH=/home/{{ sys_user }}/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/{{ sys_user }}
Environment=KUBECONFIG=/home/{{ sys_user }}/.kube/config
# The checkout is the primary one, and an untracked __pycache__ there parks homelab-checkout-sync.
Environment=PYTHONDONTWRITEBYTECODE=1
# Only the agent's fenced branches land, and approval-list paths need the operator's GitHub
# approval.
Environment=LAND_REQUIRE_AUTHOR={{ pins.author }}
Environment=LAND_REQUIRE_BRANCH_PREFIX={{ pins.branch_prefix }}
Environment=LAND_APPROVAL_PATHS=/etc/claude-land/approval-paths
Environment=LAND_APPROVER={{ pins.approver }}
# The session reads the verdict back, so the directory is world-readable and only this unit writes
# it.
StateDirectory={{ pins.unit }}
StateDirectoryMode=0755
SyslogLevel=notice
# A landing systemd kills leaves its verdict reading PENDING, or no file if killed in the lock wait,
# so the session reads this unit's Result too. 19h covers LAND_DEADLINE, LAND_WINDOW_GRACE and the
# flock wait.
TimeoutStartSec=19h
# Fits inside TimeoutStartSec less the flock wait, so land.sh ends a long promotion wait `deferred`
# before systemd kills it with no verdict; it must still leave room for verify's soak wait.
Environment=LAND_DEADLINE=41460
# A landing merging into the reboot's no-promotion window waits out the deferral, not gives up:
# the first poll inside adds the window's remaining length to the cap, up to this full length.
Environment=LAND_WINDOW_GRACE=22200
# One of the agent's landings at a time, so a second waits for the first's landing rather than
# racing it. Interactive sessions and renovate-agent's lander do not take
# this lock.
ExecStart=/usr/bin/flock -w 1800 /var/lock/claude-land.lock \
  {{ pins.checkout }}/scripts/deploy_tools/land.sh --pr %i --arm-merge \
  --await-merge --verdict-file /var/lib/{{ pins.unit }}/%i.verdict
