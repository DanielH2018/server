#!/usr/bin/env bash
# Shipped by the claude-code component as /usr/lib/homelab/takeover-check-flux, and run as root
# by homelab-takeover-check-flux.service.
#
# Installs the pinned flux CLI that /usr/local/sbin/homelab-takeover-check runs as root, or takes
# it back. Switched on (claude_code_takeover_check_enabled), it downloads the release tarball,
# refuses it unless its sha256 is the pin, and installs `flux` 0755 into the library
# directory. A copy already at the pin downloads nothing. Switched off, it removes the library
# directory and the check's state directory. The package drops the wrapper and its sudoers
# grant in the same version, so the grant never names a missing command.
#
# Usage: takeover-check-flux (no arguments). Environment, optional: TAKEOVER_CHECK_FLUX_ROOT
# (default empty), a prefix for every path, which the tests set.
case "${1:-}" in
  -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
esac
set -euo pipefail

root="${TAKEOVER_CHECK_FLUX_ROOT:-}"
lib_dir="${root}{{ claude_code_takeover_check_lib_dir }}"
url="{{ claude_code_takeover_check_flux_url }}"
sha256="{{ claude_code_takeover_check_flux_sha256 }}"
# Which pin the installed copy came from. The release tarball carries no version file.
stamp="${lib_dir}/flux.sha256"

{% if claude_code_takeover_check_enabled %}
if [ -x "${lib_dir}/flux" ] && [ "$(cat "$stamp" 2>/dev/null || true)" = "$sha256" ]; then
  exit 0
fi
install -d -m 0755 "$lib_dir"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
curl --fail --silent --show-error --location --retry 3 --output "${work}/flux.tar.gz" "$url"
echo "${sha256}  ${work}/flux.tar.gz" | sha256sum --check --quiet --strict
tar -xzf "${work}/flux.tar.gz" -C "$work" flux
install -m 0755 "${work}/flux" "${lib_dir}/flux"
echo "$sha256" > "$stamp"
# The tarball the Ansible role kept beside the binary.
rm -f "${lib_dir}"/flux_*.tar.gz
echo "takeover-check-flux: installed flux at ${sha256:0:12}"
{% else %}
rm -rf "$lib_dir" "${root}{{ claude_code_takeover_check_state_dir }}"
{% endif %}
