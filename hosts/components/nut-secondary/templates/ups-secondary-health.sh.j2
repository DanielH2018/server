#!/usr/bin/env bash
# Host-side UPS secondary watchdog — shipped by the nut-secondary host package; edits overwritten.
#
# Usage: ups-secondary-health [-h|--help]
# Takes no arguments. homelab-ups-watchdog.timer runs it every nut_host_watchdog_interval_minutes
# minutes on both cluster nodes, and its enable link ships only while nut_host_watchdog_armed is
# true. It reads /var/lib/homelab-secrets/etc/nut/upsmon.conf. Running it by hand needs root.
# Each run writes its verdict to $TEXTFILE_DIR/ups-secondary-health.prom for node_exporter's
# textfile collector, which UpsSecondaryFailed and UpsSecondaryNotReporting read (M6 batch B4,
# other-setup-checks.yaml). B4's Cutover-2 removed its Kuma push.
#
# Answers the one question nothing else in this estate asks: can THIS host's upsmon still
# reach upsd, right now?
#
# Nothing else re-proves that link after the package installs. Two things break it silently,
# and both stay invisible until the power cut the chain exists for:
#   * the address in upsmon.conf stops reaching upsd: the pod's hostPort on ups_host, or the
#     nut Service's pinned ClusterIP (nut_k8s_cluster_ip) on any other host
#   * nut-monitor dies or is left disabled
#
# WHY THE NEIGHBOURING CHECKS DO NOT COVER THIS, all three for the same reason — they observe a
# different path from the one that carries the shutdown:
#   * observability's UPS* rules (UPSOnBattery, UPSBatteryLow and the rest, in hosts.yaml) read
#     nut-exporter's scrape of upsd, i.e. the UPS as seen THROUGH the cluster. They say the UPS is
#     fine, not that this host can hear it.
#   * the "k3s nut (upsd)" Kuma tile is a TCP probe from the Kuma POD over Service DNS. It
#     crosses the pod network, not the host-netns path this host's upsmon takes, so it can stay
#     green while that path is broken.
#   * node-exporter runs without --collector.systemd, so no node_systemd_unit_state series
#     exists for anything to alert on nut-monitor being dead.
#
# THE ADDRESS IS READ OUT OF THE RENDERED upsmon.conf, not templated into this script. A
# templated value could differ from the file upsmon actually reads, and the check would then
# pass against an address upsmon does not use, reproducing the blindness it exists to remove.
#
# The MONITOR line carries nut_monitor_password in field 5, which is why the read is
# field-scoped awk and never a bare grep: printing that line prints the credential into syslog
# and into any agent transcript that ran the check. This estate has rotated three secrets after
# exactly that mistake.
#
# Runs as root because upsmon.conf is 0640 root:nut. Root buys the file read, nothing more.
# The consequence worth knowing is that an agent session cannot trigger a run to verify this
# one by hand.
set -uo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

# shellcheck source=/dev/null
source /usr/lib/homelab/homelab-check-lib.sh || {
  logger -t ups-secondary-health "homelab-check-lib.sh missing — the check-lib component ships it"
  exit 1
}

# The longest legitimate gap between two textfile writes: two timer periods plus 300s, the rule
# M3 fixed (docs/target-architecture/monitoring/m3-textfile-timer.md, "The deadline for
# disk-health"). It renders from the same variable as the timer, and
# hosts/tests/test_b4_rule_literals.py pins the rules' literals to this value.
DEADLINE_S={{ 2 * 60 * (nut_host_watchdog_interval_minutes | int) + 300 }}
TEXTFILE_DIR=${TEXTFILE_DIR:-/var/lib/node-exporter-textfile}

UPSMON_CONF=/var/lib/homelab-secrets/etc/nut/upsmon.conf

# Field 2 only: `MONITOR <ups>@<host> <powervalue> <user> <password> <mode>`.
ENDPOINT="$(awk '$1 == "MONITOR" { print $2; exit }' "$UPSMON_CONF" 2>/dev/null)"
UNIT_STATE="$(systemctl is-active nut-monitor 2>/dev/null || true)"

# stdout and stderr are kept APART. upsc writes "Init SSL without certificate database" to
# stderr on every successful call here, so folding the two with 2>&1 puts that line inside the
# value: the logged message goes multi-line, and the empty-status branch below becomes
# unreachable because the noise is never empty. Both were live for one cycle on 2026-08-29.
UPSC_STDERR="$(mktemp)"
UPS_STATUS="$(upsc "$ENDPOINT" ups.status 2>"$UPSC_STDERR")"
UPSC_RC=$?
# Collapsed to one line: ups.status is legitimately multi-token ("OL CHRG"), and a newline in
# either half would break the syslog line.
UPS_STATUS="$(printf '%s' "$UPS_STATUS" | tr '\n' ' ' | sed 's/  */ /g; s/^ //; s/ $//')"
UPSC_ERR="$(tr '\n' ' ' < "$UPSC_STDERR" | sed 's/  */ /g; s/^ //; s/ $//')"
rm -f "$UPSC_STDERR"

if [[ ! -r "$UPSMON_CONF" ]]; then
  STATUS=down
  MSG="${UPSMON_CONF} is unreadable — the secondary is not configured on this host"
elif [[ -z "$ENDPOINT" ]]; then
  STATUS=down
  MSG="no MONITOR line in ${UPSMON_CONF} — upsmon has no upsd to watch"
elif [[ "$UNIT_STATE" != "active" ]]; then
  STATUS=down
  MSG="nut-monitor is ${UNIT_STATE:-unknown} — nothing on this host will act on FSD"
elif (( UPSC_RC != 0 )); then
  STATUS=down
  MSG="upsd unreachable at ${ENDPOINT}: ${UPSC_ERR:-upsc exited ${UPSC_RC} with no diagnostic}"
elif [[ -z "$UPS_STATUS" ]]; then
  STATUS=down
  MSG="upsd at ${ENDPOINT} returned an empty ups.status"
else
  # Deliberately does NOT page on OB/LB. Battery state is the UPS* rules' job; alerting on it here
  # would double-page the same event from two mechanisms. This check is about the LINK.
  STATUS=up
  MSG="nut-monitor active, upsd reachable at ${ENDPOINT} (ups.status=${UPS_STATUS})"
fi

# Unconditional: this line is the durable record of the verdict's message, and Loki keeps it.
# NOTICE rather than INFO: journald here is capped at MaxLevelStore=notice, so an
# info-level line is dropped from the journal AND from forwarding to rsyslog, never reaching
# Loki (2026-08-29 review M-15, which was exactly that bug in live_drift_check.py).
logger -p daemon.notice -t ups-secondary-health "status=${STATUS} ${MSG}"

# The textfile carries the verdict. A failed write logs.
SUCCESS=0
[[ "$STATUS" == "up" ]] && SUCCESS=1
write_check_textfile ups-secondary-health "$SUCCESS" "$(date +%s)" "$DEADLINE_S" \
  || logger -t ups-secondary-health "textfile write to ${TEXTFILE_DIR} failed (status=${STATUS})"
