#!/usr/bin/env bash
# fake-remux heartbeats, shipped by the fake-remux component.
#
# Usage: fake-remux-health [-h|--help]
# Takes no arguments. homelab-fake-remux-health.timer runs it as the deploy user every
# fake_remux_health_cron_minute minutes. Run it by hand the same way.
# It reads the three state files in fake_remux_state_dir and writes one verdict per state file to
# $TEXTFILE_DIR/<fake-remux-scan|fake-remux-replace|mkv-attachment-repair>.prom for
# node_exporter's textfile collector, which the FakeRemux* and MkvAttachmentRepair* rules in
# other-setup-checks.yaml read. It logs to syslog under the tag fake-remux-health.
# Exit 1 means /usr/lib/homelab/homelab-check-lib.sh is missing.
#
# Thin on purpose — the verdict logic is in state_push.py, a plain file with unit tests and a 3.12
# floor check. Same shape as longhorn-backup-health.sh.
#
# This file carries NO secret.
set -uo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

# shellcheck source=/dev/null
source /usr/lib/homelab/homelab-check-lib.sh || {
  logger -t fake-remux-health "homelab-check-lib.sh missing — the check-lib component ships it"
  exit 1
}

# Deadline: two cron periods plus 300s; fake_remux_health_cron_minute must be `*/N`.
{% set _every_n = fake_remux_health_cron_minute | string | regex_replace('^[*]/([0-9]+)$', '\\1') %}
{% if _every_n.isdigit() and '*/' ~ _every_n == fake_remux_health_cron_minute | string %}
DEADLINE_S={{ 2 * 60 * (_every_n | int) + 300 }}
{% else %}
{{ fake_remux_health_cron_minute_not_every_n | mandatory('fake_remux_health_cron_minute must be */N for fake-remux-health.sh to derive DEADLINE_S, got ' ~ fake_remux_health_cron_minute) }}
{% endif %}
TEXTFILE_DIR=${TEXTFILE_DIR:-/var/lib/node-exporter-textfile}

# state_push.py prints one line per triple in argument order; LABELS and CHECKS must match it.
mapfile -t LINES < <(/usr/bin/uv run --no-project --no-python-downloads --python {{ host_python_version }} {{ fake_remux_opt_dir }}/state_push.py \
  "fake-remux scan" "{{ fake_remux_state_dir }}/state.json" "{{ fake_remux_scan_max_age_hours }}" \
  "fake-remux replace" "{{ fake_remux_state_dir }}/replace_state.json" "{{ fake_remux_replace_max_age_hours }}" \
  "mkv attachment repair" "{{ fake_remux_state_dir }}/mkv_attachment_state.json" "{{ fake_remux_mkv_attachment_max_age_hours }}")

LABELS=("fake-remux scan" "fake-remux replace" "mkv attachment repair")
# The syslog tag is shared, so each state file gets its own textfile named for what it checks.
CHECKS=(fake-remux-scan fake-remux-replace mkv-attachment-repair)

for i in "${!LABELS[@]}"; do
  LINE="${LINES[$i]:-}"
  if [[ -z "$LINE" ]]; then
    STATUS=down
    MSG="${LABELS[$i]} reader produced no output"
  else
    STATUS="${LINE%%$'\t'*}"
    MSG="${LINE#*$'\t'}"
  fi
  # The status line is the durable record of the message: the local record of the verdict, readable in Loki with `probe.py loki-query`.
  logger -t fake-remux-health "status=${STATUS} ${LABELS[$i]}: ${MSG}"
  # The textfile carries the verdict. A failed write logs and the loop goes on.
  SUCCESS=0
  [[ "$STATUS" == "up" ]] && SUCCESS=1
  write_check_textfile "${CHECKS[$i]}" "$SUCCESS" "$(date +%s)" "$DEADLINE_S" \
    || logger -t fake-remux-health "textfile write to ${TEXTFILE_DIR} failed (${CHECKS[$i]} status=${STATUS})"
done
