# fake-remux config — a secrets output of the fake-remux component. Host-only, 0600: embeds the Sonarr
# API key + the *arr Discord webhook. Read by BOTH host crons: fake_remux.py's scan (detector)
# and replace (reconciler). Both scripts have sane
# defaults for everything else (ffprobe path, 40 s probe window);
# only secrets + the operator knobs live here.
SONARR_API_KEY={{ sonarr_api_key }}
ARR_DISCORD_WEBHOOK_URL={{ arr_discord_webhook_url }}
# A genuine remux keyframes ~every 1-2 s; a keyframe gap over this (seconds) is a re-encode.
GOP_MAX_S={{ autofix_fake_remux_gop_max_s | default(5) }}
# Blast valve: more than this many fakes in one scan = a rule bug / systemic import setting, not N
# bad grabs -> act on NONE and alert.
MAX_PER_SCAN={{ autofix_fake_remux_max_per_scan | default(5) }}
STATE_FILE=/var/lib/autofix-fake-remux/state.json

# --- mkv attachment-name repair (mkv_attachment_repair.py) ---
# Sweeps HOST_DATA_ROOT/media for attachment filenames jellyfin-ffmpeg 7.1 rejects, and renames
# them in the mkv header. Its own state file, because its verdict is its own: the scan reports
# fake remuxes and this reports unrepairable attachment names.
MKV_ATTACHMENT_STATE_FILE=/var/lib/autofix-fake-remux/mkv_attachment_state.json
# Per-file ffprobe/mkvpropedit timeout, seconds. Separate from HTTP_TIMEOUT: a header rewrite on a
# large file over network storage is slower than any API call this config's other consumers make.
MKV_ATTACHMENT_TIMEOUT={{ autofix_fake_remux_mkv_attachment_timeout | default(120) }}

# --- replacer (reconciler: fake_remux_replace.py) ---
# off = detect only; shadow = log intended grabs with zero side effects; live = grab+delete+import.
FAKE_REMUX_REPLACE_MODE={{ autofix_fake_remux_replace_mode | default('shadow') }}
FAKE_REMUX_POLICY={{ fake_remux_opt_dir }}/policy.json
LEDGER_FILE=/var/lib/autofix-fake-remux/replacements.json
REPLACE_STATE_FILE=/var/lib/autofix-fake-remux/replace_state.json
OUTCOMES_FILE=/var/lib/autofix-fake-remux/outcomes.jsonl
# Maps Sonarr's /data view to the host path an ffprobe here can open, for the scan's library and
# the reconciler's downloads. Both /data/media and /data/torrents live under this root, so one
# value covers both trees.
HOST_DATA_ROOT={{ autofix_fake_remux_host_data_root | default('/home/' ~ sys_user ~ '/server/containers/data') }}

# SONARR_URL names the Service's pinned ClusterIP (fake_remux_sonarr_cluster_ip). An empty value
# disables both crons, which report `disabled (no SONARR_URL)` in their state files.
SONARR_URL={{ autofix_fake_remux_sonarr_url | default('') }}
