# Shipped by the deploy-ui component.
[Unit]
Description=Deploy queue UI (deploy.local) — reads the landing queue, runs land.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ sys_user }}
WorkingDirectory=/home/{{ sys_user }}/server
Environment=PATH=/home/{{ sys_user }}/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=DEPLOY_UI_BIND={{ server_ip }}
Environment=DEPLOY_UI_PORT={{ deploy_ui_port }}
Environment=DEPLOY_UI_REPO=/home/{{ sys_user }}/server
Environment=DEPLOY_UI_TREE_LOCK={{ server_git_tree_lock }}
Environment=DEPLOY_UI_LOGS=/home/{{ sys_user }}/.local/state/deploy-ui
# --no-python-downloads makes the interpreter pin enforcement rather than a request.
# ENFORCED: ansible/tests/setup/test_host_python_invocations.py.
ExecStart=/usr/bin/uv run --no-project --no-python-downloads --python {{ host_python_version }} {{ deploy_ui_dir }}/deploy_ui.py
Restart=on-failure
RestartSec=5
SyslogLevel=notice

[Install]
WantedBy=multi-user.target
