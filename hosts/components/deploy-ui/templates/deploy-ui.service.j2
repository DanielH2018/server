# Shipped by the deploy-ui component.
[Unit]
Description=Deploy queue UI (deploy.local) — reads the landing queue, runs land.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ sys_user }}
WorkingDirectory=/home/{{ sys_user }}/server
Environment=PATH=/home/{{ sys_user }}/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=DEPLOY_UI_BIND={{ server_ip }}
Environment=DEPLOY_UI_PORT={{ deploy_ui_port }}
Environment=DEPLOY_UI_REPO=/home/{{ sys_user }}/server
Environment=DEPLOY_UI_TREE_LOCK={{ server_git_tree_lock }}
Environment=DEPLOY_UI_LOGS=/home/{{ sys_user }}/.local/state/deploy-ui
Environment=DEPLOY_UI_GAMES_FILE={{ deploy_ui_dir }}/games.json
Environment=DEPLOY_UI_NAMESPACE={{ k8s_namespace }}
Environment=DEPLOY_UI_LOKI=https://loki-homelab.local.{{ domain }}
Environment=KUBECONFIG=/home/{{ sys_user }}/.kube/config
# A fan-out orchestrator on daniel-server keeps its run manifests there.
Environment=DEPLOY_UI_FANOUT_REMOTES=daniel-server
# A missing token still starts the unit: reads work, only writes refuse.
ImportCredential=games_panel_token
# --no-python-downloads makes the interpreter pin enforcement rather than a request.
ExecStart=/usr/bin/uv run --no-project --no-python-downloads --python {{ host_python_version }} {{ deploy_ui_dir }}/deploy_ui.py
Restart=on-failure
RestartSec=5
SyslogLevel=notice
# Without it, journald and syslog tag every line `uv`, the ExecStart binary.
SyslogIdentifier=deploy-ui

[Install]
WantedBy=multi-user.target
