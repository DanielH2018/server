# Shipped by the host package — edits here are overwritten.
#
# rkhunter reads this file after /etc/rkhunter.conf on every run. It allowlists the warnings every
# host raised every week from benign causes, so that rkhunter-check.sh can page on any warning
# that is left. Add a line here only for a warning whose cause you have confirmed.

# systemd packaging writes both: /etc/.updated is the systemd-update-done stamp, the backup is
# systemd-resolved's.
ALLOWHIDDENFILE=/etc/.updated
ALLOWHIDDENFILE=/etc/.resolv.conf.systemd-resolved.bak

# rkhunter reads PermitRootLogin only from sshd_config, never its Include drop-ins.
# So `no` where the main file carries the line, `unset` where it does not (daniel-pi).
ALLOW_SSH_ROOT_USER={{ integrity_scans_rkhunter_allow_ssh_root_user }}
{% if inventory_hostname in integrity_scans_squid_hosts %}

# The t2-egress squid keeps collapsed-forwarding segments in /dev/shm, which rkhunter reports as
# suspicious.
ALLOWDEVFILE=/dev/shm/squid-*-cf__metadata.shm
ALLOWDEVFILE=/dev/shm/squid-*-cf__queues.shm
ALLOWDEVFILE=/dev/shm/squid-*-cf__readers.shm
{% endif %}
