#!/usr/bin/env bash
# Weekly rkhunter scan — rendered by the initial_setup role, or by the integrity-scans host
# component on a host whose package owns it; edits overwritten.
#
# Usage: rkhunter-check.sh [-h|--help]
# Takes no arguments. Cron job "Weekly rkhunter malware scan", or homelab-rkhunter-check.timer
# on a packaged host, runs it as root, Wednesday 02:00. It runs `rkhunter --check` at idle CPU and
# IO priority, writes the warnings to the journal under the `rkhunter` tag, writes the verdict to
# the node_exporter textfile as check `rkhunter-check`, where RkhunterScanFailed and
# RkhunterScanNotReporting read it. Running it by hand is safe; a scan takes two to three minutes,
# and it rewrites the textfile.
#
# WHY A SCRIPT (#4598). The cron used to pipe `rkhunter --check` straight into
# `logger -t rkhunter`. The pipeline's exit status was logger's, and nothing read the tag, so a
# scan that failed outright read the same as one that passed. AIDE had the same fault and checked
# nothing for weeks (#4591, fixed by #4594).
#
# THE EXIT CODE CANNOT TELL A WARNING FROM AN ERROR. rkhunter 1.4.6 exits 1 when the scan found a
# warning and also on every error path (a bad option, an unreadable config, a missing command).
# So this script reads the log rkhunter rewrites on every run instead: a scan completed only if
# the log was written during this run and holds the "System checks summary" block. A log left
# from last week, or one cut off before the summary, reads as a scan that did not complete.
set -uo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

# shellcheck source=/dev/null
source {{ integrity_scans_host_lib_dir }}/homelab-check-lib.sh || {
  logger -t rkhunter-check "homelab-check-lib.sh missing — install the host package"
  exit 1
}

# The longest legitimate gap between two textfile writes: the timer runs weekly (Wednesday
# 02:00, hosts/components/integrity-scans/units/homelab-rkhunter-check.timer), 604800s, and the
# extra 2h is the slack for a run that takes far longer than the last. The deleted Uptime Kuma
# tile kept the same 612000. Move it with the timer (#6168).
# ansible/tests/setup/test_integrity_scan_rule_literals.py pins the rules' literals to it.
DEADLINE_S=612000

# rkhunter's LOGFILE default in /etc/rkhunter.conf. rkhunter truncates and rewrites it on every
# run, so its mtime and its summary say whether THIS run finished.
RKHUNTER_LOG=/var/log/rkhunter.log

# Captured whole rather than piped, because a pipeline's exit status is its last command's, which
# is how the old cron lost it. --report-warnings-only keeps the journal to the warnings and any
# error rkhunter prints; the full report stays in the log file.
printf -v START_EPOCH '%(%s)T' -1
START=$SECONDS
OUTPUT=$(/usr/bin/nice -n19 /usr/bin/ionice -c3 /usr/bin/rkhunter --check --nocolors --skip-keypress --report-warnings-only 2>&1)
RC=$?
RUN_TIME="$(((SECONDS - START) / 60))m"

[[ -n "$OUTPUT" ]] && printf '%s\n' "$OUTPUT" | logger -t rkhunter

SUMMARY=""
if [[ -r "$RKHUNTER_LOG" ]] && (($(stat -c %Y "$RKHUNTER_LOG") >= START_EPOCH)); then
  SUMMARY=$(awk '/System checks summary/ { found = 1 } found' "$RKHUNTER_LOG")
fi

# One count from the summary block, whose lines read `[02:02:01] Possible rootkits: 0`.
summary_count() {
  printf '%s\n' "$SUMMARY" | awk -v label="$1" '$0 ~ label ":[[:space:]]*[0-9]+[[:space:]]*$" { print $NF; exit }'
}

# DECIDED: any warning, any suspect file and any possible rootkit pushes DOWN (#4638). Measured on
# 2026-10-12 over daniel-server's journal (18 weekly runs) and the rotated logs on all three hosts,
# the warnings fell into three classes. Two hidden files under /etc appeared on every host in every
# run, and daniel-pi reported PermitRootLogin unset in every run. Both classes are allowlisted in
# /etc/rkhunter.conf.local (rkhunter.conf.local.j2), which leaves a healthy week with no warnings
# at all. The third class is a passwd or group change: daniel-server had one in 5 of its 18 weeks,
# and daniel-box and daniel-pi one week each, every one a package or the operator adding an
# account. It pages, because a new account is what this scan exists to catch. rkhunter stores its
# copy of passwd and group on every run, so running this script again by hand acknowledges the
# change and clears the alert. Suspect files read 0 in every log kept, because a refresh after every
# dpkg run rebaselines package upgrades (homelab-rkhunter-propupd.service since #7680), so a
# suspect file is a binary that changed outside apt.
if [[ -z "$SUMMARY" ]]; then
  STATUS=down
  # The first line that names an error, else the first line of output at all.
  DETAIL=$(printf '%s\n' "$OUTPUT" | awk 'tolower($0) ~ /error|invalid/ { sub(/^[[:space:]]+/, ""); print; exit }')
  [[ -n "$DETAIL" ]] || DETAIL=$(printf '%s\n' "$OUTPUT" | awk 'NF { sub(/^[[:space:]]+/, ""); print; exit }')
  MSG="rkhunter exited ${RC} and this run wrote no summary to ${RKHUNTER_LOG}, so the scan did not complete: ${DETAIL:-no output} (run ${RUN_TIME}); journalctl -t rkhunter"
else
  ROOTKITS=$(summary_count "Possible rootkits")
  SUSPECT=$(summary_count "Suspect files")
  WARNINGS=$(grep -c '^\[[0-9:]*\] Warning:' "$RKHUNTER_LOG")
  COUNTS="${WARNINGS} warnings, ${SUSPECT:-?} suspect files, ${ROOTKITS:-?} possible rootkits (exit ${RC}, run ${RUN_TIME})"
  FIRST_WARNING=$(grep -m1 '^\[[0-9:]*\] Warning:' "$RKHUNTER_LOG" | sed 's/^\[[0-9:]*\] Warning: //')
  if [[ -z "$ROOTKITS" || -z "$SUSPECT" ]]; then
    # A group of checks was skipped or the summary changed shape: a count the alert pages on is
    # unreadable, so the scan cannot be called clean.
    STATUS=down
    MSG="the summary in ${RKHUNTER_LOG} lacks a Possible rootkits or Suspect files count: ${COUNTS}"
  elif ((ROOTKITS > 0)); then
    STATUS=down
    MSG="possible rootkit found: ${COUNTS}; grep Warning ${RKHUNTER_LOG} lists them"
  elif ((SUSPECT > 0)); then
    STATUS=down
    MSG="suspect file found, a system binary changed outside apt: ${COUNTS}; grep Warning ${RKHUNTER_LOG} lists them"
  elif ((WARNINGS > 0)); then
    STATUS=down
    MSG="rkhunter warned: ${COUNTS}; the first reads: ${FIRST_WARNING}. grep Warning ${RKHUNTER_LOG} lists them. An account change clears when this script is run again by hand; any other benign warning needs a line in /etc/rkhunter.conf.local"
  else
    STATUS=up
    MSG="scan completed: ${COUNTS}"
  fi
fi

# Unconditional, so a DOWN leaves a durable record in syslog and Loki beside the textfile. NOTICE
# rather than INFO — journald here caps MaxLevelStore=notice, so an info line is dropped from the
# journal and from forwarding.
logger -p daemon.notice -t rkhunter-check "status=${STATUS} ${MSG}"

write_check_textfile rkhunter-check "$([[ "$STATUS" == up ]] && echo 1 || echo 0)" "$(date +%s)" "$DEADLINE_S" \
  || logger -t rkhunter-check "textfile write failed (status=${STATUS})"

# Cron ignores the exit code; it is non-zero after a DOWN so a run by hand reads the same way.
[[ "$STATUS" == up ]] || exit 1
