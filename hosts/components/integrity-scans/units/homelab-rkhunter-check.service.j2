# Shipped by the host package's integrity-scans component. Started by homelab-rkhunter-check.timer.
[Unit]
Description=Run the weekly rkhunter scan and write its verdict
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
SyslogLevel=notice
SyslogIdentifier=rkhunter-check
ExecStart=/usr/lib/homelab/rkhunter-check
