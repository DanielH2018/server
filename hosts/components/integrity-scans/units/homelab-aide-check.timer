# Shipped by the host package's integrity-scans component with its enable link. Monday 03:00, the
# cron's slot. Persistent runs a slot missed while the timer was stopped, as a package upgrade
# stops it, at the next start.
[Unit]
Description=Run the weekly AIDE check on Monday at 03:00

[Timer]
OnCalendar=Mon *-*-* 03:00:00
AccuracySec=1s
Persistent=true

[Install]
WantedBy=timers.target
