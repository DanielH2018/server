# Shipped by the host package's integrity-scans component. Started by homelab-aide-check.timer.
#
# No Restart=: a red check is a broken config, a missing database or a change awaiting
# `aide-check --accept`, which a rerun does not clear, and every rerun is another
# full-filesystem scan of an hour or more.
[Unit]
Description=Run the weekly AIDE check and write its verdict
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
SyslogLevel=notice
SyslogIdentifier=aide-check
ExecStart=/usr/lib/homelab/aide-check
