# Shipped by homelab-daniel-box with its enable link. Reruns homelab-loki-route-witness.service
# once at boot, only when its last verdict was not up (#4495). The service's ExecStopPost= writes
# the marker below after any run that did not exit 0 and removes it after one that did. Without
# this, a reboot kills the pending Restart=on-failure rerun, and the timer's Persistent=true
# catch-up does not replace it: the slot that pushed `down` already fired.
#
# The condition gates this unit, and the start is an ExecStart= rather than a Wants=: systemd
# pulls in a Wants= dependency even when this unit's own condition fails, so the check would run
# at every boot. `--no-block` keeps the check out of the boot transaction.
[Unit]
Description=Loki read-route witness (boot rerun while red)
ConditionPathExists=/var/lib/kuma-check/loki-route-witness.down

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl start --no-block homelab-loki-route-witness.service

[Install]
WantedBy=multi-user.target
