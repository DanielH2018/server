# Shipped with its enable link. Hourly at minute 23, which keeps it off the
# :00 and :30 slots the */10 and */30 health checks already crowd.
[Unit]
Description=Loki read-route witness (timer)

[Timer]
OnCalendar=*-*-* *:23:00
# A slot lost to an outage runs once at boot; a check red before reboot is rerun by the -boot
# service.
Persistent=true

[Install]
WantedBy=timers.target
