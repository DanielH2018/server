#!/usr/bin/env bash
# Witness for the Loki read route — shipped by each cluster node's package (loki-route-witness).
#
# Usage: loki-read-route-health [-h|--help]
# Takes no arguments. systemd timer homelab-loki-route-witness.timer runs it as the deploy user at
# minute 23 of every hour, and again every 15 minutes while the last run failed. Each run writes
# its verdict to $TEXTFILE_DIR/loki-read-route-health.prom for node_exporter's textfile collector
# (default /var/lib/node-exporter-textfile; a test points it elsewhere).
#
# WHAT THIS WATCHES. loki-homelab's IngressRoute has exactly one caller —
# `probe.py loki-query` / `loki-labels`, running as a host process. A broken route reads as
# `404 page not found`, which does not distinguish it from a broken query.
#
# WHY A POD CANNOT BE THE WITNESS. The route's guard is a ClientIP set of node-owned addresses
# (k8s/roles/loki-homelab/templates/ingressroute.yaml.j2), so monitor-bridge's request would
# arrive with a pod IP and fail for a reason unrelated to the operator's path. The grant is
# HOST-sourced, and only a host process can witness it.
#
# WHY THIS RUNS ON BOTH NODES. Which address a host process arrives as depends on where the
# traefik pod is: same node, the packet carries that node's cni0 gateway; other node, it crosses
# the VXLAN overlay and carries the sending node's flannel.1 address. A broken grant can be
# invisible from one node and fatal from the other, so one witness could report green throughout.
# Each host writes its OWN verdict, which Prometheus labels with the host's origin, and the
# LokiReadRoute rules select each host's series apart.
#
# THE VERDICT IS THE BODY, NOT THE EXIT CODE. probe.py's curl carries no `-f`, so `404 page not
# found` comes back with exit 0. loki_route_health.py is what decides, and its tests hold that
# 404 as a DOWN case.
set -uo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

# shellcheck source=/dev/null
source /usr/lib/homelab/homelab-check-lib.sh || {
  logger -t loki-read-route-health "homelab-check-lib.sh missing — the check-lib component ships it"
  exit 1
}

# A boot on the slot reports the route down while k3s starts: exit 1 without a verdict so
# Restart=on-failure reruns it.
if boot_grace_active {{ loki_route_witness_boot_grace_s }} loki-read-route-health; then
  exit 1
fi

# The longest legitimate gap between two textfile writes: the timer fires at minute 23 of every
# hour (3600s), and a run skipped by the boot grace may take one slot, so 7200s.
# tests/services/alert_rules/test_not_reporting_rule_deadlines.py pins the rules' literals to it.
DEADLINE_S=7200

REPO_DIR=/home/{{ sys_user }}/server
# Absolute uv path: a rebuilt host has no per-user uv.
# --frozen: a uv.lock rewrite would dirty the tree and park `homelab-checkout-sync`.
UV=/usr/bin/uv
BODY="$(cd "$REPO_DIR" && "$UV" run --quiet --frozen python scripts/diagnostics/probe.py loki-labels 2>&1)"
RC=$?

# `--no-project`: a broken lockfile in the checkout must not read as a broken route.
if MSG="$(printf '%s' "$BODY" | /usr/bin/uv run --no-project --no-python-downloads --python {{ host_python_version }} /usr/lib/homelab/loki_route_health.py "$RC")"; then
  STATUS=up
else
  STATUS=down
fi

# Unconditional: the textfile keeps only the current verdict, so this line is the durable record.
# NOTICE, not INFO: journald caps MaxLevelStore=notice.
logger -p daemon.notice -t loki-read-route-health "status=${STATUS} ${MSG}"

write_check_textfile loki-read-route-health "$([[ "$STATUS" == up ]] && echo 1 || echo 0)" "$(date +%s)" "$DEADLINE_S" \
  || logger -t loki-read-route-health "textfile write failed (status=${STATUS})"

# Exit 1 after a down verdict so Restart=on-failure reruns the check until the route answers.
[[ "$STATUS" == up ]] || exit 1
