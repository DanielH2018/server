#!/bin/bash
# Write the read-only kubeconfig for {{ sys_user }}, from the token credential and the API server's CA.
#
# NOT the ca.crt inside the ServiceAccount token Secret. That is the CA k3s issues service account
# certificates from, and it does not sign the apiserver's serving certificate: a kubeconfig built
# from it authenticates and then dies at the TLS handshake. The CA that does sign it is in the admin
# kubeconfig on the server, and in the PEM file k3s fetched at the join on an agent.
#
# dpkg never owns a path under /home, so this oneshot writes the file. The identity is the
# {{ k3s_readonly_sa_name }} ServiceAccount; it cannot read Secrets, exec into pods, or change
# anything. HOMELAB_ROOT prefixes the paths and KUBECONFIG_OWNER names the owner, for the tests.
set -euo pipefail

ca_source="${HOMELAB_ROOT:-}{{ k3s_readonly_kubeconfig_ca_source }}"
dest="${HOMELAB_ROOT:-}/home/{{ sys_user }}/.kube/config"
token="$(<"$CREDENTIALS_DIRECTORY/k3s_readonly_token")"
if grep -q -e '-----BEGIN CERTIFICATE-----' "$ca_source"; then
    ca="$(base64 -w0 "$ca_source")"
else
    ca="$(awk '/certificate-authority-data:/ { print $2; exit }' "$ca_source")"
fi
if [[ -z "$ca" ]]; then
    echo "k3s-readonly-kubeconfig: no certificate-authority-data in $ca_source" >&2
    exit 1
fi

scratch="$(mktemp)"
trap 'rm -f "$scratch"' EXIT
cat > "$scratch" << EOF
---
apiVersion: v1
kind: Config
current-context: {{ k3s_readonly_sa_name }}
clusters:
  - name: default
    cluster:
      server: {{ k3s_readonly_kubeconfig_server }}
      certificate-authority-data: $ca
contexts:
  - name: {{ k3s_readonly_sa_name }}
    context:
      cluster: default
      user: {{ k3s_readonly_sa_name }}
users:
  - name: {{ k3s_readonly_sa_name }}
    user:
      token: $token
EOF

if cmp -s "$scratch" "$dest"; then
    exit 0
fi
install -d -m 0700 -o "${KUBECONFIG_OWNER:-{{ sys_user }}}" -g "${KUBECONFIG_OWNER:-{{ sys_user }}}" "$(dirname "$dest")"
install -m 0600 -o "${KUBECONFIG_OWNER:-{{ sys_user }}}" -g "${KUBECONFIG_OWNER:-{{ sys_user }}}" -T "$scratch" "$dest"
echo "k3s-readonly-kubeconfig: wrote $dest"
