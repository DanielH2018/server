---
# The apiserver reads this once, at startup: a change waits for the k3s restart.
# No level logs a Secret body: that would write every credential in plaintext to disk.
apiVersion: audit.k8s.io/v1
kind: Policy

omitStages:
  # RequestReceived doubles the entry count and carries nothing the later stage lacks.
  - RequestReceived

rules:
  # The FIRST matching rule wins, so every `level: None` rule must precede the catch-all.

  # Control-plane identities' Secret reads, which the Secret-read rule below would otherwise log.
  # Read verbs only: a kubelet Secret WRITE is anomalous and must reach the catch-all.
  - level: None
    users: ["system:kube-proxy", "system:apiserver"]
    verbs: ["get", "list", "watch"]
    resources:
      - group: ""
        resources: ["secrets"]
  - level: None
    userGroups: ["system:nodes"]
    verbs: ["get", "list", "watch"]
    resources:
      - group: ""
        resources: ["secrets"]

  # Secret reads: --secrets-encryption does not defend an API-level read, so this is the only
  # record.
  # It must precede the read drop and the readonly SA's drop; Metadata names the reader, never the
  # value.
{# DECIDED: every reader's Secret watch logs both ResponseStarted and ResponseComplete, with no
   identity exempt. A watch logs ResponseComplete only when it closes, so ResponseStarted is the
   only timely record that a token began streaming Secret changes. The ~160 entries an hour it
   costs are 1.5 percent of the stream. #}
  - level: Metadata
    verbs: ["get", "list", "watch"]
    resources:
      - group: ""
        resources: ["secrets"]

  # pods/log is a `get`, so the read drop below would swallow it; the exec rule does not cover it.
  # Logs carry tokens in error traces; Metadata names the reader, never a line.
  - level: Metadata
    verbs: ["get", "list", "watch"]
    resources:
      - group: ""
        resources: ["pods/log"]

  - level: None
    verbs: ["get", "list", "watch"]

  # Belt-and-braces if the SA is ever widened. Keep it below the Secret-read rule: its refused
  # Secret attempts must stay logged.
  - level: None
    users: ["system:serviceaccount:{{ k3s_server_readonly_sa_namespace }}:{{ k3s_server_readonly_sa_name }}"]
    verbs: ["get", "list", "watch"]

  # Kubelet and node-lease heartbeats: one write per node every few seconds, forever.
  - level: None
    users: ["system:kube-proxy", "system:apiserver"]
  - level: None
    userGroups: ["system:nodes"]
    resources:
      - group: "coordination.k8s.io"
        resources: ["leases"]

  - level: None
    resources:
      - group: "coordination.k8s.io"
        resources: ["leases"]

  # Health and discovery endpoints — unauthenticated probes, no state.
  - level: None
    nonResourceURLs:
      - /healthz*
      - /livez*
      - /readyz*
      - /version
      - /metrics
      - /openapi/*
      - /api*

  # A status write cannot change what Flux applies; the Kustomization status records every
  # reconcile.
  - level: None
    users: ["system:serviceaccount:flux-system:kustomize-controller"]
    verbs: ["patch", "update"]
    resources:
      - group: "kustomize.toolkit.fluxcd.io"
        resources: ["kustomizations/status"]

  # Status writes only; spec writes and deletes by the same account stay logged.
  - level: None
    users: ["system:serviceaccount:longhorn-system:longhorn-service-account"]
    verbs: ["patch", "update"]
    resources:
      - group: "longhorn.io"
        resources: ["engines/status", "volumes/status", "instancemanagers/status", "replicas/status", "nodes/status"]

  # A SubjectAccessReview is never stored, so it changes no state.
  - level: None
    users: ["system:serviceaccount:kube-system:metrics-server"]
    verbs: ["create"]
    resources:
      - group: "authorization.k8s.io"
        resources: ["subjectaccessreviews"]

  # An Event is itself a log record. A delete is kept, since it removes evidence.
  - level: None
    verbs: ["create", "patch", "update"]
    resources:
      - group: ""
        resources: ["events"]
      - group: "events.k8s.io"
        resources: ["events"]

  # ── kept: everything that changes state, plus pod access ──────────────────────────────

  # exec, attach and portforward are auto-approved for agent sessions: this entry is the only record
  # of a session reaching inside a container.
  - level: Metadata
    resources:
      - group: ""
        resources: ["pods/exec", "pods/attach", "pods/portforward"]

  # Catch-all: the writes after the drops above, plus anything a future resource adds.
  # kustomize-controller's apply patches are kept as the record of each promotion; the policy cannot
  # select dry-runs.
  - level: Metadata
