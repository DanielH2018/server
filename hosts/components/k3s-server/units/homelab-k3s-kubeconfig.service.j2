# Shipped by the host package's k3s-server component. Writes the read-only kubeconfig at boot, and
# again when reconcile restarts it because the token output changed.
[Unit]
Description=Write the read-only kubeconfig for {{ sys_user }}
After=homelab-secrets.service k3s.service k3s-agent.service
Wants=homelab-secrets.service
# k3s writes this file at its first start, which on a rebuild comes after the package install.
ConditionPathExists={{ k3s_readonly_kubeconfig_ca_source }}

[Service]
Type=oneshot
RemainAfterExit=yes
SyslogLevel=notice
LoadCredential=k3s_readonly_token:/run/homelab-secrets/k3s/readonly-token
ExecStart=/usr/lib/homelab/k3s-readonly-kubeconfig
SyslogIdentifier=k3s-readonly-kubeconfig

[Install]
WantedBy=multi-user.target
