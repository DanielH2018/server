# Shipped by the host package's k3s-server component. Writes the read-only kubeconfig once per boot.
[Unit]
Description=Write the read-only kubeconfig for {{ sys_user }}
After=homelab-secrets.service k3s.service
Wants=homelab-secrets.service
# k3s writes this file at its first start. A rebuild starts k3s by hand after the package install.
ConditionPathExists=/etc/rancher/k3s/k3s.yaml

[Service]
Type=oneshot
RemainAfterExit=yes
SyslogLevel=notice
LoadCredential=k3s_readonly_token:/run/credstore/k3s_readonly_token
ExecStart=/usr/lib/homelab/k3s-readonly-kubeconfig
SyslogIdentifier=k3s-readonly-kubeconfig

[Install]
WantedBy=multi-user.target
