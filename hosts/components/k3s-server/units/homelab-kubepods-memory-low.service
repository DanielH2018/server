# Shipped by the host package's k3s-server component. Started by
# homelab-kubepods-memory-low.path. A reload, not set-property: set-property would rewrite the
# file the path unit watches and trigger itself.
[Unit]
Description=Reload systemd so kubepods.slice takes the homelab MemoryLow drop-in

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl daemon-reload
