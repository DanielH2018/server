# Shipped by the github-checks component with its enable link. Daily, ten minutes after the ruleset
# check. The setting moves only when it expires, so the cadence bounds how long a lapse can go
# unnoticed.
[Unit]
Description=GitHub interaction-limit re-arm (timer)

[Timer]
OnCalendar=*-*-* {{ '%02d' | format(github_interaction_limit_cron_hour | int) }}:{{ '%02d' | format(github_interaction_limit_cron_minute | int) }}:00
# A slot that fell inside an outage runs once at boot. A check that went red before a reboot already
# fired its slot, so homelab-github-interaction-limit-boot.service reruns it (#4495).
Persistent=true

[Install]
WantedBy=timers.target
