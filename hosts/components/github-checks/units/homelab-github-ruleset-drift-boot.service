# Shipped by the github-checks component with its enable link. Reruns
# homelab-github-ruleset-drift.service once at boot, only when its last verdict was not up (#4495).
# The start is an ExecStart= rather than a Wants=, because systemd pulls in a Wants= dependency even
# when this unit's own condition fails.
[Unit]
Description=GitHub ruleset drift check (boot rerun while red)
ConditionPathExists=/var/lib/kuma-check/github-ruleset-drift.down

[Service]
SyslogLevel=notice
Type=oneshot
ExecStart=/usr/bin/systemctl start --no-block homelab-github-ruleset-drift.service

[Install]
WantedBy=multi-user.target
