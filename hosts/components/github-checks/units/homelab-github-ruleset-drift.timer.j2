# Shipped by the github-checks component with its enable link. Daily: rulesets change on a human
# cadence, and GitHub's unauthenticated limit is 60 requests an hour per source IP, shared with the
# renovate-notify component on this host.
[Unit]
Description=GitHub ruleset drift check (timer)

[Timer]
OnCalendar=*-*-* {{ '%02d' | format(github_ruleset_drift_cron_hour | int) }}:{{ '%02d' | format(github_ruleset_drift_cron_minute | int) }}:00
# A slot that fell inside an outage runs once at boot. A check that went red before a reboot already
# fired its slot, so homelab-github-ruleset-drift-boot.service reruns it (#4495).
Persistent=true

[Install]
WantedBy=timers.target
