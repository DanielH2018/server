#!/bin/bash
# Daily drift check: does the LIVE GitHub ruleset still require the contexts this repo declares,
# each pinned to the GitHub Actions app, does the branch-protection ruleset still exclude Renovate's branches, and does the fence still
# keep the agent's account to its own branches? Three arms, one verdict. Ahead of all three, the repo
# must be public: on the free plan GitHub enforces no ruleset on a private repo.
# After them it reads the fork approval policy, which the runner pods depend on (ADR-0032).
#
# Usage: github-ruleset-drift [-h|--help]
# Takes no arguments and changes nothing on GitHub. systemd timer
# homelab-github-ruleset-drift.timer runs it as root once a day
# (github_ruleset_drift_cron_hour and _minute), and again every 30 minutes while the last
# run failed. It reads the live rulesets with the deploy user's gh login (anonymous when there is
# none), compares them with the values rendered into this file, and records the verdict. Exit 0 =
# no drift; exit 1 = drift or an unverifiable read. Each verdict goes to the journal under the
# github-ruleset-drift tag and to $TEXTFILE_DIR/github-ruleset-drift.prom for node_exporter's
# textfile collector (default /var/lib/node-exporter-textfile; a test points it elsewhere).
# Prometheus's GitHubRulesetDrift and GitHubRulesetDriftNotReporting rules page from that file.
#
# The ruleset is what stops an un-CI'd commit reaching master, and `promote` and checkout-sync
# trust that: each reads the check runs for a master SHA and acts on a green verdict. An edit in
# the GitHub UI — dropping a required context, adding a bypass actor, flipping enforcement to
# `evaluate` — changes the gate with no commit, no PR and no signal, so this watches the ruleset
# itself. Legacy `branches/master/protection` is a SEPARATE API from rulesets and says nothing
# about them.
#
# WHY THIS IS A CRON AND NOT A TEST. A pytest asserting the same list would be a third hand-copy
# of the same remote state, going stale by the identical mechanism and reading green while it
# did. The declaration below is still a copy; the difference is that this compares it against
# the LIVE endpoint every day, so the copy going stale is the thing being detected rather than
# the thing being trusted.
#
# It ALERTS on drift, it never reconciles. Changing a ruleset is a deliberate act; this only makes
# it a visible one.
#
# Authenticated through the deploy user's `gh auth token` when that CLI is logged in, anonymous
# otherwise. The endpoint returns 200 with `enforcement` and every
# `rules[].parameters.required_status_checks[].context` to an anonymous caller, and the repo holds
# no GitHub token in SOPS — the same call shape renovate_notify.py uses from this host, and the
# same token source a landing's await_ci.py poll uses. Note `bypass_actors` is null
# anonymously rather than empty: GitHub returns the list only to a caller with admin on the repo.
# The contexts, enforcement and the Renovate exclusion are checked either way. The bypass lists
# are checked only on an authenticated read, and an anonymous one reports them UNVERIFIED and
# records down (check_bypass below), because the fence's bypass list is the whole of what keeps
# the agent off branches outside its own prefix. github-interaction-limit.sh already records down without a token.
#
# Rate limit: anonymous GitHub allows 60 req/hr per source IP, shared by EVERY caller on this
# host (a landing's await_ci.py poll, renovate_notify). Authenticated it is
# 5000/hr per token. Once a day is still the right cadence — rulesets change on a human clock.
# The token never lands in argv: curl reads it from a config file handed over as a process
# substitution (`-K <(...)`), because /proc is mounted without hidepid here.
#
# set -uo (not -euo): a failed curl must be captured + reported, not swallowed by an early exit.
set -uo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin # cron ships a bare PATH
export LC_ALL=C # one `sort` order for the live and declared lists, whatever the host's locale
# A prompting `gh` hangs an unattended run, and the update notifier's stderr reads as an error.
export GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1

# shellcheck source=/dev/null
source /usr/lib/homelab/homelab-check-lib.sh || {
  logger -t github-ruleset-drift "homelab-check-lib.sh missing — the check-lib component ships it"
  exit 1
}

# The longest legitimate gap between two textfile writes: the timer fires daily (86400s), and the
# extra hour is the margin the NotReporting rules keep.
# tests/services/alert_rules/test_gitops_check_rule_literals.py pins the rules' literals to it.
DEADLINE_S=90000

push() { # up|down msg
  logger -t github-ruleset-drift "status=$1 $2"
  write_check_textfile github-ruleset-drift "$([[ "$1" == up ]] && echo 1 || echo 0)" "$(date +%s)" "$DEADLINE_S" \
    || logger -t github-ruleset-drift "textfile write failed (status=$1)"
}

# Fetch arms only: a dead link is the WAN tile's page; a wrong-shaped 200 keeps `push down`.
# Keep each call site's exit 1: the timer restarts on-failure, so a skipped run retries.
push_reachout() { # msg
  REACHOUT_STATUS=down
  REACHOUT_NOTE=""
  # Guard: an older library without reachout_verdict would abort under `set -u` with no verdict.
  if command -v reachout_verdict >/dev/null 2>&1; then
    reachout_verdict github-ruleset-drift {{ wan_probe_urls | join(' ') }}
  fi
  push "$REACHOUT_STATUS" "${REACHOUT_NOTE}$1"
}

# Branch on the TYPE of `.bypass_actors`: null means the caller cannot see the list, `[]` an emptied
# list; `.bypass_actors[]?` would read both as nothing.
check_bypass() {
  local id=$1 body=$2 expected=$3 kind live added removed
  kind=$(printf '%s' "$body" | jq -r '.bypass_actors | type')
  if [ "$kind" != "array" ]; then
    push down "ruleset ${id} returned no bypass_actors list (${kind}) — GitHub shows it only to an admin token, so check gh auth status for {{ sys_user }}; bypass list UNVERIFIED"
    exit 1
  fi
  live=$(printf '%s' "$body" \
    | jq -r '.bypass_actors[] | "\(.actor_type):\(.actor_id):\(.bypass_mode)"' | sort)
  if [ "$live" != "$expected" ]; then
    added=$(comm -23 <(printf '%s\n' "$live") <(printf '%s\n' "$expected") | grep . | tr '\n' ' ')
    removed=$(comm -13 <(printf '%s\n' "$live") <(printf '%s\n' "$expected") | grep . | tr '\n' ' ')
    push down "ruleset ${id} bypass actors DRIFTED — newly-allowed:[${added}] no-longer-allowed:[${removed}] — an added actor merges past this ruleset; reconcile hosts/components/github-checks/defaults/main.yml only if the change was deliberate"
    exit 1
  fi
}

RULESET_URL="https://api.github.com/repos/{{ github_repo }}/rulesets/{{ github_ruleset_id }}"

# Quoted heredoc: context names contain spaces, parentheses and `+`. The blank-line filter makes the
# render match a bare Jinja Environment, which lacks Ansible's trim_blocks.
EXPECTED=$(
  sed '/^[[:space:]]*$/d' <<'CONTEXTS' | sort
{% for ctx in github_expected_ruleset_contexts %}
{{ ctx }}
{% endfor %}
CONTEXTS
)
# Each ruleset's declared bypass list, baked in the same way. An empty list renders to "".
EXPECTED_CI_BYPASS=$(
  sed '/^[[:space:]]*$/d' <<'ACTORS' | sort
{% for actor in github_ruleset_bypass_actors %}
{{ actor }}
{% endfor %}
ACTORS
)
EXPECTED_FENCE_BYPASS=$(
  sed '/^[[:space:]]*$/d' <<'ACTORS' | sort
{% for actor in github_fence_ruleset_bypass_actors %}
{{ actor }}
{% endfor %}
ACTORS
)

# `-H` makes gh read the deploy user's $HOME, not root's. Any failure leaves TOKEN empty
# (anonymous).
TOKEN=$(sudo -n -u "{{ sys_user }}" -H gh auth token 2>/dev/null || true)
AUTH_CONFIG=""
if [ -n "$TOKEN" ]; then
  AUTH_CONFIG=$(printf 'header = "Authorization: Bearer %s"\n' "$TOKEN")
fi

# A private free-plan repo's rulesets read active but enforce nothing, and an anonymous read 404s.
# So this read comes first, without `-f`: the 404 body is the evidence.
REPO_URL="https://api.github.com/repos/{{ github_repo }}"
if ! REPO_BODY=$(curl -s --max-time 20 -K <(printf '%s\n' "$AUTH_CONFIG") \
  -H "Accept: application/vnd.github+json" "$REPO_URL"); then
  push_reachout "failed to fetch repo {{ github_repo }} — visibility and every ruleset UNVERIFIED"
  exit 1
fi
VISIBILITY=$(printf '%s' "$REPO_BODY" | jq -r '.visibility // empty' 2>/dev/null)
REPO_ERROR=$(printf '%s' "$REPO_BODY" | jq -r '.message // empty' 2>/dev/null)
if [ -n "$VISIBILITY" ] && [ "$VISIBILITY" != "public" ]; then
  push down "repo is ${VISIBILITY}: rulesets are not enforced on the free plan, the CI merge gate is open — make {{ github_repo }} public again"
  exit 1
fi
if [ -z "$VISIBILITY" ] && [ "$REPO_ERROR" = "Not Found" ]; then
  push down "repo {{ github_repo }} answers Not Found — most likely private, and rulesets are not enforced on a private repo on the free plan, so the CI merge gate is open"
  exit 1
fi
if [ -z "$VISIBILITY" ]; then
  push down "repo {{ github_repo }} response had no .visibility (${REPO_ERROR:-no message}) — bad fetch, UNVERIFIED"
  exit 1
fi

# Process substitution, not a pipe: under pipefail `printf | curl -K -` reports printf's EPIPE when
# curl exits early. `<(...)` also keeps the token off argv.
if ! BODY=$(curl -sf --max-time 20 -K <(printf '%s\n' "$AUTH_CONFIG") \
  -H "Accept: application/vnd.github+json" "$RULESET_URL"); then
  # An unreachable source must say it could not look; it is not 'no drift'.
  push_reachout "failed to fetch ruleset {{ github_ruleset_id }} — branch protection UNVERIFIED"
  exit 1
fi

ENFORCEMENT=$(printf '%s' "$BODY" | jq -r '.enforcement // empty')
if [ -z "$ENFORCEMENT" ]; then
  # A 200 that is not a ruleset (error object, HTML, truncated) is a bad fetch, not 'contexts gone'.
  push down "ruleset {{ github_ruleset_id }} response had no .enforcement — bad fetch, UNVERIFIED"
  exit 1
fi

LIVE=$(printf '%s' "$BODY" \
  | jq -r '.rules[]?.parameters?.required_status_checks[]?.context // empty' \
  | sed '/^[[:space:]]*$/d' | sort)
LIVE_COUNT=$(printf '%s\n' "$LIVE" | grep -c .)

# An empty context list reads like 'every check removed'; the stated count tells them apart.
if [ "$LIVE_COUNT" -eq 0 ]; then
  push down "ruleset {{ github_ruleset_id }} requires NO status checks (enforcement=${ENFORCEMENT}) — every merge gate is open, or the response shape changed"
  exit 1
fi

if [ "$ENFORCEMENT" != "active" ]; then
  push down "ruleset {{ github_ruleset_id }} enforcement is '${ENFORCEMENT}', not active — required checks are advisory"
  exit 1
fi

if [ "$LIVE" != "$EXPECTED" ]; then
  # removed: expected, no longer required (stops gating merges). added: required, not declared here.
  REMOVED=$(comm -13 <(printf '%s\n' "$LIVE") <(printf '%s\n' "$EXPECTED") | tr '\n' ' ')
  ADDED=$(comm -23 <(printf '%s\n' "$LIVE") <(printf '%s\n' "$EXPECTED") | tr '\n' ' ')
  push down "ruleset {{ github_ruleset_id }} DRIFTED — no-longer-required:[${REMOVED}] newly-required:[${ADDED}] — reconcile github_expected_ruleset_contexts in hosts/components/github-checks/defaults/main.yml"
  exit 1
fi

# GitHub matches an unpinned context by name alone and omits its `integration_id`. An anonymous read
# returns the pins, so this runs ahead of the admin-only bypass checks.
UNPINNED=$(printf '%s' "$BODY" \
  | jq -r --argjson app {{ github_actions_app_id }} \
    '.rules[]?.parameters?.required_status_checks[]? | select(.integration_id != $app) | "\(.context)=\(.integration_id // "none")"' \
  | sort | tr '\n' ' ')
if [ -n "$UNPINNED" ]; then
  push down "ruleset {{ github_ruleset_id }} has required contexts not pinned to GitHub Actions (app {{ github_actions_app_id }}): [${UNPINNED}] — a commit status of that name from any token with write access satisfies it; pin each to GitHub Actions in the ruleset"
  exit 1
fi

# The PR rule stops a token pushing to master directly, since the fence does not cover master.
# A required review would hold every land.sh merge.
PR_RULE=$(printf '%s' "$BODY" \
  | jq -c 'first(.rules[]? | select(.type == "pull_request") | .parameters) // empty')
if [ -z "$PR_RULE" ]; then
  push down "ruleset {{ github_ruleset_id }} has no pull_request rule — a token that can update master pushes to it without a PR"
  exit 1
fi
# `tostring`, not `// empty`: jq's `//` treats a missing value and false alike.
APPROVALS=$(printf '%s' "$PR_RULE" | jq -r '.required_approving_review_count | tostring')
if [ "$APPROVALS" != "{{ github_ruleset_required_approvals }}" ]; then
  push down "ruleset {{ github_ruleset_id }} requires ${APPROVALS} approving reviews (declared {{ github_ruleset_required_approvals }}) — an auto-merged PR waits for a review nobody is asked to give; reconcile github_ruleset_required_approvals only if the change was deliberate"
  exit 1
fi

# "Default" applies `deletion` and `non_fast_forward` to every ref with an admin-only bypass.
# Renovate is not an admin, so with no exclusion GitHub refuses the app's post-merge branch
# delete and its rebase force-push. A merged branch then survives at its green SHA, Renovate
# opens the next version's PR onto it, and the stale verdict automerges an empty squash before
# CI can run. The exclusion below is what lets the app delete and rebase under `renovate/`; this
# arm alerts when it is missing. Same rule as above: reconcile the ruleset, never this default.
BRANCH_RULESET_URL="https://api.github.com/repos/{{ github_repo }}/rulesets/{{ github_branch_ruleset_id }}"
if ! BRANCH_BODY=$(curl -sf --max-time 20 -K <(printf '%s\n' "$AUTH_CONFIG") \
  -H "Accept: application/vnd.github+json" "$BRANCH_RULESET_URL"); then
  push_reachout "failed to fetch ruleset {{ github_branch_ruleset_id }} — renovate branch exclusion UNVERIFIED"
  exit 1
fi

if [ -z "$(printf '%s' "$BRANCH_BODY" | jq -r '.enforcement // empty')" ]; then
  push down "ruleset {{ github_branch_ruleset_id }} response had no .enforcement — bad fetch, UNVERIFIED"
  exit 1
fi

# -x -F: the whole line, literally. `**` is a glob in the pattern, not in the comparison.
if ! printf '%s' "$BRANCH_BODY" | jq -r '.conditions.ref_name.exclude[]? // empty' \
  | grep -qxF '{{ github_branch_ruleset_renovate_exclude }}'; then
  push down "ruleset {{ github_branch_ruleset_id }} does not exclude {{ github_branch_ruleset_renovate_exclude }} — Renovate cannot delete or rebase its branches, and a merged branch's stale green automerges the next PR empty (#1759)"
  exit 1
fi

# Without the fence the agent could push onto an operator's branch and its landing would carry the
# commit to master. Compare the exclusions exactly: each added one is a branch the agent can push
# to.
FENCE_RULESET_URL="https://api.github.com/repos/{{ github_repo }}/rulesets/{{ github_fence_ruleset_id }}"
if ! FENCE_BODY=$(curl -sf --max-time 20 -K <(printf '%s\n' "$AUTH_CONFIG") \
  -H "Accept: application/vnd.github+json" "$FENCE_RULESET_URL"); then
  push_reachout "failed to fetch ruleset {{ github_fence_ruleset_id }} — agent push fence UNVERIFIED"
  exit 1
fi

FENCE_ENFORCEMENT=$(printf '%s' "$FENCE_BODY" | jq -r '.enforcement // empty')
if [ -z "$FENCE_ENFORCEMENT" ]; then
  push down "ruleset {{ github_fence_ruleset_id }} response had no .enforcement — bad fetch, UNVERIFIED"
  exit 1
fi
if [ "$FENCE_ENFORCEMENT" != "active" ]; then
  push down "ruleset {{ github_fence_ruleset_id }} enforcement is '${FENCE_ENFORCEMENT}', not active — the agent can push to any branch"
  exit 1
fi

if ! printf '%s' "$FENCE_BODY" | jq -r '.conditions.ref_name.include[]? // empty' | grep -qxF '~ALL'; then
  push down "ruleset {{ github_fence_ruleset_id }} no longer covers ~ALL — the agent can push to the branches it dropped"
  exit 1
fi

EXPECTED_FENCE_EXCLUDE=$(
  sed '/^[[:space:]]*$/d' <<'REFS' | sort
{% for ref in github_fence_ruleset_exclude %}
{{ ref }}
{% endfor %}
REFS
)
FENCE_EXCLUDE=$(printf '%s' "$FENCE_BODY" | jq -r '.conditions.ref_name.exclude[]? // empty' | sort)
if [ "$FENCE_EXCLUDE" != "$EXPECTED_FENCE_EXCLUDE" ]; then
  OPENED=$(comm -23 <(printf '%s\n' "$FENCE_EXCLUDE") <(printf '%s\n' "$EXPECTED_FENCE_EXCLUDE") | grep . | tr '\n' ' ')
  CLOSED=$(comm -13 <(printf '%s\n' "$FENCE_EXCLUDE") <(printf '%s\n' "$EXPECTED_FENCE_EXCLUDE") | grep . | tr '\n' ' ')
  push down "ruleset {{ github_fence_ruleset_id }} exclusions DRIFTED — newly-open-to-the-agent:[${OPENED}] no-longer-excluded:[${CLOSED}]; reconcile github_fence_ruleset_exclude only if the change was deliberate"
  exit 1
fi

UNRESTRICTED=""
for rule in creation update deletion; do
  if ! printf '%s' "$FENCE_BODY" | jq -e --arg r "$rule" 'any(.rules[]?; .type == $r)' >/dev/null; then
    UNRESTRICTED="${UNRESTRICTED}${rule} "
  fi
done
if [ -n "$UNRESTRICTED" ]; then
  push down "ruleset {{ github_fence_ruleset_id }} no longer restricts [${UNRESTRICTED}] — the agent can do that on any branch"
  exit 1
fi

# Compare each exactly: an added rule changes what it refuses as much as a dropped one, and a
# narrowed target protects nothing while reading active.
declare -A RESTRICTION_BODY
# Fail unless REPO is public: a private free-plan repo's ruleset reads active and enforces nothing.
check_public() {
  local repo=$1 body visibility
  if ! body=$(curl -s --max-time 20 -K <(printf '%s\n' "$AUTH_CONFIG") \
    -H "Accept: application/vnd.github+json" "https://api.github.com/repos/${repo}"); then
    push_reachout "failed to fetch repo ${repo} — its rulesets UNVERIFIED"
    exit 1
  fi
  visibility=$(printf '%s' "$body" | jq -r '.visibility // empty' 2>/dev/null)
  if [ "$visibility" != "public" ]; then
    push down "repo ${repo} reads '${visibility:-no visibility}', not public — its rulesets are not enforced on the free plan"
    exit 1
  fi
}
# check_restriction REPO ID TARGET INCLUDE RULES — INCLUDE and RULES are sorted, one per line.
check_restriction() {
  local repo=$1 id=$2 target=$3 include=$4 rules=$5 body live
  if ! body=$(curl -sf --max-time 20 -K <(printf '%s\n' "$AUTH_CONFIG") \
    -H "Accept: application/vnd.github+json" "https://api.github.com/repos/${repo}/rulesets/${id}"); then
    push_reachout "failed to fetch ruleset ${id} on ${repo} — its update restriction UNVERIFIED"
    exit 1
  fi
  live=$(printf '%s' "$body" | jq -r '.enforcement // empty')
  if [ "$live" != "active" ]; then
    push down "ruleset ${id} on ${repo} enforcement is '${live:-missing}', not active — its refs take any update"
    exit 1
  fi
  live=$(printf '%s' "$body" | jq -r '.target // empty')
  if [ "$live" != "$target" ]; then
    push down "ruleset ${id} on ${repo} targets '${live}', not ${target}"
    exit 1
  fi
  live=$(printf '%s' "$body" | jq -r '.conditions.ref_name.include[]?, (.conditions.ref_name.exclude[]? | "!" + .)' | sort)
  if [ "$live" != "$include" ]; then
    push down "ruleset ${id} on ${repo} covers [$(printf '%s' "$live" | tr '\n' ' ')], declared [$(printf '%s' "$include" | tr '\n' ' ')] — reconcile github_update_restriction_rulesets only if the change was deliberate"
    exit 1
  fi
  live=$(printf '%s' "$body" | jq -r '.rules[]?.type' | sort)
  if [ "$live" != "$rules" ]; then
    push down "ruleset ${id} on ${repo} rules [$(printf '%s' "$live" | tr '\n' ' ')], declared [$(printf '%s' "$rules" | tr '\n' ' ')]"
    exit 1
  fi
  RESTRICTION_BODY[$id]=$body
}
{% for repo in github_update_restriction_rulesets | map(attribute='repo') | unique | reject('equalto', github_repo) %}
check_public "{{ repo }}"
{% endfor %}
{% for rs in github_update_restriction_rulesets %}
check_restriction "{{ rs.repo }}" {{ rs.id }} {{ rs.target }} "$(printf '%s\n' {% for ref in rs.include | sort %}'{{ ref }}' {% endfor %}| sort)" "$(printf '%s\n' {{ rs.rules | sort | join(' ') }} | sort)"
{% endfor %}

# Last: only these need an admin token, so an anonymous run judges everything else first.
check_bypass {{ github_ruleset_id }} "$BODY" "$EXPECTED_CI_BYPASS"
check_bypass {{ github_fence_ruleset_id }} "$FENCE_BODY" "$EXPECTED_FENCE_BYPASS"
{% for rs in github_update_restriction_rulesets %}
check_bypass {{ rs.id }} "${RESTRICTION_BODY[{{ rs.id }}]}" "$(printf '%s\n' {{ rs.bypass | sort | join(' ') }} | sort)"
{% endfor %}

# DECIDED: a fork's pull request waits for approval before any workflow runs, whoever opened it,
# because a runner pod takes a job from any workflow run in this repo (ADR-0032).
#
# No `-f`: a token without admin gets an error body, which says more than curl's exit code.
FORK_APPROVAL_URL="https://api.github.com/repos/{{ github_repo }}/actions/permissions/fork-pr-contributor-approval"
if ! FORK_APPROVAL_BODY=$(curl -s --max-time 20 -K <(printf '%s\n' "$AUTH_CONFIG") \
  -H "Accept: application/vnd.github+json" "$FORK_APPROVAL_URL"); then
  push_reachout "failed to fetch the fork approval policy of {{ github_repo }} — UNVERIFIED"
  exit 1
fi
FORK_APPROVAL=$(printf '%s' "$FORK_APPROVAL_BODY" | jq -r '.approval_policy // empty' 2>/dev/null)
if [ -z "$FORK_APPROVAL" ]; then
  push down "{{ github_repo }} returned no fork approval policy ($(printf '%s' "$FORK_APPROVAL_BODY" | jq -r '.message // "no message"' 2>/dev/null)) — GitHub shows it only to an admin token, so check gh auth status for {{ sys_user }}; UNVERIFIED"
  exit 1
fi
if [ "$FORK_APPROVAL" != "{{ github_fork_approval_policy }}" ]; then
  push down "fork pull requests run workflows under '${FORK_APPROVAL}', declared {{ github_fork_approval_policy }} — a fork's code can reach a runner pod with no approval (ADR-0032); set it back under Settings, Actions, General"
  exit 1
fi

push up "repo public; ruleset {{ github_ruleset_id }} active, ${LIVE_COUNT} required contexts, matches the declared set, each pinned to app {{ github_actions_app_id }};ruleset {{ github_branch_ruleset_id }} excludes {{ github_branch_ruleset_renovate_exclude }}; ruleset {{ github_ruleset_id }} requires a PR with {{ github_ruleset_required_approvals }} approving reviews; ruleset {{ github_fence_ruleset_id }} restricts every branch except {{ github_fence_ruleset_exclude | join(', ') }}; {% for rs in github_update_restriction_rulesets %}ruleset {{ rs.id }} restricts {{ rs.include | join(', ') }} on {{ rs.repo }}; {% endfor %}all bypass lists as declared; fork pull requests wait for approval ({{ github_fork_approval_policy }})"
exit 0
