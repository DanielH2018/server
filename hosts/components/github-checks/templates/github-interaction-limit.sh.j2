#!/bin/bash
# Daily re-arm of the GitHub interaction limit on each repo in github_interaction_limit_repos,
# and one recorded verdict saying whether every one is armed.
#
# Usage: github-interaction-limit [-h|--help]
# Takes no arguments. systemd timer homelab-github-interaction-limit.timer runs it as root once
# a day (github_interaction_limit_cron_hour and _minute), and again every 30 minutes while
# the last run failed. Running it by hand re-applies the limit for real. It needs a gh login for
# the deploy user, reads github_interaction_limit and its expiry from the values rendered
# into this file. Exit 0 = limit re-armed (or disarmed, when the declared limit is none); exit 1 =
# it was not, and the verdict says down. Each verdict goes to the journal under the
# github-interaction-limit tag and to $TEXTFILE_DIR/github-interaction-limit.prom for
# node_exporter's textfile collector (default /var/lib/node-exporter-textfile; a test points it
# elsewhere). Prometheus's GitHubInteractionLimitNotArmed and GitHubInteractionLimitNotReporting
# rules page from that file.
#
# The interaction limit is the only lever GitHub offers that keeps a PUBLIC repo closed to
# everyone but its collaborators: with `collaborators_only` set, nobody else can comment, react,
# open an issue or open a PR, while reads, clones and forks stay open. It is the answer to "keep
# the repo public but let only me act on it", chosen 2026-09-06 over moving the repo into an
# organization (a private org repo caps Actions minutes and loses free code scanning).
#
# GitHub only offers the limit as a TEMPORARY setting: the longest expiry is six months, and when
# it lapses nothing says so — the repo silently reopens. That expiry is the whole reason this cron
# exists. A PUT with the same body is idempotent and resets the expiry to six months from now, so
# a daily PUT turns a six-month lapse window into a one-day one.
#
# DECIDED: this script RECONCILES, where its sibling github-ruleset-drift.sh only alerts. The
# ruleset is a setting a human changes on purpose, and reconciling it would undo that change with
# no signal. The limit is not: the only way it changes without a human is by expiring, and
# re-applying an expired setting is restoring the declared state, not overriding a decision. A
# human who wants it off changes `github_interaction_limit` in defaults/main.yml — this
# script applies whatever that declares, and `none` disarms it by way of a DELETE.
#
# Authenticated through the deploy user's `gh auth token`, which carries the `repo` scope this
# endpoint needs (the setting is repo administration; anonymous callers cannot read it, let
# alone write it). No token means the PUT cannot happen, and that is reported as DOWN with
# UNVERIFIED — a check that could not act must not report the setting as armed.
#
# The token never lands in argv: curl reads it from a config file handed over as a process
# substitution (`-K <(...)`), because /proc is mounted without hidepid here.
#
# set -uo (not -euo): a failed curl must be captured + reported, not swallowed by an early exit.
set -uo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  esac
done

export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin # cron ships a bare PATH
# What scripts/lib/gh.py sets for every Python caller, and this cron calls `gh` directly. A `gh`
# that prompts hangs an unattended run forever, and the update notifier writes to stderr on the
# first call of the day — which a caller reading stderr as an error message then reports as one.
export GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1

# shellcheck source=/dev/null
source /usr/lib/homelab/homelab-check-lib.sh || {
  logger -t github-interaction-limit "homelab-check-lib.sh missing — the check-lib component ships it"
  exit 1
}

# The longest legitimate gap between two textfile writes: the timer fires daily (86400s), and the
# extra hour is the margin the NotReporting rules keep.
# tests/services/test_gitops_check_rule_literals.py pins the rules' literals to it.
DEADLINE_S=90000

# Records the verdict: the journal line first, so `journalctl -t github-interaction-limit` reads the
# outcome the way it does for github-ruleset-drift, then the textfile. A failed write logs and
# the run goes on to its exit.
push() { # up|down msg
  logger -t github-interaction-limit "status=$1 $2"
  write_check_textfile github-interaction-limit "$([[ "$1" == up ]] && echo 1 || echo 0)" "$(date +%s)" "$DEADLINE_S" \
    || logger -t github-interaction-limit "textfile write failed (status=$1)"
}

WANT_LIMIT="{{ github_interaction_limit }}"
WANT_EXPIRY="{{ github_interaction_limit_expiry }}"

# This cron runs as root; the gh login belongs to the deploy user, so the lookup drops to that
# user. `-H` matters: gh finds its login under $HOME, and a plain runuser/sudo keeps root's.
TOKEN=$(sudo -n -u "{{ sys_user }}" -H gh auth token 2>/dev/null || true)
if [ -z "$TOKEN" ]; then
  # Unlike the ruleset check there is no anonymous fallback: the endpoint needs the repo's
  # admin, so without a token the limit cannot be re-armed AND cannot be read.
  push down "no gh login for {{ sys_user }} — interaction limit NOT re-armed, state UNVERIFIED"
  exit 1
fi
AUTH_CONFIG=$(printf 'header = "Authorization: Bearer %s"\n' "$TOKEN")

# apply REPO — applies the declared limit to REPO and sets RESULT to its one-line outcome.
# Returns non-zero when the limit is not in its declared state, so one repo's failure never stops
# the next repo's re-arm.
apply() {
  local repo=$1 url="https://api.github.com/repos/$1/interaction-limits" body live expires
  # `none` means "no limit": the API expresses that as a DELETE, and a DELETE returns 204 with
  # no body. Everything else is a PUT that answers with the limit it stored.
  if [ "$WANT_LIMIT" = "none" ]; then
    if ! curl -sf --max-time 20 -X DELETE -K <(printf '%s\n' "$AUTH_CONFIG") \
      -H "Accept: application/vnd.github+json" "$url" >/dev/null; then
      RESULT="${repo}: failed to clear the interaction limit — state UNVERIFIED"
      return 1
    fi
    RESULT="${repo}: interaction limit declared none — cleared"
    return 0
  fi

  # Process substitution, not a pipe — see the sibling script for the pipefail/EPIPE reason.
  if ! body=$(curl -sf --max-time 20 -X PUT -K <(printf '%s\n' "$AUTH_CONFIG") \
    -H "Accept: application/vnd.github+json" -H "Content-Type: application/json" \
    -d "{\"limit\":\"${WANT_LIMIT}\",\"expiry\":\"${WANT_EXPIRY}\"}" "$url"); then
    # Unreachable, 401, 403 (token lacks the scope) and 422 (a value the API rejects) all land
    # here. None of them is "armed": a re-arm that never happened must say so.
    RESULT="${repo}: failed to set interaction limit ${WANT_LIMIT} — NOT re-armed, state UNVERIFIED"
    return 1
  fi

  live=$(printf '%s' "$body" | jq -r '.limit // empty')
  expires=$(printf '%s' "$body" | jq -r '.expires_at // empty')
  if [ -z "$live" ]; then
    # A 200 carrying something that is not an interaction-limit object — an error object, an
    # HTML interstitial, a truncated body. Reported as a bad response, never as "armed".
    RESULT="${repo}: interaction-limits response had no .limit — bad response, state UNVERIFIED"
    return 1
  fi
  if [ "$live" != "$WANT_LIMIT" ]; then
    # The API accepted the PUT and stored something else. Not a shape GitHub is documented to
    # produce, which is exactly why it is checked: this is the one branch that would otherwise
    # read "armed" while the setting was wrong.
    RESULT="${repo}: interaction limit is '${live}' after PUT of '${WANT_LIMIT}' — declared state NOT applied"
    return 1
  fi
  RESULT="${repo}: interaction limit ${live} re-armed, expires ${expires:-unknown}"
}

STATUS=up
SUMMARY=""
for repo in {% for repo in github_interaction_limit_repos %}"{{ repo }}" {% endfor %}; do
  apply "$repo" || STATUS=down
  SUMMARY+="${SUMMARY:+; }${RESULT}"
done
push "$STATUS" "$SUMMARY"
[ "$STATUS" = up ]
