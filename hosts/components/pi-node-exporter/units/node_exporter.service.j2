[Unit]
Description=Prometheus node exporter (host unit; was the node-exporter container until #2005)
Documentation=https://github.com/prometheus/node_exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# This host's journald stores notice and above (MaxLevelStore=notice), so stdout logs at notice.
SyslogLevel=notice
User=node_exporter
Group=node_exporter
# The collector set without the --path.* remaps a container needs to see the host's /proc, /sys
# and /, and with the textfile collector on for homelab-updater's homelab_host.prom. The listen
# address is the LAN IP; a UFW allow for the LAN admits it. The binary is homelab-tools'
# node-exporter, the version the cluster's DaemonSet pins. netclass skips Docker's bridges and
# veths, which churn, and keeps the LAN NIC's node_network_carrier_changes_total.
# +: the directory is created outside the unit's ProtectSystem=strict sandbox.
# systemd-tmpfiles-setup.service applies the same file at boot.
ExecStartPre=+/usr/bin/systemd-tmpfiles --create /usr/lib/tmpfiles.d/homelab-node-exporter.conf
ExecStart=/usr/lib/homelab/bin/node-exporter \
  --web.listen-address={{ server_ip }}:9100 \
  --collector.filesystem.mount-points-exclude=^/(dev|proc|sys|run|var/lib/docker/.+)($|/) \
  --no-collector.arp \
  --collector.netclass.ignored-devices=^(lo|docker0|br-[0-9a-f]+|veth[0-9a-f]+)$ \
  --collector.textfile.directory=/var/lib/node-exporter-textfile \
  --no-collector.wifi
Restart=on-failure
RestartSec=5
# What the container's cap_drop ALL, read_only rootfs and resources() gave it.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryMax=64M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
