# The worktree holder scan's socket. A worktree removal connects here to ask root which
# processes hold a tree (lib.worktrees.privileged_holders, fanout_lib.clean.live_process_scan).
# A socket needs no setuid, so a claude-rc.service session, which runs with
# NoNewPrivileges=yes, can ask it too. The group decides who may connect; the service then maps
# the caller's SO_PEERCRED uid to a worktree root and refuses a uid the map does not name.
[Unit]
Description=Worktree holder scan socket

[Socket]
# systemd resolves SocketGroup= when it binds, so the group and sys_user's membership come first.
ExecStartPre=+/usr/sbin/groupadd -f -r {{ worktree_holders_group }}
ExecStartPre=+/usr/sbin/usermod -aG {{ worktree_holders_group }} {{ sys_user }}
ListenStream=/run/worktree-holders.sock
# One worktree-holders@.service instance per connection, with the connection on its stdin.
Accept=yes
SocketUser=root
SocketGroup={{ worktree_holders_group }}
SocketMode=0660
# A stale socket file makes callers refuse every removal; an absent one falls back to the
# unprivileged scan.
RemoveOnStop=yes
MaxConnections=16

[Install]
WantedBy=sockets.target
