# Shipped by homelab-daniel-box. A unit pages Discord on failure with
# `OnFailure=homelab-alert@%n.service`, and the page opens with the failed unit's name.
[Unit]
Description=Page Discord that %i failed
After=homelab-secrets.service
Wants=homelab-secrets.service

[Service]
Type=oneshot
# A credential, not unit text: systemd serves unit content over the system bus, so an embedded
# webhook would print for any local user.
LoadCredential=discord_webhook:/run/credstore/discord_alert_webhook
# systemd re-runs a failed delivery every five minutes: curl's retries do not cover an outage.
# Only exit 3 (empty webhook) is final; exit 22 covers any 400+, so a 429 or 502 must retry.
Restart=on-failure
RestartSec=5min
RestartPreventExitStatus=3
# The first attempt records the failure time and every retry posts it, so a late page stays
# accurate.
# RuntimeDirectoryPreserve=restart keeps it across retries; it goes when the unit stops for good.
RuntimeDirectory=homelab-alert/%i
RuntimeDirectoryPreserve=restart
ExecStartPre=/bin/sh -c 'test -s %t/homelab-alert/%i/failed-at || date --utc "+%%Y-%%m-%%d %%H:%%M UTC" > %t/homelab-alert/%i/failed-at'
# curl JSON-escapes the instance and the time, so no shell wrapper re-quotes it.
# The page names `%i`, the instance as written: `%I` unescapes every `-` to `/`.
ExecStart=/usr/bin/curl -fsS -m 10 --retry 5 --retry-delay 10 --retry-all-errors \
  -H "Content-Type: application/json" \
  --variable 'failed_at@%t/homelab-alert/%i/failed-at' \
  --variable 'instance=%i' \
  --variable 'host=%H' \
  --variable 'webhook@%d/discord_webhook' \
  --expand-data '{"content":"{{instance:json}} failed on {{host:json}}. journalctl -u {{instance:json}} has the run. Failed at {{failed_at:trim:json}}."}' \
  --expand-url '{{webhook:trim}}'
# curl is silent on success and systemd's info-level lines are dropped (MaxLevelStore=notice), so
# the notice-level echo records a delivery.
SyslogLevel=notice
ExecStartPost=/bin/echo homelab-alert delivered for %i
