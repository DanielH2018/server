# Shipped by homelab-daniel-pi with its enable link. Every minute, the cadence the verify Job
# reads its 403 count against.
[Unit]
Description=Probe the edge VIP from daniel-pi every minute for crowdsec's off-cluster verify

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min

[Install]
WantedBy=timers.target
