# Shipped by homelab-daniel-pi. Started by homelab-crowdsec-probe.timer.
[Unit]
Description=Probe the edge VIP from daniel-pi for crowdsec's off-cluster verify

[Service]
Type=oneshot
# This host's journald stores notice and above (MaxLevelStore=notice), so stdout logs at notice.
SyslogLevel=notice
User={{ sys_user }}
# jellyfin's hostname matches a real router from any client address (the script's header).
ExecStart=/usr/lib/homelab/crowdsec-edge-probe jellyfin.local.{{ domain }} {{ k3s_metallb_ingress_vip }}
# systemd re-owns /var/log/pi-health to the starting unit's user when owners differ, so this unit
# and the three heartbeat services must name the same User=.
LogsDirectory=pi-health
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
