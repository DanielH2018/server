#cloud-config
# hosts/components/hypervisor: the etcd restore drill guest's seed, which etcd-drill-prepare fills. Unlike the
# staging guest's, this is read on EVERY run: the orchestrator recreates the disk from the base
# image each time, so each run is a first boot.
hostname: {{ hypervisor_etcd_drill_vm_hostname }}
fqdn: {{ hypervisor_etcd_drill_vm_hostname }}
preserve_hostname: false

users:
  - name: {{ sys_user }}
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - "{{ hypervisor_etcd_drill_vm_ssh_key }}"

ssh_pwauth: false
disable_root: true

# The pinned host key from etcd-drill-prepare; a per-run key would mean accepting any key.
# ed25519 only, so no other key type can be offered.
ssh_genkeytypes: [ed25519]
ssh_keys:
  ed25519_private: |
    {{ hypervisor_etcd_drill_vm_hostkey_private }}
  ed25519_public: "{{ hypervisor_etcd_drill_vm_hostkey_public }}"

# Nothing installed at boot: the orchestrator copies the k3s binary, token and R2 env in over ssh.
package_update: false
package_upgrade: false

growpart:
  mode: auto
  devices: ["/"]
resize_rootfs: true
