# Shipped by the renovate-notify component. Started by homelab-renovate-notify.timer.
[Unit]
Description=Renovate manual-action notifier (query open PRs, alert on change)
After=network-online.target homelab-secrets.service
Wants=network-online.target homelab-secrets.service
OnFailure=homelab-alert@%n.service

[Service]
Type=oneshot
# This host's journald stores notice and above (MaxLevelStore=notice), so stdout logs at notice.
SyslogLevel=notice
User={{ sys_user }}
# Confined because it parses attacker-influenceable API JSON; the script and config are read-only.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
StateDirectory=renovate-notify
StateDirectoryMode=0750
# The directory is sticky; `-` lets the notifier start on a host without the gh-quota component.
ReadWritePaths=-/var/lib/gh-quota
Environment=PYTHONDONTWRITEBYTECODE=1
# uv opens its cache for write on every run; $HOME/.cache is unwritable under ProtectHome.
# PrivateTmp, not ReadWritePaths: a surviving cache is state a compromised run could poison.
Environment=UV_CACHE_DIR=/tmp/uv-cache
ExecStart=/usr/bin/uv run --no-project --no-python-downloads --python {{ host_python_version }} /usr/lib/homelab/renovate-notify/renovate_notify.py
# The same run's verdict for node_exporter's textfile collector (M6 batch B4). It runs only when
# ExecStart succeeded. A crash writes nothing, which is the rule's own reading: the missing file
# is the signal, and the rules in other-setup-checks.yaml carry only a NotReporting arm for it.
#
# `+` runs this one line unsandboxed, because ProtectSystem=strict above leaves the textfile
# directory read-only and ReadWritePaths= should not widen for a single file. `env -i
# PATH=/usr/bin:/bin` pins the command's environment, the same form the agent unit uses. It is
# /bin/bash, not /bin/sh, since homelab-check-lib.sh is bash-shaped. Both write failures end in a logged
# line and exit 0, so the unit never fails over its own telemetry. 129600 is the DEADLINE_S: a
# daily run plus a missed one and slack, and hosts/tests/host_checks/test_b4_rule_literals.py pins the
# rule's literal to it. `%%s` is systemd's escape for the date format's `%s`.
ExecStartPost=+/usr/bin/env -i PATH=/usr/bin:/bin /bin/bash -c 'source /usr/lib/homelab/homelab-check-lib.sh && write_check_textfile renovate-notify 1 "$(date +%%s)" 129600 || logger -t renovate-notify "textfile write failed (homelab-check-lib.sh missing or the textfile directory unwritable)"'
