# Shipped by homelab-daniel-pi (pi-docker). The one path that installs or moves the held Docker
# engine. An upgrade stops every container for the apt run, so it starts only two ways: an operator
# starts it from a LAN session, or homelab-docker-engine.timer starts it in the Pi's quiet window.
# bootstrap-host.sh starts it once on a fresh Pi. It is a no-op while every engine package sits at
# its pin, which is why a timer can start it nightly. It has no [Install] section and carries
# `policy: manual`, so reconcile never starts or restarts it.
[Unit]
Description=Install, hold or upgrade the Pi's pinned Docker engine
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# This host's journald stores notice and above (MaxLevelStore=notice), so stdout logs at notice.
SyslogLevel=notice
# The recreate starts one container at a time on the 456 MB board, as homelab-compose.service does.
Environment=COMPOSE_PARALLEL_LIMIT=1
# The updater wait (51 min) plus the apt run and the project's recreate.
TimeoutStartSec=90min
ExecStart=/usr/lib/homelab/docker-engine apply
# Runs after a failed start too, so a failed apt run still leaves the engine held.
ExecStopPost=/usr/lib/homelab/docker-engine hold
