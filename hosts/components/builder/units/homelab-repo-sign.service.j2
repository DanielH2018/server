# Shipped by homelab-daniel-box. No timer and no [Install]: homelab-builder.service starts it
# through OnSuccess= after every run that exits 0, a held run included, which is what makes the
# daily re-sign happen.
[Unit]
Description=Homelab repository signer (signs and publishes the packages the builder staged)
OnFailure=homelab-alert@%n.service

[Service]
Type=oneshot
User=homelab-signer
Group=homelab-signer
# homelab-apt-repo.service is a DynamicUser reading repo/ through the other bits; the script sets
# modes too.
UMask=0022
# Signing needs no network, so PrivateNetwork=yes; it may write its own state directory and empty
# staged/.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
StateDirectory=homelab-signer
StateDirectoryMode=0711
ReadWritePaths=/var/lib/homelab-signer
ReadWritePaths=/var/lib/homelab-builder/staged
Environment=HOME=/var/lib/homelab-signer
Environment=PYTHONDONTWRITEBYTECODE=1
# journald here stores notice and above, so stdout and stderr log at notice or a traceback is lost.
SyslogLevel=notice
TimeoutStartSec=10min
# The signer cannot read the builder's pinned interpreter under its 0700 state directory.
ExecStart=/usr/bin/python3 /usr/lib/homelab/builder/homelab_repo_sign.py
# `+` runs the copy as root outside the sandbox, `-` keeps a failed copy from failing the unit.
ExecStopPost=-+/bin/sh /usr/lib/homelab/publish-textfile homelab_repo_ /var/lib/homelab-signer/homelab_repo.prom
