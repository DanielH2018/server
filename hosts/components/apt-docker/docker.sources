# Shipped by the apt-docker component: Docker's apt repository, for the Pi's engine packages.
# Suites names resolute because daniel-pi runs Ubuntu 26.04; a release upgrade needs a new suite here.
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: resolute
Components: stable
Signed-By: /etc/apt/keyrings/docker.asc
